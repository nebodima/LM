//Чеки зачёта предоплаты (В63): очередь непробитых чеков «полный расчёт» по проведённым урокам, оплаченным заранее
//(абонемент, аванс), за день или период — и пакетное пробитие на онлайн-кассе этого компьютера (УЗ_ЧекиКлиент).
//Очередь формирует проведение урока (регистр «Чеки зачёта предоплаты»), если в реквизитах организации включено
//«Пробивать чеки зачёта предоплаты». Логика — docs/логики/чеки.md.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НачалоПериода = НачалоДня(ТекущаяДатаСеанса());
	КонецПериода = НачалоПериода;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация = РегистрыСведений.УЗ_Настройки.Настройки().Организация;
	КонецЕсли;
	ЗаполнитьОчередь();

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	ЗаполнитьОчередь();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	ЗаполнитьОчередь();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОчередь

&НаКлиенте
Процедура ОчередьВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	СтрокаОчереди = Очередь.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если СтрокаОчереди <> Неопределено Тогда
		ПоказатьЗначение(, СтрокаОчереди.Урок);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПробитьЧеки(Команда)

	Чеки = Новый Массив;
	Для Каждого СтрокаОчереди Из Очередь Цикл
		Если СтрокаОчереди.Отметка Тогда
			Чеки.Добавить(Новый Структура("Урок, Ученик", СтрокаОчереди.Урок, СтрокаОчереди.Ученик));
		КонецЕсли;
	КонецЦикла;
	Если Чеки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Отметьте чеки, которые пробить: в очереди нет отмеченных строк.'"));
		Возврат;
	КонецЕсли;
	УЗ_ЧекиКлиент.ПробитьЧекиЗачета(ЭтаФорма, Чеки, Новый ОписаниеОповещения("ПробитьЧекиЗавершение", ЭтотОбъект));

КонецПроцедуры

//Пакет пробит (весь или до первой ошибки кассы) — очередь перечитывается.
&НаКлиенте
Процедура ПробитьЧекиЗавершение(Пробито, ДополнительныеПараметры) Экспорт

	ЗаполнитьОчередь();

КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)

	ЗаполнитьОчередь();

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)

	Для Каждого СтрокаОчереди Из Очередь Цикл
		СтрокаОчереди.Отметка = Истина;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)

	Для Каждого СтрокаОчереди Из Очередь Цикл
		СтрокаОчереди.Отметка = Ложь;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьОчередь()

	Очередь.Очистить();
	Если Не ЗначениеЗаполнено(КонецПериода) Или КонецПериода < НачалоПериода Тогда
		КонецПериода = НачалоПериода;
	КонецЕсли;
	Итого = 0;
	Для Каждого Чек Из УЗ_Чеки.ОчередьЧековЗачета(НачалоПериода, КонецДня(КонецПериода), Организация) Цикл
		СтрокаОчереди = Очередь.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаОчереди, Чек);
		СтрокаОчереди.Отметка = Истина;
		Итого = Итого + Чек.Сумма;
	КонецЦикла;
	Если Очередь.Количество() > 0 Тогда
		Состояние = СтрШаблон(НСтр("ru = 'Не пробито чеков зачёта: %1 на %2. Пробиваются на онлайн-кассе этого "
			+ "компьютера по очереди; двойной щелчок по строке открывает урок.'"), Очередь.Количество(),
			Формат(Итого, "ЧДЦ=2; ЧН=0,00"));
	ИначеЕсли УЗ_Чеки.ЧекиЗачетаВключены(Организация) Тогда
		Состояние = НСтр("ru = 'За период все чеки зачёта предоплаты пробиты (или уроки за период не списывали "
			+ "предоплату).'");
	Иначе
		Состояние = НСтр("ru = 'Чеки зачёта предоплаты не формируются: включите «Пробивать чеки зачёта предоплаты» в "
			+ "реквизитах организации («Учёт занятий» → Настройки → Реквизиты организаций) — очередь пополняется при "
			+ "проведении уроков после включения.'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
