//Рабочее место педагога. Данные и запись — функции модуля менеджера обработки (их же проверяет COM-тест под
//ролью педагога); форма только показывает. Отметки текущего урока записываются кнопкой «Записать отметки» или
//сами — при переходе к другому уроку, смене периода и «Обновить». Codex 3, находка 6: не записались (дата запрета,
//урок изменили, нет прав) — переход, смена периода и обновление отменяются, введённое остаётся на экране; урок
//закрытого периода открывается только для чтения.

&НаКлиенте
Перем ПериодУроков; //Структура(ДатаНачала, ДатаОкончания) — период показанного списка уроков
&НаКлиенте
Перем УрокИзменен; //Истина — урок изменили после открытия: отметки не записать, «Обновить» перечитывает без записи

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Педагог = Обработки.УЗ_МоиУроки.ПедагогТекущегоПользователя();
	Если Не ЗначениеЗаполнено(Педагог) Тогда
		Подсказка =
			НСтр("ru = 'Вы не связаны с карточкой педагога: руководитель указывает вас в поле «Пользователь программы» "
			+ "карточки педагога (Физ. лица)'");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Период.ДатаНачала) И Не ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		Сегодня = ТекущаяДатаСеанса();
		Период.ДатаНачала = НачалоДня(Сегодня) - (ДеньНедели(Сегодня) - 1) * 86400;
		Период.ДатаОкончания = Период.ДатаНачала + 7 * 86400 - 1;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЗаполнитьУроки();
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	Если Не ЗаписатьЕслиИзменено() Тогда
		//отметки не записаны — период прежний, урок и введённое на экране
		Период.ДатаНачала = ПериодУроков.ДатаНачала;
		Период.ДатаОкончания = ПериодУроков.ДатаОкончания;
		Возврат;
	КонецЕсли;
	ЗаполнитьУроки();
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗарплата Тогда
		ЗаполнитьЗарплату();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	//урок изменили после открытия — введённое не записать, «Обновить» перечитывает (так и просит сообщение)
	Если УрокИзменен <> Истина И Не ЗаписатьЕслиИзменено() Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьУроки();
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаЗарплата Тогда
		ЗаполнитьЗарплату();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьУроки()

	Уроки.Очистить();
	ПериодУроков = Новый Структура("ДатаНачала, ДатаОкончания", Период.ДатаНачала, Период.ДатаОкончания);
	Для Каждого Урок Из УрокиНаСервере(Педагог, Период.ДатаНачала, Период.ДатаОкончания) Цикл
		ЗаполнитьЗначенияСвойств(Уроки.Добавить(), Урок);
	КонецЦикла;
	ТекущийУрок = Неопределено;
	Ученики.Очистить();
	ТемаУрока = "";
	ДомашнееЗадание = "";
	ЕстьИзменения = Ложь;
	Если Уроки.Количество() = 0 Тогда
		СостояниеУрока = ?(ЗначениеЗаполнено(Педагог), НСтр("ru = 'За период уроков нет'"), "");
	Иначе
		СостояниеУрока = НСтр("ru = 'Выберите урок в списке'");
	КонецЕсли;
	Элементы.ГруппаУрок.ТолькоПросмотр = Истина;

КонецПроцедуры

&НаСервереБезКонтекста
Функция УрокиНаСервере(Знач Педагог, Знач Начало, Знач Конец)
	Возврат Обработки.УЗ_МоиУроки.УрокиПедагога(Педагог, Начало, Конец);
КонецФункции

&НаКлиенте
Процедура УрокиПриАктивизацииСтроки(Элемент)

	ТекущиеДанные = Элементы.Уроки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или ТекущиеДанные.Урок = ТекущийУрок Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗаписатьЕслиИзменено() Тогда
		//отметки прежнего урока не записаны — курсор возвращается на него, введённое остаётся
		ВернутьсяКТекущемуУроку();
		Возврат;
	КонецЕсли;
	ПоказатьУрок(ТекущиеДанные.Урок);

КонецПроцедуры

&НаКлиенте
Процедура ВернутьсяКТекущемуУроку()

	Для Каждого СтрокаУрока Из Уроки Цикл
		Если СтрокаУрока.Урок = ТекущийУрок Тогда
			Элементы.Уроки.ТекущаяСтрока = СтрокаУрока.ПолучитьИдентификатор();
			Возврат;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

//«Помещение: Класс 2, учеников: 5. » — по строке списка уроков (или "", если строки нет).
&НаКлиенте
Функция ОписаниеУрока(Урок)

	Строки = Уроки.НайтиСтроки(Новый Структура("Урок", Урок));
	Если Строки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Помещение: %1, учеников: %2. '"),
		?(ЗначениеЗаполнено(Строки[0].Помещение), Строки[0].Помещение, "—"), Строки[0].Учеников);

КонецФункции

&НаКлиенте
Процедура ПоказатьУрок(Урок)

	Данные = ДанныеУрокаНаСервере(Урок);
	ТекущийУрок = Урок;
	УрокИзменен = Ложь;
	Ученики.Очистить();
	Если Данные.Ошибка <> "" Тогда
		СостояниеУрока = Данные.Ошибка;
		ТемаУрока = "";
		ДомашнееЗадание = "";
		ВерсияУрока = "";
		Элементы.ГруппаУрок.ТолькоПросмотр = Истина;
	Иначе
		Для Каждого СтрокаУченика Из Данные.Ученики Цикл
			ЗаполнитьЗначенияСвойств(Ученики.Добавить(), СтрокаУченика);
		КонецЦикла;
		ТемаУрока = Данные.ТемаУрока;
		ДомашнееЗадание = Данные.ДомашнееЗадание;
		//помещение и число учеников — здесь, а не колонками списка: пять колонок не помещались в список рядом
		//с учениками, заголовки обрезались («Помеще…», «Учени…») и появлялась горизонтальная прокрутка
		СостояниеУрока = ОписаниеУрока(Урок) + Данные.Состояние;
		ВерсияУрока = Данные.Версия;
		//закрытый период (дата запрета) — только чтение: отметки всё равно не записались бы
		Элементы.ГруппаУрок.ТолькоПросмотр = Данные.ТолькоПросмотр;
	КонецЕсли;
	ЕстьИзменения = Ложь;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеУрокаНаСервере(Знач Урок)

	Попытка
		Данные = Обработки.УЗ_МоиУроки.ДанныеУрока(Урок);
		Данные.Вставить("Ошибка", "");
	Исключение
		Данные = Новый Структура("Ошибка", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Данные;

КонецФункции

&НаКлиенте
Процедура УченикиЯвкаПриИзменении(Элемент)
	ЕстьИзменения = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОтметкаПриИзменении(Элемент)
	ЕстьИзменения = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсех(Команда)

	Для Каждого СтрокаУченика Из Ученики Цикл
		СтрокаУченика.Явка = Истина;
	КонецЦикла;
	ЕстьИзменения = Истина;

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)

	Если Не ЗначениеЗаполнено(ТекущийУрок) Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(НСтр("ru = 'Выберите урок в списке'"), "Уроки");
		Возврат;
	КонецЕсли;
	ЗаписатьОтметкиУрока();

КонецПроцедуры

//Истина — изменений нет или они записаны; Ложь — не записаны (сообщение уже показано), вызывающий ничего не
//переключает и не очищает.
&НаКлиенте
Функция ЗаписатьЕслиИзменено()

	Если ЕстьИзменения И ЗначениеЗаполнено(ТекущийУрок) Тогда
		Возврат ЗаписатьОтметкиУрока();
	КонецЕсли;
	Возврат Истина;

КонецФункции

//Отметки — по ученику (стабильная строка урока) с версией урока, которую показали педагогу (Codex 3, находка 5).
&НаКлиенте
Функция ЗаписатьОтметкиУрока()

	Отметки = Новый Массив;
	Для Каждого СтрокаУченика Из Ученики Цикл
		Отметки.Добавить(Новый Структура("Ученик, Явка", СтрокаУченика.Ученик, СтрокаУченика.Явка));
	КонецЦикла;
	Итог = ЗаписатьНаСервере(ТекущийУрок, Отметки, ТемаУрока, ДомашнееЗадание, ВерсияУрока);
	Если Итог.Успех Тогда
		ЕстьИзменения = Ложь;
		ВерсияУрока = Итог.Версия;
		ПоказатьОповещениеПользователя(НСтр("ru = 'Отметки записаны'"), , Итог.Текст, БиблиотекаКартинок.Информация);
	Иначе
		УрокИзменен = Итог.Свойство("Перечитать");
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(Итог.Текст);
	КонецЕсли;
	Возврат Итог.Успех;

КонецФункции

&НаСервереБезКонтекста
Функция ЗаписатьНаСервере(Знач Урок, Знач Отметки, Знач Тема, Знач Задание, Знач Версия)
	Возврат Обработки.УЗ_МоиУроки.ЗаписатьОтметки(Урок, Отметки, Тема, Задание, Версия);
КонецФункции

//Страница «Моя зарплата»: начисления и выплаты за период и остаток к оплате — функция ЗарплатаПедагога() модуля
//менеджера (отчёт «Расчёты по зарплате» на СКД педагогу не дан: без права «Просмотр» уроков и физ. лиц СКД
//выбрасывает из него поля педагога и документа). Заполняется при переходе на страницу и при смене периода.
&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если ТекущаяСтраница = Элементы.СтраницаЗарплата Тогда
		ЗаполнитьЗарплату();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗарплату()

	Зарплата.Очистить();
	Данные = ЗарплатаНаСервере(Педагог, Период.ДатаНачала, Период.ДатаОкончания);
	Для Каждого СтрокаЗарплаты Из Данные.Строки Цикл
		ЗаполнитьЗначенияСвойств(Зарплата.Добавить(), СтрокаЗарплаты);
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Педагог) Тогда
		ИтогЗарплаты = "";
	Иначе
		ИтогЗарплаты = СтрШаблон(НСтр("ru = 'За период начислено %1, выплачено %2. К оплате на конец периода: %3'"),
			Формат(Данные.Начислено, "ЧДЦ=2; ЧН=0"), Формат(Данные.Выплачено, "ЧДЦ=2; ЧН=0"),
			Формат(Данные.Остаток, "ЧДЦ=2; ЧН=0"));
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗарплатаНаСервере(Знач Педагог, Знач Начало, Знач Конец)
	Возврат Обработки.УЗ_МоиУроки.ЗарплатаПедагога(Педагог, Начало, Конец);
КонецФункции
