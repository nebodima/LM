// Выгрузка и загрузка фотографий справочника «Фото».
// Файлы идут через браузер/клиент пользователя (ПолучитьФайлССервераАсинх / ПоместитьФайлыНаСерверАсинх),
// а не через папку на диске сервера: так работает и в веб-клиенте, и в тонком клиенте.

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура ОбработатьФайлы(Команда)

	Результат = "";
	Выгрузка = ПодготовитьФотоНаСервере();
	Если Выгрузка.Файлы.Количество() = 0 Тогда
		Результат = "В справочнике «Фото» нет фотографий — сохранять нечего." + Выгрузка.Пропущено;
		Возврат;
	КонецЕсли;

	Описания = Новый Массив;
	Для Каждого ФайлФото Из Выгрузка.Файлы Цикл
		Описания.Добавить(Новый ОписаниеПередаваемогоФайла(ФайлФото.Имя, ФайлФото.Адрес));
	КонецЦикла;
	ПараметрыДиалога = Новый ПараметрыДиалогаПолученияФайлов;
	ПараметрыДиалога.Заголовок = "Куда сохранить фотографии";
	Полученные = Ждать ПолучитьФайлыССервераАсинх(Описания, ПараметрыДиалога);
	Если Полученные = Неопределено Или Полученные.Количество() = 0 Тогда
		Результат = "Сохранение отменено.";
	Иначе
		Результат = СтрШаблон("Сохранено фотографий: %1.", Полученные.Количество()) + Выгрузка.Пропущено;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗагрузитьФотографии(Команда)

	Результат = "";
	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Заголовок = "Выберите фотографии";
	ПараметрыДиалога.МножественныйВыбор = Истина;
	ПараметрыДиалога.Фильтр = "Изображения (*.jpg;*.jpeg;*.png)|*.jpg;*.jpeg;*.png|Все файлы (*.*)|*.*";
	Помещенные = Ждать ПоместитьФайлыНаСерверАсинх(, , ПараметрыДиалога, УникальныйИдентификатор);
	Если Помещенные = Неопределено Или Помещенные.Количество() = 0 Тогда
		Результат = "Файлы не выбраны.";
		Возврат;
	КонецЕсли;

	Файлы = Новый Массив;
	Для Каждого Помещенный Из Помещенные Цикл
		Если Помещенный.ПомещениеФайлаОтменено Тогда
			Продолжить;
		КонецЕсли;
		Файлы.Добавить(Новый Структура("Имя, Адрес", Помещенный.СсылкаНаФайл.Имя, Помещенный.Адрес));
	КонецЦикла;
	Результат = ЗагрузитьНаСервере(Файлы);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПодготовитьФотоНаСервере()

	Фото = Обработки.УЗ_ОбработкаФото.ФайлыФотографий();
	Итог = Новый Структура("Файлы, Пропущено", Новый Массив, "");
	Если Фото.Пропущено.Количество() > 0 Тогда
		Итог.Пропущено = Символы.ПС + "Не прочитаны как картинка: " + СтрСоединить(Фото.Пропущено, ", ") + ".";
	КонецЕсли;
	Для Каждого ФайлФото Из Фото.Файлы Цикл
		Адрес = ПоместитьВоВременноеХранилище(ФайлФото.Данные, УникальныйИдентификатор);
		Итог.Файлы.Добавить(Новый Структура("Имя, Адрес", ФайлФото.ИмяФайла, Адрес));
	КонецЦикла;
	Возврат Итог;

КонецФункции

&НаСервере
Функция ЗагрузитьНаСервере(Знач Файлы)

	Загружено = 0;
	НеНайдены = Новый Массив;
	Отказы = Новый Массив;
	Для Каждого Файл Из Файлы Цикл
		Данные = ПолучитьИзВременногоХранилища(Файл.Адрес);
		УдалитьИзВременногоХранилища(Файл.Адрес);
		Причина = "";
		Если Обработки.УЗ_ОбработкаФото.ЗагрузитьФото(Файл.Имя, Данные, Причина) > 0 Тогда
			Загружено = Загружено + 1;
		ИначеЕсли ПустаяСтрока(Причина) Тогда
			НеНайдены.Добавить(Файл.Имя);
		Иначе
			Отказы.Добавить(Файл.Имя + ": " + Причина);
		КонецЕсли;
	КонецЦикла;

	Текст = СтрШаблон("Загружено фотографий: %1 из %2.", Загружено, Файлы.Количество());
	Если НеНайдены.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "Нет фото с таким наименованием: " + СтрСоединить(НеНайдены, ", ") + ".";
	КонецЕсли;
	Если Отказы.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "Не загружены: " + СтрСоединить(Отказы, "; ") + ".";
	КонецЕсли;
	Возврат Текст;

КонецФункции

#КонецОбласти
