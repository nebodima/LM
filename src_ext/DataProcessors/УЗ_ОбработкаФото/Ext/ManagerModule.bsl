#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Все фотографии справочника «Фото» файлами в их собственном формате (имя файла — наименование фото и код в
// квадратных скобках: по коду загрузка находит именно это фото, а не тёзку;
// расширение — по формату картинки: jpg, png, …). Формат не меняем: на сервере платформа не умеет
// преобразовывать PNG в JPG («Не поддерживается преобразование форматов»).
// Работает в памяти, без файлов на диске сервера (расширение работает в безопасном режиме): форма кладёт
// данные во временное хранилище и отдаёт пользователю через ПолучитьФайлыССервераАсинх (и в веб-клиенте).
//
// Возвращаемое значение:
//   Структура - Файлы (Массив из Структура: ИмяФайла — Строка, Данные — ДвоичныеДанные),
//               Пропущено (Массив из Строка — наименования, которые не удалось прочитать как картинку).
//
Функция ФайлыФотографий() Экспорт

	//массовая выгрузка фото учеников (персональные данные) — только руководителю: без права на обработку
	//отказ с записью в журнал регистрации, даже если функцию позвали мимо формы
	ВыполнитьПроверкуПравДоступа("Использование", Метаданные.Обработки.УЗ_ОбработкаФото);
	Результат = Новый Структура("Файлы, Пропущено", Новый Массив, Новый Массив);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Фото.Наименование КАК Наименование,
	|	Фото.Код КАК Код,
	|	Фото.Файл КАК Файл
	|ИЗ
	|	Справочник.УЗ_Фото КАК Фото
	|ГДЕ
	|	НЕ Фото.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Выборка = Запрос.Выполнить().Выбрать();

	ЗанятыеИмена = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Содержимое = ?(Выборка.Файл = Неопределено, Неопределено, Выборка.Файл.Получить());
		Если Содержимое = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Если ТипЗнч(Содержимое) = Тип("Картинка") Тогда
				Картинка = Содержимое;
				Данные = Картинка.ПолучитьДвоичныеДанные();
			Иначе
				Картинка = Новый Картинка(Содержимое);
				Данные = Содержимое;
			КонецЕсли;
			Расширение = РасширениеКартинки(Картинка.Формат());
		Исключение
			//честно: не картинка — файл уходит в «Пропущено» строкой ниже, человек увидит его в итоге
			Расширение = "";
		КонецПопытки;
		Если Не ЗначениеЗаполнено(Расширение) Или ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
			Результат.Пропущено.Добавить(Выборка.Наименование);
			Продолжить;
		КонецЕсли;
		ИмяФайла = СвободноеИмяФайла(СтрШаблон("%1 [%2]", СокрЛП(Выборка.Наименование), Формат(Выборка.Код, "ЧГ=")),
			ЗанятыеИмена) + "." + Расширение;
		Результат.Файлы.Добавить(Новый Структура("ИмяФайла, Данные", ИмяФайла, Данные));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заменяет картинку одного элемента справочника «Фото»: по коду в квадратных скобках в конце имени файла (так
// называет файлы выгрузка), без кода — по наименованию, равному имени файла без расширения. Помеченные на удаление
// не трогаем; под имя подходят несколько фото (тёзки, братья и сёстры) — не загружаем ни одно (L5-08).
//
// Параметры:
//   ИмяФайла - Строка - имя файла с расширением (как его выбрал пользователь, без пути).
//   Данные - ДвоичныеДанные - содержимое файла.
//   Причина - Строка - (возврат) почему не загружено: не картинка, слишком большой файл, фото не одно.
//
// Возвращаемое значение:
//   Число - сколько элементов справочника обновлено: 1 или 0.
//
Функция ЗагрузитьФото(Знач ИмяФайла, Данные, Причина = "") Экспорт

	ВыполнитьПроверкуПравДоступа("Использование", Метаданные.Обработки.УЗ_ОбработкаФото);
	Причина = "";
	Наименование = ИмяБезРасширения(ИмяФайла);
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Возврат 0;
	КонецЕсли;
	Причина = Справочники.УЗ_Фото.ПричинаНеПодходит(Данные);
	Если Не ПустаяСтрока(Причина) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Код = КодИзИмени(Наименование);
	Если Код > 0 Тогда
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	Фото.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.УЗ_Фото КАК Фото
		|ГДЕ
		|	Фото.Код = &Код
		|	И НЕ Фото.ПометкаУдаления";
		Запрос.УстановитьПараметр("Код", Код);
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	Фото.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.УЗ_Фото КАК Фото
		|ГДЕ
		|	Фото.Наименование = &Наименование
		|	И НЕ Фото.ПометкаУдаления";
		Запрос.УстановитьПараметр("Наименование", Наименование);
	КонецЕсли;
	Найдено = Запрос.Выполнить().Выгрузить();
	Если Найдено.Количество() > 1 Тогда
		Причина = НСтр("ru = 'фото с таким наименованием несколько — выгрузите фото и загрузите файл с кодом в имени'");
		Возврат 0;
	ИначеЕсли Найдено.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	ФотоОбъект = Найдено[0].Ссылка.ПолучитьОбъект();
	ФотоОбъект.Файл = Новый ХранилищеЗначения(Данные);
	ФотоОбъект.Записать();
	Возврат 1;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//Код фото из имени файла «Наименование [код]»; 0 — кода в имени нет.
Функция КодИзИмени(Имя)

	Если Не СтрЗаканчиваетсяНа(Имя, "]") Тогда
		Возврат 0;
	КонецЕсли;
	Начало = СтрНайти(Имя, "[", НаправлениеПоиска.СКонца);
	Цифры = Сред(Имя, Начало + 1, СтрДлина(Имя) - Начало - 1);
	Если Начало = 0 Или ПустаяСтрока(Цифры) Или Не ТолькоЦифры(Цифры) Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Число(Цифры);

КонецФункции

Функция ТолькоЦифры(Строка)

	Для Поз = 1 По СтрДлина(Строка) Цикл
		Если СтрНайти("0123456789", Сред(Строка, Поз, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция СвободноеИмяФайла(Знач Наименование, ЗанятыеИмена)

	Имя = СокрЛП(Наименование);
	Для Каждого Запрещенный Из СтрРазделить("\ / : * ? "" < > |", " ") Цикл
		Имя = СтрЗаменить(Имя, Запрещенный, "_");
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Имя) Тогда
		Имя = "фото";
	КонецЕсли;
	Кандидат = Имя;
	НомерКопии = 1;
	Пока ЗанятыеИмена[НРег(Кандидат)] <> Неопределено Цикл
		НомерКопии = НомерКопии + 1;
		Кандидат = СтрШаблон("%1 (%2)", Имя, НомерКопии);
	КонецЦикла;
	ЗанятыеИмена.Вставить(НРег(Кандидат), Истина);
	Возврат Кандидат;

КонецФункции

Функция РасширениеКартинки(Формат)

	Если Формат = ФорматКартинки.JPEG Тогда
		Возврат "jpg";
	ИначеЕсли Формат = ФорматКартинки.PNG Тогда
		Возврат "png";
	ИначеЕсли Формат = ФорматКартинки.GIF Тогда
		Возврат "gif";
	ИначеЕсли Формат = ФорматКартинки.BMP Тогда
		Возврат "bmp";
	ИначеЕсли Формат = ФорматКартинки.TIFF Тогда
		Возврат "tif";
	ИначеЕсли Формат = ФорматКартинки.SVG Тогда
		Возврат "svg";
	ИначеЕсли Формат = ФорматКартинки.Icon Тогда
		Возврат "ico";
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ИмяБезРасширения(Знач ИмяФайла)

	ИмяФайла = СокрЛП(ИмяФайла);
	Позиция = СтрНайти(ИмяФайла, ".", НаправлениеПоиска.СКонца);
	Возврат ?(Позиция > 1, Лев(ИмяФайла, Позиция - 1), ИмяФайла);

КонецФункции

#КонецОбласти

#КонецЕсли
