//Закрытие смены — мост в учёт программы (docs/мост_в_учёт_хозяина.md). Вкладка «Деньги»: приходы и возвраты денег
//учеников за период и их кассовые документы в программе — оформить «за день» или «каждым документом». Вкладка «Люди»:
//плательщики, педагоги и кассы, их связь с контрагентами, сотрудниками (физлицами) и кассами программы. Вкладка
//«Зарплата» (Бухгалтерия, УНФ): черновики начисления зарплаты и ведомостей в кассу для бухгалтера. Вкладка «Сверка»:
//что изменили в программе после оформления (сумма, контрагент, удалён, не проведён). Связь хранит
//регистр «Связи с учётом программы»; поиск, создание, оформление — УЗ_СредаМост.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НачалоПериода = НачалоДня(ТекущаяДатаСеанса());
	КонецПериода = НачалоПериода;
	ТолькоНесвязанные = Истина;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация = РегистрыСведений.УЗ_Настройки.Настройки().Организация;
	КонецЕсли;
	Возможно = УЗ_СредаМост.Возможности();
	СправочникПлательщиков = ?(Возможно.Контрагенты, "Контрагенты", "");
	СправочникПедагогов = Возможно.СправочникПедагогов;
	СправочникКасс = УЗ_СредаМост.СправочникДляСвязи(УЗ_СредаМост.РольКасса());
	Режим = УЗ_СредаМост.РежимЗаДень();
	Элементы.СтраницаЗарплата.Видимость = Возможно.Зарплата;
	ЗаполнитьДанные();

КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)

	Если ПустаяСтрока(Режим) Тогда
		Режим = УЗ_СредаМост.РежимЗаДень();
	КонецЕсли;
	ЗаполнитьДанные();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)

	ЗаполнитьДанные();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеньги

&НаКлиенте
Процедура ДеньгиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Движение = Деньги.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Движение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Поле = Элементы.ДеньгиОбъектХозяина И ЗначениеЗаполнено(Движение.ОбъектХозяина) Тогда
		ПоказатьЗначение(, Движение.ОбъектХозяина);
	ИначеЕсли Поле = Элементы.ДеньгиПлательщик И ЗначениеЗаполнено(Движение.Плательщик) Тогда
		ПоказатьЗначение(, Движение.Плательщик);
	Иначе
		ПоказатьЗначение(, Движение.Документ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗарплата

&НаКлиенте
Процедура ЗарплатаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Движение = Зарплата.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Движение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Поле = Элементы.ЗарплатаОбъектХозяина И ЗначениеЗаполнено(Движение.ОбъектХозяина) Тогда
		ПоказатьЗначение(, Движение.ОбъектХозяина);
	ИначеЕсли Поле = Элементы.ЗарплатаДокумент И ЗначениеЗаполнено(Движение.Документ) Тогда
		ПоказатьЗначение(, Движение.Документ);
	Иначе
		ПоказатьЗначение(, Движение.Педагог);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСверка

&НаКлиенте
Процедура СверкаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Расхождение = Сверка.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Расхождение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если (Поле = Элементы.СверкаОбъектХозяина Или Не ЗначениеЗаполнено(Расхождение.Объект))
		И ЗначениеЗаполнено(Расхождение.ОбъектХозяина) Тогда
		ПоказатьЗначение(, Расхождение.ОбъектХозяина);
	ИначеЕсли ЗначениеЗаполнено(Расхождение.Объект) Тогда
		ПоказатьЗначение(, Расхождение.Объект);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЛюди

&НаКлиенте
Процедура ЛюдиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Человек = Люди.НайтиПоИдентификатору(ВыбраннаяСтрока);
	Если Человек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Поле = Элементы.ЛюдиОбъектХозяина И ЗначениеЗаполнено(Человек.ОбъектХозяина) Тогда
		ПоказатьЗначение(, Человек.ОбъектХозяина);
	ИначеЕсли Поле = Элементы.ЛюдиКандидат И ЗначениеЗаполнено(Человек.Кандидат) Тогда
		ПоказатьЗначение(, Человек.Кандидат);
	Иначе
		ПоказатьЗначение(, Человек.ФизЛицо);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	ЗаполнитьДанные();

КонецПроцедуры

&НаКлиенте
Процедура ОформитьВыделенные(Команда)

	НашиДокументы = Новый Массив;
	Для Каждого Идентификатор Из Элементы.Деньги.ВыделенныеСтроки Цикл
		НашиДокументы.Добавить(Деньги.НайтиПоИдентификатору(Идентификатор).Документ);
	КонецЦикла;
	Если НашиДокументы.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выделите строки в таблице «Деньги».'"));
		Возврат;
	КонецЕсли;
	ОформитьНаСервере(НашиДокументы);

КонецПроцедуры

&НаКлиенте
Процедура ОформитьВсе(Команда)

	НашиДокументы = Новый Массив;
	Для Каждого Движение Из Деньги Цикл
		НашиДокументы.Добавить(Движение.Документ);
	КонецЦикла;
	Если НашиДокументы.Количество() > 0 Тогда
		ОформитьНаСервере(НашиДокументы);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОформитьЗарплату(Команда)

	ОформитьЗарплатуНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Подобрать(Команда)

	Строки = ВыделенныеСтроки();
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ПодобратьНаСервере(Строки);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьВПрограмме(Команда)

	Строки = ВыделенныеСтроки();
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	СоздатьНаСервере(Строки);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВПрограмме(Команда)

	Человек = Элементы.Люди.ТекущиеДанные;
	Если Человек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИмяСправочника = ?(Человек.Роль = РольПедагог, СправочникПедагогов, СправочникПлательщиков);
	Если ТипЗнч(Человек.ФизЛицо) = Тип("СправочникСсылка.УЗ_Кассы") Тогда
		ИмяСправочника = СправочникКасс;
	КонецЕсли;
	Если ПустаяСтрока(ИмяСправочника) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'В программе нет справочника для связи с этим человеком.'"));
		Возврат;
	КонецЕсли;
	ОткрытьФорму("Справочник." + ИмяСправочника + ".ФормаВыбора", Новый Структура("ТекущаяСтрока", Человек.Кандидат),
		ЭтаФорма, , , , Новый ОписаниеОповещения("ВыбратьВПрограммеЗавершение", ЭтотОбъект,
			Элементы.Люди.ТекущаяСтрока), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

//Выбран элемент справочника программы — связь с текущей строкой.
&НаКлиенте
Процедура ВыбратьВПрограммеЗавершение(Выбранное, Идентификатор) Экспорт

	Если Выбранное <> Неопределено Тогда
		СвязатьНаСервере(Идентификатор, Выбранное);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Отвязать(Команда)

	Строки = ВыделенныеСтроки();
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ОтвязатьНаСервере(Строки);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ВыделенныеСтроки()

	Строки = Новый Массив;
	Для Каждого Идентификатор Из Элементы.Люди.ВыделенныеСтроки Цикл
		Строки.Добавить(Идентификатор);
	КонецЦикла;
	Если Строки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выделите строки в таблице «Люди».'"));
	КонецЕсли;
	Возврат Строки;

КонецФункции

//Обе вкладки за период: в «Состоянии» — сводка по деньгам и людям.
&НаСервере
Процедура ЗаполнитьДанные()

	Если Не ЗначениеЗаполнено(КонецПериода) Или КонецПериода < НачалоПериода Тогда
		КонецПериода = НачалоПериода;
	КонецЕсли;
	ЗаполнитьЛюдей();
	ЗаполнитьЗарплату();
	ЗаполнитьДеньги();
	ЗаполнитьСверку();

КонецПроцедуры

//Расхождения с программой за период — в начало сводки.
&НаСервере
Процедура ЗаполнитьСверку()

	Сверка.Загрузить(УЗ_СредаМост.Расхождения(Организация, Касса, НачалоПериода, КонецДня(КонецПериода)));
	Элементы.СтраницаСверка.Заголовок = ?(Сверка.Количество() = 0, НСтр("ru = 'Сверка'"),
		СтрШаблон(НСтр("ru = 'Сверка (%1)'"), Сверка.Количество()));
	Если Сверка.Количество() > 0 Тогда
		Состояние = СтрШаблон(НСтр("ru = 'Расхождений с программой: %1 — вкладка «Сверка».'"), Сверка.Количество())
			+ " " + Состояние;
	КонецЕсли;

КонецПроцедуры

//Зарплата месяцев периода (Бухгалтерия, УНФ).
&НаСервере
Процедура ЗаполнитьЗарплату()

	Если Не Элементы.СтраницаЗарплата.Видимость Тогда
		Возврат;
	КонецЕсли;
	Зарплата.Загрузить(УЗ_СредаМост.ЗарплатаДляОформления(Организация, НачалоПериода, КонецДня(КонецПериода)));
	Ждут = 0;
	Для Каждого Движение Из Зарплата Цикл
		Если Движение.МожноОформить Тогда
			Ждут = Ждут + 1;
		КонецЕсли;
	КонецЦикла;
	Если Ждут > 0 Тогда
		Состояние = СтрШаблон(НСтр("ru = 'Зарплата: ждут черновиков в программе — %1.'"), Ждут) + " " + Состояние;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОформитьЗарплатуНаСервере()

	Итог = УЗ_СредаМост.ОформитьЗарплату(Организация, НачалоПериода, КонецДня(КонецПериода));
	ЗаполнитьДанные();
	Для Каждого Ошибка Из Итог.Ошибки Цикл
		Найденные = Зарплата.НайтиСтроки(Новый Структура("Педагог", Ошибка.Объект));
		Если Найденные.Количество() = 0 Тогда
			Найденные = Зарплата.НайтиСтроки(Новый Структура("Документ", Ошибка.Объект));
		КонецЕсли;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон("%1: %2", Ошибка.Объект, Ошибка.Текст);
		Если Найденные.Количество() > 0 Тогда
			Сообщение.Поле = СтрШаблон("Зарплата[%1].Педагог", Зарплата.Индекс(Найденные[0]));
		КонецЕсли;
		Сообщение.Сообщить();
	КонецЦикла;
	Состояние = СтрШаблон(НСтр("ru = 'Черновиков зарплаты в программе: %1, ошибок: %2. '"), Итог.Оформлено,
		Итог.Ошибки.Количество()) + Состояние;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеньги()

	Деньги.Загрузить(УЗ_СредаМост.ДеньгиДляОформления(Организация, Касса, НачалоПериода, КонецДня(КонецПериода),
		Режим));
	Ждут = 0;
	СуммаЖдут = 0;
	Для Каждого Движение Из Деньги Цикл
		Если Движение.МожноОформить Тогда
			Ждут = Ждут + 1;
			СуммаЖдут = СуммаЖдут + Движение.Сумма;
		КонецЕсли;
	КонецЦикла;
	Если Ждут > 0 Тогда
		Сводка = СтрШаблон(НСтр("ru = 'Ждут оформления в программе: %1 на %2.'"), Ждут,
			Формат(СуммаЖдут, "ЧДЦ=2; ЧН=0"));
	ИначеЕсли Деньги.Количество() > 0 Тогда
		Сводка = НСтр("ru = 'Деньги периода оформлены в программе.'");
	Иначе
		Сводка = НСтр("ru = 'Денег учеников за период нет.'");
	КонецЕсли;
	Состояние = Сводка + " " + Состояние;

КонецПроцедуры

&НаСервере
Процедура ОформитьНаСервере(НашиДокументы)

	Итог = УЗ_СредаМост.Оформить(НашиДокументы, Режим);
	ЗаполнитьДанные();
	Для Каждого Ошибка Из Итог.Ошибки Цикл
		Найденные = Деньги.НайтиСтроки(Новый Структура("Документ", Ошибка.Документ));
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон("%1: %2", Ошибка.Документ, Ошибка.Текст);
		Если Найденные.Количество() > 0 Тогда
			Сообщение.Поле = СтрШаблон("Деньги[%1].Документ", Деньги.Индекс(Найденные[0]));
		КонецЕсли;
		Сообщение.Сообщить();
	КонецЦикла;
	Состояние = СтрШаблон(НСтр("ru = 'Оформлено документов программы: %1, ошибок: %2. '"), Итог.Оформлено,
		Итог.Ошибки.Количество()) + Состояние;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЛюдей()

	РольПедагог = УЗ_СредаМост.РольПедагог();
	Люди.Загрузить(УЗ_СредаМост.ЛюдиДляСвязи(Организация, НачалоПериода, КонецДня(КонецПериода), ТолькоНесвязанные));
	Несвязанных = 0;
	Для Каждого Человек Из Люди Цикл
		Если Не ЗначениеЗаполнено(Человек.ОбъектХозяина) Тогда
			Несвязанных = Несвязанных + 1;
		КонецЕсли;
	КонецЦикла;
	Если Несвязанных > 0 Тогда
		Состояние = СтрШаблон(НСтр("ru = 'Не связаны с программой: %1 (вкладка «Люди»). «Подобрать» связывает "
			+ "найденных по ИНН или ФИО, «Выбрать в программе» — с выбранным вручную, «Создать в программе» заводит "
			+ "контрагента.'"), Несвязанных);
	Иначе
		Состояние = НСтр("ru = 'Плательщики, педагоги и кассы связаны с программой.'");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПодобратьНаСервере(Строки)

	Связано = 0;
	Для Каждого Идентификатор Из Строки Цикл
		Человек = Люди.НайтиПоИдентификатору(Идентификатор);
		Если Человек = Неопределено Или ЗначениеЗаполнено(Человек.ОбъектХозяина) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Человек.Кандидат) Тогда
			СообщитьУСтроки(Человек, СтрШаблон(НСтр("ru = '%1: в программе не найден однозначно — выберите вручную "
				+ "(«Выбрать в программе») или создайте.'"), Человек.ФизЛицо));
			Продолжить;
		КонецЕсли;
		Ошибка = УЗ_СредаМост.Связать(Человек.ФизЛицо, Человек.Роль, Человек.Кандидат);
		Если ПустаяСтрока(Ошибка) Тогда
			Связано = Связано + 1;
		Иначе
			СообщитьУСтроки(Человек, Ошибка);
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьДанные();
	Если Связано > 0 Тогда
		Состояние = СтрШаблон(НСтр("ru = 'Связано: %1. '"), Связано) + Состояние;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СоздатьНаСервере(Строки)

	Создано = 0;
	Для Каждого Идентификатор Из Строки Цикл
		Человек = Люди.НайтиПоИдентификатору(Идентификатор);
		Если Человек = Неопределено Или ЗначениеЗаполнено(Человек.ОбъектХозяина) Тогда
			Продолжить;
		КонецЕсли;
		Создание = УЗ_СредаМост.СоздатьУХозяина(Человек.ФизЛицо, Человек.Роль);
		Если ПустаяСтрока(Создание.Ошибка) Тогда
			Создано = Создано + 1;
		Иначе
			СообщитьУСтроки(Человек, СтрШаблон("%1: %2", Человек.ФизЛицо, Создание.Ошибка));
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьДанные();
	Если Создано > 0 Тогда
		Состояние = СтрШаблон(НСтр("ru = 'Создано и связано: %1. '"), Создано) + Состояние;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СвязатьНаСервере(Идентификатор, Выбранное)

	Человек = Люди.НайтиПоИдентификатору(Идентификатор);
	Если Человек = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ошибка = УЗ_СредаМост.Связать(Человек.ФизЛицо, Человек.Роль, Выбранное);
	Если Не ПустаяСтрока(Ошибка) Тогда
		СообщитьУСтроки(Человек, Ошибка);
		Возврат;
	КонецЕсли;
	ЗаполнитьДанные();

КонецПроцедуры

&НаСервере
Процедура ОтвязатьНаСервере(Строки)

	Для Каждого Идентификатор Из Строки Цикл
		Человек = Люди.НайтиПоИдентификатору(Идентификатор);
		Если Человек <> Неопределено И ЗначениеЗаполнено(Человек.ОбъектХозяина) Тогда
			УЗ_СредаМост.Отвязать(Человек.ФизЛицо, Человек.Роль);
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьДанные();

КонецПроцедуры

&НаСервере
Процедура СообщитьУСтроки(Человек, Текст)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = СтрШаблон("Люди[%1].ФизЛицо", Люди.Индекс(Человек));
	Сообщение.Сообщить();

КонецПроцедуры

