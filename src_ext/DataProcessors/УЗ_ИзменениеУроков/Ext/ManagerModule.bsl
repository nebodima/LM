
//Массовое изменение отметок учеников одного урока.
//Изменения — массив структур: Ученик, СписатьОплату, Явка (Неопределено — не менять).
//Меняется только то, что отличается от документа, — признак «изменено» берётся из сравнения с уроком,
//а не из исходных значений формы. Проведённый урок перепроводится: документ и движения меняются
//вместе (раньше обычная запись пересчитывала документ, а списание в регистрах оставалось прежним).
//Урок, который ещё не начался, только записывается (В10). Урок в закрытом периоде не меняется, отказ
//проведения (пересечение педагога/помещения и т.п.) — не исключение: Успех = Ложь, причины в Текст.
//Строка урока — по НомерСтроки, если он есть в изменении (Codex N04: у одного ученика бывает несколько строк —
//разные абонементы или отметки; прежде строка определялась только учеником, и изменение одной строки ложилось на
//все строки ученика). Без НомерСтроки — все строки ученика, как раньше.
//Возврат — структура: Успех, Текст, ИзмененаОплата и ИзмененаЯвка (массивы учеников), СтрокиОплата и СтрокиЯвка
//(массивы номеров изменённых строк).
Функция ИзменитьОтметкиУрока(Урок, Изменения) Экспорт

	Итог = Новый Структура("Успех, Текст, ИзмененаОплата, ИзмененаЯвка, СтрокиОплата, СтрокиЯвка", Истина, "",
		Новый Массив, Новый Массив, Новый Массив, Новый Массив);
	ОбъектУрока = Урок.ПолучитьОбъект();
	Если ОбъектУрока = Неопределено Тогда
		Итог.Успех = Ложь;
		Итог.Текст = НСтр("ru = 'Урок не найден.'");
		Возврат Итог;
	КонецЕсли;

	Описание = Новый Массив;
	Для Каждого Изменение Из Изменения Цикл
		Для Каждого СтрокаУченика Из ОбъектУрока.Ученики Цикл
			Если СтрокаУченика.Ученик <> Изменение.Ученик
				Или Изменение.Свойство("НомерСтроки") И ЗначениеЗаполнено(Изменение.НомерСтроки)
					И СтрокаУченика.НомерСтроки <> Изменение.НомерСтроки Тогда
				Продолжить;
			КонецЕсли;
			Если Изменение.СписатьОплату <> Неопределено И СтрокаУченика.СписатьОплату <> Изменение.СписатьОплату Тогда
				СтрокаУченика.СписатьОплату = Изменение.СписатьОплату;
				Итог.ИзмененаОплата.Добавить(Изменение.Ученик);
				Итог.СтрокиОплата.Добавить(СтрокаУченика.НомерСтроки);
				Описание.Добавить(СтрШаблон(НСтр("ru = '%1: к оплате — %2'"), Изменение.Ученик, Формат(Изменение.СписатьОплату, "БЛ=нет; БИ=да")));
			КонецЕсли;
			Если Изменение.Явка <> Неопределено И СтрокаУченика.Явка <> Изменение.Явка Тогда
				СтрокаУченика.Явка = Изменение.Явка;
				Итог.ИзмененаЯвка.Добавить(Изменение.Ученик);
				Итог.СтрокиЯвка.Добавить(СтрокаУченика.НомерСтроки);
				Описание.Добавить(СтрШаблон(НСтр("ru = '%1: явка — %2'"), Изменение.Ученик, Формат(Изменение.Явка, "БЛ=нет; БИ=да")));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если Описание.Количество() = 0 Тогда
		Итог.Текст = НСтр("ru = 'Без изменений.'");
		Возврат Итог;
	КонецЕсли;

	Причина = УЗ_ДатыЗапрета.ПричинаЗапрета(ОбъектУрока);
	Если Причина <> "" Тогда
		Итог.Успех = Ложь;
		Итог.Текст = Причина;
		Возврат Итог;
	КонецЕсли;

	//урок, который ещё не начался, не проводится (решение В10): будущий — только записывается, а проведённый
	//когда-то раньше — распроводится; начавшийся проведённый — перепроводится
	Если ОбъектУрока.Дата > ТекущаяДатаСеанса() Тогда
		РежимЗаписи = ?(ОбъектУрока.Проведен, РежимЗаписиДокумента.ОтменаПроведения, РежимЗаписиДокумента.Запись);
	Иначе
		РежимЗаписи = ?(ОбъектУрока.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
	КонецЕсли;
	//отказ проведения (пересечение педагога или помещения, абонемент…) — причины из сообщений в ответ,
	//а не исключение на всю обработку
	СообщенийДо = ПолучитьСообщенияПользователю(Ложь).Количество();
	Попытка
		ОбъектУрока.Записать(РежимЗаписи);
	Исключение
		Причины = Новый Массив;
		Сообщения = ПолучитьСообщенияПользователю(Ложь);
		Для Номер = СообщенийДо По Сообщения.Количество() - 1 Цикл
			Причины.Добавить(Сообщения[Номер].Текст);
		КонецЦикла;
		Если Причины.Количество() = 0 Тогда
			Причины.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецЕсли;
		Итог.Успех = Ложь;
		Итог.Текст = НСтр("ru = 'Урок не изменён: '") + СтрСоединить(Причины, " ");
		Возврат Итог;
	КонецПопытки;

	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		Действие = НСтр("ru = 'Перепроведён'");
	ИначеЕсли ОбъектУрока.Дата > ТекущаяДатаСеанса() Тогда
		Действие = НСтр("ru = 'Урок ещё не начался — записан без проведения'");
	Иначе
		Действие = НСтр("ru = 'Записан'");
	КонецЕсли;
	Итог.Текст = СтрШаблон(НСтр("ru = '%1 %2: %3'"), Действие, Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"), СтрСоединить(Описание, "; "));
	Возврат Итог;
КонецФункции
