
//Массовое изменение отметок учеников одного урока.
//Изменения — массив структур: Ученик, СписатьОплату, Явка (Неопределено — не менять).
//Меняется только то, что отличается от документа, — признак «изменено» берётся из сравнения с уроком,
//а не из исходных значений формы. Проведённый урок перепроводится: документ и движения меняются
//вместе (раньше обычная запись пересчитывала документ, а списание в регистрах оставалось прежним).
//Урок в закрытом периоде не меняется — причина в ответе.
//Возврат — структура: Успех, Текст, ИзмененаОплата и ИзмененаЯвка (массивы учеников).
Функция ИзменитьОтметкиУрока(Урок, Изменения) Экспорт

	Итог = Новый Структура("Успех, Текст, ИзмененаОплата, ИзмененаЯвка", Истина, "", Новый Массив, Новый Массив);
	ОбъектУрока = Урок.ПолучитьОбъект();
	Если ОбъектУрока = Неопределено Тогда
		Итог.Успех = Ложь;
		Итог.Текст = НСтр("ru = 'Урок не найден.'");
		Возврат Итог;
	КонецЕсли;

	Описание = Новый Массив;
	Для Каждого Изменение Из Изменения Цикл
		Для Каждого СтрокаУченика Из ОбъектУрока.Ученики Цикл
			Если СтрокаУченика.Ученик <> Изменение.Ученик Тогда
				Продолжить;
			КонецЕсли;
			Если Изменение.СписатьОплату <> Неопределено И СтрокаУченика.СписатьОплату <> Изменение.СписатьОплату Тогда
				СтрокаУченика.СписатьОплату = Изменение.СписатьОплату;
				Итог.ИзмененаОплата.Добавить(Изменение.Ученик);
				Описание.Добавить(СтрШаблон(НСтр("ru = '%1: к оплате — %2'"), Изменение.Ученик, Формат(Изменение.СписатьОплату, "БЛ=нет; БИ=да")));
			КонецЕсли;
			Если Изменение.Явка <> Неопределено И СтрокаУченика.Явка <> Изменение.Явка Тогда
				СтрокаУченика.Явка = Изменение.Явка;
				Итог.ИзмененаЯвка.Добавить(Изменение.Ученик);
				Описание.Добавить(СтрШаблон(НСтр("ru = '%1: явка — %2'"), Изменение.Ученик, Формат(Изменение.Явка, "БЛ=нет; БИ=да")));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если Описание.Количество() = 0 Тогда
		Итог.Текст = НСтр("ru = 'Без изменений.'");
		Возврат Итог;
	КонецЕсли;

	Причина = УЗ_ДатыЗапрета.ПричинаЗапрета(ОбъектУрока);
	Если Причина <> "" Тогда
		Итог.Успех = Ложь;
		Итог.Текст = Причина;
		Возврат Итог;
	КонецЕсли;

	РежимЗаписи = ?(ОбъектУрока.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
	Попытка
		ОбъектУрока.Записать(РежимЗаписи);
	Исключение
		Итог.Успех = Ложь;
		Итог.Текст = НСтр("ru = 'Урок не записан: '") + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Итог;
	КонецПопытки;

	Итог.Текст = СтрШаблон(НСтр("ru = '%1 %2: %3'"),
		?(РежимЗаписи = РежимЗаписиДокумента.Проведение, НСтр("ru = 'Перепроведён'"), НСтр("ru = 'Записан'")),
		Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"), СтрСоединить(Описание, "; "));
	Возврат Итог;

КонецФункции
