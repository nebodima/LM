#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет планировщик календаря уроками периода. Один пакетный запрос: уроки периода с отборами (ВТ),
// их подписи и цвета, ученики этих уроков, помещения-измерения и дни с уроками для календаря слева.
// Прежде в цикле по урокам читались объекты через точку (Уроки.Ссылка.Ученики, .Проведен, .Помещение.Цвет …) —
// по объекту на урок, и занятые даты считались отдельным серверным вызовом, дважды за открытие.
// Логика здесь, а не в модуле формы, — её же вызывает замер tools\нагрузка\замеры.py (раздел «календарь»).
//
// Параметры:
//   Планировщик - Планировщик - реквизит формы или новый планировщик (замер);
//   Параметры - Структура - см. НовыеПараметры().
// Возвращаемое значение:
//   Структура - Уроков (Число), ЗанятыеДаты (Массив из Дата — начала дней с уроками, месяц до и после ДатаКалендаря).
//
Функция ЗаполнитьПланировщик(Планировщик, Параметры) Экспорт

	ЭлементыПланировщика = Планировщик.Элементы;
	ЭлементыПланировщика.Очистить();
	Планировщик.Измерения.Очистить();
	Планировщик.ИнтервалыФона.Очистить();

	Запрос = Новый Запрос(ТекстЗапросаКалендаря());
	УстановитьПараметрыОтборов(Запрос, Параметры);
	Запрос.УстановитьПараметр("ДатаНачала", Параметры.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Параметры.ДатаОкончания);
	Запрос.УстановитьПараметр("ОтборСтатус", ЗначениеЗаполнено(Параметры.СтатусУрока));
	Запрос.УстановитьПараметр("Статус", Параметры.СтатусУрока);
	Запрос.УстановитьПараметр("ОтборУченик", ЗначениеЗаполнено(Параметры.ФильтрУченик));
	Запрос.УстановитьПараметр("Ученик", Параметры.ФильтрУченик);
	Запрос.УстановитьПараметр("СУчениками", Параметры.ПодписьУченики);
	Запрос.УстановитьПараметр("ИзмеренияПомещений", Параметры.ГруппироватьПомещения);
	Запрос.УстановитьПараметр("ВсеПомещения", Параметры.ОтображатьВсеПомещения);
	Результаты = Запрос.ВыполнитьПакет();
	// 0 — ВТ уроков, 1 — уроки, 2 — ученики, 3 — помещения, 4 — занятые даты

	Если Параметры.ГруппироватьПомещения Тогда
		НовИзмерение = Планировщик.Измерения.Добавить("Помещение");
		Помещения = Результаты[3].Выбрать();
		Пока Помещения.Следующий() Цикл
			НовЭл = НовИзмерение.Элементы.Добавить(Помещения.Помещение);
			НовЭл.Текст = ?(ЗначениеЗаполнено(Помещения.Помещение), Помещения.Порядок, "Без помещения");
			Если ЗначениеЗаполнено(Помещения.Цвет) Тогда
				НовЭл.ЦветФона = УЗ_ОбщийКлиентСервер.WebЦветПоИмени(СокрЛП(Помещения.Цвет));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	УченикиУроков = Новый Соответствие;
	Ученики = Результаты[2].Выбрать();
	Пока Ученики.Следующий() Цикл
		Имена = УченикиУроков.Получить(Ученики.Ссылка);
		Если Имена = Неопределено Тогда
			Имена = Новый Массив;
			УченикиУроков.Вставить(Ученики.Ссылка, Имена);
		КонецЕсли;
		Имена.Добавить(УЗ_ОбщийКлиентСервер.КраткоеФИО(Ученики.Ученик));
	КонецЦикла;

	ЦветТекста = УЗ_ОбщийКлиентСервер.ЦветТекстаНаЗаливке();
	ЦветЛиний = УЗ_ОбщийКлиентСервер.ЦветЛинийСетки();
	ПустойЦвет = Новый Цвет;
	Количество = 0;
	Уроки = Результаты[1].Выбрать();
	Пока Уроки.Следующий() Цикл

		Количество = Количество + 1;
		Начало = Уроки.Дата;
		Конец = Начало + Окр(Уроки.КоличествоЧасов * 60) * 60; //В13: до минуты
		НовыйЭлемент = ЭлементыПланировщика.Добавить(Начало, Конец);

		//подпись — по строкам (группа, предмет, педагог «Фамилия И. О.», ученики), чтобы узкий прямоугольник не
		//переносил слова по слогам
		ЧастиПодписи = Новый Массив;
		Если Параметры.ПодписьГруппа И ЗначениеЗаполнено(Уроки.Группа) Тогда
			ЧастиПодписи.Добавить(Уроки.Группа);
		КонецЕсли;
		Если Параметры.ПодписьПредмет И ЗначениеЗаполнено(Уроки.Предмет) Тогда
			ЧастиПодписи.Добавить(Уроки.Предмет);
		КонецЕсли;
		Если Параметры.ПодписьПедагог И ЗначениеЗаполнено(Уроки.ПедагогИмя) Тогда
			ЧастиПодписи.Добавить(УЗ_ОбщийКлиентСервер.КраткоеФИО(Уроки.ПедагогИмя));
		КонецЕсли;
		Имена = УченикиУроков.Получить(Уроки.Ссылка);
		Если Имена <> Неопределено Тогда
			ЧастиПодписи.Добавить(СтрСоединить(Имена, ", "));
		КонецЕсли;
		НовыйЭлемент.Текст = ТекстУрока(СтрСоединить(ЧастиПодписи, Символы.ПС), Уроки);
		НовыйЭлемент.Значение = Уроки.Ссылка;

		//проведённый урок отличим: «✓» в начале подписи и тёмная рамка; записанный планом — светлая рамка
		Если Уроки.Проведен Тогда
			НовыйЭлемент.Текст = "✓ " + НовыйЭлемент.Текст;
			НовыйЭлемент.ЦветРамки = ЦветТекста;
		Иначе
			НовыйЭлемент.ЦветРамки = ЦветЛиний;
		КонецЕсли;
		НовыйЭлемент.ЦветТекста = ЦветТекста;
		НовыйЭлемент.ЦветФона = WebЦвета.СеребристоСерый;
		//цвет помещения/предмета/педагога — по имени веб-цвета; пустое или неизвестное имя — урок остаётся серым
		ИмяЦветаУрока = "";
		Если Параметры.Цвет = "Помещение" Тогда
			ИмяЦветаУрока = Уроки.ЦветПомещения;
		ИначеЕсли Параметры.Цвет = "ПредмОбуч" Тогда
			ИмяЦветаУрока = Уроки.ЦветПредмета;
		ИначеЕсли Параметры.Цвет = "Педагог" Тогда
			ИмяЦветаУрока = Уроки.ЦветПедагога;
		КонецЕсли;
		ЦветУрока = УЗ_ОбщийКлиентСервер.WebЦветПоИмени(ИмяЦветаУрока);
		Если ЦветУрока <> ПустойЦвет Тогда
			НовыйЭлемент.ЦветФона = ЦветУрока;
		КонецЕсли;

		// Связка записей с измерениями выполняется через соответствия
		СоответствиеЗначений = Новый Соответствие;
		СоответствиеЗначений.Вставить("Помещение", Уроки.Помещение);
		СоответствиеЗначений.Вставить("Педагог", Уроки.Педагог);
		НовыйЭлемент.ЗначенияИзмерений = Новый ФиксированноеСоответствие(СоответствиеЗначений);

	КонецЦикла;

	ДобавитьГрафикПедагога(Планировщик, Параметры);
	Если Параметры.ОтображатьНапоминания Тогда
		ДобавитьНапоминания(ЭлементыПланировщика, Параметры);
	КонецЕсли;

	Возврат Новый Структура("Уроков, ЗанятыеДаты", Количество,
		Результаты[4].Выгрузить().ВыгрузитьКолонку("Дата"));

КонецФункции

// Дни с уроками (начала дней) за месяц до и после ДатаКалендаря — жирные даты календаря слева.
// Отборы: педагог, помещение, группа (как прежде; статус и ученик на выделение дней не влияют).
Функция ЗанятыеДаты(Параметры) Экспорт

	Запрос = Новый Запрос(ТекстЗапросаЗанятыхДат());
	УстановитьПараметрыОтборов(Запрос, Параметры);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Дата");

КонецФункции

// Структура параметров ЗаполнитьПланировщик/ЗанятыеДаты с настройками по умолчанию (как у новой формы).
Функция НовыеПараметры(ДатаНачала = '00010101', ДатаОкончания = '00010101') Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("ДатаНачала", ДатаНачала);
	Параметры.Вставить("ДатаОкончания", ДатаОкончания);
	Параметры.Вставить("ДатаКалендаря", ДатаНачала);
	Параметры.Вставить("ФильтрПедагог", Справочники.УЗ_ФизЛица.ПустаяСсылка());
	Параметры.Вставить("ФильтрПомещение", Справочники.УЗ_Помещения.ПустаяСсылка());
	Параметры.Вставить("ФильтрГруппаОбучения", Справочники.УЗ_ГруппыОбучения.ПустаяСсылка());
	Параметры.Вставить("ФильтрУченик", Справочники.УЗ_ФизЛица.ПустаяСсылка());
	Параметры.Вставить("СтатусУрока", Справочники.УЗ_Статусы.ПустаяСсылка());
	Параметры.Вставить("ГруппироватьПомещения", Истина);
	Параметры.Вставить("ОтображатьВсеПомещения", Ложь);
	Параметры.Вставить("ОтображатьНапоминания", Ложь);
	Параметры.Вставить("ПодписьГруппа", Ложь);
	Параметры.Вставить("ПодписьПредмет", Ложь);
	Параметры.Вставить("ПодписьПедагог", Ложь);
	Параметры.Вставить("ПодписьУченики", Ложь);
	Параметры.Вставить("Цвет", "ПредмОбуч");
	Возврат Параметры;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Отборы педагог/помещение/группа — условием с флагом, а не вырезанием строк из текста: текст один на все
// сочетания, и проверка текстов запросов (НайтиПараметры) видит его целиком.
Процедура УстановитьПараметрыОтборов(Запрос, Параметры)

	Запрос.УстановитьПараметр("ОтборПедагог", ЗначениеЗаполнено(Параметры.ФильтрПедагог));
	Запрос.УстановитьПараметр("Педагог", Параметры.ФильтрПедагог);
	Запрос.УстановитьПараметр("ОтборПомещение", ЗначениеЗаполнено(Параметры.ФильтрПомещение));
	Запрос.УстановитьПараметр("Помещение", Параметры.ФильтрПомещение);
	Запрос.УстановитьПараметр("ОтборГруппа", ЗначениеЗаполнено(Параметры.ФильтрГруппаОбучения));
	Запрос.УстановитьПараметр("ГруппаОбучения", Параметры.ФильтрГруппаОбучения);
	ДатаКалендаря = ?(ЗначениеЗаполнено(Параметры.ДатаКалендаря), Параметры.ДатаКалендаря, ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ЗанятыеС", НачалоМесяца(НачалоМесяца(ДатаКалендаря) - 1));
	Запрос.УстановитьПараметр("ЗанятыеПо", КонецМесяца(КонецМесяца(ДатаКалендаря) + 1));

КонецПроцедуры

// Текст прямоугольника урока: выбранные детали; если ни одна не выбрана — предмет (или группа) и педагог.
Функция ТекстУрока(Знач Детали, Урок)

	Текст = СокрЛП(Детали);
	Если ЗначениеЗаполнено(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	Части = Новый Массив;
	Если ЗначениеЗаполнено(Урок.Предмет) Тогда
		Части.Добавить(Урок.Предмет);
	ИначеЕсли ЗначениеЗаполнено(Урок.Группа) Тогда
		Части.Добавить(Урок.Группа);
	Иначе
		Части.Добавить("Урок");
	КонецЕсли;
	Если ЗначениеЗаполнено(Урок.ПедагогИмя) Тогда
		Части.Добавить(УЗ_ОбщийКлиентСервер.КраткоеФИО(Урок.ПедагогИмя));
	КонецЕсли;
	//две строки: «Фортепиано» / «Воронцова Е. С.»
	Возврат СтрСоединить(Части, Символы.ПС);

КонецФункции

// Рабочее время выбранного педагога — фоном планировщика.
Процедура ДобавитьГрафикПедагога(Планировщик, Параметры)

	Если Не ЗначениеЗаполнено(Параметры.ФильтрПедагог) Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГрафикТЧ.Дата КАК Дата,
	|	ГрафикТЧ.ВремяНачала КАК ВремяНачала,
	|	ГрафикТЧ.ВремяОкончания КАК ВремяОкончания
	|ИЗ
	|	Документ.УЗ_ГрафикРабочегоВремениПедагога.ТЧ КАК ГрафикТЧ
	|ГДЕ
	|	ГрафикТЧ.Ссылка.Проведен
	|	И ГрафикТЧ.Ссылка.Педагог = &Педагог
	|	И ГрафикТЧ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания";
	Запрос.УстановитьПараметр("Педагог", Параметры.ФильтрПедагог);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоМесяца(Параметры.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецМесяца(Параметры.ДатаОкончания));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ВыбДатаНачала = Выборка.Дата - ('00010101' - Выборка.ВремяНачала);
		ВыбДатаОкончания = Выборка.Дата - ('00010101' - Выборка.ВремяОкончания);
		Интервал = Планировщик.ИнтервалыФона.Добавить(ВыбДатаНачала, ВыбДатаОкончания);
		Интервал.Цвет = WebЦвета.ДымчатоБелый;
	КонецЦикла;

КонецПроцедуры

// Напоминания и оповещения — свой регистр УЗ_Оповещения (было: НапоминанияПользователя БСП).
// Незавершённые записи текущего пользователя и общие, срок которых попал в период.
Процедура ДобавитьНапоминания(ЭлементыПланировщика, Параметры)

	АдресатыОповещений = Новый Массив;
	АдресатыОповещений.Добавить(Справочники.Пользователи.ПустаяСсылка());
	ТекущийПользователь = УЗ_Среда.ТекущийПользователь();
	Если ЗначениеЗаполнено(ТекущийПользователь) Тогда
		АдресатыОповещений.Добавить(ТекущийПользователь);
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Оповещения.Источник КАК Источник,
	|	Оповещения.ВремяСобытия КАК ВремяСобытия,
	|	Оповещения.Пользователь КАК Пользователь,
	|	Оповещения.Завершено КАК Завершено,
	|	Оповещения.СрокНапоминания КАК СрокНапоминания,
	|	Оповещения.Описание КАК Описание,
	|	Оповещения.Организация КАК Организация
	|ИЗ
	|	РегистрСведений.УЗ_Оповещения КАК Оповещения
	|ГДЕ
	|	НЕ Оповещения.Завершено
	|	И Оповещения.Пользователь В (&Пользователи)
	|	И Оповещения.СрокНапоминания МЕЖДУ &ДатаНачала И &ДатаОкончания";
	Запрос.УстановитьПараметр("Пользователи", АдресатыОповещений);
	Запрос.УстановитьПараметр("ДатаНачала", Параметры.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", Параметры.ДатаОкончания);
	КартинкаНапоминания = БиблиотекаКартинок.ВыполнитьЗадачу;
	Напоминания = Запрос.Выполнить().Выбрать();
	Пока Напоминания.Следующий() Цикл
		//напоминание — получасовой отрезок от срока
		НовыйЭлемент = ЭлементыПланировщика.Добавить(Напоминания.СрокНапоминания, Напоминания.СрокНапоминания + 1800);
		НовыйЭлемент.Текст = ?(ПустаяСтрока(Напоминания.Описание), Строка(Напоминания.Источник), Напоминания.Описание);
		НовыйЭлемент.ЦветФона = WebЦвета.БледноЗолотистый;
		НовыйЭлемент.Картинка = КартинкаНапоминания;
		НовыйЭлемент.Значение = РегистрыСведений.УЗ_Оповещения.СоздатьКлючЗаписи(Новый Структура(
			"Источник, ВремяСобытия, Пользователь, Завершено, Организация",
			Напоминания.Источник, Напоминания.ВремяСобытия, Напоминания.Пользователь, Напоминания.Завершено,
			Напоминания.Организация));
	КонецЦикла;

КонецПроцедуры

Функция ТекстЗапросаКалендаря()

	Возврат
	"ВЫБРАТЬ
	|	Урок.Ссылка КАК Ссылка,
	|	Урок.Дата КАК Дата,
	|	Урок.КоличествоЧасов КАК КоличествоЧасов,
	|	Урок.Проведен КАК Проведен,
	|	Урок.Помещение КАК Помещение,
	|	Урок.Педагог КАК Педагог,
	|	Урок.ГруппаОбучения КАК ГруппаОбучения,
	|	Урок.ПредметОбучения КАК ПредметОбучения
	|ПОМЕСТИТЬ ВТ_Уроки
	|ИЗ
	|	Документ.УЗ_Урок КАК Урок
	|ГДЕ
	|	Урок.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ Урок.ПометкаУдаления
	|	И (НЕ &ОтборПедагог ИЛИ Урок.Педагог = &Педагог)
	|	И (НЕ &ОтборПомещение ИЛИ Урок.Помещение = &Помещение)
	|	И (НЕ &ОтборГруппа ИЛИ Урок.ГруппаОбучения = &ГруппаОбучения)
	|	И (НЕ &ОтборСтатус ИЛИ Урок.Статус = &Статус)
	|	И (НЕ &ОтборУченик
	|			ИЛИ Урок.Ссылка В
	|				(ВЫБРАТЬ
	|					УрокУченики.Ссылка
	|				ИЗ
	|					Документ.УЗ_Урок.Ученики КАК УрокУченики
	|				ГДЕ
	|					УрокУченики.Ученик = &Ученик))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Уроки.Ссылка КАК Ссылка,
	|	Уроки.Дата КАК Дата,
	|	Уроки.КоличествоЧасов КАК КоличествоЧасов,
	|	Уроки.Проведен КАК Проведен,
	|	Уроки.Помещение КАК Помещение,
	|	Уроки.Педагог КАК Педагог,
	|	ЕСТЬNULL(Уроки.ГруппаОбучения.Наименование, """") КАК Группа,
	|	ЕСТЬNULL(Уроки.ПредметОбучения.Наименование, """") КАК Предмет,
	|	ЕСТЬNULL(Уроки.Педагог.Наименование, """") КАК ПедагогИмя,
	|	ЕСТЬNULL(Уроки.Помещение.Цвет, """") КАК ЦветПомещения,
	|	ЕСТЬNULL(Уроки.ПредметОбучения.Цвет, """") КАК ЦветПредмета,
	|	ЕСТЬNULL(Уроки.Педагог.Цвет, """") КАК ЦветПедагога
	|ИЗ
	|	ВТ_Уроки КАК Уроки
	|
	|УПОРЯДОЧИТЬ ПО
	|	Уроки.Помещение.Наименование,
	|	Уроки.Педагог.Наименование,
	|	Уроки.Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УрокУченики.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(УрокУченики.Ученик.Наименование, """") КАК Ученик
	|ИЗ
	|	Документ.УЗ_Урок.Ученики КАК УрокУченики
	|ГДЕ
	|	&СУчениками
	|	И УрокУченики.Ссылка В
	|			(ВЫБРАТЬ
	|				Уроки.Ссылка
	|			ИЗ
	|				ВТ_Уроки КАК Уроки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	УрокУченики.Ссылка,
	|	УрокУченики.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Помещения.Ссылка КАК Помещение,
	|	Помещения.Наименование КАК Порядок,
	|	Помещения.Цвет КАК Цвет
	|ИЗ
	|	Справочник.УЗ_Помещения КАК Помещения
	|ГДЕ
	|	&ИзмеренияПомещений
	|	И &ВсеПомещения
	|	И НЕ Помещения.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Урок.Помещение,
	|	ЕСТЬNULL(Урок.Помещение.Наименование, """"),
	|	ЕСТЬNULL(Урок.Помещение.Цвет, """")
	|ИЗ
	|	Документ.УЗ_Урок КАК Урок
	|ГДЕ
	|	&ИзмеренияПомещений
	|	И НЕ &ВсеПомещения
	|	И Урок.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ Урок.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|" + ТекстЗапросаЗанятыхДат();

КонецФункции

Функция ТекстЗапросаЗанятыхДат()

	Возврат
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НАЧАЛОПЕРИОДА(Урок.Дата, ДЕНЬ) КАК Дата
	|ИЗ
	|	Документ.УЗ_Урок КАК Урок
	|ГДЕ
	|	Урок.Дата МЕЖДУ &ЗанятыеС И &ЗанятыеПо
	|	И НЕ Урок.ПометкаУдаления
	|	И (НЕ &ОтборПедагог ИЛИ Урок.Педагог = &Педагог)
	|	И (НЕ &ОтборПомещение ИЛИ Урок.Помещение = &Помещение)
	|	И (НЕ &ОтборГруппа ИЛИ Урок.ГруппаОбучения = &ГруппаОбучения)";

КонецФункции

#КонецОбласти

#КонецЕсли
