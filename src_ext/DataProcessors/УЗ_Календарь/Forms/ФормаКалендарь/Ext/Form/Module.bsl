		Пом = Значения.Получить("Помещение");
	Иначе
		Пом = ФильтрПомещение;
	КонецЕсли;
	//без вопроса «Создать новый урок?»: сразу открывается заполненный черновик — не нужен, закрыть без записи
	ОткрытьНовыйУрок(Начало, Конец, Пом);

КонецПроцедуры

//Реквизиты нового урока из отбора календаря: группа (её педагог со ставкой, предмет, тариф) или педагог.
&НаСервереБезКонтекста
Функция ЗначенияНовогоУрока(ГруппаОбучения, Педагог)

	Значения = Новый Структура;
	Если ЗначениеЗаполнено(ГруппаОбучения) Тогда
		Значения.Вставить("ГруппаОбучения", ГруппаОбучения);
		Значения.Вставить("Педагог", ГруппаОбучения.Педагог);
		Значения.Вставить("СтавкаПедагога", Документы.УЗ_Урок.СтавкаПедагогаПоУмолчанию(ГруппаОбучения.Педагог, ГруппаОбучения));
		Значения.Вставить("ПредметОбучения", ГруппаОбучения.ПредметОбучения);
		Если ЗначениеЗаполнено(ГруппаОбучения.Тариф) Тогда
			Значения.Вставить("Тариф", ГруппаОбучения.Тариф);
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(Педагог) Тогда
		Значения.Вставить("Педагог", Педагог);
		Значения.Вставить("СтавкаПедагога", Педагог.СтавкаПедагога);
	КонецЕсли;
	Возврат Значения;

КонецФункции

&НаКлиенте
Процедура ОткрытьНовыйУрок(Начало, Конец, Пом)

	Форма = ПолучитьФорму("Документ.УЗ_Урок.Форма.ФормаДокумента", , ЭтотОбъект);
	Форма.Объект.Дата = Начало;
	Форма.Объект.КоличествоЧасов = (Конец - Начало) / 3600;
	
	//реквизиты группы и педагога — с сервера (на клиенте реквизиты ссылок недоступны); тариф группы тоже
	//(прежде урок из календаря шёл без тарифа — ученики «К оплате» без тарифа)
	ЗначенияУрока = ЗначенияНовогоУрока(ФильтрГруппаОбучения, ФильтрПедагог);
	ЗаполнитьЗначенияСвойств(Форма.Объект, ЗначенияУрока);
	Форма.Объект.Помещение = Пом;
	//календарь перечитывается, когда черновик закрыт (записан или нет), а не сразу после открытия
	Форма.ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПослеЗакрытияУрока", ЭтотОбъект);
	Форма.Открыть();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияУрока(Результат, ДополнительныеПараметры) Экспорт

	ЗаполнитьНаКлиенте(Планировщик.ТекущиеПериодыОтображения[0].Начало, Планировщик.ТекущиеПериодыОтображения[0].Конец);

КонецПроцедуры

&НаКлиенте
Процедура ПланировщикПриОкончанииРедактирования(Элемент, НовыйЭлемент, ОтменаРедактирования)

	Если РасписаниеТолькоДляПросмотра = Истина Тогда
		ОтменаРедактирования = Истина;
		Возврат;
	КонецЕсли;
	Действие = ДействиеСДокументом();
	Если Действие = Неопределено Тогда
		Возврат;
	КонецЕсли;
	//вместо «Да/Нет» — кнопки с названием действия: «Перенести» / «Оставить как было»
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить("Применить", Действие.Кнопка);
	Кнопки.Добавить("Оставить", НСтр("ru = 'Оставить как было'"));
	Оповещение = Новый ОписаниеОповещения("ПланировщикПриОкончанииРедактированияЗавершение", ЭтотОбъект, Действие);
	ПоказатьВопрос(Оповещение, Действие.Текст, Кнопки, 0, "Применить", Действие.Кнопка);

КонецПроцедуры

&НаКлиенте
Процедура ПланировщикПриОкончанииРедактированияЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = "Применить" Тогда
		ИзменитьДокумент(ДополнительныеПараметры);
	КонецЕсли;
	//и после отказа, и после переноса: прямоугольник урока встаёт туда, где урок записан
	ЗаполнитьНаКлиенте(Планировщик.ТекущиеПериодыОтображения[0].Начало, Планировщик.ТекущиеПериодыОтображения[0].Конец);

КонецПроцедуры

// Что сделали мышью с уроком: перенос по времени и/или смена помещения. Данные — из выделенного элемента
// планировщика на клиенте; прежние дата, окончание и помещение урока — одним вызовом без контекста формы.
&НаКлиенте
Функция ДействиеСДокументом()

	ТекДанные = Элементы.Планировщик.ВыделенныеЭлементы;
	Если ТекДанные.Количество() <> 1 Или ТипЗнч(ТекДанные[0].Значение) <> Тип("ДокументСсылка.УЗ_Урок") Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЭлементУрока = ТекДанные[0];
	ПоПомещениям = ЭлементУрока.ЗначенияИзмерений.Количество() = 1;
	ПомКуда = ?(ПоПомещениям, ЭлементУрока.ЗначенияИзмерений.Получить("Помещение"), Неопределено);
	Возврат ОписаниеИзменения(ЭлементУрока.Значение, ЭлементУрока.Начало, ЭлементУрока.Конец, ПоПомещениям, ПомКуда);

КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеИзменения(Урок, Начало, Конец, ПоПомещениям, ПомКуда)

	Реквизиты = РеквизитыПереносимогоУрока(Урок);
	ПомОткуда = Реквизиты.Помещение;
	Если Не ПоПомещениям Тогда
		ПомКуда = ПомОткуда;
	КонецЕсли;
	СменаВремени = Реквизиты.Дата <> Начало Или Реквизиты.Окончание <> Конец;
	СменаПомещения = ПомОткуда <> ПомКуда;
	Если Не СменаВремени И Не СменаПомещения Тогда
		Возврат Неопределено;
	КонецЕсли;

	ФорматВремени = "ДФ='дд.ММ.гг ЧЧ:мм'";
	Строки = Новый Массив;
	Строки.Добавить(Строка(Урок));
	Если СменаВремени Тогда
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Время: %1 – %2 → %3 – %4'"),
			Формат(Реквизиты.Дата, ФорматВремени), Формат(Реквизиты.Окончание, "ДФ=ЧЧ:мм"),
			Формат(Начало, ФорматВремени), Формат(Конец, "ДФ=ЧЧ:мм")));
	КонецЕсли;
	Если СменаПомещения Тогда
		Строки.Добавить(СтрШаблон(НСтр("ru = 'Помещение: %1 → %2'"),
			?(ЗначениеЗаполнено(ПомОткуда), Строка(ПомОткуда), НСтр("ru = 'без помещения'")),
			?(ЗначениеЗаполнено(ПомКуда), Строка(ПомКуда), НСтр("ru = 'без помещения'"))));
	КонецЕсли;
	Если СменаВремени И СменаПомещения Тогда
		Кнопка = НСтр("ru = 'Перенести и сменить помещение'");
	ИначеЕсли СменаВремени Тогда
		Кнопка = НСтр("ru = 'Перенести'");
	Иначе
		Кнопка = НСтр("ru = 'Сменить помещение'");
	КонецЕсли;

	Действие = Новый Структура;
	Действие.Вставить("Текст", СтрСоединить(Строки, Символы.ПС));
	Действие.Вставить("Кнопка", Кнопка);
	Действие.Вставить("Документ", Урок);
	Действие.Вставить("Дата", Начало);
	Действие.Вставить("Окончание", Конец);
	Действие.Вставить("Помещение", ПомКуда);
	Возврат Действие;

КонецФункции

&НаСервереБезКонтекста
Функция РеквизитыПереносимогоУрока(Урок)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Урок.Дата КАК Дата,
	|	Урок.Окончание КАК Окончание,
	|	Урок.Помещение КАК Помещение
	|ИЗ
	|	Документ.УЗ_Урок КАК Урок
	|ГДЕ
	|	Урок.Ссылка = &Урок");
	Запрос.УстановитьПараметр("Урок", Урок);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Новый Структура("Дата, Окончание, Помещение", Выборка.Дата, Выборка.Окончание, Выборка.Помещение);

КонецФункции

// Перенос урока из календаря. План/факт решает сервер (УЗ_Общий.ЗаписатьУрок, дата сеанса), не часы клиента.
&НаСервереБезКонтекста
Функция ИзменитьДокумент(Действие)
	
	Об = Действие.Документ.ПолучитьОбъект();
	Об.Дата = Действие.Дата;
	Об.КоличествоЧасов = (Действие.Окончание - Действие.Дата) / 3600;
	Об.Помещение = Действие.Помещение;
	
	//проведённый урок перепроводится (раньше запись оставляла движения на старой дате); по В10 урок,
	//который ещё не начался, только записывается; отказ (пересечение, закрытый период) — понятным текстом
	Итог = УЗ_Общий.ЗаписатьУрок(Об, Об.Проведен);
	Если Не Итог.Успех Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Урок %1 не перенесён: %2'"),
			Действие.Документ, Итог.Текст));
		Возврат Ложь;
	КонецЕсли;
	Если Итог.Пометка <> "" Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Урок %1 перенесён и %2'"),
			Действие.Документ, Итог.Пометка));
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура ПланировщикВыбор(Элемент, СтандартнаяОбработка)
	Если НЕ Элементы.Планировщик.ТолькоПросмотр Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(,Элемент.ВыделенныеЭлементы[0].Значение);
	КонецЕсли;
