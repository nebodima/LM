&НаКлиенте
Перем РасписаниеТолькоДляПросмотра;

&НаСервере
Процедура ЗаполнитьНаСервере(ДатаНачала,ДатаОкончания)
	
	Планировщик.ТекущиеПериодыОтображения.Очистить();
	Планировщик.ТекущиеПериодыОтображения.Добавить(ДатаНачала, ДатаОкончания);
	Планировщик.ОтображатьТекущуюДату = Истина;
	//палитра (docs\визуал\дизайнер.md): линии дней и рамка — серые, как сетка времени; текст — тёмный
	Планировщик.ЦветЛиний = УЗ_ОбщийКлиентСервер.ЦветЛинийСетки();
	Планировщик.ЦветРамки = УЗ_ОбщийКлиентСервер.ЦветЛинийСетки();
	Планировщик.ЦветТекста = УЗ_ОбщийКлиентСервер.ЦветТекстаНаЗаливке();
	       
	Элементы.Календарь.ВыделенныеДаты.Очистить();
	Если НачалоДня(ДатаНачала) <> НачалоДня(ДатаОкончания) Тогда
		Элементы.Календарь.ВыделенныеДаты.Добавить(ДатаНачала);
		СледДата = ДатаНачала;
		Пока Истина Цикл
			СледДата = КонецДня(СледДата)+1;
			Если СледДата <= НачалоДня(ДатаОкончания) Тогда
				Элементы.Календарь.ВыделенныеДаты.Добавить(СледДата);
			Иначе
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		Элементы.Календарь.ВыделенныеДаты.Добавить(ДатаНачала);
	КонецЕсли;
	
	//уроки, помещения, график педагога, напоминания и дни с уроками — один серверный вызов, один пакетный запрос
	Итог = Обработки.УЗ_Календарь.ЗаполнитьПланировщик(Планировщик, ПараметрыКалендаря(ДатаНачала, ДатаОкончания));
	ЗагрузитьЗанятыеДаты(ЭтотОбъект, Итог.ЗанятыеДаты);
	
КонецПроцедуры

&НаСервере
Функция ПараметрыКалендаря(ДатаНачала, ДатаОкончания)
	
	Параметры = Обработки.УЗ_Календарь.НовыеПараметры(ДатаНачала, ДатаОкончания);
	Параметры.ДатаКалендаря = Календарь;
	Параметры.ФильтрПедагог = ФильтрПедагог;
	Параметры.ФильтрПомещение = ФильтрПомещение;
	Параметры.ФильтрГруппаОбучения = ФильтрГруппаОбучения;
	Параметры.ФильтрУченик = ФильтрУченик;
	Параметры.СтатусУрока = СтатусУрока;
	Параметры.ГруппироватьПомещения = Не НеГруппироватьПомещения;
	Параметры.ОтображатьВсеПомещения = ОтображатьВсеПомещения;
	Параметры.ОтображатьНапоминания = ОтображатьНапоминания;
	Параметры.ПодписьГруппа = ГруппаОбучения;
	Параметры.ПодписьПредмет = ПредметОбучения;
	Параметры.ПодписьПедагог = Педагог;
	Параметры.ПодписьУченики = Ученики;
	Параметры.Цвет = Цвет;
	Возврат Параметры;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗагрузитьЗанятыеДаты(Форма, ЗанятыеДаты)
	
	Форма.ТЗЗанятыеДаты.Очистить();
	Для Каждого ДеньСУроками Из ЗанятыеДаты Цикл
		Форма.ТЗЗанятыеДаты.Добавить().Дата = ДеньСУроками;
	КонецЦикла;
	
КонецПроцедуры

// Границы недели (понедельник 00:00 — воскресенье 23:59:59). Свои функции вместо НачалоНедели/КонецНедели:
// в веб-клиенте на клиенте они для понедельника вернули дату без изменений и «+7 дней», и неделя в планировщике
// растягивалась до 8–15 колонок со шкалой, сдвинутой на текущее время (проверено 28.09.2026, 8.3.27).
&НаКлиентеНаСервереБезКонтекста
Функция НачалоНеделиДаты(Знач Момент)

	Возврат НачалоДня(Момент) - (ДеньНедели(Момент) - 1) * 86400;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция КонецНеделиДаты(Знач Момент)

	Возврат НачалоНеделиДаты(Момент) + 7 * 86400 - 1;

КонецФункции

