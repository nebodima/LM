&НаКлиенте
Процедура ПланировщикПередСозданием(Элемент, Начало, Конец, Значения, Текст, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Значения.Количество() = 1 Тогда
		Пом = Значения.Получить("Помещение");
	Иначе
		Пом = ФильтрПомещение;
	КонецЕсли;
		
	ПараметрыОповещения = Новый Структура("Начало, Конец, Пом", Начало, Конец, Пом);
	Оповещение = Новый ОписаниеОповещения("ПланировщикПередСозданиемЗавершение", ЭтотОбъект, ПараметрыОповещения);
	ПоказатьВопрос(Оповещение, "Создать новый Урок с " +Формат(Начало,"ДФ='дд.ММ.гг (ЧЧ:мм)'")+ " до " +Формат(Конец,"ДФ='дд.ММ.гг (ЧЧ:мм)'")+
	?(Строка(Пом)<>""," помещение: " +Пом+ " ?"," ?"), РежимДиалогаВопрос.ДаНет, 0);

КонецПроцедуры

&НаКлиенте
Процедура ПланировщикПередСозданиемЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Начало = ДополнительныеПараметры.Начало;
	Конец = ДополнительныеПараметры.Конец;
	Пом = ДополнительныеПараметры.Пом;

	Форма = ПолучитьФорму("Документ.УЗ_Урок.Форма.ФормаДокумента");
	Форма.Объект.Дата = Начало;
	Форма.Объект.КоличествоЧасов = (Конец - Начало) / 3600;
	
	Если ЗначениеЗаполнено(ФильтрГруппаОбучения) Тогда
		Форма.Объект.ГруппаОбучения = ФильтрГруппаОбучения;
		Форма.Объект.Педагог = ФильтрГруппаОбучения.Педагог;
		Форма.Объект.СтавкаПедагога = ФильтрГруппаОбучения.Педагог.СтавкаПедагога;
		Форма.Объект.ПредметОбучения = ФильтрГруппаОбучения.ПредметОбучения;
		Форма.Объект.Помещение = Пом;
	Иначе
		Если НЕ ФильтрПедагог.Пустая() Тогда
			Форма.Объект.Педагог = ФильтрПедагог;
			Форма.Объект.СтавкаПедагога = ФильтрПедагог.СтавкаПедагога;
		КонецЕсли;
		Форма.Объект.Помещение = Пом;
	КонецЕсли;

	Форма.Открыть();
	
	ЗаполнитьНаКлиенте(Планировщик.ТекущиеПериодыОтображения[0].Начало, Планировщик.ТекущиеПериодыОтображения[0].Конец);
	//ОткрытьФорму("Документ.Урок.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);


	//Если НЕ Элементы.Планировщик.ТолькоПросмотр Тогда
	//	//ПараметрыФормы = Новый Структура;
	//	//ПараметрыФормы.Вставить("Дата",Начало);
	//	//ОткрытьФорму("РегистрСведений.НапоминанияПользователя.Форма.Напоминание", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);
	//	Форма = ПолучитьФорму("Документ.УЗ_Урок.Форма.ФормаДокумента");
	//	Форма.Объект.Дата = Начало;
	//	Форма.Открыть();
	//	//ОткрытьФорму("Документ.Урок.Форма.ФормаДокумента", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);
	//КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПланировщикПриОкончанииРедактирования(Элемент, НовыйЭлемент, ОтменаРедактирования)
	
	СтруктураДействий = ДействиеСДокументом(); 
	
	Если СтруктураДействий <> Неопределено Тогда
		
		Оповещение = Новый ОписаниеОповещения("ПланировщикПриОкончанииРедактированияЗавершение", ЭтотОбъект,
			СтруктураДействий);
		ПоказатьВопрос(Оповещение, СтруктураДействий.Действие, РежимДиалогаВопрос.ДаНет, 0);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПланировщикПриОкончанииРедактированияЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		ЗаполнитьНаКлиенте(Планировщик.ТекущиеПериодыОтображения[0].Начало, Планировщик.ТекущиеПериодыОтображения[0].Конец);
		Возврат;
	КонецЕсли;

	Если ИзменитьДокумент(ДополнительныеПараметры) Тогда
		ЗаполнитьНаКлиенте(Планировщик.ТекущиеПериодыОтображения[0].Начало, Планировщик.ТекущиеПериодыОтображения[0].Конец);
	КонецЕсли;

КонецПроцедуры
Функция ДействиеСДокументом()

	ДанныеС = Новый Структура;
	
	ТекДанные = Элементы.Планировщик.ВыделенныеЭлементы;
	
	Если ТекДанные.Количество() = 1 И ТипЗнч(ТекДанные[0].Значение) = Тип("ДокументСсылка.УЗ_Урок") Тогда
		
		Док 		= ТекДанные[0].Значение;
		ПомОткуда 	= ТекДанные[0].Значение.Помещение;
		ПомКуда 	= ТекДанные[0].ЗначенияИзмерений.Получить("Помещение");
		
		Если ТекДанные[0].ЗначенияИзмерений.Количество() = 1 Тогда
			
			// Это смена помещения
			Если ПомОткуда <> ПомКуда Тогда
				
				Если ТекДанные[0].Значение.Дата <> ТекДанные[0].Начало // в том числе перенос по времени
					или ТекДанные[0].Значение.Окончание <> ТекДанные[0].Конец Тогда
					ДанныеС.Вставить("Действие","Сменить помещение " +ПомОткуда+ " на " +ПомКуда+ Символы.ПС 
					+"и перенести по времени с " +Символы.ПС
					+Формат(ТекДанные[0].Значение.Дата,"ДФ='дд.ММ.гг (ЧЧ:мм)'")+ " - " +Формат(ТекДанные[0].Значение.Окончание,"ДФ='дд.ММ.гг (ЧЧ:мм)'")+ " на " +Символы.ПС
					+Формат(ТекДанные[0].Начало,"ДФ='дд.ММ.гг (ЧЧ:мм)'")+ " - " +Формат(ТекДанные[0].Конец,"ДФ='дд.ММ.гг (ЧЧ:мм)'")+ Символы.ПС +ТекДанные[0].Значение+ " ?");
				Иначе // Только смена помещения 
					ДанныеС.Вставить("Действие","Сменить помещение " +ПомОткуда+ " на " +ПомКуда+ " ?");
				КонецЕсли;
				
			// Это перенос по времени
			ИначеЕсли ТекДанные[0].Значение.Дата <> ТекДанные[0].Начало
				или ТекДанные[0].Значение.Окончание <> ТекДанные[0].Конец Тогда
				ДанныеС.Вставить("Действие","Перенести по времени с " +Символы.ПС
				+Формат(ТекДанные[0].Значение.Дата,"ДФ='дд.ММ.гг (ЧЧ:мм)'")+ " - " +Формат(ТекДанные[0].Значение.Окончание,"ДФ='дд.ММ.гг (ЧЧ:мм)'")+ " на " +Символы.ПС
				+Формат(ТекДанные[0].Начало,"ДФ='дд.ММ.гг (ЧЧ:мм)'")+ " - " +Формат(ТекДанные[0].Конец,"ДФ='дд.ММ.гг (ЧЧ:мм)'")+ Символы.ПС +ТекДанные[0].Значение+ " ?");
			КонецЕсли;
			
			ДанныеС.Вставить("Помещение",ПомКуда);    
			ДанныеС.Вставить("Дата",ТекДанные[0].Начало);
			ДанныеС.Вставить("Окончание",ТекДанные[0].Конец);
			ДанныеС.Вставить("Документ",ТекДанные[0].Значение);
			Возврат ДанныеС;
			
			// Это смена Помещения
			//Если ПомОткуда <> ПомКуда Тогда
			//	С.Вставить("Действие","Сменить помещение " +ПомОткуда+ " на " +ПомКуда+ Символы.ПС +ТекДанные[0].Значение+ " ?");
			//	С.Вставить("Помещение",ПомКуда);
			//	С.Вставить("Дата",ТекДанные[0].Значение.Дата);
			//	С.Вставить("Окончание",ТекДанные[0].Значение.Окончание);
			//	С.Вставить("Документ",ТекДанные[0].Значение);
			//	Возврат С;
			//КонецЕсли;
						
		Иначе
			
			// Это перенос
			Если ТекДанные[0].Значение.Дата <> ТекДанные[0].Начало
				или ТекДанные[0].Значение.Окончание <> ТекДанные[0].Конец Тогда
				ДанныеС.Вставить("Действие","Перенести по времени с " +Символы.ПС
				+Формат(ТекДанные[0].Значение.Дата,"ДФ='дд.ММ.гг (ЧЧ:мм)'")+ " - " +Формат(ТекДанные[0].Значение.Окончание,"ДФ='дд.ММ.гг (ЧЧ:мм)'")+ " на " +Символы.ПС
				+Формат(ТекДанные[0].Начало,"ДФ='дд.ММ.гг (ЧЧ:мм)'")+ " - " +Формат(ТекДанные[0].Конец,"ДФ='дд.ММ.гг (ЧЧ:мм)'")+ Символы.ПС +ТекДанные[0].Значение+ " ?");
				ДанныеС.Вставить("Помещение",ПомОткуда);
				ДанныеС.Вставить("Дата",ТекДанные[0].Начало);
				ДанныеС.Вставить("Окончание",ТекДанные[0].Конец);
				ДанныеС.Вставить("Документ",ТекДанные[0].Значение);
				Возврат ДанныеС;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
		
КонецФункции
Функция ИзменитьДокумент(СтруктураДействий)
	
	Об = СтруктураДействий.Документ.ПолучитьОбъект();
	
	Об.Дата = СтруктураДействий.Дата;
	//Об.Окончание = СтруктураДействий.Окончание;
		Об.КоличествоЧасов = (СтруктураДействий.Окончание - СтруктураДействий.Дата) / 3600;
	Об.Помещение = СтруктураДействий.Помещение;
	
	Попытка
		Об.Записать(РежимЗаписиДокумента.Запись);
		Возврат Истина;
	Исключение
		Сообщить("Не записался " +СтруктураДействий.Документ+ " " +ОписаниеОшибки());
		Возврат Ложь;	
	КонецПопытки;

КонецФункции

