&НаКлиенте
Перем РасписаниеТолькоДляПросмотра;

//Перенос урока мышью, который ещё не применён: Структура из ОписаниеПереноса (строка переноса над расписанием).
&НаКлиенте
Перем ОжидающийПеренос;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если Не ЗначениеЗаполнено(ПоложениеШкалыВремениТекст) Тогда
		ПоложениеШкалыВремениТекст = "Лево";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(ВремяКалендаряС) или Не ЗначениеЗаполнено(ВремяКалендаряПо) Тогда
		ВремяКалендаряС = 8;  // 8 с 8:00 (00:00 + 8 часов = 8:00)
		ВремяКалендаряПо = 20; // 4 до 20:00 (00:00 - 4 часа = 20:00)
	КонецЕсли;

	//в веб-клиенте расписание мышью не меняется (создание, перенос, растягивание отменяются в обработчиках),
	//но поле не «Только просмотр»: платформа рисует такое поле блёклым текстом, а урок в нём не открывается
	#Если ВебКлиент Тогда
		РасписаниеТолькоДляПросмотра = Истина;
	#КонецЕсли

	ЗаполнитьНаКлиенте(Неопределено, Неопределено);
	ОбновитьВидимость();

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Переключатель = "День";
	Цвет		  = "ПредмОбуч";
	СкрытьНастройки = Истина;
	//«сегодня» календаря — по часам сервера (сеанса), а не компьютера пользователя
	ДатаСеанса = ТекущаяДатаСеанса();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#Область Календарь

&НаКлиенте
Процедура КалендарьПриАктивизацииДаты(Элемент)

	ЗабытьПеренос();
	СтарыйМассив = Элементы.Календарь.ВыделенныеДаты;
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.ЗагрузитьЗначения(СтарыйМассив);
	СписокЗначений.СортироватьПоЗначению();
	НовыйМассив = СписокЗначений.ВыгрузитьЗначения();

	Если КалендарьПоследняяДата.Количество() = 0 Или КалендарьПоследняяДата[0].Значение <> Календарь Тогда
		КалендарьПоследняяДата.Вставить(0,Календарь);
	КонецЕсли;
	Пока КалендарьПоследняяДата.Количество() > 2 Цикл
		КалендарьПоследняяДата.Удалить(2);
	КонецЦикла;

	НачалоПериода = НовыйМассив[0];
	КонецПериода = КонецДня(НовыйМассив[НовыйМассив.Количество()-1]);

	Если Переключатель = "День" Тогда
		ДатаНачала = НачалоДня(НачалоПериода);
		ДатаОкончания = КонецДня(КонецПериода);
	ИначеЕсли Переключатель = "Неделя" Тогда
		ДатаНачала = НачалоНеделиДаты(НачалоПериода);
		ДатаОкончания = КонецНеделиДаты(КонецПериода);
	ИначеЕсли Переключатель = "Месяц" Тогда
		ДатаНачала = НачалоМесяца(НачалоПериода);
		ДатаОкончания = КонецМесяца(КонецПериода);
	КонецЕсли;

	ЗаполнитьНаСервере(ДатаНачала,ДатаОкончания);
	Элементы.Календарь.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура КалендарьПриВыводеПериода(Элемент, ОформлениеПериода)

	Для Каждого ОформлениеДаты Из ОформлениеПериода.Даты Цикл
		Отбор = Новый Структура("Дата", ОформлениеДаты.Дата);
		Если ТЗЗанятыеДаты.НайтиСтроки(Отбор).Количество() > 0 Тогда
			//дни с уроками — жирным, без цветной заливки (цвет в продукте несёт смысл)
			ОформлениеДаты.Шрифт = Новый Шрифт(, , Истина);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура КалендарьПриИзменении(Элемент)
	ЗагрузитьЗанятыеДаты(ЭтотОбъект, ЗанятыеДатыНаСервере(?(ЗначениеЗаполнено(Календарь), Календарь, ДатаСеанса),
		ОтборыКалендаря(ЭтотОбъект)));
КонецПроцедуры
#КонецОбласти

&НаКлиенте
Процедура ПереключательПриИзменении(Элемент)
	Период = Планировщик.ТекущиеПериодыОтображения[0];
	Если Переключатель = "День" Тогда
		ЗаполнитьНаКлиенте(Период.Начало, КонецДня(Период.Начало));
	ИначеЕсли Переключатель = "Месяц" Тогда
		ЗаполнитьНаКлиенте(НачалоМесяца(Период.Начало), КонецМесяца(Период.Начало));
	ИначеЕсли Переключатель = "Неделя" Тогда
		Если ДатаСеанса >= Период.Начало И ДатаСеанса <= Период.Конец Тогда
			ЗаполнитьНаКлиенте(НачалоНеделиДаты(ДатаСеанса), КонецНеделиДаты(ДатаСеанса));
		Иначе
			ЗаполнитьНаКлиенте(НачалоНеделиДаты(Период.Начало), КонецНеделиДаты(Период.Начало));
		КонецЕсли;
	Иначе
		ЗаполнитьНаКлиенте(Период.Начало, Период.Конец);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Цвет1ПриИзменении(Элемент)
	ЗаполнитьНаКлиенте(Планировщик.ТекущиеПериодыОтображения[0].Начало, Планировщик.ТекущиеПериодыОтображения[0].Конец);
КонецПроцедуры

&НаКлиенте
Процедура СкрытьНастройкиПриИзменении(Элемент)
	ОбновитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура РазделительКартинка1Нажатие(Элемент)
	Элементы.ГруппаЛево.Видимость = НЕ Элементы.ГруппаЛево.Видимость;
	Элементы.РазделительКартинка1.Видимость = Элементы.ГруппаЛево.Видимость;
	Элементы.РазделительКартинка2.Видимость = НЕ Элементы.ГруппаЛево.Видимость;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПредыдущийПериод(Команда)
	ПоказатьПериод(НачалоДня(Планировщик.ТекущиеПериодыОтображения[0].Начало) - 1);
КонецПроцедуры

&НаКлиенте
Процедура БудущийПериод(Команда)
	ПоказатьПериод(КонецДня(Планировщик.ТекущиеПериодыОтображения[0].Конец) + 1);
КонецПроцедуры

&НаКлиенте
Процедура Сегодня(Команда)
	ДатаСеанса = ДатаСеансаНаСервере();
	ПоказатьПериод(ДатаСеанса);
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ЗаполнитьНаКлиенте(Планировщик.ТекущиеПериодыОтображения[0].Начало, Планировщик.ТекущиеПериодыОтображения[0].Конец);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//Неделя: колонка помещения в дне узкая (7 дней × помещения), длинное слово платформа рвёт по буквам («Ф/орте/пиан»).
//Слово длиннее 6 знаков — первые 4 и точка («Форт.»): переносится по словам, целиком читается в подсказке урока.
&НаСервереБезКонтекста
Функция ТекстДляУзкойКолонки(Текст)

	Строки = СтрРазделить(Текст, Символы.ПС);
	Для НомерСтроки = 0 По Строки.ВГраница() Цикл
		Слова = СтрРазделить(Строки[НомерСтроки], " ");
		Для НомерСлова = 0 По Слова.ВГраница() Цикл
			Если СтрДлина(Слова[НомерСлова]) > 6 Тогда
				Слова[НомерСлова] = Лев(Слова[НомерСлова], 4) + ".";
			КонецЕсли;
		КонецЦикла;
		Строки[НомерСтроки] = СтрСоединить(Слова, " ");
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

//Планировщик за период — ОДИН серверный вызов и один пакетный запрос (Обработки.УЗ_Календарь.ДанныеКалендаря):
//подписи, цвета, ученики, помещения, график педагога, напоминания и (СЗанятымиДатами) жирные дни навигатора.
&НаСервере
Процедура ЗаполнитьНаСервере(ДатаНачала, ДатаОкончания, СЗанятымиДатами = Ложь)

	Планировщик.ТекущиеПериодыОтображения.Очистить();
	Планировщик.ТекущиеПериодыОтображения.Добавить(ДатаНачала, ДатаОкончания);
	Планировщик.ОтображатьТекущуюДату = Истина;
	//палитра (docs\визуал\дизайнер.md): линии дней и рамка — серые, как сетка времени; текст — тёмный
	Планировщик.ЦветЛиний = УЗ_ОбщийКлиентСервер.ЦветЛинийСетки();
	Планировщик.ЦветРамки = УЗ_ОбщийКлиентСервер.ЦветЛинийСетки();
	Планировщик.ЦветТекста = УЗ_ОбщийКлиентСервер.ЦветТекстаНаЗаливке();

	Элементы.Календарь.ВыделенныеДаты.Очистить();
	СледДата = НачалоДня(ДатаНачала);
	Пока СледДата <= НачалоДня(ДатаОкончания) Цикл
		Элементы.Календарь.ВыделенныеДаты.Добавить(СледДата);
		СледДата = СледДата + 86400;
	КонецЦикла;

	Показ = Новый Структура;
	Показ.Вставить("ГруппаОбучения", ГруппаОбучения);
	Показ.Вставить("ПредметОбучения", ПредметОбучения);
	Показ.Вставить("Педагог", Педагог);
	Показ.Вставить("Ученики", Ученики);
	Показ.Вставить("Цвет", Цвет);
	Показ.Вставить("Помещения", Не НеГруппироватьПомещения);
	Показ.Вставить("ВсеПомещения", ОтображатьВсеПомещения);
	Показ.Вставить("Напоминания", ОтображатьНапоминания);
	ДатаЗанятых = Неопределено;
	Если СЗанятымиДатами Тогда
		ДатаЗанятых = ?(ЗначениеЗаполнено(Календарь), Календарь, ТекущаяДатаСеанса());
	КонецЕсли;
	Данные = Обработки.УЗ_Календарь.ДанныеКалендаря(ДатаНачала, ДатаОкончания, ОтборыКалендаря(ЭтотОбъект), Показ,
		ДатаЗанятых);

	ЭлементыПланировщика = Планировщик.Элементы;
	ЭлементыПланировщика.Очистить();
	Планировщик.Измерения.Очистить();
	Если Не НеГруппироватьПомещения Тогда
		НовИзмерение = Планировщик.Измерения.Добавить("Помещение");
		Для Каждого Помещение Из Данные.Помещения Цикл
			НовЭл = НовИзмерение.Элементы.Добавить(Помещение.Помещение);
			НовЭл.Текст = Помещение.Текст;
			ЦветПомещения = УЗ_ОбщийКлиентСервер.WebЦветПоИмени(Помещение.Цвет);
			Если ЦветПомещения <> Новый Цвет Тогда
				НовЭл.ЦветФона = ЦветПомещения;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Для Каждого Урок Из Данные.Уроки Цикл
		НовыйЭлемент = ЭлементыПланировщика.Добавить(Урок.Начало, Урок.Конец);
		НовыйЭлемент.Текст = ?(Переключатель = "Неделя", ТекстДляУзкойКолонки(Урок.Текст), Урок.Текст);
		НовыйЭлемент.Значение = Урок.Ссылка;
		//проведённый урок — тёмная рамка (и «✓» в подписи), записанный планом — светлая
		НовыйЭлемент.ЦветРамки = ?(Урок.Проведен, УЗ_ОбщийКлиентСервер.ЦветТекстаНаЗаливке(),
			УЗ_ОбщийКлиентСервер.ЦветЛинийСетки());
		НовыйЭлемент.ЦветТекста = УЗ_ОбщийКлиентСервер.ЦветТекстаНаЗаливке();
		//цвет помещения/предмета/педагога — по имени веб-цвета; пустое или неизвестное имя — урок остаётся серым
		НовыйЭлемент.ЦветФона = УЗ_ОбщийКлиентСервер.ФонУрокаБезЦвета();
		ЦветУрока = УЗ_ОбщийКлиентСервер.WebЦветПоИмени(Урок.Цвет);
		Если ЦветУрока <> Новый Цвет Тогда
			НовыйЭлемент.ЦветФона = ЦветУрока;
		КонецЕсли;
		//связка записей с измерениями — через соответствие
		СоответствиеЗначений = Новый Соответствие;
		СоответствиеЗначений.Вставить("Помещение", Урок.Помещение);
		СоответствиеЗначений.Вставить("Педагог", Урок.Педагог);
		НовыйЭлемент.ЗначенияИзмерений = Новый ФиксированноеСоответствие(СоответствиеЗначений);
	КонецЦикла;

	//рабочие часы педагога из его графика — фоном
	Планировщик.ИнтервалыФона.Очистить();
	Для Каждого Интервал Из Данные.ИнтервалыГрафика Цикл
		НовыйИнтервал = Планировщик.ИнтервалыФона.Добавить(Интервал.Начало, Интервал.Конец);
		НовыйИнтервал.Цвет = УЗ_ОбщийКлиентСервер.ФонРабочихЧасов();
	КонецЦикла;

	//напоминания и оповещения (регистр УЗ_Оповещения): свои и общие, срок в периоде — получасовой отрезок
	Для Каждого Напоминание Из Данные.Напоминания Цикл
		НовыйЭлемент = ЭлементыПланировщика.Добавить(Напоминание.Начало, Напоминание.Начало + 1800);
		НовыйЭлемент.Текст = Напоминание.Текст;
		НовыйЭлемент.ЦветФона = УЗ_ОбщийКлиентСервер.ФонНапоминания();
		НовыйЭлемент.Картинка = БиблиотекаКартинок.ВыполнитьЗадачу;
		НовыйЭлемент.Значение = РегистрыСведений.УЗ_Оповещения.СоздатьКлючЗаписи(Напоминание.Ключ);
	КонецЦикла;

	Если Данные.ЗанятыеДаты <> Неопределено Тогда
		ЗагрузитьЗанятыеДаты(ЭтотОбъект, Данные.ЗанятыеДаты);
	КонецЕсли;

КонецПроцедуры

//Отборы календаря — для ДанныеКалендаря (пустое значение — без отбора).
&НаКлиентеНаСервереБезКонтекста
Функция ОтборыКалендаря(Форма)

	Возврат Новый Структура("Педагог, Помещение, ГруппаОбучения, Ученик, Статус", Форма.ФильтрПедагог,
		Форма.ФильтрПомещение, Форма.ФильтрГруппаОбучения, Форма.ФильтрУченик, Форма.СтатусУрока);

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗагрузитьЗанятыеДаты(Форма, ЗанятыеДаты)

	Форма.ТЗЗанятыеДаты.Очистить();
	Для Каждого ДатаУрока Из ЗанятыеДаты Цикл
		Форма.ТЗЗанятыеДаты.Добавить().Дата = ДатаУрока;
	КонецЦикла;

КонецПроцедуры

//Дни с уроками для навигатора (месяц до и после выбранной даты) — без контекста формы.
&НаСервереБезКонтекста
Функция ЗанятыеДатыНаСервере(Знач ДатаКалендаря, Знач Отборы)

	Возврат Обработки.УЗ_Календарь.ЗанятыеДаты(ДатаКалендаря, Отборы);

КонецФункции

//Сегодня по часам сервера (сеанса), а не компьютера пользователя.
&НаСервереБезКонтекста
Функция ДатаСеансаНаСервере()

	Возврат ТекущаяДатаСеанса();

КонецФункции

// Границы недели (понедельник 00:00 — воскресенье 23:59:59). Свои функции вместо НачалоНедели/КонецНедели:
// в веб-клиенте на клиенте они для понедельника вернули дату без изменений и «+7 дней», и неделя в планировщике
// растягивалась до 8–15 колонок со шкалой, сдвинутой на текущее время (проверено 28.09.2026, 8.3.27).
&НаКлиентеНаСервереБезКонтекста
Функция НачалоНеделиДаты(Знач Момент)

	Возврат НачалоДня(Момент) - (ДеньНедели(Момент) - 1) * 86400;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция КонецНеделиДаты(Знач Момент)

	Возврат НачалоНеделиДаты(Момент) + 7 * 86400 - 1;

КонецФункции

//Настройка шкалы по режиму «День/Неделя/Месяц» и заполнение — один серверный вызов вместе с днями навигатора.
&НаКлиенте
Процедура ЗаполнитьНаКлиенте(ДатаНач = Неопределено, ДатаОконч = Неопределено)

	ЗабытьПеренос();
	Элементы.Календарь.ВыделенныеДаты.Очистить();
	Если ДатаНач <> Неопределено Тогда
		ДатаНачала = ДатаНач;
		ДатаОкончания = ДатаОконч;
	ИначеЕсли Календарь = '00010101' Тогда
		ДатаНачала = ДатаСеанса;
		ДатаОкончания = ДатаСеанса;
	Иначе
		ДатаНачала = Календарь;
		ДатаОкончания = Календарь;
		Элементы.Календарь.ВыделенныеДаты.Добавить(Календарь);
	КонецЕсли;

	Планировщик.ОтступСНачалаПереносаШкалыВремени = ВремяКалендаряС; // 8 с 8:00 (00:00 + 8 часов = 8:00)
	Планировщик.ОтступСКонцаПереносаШкалыВремени = 24-ВремяКалендаряПо;// 4 до 20:00 (00:00 - 4 часа = 20:00)

	Если Переключатель = "День" Тогда
		ДатаНачала = НачалоДня(ДатаНачала);
		ДатаОкончания = КонецДня(ДатаОкончания);
		Планировщик.ОтображатьТекущуюДату = Ложь;
		Планировщик.ЕдиницаПериодическогоВарианта = ТипЕдиницыШкалыВремени.Час;
		Планировщик.КратностьПериодическогоВарианта = 48;
		Планировщик.ОтображатьПеренесенныеЗаголовки = Истина;
		Планировщик.ОтображатьПеренесенныеЗаголовкиШкалыВремени = Ложь;
		Планировщик.ОтображениеВремениЭлементов = ОтображениеВремениЭлементовПланировщика.ВремяНачалаИКонца;
		УстановитьПоложениеШкалы();
		Планировщик.ШкалаВремени.Элементы[0].Формат = "ДФ=ЧЧ:мм";
		Планировщик.ШкалаВремени.Элементы[0].Кратность = 30;
		Планировщик.ШкалаВремени.Элементы[0].Единица = ТипЕдиницыШкалыВремени.Минута;
	ИначеЕсли Переключатель = "Неделя" Тогда
		ДатаНачала = НачалоНеделиДаты(ДатаНачала);
		ДатаОкончания = КонецНеделиДаты(ДатаОкончания);
		Планировщик.ОтображатьТекущуюДату = Ложь;
		Планировщик.ЕдиницаПериодическогоВарианта = ТипЕдиницыШкалыВремени.Час;
		Планировщик.КратностьПериодическогоВарианта = 24;
		Планировщик.ОтображатьПеренесенныеЗаголовки = Истина;
		Планировщик.ОтображатьПеренесенныеЗаголовкиШкалыВремени = Ложь;
		Планировщик.ОтображениеВремениЭлементов = ОтображениеВремениЭлементовПланировщика.НеОтображать;
		УстановитьПоложениеШкалы();
		Планировщик.ШкалаВремени.Элементы[0].Формат = "ДФ=ЧЧ:мм";
		Планировщик.ШкалаВремени.Элементы[0].Кратность = 30;
		Планировщик.ШкалаВремени.Элементы[0].Единица = ТипЕдиницыШкалыВремени.Минута;
	ИначеЕсли Переключатель = "Месяц" Тогда
		ДатаНачала = НачалоМесяца(ДатаНачала);
		ДатаОкончания = КонецМесяца(ДатаОкончания);
		Планировщик.ОтображатьТекущуюДату = Ложь;
		Планировщик.ЕдиницаПериодическогоВарианта = ТипЕдиницыШкалыВремени.День;
		Планировщик.КратностьПериодическогоВарианта = 7;
		Планировщик.ОтступСНачалаПереносаШкалыВремени = 0;
		Планировщик.ОтступСКонцаПереносаШкалыВремени = 0;
		Планировщик.ОтображатьПеренесенныеЗаголовки = Ложь;
		Планировщик.ОтображатьПеренесенныеЗаголовкиШкалыВремени = Истина;
		Планировщик.ОтображениеВремениЭлементов = ОтображениеВремениЭлементовПланировщика.НеОтображать;
		Планировщик.ШкалаВремени.Положение = ПоложениеШкалыВремени.Лево;
		Планировщик.ШкалаВремени.Элементы[0].Формат = "ДФ='ddd, d MMM yyyy'";
		Планировщик.ШкалаВремени.Элементы[0].Кратность = 1;
		Планировщик.ШкалаВремени.Элементы[0].Единица = ТипЕдиницыШкалыВремени.День;
	КонецЕсли;

	ЗаполнитьНаСервере(ДатаНачала, ДатаОкончания, Истина);

	Элементы.Календарь.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПоложениеШкалы()

	Если ПоложениеШкалыВремениТекст = "Верх" Тогда
		Планировщик.ШкалаВремени.Положение = ПоложениеШкалыВремени.Верх;
	ИначеЕсли ПоложениеШкалыВремениТекст = "Низ" Тогда
		Планировщик.ШкалаВремени.Положение = ПоложениеШкалыВремени.Низ;
	ИначеЕсли ПоложениеШкалыВремениТекст = "Право" Тогда
		Планировщик.ШкалаВремени.Положение = ПоложениеШкалыВремени.Право;
	Иначе
		Планировщик.ШкалаВремени.Положение = ПоложениеШкалыВремени.Лево;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПериод(Знач Момент)

	ЗабытьПеренос();
	Если Переключатель = "День" Тогда
		ЗаполнитьНаСервере(НачалоДня(Момент), КонецДня(Момент));
	ИначеЕсли Переключатель = "Неделя" Тогда
		ЗаполнитьНаСервере(НачалоНеделиДаты(Момент), КонецНеделиДаты(Момент));
	ИначеЕсли Переключатель = "Месяц" Тогда
		ЗаполнитьНаСервере(НачалоМесяца(Момент), КонецМесяца(Момент));
	КонецЕсли;
	Элементы.Календарь.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимость()
	Элементы.Группа3.Видимость = Не СкрытьНастройки;
КонецПроцедуры

#Область КомандыПланировщика

&НаКлиенте
Процедура ПланировщикПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Дата, Значения)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

//Новый урок из выделенного интервала: сразу заполненный черновик (время, помещение, группа или педагог из
//отбора), без вопроса «Создать?» — не нужен урок, форму закрывают без записи. Календарь обновляется после
//закрытия формы урока, а не сразу (прежде перечитывался до записи и нового урока не показывал).
&НаКлиенте
Процедура ПланировщикПередСозданием(Элемент, Начало, Конец, Значения, Текст, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Если РасписаниеТолькоДляПросмотра = Истина Тогда
		Возврат;
	КонецЕсли;

	Если Значения.Количество() = 1 Тогда
		Пом = Значения.Получить("Помещение");
	Иначе
		Пом = ФильтрПомещение;
	КонецЕсли;

	//значения — параметрами формы (ЗначенияЗаполнения и Дата), а не правкой Объект после ПолучитьФорму: тогда
	//ПриСозданииНаСервере формы урока видит часы и время и показывает длительность «Ч:ММ» и «до» (веб-клиент
	//28.09.2026: после ПолучитьФорму поля длительности у черновика были пустыми)
	ЗначенияУрока = ЗначенияНовогоУрока(Начало, Конец, Пом, ФильтрГруппаОбучения, ФильтрПедагог);
	ПараметрыФормы = Новый Структура("Дата, ЗначенияЗаполнения", ЗначенияУрока.Дата, ЗначенияУрока);
	ЗначенияУрока.Удалить("Дата");
	ОткрытьФорму("Документ.УЗ_Урок.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("ПослеЗакрытияУрока", ЭтотОбъект));

КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗначенияНовогоУрока(Знач Начало, Знач Конец, Знач Помещение, Знач ГруппаОбучения, Знач Педагог)
	Возврат Обработки.УЗ_Календарь.ЗначенияНовогоУрока(Начало, Конец, Помещение, ГруппаОбучения, Педагог);
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияУрока(Результат, ДополнительныеПараметры) Экспорт
	Обновить(Неопределено);
КонецПроцедуры

//Урок перетащили или растянули: вместо вопроса «Да/Нет» — строка над расписанием «что изменится» и кнопки
//«Перенести» / «Отменить». Урок в базе не меняется, пока не нажата «Перенести».
&НаКлиенте
Процедура ПланировщикПриОкончанииРедактирования(Элемент, НовыйЭлемент, ОтменаРедактирования)

	Если РасписаниеТолькоДляПросмотра = Истина Тогда
		ОтменаРедактирования = Истина;
		Возврат;
	КонецЕсли;
	Выделенные = Элементы.Планировщик.ВыделенныеЭлементы;
	Если Выделенные.Количество() <> 1 Или ТипЗнч(Выделенные[0].Значение) <> Тип("ДокументСсылка.УЗ_Урок") Тогда
		Возврат;
	КонецЕсли;
	ЭлементУрока = Выделенные[0];
	СменаПомещения = ЭлементУрока.ЗначенияИзмерений.Количество() = 1;
	Перенос = ОписаниеПереноса(ЭлементУрока.Значение, ЭлементУрока.Начало, ЭлементУрока.Конец,
		?(СменаПомещения, ЭлементУрока.ЗначенияИзмерений.Получить("Помещение"), Неопределено), СменаПомещения);
	Если Перенос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОжидающийПеренос = Перенос;
	ТекстПереноса = Перенос.Текст;
	Элементы.ГруппаПеренос.Видимость = Истина;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ОписаниеПереноса(Знач Урок, Знач Начало, Знач Конец, Знач ПомещениеКуда, Знач СменаПомещения)
	Возврат Обработки.УЗ_Календарь.ОписаниеПереноса(Урок, Начало, Конец, ПомещениеКуда, СменаПомещения);
КонецФункции

&НаСервереБезКонтекста
Функция ПеренестиУрокНаСервере(Знач Перенос)
	Возврат Обработки.УЗ_Календарь.ПеренестиУрок(Перенос);
КонецФункции

&НаКлиенте
Процедура Перенести(Команда)

	Если ОжидающийПеренос = Неопределено Тогда
		Элементы.ГруппаПеренос.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	Итог = ПеренестиУрокНаСервере(ОжидающийПеренос);
	Если Итог.Текст <> "" Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(Итог.Текст);
	КонецЕсли;
	СброситьПеренос();

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьПеренос(Команда)
	СброситьПеренос();
КонецПроцедуры

//Строка переноса убирается, расписание перечитывается: отменённый перенос возвращает урок на место.
&НаКлиенте
Процедура СброситьПеренос()

	Обновить(Неопределено);

КонецПроцедуры

//Любое перечитывание расписания (обновить, другой период, отбор) возвращает урок на записанное место — строка
//неприменённого переноса тогда убирается, чтобы не звать «Перенести» к уроку, которого на экране уже нет там.
&НаКлиенте
Процедура ЗабытьПеренос()

	ОжидающийПеренос = Неопределено;
	ТекстПереноса = "";
	Элементы.ГруппаПеренос.Видимость = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ПланировщикВыбор(Элемент, СтандартнаяОбработка)
	Если НЕ Элементы.Планировщик.ТолькоПросмотр Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(,Элемент.ВыделенныеЭлементы[0].Значение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПланировщикПриСменеТекущегоПериодаОтображения(Элемент, ТекущиеПериодыОтображения, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПланировщикПередНачаломБыстрогоРедактирования(Элемент, СтандартнаяОбработка)

	Если НЕ Элементы.Планировщик.ТолькоПросмотр Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(,Элемент.ВыделенныеЭлементы[0].Значение);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти
