#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Действия панели ученика с уроками группы: «Продлить группу», «Добавить в группу», «Удалить из группы»,
// «Перевести из группы». Логика здесь, а не в модуле формы, — её проверяет COM-тест тест_панель_ученика.py.
//
// Урок группы на дату ищется среди всех непомеченных на удаление уроков — и проведённых, и записанных планом
// (раньше только среди проведённых: запланированный урок не находился, и рядом создавался второй).
// В10 (решение владельца 28.09.2026): урок, который ещё не начался, только записывается (план), прошедший —
// проводится (УЗ_Общий.ЗаписатьУрок). Результат строки — по факту записи: «Проведено» только у проведённого урока.

// Записать ученика в уроки группы на даты: урок группы на дату есть — ученик добавляется в него, нет — урок
// создаётся по группе (педагог, предмет, помещение, время дня по расписанию).
//
// Параметры:
//   Ученик - СправочникСсылка.УЗ_ФизЛица
//   ГруппаОбучения - СправочникСсылка.УЗ_ГруппыОбучения
//   Даты - Массив, СписокЗначений - даты уроков (с временем начала)
//   Скидка - СправочникСсылка.УЗ_Скидки, Неопределено - скидка ученика в новых строках
//   Организация - СправочникСсылка.Организации, Неопределено - организация новых уроков (панель задаёт свою;
//                 не задана — из настроек)
//
// Возвращаемое значение:
//   Массив из Структура - Успех, Описание, ДопОписание, Урок — строки итога для таблицы «Результат».
//
Функция ЗаписатьУченикаВГруппу(Ученик, ГруппаОбучения, Даты, Скидка = Неопределено, Организация = Неопределено) Экспорт

	Итог = Новый Массив;
	Тариф = ТарифУченикаВГруппе(Ученик, ГруппаОбучения);
	Для Каждого ДатаУрока Из МассивДат(Даты) Цикл
		Уроки = УрокиГруппыНаДату(ГруппаОбучения, ДатаУрока);
		Если Уроки.Количество() > 1 Тогда
			Итог.Добавить(СтрокаИтога(Ложь, СтрШаблон(НСтр("ru = 'У группы %1 на %2 несколько уроков (%3) — ученик не добавлен'"),
				ГруппаОбучения, Формат(ДатаУрока, "ДЛФ=DT"), Уроки.Количество()), НСтр("ru = 'Отказ'")));
			Продолжить;
		КонецЕсли;
		Если Уроки.Количество() = 1 Тогда
			Урок = Уроки[0].ПолучитьОбъект();
			Если Урок.Ученики.Найти(Ученик, "Ученик") <> Неопределено Тогда
				ЭлементИтога = СтрокаИтога(Ложь, СтрШаблон(НСтр("ru = 'Уже есть в уроке: %1'"), Ученик),
					НСтр("ru = 'Отказ'"), Урок.Ссылка);
				ЭлементИтога.УжеЕсть = Истина;
				Итог.Добавить(ЭлементИтога);
				Продолжить;
			КонецЕсли;
			//проведённый урок — перепровести, записанный планом — оставить планом
			Провести = Урок.Проведен;
			Описание = СтрШаблон(НСтр("ru = 'Добавлен ученик: %1'"), Ученик);
		Иначе
			Урок = НовыйУрокГруппы(ГруппаОбучения, ДатаУрока, Организация);
			Провести = Истина;
			Описание = Строка(Ученик);
		КонецЕсли;
		СтрокаУченика = Урок.Ученики.Добавить();
		СтрокаУченика.Ученик = Ученик;
		СтрокаУченика.СписатьОплату = Истина;
		СтрокаУченика.Тариф = Тариф;
		Если ЗначениеЗаполнено(Скидка) Тогда
			СтрокаУченика.Скидка = Скидка;
			Описание = Описание + "; " + НСтр("ru = 'скидка'") + ": " + Скидка;
		КонецЕсли;
		Итог.Добавить(ЗаписатьИРезультат(Урок, Провести, Описание, ДатаУрока));
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Убрать ученика из уроков группы на даты (и из записанных планом). Урок, где ученик был один, помечается
// на удаление.
//
// Возвращаемое значение:
//   Массив из Структура - как у ЗаписатьУченикаВГруппу.
//
Функция УдалитьУченикаИзГруппы(Ученик, ГруппаОбучения, Даты) Экспорт

	Итог = Новый Массив;
	Для Каждого ДатаУрока Из МассивДат(Даты) Цикл
		Для Каждого СсылкаУрока Из УрокиГруппыНаДату(ГруппаОбучения, ДатаУрока) Цикл
			Урок = СсылкаУрока.ПолучитьОбъект();
			//все строки ученика (у одного ученика в уроке бывает несколько строк — разные абонементы, Codex N04)
			СтрокиУченика = Урок.Ученики.НайтиСтроки(Новый Структура("Ученик", Ученик));
			Если СтрокиУченика.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если Урок.Ученики.Количество() > СтрокиУченика.Количество() Тогда
				Для Каждого СтрокаУченика Из СтрокиУченика Цикл
					Урок.Ученики.Удалить(СтрокаУченика);
				КонецЦикла;
				Итог.Добавить(ЗаписатьИРезультат(Урок, Урок.Проведен,
					СтрШаблон(НСтр("ru = 'Удалён ученик: %1'"), Ученик), ДатаУрока));
			Иначе
				Попытка
					Урок.УстановитьПометкуУдаления(Истина);
					Итог.Добавить(СтрокаИтога(Истина, НСтр("ru = 'Урок без учеников помечен на удаление'"),
						НСтр("ru = 'Пометка удаления'"), Урок.Ссылка));
				Исключение
					Итог.Добавить(СтрокаИтога(Ложь, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
						НСтр("ru = 'Не помечен на удаление'"), Урок.Ссылка));
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Перевести ученика из группы в группу: убрать из уроков группы на даты и записать в уроки новой группы
// по её расписанию на тот же период (от первой до последней даты включительно).
Функция ПеревестиУченика(Ученик, ГруппаОбучения, НоваяГруппа, Даты, Скидка = Неопределено, Организация = Неопределено) Экспорт

	Итог = Новый Массив;
	МассивДат = МассивДат(Даты);
	Если Не ЗначениеЗаполнено(НоваяГруппа) Или НоваяГруппа = ГруппаОбучения Или МассивДат.Количество() = 0 Тогда
		Итог.Добавить(СтрокаИтога(Ложь, НСтр("ru = 'Для перевода укажите другую группу в колонке «В группу» и даты уроков'"),
			НСтр("ru = 'Отказ'")));
		Возврат Итог;
	КонецЕсли;
	Начало = МассивДат[0];
	Конец = МассивДат[0];
	Для Каждого ДатаУрока Из МассивДат Цикл
		Начало = Мин(Начало, ДатаУрока);
		Конец = Макс(Конец, ДатаУрока);
	КонецЦикла;
	//Codex Q03: перевод — одной транзакцией. Прежде ученик сначала убирался из старых уроков, и отказ записи нового
	//(нет цены тарифа, пересечение, закрытый период) оставлял его без занятий. Теперь любой отказ — перевод отменяется
	//целиком, прежние уроки остаются как были; «уже есть в уроке» новой группы отказом перевода не считается.
	НачатьТранзакцию();
	Попытка
		Для Каждого ЭлементИтога Из УдалитьУченикаИзГруппы(Ученик, ГруппаОбучения, МассивДат) Цикл
			Итог.Добавить(ЭлементИтога);
		КонецЦикла;
		ДатыНовойГруппы = ДатыУроковГруппы(НоваяГруппа, НачалоДня(Начало), КонецДня(Конец));
		Для Каждого ЭлементИтога Из ЗаписатьУченикаВГруппу(Ученик, НоваяГруппа, ДатыНовойГруппы, Скидка, Организация) Цикл
			Итог.Добавить(ЭлементИтога);
		КонецЦикла;
		Для Каждого ЭлементИтога Из Итог Цикл
			Если Не ЭлементИтога.Успех И Не ЭлементИтога.УжеЕсть Тогда
				ВызватьИсключение ЭлементИтога.Описание;
			КонецЕсли;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Итог = Новый Массив;
		Итог.Добавить(СтрокаИтога(Ложь, СтрШаблон(НСтр("ru = 'Перевод из группы %1 в группу %2 отменён, прежние уроки не изменены: %3'"),
			ГруппаОбучения, НоваяГруппа, КраткоеПредставлениеОшибки(ИнформацияОбОшибке())), НСтр("ru = 'Отказ'")));
	КонецПопытки;
	Возврат Итог;

КонецФункции

// «Переместить деньги» панели: деньги ученика с предмета на предмет в организации панели (C03, В12: деньги
// учеников раздельно по организациям; прежде перемещение создавалось без организации — в пустой).
//
// Возвращаемое значение:
//   Структура - Успех, Описание, ДопОписание, Урок (здесь — проведённое перемещение или пустая ссылка).
//
Функция ПереместитьДеньгиУченика(Ученик, Организация, ИзПредмета, ВПредмет, Сумма) Экспорт

	Описание = СтрШаблон(НСтр("ru = '%1 с предмета обучения: %2 на предмет: %3'"), Ученик, ИзПредмета, ВПредмет);
	Если НЕ ЗначениеЗаполнено(ИзПредмета) Или НЕ ЗначениеЗаполнено(ВПредмет) Или ИзПредмета = ВПредмет Или Сумма <= 0 Тогда
		Возврат СтрокаИтога(Ложь, НСтр("ru = 'Укажите разные «Из предмета» и «В предмет» и сумму больше нуля'"), НСтр("ru = 'Отказ'"));
	КонецЕсли;

	Перемещение = Документы.УЗ_ПеремещениеДенег.СоздатьДокумент();
	Перемещение.Дата                           = ТекущаяДатаСеанса();
	Перемещение.Клиент                         = Ученик;
	Перемещение.Организация                    = Организация;
	Перемещение.ПредметОбученияОтправитель     = ИзПредмета;
	Перемещение.ПредметОбученияПолучатель      = ВПредмет;
	Перемещение.СделатьДвиженияПоВзаиморасчетам = Истина;
	Перемещение.Сумма                          = Сумма;
	Попытка
		Перемещение.Записать(РежимЗаписиДокумента.Проведение);
		Возврат СтрокаИтога(Истина, Описание, НСтр("ru = 'Проведено!'"), Перемещение.Ссылка);
	Исключение
		//причина отказа — в сообщениях проведения, иначе — текст ошибки
		Причины = Новый Массив;
		Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			Причины.Добавить(Сообщение.Текст);
		КонецЦикла;
		Если Причины.Количество() = 0 Тогда
			Причины.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецЕсли;
		Возврат СтрокаИтога(Ложь, НСтр("ru = 'Отказ! '") + Описание + ": " + СтрСоединить(Причины, "; "),
			НСтр("ru = 'Не проведен!'"), Перемещение.Ссылка);
	КонецПопытки;

КонецФункции

// Даты уроков группы с ДатаНач по ДатаКон по расписанию группы (отмеченные дни недели, время начала дня).
// День недели — по ДеньНедели(), а не по строке Формат(…, "ДФ=ддд") (она зависит от языка).
//
// Возвращаемое значение:
//   СписокЗначений из Дата
//
Функция ДатыУроковГруппы(ГруппаОбучения, ДатаНач, ДатаКон) Экспорт

	СписокДат = Новый СписокЗначений;
	Если Не ЗначениеЗаполнено(ГруппаОбучения) Или Не ЗначениеЗаполнено(ДатаНач) Или Не ЗначениеЗаполнено(ДатаКон) Тогда
		Возврат СписокДат;
	КонецЕсли;
	День = НачалоДня(ДатаНач);
	Пока День <= ДатаКон Цикл
		Если ГруппаЗанимаетсяВДень(ГруппаОбучения, День) Тогда
			СписокДат.Добавить(НачалоУрокаГруппы(ГруппаОбучения, День));
		КонецЕсли;
		День = День + 86400;
	КонецЦикла;
	Возврат СписокДат;

КонецФункции

// Начало урока группы в день: время дня по расписанию группы, без него — общее «Время» группы.
Функция НачалоУрокаГруппы(ГруппаОбучения, День) Экспорт

	Время = ГруппаОбучения[ПрефиксДня(День) + "Время"];
	Если Не ЗначениеЗаполнено(Время) Тогда
		Время = ГруппаОбучения.Время;
	КонецЕсли;
	Возврат НачалоДня(День) + (Время - НачалоДня(Время));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрефиксДня(День)
	Возврат СтрРазделить("ПН,ВТ,СР,ЧТ,ПТ,СБ,ВС", ",")[ДеньНедели(День) - 1];
КонецФункции

Функция ГруппаЗанимаетсяВДень(ГруппаОбучения, День)
	Возврат ГруппаОбучения[ПрефиксДня(День)] = Истина;
КонецФункции

//Длительность урока группы в день, часов: по расписанию дня (конец − начало), иначе «Продолжительность».
Функция ЧасовУрокаГруппы(ГруппаОбучения, День)

	Префикс = ПрефиксДня(День);
	Начало = ГруппаОбучения[Префикс + "Время"];
	Конец = ГруппаОбучения[Префикс + "Время2"];
	Если ЗначениеЗаполнено(Начало) И ЗначениеЗаполнено(Конец) И Конец > Начало Тогда
		Возврат (Конец - Начало) / 3600;
	КонецЕсли;
	Возврат (ГруппаОбучения.Продолжительность - НачалоДня(ГруппаОбучения.Продолжительность)) / 3600;

КонецФункции

Функция МассивДат(Даты)

	Итог = Новый Массив;
	Если ТипЗнч(Даты) = Тип("СписокЗначений") Тогда
		Для Каждого Элемент Из Даты Цикл
			Итог.Добавить(Элемент.Значение);
		КонецЦикла;
	ИначеЕсли Даты <> Неопределено Тогда
		Для Каждого ДатаУрока Из Даты Цикл
			Итог.Добавить(ДатаУрока);
		КонецЦикла;
	КонецЕсли;
	Возврат Итог;

КонецФункции

//Все непомеченные на удаление уроки группы на дату — и проведённые, и записанные планом.
Функция УрокиГруппыНаДату(ГруппаОбучения, ДатаУрока)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Урок.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УЗ_Урок КАК Урок
	|ГДЕ
	|	Урок.Дата = &Дата
	|	И Урок.ГруппаОбучения = &ГруппаОбучения
	|	И НЕ Урок.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Урок.Проведен УБЫВ";
	Запрос.УстановитьПараметр("Дата", ДатаУрока);
	Запрос.УстановитьПараметр("ГруппаОбучения", ГруппаОбучения);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

//Тариф ученика в группе: из последнего урока ученика в этой группе, иначе тариф группы, иначе тариф ученика.
Функция ТарифУченикаВГруппе(Ученик, ГруппаОбучения)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	УрокУченики.Тариф КАК Тариф
	|ИЗ
	|	Документ.УЗ_Урок.Ученики КАК УрокУченики
	|ГДЕ
	|	УрокУченики.Ученик = &Ученик
	|	И УрокУченики.Ссылка.ГруппаОбучения = &ГруппаОбучения
	|	И НЕ УрокУченики.Ссылка.ПометкаУдаления
	|	И УрокУченики.Тариф <> ЗНАЧЕНИЕ(Справочник.УЗ_Тарифы.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	УрокУченики.Ссылка.Дата УБЫВ";
	Запрос.УстановитьПараметр("Ученик", Ученик);
	Запрос.УстановитьПараметр("ГруппаОбучения", ГруппаОбучения);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Тариф;
	КонецЕсли;
	Если ЗначениеЗаполнено(ГруппаОбучения.Тариф) Тогда
		Возврат ГруппаОбучения.Тариф;
	КонецЕсли;
	Возврат Ученик.Тариф;

КонецФункции

//Новый урок группы: педагог, предмет, помещение, часы по расписанию; ставка педагога — общей функцией урока
//(B07), организация — панели (C03), не задана — из настроек.
Функция НовыйУрокГруппы(ГруппаОбучения, ДатаУрока, Организация = Неопределено)

	Урок = Документы.УЗ_Урок.СоздатьДокумент();
	Урок.Дата = ДатаУрока;
	Урок.ГруппаОбучения = ГруппаОбучения;
	Урок.КоличествоЧасов = ЧасовУрокаГруппы(ГруппаОбучения, ДатаУрока);
	Урок.ПредметОбучения = ГруппаОбучения.ПредметОбучения;
	Урок.Педагог = ГруппаОбучения.Педагог;
	Урок.Помещение = ГруппаОбучения.Помещение;
	Документы.УЗ_Урок.ЗаполнитьСтавкуПедагога(Урок);
	Если ЗначениеЗаполнено(Организация) Тогда
		Урок.Организация = Организация;
	Иначе
		ЗаполнитьЗначенияСвойств(Урок, РегистрыСведений.УЗ_Настройки.Настройки(), "Организация");
	КонецЕсли;
	Возврат Урок;

КонецФункции

Функция ЗаписатьИРезультат(Урок, Провести, Описание, ДатаУрока)

	Записан = УЗ_Общий.ЗаписатьУрок(Урок, Провести);
	Если Не Записан.Успех Тогда
		Возврат СтрокаИтога(Ложь, СтрШаблон(НСтр("ru = 'Отказ: %1 на %2: %3'"), Описание, Формат(ДатаУрока, "ДЛФ=DT"),
			Записан.Текст), НСтр("ru = 'Не записан'"), Урок.Ссылка);
	КонецЕсли;
	Если Урок.Проведен Тогда
		ДопОписание = НСтр("ru = 'Проведено'");
	Иначе
		ДопОписание = НСтр("ru = 'Записан без проведения (план)'");
	КонецЕсли;
	Возврат СтрокаИтога(Истина, Описание, ДопОписание, Урок.Ссылка);

КонецФункции

Функция СтрокаИтога(Успех, Описание, ДопОписание, Урок = Неопределено)
	//УжеЕсть — ученик уже в уроке: для перевода это не отказ
	Возврат Новый Структура("Успех, Описание, ДопОписание, Урок, УжеЕсть", Успех, Описание, ДопОписание, Урок, Ложь);
КонецФункции

#КонецОбласти

#КонецЕсли
