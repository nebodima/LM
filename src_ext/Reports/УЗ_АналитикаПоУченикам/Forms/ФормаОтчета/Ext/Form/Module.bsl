#Область СлужебныеПроцедурыИФункции

//Строки уроков за период (регистр денег ученика, по регистратору): ученик, предмет, урок, сумма, часы, педагог, группа.
//Проведен — у урока есть хоть одна явка (В6): считается по строкам самого регистра (явка пишет КоличествоЯвок), без
//соединения с документом урока — на 30 000 уроков соединение стоило секунды (docs/нагрузка_2026-09-28.md). Урок
//считается проведённым и тогда, когда пришедший ученик занимался бесплатно, а его строка ниже отброшена фильтром.
//Без «Включать бесплатные уроки» — только строки с суммой больше нуля.
&НаСервере
Функция ПолучитьТЗОстатков(ДатаНачала, ДатаОкончания)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СписанияСуммЗаУроки.Клиент КАК Клиент,
	|	СписанияСуммЗаУроки.ПредметОбучения КАК ПредметОбучения,
	|	СписанияСуммЗаУроки.Регистратор КАК Регистратор,
	|	СписанияСуммЗаУроки.СуммаРасход КАК СуммаРасход,
	|	1 КАК Кол,
	|	СписанияСуммЗаУроки.ЧасыРасход / 60 / 60 КАК ЧасыРасход,
	|	СписанияСуммЗаУроки.ГруппаОбучения КАК ГруппаОбучения,
	|	СписанияСуммЗаУроки.Педагог КАК Педагог,
	|	СписанияСуммЗаУроки.КоличествоЯвокРасход КАК Явок,
	|	ЛОЖЬ КАК Проведен
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки.ОстаткиИОбороты(&ДатаНачала, &ДатаОкончания, Регистратор, , ) КАК
	|		СписанияСуммЗаУроки
	|ГДЕ
	|	СписанияСуммЗаУроки.Регистратор ССЫЛКА Документ.УЗ_Урок";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	ТЗ = Запрос.Выполнить().Выгрузить();

	Проведенные = Новый Соответствие;
	Для Каждого СтрокаУрока Из ТЗ Цикл
		Если СтрокаУрока.Явок <> 0 Тогда
			Проведенные.Вставить(СтрокаУрока.Регистратор, Истина);
		КонецЕсли;
	КонецЦикла;
	Всего = ТЗ.Количество();
	Для Индекс = 1 По Всего Цикл
		СтрокаУрока = ТЗ[Всего - Индекс];
		Если НЕ ВключатьБесплатныеУроки И СтрокаУрока.СуммаРасход <= 0 Тогда
			ТЗ.Удалить(СтрокаУрока);
		Иначе
			СтрокаУрока.Проведен = Проведенные[СтрокаУрока.Регистратор] = Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат ТЗ;

КонецФункции

//Строки уроков НОВЫХ учеников: у кого по этому предмету не было часов до начала периода. Те же строки, что
//ПолучитьТЗОстатков за период, без пар «ученик × предмет» прошлого периода (было: запрос на каждый предмет периода).
&НаСервере
Функция ПолучитьТЗОстатковТолькоНОВЫХ(ДатаНачала,ДатаОкончания)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СписанияСуммЗаУрокиОбороты.ПредметОбучения КАК ПредметОбучения,
	|	СписанияСуммЗаУрокиОбороты.Клиент КАК Клиент
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки.Обороты(&НачалоПериода, &ОкончаниеПериода, , ) КАК
	|		СписанияСуммЗаУрокиОбороты
	|ГДЕ
	|	СписанияСуммЗаУрокиОбороты.ЧасыОборот <> 0";
	Запрос.УстановитьПараметр("НачалоПериода", '20000101');
	Запрос.УстановитьПараметр("ОкончаниеПериода", ДатаНачала-1);
	Старые = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		УченикиПредмета = Старые[Выборка.ПредметОбучения];
		Если УченикиПредмета = Неопределено Тогда
			УченикиПредмета = Новый Соответствие;
			Старые.Вставить(Выборка.ПредметОбучения, УченикиПредмета);
		КонецЕсли;
		УченикиПредмета.Вставить(Выборка.Клиент, Истина);
	КонецЦикла;

	ТЗИтоги = ПолучитьТЗОстатков(ДатаНачала, ДатаОкончания);
	Всего = ТЗИтоги.Количество();
	Для Индекс = 1 По Всего Цикл
		СтрокаУрока = ТЗИтоги[Всего - Индекс];
		УченикиПредмета = Старые[СтрокаУрока.ПредметОбучения];
		Если УченикиПредмета <> Неопределено И УченикиПредмета[СтрокаУрока.Клиент] = Истина Тогда
			ТЗИтоги.Удалить(СтрокаУрока);
		КонецЕсли;
	КонецЦикла;

	Возврат ТЗИтоги;

КонецФункции

//Пустой период (новая форма, пустые сохранённые настройки) — текущий месяц.
&НаСервере
Процедура УстановитьПериодПоУмолчанию()

	Если Не ЗначениеЗаполнено(Период.ДатаНачала) И Не ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		Период.Вариант = ВариантСтандартногоПериода.ЭтотМесяц;
	КонецЕсли;

КонецПроцедуры

//Период отчёта приводится к рабочему виду: пустой — текущий месяц, без конца — до конца месяца начала,
//начало раньше 02.01.2000 — 02.01.2000 («прошлый период» считается с 01.01.2000 по день перед началом).
&НаСервере
Процедура ПроверитьПериод()

	УстановитьПериодПоУмолчанию();
	Если Не ЗначениеЗаполнено(Период.ДатаНачала) Или Период.ДатаНачала < '20000102' Тогда
		Начало = '20000102';
		Окончание = ?(ЗначениеЗаполнено(Период.ДатаОкончания), Период.ДатаОкончания, КонецМесяца(ТекущаяДатаСеанса()));
		Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
		Период.ДатаНачала = Начало;
		Период.ДатаОкончания = Окончание;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Период.ДатаОкончания) Или Период.ДатаОкончания < Период.ДатаНачала Тогда
		Начало = Период.ДатаНачала;
		Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
		Период.ДатаНачала = Начало;
		Период.ДатаОкончания = КонецМесяца(Начало);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПолучитьОстатки()

	ТабДок.Очистить();
	//отчёт, а не табличный редактор: без номеров строк и колонок, без сетки, без правки ячеек
	ТабДок.ТолькоПросмотр = Истина;
	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.ОтображатьЗаголовки = Ложь;
	ПроверитьПериод();

	ОстаткиПрошлогоПериода 	= ПолучитьТЗОстатков('20000101',КонецДня(Период.ДатаНачала-1));
	ОстаткиТекущие 			= ПолучитьТЗОстатковТолькоНОВЫХ(Период.ДатаНачала,КонецДня(Период.ДатаОкончания));
	ОстаткиТекущиеПолные 	= ПолучитьТЗОстатков(Период.ДатаНачала,КонецДня(Период.ДатаОкончания));

	КолУчПрош = ОстаткиПрошлогоПериода.Скопировать();
	КолУчПрош.Свернуть("ПредметОбучения,Клиент,Кол");
	КолУчПрош.Свернуть("ПредметОбучения","Кол");
	КолУчПрош.Сортировать("ПредметОбучения");

	КолУрПрош = УрокиИЧасыПоПредметам(ОстаткиПрошлогоПериода);

	КолЧасовПрош = КолУрПрош;

	СуммУрПрош = ОстаткиПрошлогоПериода.Скопировать();
	СуммУрПрош.Свернуть("ПредметОбучения","СуммаРасход");
	СуммУрПрош.Сортировать("ПредметОбучения");

	ПКОПрош = ОстаткиПрошлогоПериода.Скопировать();
	ПКОПрош.Свернуть("ПредметОбучения");
	ПКОПрош.Колонки.Добавить("ПКОСумма");
	СуммыПКОПрош = ПолучитьСуммыОплат('20000101', КонецДня(Период.ДатаНачала-1), "Прошлый");
	Для Каждого СтрПКОПрош из ПКОПрош Цикл
		Сумма = СуммыПКОПрош[СтрПКОПрош.ПредметОбучения];
		СтрПКОПрош.ПКОСумма = ?(Сумма = Неопределено, 0, Сумма);
	КонецЦикла;
	ДобавитьПредметыОплат(СуммыПКОПрош, КолУчПрош, КолУрПрош, СуммУрПрош, ПКОПрош);

	КолУч = ОстаткиТекущие.Скопировать();
	КолУч.Свернуть("ПредметОбучения,Клиент,Кол");
	КолУч.Свернуть("ПредметОбучения","Кол");
	КолУч.Сортировать("ПредметОбучения");

	КолУр = УрокиИЧасыПоПредметам(ОстаткиТекущие);

	КолЧасов = КолУр;

	СуммУр = ОстаткиТекущие.Скопировать();
	СуммУр.Свернуть("ПредметОбучения","СуммаРасход");
	СуммУр.Сортировать("ПредметОбучения");

	ПКО = ОстаткиТекущие.Скопировать();
	ПКО.Свернуть("ПредметОбучения");
	ПКО.Колонки.Добавить("ПКОСумма");
	СуммыПКО = ПолучитьСуммыОплат(Период.ДатаНачала, КонецДня(Период.ДатаОкончания), "Текущий");
	Для Каждого СтрПКО из ПКО Цикл
		Сумма = СуммыПКО[СтрПКО.ПредметОбучения];
		СтрПКО.ПКОСумма = ?(Сумма = Неопределено, 0, Сумма);
	КонецЦикла;
	ДобавитьПредметыОплат(СуммыПКО, КолУч, КолУр, СуммУр, ПКО);

	КолУчПолн = ОстаткиТекущиеПолные.Скопировать();
	КолУчПолн.Свернуть("ПредметОбучения,Клиент,Кол");
	КолУчПолн.Свернуть("ПредметОбучения","Кол");
	КолУчПолн.Сортировать("ПредметОбучения");

	КолУрПолн = УрокиИЧасыПоПредметам(ОстаткиТекущиеПолные);

	КолЧасовПолн = КолУрПолн;

	СуммУрПолн = ОстаткиТекущиеПолные.Скопировать();
	СуммУрПолн.Свернуть("ПредметОбучения","СуммаРасход");
	СуммУрПолн.Сортировать("ПредметОбучения");

	ПКОПолн = ОстаткиТекущиеПолные.Скопировать();
	ПКОПолн.Свернуть("ПредметОбучения");
	ПКОПолн.Колонки.Добавить("ПКОСумма");
	СуммыПКОПолн = ПолучитьСуммыОплат(Период.ДатаНачала, КонецДня(Период.ДатаОкончания), "ТекущийПолный");
	Для Каждого СтрПКОПолн из ПКОПолн Цикл
		Сумма = СуммыПКОПолн[СтрПКОПолн.ПредметОбучения];
		СтрПКОПолн.ПКОСумма = ?(Сумма = Неопределено, 0, Сумма);
	КонецЦикла;
	ДобавитьПредметыОплат(СуммыПКОПолн, КолУчПолн, КолУрПолн, СуммУрПолн, ПКОПолн);

	ВывестиШапку();
	ВывестиДанныеПрош(КолУчПрош,КолУрПрош,СуммУрПрош,КолЧасовПрош,ПКОПрош,УникальныхУчеников(ОстаткиПрошлогоПериода));
	ВывестиДанныеТекущ(КолУч,КолУр,СуммУр,КолЧасов,ПКО,УникальныхУчеников(ОстаткиТекущие));
	ВывестиДанныеТекущПолные(КолУчПолн,КолУрПолн,СуммУрПолн,КолЧасовПолн,ПКОПолн,
		УникальныхУчеников(ОстаткиТекущиеПолные));

КонецПроцедуры

//Уроки и часы по предметам — «про студию/педагога» (В26): урок группы — один урок и его часы один раз (было: часы
//суммой по строкам учеников — урок группы из 5 человек давал 5 часов); урок, на который никто не пришёл, не проведён
//(В6) — не считается ни уроком, ни часами (сумма неявок «К оплате» остаётся в колонке «Сумма»). Строка есть у каждого
//предмета таблицы (0, если проведённых уроков нет). Колонки: ПредметОбучения, Кол, ЧасыРасход.
&НаСервере
Функция УрокиИЧасыПоПредметам(ТЗ)

	Итог = ТЗ.Скопировать(, "ПредметОбучения");
	Итог.Свернуть("ПредметОбучения");
	Итог.Колонки.Добавить("Кол", Новый ОписаниеТипов("Число"));
	Итог.Колонки.Добавить("ЧасыРасход", Новый ОписаниеТипов("Число"));
	Учтенные = Новый Соответствие;
	Для Каждого СтрокаУрока Из ТЗ Цикл
		Если СтрокаУрока.Проведен <> Истина Или Учтенные[СтрокаУрока.Регистратор] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Учтенные.Вставить(СтрокаУрока.Регистратор, Истина);
		СтрокаИтога = Итог.Найти(СтрокаУрока.ПредметОбучения, "ПредметОбучения");
		СтрокаИтога.Кол = СтрокаИтога.Кол + 1;
		СтрокаИтога.ЧасыРасход = СтрокаИтога.ЧасыРасход + СтрокаУрока.ЧасыРасход;
	КонецЦикла;
	Итог.Сортировать("ПредметОбучения");
	Возврат Итог;

КонецФункции

//R10 (ревью 28.09): предметы, по которым в периоде есть оплаты, но нет уроков (аванс робототехники за следующий
//месяц), — строками блока с нулями уроков, часов и сумм: список предметов строился только из уроков, и «Оплаты −
//возвраты» блока теряли такие оплаты (касса 6 000, аналитика 1 000). Таблицы блока — по предмету, по порядку.
&НаСервере
Процедура ДобавитьПредметыОплат(СуммыОплат, КолУч, КолУр, СуммУр, ПКО)

	Добавлены = Ложь;
	Для Каждого Элемент Из СуммыОплат Цикл
		Если КолУч.Найти(Элемент.Ключ, "ПредметОбучения") <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Строка = КолУч.Добавить();
		Строка.ПредметОбучения = Элемент.Ключ;
		Строка.Кол = 0;
		Строка = КолУр.Добавить();
		Строка.ПредметОбучения = Элемент.Ключ;
		Строка = СуммУр.Добавить();
		Строка.ПредметОбучения = Элемент.Ключ;
		Строка.СуммаРасход = 0;
		Строка = ПКО.Добавить();
		Строка.ПредметОбучения = Элемент.Ключ;
		Строка.ПКОСумма = Элемент.Значение;
		Добавлены = Истина;
	КонецЦикла;
	Если Добавлены Тогда
		КолУч.Сортировать("ПредметОбучения");
		КолУр.Сортировать("ПредметОбучения");
		СуммУр.Сортировать("ПредметОбучения");
		ПКО.Сортировать("ПредметОбучения");
	КонецЕсли;

КонецПроцедуры

//R19 (ревью 28.09): «Часы урока» в расшифровке — часы урока один раз (первая строка урока, только проведённый урок —
//хоть одна явка, В6), как ячейка «Кол. часов» (В26); прежде расшифровка суммировала часы учеников — у группового урока
//на 10 пришедших ячейка 1,00, её расшифровка 10,00. Ученико-часы — другой показатель, в этой расшифровке его нет.
&НаСервере
Функция ЧасыУрокаОдинРаз(СтрокаУрока, УчтенныеУроки)

	Если СтрокаУрока.Проведен <> Истина Или УчтенныеУроки[СтрокаУрока.Регистратор] <> Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	УчтенныеУроки.Вставить(СтрокаУрока.Регистратор, Истина);
	Возврат СтрокаУрока.ЧасыРасход;

КонецФункции

//Учеников в итоге — разных учеников (ученик с двумя предметами — один раз; было: сумма по предметам, 26 при 25).
&НаСервере
Функция УникальныхУчеников(ТЗ)

	Ученики = ТЗ.Скопировать(, "Клиент");
	Ученики.Свернуть("Клиент");
	Возврат Ученики.Количество();

