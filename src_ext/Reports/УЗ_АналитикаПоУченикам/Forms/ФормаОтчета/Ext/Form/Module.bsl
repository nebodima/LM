//Оплаты — по движениям регистра УЗ_Касса, а не по самим документам: у менеджера ограничение доступа роли прячет ПКО
//старше границы просмотра кассы (S04). Величина одна для всех отчётов (docs/логики/отчёты_сверка_цифр.md, раздел 8):
//вид операции «Касса ученики», приход ПКО минус возвраты РКО, без бонусов и внутренней кассы.
//Период = "Текущий" — без учеников, у которых по предмету были уроки до ДатаНачала («новые»).
Функция ПолучитьСуммыОплат(ДатаНачала, ДатаОкончания, Период)

	Запрос = Новый Запрос;
	Запрос.Текст = ?(Период = "Текущий", ТекстСтарыхУчеников(), "") +
	"ВЫБРАТЬ
	|	Оплаты.ПредметОбучения КАК ПредметОбучения,
	|	СУММА(ВЫБОР
	|			КОГДА Оплаты.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА Оплаты.Сумма
	|			ИНАЧЕ -Оплаты.Сумма
	|		КОНЕЦ) КАК Сумма
	|ИЗ
	|	РегистрНакопления.УЗ_Касса КАК Оплаты
	|ГДЕ
	|	(Оплаты.Регистратор ССЫЛКА Документ.УЗ_ПриходДенег
	|			ИЛИ Оплаты.Регистратор ССЫЛКА Документ.УЗ_РасходДенег)
	|	И Оплаты.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыОпераций.КассаУченики)
	|	И Оплаты.Активность
	|	И Оплаты.Период >= &ДатаНачала
	|	И Оплаты.Период <= &ДатаОкончания
	|	И (&ВсеКассы
	|			ИЛИ Оплаты.Касса В (&Кассы))
	|
	|СГРУППИРОВАТЬ ПО
	|	Оплаты.ПредметОбучения";
	Если Период = "Текущий" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СГРУППИРОВАТЬ ПО", УсловиеНовыхОплат() + "
		|СГРУППИРОВАТЬ ПО");
	КонецЕсли;
	Запрос.УстановитьПараметр("ВсеКассы", Не ЗначениеЗаполнено(Кассы));
	Запрос.УстановитьПараметр("Кассы", Кассы);
	Запрос.УстановитьПараметр("НачалоСтарых", '20000101');
	Запрос.УстановитьПараметр("ОкончаниеСтарых", ДатаНачала - 1);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Суммы = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Суммы.Вставить(Выборка.ПредметОбучения, Выборка.Сумма);
	КонецЦикла;
	Возврат Суммы;

КонецФункции

//Оплаты для расшифровки — тоже по движениям УЗ_Касса (см. ПолучитьСуммыОплат). ПКО, который пользователю
//не виден (касса старше его границы просмотра), показывается датой, без ссылки: открыть его нельзя.
//Колонки: ПКО, Клиент, Касса, СуммаПКО, ПредметОбучения, ПКОТекст, ПКОРасшифровка.
Функция ПолучитьПКО(ДатаНачала,ДатаОкончания,Период)

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстСтарыхУчеников() +
	"ВЫБРАТЬ
	|	Оплаты.Регистратор КАК ПКО,
	|	Оплаты.Период КАК Дата,
	|	Оплаты.Клиент КАК Клиент,
	|	Оплаты.Касса КАК Касса,
	|	ВЫБОР
	|		КОГДА Оплаты.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			ТОГДА Оплаты.Сумма
	|		ИНАЧЕ -Оплаты.Сумма
	|	КОНЕЦ КАК СуммаПКО,
	|	Оплаты.ПредметОбучения КАК ПредметОбучения
	|ИЗ
	|	РегистрНакопления.УЗ_Касса КАК Оплаты
	|ГДЕ
	|	(Оплаты.Регистратор ССЫЛКА Документ.УЗ_ПриходДенег
	|			ИЛИ Оплаты.Регистратор ССЫЛКА Документ.УЗ_РасходДенег)
	|	И Оплаты.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыОпераций.КассаУченики)
	|	И Оплаты.Активность
	|	И Оплаты.Период >= &ДатаНачала
	|	И Оплаты.Период <= &ДатаОкончания";

	Если Период = "Текущий" Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС + УсловиеНовыхОплат();
	КонецЕсли;
	Если ЗначениеЗаполнено(Кассы) Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС + "И Оплаты.Касса В(&Кассы)";
	КонецЕсли;

	Запрос.УстановитьПараметр("Кассы", Кассы);
	Запрос.УстановитьПараметр("НачалоСтарых", '20000101');
	Запрос.УстановитьПараметр("ОкончаниеСтарых", ДатаНачала - 1);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	РезультатЗапроса.Сортировать("ПредметОбучения,Клиент,ПКО");

	//какие ПКО пользователь видит (ограничение доступа роли) — их представление и ссылка для открытия
	Видимые = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПКО.Ссылка КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(ПКО.Ссылка) КАК Представление
	|ИЗ
	|	Документ.УЗ_ПриходДенег КАК ПКО
	|ГДЕ
	|	ПКО.Ссылка В (&Ссылки)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РКО.Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(РКО.Ссылка)
	|ИЗ
	|	Документ.УЗ_РасходДенег КАК РКО
	|ГДЕ
	|	РКО.Ссылка В (&Ссылки)");
	Видимые.УстановитьПараметр("Ссылки", РезультатЗапроса.ВыгрузитьКолонку("ПКО"));
	Представления = Новый Соответствие;
	Выборка = Видимые.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Представления.Вставить(Выборка.Ссылка, Выборка.Представление);
	КонецЦикла;
	РезультатЗапроса.Колонки.Добавить("ПКОТекст");
	РезультатЗапроса.Колонки.Добавить("ПКОРасшифровка");
	Для Каждого СтрокаОплаты Из РезультатЗапроса Цикл
		Представление = Представления.Получить(СтрокаОплаты.ПКО);
		Если Представление = Неопределено Тогда
			//возврат (РКО) — расход денег, оплата (ПКО) — приход
			СтрокаОплаты.ПКОТекст = СтрШаблон(?(ТипЗнч(СтрокаОплаты.ПКО) = Тип("ДокументСсылка.УЗ_РасходДенег"),
				НСтр("ru = 'Расход денег от %1'"), НСтр("ru = 'Приход денег от %1'")),
					Формат(СтрокаОплаты.Дата, "ДЛФ=D"));
		Иначе
			СтрокаОплаты.ПКОТекст = Представление;
			СтрокаОплаты.ПКОРасшифровка = СтрокаОплаты.ПКО;
		КонецЕсли;
	КонецЦикла;

	Возврат РезультатЗапроса;

КонецФункции

//Предмет в расшифровке — идентификатором ссылки, а не наименованием: у двух предметов с одинаковым
//названием (и с запятой в названии) расшифровка открывалась не по тому предмету.
&НаСервереБезКонтекста
Функция КодПредметаДляРасшифровки(ПредметОбучения)
	Если ЗначениеЗаполнено(ПредметОбучения) Тогда
		Возврат Строка(ПредметОбучения.УникальныйИдентификатор());
	КонецЕсли;
	Возврат "<не выбран>";
КонецФункции

&НаСервереБезКонтекста
Функция ПредметИзРасшифровки(Код)
	Попытка
		Возврат Справочники.УЗ_ПредметыОбучения.ПолучитьСсылку(Новый УникальныйИдентификатор(Код));
	Исключение
		//честно: «<не выбран>» и прочие не-идентификаторы в расшифровке — это пустой предмет
		Возврат Справочники.УЗ_ПредметыОбучения.ПустаяСсылка();
	КонецПопытки;
КонецФункции

//«ТекущийПериод,ПоВсемУченикам,Сумма,<идентификатор>» → «…,<наименование предмета>» для заголовка окна.
&НаСервереБезКонтекста
Функция ПредставлениеРасшифровки(Расшифровка)
	Код = Сред(Расшифровка, СтрНайти(Расшифровка, ",", НаправлениеПоиска.СКонца) + 1);
	Предмет = ПредметИзРасшифровки(Код);
	Если ЗначениеЗаполнено(Предмет) Тогда
		Возврат Лев(Расшифровка, СтрДлина(Расшифровка) - СтрДлина(Код)) + Строка(Предмет);
	КонецЕсли;
	Возврат Расшифровка;
КонецФункции

#КонецОбласти
