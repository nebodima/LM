		<query>ВЫБРАТЬ
	ДанныеРегистра.Регистратор КАК Регистратор,
	ДанныеРегистра.Организация КАК Организация,
	ДанныеРегистра.Педагог КАК Педагог,
	ДанныеРегистра.НеИзменять КАК НеИзменять,
	ДанныеРегистра.Комментарий КАК Комментарий,
	ДанныеРегистра.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
	ДанныеРегистра.СуммаПриход КАК СуммаПриход,
	ДанныеРегистра.СуммаРасход КАК СуммаРасход,
	ДанныеРегистра.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток,
	ДанныеРегистра.Период КАК Период
ПОМЕСТИТЬ ВТ_Движения
ИЗ
	РегистрНакопления.УЗ_РасчетыПоЗарплате.ОстаткиИОбороты(&amp;НачалоПериода, &amp;КонецПериода, Регистратор, Движения, ) КАК ДанныеРегистра
ГДЕ
	НЕ ДанныеРегистра.Регистратор ССЫЛКА Документ.УЗ_РасчетЗарплаты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Движения.Регистратор КАК Регистратор,
	МИНИМУМ(ВТ_Движения.Комментарий) КАК Комментарий
ПОМЕСТИТЬ ВТ_ПервыеКомментарии
ИЗ
	ВТ_Движения КАК ВТ_Движения
ГДЕ
	НЕ ВТ_Движения.Регистратор ЕСТЬ NULL

СГРУППИРОВАТЬ ПО
	ВТ_Движения.Регистратор
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Движения.Регистратор КАК Регистратор,
	ВТ_Движения.Комментарий КАК Комментарий,
	МИНИМУМ(ВЫБОР
			КОГДА ВТ_Движения.НеИзменять
				ТОГДА 1
			ИНАЧЕ 0
		КОНЕЦ) КАК НеИзменять
ПОМЕСТИТЬ ВТ_ПервыеСтроки
ИЗ
	ВТ_Движения КАК ВТ_Движения
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПервыеКомментарии КАК ВТ_ПервыеКомментарии
		ПО ВТ_Движения.Регистратор = ВТ_ПервыеКомментарии.Регистратор
			И ВТ_Движения.Комментарий = ВТ_ПервыеКомментарии.Комментарий

СГРУППИРОВАТЬ ПО
	ВТ_Движения.Регистратор,
	ВТ_Движения.Комментарий
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Движения.Регистратор КАК Регистратор,
	ВТ_Движения.Организация КАК Организация,
	ВТ_Движения.Педагог КАК Педагог,
	ВТ_Движения.НеИзменять КАК НеИзменять,
	ВТ_Движения.Комментарий КАК Комментарий,
	ВТ_Движения.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
	ВТ_Движения.СуммаПриход КАК СуммаПриход,
	ВТ_Движения.СуммаРасход КАК СуммаРасход,
	ВТ_Движения.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток,
	ВТ_Движения.Период КАК Период,
	ВЫБОР
		КОГДА ВТ_ПервыеСтроки.Регистратор ЕСТЬ NULL
				ИЛИ НЕ ВТ_Движения.Регистратор ССЫЛКА Документ.УЗ_Урок
			ТОГДА 0
		ИНАЧЕ ЕСТЬNULL(ВЫРАЗИТЬ(ВТ_Движения.Регистратор КАК Документ.УЗ_Урок).Сумма, 0)
	КОНЕЦ КАК СуммаУрока,
	ВЫБОР
		КОГДА ВТ_Движения.Регистратор ССЫЛКА Документ.УЗ_Урок
				И НЕ ВТ_ПервыеСтроки.Регистратор ЕСТЬ NULL
			ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ВТ_Движения.Регистратор КАК Документ.УЗ_Урок).Сумма, 0) - ВТ_Движения.СуммаПриход
		КОГДА ВТ_Движения.Регистратор ССЫЛКА Документ.УЗ_Урок
				ИЛИ ВТ_Движения.Регистратор ССЫЛКА Документ.УЗ_НачисленияПедагогам
			ТОГДА -ВТ_Движения.СуммаПриход
		ИНАЧЕ 0
	КОНЕЦ КАК Выручка
ИЗ
	ВТ_Движения КАК ВТ_Движения
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПервыеСтроки КАК ВТ_ПервыеСтроки
		ПО ВТ_Движения.Регистратор = ВТ_ПервыеСтроки.Регистратор
			И ВТ_Движения.Комментарий = ВТ_ПервыеСтроки.Комментарий
			И (ВЫБОР
				КОГДА ВТ_Движения.НеИзменять
					ТОГДА 1
				ИНАЧЕ 0
			КОНЕЦ = ВТ_ПервыеСтроки.НеИзменять)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Урок.Ссылка,
	Урок.Организация,
	Урок.Педагог,
	ЛОЖЬ,
	"",
	0,
	0,
	0,
	0,
	Урок.Дата,
	Урок.Сумма,
	Урок.Сумма
ИЗ
	Документ.УЗ_Урок КАК Урок
ГДЕ
	Урок.Проведен
	И Урок.Сумма &lt;&gt; 0
	И (&amp;НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ Урок.Дата &gt;= &amp;НачалоПериода)
	И (&amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ Урок.Дата &lt;= &amp;КонецПериода)
	И НЕ Урок.Ссылка В
				(ВЫБРАТЬ
					ВТ_ПервыеСтроки.Регистратор
				ИЗ
					ВТ_ПервыеСтроки КАК ВТ_ПервыеСтроки)</query>
	</dataSet>
