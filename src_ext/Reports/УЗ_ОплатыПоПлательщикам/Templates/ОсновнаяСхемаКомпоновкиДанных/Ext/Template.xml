		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Движения.Организация КАК Организация,
	Движения.Плательщик КАК Плательщик,
	Движения.Клиент КАК Ученик,
	Движения.ПредметОбучения КАК ПредметОбучения,
	ВЫБОР
		КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
			ТОГДА Движения.Сумма
		ИНАЧЕ 0
	КОНЕЦ КАК Внесено,
	ВЫБОР
		КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
			ТОГДА Движения.Сумма
		ИНАЧЕ 0
	КОНЕЦ КАК Возвращено,
	ВЫБОР
		КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
			ТОГДА Движения.Сумма
		ИНАЧЕ -Движения.Сумма
	КОНЕЦ КАК Оплачено
ИЗ
	РегистрНакопления.УЗ_Касса КАК Движения
ГДЕ
	Движения.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыОпераций.КассаУченики)
	И Движения.Активность
	И (Движения.Регистратор ССЫЛКА Документ.УЗ_ПриходДенег
			ИЛИ Движения.Регистратор ССЫЛКА Документ.УЗ_РасходДенег)
	И (&amp;НачалоПериода = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ Движения.Период &gt;= &amp;НачалоПериода)
	И (&amp;КонецПериода = ДАТАВРЕМЯ(1, 1, 1)
			ИЛИ Движения.Период &lt;= &amp;КонецПериода)</query>
	</dataSet>
