//Время события — момент создания на сервере (ТекущаяДатаСеанса, как в УЗ_Сервер.ЗначенияНапоминания), а не часы
//компьютера пользователя. Кому и «Завершено» у чужих и общих оповещений меняет только руководитель (у остальных
//поля только для просмотра; запись чужого всё равно не пропустит модуль набора записей регистра).
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Запись.ВремяСобытия) Тогда
		Запись.ВремяСобытия = ТекущаяДатаСеанса();
	КонецЕсли;
	Если ПравоДоступа("Изменение", Метаданные.РегистрыСведений.УЗ_Настройки) Тогда
		Возврат;
	КонецЕсли;
	Текущий = УЗ_Среда.ТекущийПользователь();
	Если Не ЗначениеЗаполнено(Запись.Пользователь) И Не ЗначениеЗаполнено(Запись.Источник) Тогда
		Запись.Пользователь = Текущий;		//новое напоминание — себе
	КонецЕсли;
	Элементы.Пользователь.ТолькоПросмотр = Истина;
	Если Запись.Пользователь <> Текущий Тогда
		ТолькоПросмотр = Истина;
	КонецЕсли;

КонецПроцедуры
