//Мои оповещения: напоминания текущего пользователя и общие оповещения (задолженность —
//пользователь пустой). Замена «Моих напоминаний» БСП. Завершённые скрыты, пока не отмечен флажок.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АдресатыОповещений = Новый СписокЗначений;
	АдресатыОповещений.Добавить(Справочники.Пользователи.ПустаяСсылка());
	Текущий = УЗ_Среда.ТекущийПользователь();
	Если ЗначениеЗаполнено(Текущий) Тогда
		АдресатыОповещений.Добавить(Текущий);
	КонецЕсли;
	Элемент = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Пользователь");
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	Элемент.ПравоеЗначение = АдресатыОповещений;
	Элемент.Использование = Истина;
	Элемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;

	Порядок = Список.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	Порядок.Поле = Новый ПолеКомпоновкиДанных("СрокНапоминания");
	Порядок.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
	Порядок.Использование = Истина;

	УстановитьОтборЗавершенных();

КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьЗавершенныеПриИзменении(Элемент)

	УстановитьОтборЗавершенных();

КонецПроцедуры

&НаСервере
Процедура УстановитьОтборЗавершенных()

	Для Каждого Элемент Из Список.Отбор.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных")
			И Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Завершено") Тогда
			Элемент.Использование = Не ПоказыватьЗавершенные;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Элемент = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Завершено");
	Элемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Элемент.ПравоеЗначение = Ложь;
	Элемент.Использование = Не ПоказыватьЗавершенные;
	Элемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;

КонецПроцедуры

&НаКлиенте
Процедура Завершить(Команда)

	Ключи = Новый Массив;
	Для Каждого Ключ Из Элементы.Список.ВыделенныеСтроки Цикл
		Ключи.Добавить(Ключ);
	КонецЦикла;
	Если Ключи.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	УЗ_Сервер.ЗавершитьОповещения(Ключи);
	Элементы.Список.Обновить();

КонецПроцедуры
