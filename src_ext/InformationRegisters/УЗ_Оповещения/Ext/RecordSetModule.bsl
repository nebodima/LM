//Права на чужие оповещения — и в обход серверного API (N08 аудита 28.09): у менеджера право «Изменение» регистра
//нужно для своих напоминаний («Напомнить»), а стандартная форма записи позволяла поставить напоминание
//руководителю, сменить пользователя или завершить чужое/общее оповещение. Чужие (другого пользователя) и общие
//(пользователь пустой — оповещения о долге) записи меняет только тот, кто меняет настройки учёта (руководитель,
//администратор) — та же проверка, что в УЗ_Сервер.СоздатьНапоминание и ЗавершитьОповещения. Записи, которые пишет
//сам сервер после своей проверки (задание о долге, «Завершить»), помечены КлючПроверенныхПрав.
Процедура ПередЗаписью(Отказ, Замещение)

	Если ОбменДанными.Загрузка Или ДополнительныеСвойства.Свойство(УЗ_Сервер.КлючПроверенныхПрав()) Тогда
		Возврат;
	КонецЕсли;
	Если ПравоДоступа("Изменение", Метаданные.РегистрыСведений.УЗ_Настройки) Тогда
		Возврат;
	КонецЕсли;
	Текущий = УЗ_Среда.ТекущийПользователь();
	//заменяемые записи — по отбору набора: без отбора по пользователю набор может заменить чужие
	Чужие = Не Отбор.Пользователь.Использование Или Отбор.Пользователь.Значение <> Текущий;
	Для Каждого Запись Из ЭтотОбъект Цикл
		Если Запись.Пользователь <> Текущий Тогда
			Чужие = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Чужие Тогда
		Отказ = Истина;
		ВызватьИсключение НСтр("ru = 'Чужие и общие оповещения меняет только руководитель. Своё напоминание — с вашим
			|пользователем; общее оповещение о долге закрывается командой «Завершить» в списке оповещений.'");
	КонецЕсли;

КонецПроцедуры
