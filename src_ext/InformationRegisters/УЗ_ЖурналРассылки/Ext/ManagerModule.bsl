//Журнал сообщений (до 2.2 — «Журнал писем о задолженности»): каждая попытка отправить сообщение ученику или
//плательщику — вид (задолженность, занятие, окончание абонемента, вручную), канал (почта, Telegram, SMS, WhatsApp),
//получатель, статус и ошибка (В46). Для задолженности — одна история ручной рассылки должникам и регламентного
//оповещения о долге (УЗ_Сервер.ПроверкаЗадолженности, В27): письмо ученику в организации не повторяется чаще N
//дней, кто бы его ни отправил. Напоминания о занятии и абонементе по нему не повторяются (УЗ_Сообщения).
//Менеджер журнал только читает: пишет код — обычной записью у руководителя, иначе в привилегированном режиме
//(вне безопасного режима; в безопасном режиме почта и так не уходит).

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

//Ключ ученика и организации в соответствиях последних писем.
Функция КлючПисьма(Ученик, Организация) Экспорт

	Возврат Строка(Ученик.УникальныйИдентификатор()) + "|"
		+ ?(ЗначениеЗаполнено(Организация), Строка(Организация.УникальныйИдентификатор()), "");

КонецФункции

//Последние ОТПРАВЛЕННЫЕ сообщения о долге (любым каналом; записи до 2.2 — без вида,
//это письма о долге): Соответствие КлючПисьма → дата письма.
//  Ученики — массив или Неопределено (все).
Функция ПоследниеПисьма(Ученики = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Журнал.Ученик КАК Ученик,
	|	Журнал.Организация КАК Организация,
	|	МАКСИМУМ(Журнал.Период) КАК Дата
	|ИЗ
	|	РегистрСведений.УЗ_ЖурналРассылки КАК Журнал
	|ГДЕ
	|	Журнал.Отправлено
	|	И Журнал.Вид В (ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыСообщений.Задолженность),
	|		ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыСообщений.ПустаяСсылка))
	|	И (&ВсеУченики
	|			ИЛИ Журнал.Ученик В (&Ученики))
	|
	|СГРУППИРОВАТЬ ПО
	|	Журнал.Ученик,
	|	Журнал.Организация";
	Запрос.УстановитьПараметр("ВсеУченики", Ученики = Неопределено);
	Запрос.УстановитьПараметр("Ученики", ?(Ученики = Неопределено, Новый Массив, Ученики));
	Итог = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Итог.Вставить(КлючПисьма(Выборка.Ученик, Выборка.Организация), Выборка.Дата);
	КонецЦикла;
	Возврат Итог;

КонецФункции

//Записать попытку письма о задолженности (почта; до 2.2 — единственный вид). Ошибка записи журнала не отменяет
//отправленного письма — она в журнале регистрации.
//  Вручную — Истина: рассылка должникам (с пользователем), Ложь — регламентное оповещение.
//Возврат: дата записи (Период) или пустая дата, если записать не удалось.
Функция ЗаписатьПисьмо(Ученик, Организация, Сумма, Адреса, Отправлено, ТекстОшибки, Вручную) Экспорт

	Запись = НоваяЗапись();
	Запись.Ученик = Ученик;
	Запись.Организация = Организация;
	Запись.Сумма = Сумма;
	Запись.Адреса = ?(ТипЗнч(Адреса) = Тип("Массив"), СтрСоединить(Адреса, "; "), Строка(Адреса));
	Запись.Отправлено = Отправлено;
	Запись.ТекстОшибки = ТекстОшибки;
	Запись.Вручную = Вручную;
	Запись.Вид = Перечисления.УЗ_ВидыСообщений.Задолженность;
	Запись.Канал = Перечисления.УЗ_КаналыСообщений.Почта;
	Запись.Статус = ?(Отправлено, Перечисления.УЗ_СтатусыСообщений.Отправлено, Перечисления.УЗ_СтатусыСообщений.Ошибка);
	Возврат ЗаписатьСообщение(Запись);

КонецФункции

//Пустая запись журнала для ЗаписатьСообщение: Структура по измерениям, ресурсам и реквизитам регистра.
Функция НоваяЗапись() Экспорт

	Возврат Новый Структура("Ученик, Организация, Получатель, Канал, Сумма, Отправлено, Адреса, ТекстОшибки, Вручную,
		|Вид, Статус, Источник, Текст", Справочники.УЗ_ФизЛица.ПустаяСсылка(), Справочники.Организации.ПустаяСсылка(),
		Справочники.УЗ_ФизЛица.ПустаяСсылка(), Перечисления.УЗ_КаналыСообщений.ПустаяСсылка(), 0, Ложь, "", "", Ложь,
		Перечисления.УЗ_ВидыСообщений.ПустаяСсылка(), Перечисления.УЗ_СтатусыСообщений.ПустаяСсылка(), Неопределено,
			"");

КонецФункции

//Записать попытку сообщения (Запись — см. НоваяЗапись). Ошибка записи журнала не отменяет отправленного сообщения —
//она в журнале регистрации. Пишет код отправки: у руководителя обычной записью, у менеджера — привилегированно
//(вне безопасного режима; в безопасном режиме сообщения и так не уходят).
//Возврат: дата записи (Период) или пустая дата, если записать не удалось.
Функция ЗаписатьСообщение(Данные) Экспорт

	Период = ТекущаяДатаСеанса();
	Привилегированно = Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.УЗ_ЖурналРассылки);
	Попытка
		Если Привилегированно Тогда
			УстановитьПривилегированныйРежим(Истина);
		КонецЕсли;
		//два сообщения одному получателю в одну секунду (повтор после
		//ошибки, два занятия) — следующая свободная секунда
		Для Сдвиг = 0 По 59 Цикл
			Проба = СоздатьМенеджерЗаписи();
			Проба.Период = Период;
			Проба.Ученик = Данные.Ученик;
			Проба.Организация = Данные.Организация;
			Проба.Получатель = Данные.Получатель;
			Проба.Канал = Данные.Канал;
			Проба.Прочитать();
			Если Не Проба.Выбран() Тогда
				Прервать;
			КонецЕсли;
			Период = Период + 1;
		КонецЦикла;
		Запись = СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Данные,
			"Ученик, Организация, Получатель, Канал, Сумма, Отправлено, Вручную, Вид,
			|Статус, Источник");
		Запись.Период = Период;
		Запись.Адреса = Лев(Данные.Адреса, 255);
		Запись.ТекстОшибки = Лев(Данные.ТекстОшибки, 1000);
		Запись.Текст = Лев(Данные.Текст, 1000);
		Если Данные.Вручную Тогда
			Запись.Пользователь = УЗ_Среда.ТекущийПользователь();
		КонецЕсли;
		Запись.Записать();
		Если Привилегированно Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
	Исключение
		Если Привилегированно И ПривилегированныйРежим() Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Учёт занятий.Сообщения'"), УровеньЖурналаРегистрации.Ошибка, ,
			Данные.Ученик,
			НСтр("ru = 'Не записан журнал сообщений:'") + " " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат '00010101';
	КонецПопытки;
	Возврат Период;

КонецФункции

#КонецЕсли
