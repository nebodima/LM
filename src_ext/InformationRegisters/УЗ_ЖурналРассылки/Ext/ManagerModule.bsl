//Журнал писем о задолженности: одна история для ручной рассылки должникам (обработка «Рассылка должникам») и
//регламентного оповещения о долге (УЗ_Сервер.ПроверкаЗадолженности, В27). По ней письмо ученику в организации не
//повторяется чаще N дней, кто бы его ни отправил: ручная рассылка не дублирует регламентное письмо, и наоборот.
//Менеджер журнал только читает: пишет код — обычной записью у руководителя, иначе в привилегированном режиме
//(вне безопасного режима; в безопасном режиме почта и так не уходит).

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

//Ключ ученика и организации в соответствиях последних писем.
Функция КлючПисьма(Ученик, Организация) Экспорт

	Возврат Строка(Ученик.УникальныйИдентификатор()) + "|"
		+ ?(ЗначениеЗаполнено(Организация), Строка(Организация.УникальныйИдентификатор()), "");

КонецФункции

//Последние ОТПРАВЛЕННЫЕ письма о долге: Соответствие КлючПисьма → дата письма.
//  Ученики — массив или Неопределено (все).
Функция ПоследниеПисьма(Ученики = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Журнал.Ученик КАК Ученик,
	|	Журнал.Организация КАК Организация,
	|	МАКСИМУМ(Журнал.Период) КАК Дата
	|ИЗ
	|	РегистрСведений.УЗ_ЖурналРассылки КАК Журнал
	|ГДЕ
	|	Журнал.Отправлено
	|	И (&ВсеУченики
	|			ИЛИ Журнал.Ученик В (&Ученики))
	|
	|СГРУППИРОВАТЬ ПО
	|	Журнал.Ученик,
	|	Журнал.Организация";
	Запрос.УстановитьПараметр("ВсеУченики", Ученики = Неопределено);
	Запрос.УстановитьПараметр("Ученики", ?(Ученики = Неопределено, Новый Массив, Ученики));
	Итог = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Итог.Вставить(КлючПисьма(Выборка.Ученик, Выборка.Организация), Выборка.Дата);
	КонецЦикла;
	Возврат Итог;

КонецФункции

//Записать попытку письма. Ошибка записи журнала не отменяет отправленного письма — она в журнале регистрации.
//  Вручную — Истина: рассылка должникам (с пользователем), Ложь — регламентное оповещение.
//Возврат: дата записи (Период) или пустая дата, если записать не удалось.
Функция ЗаписатьПисьмо(Ученик, Организация, Сумма, Адреса, Отправлено, ТекстОшибки, Вручную) Экспорт

	Период = ТекущаяДатаСеанса();
	Привилегированно = Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.УЗ_ЖурналРассылки);
	Попытка
		Если Привилегированно Тогда
			УстановитьПривилегированныйРежим(Истина);
		КонецЕсли;
		//два письма одному ученику в одну секунду (повтор после ошибки) — следующая свободная секунда
		Для Сдвиг = 0 По 59 Цикл
			Проба = СоздатьМенеджерЗаписи();
			Проба.Период = Период;
			Проба.Ученик = Ученик;
			Проба.Организация = Организация;
			Проба.Прочитать();
			Если Не Проба.Выбран() Тогда
				Прервать;
			КонецЕсли;
			Период = Период + 1;
		КонецЦикла;
		Запись = СоздатьМенеджерЗаписи();
		Запись.Период = Период;
		Запись.Ученик = Ученик;
		Запись.Организация = Организация;
		Запись.Сумма = Сумма;
		Запись.Адреса = Лев(?(ТипЗнч(Адреса) = Тип("Массив"), СтрСоединить(Адреса, "; "), Строка(Адреса)), 255);
		Запись.Отправлено = Отправлено;
		Запись.ТекстОшибки = Лев(ТекстОшибки, 1000);
		Запись.Вручную = Вручную;
		Если Вручную Тогда
			Запись.Пользователь = УЗ_Среда.ТекущийПользователь();
		КонецЕсли;
		Запись.Записать();
		Если Привилегированно Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
	Исключение
		Если Привилегированно И ПривилегированныйРежим() Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Учёт занятий.Почта'"), УровеньЖурналаРегистрации.Ошибка, , Ученик,
			НСтр("ru = 'Не записан журнал писем о задолженности:'") + " "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат '00010101';
	КонецПопытки;
	Возврат Период;

КонецФункции

#КонецЕсли
