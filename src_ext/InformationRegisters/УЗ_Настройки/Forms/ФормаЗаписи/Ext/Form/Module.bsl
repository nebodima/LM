//Регистр без измерений — одна запись. Стандартная форма записи открывала её как новую
//(«Настройки (создание)») и падала на записи «Запись с такими ключевыми полями существует».
//Поэтому форма без основного реквизита: читает и пишет единственную запись менеджером записи.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Менеджер = РегистрыСведений.УЗ_Настройки.СоздатьМенеджерЗаписи();
	Менеджер.Прочитать();
	ЗначениеВРеквизитФормы(Менеджер, "Запись");
	ТолькоПросмотр = Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.УЗ_Настройки);

КонецПроцедуры

&НаСервере
Функция ЗаписатьНаСервере()

	Менеджер = РеквизитФормыВЗначение("Запись");
	//период опроса оповещений не чаще раза в 5 минут (архитектор, 2.2): меньшее значение поднимается с пояснением
	Минимум = УЗ_ОбщийКлиентСервер.МинимальныйПериодОповещения();
	Если Менеджер.ПериодОповещения > 0 И Менеджер.ПериодОповещения < Минимум Тогда
		Менеджер.ПериодОповещения = Минимум;
		Запись.ПериодОповещения = Минимум;
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(СтрШаблон(
			НСтр("ru = 'Оповещения проверяются не чаще раза в %1 секунд — период увеличен до %1.'"), Минимум),
			"Запись.ПериодОповещения");
	КонецЕсли;
	Попытка
		Менеджер.Записать(Истина);
	Исключение
		УЗ_Общий.ЗаписатьОшибку("Настройки", ИнформацияОбОшибке(), НСтр("ru = 'Не удалось записать настройки'"));
		Возврат Ложь;
	КонецПопытки;
	Модифицированность = Ложь;
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура КомандаЗаписать(Команда)
	ЗаписатьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаписатьИЗакрыть(Команда)
	Если ЗаписатьНаСервере() Тогда
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьОповещенияПриИзменении(Элемент)
	
	Если Запись.ИспользоватьОповещения Тогда
		
		Если Запись.ПериодОповещения = 0 Тогда
			Запись.ПериодОповещения = УЗ_ОбщийКлиентСервер.ПериодОповещенияПоУмолчанию();
		КонецЕсли;
		
		Если Запись.ОповещатьОЗадолженности = 0 Тогда
			Запись.ОповещатьОЗадолженности = 2; // 2 дня
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьВидимость();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьВидимость();
КонецПроцедуры

//Флажок управляет только проверкой долгов: период показа напоминаний действует и без него
//(напоминания «Напомнить» показываются всегда), поэтому поле периода доступно всегда.
&НаКлиенте
Процедура ОбновитьВидимость()
	
	Если Запись.ИспользоватьОповещения Тогда		
		Элементы.ОповещатьОЗадолженности.Доступность 	= Истина;
	Иначе
		Элементы.ОповещатьОЗадолженности.Доступность 	= Ложь;
	КонецЕсли;
	
КонецПроцедуры