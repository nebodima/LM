//Настройки учёта занятий — одна запись регистра без измерений (в LM регистр был
//периодическим с фиктивным измерением Реквизит1, а читали его всегда срезом на сегодня).

//Структура: все ресурсы регистра по имени. Записи нет — значения по умолчанию типов.
//Имена ресурсов совпадают с реквизитами документов (Организация, Касса) — документы
//заполняются из структуры через ЗаполнитьЗначенияСвойств.
Функция Настройки() Экспорт

	Итог = Новый Структура;
	Запись = СоздатьМенеджерЗаписи();
	УстановитьПривилегированныйРежим(Истина);
	Запись.Прочитать();
	УстановитьПривилегированныйРежим(Ложь);
	Для Каждого Ресурс Из Метаданные.РегистрыСведений.УЗ_Настройки.Ресурсы Цикл
		Итог.Вставить(Ресурс.Имя, Запись[Ресурс.Имя]);
	КонецЦикла;
	Возврат Итог;

КонецФункции

//Записать значения из структуры (только переданные ресурсы; остальные сохраняются).
Процедура ЗаписатьНастройки(Значения) Экспорт

	Запись = СоздатьМенеджерЗаписи();
	Запись.Прочитать();
	ЗаполнитьЗначенияСвойств(Запись, Значения);
	Запись.Записать();

КонецПроцедуры
