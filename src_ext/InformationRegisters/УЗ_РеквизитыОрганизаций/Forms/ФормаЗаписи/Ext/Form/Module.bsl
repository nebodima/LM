
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Запись.Организация) Тогда
		Запись.Организация = РегистрыСведений.УЗ_Настройки.Настройки().Организация;
	КонецЕсли;
	ПоказатьСведенияОрганизации();

КонецПроцедуры

//Что берётся из карточки организации (ИНН, КПП, наименование) и может ли она выдавать справку для вычета.
&НаСервере
Процедура ПоказатьСведенияОрганизации()

	Если Не ЗначениеЗаполнено(Запись.Организация) Тогда
		Элементы.СведенияХозяина.Заголовок = "";
		Возврат;
	КонецЕсли;
	Сведения = УЗ_Печать.СведенияОбОрганизации(Запись.Организация);
	Части = Новый Массив;
	Части.Добавить(СтрШаблон(НСтр("ru = 'Из карточки организации: %1, ИНН %2%3.'"), Сведения.Наименование,
		?(ПустаяСтрока(Сведения.ИНН), НСтр("ru = 'не заполнен'"), Сведения.ИНН),
		?(ПустаяСтрока(Сведения.КПП), "", ", " + НСтр("ru = 'КПП'") + " " + Сведения.КПП)));
	Если Сведения.ЭтоИП Тогда
		Части.Добавить(НСтр("ru = 'Индивидуальный предприниматель: без лицензии можно, если учит сам (отметьте "
			+ "флажок ниже).'"));
	Иначе
		Части.Добавить(НСтр("ru = 'Организация: для справки на вычет нужна лицензия (номер и дата).'"));
	КонецЕсли;
	Элементы.СведенияХозяина.Заголовок = СтрСоединить(Части, " ");
	Элементы.ИПБезЛицензии.Доступность = Сведения.ЭтоИП Или Запись.ИПБезЛицензии;

КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ПоказатьСведенияОрганизации();
КонецПроцедуры
