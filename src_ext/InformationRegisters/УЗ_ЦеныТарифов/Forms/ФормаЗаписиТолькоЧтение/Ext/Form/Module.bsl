
&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	Оповестить("ЗакрытьФорму");
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Запись.Тариф = Параметры.Тариф;
	ЧасыТекстом = УЗ_ОбщийКлиентСервер.ЧасыМинуты(Запись.КоличествоЧасов, Истина);
КонецПроцедуры

//Часы вводятся строкой «ч:мм» (реквизит формы ЧасыТекстом), хранятся числом часов.
&НаКлиенте
Процедура КоличествоЧасовПриИзменении(Элемент)
	Часы = УЗ_ОбщийКлиентСервер.ЧасыИзСтроки(ЧасыТекстом);
	Если Часы = Неопределено Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(НСтр("ru = 'Часы вводятся как ч:мм, например 1:30.'"), "ЧасыТекстом");
	Иначе
		Запись.КоличествоЧасов = Часы;
		Запись.КоличествоУроков = 0;
	КонецЕсли;
	ЧасыТекстом = УЗ_ОбщийКлиентСервер.ЧасыМинуты(Запись.КоличествоЧасов, Истина);
	ОбновитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура КоличествоЗанятийПриИзменении(Элемент)
	Запись.КоличествоЧасов = 0;
	ЧасыТекстом = "";
	ОбновитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимость()

	Если Запись.КоличествоУроков > 0 Тогда
		Элементы.Декорация1.Заголовок = "" +Формат(Запись.Сумма/Запись.КоличествоУроков,"ЧДЦ=2")+ " за 1 урок ("
		+Формат(Запись.Сумма,"ЧДЦ=2")+ " / " +Запись.КоличествоУроков+ " ур.)";
	ИначеЕсли Запись.КоличествоЧасов > 0 Тогда
		Элементы.Декорация1.Заголовок = "" +Формат(Запись.Сумма/Запись.КоличествоЧасов,"ЧДЦ=2")+ " за 1 час ("
		+Формат(Запись.Сумма,"ЧДЦ=2")+ " / " + УЗ_ОбщийКлиентСервер.ЧасыМинуты(Запись.КоличествоЧасов) + " ч.)";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура СуммаПриИзменении(Элемент)
	ОбновитьВидимость();
КонецПроцедуры
