//В8 (решение владельца 28.09.2026, как в типовых): цена тарифа меняется только с даты ПОСЛЕ последнего
//проведённого урока по тарифу; на будущее — свободно. Прошлые цены (на дату последнего урока и раньше) не
//правятся и не удаляются: проведённые уроки посчитаны по ним. Прежде запрещалась любая запись по тарифу, у
//которого есть хоть одно движение (и новая цена на будущее тоже), а без отбора по тарифу проверялся пустой тариф.
Процедура ПередЗаписью(Отказ, Замещение)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	//прежняя цена карточки тарифа, по которой уроки уже посчитаны, переносится в историю при смене цены
	//карточки (РегистрыСведений.УЗ_ЦеныТарифов.ЗафиксироватьЦенуКарточки) — это не правка прошлого
	Если ДополнительныеСвойства.Свойство("ПрежняяЦенаКарточки") Тогда
		Возврат;
	КонецЕсли;

	//цена на дату с суммой — с единицей: «за уроки» или «за часы» (Т3); сумма 0 без единицы — явно бесплатно.
	//Прежде запись без единицы считалась «за 1 урок», а та же цена в карточке — «нет цены». Обе единицы —
	//считается за уроки (как урок и подсказки), с предупреждением
	Предел = УЗ_Общий.ПредельнаяСуммаДенег();
	Для Каждого Запись Из ЭтотОбъект Цикл
		//сумма истории цен шире строки урока: дороже предела урок урезал бы цену молча (тест нелепицы, 29.09.2026)
		Если Запись.Сумма > Предел Тогда
			УЗ_ОбщийКлиентСервер.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Цена тарифа «%1» на %2 больше %3: такую сумму не списать уроком'"),
				Запись.Тариф, Формат(Запись.Период, "ДЛФ=D"), Формат(Предел, "ЧДЦ=2")));
			Отказ = Истина;
			Возврат;
		ИначеЕсли Запись.Сумма <> 0 И Запись.КоличествоУроков <= 0 И Запись.КоличествоЧасов <= 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст =
				СтрШаблон(НСтр(
				"ru = 'Цена тарифа «%1» на %2: укажите количество уроков (цена за урок) или количество часов (цена за "
				+ "час)'"),
				Запись.Тариф, Формат(Запись.Период, "ДЛФ=D"));
			Сообщение.Сообщить();
			Отказ = Истина;
			Возврат;
		ИначеЕсли Запись.КоличествоУроков > 0 И Запись.КоличествоЧасов > 0 Тогда
			УЗ_ОбщийКлиентСервер.СообщитьПользователю(
				СтрШаблон(НСтр("ru = 'Цена тарифа «%1» на %2: указаны и уроки, и часы — цена считается за урок'"),
				Запись.Тариф, Формат(Запись.Период, "ДЛФ=D")));
		КонецЕсли;
	КонецЦикла;

	//что будет записано и что будет замещено (удалено) — по каждому тарифу
	Изменения = Новый ТаблицаЗначений;
	Изменения.Колонки.Добавить("Тариф");
	Изменения.Колонки.Добавить("Период");
	Изменения.Колонки.Добавить("Ключ");
	Изменения.Колонки.Добавить("Новая");
	Для Каждого Запись Из ЭтотОбъект Цикл
		ДобавитьИзменение(Изменения, Запись, Истина);
	КонецЦикла;
	Если Замещение Тогда
		Старые = РегистрыСведений.УЗ_ЦеныТарифов.СоздатьНаборЗаписей();
		Для Каждого ЭлементОтбора Из Отбор Цикл
			Если ЭлементОтбора.Использование Тогда
				Старые.Отбор[ЭлементОтбора.Имя].Установить(ЭлементОтбора.Значение);
			КонецЕсли;
		КонецЦикла;
		Старые.Прочитать();
		Для Каждого Запись Из Старые Цикл
			ДобавитьИзменение(Изменения, Запись, Ложь);
		КонецЦикла;
	КонецЕсли;
	Если Изменения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Тарифы = Изменения.ВыгрузитьКолонку("Тариф");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Движения.Тариф КАК Тариф,
	|	МАКСИМУМ(Движения.Период) КАК ПоследнийУрок
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки КАК Движения
	|ГДЕ
	|	Движения.Тариф В (&Тарифы)
	|	И Движения.Регистратор ССЫЛКА Документ.УЗ_Урок
	|	И Движения.Активность
	|
	|СГРУППИРОВАТЬ ПО
	|	Движения.Тариф";
	Запрос.УстановитьПараметр("Тарифы", Тарифы);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Граница = НачалоДня(Выборка.ПоследнийУрок);
		//неизменная прошлая запись (есть и в старых, и в новых с тем же ключом) — не правка
		Для Каждого Изменение Из Изменения.НайтиСтроки(Новый Структура("Тариф", Выборка.Тариф)) Цикл
			Если НачалоДня(Изменение.Период) > Граница Тогда
				Продолжить;
			КонецЕсли;
			Пара = Изменения.НайтиСтроки(
				Новый Структура("Тариф, Ключ, Новая", Выборка.Тариф, Изменение.Ключ, Не Изменение.Новая));
			Если Пара.Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст =
				СтрШаблон("Цену тарифа «%1» на %2 изменить нельзя: по ней проведён урок %3. Новую цену укажите с %4 "
				+ "или позже",
				Выборка.Тариф, Формат(Изменение.Период, "ДЛФ=D"), Формат(Выборка.ПоследнийУрок, "ДЛФ=D"),
				Формат(Граница + 86400, "ДЛФ=D"));
			Сообщение.Сообщить();
			Отказ = Истина;
			Возврат;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

//Ключ записи — период и значения ресурсов: одинаковый ключ в старых и новых записях значит «запись не менялась».
Процедура ДобавитьИзменение(Изменения, Запись, Новая)

	Изменение = Изменения.Добавить();
	Изменение.Тариф = Запись.Тариф;
	Изменение.Период = Запись.Период;
	Изменение.Новая = Новая;
	Изменение.Ключ = Формат(НачалоДня(Запись.Период), "ДФ=yyyyMMdd") + "|" + Формат(Запись.Сумма, "ЧГ=")
		+ "|" + Формат(Запись.КоличествоЧасов, "ЧГ=") + "|" + Формат(Запись.КоличествоУроков, "ЧГ=");

КонецПроцедуры