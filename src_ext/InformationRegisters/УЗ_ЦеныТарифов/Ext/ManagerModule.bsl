//Цена тарифа на Дата (последняя запись регистра не позже даты): Структура(КоличествоУроков,
//КоличествоЧасов, Сумма) или Неопределено, если цены нет.
Функция ПолучитьСуммуТарифаНаДату(Тариф, Дата) Экспорт

	ДанныеС = новый Структура;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЦеныТарифовСрезПоследних.Сумма КАК Сумма,
		|	ЦеныТарифовСрезПоследних.КоличествоЧасов КАК КоличествоЧасов,
		|	ЦеныТарифовСрезПоследних.КоличествоУроков КАК КоличествоУроков,
		|	ЦеныТарифовСрезПоследних.Период КАК Период
		|ИЗ
		|	РегистрСведений.УЗ_ЦеныТарифов.СрезПоследних(&Период, Тариф = &Тариф) КАК ЦеныТарифовСрезПоследних";
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("Тариф", Тариф);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	Если РезультатЗапроса.Количество() = 1 Тогда

		//без единицы запись больше не считается «за 1 урок» (как и карточка без единицы — цены нет; сумма 0 —
		//явно бесплатно): урок сообщит «нет цены» (Документы.УЗ_Урок.ЦенаСтрокиУрока); новые такие записи не пишутся
		ДанныеС.Вставить("КоличествоУроков",РезультатЗапроса[0].КоличествоУроков);

		ДанныеС.Вставить("КоличествоЧасов",РезультатЗапроса[0].КоличествоЧасов);
		ДанныеС.Вставить("Сумма",РезультатЗапроса[0].Сумма);

		Возврат ДанныеС;

	КонецЕсли;

	Возврат Неопределено;

КонецФункции

//Цена карточки тарифа годна: есть сумма и единица (уроки или часы).
Функция ЦенаКарточкиЗаполнена(Цена) Экспорт

	Возврат Цена.Сумма <> 0 И (Цена.КоличествоЧасов > 0 Или Цена.КоличествоУроков > 0);

КонецФункции

//Р2/В8 (решение владельца 28.09.2026, как в типовых — цена фиксируется на дату): изменилась одна цена
//в карточке тарифа (без истории цен) — она записывается в историю цен с первой свободной даты:
//сегодня, а если сегодня уже проведён урок по тарифу — со следующего дня после последнего проведённого урока.
//У тарифа ещё нет записей истории — прежняя цена карточки сначала пишется «с начала времён» (01.01.1980):
//уроки до новой даты продолжают считаться по ней, в т.ч. при перепроведении.
//Урок берёт цену на свою дату (Документы.УЗ_Урок.ЦенаТарифаНаДату).
Процедура ЗафиксироватьЦенуКарточки(Тариф, ПрежняяЦена, НоваяЦена, ОднаЦена) Экспорт

	Если Не ОднаЦена Или Не ЦенаКарточкиЗаполнена(НоваяЦена) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Цены.Период) КАК Записей
	|ИЗ
	|	РегистрСведений.УЗ_ЦеныТарифов КАК Цены
	|ГДЕ
	|	Цены.Тариф = &Тариф
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Движения.Период) КАК ПоследнийУрок
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки КАК Движения
	|ГДЕ
	|	Движения.Тариф = &Тариф
	|	И Движения.Регистратор ССЫЛКА Документ.УЗ_Урок
	|	И Движения.Активность";
	Запрос.УстановитьПараметр("Тариф", Тариф);
	Результаты = Запрос.ВыполнитьПакет();
	Записей = Результаты[0].Выгрузить()[0].Записей;
	ПоследнийУрок = Результаты[1].Выгрузить()[0].ПоследнийУрок;

	Если Записей = 0 И ЦенаКарточкиЗаполнена(ПрежняяЦена) Тогда
		Набор = СоздатьНаборЗаписей();
		Набор.Отбор.Период.Установить('19800101');
		Набор.Отбор.Тариф.Установить(Тариф);
		Запись = Набор.Добавить();
		Запись.Период = '19800101';
		Запись.Тариф = Тариф;
		ЗаполнитьЗначенияСвойств(Запись, ПрежняяЦена);
		//прежняя цена — та, по которой уроки уже посчитаны: не правка прошлого (проверка В8 в модуле набора)
		Набор.ДополнительныеСвойства.Вставить("ПрежняяЦенаКарточки", Истина);
		Набор.Записать();
	КонецЕсли;

	ДатаЦены = НачалоДня(ТекущаяДатаСеанса());
	Если ЗначениеЗаполнено(ПоследнийУрок) И НачалоДня(ПоследнийУрок) >= ДатаЦены Тогда
		ДатаЦены = НачалоДня(ПоследнийУрок) + 86400;
	КонецЕсли;

	Набор = СоздатьНаборЗаписей();
	Набор.Отбор.Период.Установить(ДатаЦены);
	Набор.Отбор.Тариф.Установить(Тариф);
	Запись = Набор.Добавить();
	Запись.Период = ДатаЦены;
	Запись.Тариф = Тариф;
	ЗаполнитьЗначенияСвойств(Запись, НоваяЦена);
	Набор.Записать();

	УЗ_ОбщийКлиентСервер.СообщитьПользователю(СтрШаблон(
		НСтр("ru = 'Новая цена тарифа «%1» действует с %2; уроки до этой даты остаются по прежней цене (она сохранена "
			+ "в истории цен)'"),
		Тариф, Формат(ДатаЦены, "ДЛФ=D")));

КонецПроцедуры
