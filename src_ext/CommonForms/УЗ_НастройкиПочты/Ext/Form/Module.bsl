//Настройки отправки почты «Учёта занятий» (регистр УЗ_НастройкиПочты, одна запись).
//Открывает только администратор. Пароль в форму не передаётся: поле пустое, сохранённый
//пароль меняется, только если в поле что-то ввели. «Проверить» — письмо себе, на адрес отправителя: фоновым
//заданием, форма раз в секунду спрашивает его состояние и показывает, сколько ждём (архитектор, 2.3, 28.09.2026:
//прежде SMTP с таймаутом 30 с держал клиента, а обработчик ожидания 0,1 с только перерисовывал форму).

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не УЗ_Почта.ЕстьПравоНастройки() Тогда
		ВызватьИсключение НСтр("ru = 'Настройки почты может открыть только администратор.'");
	КонецЕсли;
	Настройки = УЗ_Почта.Настройки();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки);
	Пароль = "";
	Элементы.Пароль.ПодсказкаВвода = ?(ПарольЗадан, НСтр("ru = 'сохранён — введите, чтобы заменить'"),
		НСтр("ru = 'не задан'"));

	ДоступностьПочты = УЗ_Почта.ДоступностьИнтернетПочты();
	Если ДоступностьПочты.БезопасныйРежим Тогда
		Состояние = НСтр("ru = 'Отправка почты в безопасном режиме запрещена.'") + " "
			+ УЗ_Общий.КакСнятьБезопасныйРежим();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	Если ЗаписатьНаСервере() Тогда
		Закрыть();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)

	Если ЗаписатьНаСервере() Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Настройки почты сохранены'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Проверить(Команда)

	Если Не ЗаписатьНаСервере() Тогда
		Возврат;
	КонецЕсли;
	Запуск = НачатьОтправкуНаСервере();
	Если Запуск.Результат <> Неопределено Или Не ПустаяСтрока(Запуск.Ошибка) Тогда
		Состояние = ТекстРезультата(Запуск.Результат, Запуск.Ошибка);
		Возврат;
	КонецЕсли;
	ЗаданиеПисьма = Запуск.Задание;
	АдресРезультата = Запуск.АдресРезультата;
	НачалоОжидания = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Элементы.ФормаПроверить.Доступность = Ложь;
	Состояние = НСтр("ru = 'Отправляем проверочное письмо…'");
	ПодключитьОбработчикОжидания("ПроверитьЗаданиеПисьма", 1, Истина);

КонецПроцедуры

//Опрос фонового задания раз в секунду: форма доступна, в «Состоянии» — сколько ждём; по завершении — итог.
&НаКлиенте
Процедура ПроверитьЗаданиеПисьма()

	Итог = СостояниеЗаданияНаСервере(ЗаданиеПисьма, АдресРезультата);
	Если Не Итог.Завершено Тогда
		Состояние = СтрШаблон(НСтр("ru = 'Отправляем проверочное письмо… %1 с'"),
			Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоОжидания) / 1000));
		ПодключитьОбработчикОжидания("ПроверитьЗаданиеПисьма", 1, Истина);
		Возврат;
	КонецЕсли;
	Элементы.ФормаПроверить.Доступность = Истина;
	Состояние = ТекстРезультата(Итог.Результат, Итог.Ошибка);

КонецПроцедуры

&НаСервере
Функция НачатьОтправкуНаСервере()

	Возврат УЗ_Почта.НачатьОтправкуТестовогоПисьма(УникальныйИдентификатор);

КонецФункции

&НаСервереБезКонтекста
Функция СостояниеЗаданияНаСервере(Знач Задание, Знач Адрес)

	Возврат УЗ_Общий.СостояниеДлительнойОперации(Задание, Адрес);

КонецФункции

//Итог проверки для поля «Состояние»: отправлено (с временем сервера) или почему нет.
&НаСервере
Функция ТекстРезультата(Знач Результат, Знач Ошибка)

	Если ПустаяСтрока(Ошибка) И ТипЗнч(Результат) = Тип("Структура") И Результат.Отправлено Тогда
		Возврат СтрШаблон(НСтр("ru = 'Проверочное письмо отправлено на %1 (%2). Проверьте входящие.'"),
			АдресОтправителя, Формат(ТекущаяДатаСеанса(), "ДЛФ=T"));
	КонецЕсли;
	Если ПустаяСтрока(Ошибка) И ТипЗнч(Результат) = Тип("Структура") Тогда
		Ошибка = Результат.ТекстОшибки;
	КонецЕсли;
	Возврат НСтр("ru = 'Письмо не отправлено:'") + " " + Ошибка;

КонецФункции

&НаСервере
Функция ЗаписатьНаСервере()

	Если Включена И (ПустаяСтрока(СерверSMTP) Или ПустаяСтрока(АдресОтправителя)) Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Чтобы отправлять письма, укажите сервер SMTP и адрес отправителя.'"),
			?(ПустаяСтрока(СерверSMTP), "СерверSMTP", "АдресОтправителя"));
		Возврат Ложь;
	КонецЕсли;
	Данные = Новый Структура("Включена, СерверSMTP, Порт, ИспользоватьSSL, Логин, АдресОтправителя,
		|ИмяОтправителя, ПисьмаОЗадолженности",
		Включена, СокрЛП(СерверSMTP), Порт, ИспользоватьSSL, СокрЛП(Логин), СокрЛП(АдресОтправителя),
		СокрЛП(ИмяОтправителя), ПисьмаОЗадолженности);
	ИзменитьПароль = Не ПустаяСтрока(Пароль);
	УЗ_Почта.СохранитьНастройки(Данные, Пароль, ИзменитьПароль);
	Если ИзменитьПароль Тогда
		ПарольЗадан = Истина;
		Пароль = "";
		Элементы.Пароль.ПодсказкаВвода = НСтр("ru = 'сохранён — введите, чтобы заменить'");
	КонецЕсли;
	Состояние = "";
	Возврат Истина;

КонецФункции
