//Настройки отправки почты «Учёта занятий» (регистр УЗ_НастройкиПочты, одна запись).
//Открывает только администратор. Пароль в форму не передаётся: поле пустое, сохранённый
//пароль меняется, только если в поле что-то ввели. «Проверить» — письмо себе, на адрес отправителя.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не УЗ_Почта.ЕстьПравоНастройки() Тогда
		ВызватьИсключение НСтр("ru = 'Настройки почты может открыть только администратор.'");
	КонецЕсли;
	Настройки = УЗ_Почта.Настройки();
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Настройки);
	Пароль = "";
	Элементы.Пароль.ПодсказкаВвода = ?(ПарольЗадан, НСтр("ru = 'сохранён — введите, чтобы заменить'"),
		НСтр("ru = 'не задан'"));

	ДоступностьПочты = УЗ_Почта.ДоступностьИнтернетПочты();
	Если ДоступностьПочты.БезопасныйРежим Тогда
		Состояние = НСтр("ru = 'Расширение «Учёт занятий» работает в безопасном режиме — в нём отправка почты запрещена.
			|Администратору: «Все функции» → «Управление расширениями конфигурации» → снять флажок «Безопасный режим».'");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	Если ЗаписатьНаСервере() Тогда
		Закрыть();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)

	Если ЗаписатьНаСервере() Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Настройки почты сохранены'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Проверить(Команда)

	Если Не ЗаписатьНаСервере() Тогда
		Возврат;
	КонецЕсли;
	Состояние = НСтр("ru = 'Отправляем проверочное письмо…'");
	ПодключитьОбработчикОжидания("ПроверитьЗавершение", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗавершение()

	Состояние = ОтправитьТестовоеПисьмоНаСервере();

КонецПроцедуры

&НаСервере
Функция ОтправитьТестовоеПисьмоНаСервере()

	ТекстОшибки = "";
	Если УЗ_Почта.ОтправитьТестовоеПисьмо(ТекстОшибки) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Проверочное письмо отправлено на %1 (%2). Проверьте входящие.'"),
			АдресОтправителя, Формат(ТекущаяДатаСеанса(), "ДЛФ=T"));
	КонецЕсли;
	Возврат НСтр("ru = 'Письмо не отправлено:'") + " " + ТекстОшибки;

КонецФункции

&НаСервере
Функция ЗаписатьНаСервере()

	Если Включена И (ПустаяСтрока(СерверSMTP) Или ПустаяСтрока(АдресОтправителя)) Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Чтобы отправлять письма, укажите сервер SMTP и адрес отправителя.'"),
			?(ПустаяСтрока(СерверSMTP), "СерверSMTP", "АдресОтправителя"));
		Возврат Ложь;
	КонецЕсли;
	Данные = Новый Структура("Включена, СерверSMTP, Порт, ИспользоватьSSL, Логин, АдресОтправителя,
		|ИмяОтправителя, ПисьмаОЗадолженности",
		Включена, СокрЛП(СерверSMTP), Порт, ИспользоватьSSL, СокрЛП(Логин), СокрЛП(АдресОтправителя),
		СокрЛП(ИмяОтправителя), ПисьмаОЗадолженности);
	ИзменитьПароль = Не ПустаяСтрока(Пароль);
	УЗ_Почта.СохранитьНастройки(Данные, Пароль, ИзменитьПароль);
	Если ИзменитьПароль Тогда
		ПарольЗадан = Истина;
		Пароль = "";
		Элементы.Пароль.ПодсказкаВвода = НСтр("ru = 'сохранён — введите, чтобы заменить'");
	КонецЕсли;
	Состояние = "";
	Возврат Истина;

КонецФункции
