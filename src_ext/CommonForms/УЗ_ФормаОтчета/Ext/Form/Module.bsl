// Своя форма отчетов УЗ на СКД — без БСП.
//
// Формирование, варианты (выбор/сохранение в хранилище платформы), пользовательские настройки
// и стандартная расшифровка — механизмы самой платформы: форма объявлена формой отчета
// (Результат, ДанныеРасшифровки, ГруппаБыстрыеНастройки в свойствах формы).
// Стандартные «Настройки...» и «Изменить вариант...» отключены: у хозяина (УНФ/БП/УТ) формы
// настроек и варианта по умолчанию — из БСП; вместо них своя панель «Настройки...» на этой форме.
//
// «Оформить приход денег» и «Оформить перемещение денег» (было патчем формы БСП в LM)
// видны только у отчета Взаиморасчеты: ученик, организация и предмет — из расшифровки текущей ячейки,
// иначе из отбора отчета; сумма — актуальный остаток на момент документа (УЗ_Сервер.ЗаполнениеДенежногоДокумента),
// а не текст ячейки (модернизация Codex Т1, 28.09.2026: итог нескольких учеников, часы, устаревший отчет
// больше не превращаются в оплату). Итог без одного ученика — отказ с пояснением, документ не открывается.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИмяОтчета = РеквизитФормыВЗначение("Отчет").Метаданные().Имя;
	КомандыКассы = (ИмяОтчета = "УЗ_Взаиморасчеты");
	Элементы.ФормаОформитьПКО.Видимость = КомандыКассы;
	Элементы.ФормаОформитьПеремещениеДенег.Видимость = КомандыКассы;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПоказатьНастройки(Команда)

	Показывать = НЕ Элементы.ГруппаНастройки.Видимость;
	Элементы.ГруппаНастройки.Видимость = Показывать;
	Элементы.ФормаПоказатьНастройки.Пометка = Показывать;

КонецПроцедуры

&НаКлиенте
Процедура ОформитьПКО(Команда)

	ОткрытьДенежныйДокумент("УЗ_ПриходДенег");

КонецПроцедуры

&НаКлиенте
Процедура ОформитьПеремещениеДенег(Команда)

	ОткрытьДенежныйДокумент("УЗ_ПеремещениеДенег");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Документ открывается с заполнением по актуальным данным; отказ (итог нескольких учеников, деньги в нескольких
// организациях) — сообщением, без документа; что подставлено — оповещением.
&НаКлиенте
Процедура ОткрытьДенежныйДокумент(ИмяДокумента)

	Заполнение = ЗначенияЗаполненияДокумента(ИмяДокумента, РасшифровкаТекущейЯчейки());
	Если НЕ ПустаяСтрока(Заполнение.Отказ) Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(Заполнение.Отказ);
		Возврат;
	КонецЕсли;
	ОткрытьФорму("Документ." + ИмяДокумента + ".ФормаОбъекта",
		Новый Структура("ЗначенияЗаполнения", Заполнение.Заполнение), ЭтотОбъект);
	ПоказатьОповещениеПользователя(НСтр("ru = 'Сумма — по остатку на сейчас'"), , Заполнение.Пояснение);

КонецПроцедуры

&НаКлиенте
Функция РасшифровкаТекущейЯчейки()

	Попытка
		Возврат Элементы.Результат.ТекущаяОбласть.Расшифровка;
	Исключение
		//честно: текущая область — не ячейка (рисунок, диаграмма); расшифровку возьмём из отбора
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// Ученик, организация и предмет — значения полей расшифровки ячейки (ближайшая группировка важнее), иначе
// включенные отборы «Равно»; текст ячейки не читается вовсе.
&НаСервере
Функция ЗначенияЗаполненияДокумента(ИмяДокумента, Знач Расшифровка)

	Поля = Новый Соответствие;
	Если ТипЗнч(Расшифровка) = Тип("ИдентификаторРасшифровкиКомпоновкиДанных")
		И ЭтоАдресВременногоХранилища(ДанныеРасшифровки) Тогда
		ДанныеОтчета = ПолучитьИзВременногоХранилища(ДанныеРасшифровки);
		Если ТипЗнч(ДанныеОтчета) = Тип("ДанныеРасшифровкиКомпоновкиДанных") Тогда
			ДобавитьПоляРасшифровки(ДанныеОтчета.Элементы[Расшифровка], Поля);
		КонецЕсли;
	КонецЕсли;
	ДобавитьПоляОтбора(Отчет.КомпоновщикНастроек.ПолучитьНастройки().Отбор.Элементы, Поля);

	Возврат УЗ_Сервер.ЗаполнениеДенежногоДокумента(ИмяДокумента, Поля.Получить("Клиент"),
		Поля.Получить("Организация"), Поля.Получить("ПредметОбучения"));

КонецФункции

// Поля ячейки и всех ее родителей (группировок) в расшифровке; ближайшее значение важнее.
&НаСервереБезКонтекста
Процедура ДобавитьПоляРасшифровки(ЭлементРасшифровки, Поля)

	Если ТипЗнч(ЭлементРасшифровки) = Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
		Для Каждого ЗначениеПоля Из ЭлементРасшифровки.ПолучитьПоля() Цикл
			Если Поля.Получить(ЗначениеПоля.Поле) = Неопределено Тогда
				Поля.Вставить(ЗначениеПоля.Поле, ЗначениеПоля.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого Родитель Из ЭлементРасшифровки.ПолучитьРодителей() Цикл
		ДобавитьПоляРасшифровки(Родитель, Поля);
	КонецЦикла;

КонецПроцедуры

// Включенные отборы «Равно» (вариант + пользовательские настройки) — если в ячейке поля не было.
&НаСервереБезКонтекста
Процедура ДобавитьПоляОтбора(ЭлементыОтбора, Поля)

	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		Если НЕ ЭлементОтбора.Использование Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ДобавитьПоляОтбора(ЭлементОтбора.Элементы, Поля);
			Продолжить;
		КонецЕсли;
		Если ЭлементОтбора.ВидСравнения <> ВидСравненияКомпоновкиДанных.Равно Тогда
			Продолжить;
		КонецЕсли;
		ИмяПоля = Строка(ЭлементОтбора.ЛевоеЗначение);
		Если Поля.Получить(ИмяПоля) = Неопределено Тогда
			Поля.Вставить(ИмяПоля, ЭлементОтбора.ПравоеЗначение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
