// Панель отчетов УЗ (было ВариантыОтчетовКлиент.ПоказатьПанельОтчетов БСП):
// состав подсистемы УЗ_УчетЗанятий.УЗ_Отчеты, только отчеты, на которые у пользователя есть право.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Подсистема = Метаданные.Подсистемы.УЗ_УчетЗанятий.Подсистемы.УЗ_Отчеты;
	Для Каждого ОбъектМетаданных Из Подсистема.Состав Цикл
		Если НЕ Метаданные.Отчеты.Содержит(ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ПравоДоступа("Использование", ОбъектМетаданных) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаОтчета = СписокОтчетов.Добавить();
		СтрокаОтчета.Имя = ОбъектМетаданных.Имя;
		СтрокаОтчета.Представление = ОбъектМетаданных.Представление();
		СтрокаОтчета.Пояснение = ОбъектМетаданных.Пояснение;
	КонецЦикла;
	СписокОтчетов.Сортировать("Представление");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы

&НаКлиенте
Процедура СписокОтчетовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьТекущийОтчет();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьОтчет(Команда)

	ОткрытьТекущийОтчет();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьТекущийОтчет()

	ТекущиеДанные = Элементы.СписокОтчетов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОткрытьФорму("Отчет." + ТекущиеДанные.Имя + ".Форма");

КонецПроцедуры

#КонецОбласти
