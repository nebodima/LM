//Своя печать документа «Учёта занятий» — когда у хозяина нет библиотеки стандартных подсистем
//и его формы «Печать документов». Документ формирует та же процедура Печать модуля менеджера.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ПустаяСтрока(Параметры.ИмяМенеджера) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Результат = УЗ_Печать.СформироватьСвоейПечатью(Параметры.ИмяМенеджера, Параметры.ИменаМакетов, Параметры.Объекты);
	ТабличныйДокумент = Результат.ТабличныйДокумент;
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	Если Не ПустаяСтрока(Результат.Заголовок) Тогда
		Заголовок = Результат.Заголовок;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Напечатать(Команда)

	ТабличныйДокумент.Напечатать(РежимИспользованияДиалогаПечати.Использовать);

КонецПроцедуры
