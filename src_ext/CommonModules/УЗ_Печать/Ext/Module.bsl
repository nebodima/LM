//Печать документов «Учёта занятий».
//
//У каждого печатаемого документа в модуле менеджера одна точка входа — процедура Печать
//с сигнатурой библиотеки стандартных подсистем (МассивОбъектов, ПараметрыПечати,
//КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода). Её вызывает:
//  * форма «Печать документов» хозяина, если у него есть БСП (подменю «Печать» документа
//    открывает её через УЗ_ПечатьКлиент, имя формы даёт УЗ_Среда.ФормаПечатиХозяина);
//  * своя печать этого модуля (СформироватьСвоейПечатью), если БСП у хозяина нет.
//Сама БСП здесь не вызывается: коллекция печатных форм — обычная таблица значений, поля
//которой мы заполняем так же, как это делает БСП.

//Пустая коллекция печатных форм того же устройства, что готовит БСП.
//  ИменаМакетов — строка идентификаторов через запятую ("ПКО" или "ПКО,РКО").
Функция НоваяКоллекцияПечатныхФорм(ИменаМакетов) Экспорт

	Коллекция = Новый ТаблицаЗначений;
	Для Каждого ИмяКолонки Из СтрРазделить("ИмяМакета,ИмяВРЕГ,СинонимМакета,ТабличныйДокумент,Экземпляров,"
		+ "Картинка,ПолныйПутьКМакету,ИмяФайлаПечатнойФормы", ",") Цикл
		Коллекция.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;
	Для Каждого Идентификатор Из СтрРазделить(ИменаМакетов, ",", Ложь) Цикл
		Идентификатор = СокрЛП(Идентификатор);
		Описание = Коллекция.Найти(ВРег(Идентификатор), "ИмяВРЕГ");
		Если Описание = Неопределено Тогда
			Описание = Коллекция.Добавить();
			Описание.ИмяМакета = Идентификатор;
			Описание.ИмяВРЕГ = ВРег(Идентификатор);
			Описание.Экземпляров = 1;
		Иначе
			Описание.Экземпляров = Описание.Экземпляров + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Коллекция;

КонецФункции

//Заказана ли печатная форма с этим идентификатором.
Функция НужноПечататьМакет(КоллекцияПечатныхФорм, ИмяМакета) Экспорт

	Возврат КоллекцияПечатныхФорм.Найти(ВРег(ИмяМакета), "ИмяВРЕГ") <> Неопределено;

КонецФункции

//Положить сформированный табличный документ в коллекцию печатных форм.
Процедура ВывестиВКоллекцию(КоллекцияПечатныхФорм, ИмяМакета, Синоним, ТабличныйДокумент) Экспорт

	Описание = КоллекцияПечатныхФорм.Найти(ВРег(ИмяМакета), "ИмяВРЕГ");
	Если Описание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Описание.ТабличныйДокумент = ТабличныйДокумент;
	Описание.СинонимМакета = Синоним;
	Если КоллекцияПечатныхФорм.Колонки.Найти("ПолныйПутьКМакету") <> Неопределено Тогда
		Описание.ПолныйПутьКМакету = "";
	КонецЕсли;

КонецПроцедуры

//Отметить в табличном документе область одного объекта печати (строки с НомерСтрокиНачало
//до конца документа). По этим областям форма печати хозяина раскладывает комплект по документам.
Процедура ЗадатьОбластьДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Ссылка) Экспорт

	Если ТипЗнч(ОбъектыПечати) <> Тип("СписокЗначений") Или ТабличныйДокумент.ВысотаТаблицы < НомерСтрокиНачало Тогда
		Возврат;
	КонецЕсли;
	Элемент = ОбъектыПечати.НайтиПоЗначению(Ссылка);
	Если Элемент = Неопределено Тогда
		ИмяОбласти = "Документ_" + Формат(ОбъектыПечати.Количество() + 1, "ЧН=; ЧГ=");
		ОбъектыПечати.Добавить(Ссылка, ИмяОбласти);
	Иначе
		ИмяОбласти = Элемент.Представление;
	КонецЕсли;
	ТабличныйДокумент.Область(НомерСтрокиНачало, , ТабличныйДокумент.ВысотаТаблицы, ).Имя = ИмяОбласти;

КонецПроцедуры

//Заголовок окна печати (иначе форма называется идентификатором макета).
Процедура УстановитьЗаголовок(ПараметрыВывода, Заголовок) Экспорт

	Если ТипЗнч(ПараметрыВывода) = Тип("Структура") Тогда
		ПараметрыВывода.Вставить("ЗаголовокФормы", Заголовок);
	КонецЕсли;

КонецПроцедуры

//Реквизиты организации для печати, справок и договоров (этап 2.1, В40). Какие реквизиты есть у хозяина, знает
//УЗ_Среда.РеквизитыОрганизацииХозяина (у УНФ, Бухгалтерии и Управления торговлей имена разные); значения читаются
//здесь запросом при каждом вызове — правка карточки организации видна сразу. Нет реквизита — пустая строка.
//Структура:
//  Наименование — сокращённое наименование (нет — краткое, нет — полное): так его пишет справка ФНС (порядок, п. 21);
//  НаименованиеПолное — полное (нет — Наименование); ИНН, КПП, ОКПО — строки;
//  ЭтоИП — индивидуальный предприниматель: ИНН из 12 цифр или признак хозяина «физическое лицо / ИП»;
//  ФИОПредпринимателя — у ИП: полное наименование без слов «Индивидуальный предприниматель» / «ИП»;
//  Представление — «ООО «Ромашка», ИНН 7701…, КПП 7701…» для кассовых ордеров.
Функция СведенияОбОрганизации(Организация) Экспорт

	Сведения = Новый Структура("Наименование, НаименованиеПолное, ИНН, КПП, ОКПО, ЭтоИП, ФИОПредпринимателя, "
		+ "Представление", "", "", "", "", "", Ложь, "", "");
	Имена = УЗ_Среда.РеквизитыОрганизацииХозяина();
	Если Не ЗначениеЗаполнено(Организация) Или Имена.Количество() = 0 Тогда
		Возврат Сведения;
	КонецЕсли;

	Поля = Новый Массив;
	Для Каждого ИмяРеквизита Из Имена Цикл
		Поля.Добавить("Организации." + ИмяРеквизита + " КАК " + ИмяРеквизита);
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ " + СтрСоединить(Поля, ", ")
		+ " ИЗ Справочник.Организации КАК Организации ГДЕ Организации.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Организация);
	Выгрузка = Запрос.Выполнить().Выгрузить();
	Если Выгрузка.Количество() = 0 Тогда
		Возврат Сведения;
	КонецЕсли;
	Данные = Новый Структура;
	Для Каждого Колонка Из Выгрузка.Колонки Цикл
		Данные.Вставить(Колонка.Имя, Выгрузка[0][Колонка.Имя]);
	КонецЦикла;

	Краткое = СтрокаРеквизита(Данные, "Наименование");
	Сокращенное = СтрокаРеквизита(Данные, "НаименованиеСокращенное");
	Полное = СтрокаРеквизита(Данные, "НаименованиеПолное");
	Сведения.Наименование = ?(ПустаяСтрока(Сокращенное), ?(ПустаяСтрока(Краткое), Полное, Краткое), Сокращенное);
	Сведения.НаименованиеПолное = ?(ПустаяСтрока(Полное), Сведения.Наименование, Полное);
	Сведения.ИНН = СтрокаРеквизита(Данные, "ИНН");
	Сведения.КПП = СтрокаРеквизита(Данные, "КПП");
	Сведения.ОКПО = СтрокаРеквизита(Данные, "КодПоОКПО");

	//признак хозяина — значение перечисления: имя значения в метаданных («ФизическоеЛицо»,
	//«ИндивидуальныйПредприниматель»)
	ВидЛица = "";
	Для Каждого ИмяПризнака Из СтрРазделить("ЮридическоеФизическоеЛицо,ЮрФизЛицо", ",") Цикл
		Если Данные.Свойство(ИмяПризнака) И ЗначениеЗаполнено(Данные[ИмяПризнака]) Тогда
			ВидЛица = ВидЛица + XMLСтрока(Данные[ИмяПризнака]);
		КонецЕсли;
	КонецЦикла;
	Сведения.ЭтоИП = СтрДлина(Сведения.ИНН) = 12
		Или СтрНайти(ВидЛица, "Физическ") > 0 Или СтрНайти(ВидЛица, "Предприним") > 0;
	Если Сведения.ЭтоИП Тогда
		ФИО = Сведения.НаименованиеПолное;
		Для Каждого Приставка Из СтрРазделить("Индивидуальный предприниматель |ИП ", "|") Цикл
			Если СтрНачинаетсяС(ВРег(ФИО), ВРег(Приставка)) Тогда
				ФИО = Сред(ФИО, СтрДлина(Приставка) + 1);
			КонецЕсли;
		КонецЦикла;
		Сведения.ФИОПредпринимателя = СокрЛП(ФИО);
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить(Сведения.НаименованиеПолное);
	Если Не ПустаяСтрока(Сведения.ИНН) Тогда
		Части.Добавить(НСтр("ru = 'ИНН'") + " " + Сведения.ИНН);
	КонецЕсли;
	Если Не ПустаяСтрока(Сведения.КПП) Тогда
		Части.Добавить(НСтр("ru = 'КПП'") + " " + Сведения.КПП);
	КонецЕсли;
	Сведения.Представление = СтрСоединить(Части, ", ");
	Возврат Сведения;

КонецФункции

Функция СтрокаРеквизита(Данные, Имя)

	Если Не Данные.Свойство(Имя) Или Не ЗначениеЗаполнено(Данные[Имя]) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Данные[Имя]));

КонецФункции

//Знакоместа бланка ФНС (справка КНД 1151158): поле из Длина клеток — параметры макета «Имя_1» … «Имя_Длина».
//Значение пишется по одному знаку слева направо с первой клетки, свободные клетки поля — прочерк (порядок
//заполнения справки, п. 11 и 14: «1234356------.50»). Буквы — заглавные. Клетки кладутся в структуру Параметры,
//её выводит Область.Параметры.Заполнить.
Процедура ДобавитьЗнакоместа(Параметры, Имя, Знач Значение, Длина) Экспорт

	Значение = ВРег(СокрЛП(Значение));
	Для Позиция = 1 По Длина Цикл
		//пробел внутри значения — пустая клетка (между словами), после значения — прочерк
		Знак = ?(Позиция > СтрДлина(Значение), "-", Сред(Значение, Позиция, 1));
		Параметры.Вставить(Имя + "_" + Формат(Позиция, "ЧГ="), Знак);
	КонецЦикла;

КонецПроцедуры

//Дата в знакоместах ДДММГГГГ (точки — в макете, п. 13); пустая дата — прочерки.
Процедура ДобавитьДатуЗнакоместами(Параметры, Имя, Дата) Экспорт

	ДобавитьЗнакоместа(Параметры, Имя, ?(ЗначениеЗаполнено(Дата), Формат(Дата, "ДФ=ddMMyyyy"), ""), 8);

КонецПроцедуры

//Своя печать — когда у хозяина нет БСП (и для проверок): вызывает Печать менеджера документа
//и собирает все сформированные формы в один табличный документ.
//  ИмяМенеджера — "Документ.УЗ_ПриходДенег"; ИменаМакетов — "ПКО"; Объекты — ссылка или массив ссылок.
//Структура: ТабличныйДокумент, Заголовок, ПечатныхФорм (сколько форм сформировано).
Функция СформироватьСвоейПечатью(ИмяМенеджера, ИменаМакетов, Объекты) Экспорт

	Результат = Новый Структура("ТабличныйДокумент, Заголовок, ПечатныхФорм", Новый ТабличныйДокумент, "", 0);
	Менеджер = МенеджерПечати(ИмяМенеджера);

	Если ТипЗнч(Объекты) = Тип("Массив") Тогда
		МассивОбъектов = Объекты;
	Иначе
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(Объекты);
	КонецЕсли;

	Коллекция = НоваяКоллекцияПечатныхФорм(ИменаМакетов);
	ОбъектыПечати = Новый СписокЗначений;
	ПараметрыВывода = Новый Структура("ЗаголовокФормы", "");
	Менеджер.Печать(МассивОбъектов, Новый Структура, Коллекция, ОбъектыПечати, ПараметрыВывода);

	Итог = Результат.ТабличныйДокумент;
	Для Каждого Описание Из Коллекция Цикл
		Если ТипЗнч(Описание.ТабличныйДокумент) <> Тип("ТабличныйДокумент") Тогда
			Продолжить;
		КонецЕсли;
		Если Результат.ПечатныхФорм = 0 Тогда
			//параметры страницы (ориентация, поля) — от первой формы
			Итог = Описание.ТабличныйДокумент;
		Иначе
			Итог.ВывестиГоризонтальныйРазделительСтраниц();
			Итог.Вывести(Описание.ТабличныйДокумент);
		КонецЕсли;
		Результат.ПечатныхФорм = Результат.ПечатныхФорм + 1;
		Если ПустаяСтрока(Результат.Заголовок) Тогда
			Результат.Заголовок = Описание.СинонимМакета;
		КонецЕсли;
	КонецЦикла;
	Результат.ТабличныйДокумент = Итог;
	Если Не ПустаяСтрока(ПараметрыВывода.ЗаголовокФормы) Тогда
		Результат.Заголовок = ПараметрыВывода.ЗаголовокФормы;
	КонецЕсли;
	Возврат Результат;

КонецФункции

//Менеджер своего документа по полному имени. Имя приходит с клиента (параметр формы),
//поэтому печатаем только документы «Учёта занятий».
Функция МенеджерПечати(ИмяМенеджера)

	Части = СтрРазделить(ИмяМенеджера, ".");
	Если Части.Количество() <> 2 Или Части[0] <> "Документ" Или Не СтрНачинаетсяС(Части[1], "УЗ_")
		Или Метаданные.Документы.Найти(Части[1]) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Печать: неизвестный менеджер печати «%1».'"), ИмяМенеджера);
	КонецЕсли;
	Возврат Документы[Части[1]];

КонецФункции
