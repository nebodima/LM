КонецФункции

//Ключ WebЦвета для выбранного в палитре цвета: «КоролевскиГолубой», а не «Королевскийголубой».
//Цвет вне палитры — пустая строка.
Функция ИмяWebЦвета(Цвет) Экспорт

	Для Каждого ИмяЦвета Из ИменаWebЦветов() Цикл
		Если WebЦвета[ИмяЦвета] = Цвет Тогда
			Возврат ИмяЦвета;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

//Цвет по сохранённому имени — ключу WebЦвета в любом регистре. Пустое или неизвестное имя — Новый Цвет
//(авто): поле формы остаётся без раскраски, форма не падает.
Функция WebЦветПоИмени(Знач Имя) Экспорт

	Имя = СокрЛП(Имя);
	Если ПустаяСтрока(Имя) Тогда
		Возврат Новый Цвет;
	КонецЕсли;
	Искомое = НРег(СтрЗаменить(СтрЗаменить(Имя, "-", ""), " ", ""));
	Для Каждого ИмяЦвета Из ИменаWebЦветов() Цикл
		Если НРег(ИмяЦвета) = Искомое Тогда
			Возврат WebЦвета[ИмяЦвета];
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Цвет;

КонецФункции

//«Темно-красный (DarkRed)» -> «Темно-красный»: имя цвета словами платформы.
Функция ИмяЦветаСловами(Цвет) Экспорт

	Имя = Строка(Цвет);
	Поз = СтрНайти(Имя, " (");
	Возврат ?(Поз > 0, Лев(Имя, Поз - 1), Имя);

КонецФункции

//«СветлоЖелтый» -> «Светло-жёлтый»: ключ WebЦвета, сохранённый в карточке, для списков (имя словами платформы, с «ё»).
//Имя вне палитры возвращается как есть.
Функция ПредставлениеЦвета(Знач Имя) Экспорт

	Имя = СокрЛП(Имя);
	Если ПустаяСтрока(Имя) Тогда
		Возврат "";
	КонецЕсли;
	Искомое = НРег(Имя);
	Для Каждого ИмяЦвета Из ИменаWebЦветов() Цикл
		Если НРег(ИмяЦвета) = Искомое Тогда
			Слова = ИмяЦветаСловами(WebЦвета[ИмяЦвета]);
			Слова = СтрЗаменить(Слова, "елтый", "ёлтый");
			Слова = СтрЗаменить(Слова, "еленый", "елёный");
			Слова = СтрЗаменить(Слова, "ерный", "ёрный");
			Возврат Слова;
		КонецЕсли;
	КонецЦикла;
	Возврат Имя;

КонецФункции

