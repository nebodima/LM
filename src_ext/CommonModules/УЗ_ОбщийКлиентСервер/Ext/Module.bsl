//Общие функции «Учёта занятий», доступные и на клиенте, и на сервере.

#Область ПрограммныйИнтерфейс

//Сообщение пользователю с привязкой к полю формы или объекта.
//  Текст — текст сообщения;
//  Поле — имя реквизита формы/объекта ("Объект.Ученики[2].Сумма" или "Педагог");
//  ПутьКДанным — путь к данным ("Объект"), если сообщение с сервера для объекта;
//  Отказ — если передан, выставляется в Истина.
Процедура СообщитьПользователю(Знач Текст, Знач Поле = "", Знач ПутьКДанным = "", Отказ = Неопределено) Экспорт

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Если Не ПустаяСтрока(Поле) Тогда
		Сообщение.Поле = Поле;
	КонецЕсли;
	Если Не ПустаяСтрока(ПутьКДанным) Тогда
		Сообщение.ПутьКДанным = ПутьКДанным;
	КонецЕсли;
	Сообщение.Сообщить();

	Если Отказ <> Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

//Номер документа для печати: без ведущих нулей в цифровой части, префикс сохраняется.
//  "000000123" -> "123"; "АС-000045" -> "АС-45".
Функция НомерНаПечать(Знач Номер) Экспорт

	Номер = СокрЛП(Номер);
	Длина = СтрДлина(Номер);
	НачалоЦифр = Длина + 1;
	Поз = Длина;
	Пока Поз >= 1 И СтрНайти("0123456789", Сред(Номер, Поз, 1)) > 0 Цикл
		НачалоЦифр = Поз;
		Поз = Поз - 1;
	КонецЦикла;
	Если НачалоЦифр > Длина Тогда
		Возврат Номер;
	КонецЕсли;

	Префикс = Лев(Номер, НачалоЦифр - 1);
	Цифры = Сред(Номер, НачалоЦифр);
	Пока СтрДлина(Цифры) > 1 И Лев(Цифры, 1) = "0" Цикл
		Цифры = Сред(Цифры, 2);
	КонецЦикла;
	Возврат Префикс + Цифры;

КонецФункции

//Номер документа без ведущих нулей: «00000012» → «12» (представления документов в списках и сообщениях).
Функция НомерБезНулей(Знач Номер) Экспорт

	Номер = СокрЛП(Номер);
	Пока СтрНачинаетсяС(Номер, "0") Цикл
		Номер = Сред(Номер, 2);
	КонецЦикла;
	Возврат Номер;

КонецФункции

//Подсказка цены тарифа — одна для карточки тарифа, записи цены, помощника уроков и представления тарифа:
//«1 000,00 за 1 урок (8 000,00 / 8 ур.)» или «1 000,00 за 1 час (1 000,00 / 1:00 ч)». Порядок единиц — как считает
//урок: сначала уроки, затем часы (от целых минут: 40 мин — ровно 2/3 часа). Цена — Структура(Сумма,
//КоличествоЧасов, КоличествоУроков) или Неопределено; Кратко — без скобок.
Функция ПредставлениеЦеныТарифа(Цена, Кратко = Ложь) Экспорт

	Если Цена = Неопределено Тогда
		Возврат НСтр("ru = 'нет цены'");
	ИначеЕсли Цена.Сумма = 0 Тогда
		Возврат НСтр("ru = 'Бесплатно'");
	ИначеЕсли Цена.КоличествоУроков > 0 Тогда
		Возврат Формат(Цена.Сумма / Цена.КоличествоУроков, "ЧДЦ=2") + " за 1 урок" + ?(Кратко, "",
			" (" + Формат(Цена.Сумма, "ЧДЦ=2") + " / " + Цена.КоличествоУроков + " ур.)");
	КонецЕсли;
	Часов = Окр(Цена.КоличествоЧасов * 60) / 60;
	Если Часов > 0 Тогда
		Возврат Формат(Цена.Сумма / Часов, "ЧДЦ=2") + " за 1 час" + ?(Кратко, "",
			" (" + Формат(Цена.Сумма, "ЧДЦ=2") + " / " + ЧасыМинуты(Цена.КоличествоЧасов) + " ч)");
	КонецЕсли;
	Возврат НСтр("ru = 'нет цены: не указано количество уроков или часов'");

КонецФункции

//Поле «ч:мм» формы записи цены тарифа (реквизит формы ЧасыТекстом) → Запись.КоличествоЧасов (уроки
//обнуляются); неверный ввод — сообщение у поля. Одна процедура для обеих форм записи цены.
Процедура ПрименитьЧасыЦены(Форма) Экспорт

	Часы = ЧасыИзСтроки(Форма.ЧасыТекстом);
	Если Часы = Неопределено Тогда
		СообщитьПользователю(НСтр("ru = 'Часы вводятся как ч:мм, например 1:30.'"), "ЧасыТекстом");
	Иначе
		Форма.Запись.КоличествоЧасов = Часы;
		Форма.Запись.КоличествоУроков = 0;
	КонецЕсли;
	Форма.ЧасыТекстом = ЧасыМинуты(Форма.Запись.КоличествоЧасов, Истина);

КонецПроцедуры

