//Общие функции «Учёта занятий», доступные и на клиенте, и на сервере.

//Сообщение пользователю с привязкой к полю формы или объекта.
//  Текст — текст сообщения;
//  Поле — имя реквизита формы/объекта ("Объект.Ученики[2].Сумма" или "Педагог");
//  ПутьКДанным — путь к данным ("Объект"), если сообщение с сервера для объекта;
//  Отказ — если передан, выставляется в Истина.
Процедура СообщитьПользователю(Знач Текст, Знач Поле = "", Знач ПутьКДанным = "", Отказ = Неопределено) Экспорт

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Если Не ПустаяСтрока(Поле) Тогда
		Сообщение.Поле = Поле;
	КонецЕсли;
	Если Не ПустаяСтрока(ПутьКДанным) Тогда
		Сообщение.ПутьКДанным = ПутьКДанным;
	КонецЕсли;
	Сообщение.Сообщить();

	Если Отказ <> Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

//Номер документа для печати: без ведущих нулей в цифровой части, префикс сохраняется.
//  "000000123" -> "123"; "АС-000045" -> "АС-45".
Функция НомерНаПечать(Знач Номер) Экспорт

	Номер = СокрЛП(Номер);
	Длина = СтрДлина(Номер);
	НачалоЦифр = Длина + 1;
	Поз = Длина;
	Пока Поз >= 1 И СтрНайти("0123456789", Сред(Номер, Поз, 1)) > 0 Цикл
		НачалоЦифр = Поз;
		Поз = Поз - 1;
	КонецЦикла;
	Если НачалоЦифр > Длина Тогда
		Возврат Номер;
	КонецЕсли;

	Префикс = Лев(Номер, НачалоЦифр - 1);
	Цифры = Сред(Номер, НачалоЦифр);
	Пока СтрДлина(Цифры) > 1 И Лев(Цифры, 1) = "0" Цикл
		Цифры = Сред(Цифры, 2);
	КонецЦикла;
	Возврат Префикс + Цифры;

КонецФункции
