#Область Ученик

//Полных лет на дату (возраст не хранится в карточке, а вычисляется от даты рождения: хранимый устаревал —
//через год в списках и «Днях рождения» оставался прежний). День рождения 29 февраля в невисокосный год
//наступает 1 марта. Даты рождения нет — 0.
Функция ВозрастНаДату(ДатаРождения, НаДату) Экспорт

	Если Не ЗначениеЗаполнено(ДатаРождения) Или НаДату < ДатаРождения Тогда
		Возврат 0;
	КонецЕсли;
	Лет = Год(НаДату) - Год(ДатаРождения);
	Если Месяц(НаДату) * 100 + День(НаДату) < Месяц(ДатаРождения) * 100 + День(ДатаРождения) Тогда
		Лет = Лет - 1;
	КонецЕсли;
	Возврат Лет;

КонецФункции

#КонецОбласти

#Область Длительность

//Число часов (дробь, как хранят тарифы, цены, абонементы, списания) — строкой «ч:мм» для экрана:
//1,5 → «1:30», 0,3333 → «0:20», 36 → «36:00» (время суток не годится: часов бывает больше 24).
//Не число — пустая строка; ноль — «0:00», а при НольПусто — пустая строка (поле, где часы не заданы).
Функция ЧасыМинуты(Знач Часы, НольПусто = Ложь) Экспорт

	Если ТипЗнч(Часы) <> Тип("Число") Или (НольПусто И Часы = 0) Тогда
		Возврат "";
	КонецЕсли;
	Минут = Окр(Часы * 60);
	Знак = ?(Минут < 0, "-", "");
	Минут = ?(Минут < 0, -Минут, Минут);
	Возврат Знак + Формат(Цел(Минут / 60), "ЧН=0; ЧГ=") + ":" + Формат(Минут % 60, "ЧЦ=2; ЧВН=; ЧН=00");

КонецФункции

//Строка «ч:мм» (или «1,5», «1.5», «2») — число часов с 4 знаками (20 минут — 0,3333).
//Пусто — 0. Не разобрать (минут 60 и больше, буквы) — Неопределено: поле покажет ошибку.
Функция ЧасыИзСтроки(Знач Текст) Экспорт

	Текст = СтрЗаменить(СокрЛП(Текст), " ", "");
	Если Текст = "" Тогда
		Возврат 0;
	КонецЕсли;
	Знак = 1;
	Если Лев(Текст, 1) = "-" Тогда
		Знак = -1;
		Текст = Сред(Текст, 2);
	КонецЕсли;
	Части = СтрРазделить(Текст, ":", Истина);
	Если Части.Количество() = 2 Тогда
		Часов = ЧислоИзТекста(Части[0]);
		Минут = ЧислоИзТекста(Части[1]);
		Если Часов = Неопределено Или Минут = Неопределено Или Цел(Часов) <> Часов Или Цел(Минут) <> Минут
			Или Минут >= 60 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Знак * Окр(Часов + Минут / 60, 4);
	ИначеЕсли Части.Количество() = 1 Тогда
		Часов = ЧислоИзТекста(Текст);
		Возврат ?(Часов = Неопределено, Неопределено, Знак * Окр(Часов, 4));
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ЧислоИзТекста(Знач Текст)

	Текст = СтрЗаменить(Текст, ",", ".");
	Если Текст = "" Тогда
		Возврат 0;
	КонецЕсли;
	Для Поз = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789.", Сред(Текст, Поз, 1)) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Если СтрЧислоВхождений(Текст, ".") > 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ОписаниеЧисла = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 4, ДопустимыйЗнак.Неотрицательный));
	Возврат ОписаниеЧисла.ПривестиЗначение(Текст);

КонецФункции

//Поле формы «время»: длительность урока хранится числом часов (4 знака: 40 мин = 0,6667), а на экране — временем «Ч:ММ».
//Перевод идёт через целые минуты, поэтому 0,6667 ч ↔ 0:40 и 1,5 ч ↔ 1:30 без накопления ошибки.

//Часы (число) → время (Дата 01.01.0001 Ч:ММ) для поля формы с форматом ДФ=Ч:мм.
Функция ВремяИзЧасов(Знач Часы) Экспорт

	Если ТипЗнч(Часы) <> Тип("Число") Тогда
		Возврат '00010101';
	КонецЕсли;
	Минут = Окр(Часы * 60);
	Минут = Макс(0, Мин(Минут, 24 * 60 - 1));
	Возврат '00010101' + Минут * 60;

КонецФункции

//Время (Дата, берётся только время дня) → часы числом с 4 знаками, как в реквизите КоличествоЧасов.
Функция ЧасыИзВремени(Знач Время) Экспорт

	Если ТипЗнч(Время) <> Тип("Дата") Тогда
		Возврат 0;
	КонецЕсли;
	Минут = Окр((Время - НачалоДня(Время)) / 60);
	Возврат Окр(Минут / 60, 4);

КонецФункции

