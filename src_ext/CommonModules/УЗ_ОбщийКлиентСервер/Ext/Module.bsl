КонецФункции

//Ключ WebЦвета для выбранного в палитре цвета: «КоролевскиГолубой», а не «Королевскийголубой».
//Цвет вне палитры — пустая строка.
Функция ИмяWebЦвета(Цвет) Экспорт

	Для Каждого ИмяЦвета Из ИменаWebЦветов() Цикл
		Если WebЦвета[ИмяЦвета] = Цвет Тогда
			Возврат ИмяЦвета;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

//Цвет по сохранённому имени. Понимает ключ WebЦвета в любом регистре и старые имена, собранные из
//представления цвета («Королевскийголубой», «Темнокрасный»). Пустое или неизвестное имя — Новый Цвет
//(авто): поле формы остаётся без раскраски, форма не падает.
Функция WebЦветПоИмени(Знач Имя) Экспорт

	Имя = СокрЛП(Имя);
	Если ПустаяСтрока(Имя) Тогда
		Возврат Новый Цвет;
	КонецЕсли;
	Искомое = НРег(СтрЗаменить(СтрЗаменить(Имя, "-", ""), " ", ""));
	Имена = ИменаWebЦветов();
	Для Каждого ИмяЦвета Из Имена Цикл
		Если НРег(ИмяЦвета) = Искомое Тогда
			Возврат WebЦвета[ИмяЦвета];
		КонецЕсли;
	КонецЦикла;
	//старые данные: ключ, собранный из представления цвета
	Для Каждого ИмяЦвета Из Имена Цикл
		ИзПредставления = НРег(СтрЗаменить(СтрЗаменить(ИмяЦветаСловами(WebЦвета[ИмяЦвета]), "-", ""), " ", ""));
		Если ИзПредставления = Искомое Тогда
			Возврат WebЦвета[ИмяЦвета];
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Цвет;

КонецФункции

//«Темно-красный (DarkRed)» -> «Темно-красный»: имя цвета словами платформы.
Функция ИмяЦветаСловами(Цвет) Экспорт

	Имя = Строка(Цвет);
	Поз = СтрНайти(Имя, " (");
	Возврат ?(Поз > 0, Лев(Имя, Поз - 1), Имя);

КонецФункции

