#Область ФИО

//«Фамилия И. О.» для узких мест (календарь, журнал): «Воронцова Елена Сергеевна» → «Воронцова Е. С.».
//Одно слово (или не ФИО) возвращается как есть.
Функция КраткоеФИО(Знач ФИО) Экспорт

	Слова = СтрРазделить(СокрЛП(ФИО), " ", Ложь);
	Если Слова.Количество() < 2 Тогда
		Возврат СокрЛП(ФИО);
	КонецЕсли;
	Итог = Слова[0];
	Для Поз = 1 По Мин(Слова.Количество() - 1, 2) Цикл
		Итог = Итог + " " + ВРег(Лев(Слова[Поз], 1)) + ".";
	КонецЦикла;
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область Деньги

//Остаток денег со знаком для текста (палитра, docs\визуал\дизайнер.md): «+1 800,00» — переплата (аванс),
//«−800,00» — долг, «0,00» — ноль. Знак минуса — типографский «−», как в сводке панели ученика.
Функция ПредставлениеОстаткаДенег(Знач Сумма) Экспорт

	Если ТипЗнч(Сумма) <> Тип("Число") Или Сумма = 0 Тогда
		Возврат "0,00";
	КонецЕсли;
	Возврат ?(Сумма > 0, "+", "−") + Формат(?(Сумма > 0, Сумма, -Сумма), "ЧДЦ=2; ЧН=0,00");

КонецФункции

#КонецОбласти

#КонецОбласти
