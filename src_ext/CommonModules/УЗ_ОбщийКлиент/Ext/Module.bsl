//Общие действия форм «Учёта занятий» на клиенте: одна копия вместо одинаковых процедур в нескольких формах.

#Область ПрограммныйИнтерфейс

//Новая карточка физ. лица из поля ввода (событие «Создание»): набранное ФИО — в наименование, Группа — имя
//предопределённой группы справочника УЗ_ФизЛица ("Педагоги", "Родители", "Ученики"). Окно владельца блокируется.
Процедура СоздатьФизЛицо(Форма, Элемент, Группа) Экспорт

	ПараметрыСтроки = Новый Структура("Наименование, Группа", СокрЛП(Элемент.ТекстРедактирования), Группа);
	ОткрытьФорму("Справочник.УЗ_ФизЛица.Форма.ФормаЭлемента", Новый Структура("Ключ2", ПараметрыСтроки), Форма,
		Форма.УникальныйИдентификатор, ВариантОткрытияОкна.ОтдельноеОкно, , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

//Выбор нескольких учеников из группы «Ученики»; выбранные — в Оповещение (массив ссылок).
Процедура ПодобратьУчеников(Форма, Оповещение) Экспорт

	Отбор = Новый Структура("Родитель", ПредопределенноеЗначение("Справочник.УЗ_ФизЛица.Ученики"));
	ОткрытьФорму("Справочник.УЗ_ФизЛица.Форма.ФормаВыбора", Новый Структура("МножественныйВыбор, Отбор", Истина, Отбор),
		Форма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

//Сделать выбранную в списке кассу основной; не вышло — сообщение с причиной, вышло — список обновляется.
Процедура СделатьКассуОсновной(Список) Экспорт

	ТекстОшибки = УЗ_Сервер.НазначитьОсновнуюКассу(Список.ТекущаяСтрока);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(ТекстОшибки);
	Иначе
		Список.Обновить();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
