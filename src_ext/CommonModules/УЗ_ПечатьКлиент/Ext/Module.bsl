//Команды подменю «Печать» документов «Учёта занятий».
//
//Есть у хозяина БСП — открываем его форму «Печать документов» с нашим менеджером печати:
//покупатель печатает, сохраняет и отправляет наши документы так же, как свои. Нет — своя
//форма УЗ_ПечатнаяФорма с табличным документом. Имя формы хозяина знает только УЗ_Среда.

//  ИмяМенеджера — "Документ.УЗ_ПриходДенег"; ИменаМакетов — "ПКО";
//  ПараметрКоманды — ссылка или массив ссылок; Владелец — форма, из которой печатают.
Процедура Печать(ИмяМенеджера, ИменаМакетов, ПараметрКоманды, Владелец) Экспорт

	Если ТипЗнч(ПараметрКоманды) = Тип("Массив") Тогда
		Объекты = ПараметрКоманды;
	Иначе
		Объекты = Новый Массив;
		Если ЗначениеЗаполнено(ПараметрКоманды) Тогда
			Объекты.Добавить(ПараметрКоманды);
		КонецЕсли;
	КонецЕсли;
	Если Объекты.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Печать'"), ,
			НСтр("ru = 'Сначала запишите документ.'"), БиблиотекаКартинок.ДиалогВосклицание);
		Возврат;
	КонецЕсли;

	ФормаХозяина = УЗ_Среда.ФормаПечатиХозяина();
	Если ЗначениеЗаполнено(ФормаХозяина) Тогда
		ПараметрыОткрытия = Новый Структура("ИмяМенеджераПечати, ИменаМакетов, ПараметрКоманды, ПараметрыПечати",
			ИмяМенеджера, ИменаМакетов, Объекты, Неопределено);
		ОткрытьФорму(ФормаХозяина, ПараметрыОткрытия, Владелец, Строка(Новый УникальныйИдентификатор));
	Иначе
		ПараметрыОткрытия = Новый Структура("ИмяМенеджера, ИменаМакетов, Объекты",
			ИмяМенеджера, ИменаМакетов, Объекты);
		ОткрытьФорму("ОбщаяФорма.УЗ_ПечатнаяФорма", ПараметрыОткрытия, Владелец, Строка(Новый УникальныйИдентификатор));
	КонецЕсли;

КонецПроцедуры
