//Оповещения и напоминания «Учёта занятий» на клиенте (замена напоминаний пользователя БСП:
//свой регистр УЗ_Оповещения, показ по таймеру из модуля приложения, команда «Напомнить»).

//Показать оповещения всплывающими окнами. Больше трёх — одно окно со ссылкой на список,
//чтобы не засыпать экран (например, утром после проверки задолженности).
Процедура Показать(Оповещения) Экспорт

	Если Оповещения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если Оповещения.Количество() > 3 Тогда
		ПоказатьОповещениеПользователя(
			СтрШаблон(НСтр("ru = 'Оповещений: %1'"), Оповещения.Количество()),
			"e1cib/list/РегистрСведений.УЗ_Оповещения",
			НСтр("ru = 'Откройте список оповещений'"),
			БиблиотекаКартинок.ДиалогИнформация, СтатусОповещенияПользователя.Важное);
		Возврат;
	КонецЕсли;
	Для Каждого Оповещение Из Оповещения Цикл
		ПоказатьОповещениеПользователя(Оповещение.Описание, Оповещение.Ссылка, Строка(Оповещение.Источник),
			БиблиотекаКартинок.ДиалогИнформация, СтатусОповещенияПользователя.Важное);
	КонецЦикла;

КонецПроцедуры

//Команда «Напомнить»: форма новой записи оповещения по объекту (время, текст, пользователь —
//текущий). Форма открывается обычным окном, не модально.
Процедура Напомнить(Источник, Владелец = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Источник) Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Напомнить'"), ,
			НСтр("ru = 'Сначала запишите объект.'"), БиблиотекаКартинок.ДиалогВосклицание);
		Возврат;
	КонецЕсли;
	ЗначенияЗаполнения = УЗ_Сервер.ЗначенияНапоминания(Источник);
	ОткрытьФорму("РегистрСведений.УЗ_Оповещения.ФормаЗаписи",
		Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения), Владелец);

КонецПроцедуры
