//Обработчики ожидания оповещений «Учёта занятий». Модуль глобальный: обработчик ожидания,
//подключённый из модуля приложения, ищется в глобальном контексте. Имена с префиксом УЗ_,
//чтобы не столкнуться с процедурами хозяина.

//Подключить периодическую проверку оповещений (из модуля приложения при начале работы).
Процедура УЗ_ПодключитьОповещения() Экспорт

	НастройкиПоказа = УЗ_Сервер.ПараметрыОповещений();
	Если Не НастройкиПоказа.Включено Тогда
		Возврат;
	КонецЕсли;
	//первая проверка — сразу после старта, дальше — по периоду
	ПодключитьОбработчикОжидания("УЗ_ПервыеОповещения", 5, Истина);
	ПодключитьОбработчикОжидания("УЗ_ПроверитьОповещения", НастройкиПоказа.Период);

КонецПроцедуры

Процедура УЗ_ПервыеОповещения() Экспорт

	УЗ_ПроверитьОповещения();

КонецПроцедуры

//Спросить сервер о наступивших оповещениях и показать их всплывающими окнами (не модально).
Процедура УЗ_ПроверитьОповещения() Экспорт

	Память = УЗ_ОповещенияКлиентПовтИсп.Память();
	Ответ = УЗ_Сервер.ПолучитьОповещения(Память.Получить("ПоказаныДо"));
	Память.Вставить("ПоказаныДо", Ответ.Сейчас);
	УЗ_ОповещенияКлиент.Показать(Ответ.Оповещения);

КонецПроцедуры
