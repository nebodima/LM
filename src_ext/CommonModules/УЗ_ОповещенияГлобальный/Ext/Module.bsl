//Обработчики ожидания оповещений «Учёта занятий». Модуль глобальный: обработчик ожидания,
//подключённый из модуля приложения, ищется в глобальном контексте. Имена с префиксом УЗ_,
//чтобы не столкнуться с процедурами хозяина.

//Подключить периодическую проверку оповещений (из модуля приложения при начале работы).
Процедура УЗ_ПодключитьОповещения() Экспорт

	//один вызов сервера при старте: заодно ставит параметры сеанса расширения (граница просмотра кассы
	//менеджера — по ней ограничение доступа ролей к кассовым документам и журналам)
	НастройкиПоказа = УЗ_Сервер.ПриНачалеРаботы();
	//в базе ещё нет ни одного человека, а помощник первого запуска пользователю доступен — открыть его (не модально)
	Если НастройкиПоказа.ПервыйЗапуск Тогда
		ОткрытьФорму("ОбщаяФорма.УЗ_ПервыйЗапуск");
	КонецЕсли;
	Если Не НастройкиПоказа.Включено Тогда
		Возврат;
	КонецЕсли;
	//первая проверка — сразу после старта, дальше — по периоду
	ПодключитьОбработчикОжидания("УЗ_ПервыеОповещения", 5, Истина);
	ПодключитьОбработчикОжидания("УЗ_ПроверитьОповещения", НастройкиПоказа.Период);

КонецПроцедуры

//Первая проверка оповещений через 5 с после старта (обработчик ожидания зовёт её по имени).
Процедура УЗ_ПервыеОповещения() Экспорт

	УЗ_ПроверитьОповещения();

КонецПроцедуры

//Спросить сервер о наступивших оповещениях и показать их всплывающими окнами (не модально).
Процедура УЗ_ПроверитьОповещения() Экспорт

	Память = УЗ_ОповещенияКлиентПовтИсп.Память();
	Ответ = УЗ_Сервер.ПолучитьОповещения(Память.Получить("ПоказаныДо"), Истина);
	Память.Вставить("ПоказаныДо", Ответ.Сейчас);
	УЗ_ОповещенияКлиент.Показать(Ответ.Оповещения);

КонецПроцедуры

//Оповещение пользователю ПОСЛЕ записи формы: стандартное «Изменение: …», которое платформа показывает сразу после
//записи, перекрывало пояснение, показанное в ПередЗаписью (урок «Урок записан как план» при записи будущего урока).
//Показ откладывается на 1 с и переживает закрытие формы («Провести и закрыть»): обработчик — в глобальном модуле.
Процедура УЗ_ПоказатьПослеЗаписи(Заголовок, Текст) Экспорт

	Память = УЗ_ОповещенияКлиентПовтИсп.Память();
	Память.Вставить("ПослеЗаписи", Новый Структура("Заголовок, Текст", Заголовок, Текст));
	ПодключитьОбработчикОжидания("УЗ_ОповещениеПослеЗаписи", 1, Истина);

КонецПроцедуры

//Отложенное оповещение УЗ_ПоказатьПослеЗаписи (обработчик ожидания зовёт его по имени).
Процедура УЗ_ОповещениеПослеЗаписи() Экспорт

	Память = УЗ_ОповещенияКлиентПовтИсп.Память();
	Оповещение = Память.Получить("ПослеЗаписи");
	Если Оповещение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Память.Удалить("ПослеЗаписи");
	ПоказатьОповещениеПользователя(Оповещение.Заголовок, , Оповещение.Текст, БиблиотекаКартинок.Информация,
		СтатусОповещенияПользователя.Важное);

КонецПроцедуры
