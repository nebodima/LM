//Зарплата педагога в уроке и ставки — только руководителю (R24 ревью 28.09, как в типовых: сдельный наряд
//закрывает мастер, начисление считает программа по ставке, ставку назначает руководитель).
//
//Урок начисление педагогу не хранит: проведение считает его по ставке урока (Документы.УЗ_Урок.НачисленияПоСтавке)
//и пишет сразу в регистр УЗ_РасчетыПоЗарплате, который менеджер пишет, но прочитать не может. Доплаты сверх ставки —
//документ «Начисление педагогам» на основании урока, он менеджеру не виден и не доступен для записи.
//Остаётся одно, чем менеджер мог бы повлиять на зарплату, — выбор ставки: в уроке, в карточке педагога и в группе.
//Права на реквизит «Ставка педагога» (без «Редактирование») — интерфейсные: форма, список, настройки. Запись из кода
//(обработки, внешнее соединение) они не останавливают, поэтому здесь — проверка на сервере по данным в базе.
//У кого зарплата доступна (УЗ_Общий.ДоступнаЗарплата — руководитель, администратор), проверки не действуют.

//Обработчик подписки УЗ_ЗарплатаУрокаПередЗаписью (после ПередЗаписью модуля урока: ставка уже подставлена).
//Новый урок — ставка по умолчанию (группы урока, иначе педагога): другую ставку менеджера, в том числе
//скопированную из урока-образца, код заменяет с сообщением. Записанный урок — ставку оставить прежней; при смене
//педагога или группы — ставка по умолчанию для них (так делает форма). Иначе — отказ.
Процедура ПередЗаписьюУрока(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт

	Если Источник.ОбменДанными.Загрузка Или УЗ_Общий.ДоступнаЗарплата() Тогда
		Возврат;
	КонецЕсли;

	ПоУмолчанию = Документы.УЗ_Урок.СтавкаПедагогаПоУмолчанию(Источник.Педагог, Источник.ГруппаОбучения);
	Если Источник.ЭтоНовый() Тогда
		Если Источник.СтавкаПедагога <> ПоУмолчанию Тогда
			Источник.СтавкаПедагога = ПоУмолчанию;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр(
				"ru = 'Ставка педагога в новом уроке — по умолчанию (группы урока, иначе карточки педагога): другую "
				+ "ставку выбирает руководитель.'");
			Сообщение.Сообщить();
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Прежний = УрокВБазе(Источник.Ссылка);
	Если Источник.СтавкаПедагога = Прежний.СтавкаПедагога Тогда
		Возврат;
	КонецЕсли;
	ПедагогИлиГруппаСменились = Источник.Педагог <> Прежний.Педагог
		Или Источник.ГруппаОбучения <> Прежний.ГруппаОбучения;
	Если ПедагогИлиГруппаСменились И Источник.СтавкаПедагога = ПоУмолчанию Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = НСтр("ru = 'Ставку педагога в уроке меняет руководитель: у вас нет доступа к зарплате.'");
	Сообщение.Сообщить();

КонецПроцедуры

//Из ПередЗаписью карточки педагога (Справочник.УЗ_ФизЛица) и группы (Справочник.УЗ_ГруппыОбучения): ставку
//назначает и меняет руководитель. Менеджер заводит педагога и группу без ставки или с прежней ставкой.
Процедура ПроверитьСтавкуСправочника(Объект, Отказ) Экспорт

	Если Объект.ОбменДанными.Загрузка Или Объект.ЭтоГруппа Или УЗ_Общий.ДоступнаЗарплата() Тогда
		Возврат;
	КонецЕсли;
	Прежняя = ?(Объект.ЭтоНовый(), Справочники.УЗ_СтавкиПедагогов.ПустаяСсылка(), Объект.Ссылка.СтавкаПедагога);
	Если Объект.СтавкаПедагога = Прежняя Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон(НСтр(
		"ru = '%1: ставку педагога назначает и меняет руководитель — у вас нет доступа к зарплате.'"), Объект);
	Сообщение.Поле = "СтавкаПедагога";
	Сообщение.Сообщить();

КонецПроцедуры

//Педагог, группа и ставка урока в базе.
Функция УрокВБазе(Ссылка)

	Итог = Новый Структура("Педагог, ГруппаОбучения, СтавкаПедагога");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Урок.Педагог КАК Педагог,
	|	Урок.ГруппаОбучения КАК ГруппаОбучения,
	|	Урок.СтавкаПедагога КАК СтавкаПедагога
	|ИЗ
	|	Документ.УЗ_Урок КАК Урок
	|ГДЕ
	|	Урок.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Итог, Выборка);
	КонецЕсли;
	Возврат Итог;

КонецФункции
