#Область ПрограммныйИнтерфейс

//В12 (A03, решение владельца 28.09.2026): деньги ученика учитываются раздельно по организациям, как взаиморасчёты
//в типовых. Остаток денег ученика в организации: «+» — оплачено вперёд, «−» — долг. Аванс 8 000 в А и долг 1 000
//в Б — это +8 000 в А и −1 000 в Б, а не общие +7 000. Формы документов (урок, ПКО, перемещение, панель ученика)
//показывают остаток по организации документа.
//  ПредметОбучения — Неопределено: по всем предметам; Граница — Неопределено: текущий остаток, иначе Дата/Граница.
//Виртуальная таблица сворачивает прочие измерения, СУММА — на случай нескольких строк.
Функция ОстатокДенегУченика(Ученик, Организация, ПредметОбучения = Неопределено, Граница = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(Ученик) Тогда
		Возврат 0;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки.Остатки(&Граница, Клиент = &Клиент И Организация = &Организация) КАК
	|		Остатки";
	Если ПредметОбучения <> Неопределено Тогда
		Запрос.Текст =
			СтрЗаменить(Запрос.Текст, "Организация = &Организация",
			"Организация = &Организация И ПредметОбучения = &ПредметОбучения");
		Запрос.УстановитьПараметр("ПредметОбучения", ПредметОбучения);
	КонецЕсли;
	Если Граница = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Остатки(&Граница,", "Остатки(,");
	Иначе
		Запрос.УстановитьПараметр("Граница", Граница);
	КонецЕсли;
	Запрос.УстановитьПараметр("Клиент", Ученик);
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.СуммаОстаток;

КонецФункции

//Свободный аванс ученика без предмета в организации на границу: остаток «без предмета» за вычетом долгов предметов
//(аванс без предмета зачитывается в любой долг — ЗадолженностьУченика; зачтённую часть второй раз не выдают и не
//перемещают). Аванс без предмета 1 000 и урок математики 1 000 — свободного аванса 0: деньги уже оплатили урок.
//Положительные остатки других предметов долг не гасят (у каждого предмета свои деньги, как договоры в типовых).
//Находка 1 третьего аудита Codex (28.09.2026): прежде возврат без предмета проверял сумму ВСЕХ предметов, а расход
//писал в пустой предмет — аванс математики возвращался дважды.
Функция СвободныйАвансБезПредмета(Ученик, Организация, Граница = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(Ученик) Тогда
		Возврат 0;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА ПоПредметам.ПредметОбучения = ЗНАЧЕНИЕ(Справочник.УЗ_ПредметыОбучения.ПустаяСсылка)
	|					ТОГДА ПоПредметам.Сумма
	|				КОГДА ПоПредметам.Сумма < 0
	|					ТОГДА ПоПредметам.Сумма
	|				ИНАЧЕ 0
	|			КОНЕЦ), 0) КАК Сумма
	|ИЗ
	|	(ВЫБРАТЬ
	|		Остатки.ПредметОбучения КАК ПредметОбучения,
	|		СУММА(Остатки.СуммаОстаток) КАК Сумма
	|	ИЗ
	|		РегистрНакопления.УЗ_СписанияСуммЗаУроки.Остатки(&Граница, Клиент = &Клиент И Организация = &Организация)
	|		КАК
	|			Остатки
	|
	|	СГРУППИРОВАТЬ ПО
	|		Остатки.ПредметОбучения) КАК ПоПредметам";
	Если Граница = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Остатки(&Граница,", "Остатки(,");
	Иначе
		Запрос.УстановитьПараметр("Граница", Граница);
	КонецЕсли;
	Запрос.УстановитьПараметр("Клиент", Ученик);
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Сумма;

КонецФункции

//Исключительная блокировка денег ученика в организации (по предмету или, Неопределено, по всем) — до чтения
//ОстатокДенегУченика в проведении: два расхода денег ученика (возврат, перемещение), проводимые одновременно, не
//израсходуют один аванс дважды. Вне транзакции ничего не делает.
Процедура ЗаблокироватьДеньгиУченика(Ученик, Организация, ПредметОбучения = Неопределено) Экспорт

	Если НЕ ТранзакцияАктивна() Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.УЗ_СписанияСуммЗаУроки");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Клиент", Ученик);
	ЭлементБлокировки.УстановитьЗначение("Организация", Организация);
	Если ПредметОбучения <> Неопределено Тогда
		ЭлементБлокировки.УстановитьЗначение("ПредметОбучения", ПредметОбучения);
	КонецЕсли;
	Блокировка.Заблокировать();

КонецПроцедуры

//Долг ученика к оплате (≥ 0) в организации — для «Рассчитать задолженность» и «Назначение платежа» прихода денег.
//По предмету: долг предмета за вычетом его доли аванса, внесённого без предмета (как аванс по договору в типовых —
//он зачитывается в любой долг, но ОДИН раз): оплата 5 000 без предмета и урок математики 1 000 — долга по математике
//нет, второй раз деньги не берутся. Аванс без предмета распределяется между долгами предметов по очереди — сначала
//предмет, чей долг начался раньше (при равных — по наименованию предмета): сумма долгов по предметам всегда равна
//долгу без предмета (R09 ревью 28.09: аванс 1 000 и долги математики и гитары по 1 000 давали 0 + 0 при общем
//долге 1 000; одна сумма на ученика и организацию — В12). Без предмета (Неопределено) — долг по всем предметам.
Функция ЗадолженностьУченика(Ученик, Организация, ПредметОбучения = Неопределено, Граница = Неопределено) Экспорт

	Если ПредметОбучения = Неопределено Тогда
		Возврат Макс(0, -ОстатокДенегУченика(Ученик, Организация, Неопределено, Граница));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ПредметОбучения) Тогда
		Возврат Макс(0, -ОстатокДенегУченика(Ученик, Организация, ПредметОбучения, Граница));
	КонецЕсли;
	Долги = ДолгиПоПредметам(Ученик, Организация, Граница);
	Долг = Долги[ПредметОбучения];
	Возврат ?(Долг = Неопределено, 0, Долг);

КонецФункции

//«Заполнить сумму по задолженности» прихода денег: предмет и сумма долга ученика в организации.
//Предмет выбран — сумма долга по нему (ЗадолженностьУченика). Предмет пуст — берётся предмет долга, как в типовых
//оплата подбирается к долгу по договору: приход без предмета не гасит долг предмета, и после такой оплаты долг по
//предмету в отчётах оставался. Долг по одному предмету — он и сумма; по нескольким — предмет, чей долг начался
//раньше, и его сумма, остальные предметы перечислены в пояснении (их оплачивают отдельными приходами). Долга по
//предметам нет — сумма общего долга без предмета (обычно 0).
//Возврат: Структура(ПредметОбучения — предмет или Неопределено, если не менять; Сумма; Пояснение — "" или текст).
Функция ЗаполнениеПоЗадолженности(Ученик, Организация, ПредметОбучения = Неопределено) Экспорт

	Итог = Новый Структура("ПредметОбучения, Сумма, Пояснение", Неопределено, 0, "");
	Если ЗначениеЗаполнено(ПредметОбучения) Тогда
		Итог.Сумма = ЗадолженностьУченика(Ученик, Организация, ПредметОбучения);
		Возврат Итог;
	КонецЕсли;
	Порядок = Новый Массив;
	Долги = ДолгиПоПредметам(Ученик, Организация, , Порядок);
	Если Порядок.Количество() = 0 Тогда
		Итог.Сумма = ЗадолженностьУченика(Ученик, Организация);
		Возврат Итог;
	КонецЕсли;
	Итог.ПредметОбучения = Порядок[0];
	Итог.Сумма = Долги[Порядок[0]];
	Если Порядок.Количество() > 1 Тогда
		Другие = Новый Массив;
		Для Поз = 1 По Порядок.Количество() - 1 Цикл
			Другие.Добавить(СтрШаблон("%1 — %2", Порядок[Поз], Формат(Долги[Порядок[Поз]], "ЧДЦ=2")));
		КонецЦикла;
		Итог.Пояснение = СтрШаблон(НСтр(
			"ru = 'Подставлен долг по предмету «%1». Ученик должен и по другим предметам: %2 — их оплатите отдельным "
			+ "приходом (или выберите предмет и нажмите кнопку снова).'"), Порядок[0], СтрСоединить(Другие, "; "));
	КонецЕсли;
	Возврат Итог;

КонецФункции

//«Заполнить по долгам» прихода денег (В35): долги ученика в организации по предметам (после зачёта аванса без
//предмета — ДолгиПоПредметам, как ЗадолженностьУченика), раньше начавшийся — первым, и долг без предмета (начисление
//ученику без предмета — вступительный взнос; находка 5 аудита Codex 2.1: прежде он попадал в строки, только если
//долгов по предметам не было). Аванс без предмета зачитывается один раз: есть аванс — нет долга без предмета.
//  Исключить — приход, который заполняется заново (находка 6): долг считается без его движений — он их заменит.
//Массив Структур (ПредметОбучения, Сумма).
Функция ДолгиДляОплаты(Ученик, Организация, Граница = Неопределено, Исключить = Неопределено) Экспорт

	Итог = Новый Массив;
	Порядок = Новый Массив;
	ОстатокБезПредмета = 0;
	Долги = ДолгиПоПредметам(Ученик, Организация, Граница, Порядок, Исключить, ОстатокБезПредмета);
	Для Каждого Предмет Из Порядок Цикл
		Итог.Добавить(Новый Структура("ПредметОбучения, Сумма", Предмет, Долги[Предмет]));
	КонецЦикла;
	Если ОстатокБезПредмета < 0 Тогда
		Итог.Добавить(Новый Структура("ПредметОбучения, Сумма", Справочники.УЗ_ПредметыОбучения.ПустаяСсылка(),
			-ОстатокБезПредмета));
	КонецЕсли;
	Если Итог.Количество() = 0 И Исключить = Неопределено Тогда
		Долг = ЗадолженностьУченика(Ученик, Организация, Неопределено, Граница);
		Если Долг > 0 Тогда
			Итог.Добавить(Новый Структура("ПредметОбучения, Сумма", Справочники.УЗ_ПредметыОбучения.ПустаяСсылка(),
				Долг));
		КонецЕсли;
	КонецЕсли;
	Возврат Итог;

КонецФункции

//В38: кому по умолчанию возвращаются деньги ученика — кто за него платил: плательщик последней оплаты ученика в
//организации по предмету (движения прихода кассы «Касса ученики» с реквизитом «Плательщик», до Граница); оплат по
//предмету нет — последней оплаты по любому предмету; оплат нет — основной плательщик карточки; нет и его — сам
//ученик (платил сам).
Функция ПолучательВозврата(Ученик, Организация, ПредметОбучения = Неопределено, Граница = Неопределено) Экспорт

	Если НЕ ЗначениеЗаполнено(Ученик) Тогда
		Возврат Справочники.УЗ_ФизЛица.ПустаяСсылка();
	КонецЕсли;
	//в записи возврата (ПередЗаписью) — как всякое чтение регистра накопления в транзакции: под блокировкой
	//(разделяемой — оплаты ученика только читаются)
	Если ТранзакцияАктивна() Тогда
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.УЗ_Касса");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
		ЭлементБлокировки.УстановитьЗначение("Клиент", Ученик);
		Блокировка.Заблокировать();
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Оплаты.Плательщик КАК Плательщик
	|ИЗ
	|	РегистрНакопления.УЗ_Касса КАК Оплаты
	|ГДЕ
	|	Оплаты.Клиент = &Ученик
	|	И Оплаты.Организация = &Организация
	|	И Оплаты.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыОпераций.КассаУченики)
	|	И Оплаты.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И Оплаты.Активность
	|	И Оплаты.Плательщик <> ЗНАЧЕНИЕ(Справочник.УЗ_ФизЛица.ПустаяСсылка)
	|	И Оплаты.Период <= &Граница
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР
	|		КОГДА Оплаты.ПредметОбучения = &ПредметОбучения
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ,
	|	Оплаты.Период УБЫВ,
	|	Оплаты.НомерСтроки УБЫВ";
	Запрос.УстановитьПараметр("Ученик", Ученик);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПредметОбучения", ?(ПредметОбучения = Неопределено,
		Справочники.УЗ_ПредметыОбучения.ПустаяСсылка(), ПредметОбучения));
	Запрос.УстановитьПараметр("Граница", ?(Граница = Неопределено, '39991231235959', Граница));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Плательщик;
	КонецЕсли;
	Основной = Справочники.УЗ_ФизЛица.ОсновнойПлательщик(Ученик);
	Возврат ?(ЗначениеЗаполнено(Основной), Основной, Ученик);

КонецФункции

//Текущая дата сеанса (серверное время) — для клиента: «план/факт», даты по умолчанию и статусы на экране считаются
//по часам сервера, а не компьютера пользователя (модернизация Codex Т2, 28.09.2026).
Функция ДатаСеанса() Экспорт
	Возврат ТекущаяДатаСеанса();
КонецФункции

//Заполнение денежного документа из отчёта «Взаиморасчёты» и панели ученика (модернизация Codex Т1, 28.09.2026):
//ученик, организация и предмет — типизированные значения расшифровки ячейки или отбора отчёта, сумма — АКТУАЛЬНЫЙ
//остаток на момент документа (серверное время), а не текст ячейки. Прежде сумма разбиралась из оформленного текста:
//итог нескольких учеников, часы или устаревший отчёт становились суммой оплаты, минус — плюсом, ошибка — нулём.
//  ИмяДокумента — "УЗ_ПриходДенег": сумма — долг к оплате (ЗадолженностьУченика: по предмету — за вычетом аванса
//    без предмета); "УЗ_ПеремещениеДенег": сумма — доступный аванс предмета-отправителя (как «Заполнить по остаткам»).
//  Организация — пустая: организация, где у ученика есть деньги (одна) или организация остатков по умолчанию;
//    деньги в нескольких организациях — отказ (В12: остатки раздельны, выбирать за пользователя нельзя).
//Структура: Заполнение — значения заполнения формы документа; Отказ — почему документ не открывать ("" — открыть);
//Пояснение — что подставлено (для оповещения пользователя).
Функция ЗаполнениеДенежногоДокумента(ИмяДокумента, Ученик, Организация = Неопределено,
	ПредметОбучения = Неопределено) Экспорт

	Результат = Новый Структура("Заполнение, Отказ, Пояснение", Новый Структура, "", "");
	Если ТипЗнч(Ученик) <> Тип("СправочникСсылка.УЗ_ФизЛица") Или НЕ ЗначениеЗаполнено(Ученик) Тогда
		Результат.Отказ =
			НСтр("ru = 'Встаньте на строку одного ученика или задайте отбор по ученику: итог по нескольким ученикам не "
			+ "превращается в оплату.'");
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(ПредметОбучения) <> Тип("СправочникСсылка.УЗ_ПредметыОбучения") Тогда
		ПредметОбучения = Справочники.УЗ_ПредметыОбучения.ПустаяСсылка();
	КонецЕсли;
	Если ТипЗнч(Организация) <> Тип("СправочникСсылка.Организации") Или НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = ОрганизацияДенегУченика(Ученик);
		Если Организация = Неопределено Тогда
			Результат.Отказ =
				СтрШаблон(НСтр(
				"ru = 'У ученика %1 деньги в нескольких организациях: встаньте на строку организации или задайте отбор "
				+ "по организации.'"), Ученик);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	Сейчас = ТекущаяДатаСеанса();
	Граница = Новый Граница(Сейчас, ВидГраницы.Включая);
	Заполнение = Результат.Заполнение;
	Если ЗначениеЗаполнено(Организация) Тогда
		Заполнение.Вставить("Организация", Организация);
	КонецЕсли;
	Если ИмяДокумента = "УЗ_ПриходДенег" Тогда
		Сумма = ЗадолженностьУченика(Ученик, Организация,
			?(ЗначениеЗаполнено(ПредметОбучения), ПредметОбучения, Неопределено), Граница);
		Заполнение.Вставить("ФизЛицо", Ученик);
		Заполнение.Вставить("ВидОперации", Перечисления.УЗ_ВидыОпераций.КассаУченики);
		//В33: плательщик — основной плательщик ученика
		Плательщик = Справочники.УЗ_ФизЛица.ОсновнойПлательщик(Ученик);
		Если ЗначениеЗаполнено(Плательщик) Тогда
			Заполнение.Вставить("Плательщик", Плательщик);
		КонецЕсли;
		Если ЗначениеЗаполнено(ПредметОбучения) Тогда
			Заполнение.Вставить("ПредметОбучения", ПредметОбучения);
		КонецЕсли;
		Если Сумма > 0 Тогда
			Заполнение.Вставить("СуммаДокумента", Сумма);
		КонецЕсли;
		ЧтоСчитали = НСтр("ru = 'Долг'");
	ИначеЕсли ИмяДокумента = "УЗ_ПеремещениеДенег" Тогда
		Сумма = Макс(0, ОстатокДенегУченика(Ученик, Организация, ПредметОбучения, Граница));
		Заполнение.Вставить("Клиент", Ученик);
		Заполнение.Вставить("СделатьДвиженияПоВзаиморасчетам", Истина);
		Если ЗначениеЗаполнено(ПредметОбучения) Тогда
			Заполнение.Вставить("ПредметОбученияОтправитель", ПредметОбучения);
		КонецЕсли;
		Если Сумма > 0 Тогда
			Заполнение.Вставить("Сумма", Сумма);
		КонецЕсли;
		ЧтоСчитали = НСтр("ru = 'Аванс'");
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестный денежный документ: %1'"), ИмяДокумента);
	КонецЕсли;

	Результат.Пояснение = СтрШаблон(НСтр("ru = '%1 %2%3%4 на %5: %6'"), ЧтоСчитали, Ученик,
		?(ЗначениеЗаполнено(ПредметОбучения), ", " + ПредметОбучения, ""),
		?(ЗначениеЗаполнено(Организация), " (" + Организация + ")", ""), Формат(Сейчас, "ДФ='dd.MM.yyyy HH:mm'"),
		?(Сумма > 0, Формат(Сумма, "ЧДЦ=2"), НСтр("ru = 'нет — сумма не заполнена'")));
	Возврат Результат;

КонецФункции

//«Назначение платежа» прихода денег: даты неоплаченных уроков ученика (Массив, по возрастанию). Из регистра денег
//ученика (одна правда с остатком, В12), а не суммой документов ПКО: учитываются возвраты, перемещения, бонусы,
//списание остатков, начисления и организация. Долг (ЗадолженностьУченика: по предмету — за вычетом аванса без
//предмета) на границу покрывают последние по времени начисления ученику — уроки «К оплате» и «Начисление ученику»
//(набор, материалы, В15); неоплаченные из них уроки — в назначение. R15 ревью 28.09: долг за набор 500 после
//оплаченного урока покрывался уроком — назначение называло оплаченный урок. Нет долга — пусто: второй раз за
//оплаченные уроки деньги не берутся.
Функция НеоплаченныеУрокиУченика(Ученик, Организация, ПредметОбучения = Неопределено, Граница = Неопределено) Экспорт

	Уроки = Новый Массив;
	Долг = ЗадолженностьУченика(Ученик, Организация, ПредметОбучения, Граница);
	Если Долг <= 0 Тогда
		Возврат Уроки;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Движения.Период КАК Период,
	|	Движения.Сумма КАК Сумма,
	|	Движения.Регистратор ССЫЛКА Документ.УЗ_Урок КАК ЭтоУрок
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки КАК Движения
	|ГДЕ
	|	(Движения.Регистратор ССЫЛКА Документ.УЗ_Урок
	|			ИЛИ Движения.Регистратор ССЫЛКА Документ.УЗ_НачислениеУченику)
	|	И Движения.Активность
	|	И Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|	И Движения.Клиент = &Ученик
	|	И Движения.Организация = &Организация
	|	И Движения.Сумма > 0
	|	И Движения.ПредметОбучения = &ПредметОбучения
	|	И Движения.Период <= &Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Движения.Период УБЫВ";
	Если ПредметОбучения = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Движения.ПредметОбучения = &ПредметОбучения", "");
	Иначе
		Запрос.УстановитьПараметр("ПредметОбучения", ПредметОбучения);
	КонецЕсли;
	Запрос.УстановитьПараметр("Ученик", Ученик);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата", ?(ТипЗнч(Граница) = Тип("Граница"), Граница.Значение.Дата,
		?(ТипЗнч(Граница) = Тип("Дата"), Граница, '39991231')));
	Выборка = Запрос.Выполнить().Выбрать();

	Покрыто = 0;
	Пока Покрыто < Долг И Выборка.Следующий() Цикл
		Покрыто = Покрыто + Выборка.Сумма;
		Если Выборка.ЭтоУрок Тогда
			Уроки.Вставить(0, Выборка.Период);
		КонецЕсли;
	КонецЦикла;
	Возврат Уроки;

КонецФункции

//Сколько оплачено по абонементу деньгами: приходы денег по абонементу минус возвраты по нему (движения регистра
//денег ученика с этим абонементом); Исключить — документ, чьи движения не считать (перезаполнение прихода).
//Приход на основании абонемента берёт неоплаченный остаток цены — второй раз полную цену не просит.
Функция ОплаченоПоАбонементу(Абонемент, Исключить = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|					ТОГДА Движения.Сумма
	|				ИНАЧЕ -Движения.Сумма
	|			КОНЕЦ), 0) КАК Сумма
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки КАК Движения
	|ГДЕ
	|	Движения.Абонемент = &Абонемент
	|	И Движения.Активность
	|	И Движения.Регистратор <> &Исключить
	|	И (Движения.Регистратор ССЫЛКА Документ.УЗ_ПриходДенег
	|			ИЛИ Движения.Регистратор ССЫЛКА Документ.УЗ_РасходДенег)";
	Запрос.УстановитьПараметр("Абонемент", Абонемент);
	Если Исключить = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Движения.Регистратор <> &Исключить", "");
	Иначе
		Запрос.УстановитьПараметр("Исключить", Исключить);
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Сумма;

КонецФункции

//Неизрасходованные деньги абонемента (оплата минус уроки и возвраты по нему) — сумма возврата на основании абонемента.
Функция ОстатокДенегПоАбонементу(Абонемент) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК Сумма
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки.Остатки(, Абонемент = &Абонемент) КАК Остатки";
	Запрос.УстановитьПараметр("Абонемент", Абонемент);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Сумма;

КонецФункции

#Область ДопРасходы

//Строка расхода (урок — вкладка «Доп. расходы», документ «Доп. расходы»): статья обязательна — по ней отчёт
//«Расходы», сумма больше нуля (отрицательная тихо уменьшала расходы). Возврат: "" — строка годится, иначе текст.
Функция ОшибкаСтрокиРасхода(СтрокаРасхода) Экспорт

	Если НЕ ЗначениеЗаполнено(СтрокаРасхода.СтатьяЗатрат) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Расходы, строка %1: укажите статью затрат.'"), СтрокаРасхода.НомерСтроки);
	КонецЕсли;
	Если СтрокаРасхода.Сумма <= 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'Расходы, строка %1: сумма должна быть больше нуля.'"), СтрокаРасхода.НомерСтроки);
	КонецЕсли;
	Возврат "";

КонецФункции

//Подписка УЗ_РасходыУрокаОдинИсточник (проведение урока): расходы урока вводятся один раз — в самом уроке или
//документом «Доп. расходы» на основании урока (он виден в уроке: «Связанные документы»). Урок с расходами при
//проведённом документе по нему не проводится — отчёт «Расходы» показал бы сумму дважды; строки расходов урока —
//со статьёй и суммой больше нуля, как в документе.
Процедура РасходыУрокаОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт

	Если Источник.ОбменДанными.Загрузка Или Источник.Расходы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаРасхода Из Источник.Расходы Цикл
		Текст = ОшибкаСтрокиРасхода(СтрокаРасхода);
		Если ЗначениеЗаполнено(Текст) Тогда
			УЗ_Общий.СообщитьОбОшибкеОбъекта(Источник, Текст,
				СтрШаблон("Расходы[%1].Сумма", СтрокаРасхода.НомерСтроки - 1),
				Отказ);
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Документы.Ссылка КАК Ссылка,
	|	Документы.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.УЗ_ДополнительныеРасходы КАК Документы
	|ГДЕ
	|	Документы.ДокументОснования = &Урок
	|	И Документы.Проведен";
	Запрос.УстановитьПараметр("Урок", Источник.Ссылка);
	//РАЗРЕШЕННЫЕ: менеджеру из «Доп. расходов» видны только документы на основании урока (ограничение роли,
	//R06 ревью 28.09: прежде «ГДЕ ЛОЖЬ» — документ руководителя по уроку проверка менеджера не находила, и те же
	//расходы вносились второй раз вкладкой урока — в отчёте «Расходы» 1 000 вместо 500); привилегированный режим в
	//расширении из файла не действует. Прочие доп. расходы менеджеру по-прежнему не видны (общий журнал — S04)
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(Источник,
			СтрШаблон(НСтр(
			"ru = 'Расходы этого урока уже введены документом %1 (%2). Один расход вводится один раз: очистите вкладку "
			+ "«Доп. расходы» урока или отмените проведение документа.'"),
			Выборка.Ссылка, Формат(Выборка.СуммаДокумента, "ЧДЦ=2; ЧН=0,00")), "Расходы", Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

//Остатки денег ученика по организациям и предметам (карточка ученика) — та же величина, что ОстатокДенегУченика:
//итог строк организации равен ОстатокДенегУченика(Ученик, Организация). Нулевые строки не выводятся.
//ТаблицаЗначений: Организация, ПредметОбучения, Остаток («+» — оплачено вперёд, «−» — долг).
Функция ОстаткиДенегУченика(Ученик) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Организация КАК Организация,
	|	Остатки.ПредметОбучения КАК ПредметОбучения,
	|	СУММА(Остатки.СуммаОстаток) КАК Остаток
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки.Остатки(, Клиент = &Клиент) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Организация,
	|	Остатки.ПредметОбучения
	|
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.СуммаОстаток) <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.Организация.Наименование,
	|	Остатки.ПредметОбучения.Наименование";
	Запрос.УстановитьПараметр("Клиент", Ученик);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

//Организация, в которой списки учеников, выбор ученика и журнал уроков показывают остаток денег (В12): из настроек
//учёта; не задана — единственная организация базы. Организаций несколько, в настройках пусто — Неопределено:
//колонка показывает остаток по всем организациям и так и подписана.
Функция ОрганизацияОстатков() Экспорт

	Организация = ПолучитьНастройки().Организация;
	Если ЗначениеЗаполнено(Организация) Тогда
		Возврат Организация;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления");
	Организации = Запрос.Выполнить().Выгрузить();
	Возврат ?(Организации.Количество() = 1, Организации[0].Ссылка, Неопределено);

КонецФункции

//Параметры остатка денег в динамическом списке (формы списка, выбора и подбора учеников): &Организация,
//&ВсеОрганизации (в запросе — Остатки(, &ВсеОрганизации ИЛИ Организация = &Организация)) и &Сегодня (возраст
//вычисляется от даты рождения). Возвращает заголовок колонки: «Остаток денег (Студия А)» или «… (все организации)».
Функция УстановитьПараметрыОстатка(Список) Экспорт

	Организация = ОрганизацияОстатков();
	Список.Параметры.УстановитьЗначениеПараметра("Организация", ?(Организация = Неопределено,
		Справочники.Организации.ПустаяСсылка(), Организация));
	Список.Параметры.УстановитьЗначениеПараметра("ВсеОрганизации", Организация = Неопределено);
	Список.Параметры.УстановитьЗначениеПараметра("Сегодня", НачалоДня(ТекущаяДатаСеанса()));
	Возврат СтрШаблон(НСтр("ru = 'Остаток денег (%1)'"),
		?(Организация = Неопределено, НСтр("ru = 'все организации'"), Строка(Организация)));

КонецФункции

//Должники — ученики с отрицательным остатком денег в организации (В12: по каждой организации отдельно — аванс
//8 000 в А не гасит долг 1 000 в Б). Педагоги — не ученики (роль при выборе, В18/Р8) и должниками не считаются.
//Одно правило для диаграммы должников журнала уроков и оповещений о долге (было: диаграмма исключала педагогов,
//задание — нет; обе сворачивали организации).
//  Ученики — массив или Неопределено (все). ТаблицаЗначений: Клиент, Организация, Долг (положительный), по убыванию.
Функция Должники(Ученики = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаДолжников() + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Должники.Клиент КАК Клиент,
	|	ВТ_Должники.Организация КАК Организация,
	|	-ВТ_Должники.Остаток КАК Долг
	|ИЗ
	|	ВТ_Должники КАК ВТ_Должники
	|
	|УПОРЯДОЧИТЬ ПО
	|	Долг УБЫВ";
	УстановитьПараметрыДолжников(Запрос, Ученики);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#Область Оповещения

//Должники (см. Должники) с датой ВОЗНИКНОВЕНИЯ долга — последнего перехода остатка ученика в организации из «≥ 0»
//в «< 0» (по регистратору). Одно правило для регламентного оповещения (В27) и рассылки должникам.
//  Ученики — массив или Неопределено (все). ТаблицаЗначений: Клиент, Организация, Долг (положительный), НачалоДолга
//  (пустая дата — переход не найден: долг с начала учёта).
Функция ДолжникиИНачалоДолга(Ученики = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаДолжников() + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Обороты.Клиент КАК Клиент,
	|	Обороты.Организация КАК Организация,
	|	МАКСИМУМ(Обороты.Период) КАК НачалоДолга
	|ПОМЕСТИТЬ ВТ_НачалоДолга
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки.ОстаткиИОбороты(
	|			,
	|			,
	|			Регистратор,
	|			,
	|			Клиент В
	|				(ВЫБРАТЬ
	|					ВТ_Должники.Клиент
	|				ИЗ
	|					ВТ_Должники КАК ВТ_Должники)) КАК Обороты
	|ГДЕ
	|	Обороты.СуммаНачальныйОстаток >= 0
	|	И Обороты.СуммаКонечныйОстаток < 0
	|
	|СГРУППИРОВАТЬ ПО
	|	Обороты.Клиент,
	|	Обороты.Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Должники.Клиент КАК Клиент,
	|	ВТ_Должники.Организация КАК Организация,
	|	-ВТ_Должники.Остаток КАК Долг,
	|	ЕСТЬNULL(ВТ_НачалоДолга.НачалоДолга, ДАТАВРЕМЯ(1, 1, 1)) КАК НачалоДолга
	|ИЗ
	|	ВТ_Должники КАК ВТ_Должники
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НачалоДолга КАК ВТ_НачалоДолга
	|		ПО ВТ_Должники.Клиент = ВТ_НачалоДолга.Клиент
	|			И ВТ_Должники.Организация = ВТ_НачалоДолга.Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Должники.Клиент,
	|	ВТ_Должники.Организация";
	УстановитьПараметрыДолжников(Запрос, Ученики);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

//Регламентное задание УЗ_ПроверкаЗадолженности — оповещения о долге учеников (В27), общие для всех пользователей
//(Пользователь пустой). Жизненный цикл, как напоминания о задолженности в типовых:
//  * должник — см. Должники: отрицательный остаток в организации (В12), без педагогов;
//  * срок «Оповещать о задолженности за N дней» — от даты ВОЗНИКНОВЕНИЯ долга: последнего момента, когда остаток
//    ученика в организации перешёл из «≥ 0» в «< 0» (было: две точки «сейчас» и «N дней назад» — погашение между
//    ними не замечалось, новый долг оповещался сразу);
//  * одно незавершённое оповещение на ученика и организацию; сумма в нём обновляется при каждом запуске;
//  * долг погашен — оповещение закрывается само (Завершено), висеть у всех «Задолженность … 1 000,00» не будет;
//  * письмо ученику/родителю (если включено в настройках почты) повторяется раз в N дней, пока долг не погашен;
//    дата последнего письма — в оповещении (ДатаПисьма); неудачная отправка даты не ставит — письмо уйдёт при
//    следующем запуске. «Завершить» вручную при живом долге заводит новое оповещение, но письмо — не раньше N дней
//    после прошлого.
//  Ученики — массив: проверить только их (проверки на копиях баз не трогают чужих учеников и не шлют им
//  писем); Неопределено — всех (регламентное задание).
//Модуль вызывается с клиента, а проверка заводит общие оповещения и шлёт письма, поэтому запускают её только
//регламентное задание (фоновый сеанс) и тот, кто меняет настройки учёта (руководитель, администратор).
Процедура ПроверкаЗадолженности(Ученики = Неопределено) Экспорт

	Если ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание() = Неопределено Тогда
		ВыполнитьПроверкуПравДоступа("Изменение", Метаданные.РегистрыСведений.УЗ_Настройки);
	КонецЕсли;
	Настройки = ПолучитьНастройки();
	Если Не Настройки.ИспользоватьОповещения Или Настройки.ОповещатьОЗадолженности <= 0 Тогда
		Возврат;
	КонецЕсли;
	Срок = Настройки.ОповещатьОЗадолженности * 86400;

	Должники = ДолжникиИНачалоДолга(Ученики);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Оповещения.Источник КАК Клиент,
	|	Оповещения.Организация КАК Организация,
	|	Оповещения.ВремяСобытия КАК ВремяСобытия,
	|	Оповещения.Завершено КАК Завершено,
	|	Оповещения.Описание КАК Описание,
	|	Оповещения.ДатаПисьма КАК ДатаПисьма
	|ИЗ
	|	РегистрСведений.УЗ_Оповещения КАК Оповещения
	|ГДЕ
	|	Оповещения.Пользователь = &ПустойПользователь
	|	И Оповещения.Описание ПОДОБНО &НачалоОписания
	|	И Оповещения.Источник ССЫЛКА Справочник.УЗ_ФизЛица
	|	И (&ВсеУченики
	|			ИЛИ Оповещения.Источник В (&Ученики))";
	УстановитьПараметрыДолжников(Запрос, Ученики);
	Запрос.УстановитьПараметр("ПустойПользователь", Справочники.Пользователи.ПустаяСсылка());
	Запрос.УстановитьПараметр("НачалоОписания", ПрефиксОписанияДолга() + "%");
	Оповещения = Запрос.Выполнить().Выгрузить();
	//письма из журнала — и ручной рассылки должникам: регламентное письмо не дублирует ручное (и наоборот)
	ПисьмаЖурнала = РегистрыСведений.УЗ_ЖурналРассылки.ПоследниеПисьма(Ученики);
	Оповещения.Колонки.Добавить("Действует", Новый ОписаниеТипов("Булево"));

	Сейчас = ТекущаяДатаСеанса();
	Для Каждого Должник Из Должники Цикл
		//оповещения этого долга — по его организации
		Незавершенное = Неопределено;
		ПоследнееПисьмо = ПисьмаЖурнала.Получить(
			РегистрыСведений.УЗ_ЖурналРассылки.КлючПисьма(Должник.Клиент, Должник.Организация));
		Если ПоследнееПисьмо = Неопределено Тогда
			ПоследнееПисьмо = '00010101';
		КонецЕсли;
	ЦиклОтправки = УЗ_Сообщения.НовыйЦикл();
		Для Каждого Оповещение Из Оповещения Цикл
			Если Оповещение.Клиент <> Должник.Клиент Или Оповещение.Организация <> Должник.Организация Тогда
				Продолжить;
			КонецЕсли;
			ПоследнееПисьмо = Макс(ПоследнееПисьмо, Оповещение.ДатаПисьма);
			Если Оповещение.Завершено Тогда
				Продолжить;
			КонецЕсли;
			Оповещение.Действует = Истина;
			Если Незавершенное = Неопределено Тогда
				Незавершенное = Оповещение;
			КонецЕсли;
		КонецЦикла;
		Если Незавершенное = Неопределено И Сейчас - Должник.НачалоДолга < Срок Тогда
			Продолжить;		//долг моложе N дней
		КонецЕсли;
		Описание = ОписаниеДолга(Должник.Клиент, Должник.Организация, Должник.Долг);
		ПораПисать = Не ЗначениеЗаполнено(ПоследнееПисьмо) Или Сейчас - ПоследнееПисьмо >= Срок;
		ДатаПисьма = '00010101';
		Если ПораПисать
			И ОтправитьПисьмоОЗадолженности(Должник.Клиент, Должник.Долг, Должник.Организация, ЦиклОтправки) Тогда
			ДатаПисьма = Сейчас;
		КонецЕсли;
		Если Незавершенное = Неопределено Тогда
			Набор = НаборОповещения(Должник.Клиент, Сейчас, Справочники.Пользователи.ПустаяСсылка(), Ложь,
				Должник.Организация);
			Запись = Набор.Добавить();
			Запись.Источник = Должник.Клиент;
			Запись.ВремяСобытия = Сейчас;
			Запись.Пользователь = Справочники.Пользователи.ПустаяСсылка();
			Запись.Организация = Должник.Организация;
			Запись.СрокНапоминания = Сейчас;
			Запись.Описание = Описание;
			Запись.ДатаПисьма = ДатаПисьма;
			Набор.Записать();
		ИначеЕсли Незавершенное.Описание <> Описание Или ЗначениеЗаполнено(ДатаПисьма) Тогда
			Набор = НаборОповещения(Незавершенное.Клиент, Незавершенное.ВремяСобытия,
				Справочники.Пользователи.ПустаяСсылка(), Ложь, Незавершенное.Организация);
			Набор.Прочитать();
			Для Каждого Запись Из Набор Цикл
				Запись.Описание = Описание;
				Если ЗначениеЗаполнено(ДатаПисьма) Тогда
					Запись.ДатаПисьма = ДатаПисьма;
				КонецЕсли;
			КонецЦикла;
			Набор.Записать();
		КонецЕсли;
	КонецЦикла;

	//долг погашен (ученик в организации больше не должник) — оповещение закрывается
	Для Каждого Оповещение Из Оповещения Цикл
		Если Оповещение.Завершено Или Оповещение.Действует Тогда
			Продолжить;
		КонецЕсли;
		ОтметитьЗавершенным(Оповещение.Клиент, Оповещение.ВремяСобытия, Справочники.Пользователи.ПустаяСсылка(),
			Оповещение.Организация);
	КонецЦикла;

КонецПроцедуры

//Текст оповещения о долге: «Задолженность Сидорова Анна (Студия А): 1 234,56»; без организации —
//«Задолженность Сидорова Анна: 1 234,56».
Функция ОписаниеДолга(Ученик, Организация, Долг) Экспорт

	Если ЗначениеЗаполнено(Организация) Тогда
		Возврат СтрШаблон("%1 %2 (%3): %4", ПрефиксОписанияДолга(), Ученик, Организация, Формат(Долг, "ЧДЦ=2; ЧН=0"));
	КонецЕсли;
	Возврат СтрШаблон("%1 %2: %3", ПрефиксОписанияДолга(), Ученик, Формат(Долг, "ЧДЦ=2; ЧН=0"));

КонецФункции

//Начало описания оповещения о долге — по нему задание узнаёт свои записи.
Функция ПрефиксОписанияДолга() Экспорт
	Возврат НСтр("ru = 'Задолженность'");
КонецФункции

//Сообщение о долге ученику и плательщикам с согласием — каждому его каналом (почта, Telegram, SMS, WhatsApp;
//УЗ_Сообщения.ОтправитьОЗадолженности, В47): Истина — хоть одному принято (отправлено или записано песочницей);
//Ложь — писать некому, автоматические сообщения о долге выключены или отправка не удалась (ошибка — в журнале
//сообщений и журнале регистрации; сообщение уйдёт при следующем запуске задания). Каждая попытка — в журнале
//сообщений (одна история с рассылкой должникам: по ней ручная рассылка не повторит это сообщение).
//  Цикл — цикл отправки задания: первый отказ сервиса — остальным этим каналом не шлём.
Функция ОтправитьПисьмоОЗадолженности(Ученик, Долг, Организация, ЦиклОтправки)

	Если Не УЗ_Сообщения.АвтоматическиОЗадолженности() Тогда
		Возврат Ложь;
	КонецЕсли;
	Должник = Новый Структура("Ученик, Организация, Долг, Предметы, ДнейДолга", Ученик, Организация, Долг, "", 0);
	Итог = УЗ_Сообщения.ОтправитьОЗадолженности(ЦиклОтправки, Должник);
	Если Итог.Получателей > 0 И Не Итог.Отправлено Тогда
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Учёт занятий.Почта'"), УровеньЖурналаРегистрации.Предупреждение,
			, Ученик, Итог.ТекстОшибки);
	КонецЕсли;
	Возврат Итог.Отправлено;

КонецФункции

//Набор записей оповещения по полному ключу. Права уже проверены сервером (оповещение о долге пишет задание,
//«Завершить» проверяет ключи сам) — модуль набора записей эту запись пропускает (см. КлючПроверенныхПрав).
Функция НаборОповещения(Источник, ВремяСобытия, Пользователь, Завершено, Организация)

	Набор = РегистрыСведений.УЗ_Оповещения.СоздатьНаборЗаписей();
	Набор.Отбор.Источник.Установить(Источник);
	Набор.Отбор.ВремяСобытия.Установить(ВремяСобытия);
	Набор.Отбор.Пользователь.Установить(Пользователь);
	Набор.Отбор.Завершено.Установить(Завершено);
	Набор.Отбор.Организация.Установить(Организация);
	Набор.ДополнительныеСвойства.Вставить(КлючПроверенныхПрав(), Истина);
	Возврат Набор;

КонецФункции

//Имя дополнительного свойства набора записей УЗ_Оповещения: запись идёт из сервера, права проверены там.
Функция КлючПроверенныхПрав() Экспорт
	Возврат "УЗ_ПраваПроверены";
КонецФункции

//Отметить запись оповещения завершённой: Завершено — измерение, запись переписывается (удалить + записать копию)
//в одной транзакции; реквизиты (описание, дата письма) переносятся.
Процедура ОтметитьЗавершенным(Источник, ВремяСобытия, Пользователь, Организация)

	Старый = НаборОповещения(Источник, ВремяСобытия, Пользователь, Ложь, Организация);
	Старый.Прочитать();
	Если Старый.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Завершенный = НаборОповещения(Источник, ВремяСобытия, Пользователь, Истина, Организация);
	Запись = Завершенный.Добавить();
	ЗаполнитьЗначенияСвойств(Запись, Старый[0]);
	Запись.Завершено = Истина;
	НачатьТранзакцию();
	Попытка
		Старый.Очистить();
		Старый.Записать();
		Завершенный.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

//Начало работы сеанса (модуль приложения, после ПриНачалеРаботыСистемы хозяина) — один вызов сервера:
//граница просмотра кассы в регистре УЗ_ГраницаПросмотраКассы, если она посчитана не на сегодня (по ней
//ограничение доступа роли менеджера; сеансы без клиента от этого вызова НЕ зависят — граница общая, её
//обновляет и регламентное задание), параметры показа оповещений и ПервыйЗапуск — открыть помощник первого запуска.
Функция ПриНачалеРаботы() Экспорт

	ОбновитьГраницуПросмотраКассыПриВходе();
	Результат = ПараметрыОповещений();
	Результат.Вставить("ПервыйЗапуск", НуженПервыйЗапуск());
	Возврат Результат;

КонецФункции

//Помощник первого запуска (общая форма УЗ_ПервыйЗапуск) открывается сам при входе, пока в базе нет ни одного
//человека (УЗ_ФизЛица без папок) — у того, кому помощник доступен (руководитель). Право проверяется первым: у
//менеджера вход обходится без запроса; сам запрос — ПЕРВЫЕ 1 по справочнику, старт не утяжеляет.
Функция НуженПервыйЗапуск() Экспорт

	Если Не ПравоДоступа("Просмотр", Метаданные.ОбщиеФормы.УЗ_ПервыйЗапуск) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ФизЛица.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УЗ_ФизЛица КАК ФизЛица
	|ГДЕ
	|	НЕ ФизЛица.ЭтоГруппа");
	Возврат Запрос.Выполнить().Пустой();

КонецФункции

//Отказ записи границы не должен мешать входу: у кого нет права записи (пользователь без ролей учёта) —
//не пишет; ошибка записи — в журнал регистрации (граница останется вчерашней: менеджер увидит на день больше,
//пока её не обновит регламентное задание или следующий вход).
Процедура ОбновитьГраницуПросмотраКассыПриВходе()

	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.УЗ_ГраницаПросмотраКассы) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		УЗ_ДатыЗапрета.ОбновитьГраницуПросмотраКассы();
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Учёт занятий.Граница просмотра кассы'"), УровеньЖурналаРегистрации.Ошибка,
			, ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

//Как показывать оповещения в этом сеансе (модуль приложения, при начале работы).
//Структура: Включено — у пользователя есть право читать оповещения; Период — секунды между проверками.
Функция ПараметрыОповещений() Экспорт

	//период по умолчанию — один для всех (УЗ_ОбщийКлиентСервер.ПериодОповещенияПоУмолчанию); настройки учёта
	//читаются привилегированно (УЗ_Настройки.Настройки) — менеджер без права чтения настроек получает тот же период
	Результат = Новый Структура("Включено, Период", Ложь, УЗ_ОбщийКлиентСервер.ПериодОповещенияПоУмолчанию());
	Если Не ПравоДоступа("Чтение", Метаданные.РегистрыСведений.УЗ_Оповещения) Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Включено = Истина;
	Настройки = ПолучитьНастройки();
	Если Настройки.ПериодОповещения > 0 Тогда
		Результат.Период = Макс(Настройки.ПериодОповещения, УЗ_ОбщийКлиентСервер.МинимальныйПериодОповещения());
	КонецЕсли;
	Возврат Результат;

КонецФункции

//Оповещения текущего пользователя (и общие — с пустым пользователем), срок которых наступил.
//  ПоказаныДо — момент прошлой проверки этого сеанса: выдаём только то, что наступило после
//  него; Неопределено — первая проверка сеанса, выдаём все незавершённые с наступившим сроком.
//Структура: Сейчас — момент проверки (передать в следующий вызов); Оповещения — массив структур
//  (Описание, Источник, Ссылка — навигационная ссылка записи); Всего — сколько наступило.
Функция ПолучитьОповещения(Знач ПоказаныДо = Неопределено) Экспорт

	Сейчас = ТекущаяДатаСеанса();
	Результат = Новый Структура("Сейчас, Оповещения, Всего", Сейчас, Новый Массив, 0);

	АдресатыОповещений = Новый Массив;
	АдресатыОповещений.Добавить(Справочники.Пользователи.ПустаяСсылка());
	Текущий = УЗ_Среда.ТекущийПользователь();
	Если ЗначениеЗаполнено(Текущий) Тогда
		АдресатыОповещений.Добавить(Текущий);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 20
	|	Оповещения.Источник КАК Источник,
	|	Оповещения.ВремяСобытия КАК ВремяСобытия,
	|	Оповещения.Пользователь КАК Пользователь,
	|	Оповещения.Завершено КАК Завершено,
	|	Оповещения.СрокНапоминания КАК СрокНапоминания,
	|	Оповещения.Описание КАК Описание,
	|	Оповещения.Организация КАК Организация
	|ИЗ
	|	РегистрСведений.УЗ_Оповещения КАК Оповещения
	|ГДЕ
	|	НЕ Оповещения.Завершено
	|	И Оповещения.Пользователь В (&Пользователи)
	|	И Оповещения.СрокНапоминания <= &Сейчас
	|	И Оповещения.СрокНапоминания > &ПоказаныДо
	|
	|УПОРЯДОЧИТЬ ПО
	|	Оповещения.СрокНапоминания УБЫВ";
	Запрос.УстановитьПараметр("Пользователи", АдресатыОповещений);
	Запрос.УстановитьПараметр("Сейчас", Сейчас);
	Запрос.УстановитьПараметр("ПоказаныДо", ?(ТипЗнч(ПоказаныДо) = Тип("Дата"), ПоказаныДо, '00010101'));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ключ = РегистрыСведений.УЗ_Оповещения.СоздатьКлючЗаписи(Новый Структура(
			"Источник, ВремяСобытия, Пользователь, Завершено, Организация",
			Выборка.Источник, Выборка.ВремяСобытия, Выборка.Пользователь, Выборка.Завершено, Выборка.Организация));
		Результат.Оповещения.Добавить(Новый Структура("Описание, Источник, Ссылка",
			?(ПустаяСтрока(Выборка.Описание), Строка(Выборка.Источник), Выборка.Описание),
			Выборка.Источник, ПолучитьНавигационнуюСсылку(Ключ)));
	КонецЦикла;
	Результат.Всего = Результат.Оповещения.Количество();
	Возврат Результат;

КонецФункции

//Значения новой записи для команды «Напомнить»: источник, текущий пользователь, срок через час.
Функция ЗначенияНапоминания(Источник) Экспорт

	Сейчас = ТекущаяДатаСеанса();
	Значения = Новый Структура;
	Значения.Вставить("Источник", Источник);
	Значения.Вставить("Пользователь", УЗ_Среда.ТекущийПользователь());
	Значения.Вставить("ВремяСобытия", Сейчас);
	Значения.Вставить("СрокНапоминания", Сейчас + 3600);
	Значения.Вставить("Описание", СтрШаблон(НСтр("ru = 'Напомнить: %1'"), Источник));
	Возврат Значения;

КонецФункции

//Создать напоминание программно (для проверок и обработок). Возвращает ключ записи.
//Напоминание себе — любому; другому сотруднику или всем — только тому, кто меняет настройки учёта
//(руководитель, администратор): модуль вызывается с клиента.
Функция СоздатьНапоминание(Источник, СрокНапоминания, Описание, Пользователь = Неопределено) Экспорт

	Если Пользователь <> Неопределено И Пользователь <> УЗ_Среда.ТекущийПользователь() Тогда
		ВыполнитьПроверкуПравДоступа("Изменение", Метаданные.РегистрыСведений.УЗ_Настройки);
	КонецЕсли;
	Запись = РегистрыСведений.УЗ_Оповещения.СоздатьМенеджерЗаписи();
	Запись.Источник = Источник;
	Запись.ВремяСобытия = ТекущаяДатаСеанса();
	Запись.Пользователь = ?(Пользователь = Неопределено, УЗ_Среда.ТекущийПользователь(), Пользователь);
	Запись.СрокНапоминания = СрокНапоминания;
	Запись.Описание = Описание;
	Запись.Записать();
	Возврат РегистрыСведений.УЗ_Оповещения.СоздатьКлючЗаписи(Новый Структура(
		"Источник, ВремяСобытия, Пользователь, Завершено, Организация",
		Запись.Источник, Запись.ВремяСобытия, Запись.Пользователь, Запись.Завершено, Запись.Организация));

КонецФункции

//Отметить оповещения завершёнными (Завершено — измерение: запись переписывается).
//Свои и общие (задолженность — всем) завершает любой; чужие напоминания — только тот, кто меняет
//настройки учёта (руководитель, администратор): ключи приходят с клиента.
Процедура ЗавершитьОповещения(Ключи) Экспорт

	Текущий = УЗ_Среда.ТекущийПользователь();
	Для Каждого Ключ Из Ключи Цикл
		Запись = РегистрыСведений.УЗ_Оповещения.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Запись, Ключ);
		Запись.Прочитать();
		Если Не Запись.Выбран() Или Запись.Завершено Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Запись.Пользователь) И Запись.Пользователь <> Текущий Тогда
			ВыполнитьПроверкуПравДоступа("Изменение", Метаданные.РегистрыСведений.УЗ_Настройки);
		КонецЕсли;
		ОтметитьЗавершенным(Запись.Источник, Запись.ВремяСобытия, Запись.Пользователь, Запись.Организация);
	КонецЦикла;

КонецПроцедуры

