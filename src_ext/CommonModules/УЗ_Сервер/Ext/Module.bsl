Функция ПолучитьОстаткиЧасовИСумм(Дата, ФизЛицо) Экспорт
	
	Ст = Новый Структура; 	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СписанияСуммЗаУроки.ЧасыОстаток,
	|	СписанияСуммЗаУроки.СуммаОстаток
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки.Остатки(&Дата, ) КАК СписанияСуммЗаУроки
	|ГДЕ
	|	СписанияСуммЗаУроки.Клиент = &Клиент"; 	
	Запрос.УстановитьПараметр("Клиент", ФизЛицо);
	Запрос.УстановитьПараметр("Дата", Дата);	
	РезультатЗапроса = Запрос.Выполнить();	
	Остатки = РезультатЗапроса.Выбрать();
	Пока Остатки.Следующий() Цикл
		Ст.Вставить("КоличествоЧасов", '00010101' + Остатки.ЧасыОстаток);
		Ст.Вставить("Сумма", Остатки.СуммаОстаток);		
	КонецЦикла; 
	
	Возврат Ст;
	
КонецФункции

// Проверияет образовавшуюся задолженность
Процедура ПроверкаЗадолженности() Экспорт 

	Настройки = ПолучитьНастройки();
	
	Если Настройки.ИспользоватьОповещения и Настройки.ОповещатьОЗадолженности <> 0 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	УЗ_СписанияСуммЗаУрокиОстаткиИОбороты.Клиент КАК Клиент,
		|	УЗ_СписанияСуммЗаУрокиОстаткиИОбороты.СуммаКонечныйОстаток КАК Остаток
		|ИЗ
		|	РегистрНакопления.УЗ_СписанияСуммЗаУроки.ОстаткиИОбороты КАК УЗ_СписанияСуммЗаУрокиОстаткиИОбороты
		|ГДЕ
		|	УЗ_СписанияСуммЗаУрокиОстаткиИОбороты.СуммаКонечныйОстаток < 0";
		Должники = Запрос.Выполнить().Выгрузить();
		Для Каждого Стр из Должники Цикл		
			
			//ПроверитьИДобавитьВОповещения();
			
			НовЗапись = РегистрыСведений.УЗ_Оповещения.СоздатьМенеджерЗаписи();
			НовЗапись.ВремяСобытия = ТекущаяДата();
			НовЗапись.Источник = Стр.Клиент;
			НовЗапись.Описание = "Задолженность на " +ТекущаяДата()+ ": " +Формат(Стр.Остаток,"ЧДЦ=2");
			НовЗапись.Пользователь = Неопределено;
			НовЗапись.СрокНапоминания = НачалоДня(ТекущаяДата()) + 86400; //86400 = 1 день
			НовЗапись.Записать();
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьОповещения() Экспорт 

	МассивОповещений = Новый Массив;
	
	ДанныеС = Новый Структура;
	
	МассивПользователей = Новый Массив;
	МассивПользователей.Добавить(УЗ_Среда.ТекущийПользователь());
	МассивПользователей.Добавить(Справочники.Пользователи.ПустаяСсылка());
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УЗ_Оповещения.Источник КАК Источник,
	|	УЗ_Оповещения.ВремяСобытия КАК ВремяСобытия,
	|	УЗ_Оповещения.Пользователь КАК Пользователь,
	|	УЗ_Оповещения.Завершено КАК Завершено,
	|	УЗ_Оповещения.СрокНапоминания КАК СрокНапоминания,
	|	УЗ_Оповещения.Описание КАК Описание
	|ИЗ
	|	РегистрСведений.УЗ_Оповещения КАК УЗ_Оповещения
	|ГДЕ
	|	УЗ_Оповещения.Пользователь В(&Пользователи)
	|	И НЕ УЗ_Оповещения.Завершено";
	Запрос.УстановитьПараметр("Пользователи", МассивПользователей);
	Оповещения = Запрос.Выполнить().Выгрузить();
	Для Каждого Оп из Оповещения Цикл
		
		ДанныеС.Вставить("Описание",Оп.Описание);
		ДанныеС.Вставить("Источник",Оп.Источник);
		
		Струк = новый Структура("Источник, Описание, ВремяСобытия, Пользователь, Завершено, СрокНапоминания", 
		Оп.Источник, Оп.Описание, Оп.ВремяСобытия, Оп.Пользователь, Оп.Завершено, Оп.СрокНапоминания,);
		КлючЗаписи = РегистрыСведений.УЗ_Оповещения.СоздатьКлючЗаписи(Струк);
		ДанныеС.Вставить("КлючЗаписи",КлючЗаписи);

		МассивОповещений.Добавить(ДанныеС);
		
	КонецЦикла;
	
	Возврат МассивОповещений;

КонецФункции

Функция ПолучитьНастройки() Экспорт 
	Возврат РегистрыСведений.УЗ_Настройки.Настройки();
КонецФункции
