#Область СлужебныеПроцедурыИФункции

//Долги ученика в организации по предметам после зачёта аванса без предмета (см. ЗадолженностьУченика):
//Соответствие ПредметОбучения → долг (> 0); предметов без долга в нём нет.
//  Порядок — Массив: если передан, в него добавляются предметы с долгом в том же порядке (раньше начался — первым).
//  Исключить — документ, чьи движения не учитываются (приход, который заполняется заново — он их заменит).
//  ОстатокБезПредмета — сюда возвращается остаток без предмета («−» — долг без предмета, «+» — аванс).
Функция ДолгиПоПредметам(Ученик, Организация, Граница = Неопределено, Порядок = Неопределено,
	Исключить = Неопределено, ОстатокБезПредмета = 0)

	Итог = Новый Соответствие;
	ОстатокБезПредмета = 0;
	Если НЕ ЗначениеЗаполнено(Ученик) Тогда
		Возврат Итог;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОстаткиБезДокумента.ПредметОбучения КАК ПредметОбучения,
	|	СУММА(ОстаткиБезДокумента.Остаток) КАК Остаток
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	(ВЫБРАТЬ
	|		Остатки.ПредметОбучения КАК ПредметОбучения,
	|		Остатки.СуммаОстаток КАК Остаток
	|	ИЗ
	|		РегистрНакопления.УЗ_СписанияСуммЗаУроки.Остатки(&Граница, Клиент = &Клиент И Организация = &Организация)
	|		КАК
	|			Остатки
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Движения.ПредметОбучения,
	|		ВЫБОР
	|			КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА -Движения.Сумма
	|			ИНАЧЕ Движения.Сумма
	|		КОНЕЦ
	|	ИЗ
	|		РегистрНакопления.УЗ_СписанияСуммЗаУроки КАК Движения
	|	ГДЕ
	|		Движения.Регистратор = &Исключить
	|		И Движения.Клиент = &Клиент
	|		И Движения.Организация = &Организация
	|		И Движения.Активность) КАК ОстаткиБезДокумента
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиБезДокумента.ПредметОбучения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Остатки.ПредметОбучения КАК ПредметОбучения,
	|	ВТ_Остатки.Остаток КАК Остаток,
	|	ЕСТЬNULL(Начало.НачалоДолга, ДАТАВРЕМЯ(3999, 12, 31)) КАК НачалоДолга,
	|	ЕСТЬNULL(ВТ_Остатки.ПредметОбучения.Наименование, """") КАК Наименование
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Движения.ПредметОбучения КАК ПредметОбучения,
	|			МИНИМУМ(Движения.Период) КАК НачалоДолга
	|		ИЗ
	|			РегистрНакопления.УЗ_СписанияСуммЗаУроки КАК Движения
	|		ГДЕ
	|			Движения.Клиент = &Клиент
	|			И Движения.Организация = &Организация
	|			И Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|			И Движения.Сумма > 0
	|			И Движения.Активность
	|		СГРУППИРОВАТЬ ПО
	|			Движения.ПредметОбучения) КАК Начало
	|		ПО ВТ_Остатки.ПредметОбучения = Начало.ПредметОбучения
	|
	|УПОРЯДОЧИТЬ ПО
	|	НачалоДолга,
	|	Наименование";
	Если Граница = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Остатки(&Граница,", "Остатки(,");
	Иначе
		Запрос.УстановитьПараметр("Граница", Граница);
	КонецЕсли;
	Запрос.УстановитьПараметр("Клиент", Ученик);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Исключить", Исключить);
	Таблица = Запрос.Выполнить().Выгрузить();
	Аванс = 0;
	Для Каждого Строка Из Таблица Цикл
		Если НЕ ЗначениеЗаполнено(Строка.ПредметОбучения) Тогда
			ОстатокБезПредмета = ОстатокБезПредмета + Строка.Остаток;
			Аванс = Макс(0, ОстатокБезПредмета);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Строка Из Таблица Цикл
		Если НЕ ЗначениеЗаполнено(Строка.ПредметОбучения) Или Строка.Остаток >= 0 Тогда
			Продолжить;
		КонецЕсли;
		Зачтено = Мин(Аванс, -Строка.Остаток);
		Аванс = Аванс - Зачтено;
		Если -Строка.Остаток - Зачтено > 0 Тогда
			Итог.Вставить(Строка.ПредметОбучения, -Строка.Остаток - Зачтено);
			Если Порядок <> Неопределено Тогда
				Порядок.Добавить(Строка.ПредметОбучения);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

//Организация, в которой у ученика есть деньги (остаток не ноль): одна — она; ни одной — организация остатков по
//умолчанию (ОрганизацияОстатков, может быть пустой ссылкой); несколько — Неопределено (выбирает пользователь).
Функция ОрганизацияДенегУченика(Ученик)

	Организации = Новый Массив;
	Для Каждого СтрокаОстатка Из ОстаткиДенегУченика(Ученик) Цикл
		Если Организации.Найти(СтрокаОстатка.Организация) = Неопределено Тогда
			Организации.Добавить(СтрокаОстатка.Организация);
		КонецЕсли;
	КонецЦикла;
	Если Организации.Количество() = 1 Тогда
		Возврат Организации[0];
	ИначеЕсли Организации.Количество() > 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПоУмолчанию = ОрганизацияОстатков();
	Возврат ?(ПоУмолчанию = Неопределено, Справочники.Организации.ПустаяСсылка(), ПоУмолчанию);

КонецФункции

Функция ТекстЗапросаДолжников()

	Возврат
	"ВЫБРАТЬ
	|	Остатки.Клиент КАК Клиент,
	|	Остатки.Организация КАК Организация,
	|	СУММА(Остатки.СуммаОстаток) КАК Остаток
	|ПОМЕСТИТЬ ВТ_Должники
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки.Остатки(, &ВсеУченики ИЛИ Клиент В (&Ученики)) КАК Остатки
	|ГДЕ
	|	НЕ Остатки.Клиент.ЭтоПедагог
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Клиент,
	|	Остатки.Организация
	|
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.СуммаОстаток) < 0";

КонецФункции

Процедура УстановитьПараметрыДолжников(Запрос, Ученики)

	Запрос.УстановитьПараметр("ВсеУченики", Ученики = Неопределено);
	Запрос.УстановитьПараметр("Ученики", ?(Ученики = Неопределено, Новый Массив, Ученики));

КонецПроцедуры

#КонецОбласти
