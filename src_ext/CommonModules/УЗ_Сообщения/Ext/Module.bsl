//Канал и адрес получателя: выбранный в карточке, если готов и есть адрес; иначе почта; нет согласия — не пишем.
Процедура ВыбратьКанал(Получатель, Данные, Готовность)

	Почта = Перечисления.УЗ_КаналыСообщений.Почта;
	Если Данные.Согласие <> Истина Тогда
		Получатель.Причина = НСтр("ru = 'нет согласия на сообщения'");
		Получатель.Представление = Получатель.Имя + ": " + Получатель.Причина;
		Возврат;
	КонецЕсли;
	Выбранный = ?(ЗначениеЗаполнено(Данные.Канал), Данные.Канал, Почта);
	АдресВыбранного = АдресДляКанала(Выбранный, Данные);
	ПричинаВыбранного = "";
	Если ПустаяСтрока(АдресВыбранного) Тогда
		ПричинаВыбранного = ТекстНетАдреса(Выбранный);
	ИначеЕсли Не ПустаяСтрока(Готовность.Получить(Выбранный)) Тогда
		ПричинаВыбранного = Готовность.Получить(Выбранный);
	КонецЕсли;
	Если ПустаяСтрока(ПричинаВыбранного) Тогда
		Получатель.Канал = Выбранный;
		Получатель.Адрес = АдресВыбранного;
		Получатель.МожноПисать = Истина;
	ИначеЕсли Выбранный <> Почта И Не ПустаяСтрока(АдресДляКанала(Почта, Данные))
		И ПустаяСтрока(Готовность.Получить(Почта)) Тогда
		Получатель.Канал = Почта;
		Получатель.Адрес = АдресДляКанала(Почта, Данные);
		Получатель.МожноПисать = Истина;
		Получатель.Причина = СтрШаблон(НСтр("ru = 'почтой вместо «%1»: %2'"), Выбранный, ПричинаВыбранного);
	Иначе
		Получатель.Канал = Выбранный;
		Получатель.Причина = ПричинаВыбранного;
	КонецЕсли;
	Получатель.Представление = СтрШаблон("%1 — %2: %3", Получатель.Имя, Получатель.Канал,
		?(Получатель.МожноПисать, Получатель.Адрес, Получатель.Причина));

КонецПроцедуры

Функция АдресДляКанала(Канал, Данные)

	Если Канал = Перечисления.УЗ_КаналыСообщений.Почта Тогда
		Адрес = СокрЛП(Данные.EMail);
		Возврат ?(СтрНайти(Адрес, "@") > 1, Адрес, "");
	ИначеЕсли Канал = Перечисления.УЗ_КаналыСообщений.Телеграм Тогда
		Возврат СокрЛП(Данные.Чат);
	КонецЕсли;
	Возврат НормализоватьТелефон(Данные.Телефон);

КонецФункции

Функция ТекстНетАдреса(Канал)

	Если Канал = Перечисления.УЗ_КаналыСообщений.Почта Тогда
		Возврат НСтр("ru = 'нет e-mail'");
	ИначеЕсли Канал = Перечисления.УЗ_КаналыСообщений.Телеграм Тогда
		Возврат НСтр("ru = 'Telegram не привязан'");
	КонецЕсли;
	Возврат НСтр("ru = 'нет мобильного телефона'");

КонецФункции

Процедура ДобавитьИтог(Итог, Получатель, Результат)

	Итог.Итоги.Добавить(Новый Структура("Получатель, Канал, Адрес, Отправлено, ТекстОшибки", Получатель.ФизЛицо,
		Получатель.Канал, Получатель.Адрес, Результат.Отправлено, Результат.ТекстОшибки));
	Если Результат.Отправлено Тогда
		Итог.Отправлено = Истина;
		Адреса = ?(ТипЗнч(Получатель.Адрес) = Тип("Массив"), Получатель.Адрес,
			СтрРазделить(Получатель.Адрес, ";", Ложь));
		Для Каждого Адрес Из Адреса Цикл
			Итог.Адреса.Добавить(СокрЛП(Адрес));
		КонецЦикла;
	Иначе
		Итог.ОтправленоВсем = Ложь;
		Если ПустаяСтрока(Итог.ТекстОшибки) Тогда
			Итог.ТекстОшибки = Результат.ТекстОшибки;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция НоваяЗаписьЖурнала(Сообщение, Получатель, Канал, Адрес)

	Запись = РегистрыСведений.УЗ_ЖурналРассылки.НоваяЗапись();
	Запись.Ученик = Сообщение.Ученик;
	Запись.Организация = Сообщение.Организация;
	Запись.Сумма = Сообщение.Сумма;
	Запись.Вид = Сообщение.Вид;
	Запись.Источник = Сообщение.Источник;
	Запись.Вручную = Сообщение.Вручную;
	Запись.Получатель = Получатель;
	Запись.Канал = Канал;
	Запись.Адреса = ?(ТипЗнч(Адрес) = Тип("Массив"), СтрСоединить(Адрес, "; "), Строка(Адрес));
	Возврат Запись;

КонецФункции

//Напоминание по источнику (урок, абонемент) всем получателям ученика, кому оно ещё не ушло.
Процедура НапомнитьУченику(ЦиклОтправки, Вид, Источник, Ученик, Организация, Шаблон, Значения, История, Итоги)

	Для Каждого Получатель Из Получатели(Ученик, ЦиклОтправки.Готовность) Цикл
		Если Не Получатель.МожноПисать Тогда
			Продолжить;
		КонецЕсли;
		Ключ = КлючИстории(Источник, Ученик, Получатель.ФизЛицо);
		Было = История.Получить(Ключ);
		Если Было <> Неопределено И (Было.Отправлено Или Было.Неудач >= МаксимумПопыток()) Тогда
			Продолжить;
		КонецЕсли;
		Значения.Получатель = Получатель.Имя;
		Сообщение = НовоеСообщение(Вид, Ученик, ПодставитьЗначения(Шаблон.Тема, Значения),
			ПодставитьЗначения(Шаблон.Текст, Значения), ПодставитьЗначения(Шаблон.КраткийТекст, Значения));
		Сообщение.Организация = Организация;
		Сообщение.Источник = Источник;
		Результат = ОтправитьПолучателю(ЦиклОтправки, Получатель, Сообщение);
		Если Было = Неопределено Тогда
			Было = Новый Структура("Отправлено, Неудач", Ложь, 0);
			История.Вставить(Ключ, Было);
		КонецЕсли;
		Было.Отправлено = Результат.Отправлено;
		Было.Неудач = Было.Неудач + ?(Результат.Отправлено, 0, 1);
		Итоги.Добавить(Новый Структура("Источник, Ученик, Получатель, Канал, Статус, ТекстОшибки", Источник, Ученик,
			Получатель.ФизЛицо, Получатель.Канал, Результат.Статус, Результат.ТекстОшибки));
	КонецЦикла;

КонецПроцедуры

//История напоминаний вида по источникам: Соответствие КлючИстории → Структура Отправлено, Неудач.
Функция ИсторияНапоминаний(Вид, Источники)

	Итог = Новый Соответствие;
	Если Источники.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Журнал.Источник КАК Источник,
	|	Журнал.Ученик КАК Ученик,
	|	Журнал.Получатель КАК Получатель,
	|	МАКСИМУМ(Журнал.Отправлено) КАК Отправлено,
	|	СУММА(ВЫБОР
	|			КОГДА Журнал.Отправлено
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК Неудач
	|ИЗ
	|	РегистрСведений.УЗ_ЖурналРассылки КАК Журнал
	|ГДЕ
	|	Журнал.Вид = &Вид
	|	И Журнал.Источник В (&Источники)
	|
	|СГРУППИРОВАТЬ ПО
	|	Журнал.Источник,
	|	Журнал.Ученик,
	|	Журнал.Получатель";
	Запрос.УстановитьПараметр("Вид", Вид);
	Запрос.УстановитьПараметр("Источники", Источники);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Итог.Вставить(КлючИстории(Выборка.Источник, Выборка.Ученик, Выборка.Получатель),
			Новый Структура("Отправлено, Неудач", Выборка.Отправлено = Истина, Выборка.Неудач));
	КонецЦикла;
	Возврат Итог;

КонецФункции

Функция КлючИстории(Источник, Ученик, Получатель)

	Возврат Строка(Источник.УникальныйИдентификатор()) + "|" + Строка(Ученик.УникальныйИдентификатор()) + "|"
		+ ?(ЗначениеЗаполнено(Получатель), Строка(Получатель.УникальныйИдентификатор()), "");

КонецФункции

Процедура УстановитьОтборУчеников(Запрос, Ученики)

	Запрос.УстановитьПараметр("ВсеУченики", Ученики = Неопределено);
	Запрос.УстановитьПараметр("Ученики", ?(Ученики = Неопределено, Новый Массив, Ученики));

КонецПроцедуры

//Напоминания шлёт регламентное задание (фоновый сеанс); вручную — тот, кто меняет настройки каналов (руководитель).
Процедура ПроверитьПравоЗапуска()

	Если ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание() = Неопределено Тогда
		ВыполнитьПроверкуПравДоступа("Изменение", Метаданные.РегистрыСведений.УЗ_НастройкиКаналов);
	КонецЕсли;

КонецПроцедуры

Функция ПодписьОтпискиТелеграм()
	Возврат НСтр("ru = 'Отписаться от сообщений: /stop'");
КонецФункции

//«/start <код>»: код выдан не раньше СрокКодаДней назад — чат привязывается, согласие ставится.
Функция ПривязатьЧат(Чат, Код, Имя)

	Если ПустаяСтрока(Код) Тогда
		Возврат НСтр(
			"ru = 'Здравствуйте! Чтобы получать напоминания о занятиях, откройте ссылку, которую вам дали в студии.'");
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Привязки.ФизЛицо КАК ФизЛицо
	|ИЗ
	|	РегистрСведений.УЗ_ПривязкиКаналов КАК Привязки
	|ГДЕ
	|	Привязки.Канал = ЗНАЧЕНИЕ(Перечисление.УЗ_КаналыСообщений.Телеграм)
	|	И Привязки.КодПривязки = &Код
	|	И Привязки.ДатаКода >= &Срок";
	Запрос.УстановитьПараметр("Код", Лев(Код, 32));
	Запрос.УстановитьПараметр("Срок", ТекущаяДатаСеанса() - СрокКодаДней() * 86400);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат НСтр("ru = 'Ссылка устарела или уже использована. Попросите в студии новую.'");
	КонецЕсли;
	Запись = РегистрыСведений.УЗ_ПривязкиКаналов.СоздатьМенеджерЗаписи();
	Запись.ФизЛицо = Выборка.ФизЛицо;
	Запись.Канал = Перечисления.УЗ_КаналыСообщений.Телеграм;
	Запись.Прочитать();
	Запись.Адрес = Чат;
	Запись.КодПривязки = "";
	Запись.ДатаПривязки = ТекущаяДатаСеанса();
	Запись.ИмяВМессенджере = Имя;
	Запись.Записать();
	Объект = Выборка.ФизЛицо.ПолучитьОбъект();
	Изменен = Ложь;
	Если Не Объект.ОповеститьПоEmail Тогда
		Объект.ОповеститьПоEmail = Истина;
		Изменен = Истина;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ПредпочитаемыйКанал) Тогда
		Объект.ПредпочитаемыйКанал = Перечисления.УЗ_КаналыСообщений.Телеграм;
		Изменен = Истина;
	КонецЕсли;
	Если Изменен Тогда
		Объект.Записать();
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Готово: сообщения студии для «%1» будут приходить сюда. Отписаться — /stop'"),
		Выборка.ФизЛицо);

КонецФункции

//«/stop»: согласие снимается у всех, к кому привязан этот чат (у мамы двое детей — это один человек-плательщик).
Функция ОтписатьЧат(Чат)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Привязки.ФизЛицо КАК ФизЛицо
	|ИЗ
	|	РегистрСведений.УЗ_ПривязкиКаналов КАК Привязки
	|ГДЕ
	|	Привязки.Канал = ЗНАЧЕНИЕ(Перечисление.УЗ_КаналыСообщений.Телеграм)
	|	И Привязки.Адрес = &Чат";
	Запрос.УстановитьПараметр("Чат", Чат);
	Выборка = Запрос.Выполнить().Выбрать();
	Отписано = 0;
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.ФизЛицо.ПолучитьОбъект();
		Если Объект.ОповеститьПоEmail Тогда
			Объект.ОповеститьПоEmail = Ложь;
			Объект.Записать();
		КонецЕсли;
		Отписано = Отписано + 1;
	КонецЦикла;
	Если Отписано = 0 Тогда
		Возврат НСтр("ru = 'Этот чат не подписан на сообщения студии.'");
	КонецЕсли;
	Возврат НСтр(
		"ru = 'Вы отписаны: сообщения студии больше приходить не будут. Подписаться снова — по ссылке из студии.'");

КонецФункции

#КонецОбласти
