//Наши приходы денег и возвраты ученикам за период — с состоянием оформления в программе.
//Организация, Касса — пустые: все. Режим — РежимЗаДень() или РежимКаждымДокументом(): от него зависит, нужен ли
//связанный плательщик.
//ТаблицаЗначений: Документ, Вид ("Приход"/"Возврат"), Дата, Организация, Касса, Плательщик, Сумма, Безнал, Проведен,
//КонтрагентПлательщика, ОбъектХозяина, СуммаОформлено, Изменен, Ошибка, Состояние, МожноОформить.
Функция ДеньгиДляОформления(Организация, Касса, Начало, Конец, Режим) Экспорт

	Возврат ДанныеДенег(Организация, Касса, Начало, Конец, Режим, Неопределено);

КонецФункции

//Оформляет наши документы денег в программе: создаёт или переписывает ПКО/РКО («Поступление в кассу»/«Расход из
//кассы» в УНФ) и проводит их механизмом программы. Режим «за день»: приходы дня по организации и кассе — один
//документ на общего контрагента (переписывается целиком, когда в дне что-то изменилось); возвраты — каждым документом.
//Режим «каждым документом»: контрагент — связанный плательщик. Отменённый у нас документ — документ программы
//помечается на удаление. Ошибка программы (закрыт период, не заполнена статья) остаётся у строки, наш учёт не трогает.
//НашиДокументы — массив наших ссылок. Структура: Оформлено (число документов программы), Ошибки — массив
//Структура("Документ, Текст").
Функция Оформить(НашиДокументы, Режим) Экспорт

	Итог = Новый Структура("Оформлено, Ошибки", 0, Новый Массив);
	Если НашиДокументы.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;
	Выбранные = ДанныеДенег(Неопределено, Неопределено, '00010101', '39991231', Режим, НашиДокументы);
	Дни = Новый Соответствие;
	Для Каждого Движение Из Выбранные Цикл
		//оформлено и не изменено, безнал, плательщик не связан — делать нечего (повтор ничего не трогает)
		Если Не Движение.МожноОформить Тогда
			Если Не ЗначениеЗаполнено(Движение.ОбъектХозяина) Тогда
				Итог.Ошибки.Добавить(Новый Структура("Документ, Текст", Движение.Документ, Движение.Состояние));
			КонецЕсли;
			Продолжить;
		ИначеЕсли Режим = РежимЗаДень() И Движение.Вид = "Приход" Тогда
			Ключ = СтрШаблон("%1|%2|%3", Формат(Движение.Дата, "ДФ=yyyyMMdd"),
				XMLСтрока(Движение.Организация), XMLСтрока(Движение.Касса));
			Дни.Вставить(Ключ, Движение);
		Иначе
			ОформитьДокумент(Движение, Режим, Итог);
		КонецЕсли;
	КонецЦикла;
	Для Каждого День Из Дни Цикл
		ОформитьДень(День.Значение, Итог);
	КонецЦикла;
	Возврат Итог;

КонецФункции

//Имя справочника программы для связи в роли ("Контрагенты", "Сотрудники", "Кассы"…) или "" — связывать не с чем.
Функция СправочникДляСвязи(Роль) Экспорт
	Возврат ИмяСправочникаРоли(Роль, Возможности());
КонецФункции

//Зарплата педагогов за месяцы периода — черновики документов программы для бухгалтера (Бухгалтерия, УНФ).
//Начисление: сумма начисленного педагогу за месяц (уроки и начисления педагогам) — строка «Начисления зарплаты»
//программы, одного на организацию и месяц. Выплата: наш расходный ордер «Выплата зарплаты» — «Ведомость в кассу».
//ТаблицаЗначений: Вид ("Начисление"/"Выплата"), Месяц, Дата, Организация, Педагог, Сумма, Документ (наш ордер для
//выплаты), Проведен, Сотрудник, ОбъектХозяина, СуммаОформлено, Изменен, ПроведеноВПрограмме, Ошибка, Состояние,
//МожноОформить.
Функция ЗарплатаДляОформления(Организация, Начало, Конец) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	""Начисление"" КАК Вид,
	|	НАЧАЛОПЕРИОДА(Расчеты.Период, МЕСЯЦ) КАК Месяц,
	|	Расчеты.Организация КАК Организация,
	|	Расчеты.Педагог КАК Педагог,
	|	СУММА(Расчеты.Сумма) КАК Сумма,
	|	НЕОПРЕДЕЛЕНО КАК Документ,
	|	ИСТИНА КАК Проведен,
	|	"""" КАК ВерсияДанных
	|ИЗ
	|	РегистрНакопления.УЗ_РасчетыПоЗарплате КАК Расчеты
	|ГДЕ
	|	Расчеты.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И Расчеты.Активность
	|	И Расчеты.Период МЕЖДУ &НачалоМесяцев И &КонецМесяцев
	|	И (&ВсеОрганизации ИЛИ Расчеты.Организация = &Организация)
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Расчеты.Период, МЕСЯЦ),
	|	Расчеты.Организация,
	|	Расчеты.Педагог
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	""Выплата"",
	|	НАЧАЛОПЕРИОДА(Расход.Дата, МЕСЯЦ),
	|	Расход.Организация,
	|	Расход.ФизЛицо,
	|	Расход.СуммаДокумента,
	|	Расход.Ссылка,
	|	Расход.Проведен,
	|	Расход.ВерсияДанных
	|ИЗ
	|	Документ.УЗ_РасходДенег КАК Расход
	|ГДЕ
	|	Расход.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыОпераций.ВыплатаЗарплаты)
	|	И Расход.Дата МЕЖДУ &Начало И &Конец
	|	И (&ВсеОрганизации ИЛИ Расход.Организация = &Организация)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Месяц,
	|	Вид УБЫВ,
	|	Педагог";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("НачалоМесяцев", НачалоМесяца(Начало));
	Запрос.УстановитьПараметр("КонецМесяцев", КонецМесяца(Конец));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВсеОрганизации", Не ЗначениеЗаполнено(Организация));
	Зарплата = Запрос.Выполнить().Выгрузить();
	Зарплата.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	Зарплата.Колонки.Добавить("Сотрудник");
	Зарплата.Колонки.Добавить("ОбъектХозяина");
	Зарплата.Колонки.Добавить("СуммаОформлено", Новый ОписаниеТипов("Число"));
	Зарплата.Колонки.Добавить("Изменен", Новый ОписаниеТипов("Булево"));
	Зарплата.Колонки.Добавить("ПроведеноВПрограмме", Новый ОписаниеТипов("Булево"));
	Зарплата.Колонки.Добавить("Ошибка", Новый ОписаниеТипов("Строка"));
	Зарплата.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));
	Зарплата.Колонки.Добавить("МожноОформить", Новый ОписаниеТипов("Булево"));
	Для Каждого Движение Из Зарплата Цикл
		Движение.Сотрудник = СвязанныйОбъект(Движение.Педагог, РольПедагог());
		Если Движение.Вид = "Начисление" Тогда
			Движение.Дата = КонецМесяца(Движение.Месяц);
			Запись = ЗаписьСвязи(Движение.Педагог, РольНачисления(Движение.Организация, Движение.Месяц));
		Иначе
			Движение.Дата = Движение.Документ.Дата;
			Запись = ЗаписьСвязи(Движение.Документ, РольДокумент());
		КонецЕсли;
		Если Запись <> Неопределено Тогда
			Движение.ОбъектХозяина = Запись.ОбъектХозяина;
			Движение.СуммаОформлено = Запись.Сумма;
			Движение.Ошибка = Запись.Ошибка;
			Движение.Изменен = Запись.Сумма <> Движение.Сумма
				Или Движение.Вид = "Выплата" И Запись.ВерсияДанных <> Движение.ВерсияДанных;
		КонецЕсли;
		Если ЗначениеЗаполнено(Движение.ОбъектХозяина) Тогда
			Движение.ПроведеноВПрограмме = Движение.ОбъектХозяина.Проведен;
		КонецЕсли;
		ЗаполнитьСостояниеЗарплаты(Движение);
	КонецЦикла;
	//отменённые у нас выплаты без черновика в программе показывать незачем
	Отменённые = Зарплата.НайтиСтроки(Новый Структура("Проведен, ОбъектХозяина", Ложь, Неопределено));
	Для Каждого Движение Из Отменённые Цикл
		Зарплата.Удалить(Движение);
	КонецЦикла;
	Возврат Зарплата;

КонецФункции

//Черновики зарплаты в программе за месяцы периода: «Начисление зарплаты» на организацию и месяц (строка на педагога,
//связанного с сотрудником; вид начисления, выбранный бухгалтером в черновике, сохраняется; в Бухгалтерии НДФЛ и
//взносы рассчитаны) и «Ведомость в кассу» на каждый наш ордер «Выплата зарплаты». Документы не проводятся: их
//проверяет и проводит бухгалтер. Проведённый бухгалтером документ не переписывается — расхождение покажет сверка.
//Структура: Оформлено (число документов программы), Ошибки — массив Структура("Объект, Текст").
Функция ОформитьЗарплату(Организация, Начало, Конец) Экспорт

	Итог = Новый Структура("Оформлено, Ошибки", 0, Новый Массив);
	Если Не Возможности().Зарплата Тогда
		Итог.Ошибки.Добавить(Новый Структура("Объект, Текст", Организация,
			НСтр("ru = 'Зарплату оформляют в программе только Бухгалтерия и УНФ.'")));
		Возврат Итог;
	КонецЕсли;
	Зарплата = ЗарплатаДляОформления(Организация, Начало, Конец);
	Месяцы = Новый Соответствие;
	Для Каждого Движение Из Зарплата Цикл
		Если Не Движение.МожноОформить Тогда
			Если Не ЗначениеЗаполнено(Движение.Сотрудник) Тогда
				Итог.Ошибки.Добавить(Новый Структура("Объект, Текст", ?(Движение.Вид = "Начисление",
					Движение.Педагог, Движение.Документ), Движение.Состояние));
			КонецЕсли;
		ИначеЕсли Движение.Вид = "Начисление" Тогда
			Месяцы.Вставить(СтрШаблон("%1|%2", Формат(Движение.Месяц, "ДФ=yyyyMM"), XMLСтрока(Движение.Организация)),
				Движение);
		Иначе
			ОформитьВедомость(Движение, Итог);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Месяц Из Месяцы Цикл
		ОформитьНачисление(Месяц.Значение, Зарплата, Итог);
	КонецЦикла;
	Возврат Итог;

КонецФункции

//Сверка учёта занятий с учётом программы за период: что изменили в программе после оформления — сумма документа
//программы не та, контрагент не тот, что связан с плательщиком (у нас «Марина», в программе «Марианна»), документ
//программы удалён, помечен на удаление или не проведён; за день — сумма дня; зарплата — суммы черновиков и
//проведённых бухгалтером документов. Оформленные «каждым документом» сверяются по одному, «за день» — по документу дня.
//ТаблицаЗначений: Раздел ("Деньги"/"Зарплата"), Объект (наш документ или педагог), ОбъектХозяина, Расхождение,
//УНас, ВПрограмме (строки для формы).
Функция Расхождения(Организация, Касса, Начало, Конец) Экспорт

	Итог = Новый ТаблицаЗначений;
	Итог.Колонки.Добавить("Раздел", Новый ОписаниеТипов("Строка"));
	Итог.Колонки.Добавить("Объект");
	Итог.Колонки.Добавить("ОбъектХозяина");
	Итог.Колонки.Добавить("Расхождение", Новый ОписаниеТипов("Строка"));
	Итог.Колонки.Добавить("УНас", Новый ОписаниеТипов("Строка"));
	Итог.Колонки.Добавить("ВПрограмме", Новый ОписаниеТипов("Строка"));
	СверитьДеньги(Итог, ДанныеДенег(Организация, Касса, Начало, Конец, РежимКаждымДокументом(), Неопределено));
	Если Возможности().Зарплата Тогда
		СверитьЗарплату(Итог, ЗарплатаДляОформления(Организация, Начало, Конец));
	КонецЕсли;
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяСправочникаРоли(Роль, Возможно)

	Если Роль = РольПлательщик() Тогда
		Возврат ?(Возможно.Контрагенты, "Контрагенты", "");
	ИначеЕсли Роль = РольПедагог() Тогда
		Возврат Возможно.СправочникПедагогов;
	ИначеЕсли Роль = РольКасса() Тогда
		Возврат ?(ЕстьСправочник("Кассы"), "Кассы", "");
	КонецЕсли;
	Возврат "";

КонецФункции

//Кандидат для связи: сначала по ИНН (один элемент), затем по наименованию (ровно один — иначе выбирать руками).
//Структура: Кандидат (ссылка или Неопределено), Состояние.
Функция НайтиКандидата(ИмяСправочника, ФизЛицо, ИНН)

	Итог = Новый Структура("Кандидат, Состояние", Неопределено, НСтр("ru = 'Не связан: в программе не найден'"));
	ПолеИНН = ПолеИННСправочника(ИмяСправочника);
	Если Не ПустаяСтрока(ИНН) И Не ПустаяСтрока(ПолеИНН) Тогда
		Найденные = ЭлементыПрограммы(ИмяСправочника, ПолеИНН, ИНН);
		Если Найденные.Количество() = 1 Тогда
			Итог.Кандидат = Найденные[0].Ссылка;
			Итог.Состояние = НСтр("ru = 'Не связан: найден по ИНН'");
			Возврат Итог;
		КонецЕсли;
	КонецЕсли;
	Найденные = ЭлементыПрограммы(ИмяСправочника, "Наименование", СокрЛП(ФизЛицо.Наименование));
	Если Найденные.Количество() = 1 Тогда
		Итог.Кандидат = Найденные[0].Ссылка;
		Итог.Состояние = НСтр("ru = 'Не связан: найден по ФИО'");
	ИначеЕсли Найденные.Количество() > 1 Тогда
		Итог.Состояние = НСтр("ru = 'Не связан: с таким ФИО несколько — выберите'");
	КонецЕсли;
	Возврат Итог;

КонецФункции

//Поле, по которому искать ИНН: у контрагентов и физлиц — ИНН, у сотрудников — ИНН их физического лица.
Функция ПолеИННСправочника(ИмяСправочника)

	Если УЗ_Общий.ЕстьРеквизит("Справочник." + ИмяСправочника, "ИНН") Тогда
		Возврат "ИНН";
	ИначеЕсли УЗ_Общий.ЕстьРеквизит("Справочник." + ИмяСправочника, "ФизическоеЛицо")
		И УЗ_Общий.ЕстьРеквизит("Справочник.ФизическиеЛица", "ИНН") Тогда
		Возврат "ФизическоеЛицо.ИНН";
	КонецЕсли;
	Возврат "";

КонецФункции

//Не более двух элементов справочника программы (не групп, без пометки удаления) с полем = значению.
Функция ЭлементыПрограммы(ИмяСправочника, Поле, Значение)

	Условия = Новый Массив;
	Условия.Добавить("Т." + Поле + " = &Значение");
	Условия.Добавить("НЕ Т.ПометкаУдаления");
	МетаданныеСправочника = Метаданные.Справочники[ИмяСправочника];
	Если МетаданныеСправочника.Иерархический
		И МетаданныеСправочника.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		Условия.Добавить("НЕ Т.ЭтоГруппа");
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2 Т.Ссылка КАК Ссылка ИЗ Справочник.%1 КАК Т ГДЕ %2",
		ИмяСправочника, СтрСоединить(Условия, " И "));
	Запрос.УстановитьПараметр("Значение", Значение);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

//Новый элемент справочника программы: её заполнение по умолчанию (и по данным заполнения), затем наши реквизиты —
//те, что есть у программы (перекрывают умолчания: юр. лицо по умолчанию у Бухгалтерии требует КПП); запись с её
//проверками. Ссылка или исключение.
Функция ЗаписатьНовый(ИмяСправочника, Реквизиты, ДанныеЗаполнения)

	Элемент = Справочники[ИмяСправочника].СоздатьЭлемент();
	Элемент.Заполнить(ДанныеЗаполнения);
	Для Каждого Реквизит Из Реквизиты Цикл
		Если Реквизит.Значение = Неопределено Или Не ЗначениеЗаполнено(Реквизит.Значение)
			Или Не УЗ_Общий.ЕстьРеквизит("Справочник." + ИмяСправочника, Реквизит.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Элемент[Реквизит.Ключ] = Реквизит.Значение;
	КонецЦикла;
	Если Не Элемент.ПроверитьЗаполнение() Тогда
		Тексты = Новый Массив;
		Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			Тексты.Добавить(Сообщение.Текст);
		КонецЦикла;
		ВызватьИсключение СтрШаблон(НСтр("ru = '%1: %2'"), Метаданные.Справочники[ИмяСправочника].Синоним,
			СтрСоединить(Тексты, "; "));
	КонецЕсли;
	Элемент.Записать();
	Возврат Элемент.Ссылка;

КонецФункции

//Новый контрагент программы — физическое лицо (в Управлении торговлей — с партнёром-частным лицом). Ссылка или
//исключение; вызывать в транзакции.
Функция НовыйКонтрагентФизЛицо(ФИО, ИНН)

	Партнер = Неопределено;
	Если ЕстьСправочник("Партнеры") И УЗ_Общий.ЕстьРеквизит("Справочник.Контрагенты", "Партнер") Тогда
		Партнер = ЗаписатьНовый("Партнеры", Новый Структура("Наименование, НаименованиеПолное, Клиент, "
			+ "ДатаРегистрации, ЮрФизЛицо, ГруппаДоступа", ФИО, ФИО, Истина, ТекущаяДатаСеанса(),
			ЗначениеПеречисления("КомпанияЧастноеЛицо", "ЧастноеЛицо"), ГруппаДоступаЧастногоЛица()),
			Неопределено);
	КонецЕсли;
	//УНФ определяет юр./физ. лицо по виду контрагента (по умолчанию — юрлицо, ИНН обрезается до 10)
	Реквизиты = Новый Структура("Наименование, НаименованиеПолное, ИНН, ЮридическоеФизическоеЛицо, ЮрФизЛицо, "
		+ "ВидКонтрагента", ФИО, ФИО, ИНН, ЗначениеПеречисления("ЮридическоеФизическоеЛицо", "ФизическоеЛицо"),
		ЗначениеПеречисления("ЮрФизЛицо", "ФизЛицо"),
		ЗначениеПеречисления("ВидыКонтрагентов", "ФизическоеЛицо"));
	Если Партнер <> Неопределено Тогда
		Реквизиты.Вставить("Партнер", Партнер);
	КонецЕсли;
	Возврат ЗаписатьНовый("Контрагенты", Реквизиты,
		?(Партнер = Неопределено, Неопределено, Новый Структура("Партнер", Партнер)));

КонецФункции

//Группа доступа нового партнёра Управления торговлей (обязательна, если группы доступа партнёров включены): как у
//последнего частного лица, иначе первая по наименованию; групп нет — Неопределено.
Функция ГруппаДоступаЧастногоЛица()

	Если Не ЕстьСправочник("ГруппыДоступаПартнеров")
		Или Не УЗ_Общий.ЕстьРеквизит("Справочник.Партнеры", "ГруппаДоступа") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Т.ГруппаДоступа КАК ГруппаДоступа
	|ИЗ
	|	Справочник.%1 КАК Т
	|ГДЕ
	|	Т.ЮрФизЛицо = &ЧастноеЛицо
	|	И Т.ГруппаДоступа <> ЗНАЧЕНИЕ(Справочник.%2.ПустаяСсылка)
	|	И НЕ Т.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.ДатаРегистрации УБЫВ", "Партнеры", "ГруппыДоступаПартнеров");
	Запрос.УстановитьПараметр("ЧастноеЛицо", ЗначениеПеречисления("КомпанияЧастноеЛицо", "ЧастноеЛицо"));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ГруппаДоступа;
	КонецЕсли;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Т.Ссылка КАК ГруппаДоступа
	|ИЗ
	|	Справочник.%1 КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Наименование", "ГруппыДоступаПартнеров");
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.ГруппаДоступа, Неопределено);

КонецФункции

//Значение перечисления программы или Неопределено, если такого нет.
Функция ЗначениеПеречисления(ИмяПеречисления, ИмяЗначения)

	МетаданныеПеречисления = Метаданные.Перечисления.Найти(ИмяПеречисления);
	Если МетаданныеПеречисления = Неопределено
		Или МетаданныеПеречисления.ЗначенияПеречисления.Найти(ИмяЗначения) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Перечисления[ИмяПеречисления][ИмяЗначения];

КонецФункции

//ИНН человека, если он корректен для физического лица (12 цифр), иначе пустая строка: программа проверяет ИНН
//контрольными разрядами и не запишет элемент с неверным.
Функция ИННДляПрограммы(ФизЛицо)

	ИНН = СокрЛП(РегистрыСведений.УЗ_ДокументыФизЛиц.ДанныеФизЛица(ФизЛицо).ИНН);
	Если ПустаяСтрока(ИНН) Или Не ПустаяСтрока(РегистрыСведений.УЗ_ДокументыФизЛиц.ОшибкаИНН(ИНН)) Тогда
		Возврат "";
	КонецЕсли;
	Возврат ИНН;

КонецФункции

Функция НетПраваДобавлять(ИмяСправочника)

	Если ПравоДоступа("Добавление", Метаданные.Справочники[ИмяСправочника]) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Нет права добавлять «%1» в программе: создайте элемент там (или попросите "
		+ "бухгалтера) и нажмите «Подобрать».'"), Метаданные.Справочники[ИмяСправочника].Синоним);

КонецФункции

Функция ЕстьСправочник(ИмяСправочника)

	Возврат Метаданные.Справочники.Найти(ИмяСправочника) <> Неопределено;

КонецФункции

//НашиДокументы — массив наших ссылок или Неопределено (все за период).
Функция ДанныеДенег(Организация, Касса, Начало, Конец, Режим, НашиДокументы)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Приход.Ссылка КАК Документ,
	|	""Приход"" КАК Вид,
	|	Приход.Дата КАК Дата,
	|	Приход.Организация КАК Организация,
	|	Приход.Касса КАК Касса,
	|	ВЫБОР
	|		КОГДА Приход.Плательщик <> ЗНАЧЕНИЕ(Справочник.УЗ_ФизЛица.ПустаяСсылка)
	|			ТОГДА Приход.Плательщик
	|		ИНАЧЕ Приход.ФизЛицо
	|	КОНЕЦ КАК Плательщик,
	|	Приход.СуммаДокумента КАК Сумма,
	|	Приход.ДокументОснования ССЫЛКА Документ.УЗ_СчетНаОплатуQR КАК Безнал,
	|	Приход.Проведен КАК Проведен,
	|	Приход.ВерсияДанных КАК ВерсияДанных
	|ПОМЕСТИТЬ ВТДеньги
	|ИЗ
	|	Документ.УЗ_ПриходДенег КАК Приход
	|ГДЕ
	|	Приход.Дата МЕЖДУ &Начало И &Конец
	|	И (&ВсеОрганизации ИЛИ Приход.Организация = &Организация)
	|	И (&ВсеКассы ИЛИ Приход.Касса = &Касса)
	|	И (&ВсеДокументы ИЛИ Приход.Ссылка В (&НашиДокументы))
	|	И Приход.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыОпераций.КассаУченики)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Расход.Ссылка,
	|	""Возврат"",
	|	Расход.Дата,
	|	Расход.Организация,
	|	Расход.Касса,
	|	ВЫБОР
	|		КОГДА Расход.Получатель <> ЗНАЧЕНИЕ(Справочник.УЗ_ФизЛица.ПустаяСсылка)
	|			ТОГДА Расход.Получатель
	|		ИНАЧЕ Расход.ФизЛицо
	|	КОНЕЦ,
	|	Расход.СуммаДокумента,
	|	ЛОЖЬ,
	|	Расход.Проведен,
	|	Расход.ВерсияДанных
	|ИЗ
	|	Документ.УЗ_РасходДенег КАК Расход
	|ГДЕ
	|	Расход.Дата МЕЖДУ &Начало И &Конец
	|	И (&ВсеОрганизации ИЛИ Расход.Организация = &Организация)
	|	И (&ВсеКассы ИЛИ Расход.Касса = &Касса)
	|	И (&ВсеДокументы ИЛИ Расход.Ссылка В (&НашиДокументы))
	|	И Расход.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыОпераций.КассаУченики)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Деньги.Документ КАК Документ,
	|	Деньги.Вид КАК Вид,
	|	Деньги.Дата КАК Дата,
	|	Деньги.Организация КАК Организация,
	|	Деньги.Касса КАК Касса,
	|	Деньги.Плательщик КАК Плательщик,
	|	Деньги.Сумма КАК Сумма,
	|	Деньги.Безнал КАК Безнал,
	|	Деньги.Проведен КАК Проведен,
	|	Плательщики.ОбъектХозяина КАК КонтрагентПлательщика,
	|	Связи.ОбъектХозяина КАК ОбъектХозяина,
	|	ЕСТЬNULL(Связи.Сумма, 0) КАК СуммаОформлено,
	|	ЕСТЬNULL(Связи.ВерсияДанных, """") КАК ВерсияОформления,
	|	Деньги.ВерсияДанных КАК ВерсияДанных,
	|	ЕСТЬNULL(Связи.Ошибка, """") КАК Ошибка,
	|	ЕСТЬNULL(Связи.Режим, """") КАК РежимОформления
	|ИЗ
	|	ВТДеньги КАК Деньги
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УЗ_СвязиСУчетомХозяина КАК Связи
	|		ПО Деньги.Документ = Связи.Объект
	|			И (Связи.Роль = &РольДокумент)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УЗ_СвязиСУчетомХозяина КАК Плательщики
	|		ПО Деньги.Плательщик = Плательщики.Объект
	|			И (Плательщики.Роль = &РольПлательщик)
	|ГДЕ
	|	(Деньги.Проведен
	|			ИЛИ НЕ Связи.Объект ЕСТЬ NULL)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Документ";
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВсеОрганизации", Не ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Касса", Касса);
	Запрос.УстановитьПараметр("ВсеКассы", Не ЗначениеЗаполнено(Касса));
	Запрос.УстановитьПараметр("НашиДокументы", НашиДокументы);
	Запрос.УстановитьПараметр("ВсеДокументы", НашиДокументы = Неопределено);
	Запрос.УстановитьПараметр("РольДокумент", РольДокумент());
	Запрос.УстановитьПараметр("РольПлательщик", РольПлательщик());
	Деньги = Запрос.Выполнить().Выгрузить();
	Деньги.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));
	Деньги.Колонки.Добавить("МожноОформить", Новый ОписаниеТипов("Булево"));
	Деньги.Колонки.Добавить("Изменен", Новый ОписаниеТипов("Булево"));
	Для Каждого Движение Из Деньги Цикл
		//версия документа — строка неограниченной длины: в запросе её не сравнить
		Движение.Изменен = Не ПустаяСтрока(Движение.ВерсияОформления)
			И Движение.ВерсияОформления <> Движение.ВерсияДанных;
		ЗаполнитьСостояниеДенег(Движение, Режим);
	КонецЦикла;
	Возврат Деньги;

КонецФункции

Процедура ЗаполнитьСостояниеДенег(Движение, Режим)

	Движение.МожноОформить = Истина;
	Если Движение.Безнал Тогда
		Движение.МожноОформить = Ложь;
		Движение.Состояние = НСтр("ru = 'Безналичная оплата: в программу её приносит выписка банка — только сверка'");
	ИначеЕсли Не ПустаяСтрока(Движение.Ошибка) Тогда
		Движение.Состояние = НСтр("ru = 'Не оформлено: '") + Движение.Ошибка;
	ИначеЕсли Не Движение.Проведен Тогда
		Движение.Состояние = НСтр("ru = 'Отменён в учёте занятий: документ программы будет помечен на удаление'");
	ИначеЕсли Не ЗначениеЗаполнено(Движение.ОбъектХозяина) Тогда
		Если Режим = РежимКаждымДокументом() И Не ЗначениеЗаполнено(Движение.КонтрагентПлательщика) Тогда
			Движение.МожноОформить = Ложь;
			Движение.Состояние = НСтр("ru = 'Плательщик не связан с контрагентом — свяжите на вкладке «Люди»'");
		Иначе
			Движение.Состояние = НСтр("ru = 'Не оформлено'");
		КонецЕсли;
	ИначеЕсли Движение.Изменен Тогда
		Движение.Состояние = НСтр("ru = 'Изменено после оформления — оформите ещё раз'");
	Иначе
		Движение.МожноОформить = Ложь;
		Движение.Состояние = НСтр("ru = 'Оформлено'");
	КонецЕсли;

КонецПроцедуры

//Все приходы дня по организации и кассе — один документ программы на общего контрагента.
Процедура ОформитьДень(Образец, Итог)

	Приходы = ДанныеДенег(Образец.Организация, Образец.Касса, НачалоДня(Образец.Дата), КонецДня(Образец.Дата),
		РежимЗаДень(), Неопределено);
	День = Новый Массив;
	Существующий = Неопределено;
	Сумма = 0;
	Дата = НачалоДня(Образец.Дата);
	Для Каждого Движение Из Приходы Цикл
		Если Движение.Вид <> "Приход" Или Движение.Безнал Тогда
			Продолжить;
		КонецЕсли;
		День.Добавить(Движение);
		Если ЗначениеЗаполнено(Движение.ОбъектХозяина) И Существующий = Неопределено Тогда
			Существующий = Движение.ОбъектХозяина;
		КонецЕсли;
		Если Движение.Проведен Тогда
			Сумма = Сумма + Движение.Сумма;
			Дата = Макс(Дата, Движение.Дата);
		КонецЕсли;
	КонецЦикла;

	Ошибка = "";
	Попытка
		Если Сумма = 0 Тогда
			ПометитьНаУдалениеВПрограмме(Существующий);
			Документ = Неопределено;
		Иначе
			Данные = НовыеДанныеКассовогоДокумента(Образец, "Приход", Сумма, Существующий);
			Данные.Дата = Дата;
			Данные.Контрагент = ОбщийКонтрагент();
			Данные.Человек = НСтр("ru = 'Физические лица'");
			Данные.Основание = СтрШаблон(НСтр("ru = 'Выручка учёта занятий за %1 (документов: %2)'"),
				Формат(Дата, "ДЛФ=D"), День.Количество());
			Документ = ЗаписатьКассовыйДокумент(Данные);
			Итог.Оформлено = Итог.Оформлено + 1;
		КонецЕсли;
	Исключение
		Ошибка = ТекстОшибкиПрограммы(ИнформацияОбОшибке(), Образец.Документ);
		Документ = Существующий;
		Итог.Ошибки.Добавить(Новый Структура("Документ, Текст", Образец.Документ, Ошибка));
	КонецПопытки;
	Для Каждого Движение Из День Цикл
		ЗаписатьСвязьДокумента(Движение, ?(Движение.Проведен, Документ, Неопределено), РежимЗаДень(),
			?(Движение.Проведен, Ошибка, ""));
	КонецЦикла;

КонецПроцедуры

//Один наш документ — один документ программы.
Процедура ОформитьДокумент(Движение, Режим, Итог)

	Ошибка = "";
	Документ = Движение.ОбъектХозяина;
	Попытка
		Если Не Движение.Проведен Тогда
			ПометитьНаУдалениеВПрограмме(Документ);
			Документ = Неопределено;
		Иначе
			Данные = НовыеДанныеКассовогоДокумента(Движение, Движение.Вид, Движение.Сумма, Документ);
			Если Режим = РежимЗаДень() Тогда
				Данные.Контрагент = ОбщийКонтрагент();
			ИначеЕсли ЗначениеЗаполнено(Движение.КонтрагентПлательщика) Тогда
				Данные.Контрагент = Движение.КонтрагентПлательщика;
			Иначе
				ВызватьИсключение НСтр("ru = 'Плательщик не связан с контрагентом — свяжите на вкладке «Люди».'");
			КонецЕсли;
			Документ = ЗаписатьКассовыйДокумент(Данные);
			Итог.Оформлено = Итог.Оформлено + 1;
		КонецЕсли;
	Исключение
		Ошибка = ТекстОшибкиПрограммы(ИнформацияОбОшибке(), Движение.Документ);
		Итог.Ошибки.Добавить(Новый Структура("Документ, Текст", Движение.Документ, Ошибка));
	КонецПопытки;
	ЗаписатьСвязьДокумента(Движение, Документ, Режим, Ошибка);

КонецПроцедуры

Функция НовыеДанныеКассовогоДокумента(Движение, Вид, Сумма, Существующий)

	Данные = Новый Структура("Вид, Дата, Организация, КассаПрограммы, Контрагент, Сумма, Основание, Человек, "
		+ "Существующий, НашаКасса", Вид, Движение.Дата, Движение.Организация, СвязанныйОбъект(Движение.Касса,
		РольКасса()), Неопределено, Сумма, "", "", Существующий, Движение.Касса);
	Если ЗначениеЗаполнено(Движение.Плательщик) Тогда
		Данные.Человек = СокрЛП(Движение.Плательщик.Наименование);
	КонецЕсли;
	Данные.Основание = СтрШаблон(НСтр("ru = 'Учёт занятий: %1'"), Движение.Документ);
	Возврат Данные;

КонецФункции

//Связь нашего документа с документом программы: сумма и версия на момент оформления — по ним видно «изменено после
//оформления». Документ — Неопределено и нет ошибки: связь снимается (наш документ отменён).
Процедура ЗаписатьСвязьДокумента(Движение, Документ, Режим, Ошибка)

	Если Документ = Неопределено И ПустаяСтрока(Ошибка) Тогда
		Отвязать(Движение.Документ, РольДокумент());
		Возврат;
	КонецЕсли;
	Запись = РегистрыСведений.УЗ_СвязиСУчетомХозяина.СоздатьМенеджерЗаписи();
	Запись.Объект = Движение.Документ;
	Запись.Роль = РольДокумент();
	Запись.ОбъектХозяина = Документ;
	Запись.Сумма = Движение.Сумма;
	Запись.ВерсияДанных = Движение.Документ.ВерсияДанных;
	Запись.Режим = Режим;
	Запись.Дата = ТекущаяДатаСеанса();
	Запись.Автор = УЗ_Среда.ТекущийПользователь();
	Запись.Ошибка = Ошибка;
	Запись.Записать();

КонецПроцедуры

Функция ТекстОшибкиПрограммы(Информация, Документ)

	ЗаписьЖурналаРегистрации(НСтр("ru = 'Учёт занятий.Мост'"), УровеньЖурналаРегистрации.Предупреждение,
		Документ.Метаданные(), Документ, ПодробноеПредставлениеОшибки(Информация));
	Возврат КраткоеПредставлениеОшибки(Информация);

КонецФункции

//Помечает документ программы на удаление (проведённый — с отменой проведения, механизмом программы).
Процедура ПометитьНаУдалениеВПрограмме(Документ)

	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат;
	КонецЕсли;
	Объект = Документ.ПолучитьОбъект();
	Если Объект <> Неопределено И Не Объект.ПометкаУдаления Тогда
		Объект.УстановитьПометкуУдаления(Истина);
	КонецЕсли;

КонецПроцедуры

//Общий контрагент режима «за день» — «Физические лица (учёт занятий)»: находится по наименованию или создаётся
//физическим лицом (в Управлении торговлей — с партнёром); связь хранится с ролью «ОбщийКонтрагент».
Функция ОбщийКонтрагент()

	Связь = СвязанныйОбъект(Неопределено, РольОбщийКонтрагент());
	Если Связь <> Неопределено Тогда
		Возврат Связь;
	КонецЕсли;
	Если Не ЕстьСправочник("Контрагенты") Тогда
		ВызватьИсключение НСтр("ru = 'В программе нет справочника контрагентов.'");
	КонецЕсли;
	Наименование = НСтр("ru = 'Физические лица (учёт занятий)'");
	Найденные = ЭлементыПрограммы("Контрагенты", "Наименование", Наименование);
	Если Найденные.Количество() > 0 Тогда
		Контрагент = Найденные[0].Ссылка;
	Иначе
		Причина = НетПраваДобавлять("Контрагенты");
		Если Не ПустаяСтрока(Причина) Тогда
			ВызватьИсключение Причина;
		КонецЕсли;
		Контрагент = НовыйКонтрагентФизЛицо(Наименование, "");
	КонецЕсли;
	Запись = РегистрыСведений.УЗ_СвязиСУчетомХозяина.СоздатьМенеджерЗаписи();
	Запись.Объект = Неопределено;
	Запись.Роль = РольОбщийКонтрагент();
	Запись.ОбъектХозяина = Контрагент;
	Запись.Дата = ТекущаяДатаСеанса();
	Запись.Автор = УЗ_Среда.ТекущийПользователь();
	Запись.Записать();
	Возврат Контрагент;

КонецФункции

Функция РольОбщийКонтрагент()
	Возврат "ОбщийКонтрагент";
КонецФункции

//Кассовый документ программы для нашего вида движения ("Приход" / "Возврат"): имя документа, поле и значение вида
//операции, поле «принято от» / «выдать». Неопределено — программа не знает таких документов.
Функция КассовыйДокументПрограммы(Вид)

	Приход = Вид = "Приход";
	Семейство = УЗ_Среда.Паспорт().Семейство;
	Если Семейство = "УНФ" Тогда
		Описание = Новый Структура("Имя, ПолеВида, ЗначениеВида, ПолеЧеловека",
			?(Приход, "ПоступлениеВКассу", "РасходИзКассы"), "ВидОперации",
			?(Приход, ЗначениеПеречисления("ВидыОперацийПоступлениеВКассу", "ОтПокупателя"),
				ЗначениеПеречисления("ВидыОперацийРасходИзКассы", "Покупателю")),
			?(Приход, "ПринятоОт", "Выдать"));
	ИначеЕсли Семейство = "УТ" Тогда
		Описание = Новый Структура("Имя, ПолеВида, ЗначениеВида, ПолеЧеловека",
			?(Приход, "ПриходныйКассовыйОрдер", "РасходныйКассовыйОрдер"), "ХозяйственнаяОперация",
			ЗначениеПеречисления("ХозяйственныеОперации",
				?(Приход, "ПоступлениеОплатыОтКлиента", "ВозвратОплатыКлиенту")),
			?(Приход, "ПринятоОт", "Выдать"));
	Иначе
		Описание = Новый Структура("Имя, ПолеВида, ЗначениеВида, ПолеЧеловека",
			?(Приход, "ПриходныйКассовыйОрдер", "РасходныйКассовыйОрдер"), "ВидОперации",
			?(Приход, ЗначениеПеречисления("ВидыОперацийПКО", "ОплатаПокупателя"),
				ЗначениеПеречисления("ВидыОперацийРКО", "ВозвратПокупателю")),
			?(Приход, "ПринятоОт", "Выдать"));
	КонецЕсли;
	Если Метаданные.Документы.Найти(Описание.Имя) = Неопределено Или Описание.ЗначениеВида = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Описание;

КонецФункции

//Создаёт или переписывает кассовый документ программы и проводит его её механизмом: заполнение по умолчанию (касса,
//валюта, статья, счета), наши данные, одна строка расшифровки платежа. Ссылка или исключение с причиной программы.
Функция ЗаписатьКассовыйДокумент(Данные)

	Описание = КассовыйДокументПрограммы(Данные.Вид);
	Если Описание = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'В программе нет кассовых документов для оформления.'");
	КонецЕсли;
	МетаданныеДокумента = Метаданные.Документы[Описание.Имя];
	Если ЗначениеЗаполнено(Данные.Существующий) И Данные.Существующий.Метаданные() = МетаданныеДокумента Тогда
		Объект = Данные.Существующий.ПолучитьОбъект();
		Если Объект.ПометкаУдаления Тогда
			Объект.УстановитьПометкуУдаления(Ложь);
		КонецЕсли;
	Иначе
		Объект = Документы[Описание.Имя].СоздатьДокумент();
		Объект.Дата = Данные.Дата;
		Заполнение = Новый Структура("Организация, Контрагент", Данные.Организация, Данные.Контрагент);
		Заполнение.Вставить(Описание.ПолеВида, Описание.ЗначениеВида);
		Объект.Заполнить(Заполнение);
	КонецЕсли;
	Объект.Дата = Данные.Дата;
	Объект[Описание.ПолеВида] = Описание.ЗначениеВида;
	Объект.Организация = Данные.Организация;
	Объект.Контрагент = Данные.Контрагент;
	Объект.СуммаДокумента = Данные.Сумма;
	Если ЗначениеЗаполнено(Данные.КассаПрограммы) Тогда
		УстановитьРеквизит(Объект, "Касса", Данные.КассаПрограммы);
	КонецЕсли;
	//касса не связана и программа не подставила свою по умолчанию — единственная касса организации, иначе причина
	Если УЗ_Общий.ЕстьРеквизит(МетаданныеДокумента.ПолноеИмя(), "Касса") И Не ЗначениеЗаполнено(Объект.Касса) Тогда
		Объект.Касса = ЕдинственнаяКассаПрограммы(Данные.Организация);
		Если Не ЗначениеЗаполнено(Объект.Касса) Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Не выбрана касса программы: свяжите кассу «%1» с кассой программы "
				+ "на вкладке «Люди».'"), Данные.НашаКасса);
		КонецЕсли;
	КонецЕсли;
	УстановитьРеквизит(Объект, Описание.ПолеЧеловека, Данные.Человек);
	УстановитьРеквизит(Объект, "Основание", Данные.Основание);
	//образование не облагается НДС (подп. 14 п. 2 ст. 149 НК РФ): УНФ без этого требует ставку в строке
	Если УЗ_Общий.ЕстьРеквизит(МетаданныеДокумента.ПолноеИмя(), "НалогообложениеНДС")
		И Не ЗначениеЗаполнено(Объект.НалогообложениеНДС) Тогда
		УстановитьРеквизит(Объект, "НалогообложениеНДС", ЗначениеПеречисления("ТипыНалогообложенияНДС",
			"НеОблагаетсяНДС"));
	КонецЕсли;
	//Бухгалтерия: счета расчётов (62.01, 62.02) заполнить перед записью, даже если пользователь управляет ими сам
	Объект.ДополнительныеСвойства.Вставить("ЗаполнитьСчетаУчетаПередЗаписью", Истина);
	ЗаполнитьРасшифровкуПлатежа(Объект, Данные);

	СообщенияДо = ПолучитьСообщенияПользователю(Истина);
	Попытка
		Объект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Тексты = Новый Массив;
		Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			Тексты.Добавить(Сообщение.Текст);
		КонецЦикла;
		Тексты.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение СтрШаблон("%1: %2", МетаданныеДокумента.Синоним, СтрСоединить(Тексты, "; "));
	КонецПопытки;
	Для Каждого Сообщение Из СообщенияДо Цикл
		Сообщение.Сообщить();
	КонецЦикла;
	Возврат Объект.Ссылка;

КонецФункции

//Одна строка расшифровки платежа на всю сумму: в каждой программе свои колонки — заполняем те, что есть.
Процедура ЗаполнитьРасшифровкуПлатежа(Объект, Данные)

	Если Объект.Метаданные().ТабличныеЧасти.Найти("РасшифровкаПлатежа") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Расшифровка = Объект.РасшифровкаПлатежа;
	Если Расшифровка.Количество() = 0 Тогда
		Расшифровка.Добавить();
	КонецЕсли;
	Пока Расшифровка.Количество() > 1 Цикл
		Расшифровка.Удалить(Расшифровка.Количество() - 1);
	КонецЦикла;
	Платеж = Расшифровка[0];
	Колонки = Объект.Метаданные().ТабличныеЧасти.РасшифровкаПлатежа.Реквизиты;
	Значения = Новый Структура("СуммаПлатежа, Сумма, СуммаВзаиморасчетов, СуммаРасчетов", Данные.Сумма, Данные.Сумма,
		Данные.Сумма, Данные.Сумма);
	Значения.Вставить("КурсВзаиморасчетов", 1);
	Значения.Вставить("КратностьВзаиморасчетов", 1);
	Значения.Вставить("КурсЧислительВзаиморасчетов", 1);
	Значения.Вставить("КурсЗнаменательВзаиморасчетов", 1);
	Значения.Вставить("Курс", 1);
	Значения.Вставить("Кратность", 1);
	Значения.Вставить("ПризнакАванса", Истина);
	Значения.Вставить("СпособПогашенияЗадолженности", ЗначениеПеречисления("СпособыПогашенияЗадолженности",
		"Автоматически"));
	Если Колонки.Найти("Партнер") <> Неопределено И УЗ_Общий.ЕстьРеквизит("Справочник.Контрагенты", "Партнер") Тогда
		Значения.Вставить("Партнер", Данные.Контрагент.Партнер);
	КонецЕсли;
	Если Колонки.Найти("ВалютаВзаиморасчетов") <> Неопределено
		И УЗ_Общий.ЕстьРеквизит(Объект.Метаданные().ПолноеИмя(), "Валюта") Тогда
		Значения.Вставить("ВалютаВзаиморасчетов", Объект.Валюта);
	КонецЕсли;
	Если Колонки.Найти("СтатьяДвиженияДенежныхСредств") <> Неопределено
		И Не ЗначениеЗаполнено(Платеж.СтатьяДвиженияДенежныхСредств)
		И УЗ_Общий.ЕстьРеквизит(Объект.Метаданные().ПолноеИмя(), "СтатьяДвиженияДенежныхСредств") Тогда
		Значения.Вставить("СтатьяДвиженияДенежныхСредств", Объект.СтатьяДвиженияДенежныхСредств);
	КонецЕсли;
	ИмяДоговора = ?(Колонки.Найти("ДоговорКонтрагента") <> Неопределено, "ДоговорКонтрагента",
		?(Колонки.Найти("Договор") <> Неопределено, "Договор", ""));
	Если Не ПустаяСтрока(ИмяДоговора) Тогда
		Договор = ДоговорПокупателя(Данные.Контрагент, Данные.Организация);
		Если Договор <> Неопределено Тогда
			Значения.Вставить(ИмяДоговора, Договор);
		КонецЕсли;
	КонецЕсли;
	//УНФ: возврат при расчётах по документам — против документа оплаты, по которому числится аванс
	Если Данные.Вид <> "Приход" И Колонки.Найти("Документ") <> Неопределено
		И УЗ_Общий.ЕстьРеквизит("Справочник.Контрагенты", "ВестиРасчетыПоДокументам")
		И Данные.Контрагент.ВестиРасчетыПоДокументам Тогда
		Значения.Вставить("Документ", ПоследняяОплатаКонтрагента(Данные.Контрагент, Данные.Организация, Данные.Дата));
	КонецЕсли;
	Для Каждого Значение Из Значения Цикл
		Если Значение.Значение <> Неопределено И Колонки.Найти(Значение.Ключ) <> Неопределено Тогда
			Платеж[Значение.Ключ] = Значение.Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

//Договор с покупателем (Бухгалтерия, УНФ): существующий договор контрагента с организацией, иначе новый «Основной
//договор». В Управлении торговлей договоров у кассовых документов нет — Неопределено.
Функция ДоговорПокупателя(Контрагент, Организация)

	Если Не ЕстьСправочник("ДоговорыКонтрагентов") Тогда
		Возврат Неопределено;
	КонецЕсли;
	ВидДоговора = ЗначениеПеречисления("ВидыДоговоровКонтрагентов", "СПокупателем");
	Если ВидДоговора = Неопределено Тогда
		ВидДоговора = ЗначениеПеречисления("ВидыДоговоров", "СПокупателем");
	КонецЕсли;
	Если ВидДоговора = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.%1 КАК Т
	|ГДЕ
	|	Т.Владелец = &Контрагент
	|	И Т.Организация = &Организация
	|	И Т.ВидДоговора = &ВидДоговора
	|	И НЕ Т.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Код", "ДоговорыКонтрагентов");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВидДоговора", ВидДоговора);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат ЗаписатьНовый("ДоговорыКонтрагентов", Новый Структура("Владелец, Организация, ВидДоговора, Наименование",
		Контрагент, Организация, ВидДоговора, НСтр("ru = 'Основной договор'")),
		Новый Структура("Владелец, Организация, ВидДоговора", Контрагент, Организация, ВидДоговора));

КонецФункции

//Последний проведённый приходный кассовый документ программы от контрагента не позже даты; Неопределено — нет.
Функция ПоследняяОплатаКонтрагента(Контрагент, Организация, Дата)

	Описание = КассовыйДокументПрограммы("Приход");
	Если Описание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.%1 КАК Т
	|ГДЕ
	|	Т.Проведен
	|	И Т.Контрагент = &Контрагент
	|	И Т.Организация = &Организация
	|	И Т.Дата <= &Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Дата УБЫВ", Описание.Имя);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата", Дата);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Неопределено);

КонецФункции

//Касса программы (справочник «Кассы» УНФ и Управления торговлей), если у организации она одна; иначе Неопределено.
Функция ЕдинственнаяКассаПрограммы(Организация)

	Если Не ЕстьСправочник("Кассы") Или Не УЗ_Общий.ЕстьРеквизит("Справочник.Кассы", "Владелец")
		И Не УЗ_Общий.ЕстьРеквизит("Справочник.Кассы", "Организация") Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПолеОрганизации = ?(УЗ_Общий.ЕстьРеквизит("Справочник.Кассы", "Организация"), "Организация", "Владелец");
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Кассы КАК Т
	|ГДЕ
	|	Т.%1 = &Организация
	|	И НЕ Т.ПометкаУдаления", ПолеОрганизации);
	Запрос.УстановитьПараметр("Организация", Организация);
	Выгрузка = Запрос.Выполнить().Выгрузить();
	Возврат ?(Выгрузка.Количество() = 1, Выгрузка[0].Ссылка, Неопределено);

КонецФункции

//Реквизит шапки документа программы, если он у неё есть.
//Роль связи педагога с «Начислением зарплаты» программы: документ общий на организацию и месяц (до 20 знаков).
Функция РольНачисления(Организация, Месяц)
	Возврат "ЗП" + Формат(Месяц, "ДФ=yyyyMM") + Прав(Строка(Организация.УникальныйИдентификатор()), 12);
КонецФункции

//Менеджер записи связи или Неопределено.
Функция ЗаписьСвязи(Объект, Роль)

	Запись = РегистрыСведений.УЗ_СвязиСУчетомХозяина.СоздатьМенеджерЗаписи();
	Запись.Объект = Объект;
	Запись.Роль = Роль;
	Запись.Прочитать();
	Возврат ?(Запись.Выбран(), Запись, Неопределено);

КонецФункции

Процедура ЗаполнитьСостояниеЗарплаты(Движение)

	Движение.МожноОформить = Ложь;
	Если Движение.ПроведеноВПрограмме Тогда
		Движение.Состояние = ?(Движение.Изменен, НСтр("ru = 'Проведено бухгалтером, у нас сумма изменилась — сверка'"),
			НСтр("ru = 'Проведено бухгалтером'"));
	ИначеЕсли Не ЗначениеЗаполнено(Движение.Сотрудник) Тогда
		Движение.Состояние = НСтр("ru = 'Педагог не связан с сотрудником — свяжите на вкладке «Люди»'");
	ИначеЕсли Не ПустаяСтрока(Движение.Ошибка) Тогда
		Движение.МожноОформить = Истина;
		Движение.Состояние = НСтр("ru = 'Не оформлено: '") + Движение.Ошибка;
	ИначеЕсли Не Движение.Проведен Тогда
		Движение.МожноОформить = Истина;
		Движение.Состояние = НСтр("ru = 'Отменён в учёте занятий: черновик программы будет помечен на удаление'");
	ИначеЕсли Не ЗначениеЗаполнено(Движение.ОбъектХозяина) Тогда
		Движение.МожноОформить = Истина;
		Движение.Состояние = НСтр("ru = 'Не оформлено'");
	ИначеЕсли Движение.Изменен Тогда
		Движение.МожноОформить = Истина;
		Движение.Состояние = НСтр("ru = 'Изменено после оформления — оформите ещё раз'");
	Иначе
		Движение.Состояние = НСтр("ru = 'Черновик у бухгалтера'");
	КонецЕсли;

КонецПроцедуры

//Одно «Начисление зарплаты» программы на организацию и месяц: переписывается целиком по всем педагогам месяца.
Процедура ОформитьНачисление(Образец, Зарплата, Итог)

	Педагоги = Новый Массив;
	Существующий = Неопределено;
	Для Каждого Движение Из Зарплата Цикл
		Если Движение.Вид <> "Начисление" Или Движение.Месяц <> Образец.Месяц
			Или Движение.Организация <> Образец.Организация Или Не ЗначениеЗаполнено(Движение.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		Педагоги.Добавить(Движение);
		Если ЗначениеЗаполнено(Движение.ОбъектХозяина) И Существующий = Неопределено Тогда
			Существующий = Движение.ОбъектХозяина;
		КонецЕсли;
	КонецЦикла;
	Ошибка = "";
	Попытка
		Документ = ЗаписатьНачислениеЗарплаты(Образец, Педагоги, Существующий);
		Итог.Оформлено = Итог.Оформлено + 1;
	Исключение
		Ошибка = ТекстОшибкиПрограммы(ИнформацияОбОшибке(), Образец.Педагог);
		Документ = Существующий;
		Итог.Ошибки.Добавить(Новый Структура("Объект, Текст", Образец.Педагог, Ошибка));
	КонецПопытки;
	Роль = РольНачисления(Образец.Организация, Образец.Месяц);
	Для Каждого Движение Из Педагоги Цикл
		ЗаписатьСвязьЗарплаты(Движение.Педагог, Роль, Документ, Движение.Сумма, "", Ошибка);
	КонецЦикла;

КонецПроцедуры

Функция ЗаписатьНачислениеЗарплаты(Образец, Педагоги, Существующий)

	ИмяДокумента = "НачислениеЗарплаты";
	Если Метаданные.Документы.Найти(ИмяДокумента) = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'В программе нет документа «Начисление зарплаты».'");
	КонецЕсли;
	ВидыНачислений = Новый Соответствие;     //вид, выбранный бухгалтером в черновике, — по сотруднику
	Если ЗначениеЗаполнено(Существующий) Тогда
		Объект = Существующий.ПолучитьОбъект();
		Если Объект.ПометкаУдаления Тогда
			Объект.УстановитьПометкуУдаления(Ложь);
		КонецЕсли;
		Для Каждого Старая Из Объект.Начисления Цикл
			ВидыНачислений.Вставить(Старая.Сотрудник, Старая.Начисление);
		КонецЦикла;
	Иначе
		Объект = Документы[ИмяДокумента].СоздатьДокумент();
	КонецЕсли;
	Объект.Дата = КонецДня(Образец.Дата);
	Объект.Организация = Образец.Организация;
	Объект.МесяцНачисления = Образец.Месяц;
	Объект.Комментарий = НСтр("ru = 'Учёт занятий: черновик — проверьте НДФЛ и взносы и проведите'");
	Для Каждого ТабличнаяЧасть Из Объект.Метаданные().ТабличныеЧасти Цикл
		Объект[ТабличнаяЧасть.Имя].Очистить();
	КонецЦикла;
	ВидПоУмолчанию = ?(ВидыНачислений.Количество() < Педагоги.Количество(), ВидНачисленияПоУмолчанию(), Неопределено);
	СДатойВыплаты = Объект.Метаданные().ТабличныеЧасти.Начисления.Реквизиты.Найти("ПланируемаяДатаВыплаты")
		<> Неопределено;
	Сотрудники = Новый Массив;
	Для Каждого Движение Из Педагоги Цикл
		Если Движение.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		Вид = ВидыНачислений[Движение.Сотрудник];
		Если Вид = Неопределено Тогда
			Вид = ВидПоУмолчанию;
		КонецЕсли;
		Начисление = Объект.Начисления.Добавить();
		Начисление.Сотрудник = Движение.Сотрудник;
		Начисление.Начисление = Вид;
		Начисление.Результат = Движение.Сумма;
		Если СДатойВыплаты Тогда
			Начисление.ПланируемаяДатаВыплаты = Объект.Дата;
		КонецЕсли;
		Если Сотрудники.Найти(Движение.Сотрудник) = Неопределено Тогда
			Сотрудники.Добавить(Движение.Сотрудник);
			Объект.Сотрудники.Добавить().Сотрудник = Движение.Сотрудник;
			Объект.ФизическиеЛица.Добавить().ФизическоеЛицо = Движение.Сотрудник.ФизическоеЛицо;
		КонецЕсли;
	КонецЦикла;
	//Бухгалтерия считает НДФЛ и взносы менеджером документа (свою транзакцию открывает сама); в УНФ — форма документа
	Если УЗ_Среда.Паспорт().Семейство = "БП" И Сотрудники.Количество() > 0 Тогда
		Попытка
			Документы[ИмяДокумента].ОбновитьНДФЛиВзносыСотрудников(Объект, Сотрудники);
		Исключение
			//черновик всё равно нужен: НДФЛ пересчитает бухгалтер, причина — в журнале
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Учёт занятий.Мост'"), УровеньЖурналаРегистрации.Предупреждение, ,
				Существующий, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	ЗаписатьЧерновикПрограммы(Объект);
	Возврат Объект.Ссылка;

КонецФункции

//Вид начисления для новой строки: «Оплата по окладу», иначе первый действующий вид начисления программы.
Функция ВидНачисленияПоУмолчанию()

	Если Метаданные.ПланыВидовРасчета.Найти("Начисления") = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'В программе нет видов начислений.'");
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	ПланВидовРасчета.%1 КАК Т
	|ГДЕ
	|	НЕ Т.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР
	|		КОГДА Т.Наименование = &Наименование
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ,
	|	Т.Код", "Начисления");
	Запрос.УстановитьПараметр("Наименование", НСтр("ru = 'Оплата по окладу'"));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение НСтр("ru = 'В программе нет видов начислений: их заводит бухгалтер.'");
	КонецЕсли;
	Возврат Выборка.Ссылка;

КонецФункции

//«Ведомость в кассу» программы на наш ордер «Выплата зарплаты»: черновик; отменённый у нас — помечается на удаление.
Процедура ОформитьВедомость(Движение, Итог)

	Ошибка = "";
	Документ = Движение.ОбъектХозяина;
	Попытка
		Если Не Движение.Проведен Тогда
			ПометитьНаУдалениеВПрограмме(Документ);
			Документ = Неопределено;
		Иначе
			Документ = ЗаписатьВедомостьВКассу(Движение);
			Итог.Оформлено = Итог.Оформлено + 1;
		КонецЕсли;
	Исключение
		Ошибка = ТекстОшибкиПрограммы(ИнформацияОбОшибке(), Движение.Документ);
		Итог.Ошибки.Добавить(Новый Структура("Объект, Текст", Движение.Документ, Ошибка));
	КонецПопытки;
	ЗаписатьСвязьЗарплаты(Движение.Документ, РольДокумент(), Документ, Движение.Сумма,
		Движение.Документ.ВерсияДанных, Ошибка);

КонецПроцедуры

Функция ЗаписатьВедомостьВКассу(Движение)

	ИмяДокумента = "ВедомостьНаВыплатуЗарплатыВКассу";
	ИмяМодуля = "ВедомостьНаВыплатуЗарплаты";
	Если Метаданные.Документы.Найти(ИмяДокумента) = Неопределено
		Или Метаданные.ОбщиеМодули.Найти(ИмяМодуля) = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'В программе нет документа «Ведомость в кассу».'");
	КонецЕсли;
	Если ЗначениеЗаполнено(Движение.ОбъектХозяина) Тогда
		Объект = Движение.ОбъектХозяина.ПолучитьОбъект();
		Если Объект.ПометкаУдаления Тогда
			Объект.УстановитьПометкуУдаления(Ложь);
		КонецЕсли;
	Иначе
		Объект = Документы[ИмяДокумента].СоздатьДокумент();
		Объект.Заполнить(Неопределено);
	КонецЕсли;
	Объект.Дата = Движение.Дата;
	Объект.Организация = Движение.Организация;
	Объект.ПериодРегистрации = Движение.Месяц;
	Объект.ДатаВыплаты = НачалоДня(Движение.Дата);
	Объект.СпособВыплаты = Справочники["СпособыВыплатыЗарплаты"].Зарплата;
	Объект.Комментарий = СтрШаблон(НСтр("ru = 'Учёт занятий: черновик по документу %1'"), Движение.Документ);
	Зарплата = Объект.Зарплата.Выгрузить();
	Зарплата.Очистить();
	Выплата = Зарплата.Добавить();
	Выплата.Сотрудник = Движение.Сотрудник;
	Выплата.ФизическоеЛицо = Движение.Сотрудник.ФизическоеЛицо;
	Выплата.ПериодВзаиморасчетов = Движение.Месяц;
	Выплата.КВыплате = Движение.Сумма;
	НДФЛ = НалогиКУдержаниюПрограммы(ИмяМодуля, Зарплата, Документы[ИмяДокумента].ПараметрыЗаполненияПоОбъекту(Объект),
		Объект.Ссылка);
	Объект.ЗагрузитьВыплаты(Зарплата, НДФЛ);
	ЗаписатьЧерновикПрограммы(Объект);
	Возврат Объект.Ссылка;

КонецФункции

//НДФЛ к удержанию по выплатам ведомости считает программа (имя её модуля проверено вызывающим).
Функция НалогиКУдержаниюПрограммы(ИмяМодуля, Зарплата, Параметры, Ведомость)

	Возврат Вычислить(ИмяМодуля + ".НалогиКУдержанию(Зарплата, Параметры.ОписаниеОперации, "
		+ "Параметры.ПараметрыРасчетаНДФЛ, Параметры.Финансирование, Ведомость)");

КонецФункции

//Записывает документ программы без проведения; причина отказа — с сообщениями программы.
Процедура ЗаписатьЧерновикПрограммы(Объект)

	СообщенияДо = ПолучитьСообщенияПользователю(Истина);
	Попытка
		Объект.Записать(РежимЗаписиДокумента.Запись);
	Исключение
		Тексты = Новый Массив;
		Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			Тексты.Добавить(Сообщение.Текст);
		КонецЦикла;
		Тексты.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение СтрШаблон("%1: %2", Объект.Метаданные().Синоним, СтрСоединить(Тексты, "; "));
	КонецПопытки;
	Для Каждого Сообщение Из СообщенияДо Цикл
		Сообщение.Сообщить();
	КонецЦикла;

КонецПроцедуры

//Связь с черновиком зарплаты: сумма (и версия ордера) на момент оформления. Нет документа и ошибки — связь снята.
Процедура ЗаписатьСвязьЗарплаты(Объект, Роль, Документ, Сумма, ВерсияДанных, Ошибка)

	Если Документ = Неопределено И ПустаяСтрока(Ошибка) Тогда
		Отвязать(Объект, Роль);
		Возврат;
	КонецЕсли;
	Запись = РегистрыСведений.УЗ_СвязиСУчетомХозяина.СоздатьМенеджерЗаписи();
	Запись.Объект = Объект;
	Запись.Роль = Роль;
	Запись.ОбъектХозяина = Документ;
	Запись.Сумма = Сумма;
	Запись.ВерсияДанных = ВерсияДанных;
	Запись.Режим = "Зарплата";
	Запись.Дата = ТекущаяДатаСеанса();
	Запись.Автор = УЗ_Среда.ТекущийПользователь();
	Запись.Ошибка = Ошибка;
	Запись.Записать();

КонецПроцедуры

Процедура СверитьДеньги(Итог, Деньги)

	Дни = Новый Соответствие;            //документ программы дня → сумма наших проведённых приходов
	Для Каждого Движение Из Деньги Цикл
		Если Не ЗначениеЗаполнено(Движение.ОбъектХозяина) Тогда
			Продолжить;
		ИначеЕсли Движение.РежимОформления = РежимЗаДень() И Движение.Вид = "Приход" Тогда
			Дни.Вставить(Движение.ОбъектХозяина, ?(Дни[Движение.ОбъектХозяина] = Неопределено, 0,
				Дни[Движение.ОбъектХозяина]) + ?(Движение.Проведен, Движение.Сумма, 0));
			Продолжить;
		КонецЕсли;
		Документ = Движение.ОбъектХозяина.ПолучитьОбъект();
		Если Не СверитьСуществование(Итог, "Деньги", Движение.Документ, Движение.ОбъектХозяина, Документ,
			Движение.Проведен) Тогда
			Продолжить;
		КонецЕсли;
		Если Документ.СуммаДокумента <> Движение.Сумма Тогда
			ДобавитьРасхождение(Итог, "Деньги", Движение.Документ, Движение.ОбъектХозяина, НСтр("ru = 'Сумма'"),
				ФорматСуммы(Движение.Сумма), ФорматСуммы(Документ.СуммаДокумента));
		КонецЕсли;
		Контрагент = ?(Движение.РежимОформления = РежимЗаДень(), СвязанныйОбъект(Неопределено, РольОбщийКонтрагент()),
			Движение.КонтрагентПлательщика);
		Если ЗначениеЗаполнено(Контрагент) И Документ.Контрагент <> Контрагент Тогда
			ДобавитьРасхождение(Итог, "Деньги", Движение.Документ, Движение.ОбъектХозяина, НСтр("ru = 'Контрагент'"),
				СтрШаблон("%1 (%2)", Контрагент, Движение.Плательщик), Строка(Документ.Контрагент));
		КонецЕсли;
	КонецЦикла;

	Для Каждого День Из Дни Цикл
		Документ = День.Ключ.ПолучитьОбъект();
		Если Не СверитьСуществование(Итог, "Деньги", Неопределено, День.Ключ, Документ, День.Значение > 0) Тогда
			Продолжить;
		КонецЕсли;
		Если Документ.СуммаДокумента <> День.Значение Тогда
			ДобавитьРасхождение(Итог, "Деньги", Неопределено, День.Ключ, НСтр("ru = 'Сумма дня'"),
				ФорматСуммы(День.Значение), ФорматСуммы(Документ.СуммаДокумента));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура СверитьЗарплату(Итог, Зарплата)

	Загруженные = Новый Соответствие;    //документ программы → объект (начисление одно на месяц для всех педагогов)
	Для Каждого Движение Из Зарплата Цикл
		Если Не ЗначениеЗаполнено(Движение.ОбъектХозяина) Тогда
			Продолжить;
		КонецЕсли;
		Объект = ?(Движение.Вид = "Начисление", Движение.Педагог, Движение.Документ);
		Документ = Загруженные[Движение.ОбъектХозяина];
		Если Документ = Неопределено Тогда
			Документ = Движение.ОбъектХозяина.ПолучитьОбъект();
			Загруженные.Вставить(Движение.ОбъектХозяина, Документ);
		КонецЕсли;
		//черновик зарплаты не проведён — это нормально: его проводит бухгалтер
		Если Не СверитьСуществование(Итог, "Зарплата", Объект, Движение.ОбъектХозяина, Документ,
			Движение.Проведен, Ложь) Тогда
			Продолжить;
		КонецЕсли;
		Сумма = 0;
		Если Движение.Вид = "Начисление" Тогда
			Для Каждого Начисление Из Документ.Начисления Цикл
				Если Начисление.Сотрудник = Движение.Сотрудник Тогда
					Сумма = Сумма + Начисление.Результат;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Сумма = Документ.Зарплата.Итог("КВыплате");
		КонецЕсли;
		Если Сумма <> Движение.Сумма Тогда
			ДобавитьРасхождение(Итог, "Зарплата", Объект, Движение.ОбъектХозяина,
				?(Движение.Вид = "Начисление", НСтр("ru = 'Начислено'"), НСтр("ru = 'К выплате'")),
				ФорматСуммы(Движение.Сумма), ФорматСуммы(Сумма));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

//Документ программы есть и действует; иначе — строка расхождения. Ложь — дальше сверять нечего.
Функция СверитьСуществование(Итог, Раздел, Объект, Ссылка, Документ, ПроведенУНас, ПроведениеОбязательно = Истина)

	Если Документ = Неопределено Тогда
		ДобавитьРасхождение(Итог, Раздел, Объект, Неопределено, НСтр("ru = 'Документ программы удалён'"), "",
			Строка(Ссылка));
		Возврат Ложь;
	ИначеЕсли Не ПроведенУНас Тогда
		Если Не Документ.ПометкаУдаления Тогда
			ДобавитьРасхождение(Итог, Раздел, Объект, Ссылка, НСтр("ru = 'Отменён у нас, в программе действует'"),
				НСтр("ru = 'отменён'"), ?(Документ.Проведен, НСтр("ru = 'проведён'"), НСтр("ru = 'записан'")));
		КонецЕсли;
		Возврат Ложь;
	ИначеЕсли Документ.ПометкаУдаления Тогда
		ДобавитьРасхождение(Итог, Раздел, Объект, Ссылка, НСтр("ru = 'Помечен на удаление в программе'"),
			НСтр("ru = 'проведён'"), НСтр("ru = 'помечен на удаление'"));
		Возврат Ложь;
	ИначеЕсли ПроведениеОбязательно И Не Документ.Проведен Тогда
		ДобавитьРасхождение(Итог, Раздел, Объект, Ссылка, НСтр("ru = 'Не проведён в программе'"),
			НСтр("ru = 'проведён'"), НСтр("ru = 'не проведён'"));
	КонецЕсли;
	Возврат Истина;

КонецФункции

Процедура ДобавитьРасхождение(Итог, Раздел, Объект, Ссылка, Расхождение, УНас, ВПрограмме)

	НоваяСтрока = Итог.Добавить();
	НоваяСтрока.Раздел = Раздел;
	НоваяСтрока.Объект = Объект;
	НоваяСтрока.ОбъектХозяина = Ссылка;
	НоваяСтрока.Расхождение = Расхождение;
	НоваяСтрока.УНас = УНас;
	НоваяСтрока.ВПрограмме = ВПрограмме;

КонецПроцедуры

Функция ФорматСуммы(Сумма)
	Возврат Формат(Сумма, "ЧДЦ=2; ЧН=0");
КонецФункции

Процедура УстановитьРеквизит(Объект, Имя, Значение)

	Если Значение <> Неопределено И УЗ_Общий.ЕстьРеквизит(Объект.Метаданные().ПолноеИмя(), Имя) Тогда
		Объект[Имя] = Значение;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
