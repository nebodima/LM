//Мост в учёт программы (закрытие смены, docs/мост_в_учёт_хозяина.md): люди «Учёта занятий» связываются со
//справочниками программы — плательщик (мама, папа, бабушка) с контрагентом, педагог с сотрудником (Бухгалтерия, УНФ)
//или физическим лицом (Управление торговлей). Связи — в регистре УЗ_СвязиСУчетомХозяина: ссылка программы хранится
//без заимствования (тип «любой справочник, любой документ»). Ученики в учёт программы не уходят никогда (152-ФЗ).
//
//Справочники программы не заимствованы: имена берутся строкой после проверки метаданных, тексты запросов к ним
//разбираются при выполнении. Объекты программы записываются её же проверками (без режима загрузки) и правами
//пользователя: нет права добавлять контрагентов — понятная причина, а не обход.

#Область ПрограммныйИнтерфейс

//Роль связи плательщика (измерение «Роль» регистра): контрагент программы.
Функция РольПлательщик() Экспорт
	Возврат "Плательщик";
КонецФункции

//Роль связи педагога: сотрудник (Бухгалтерия, УНФ) или физическое лицо (Управление торговлей).
Функция РольПедагог() Экспорт
	Возврат "Педагог";
КонецФункции

//Что программа умеет для моста.
//Структура:
//  Семейство            — "УНФ" / "БП" / "УТ" / ...;
//  Контрагенты          — справочник контрагентов есть (имя "Контрагенты");
//  Партнеры             — в Управлении торговлей контрагент создаётся с партнёром;
//  СправочникПедагогов  — "Сотрудники" (Бухгалтерия, УНФ), "ФизическиеЛица" (Управление торговлей) или "";
//  СоздаватьПедагогов   — педагога можно создать у программы (физлицо УТ); сотрудника принимает на работу бухгалтер;
//  Зарплата             — начисление зарплаты программы оформляется (Бухгалтерия, УНФ).
Функция Возможности() Экспорт

	Семейство = УЗ_Среда.Паспорт().Семейство;
	Итог = Новый Структура("Семейство, Контрагенты, Партнеры, СправочникПедагогов, СоздаватьПедагогов, Зарплата",
		Семейство, ЕстьСправочник("Контрагенты"), ЕстьСправочник("Партнеры") И Семейство = "УТ", "", Ложь,
		Семейство = "БП" Или Семейство = "УНФ");
	Если (Семейство = "БП" Или Семейство = "УНФ") И ЕстьСправочник("Сотрудники") Тогда
		Итог.СправочникПедагогов = "Сотрудники";
	ИначеЕсли ЕстьСправочник("ФизическиеЛица") Тогда
		Итог.СправочникПедагогов = "ФизическиеЛица";
		Итог.СоздаватьПедагогов = Истина;
	КонецЕсли;
	Возврат Итог;

КонецФункции

//Плательщики документов денег за период и все педагоги — со связью с программой и кандидатом для связи.
//Организация — пустая: все. ТолькоНесвязанные — только люди без связи.
//ТаблицаЗначений: ФизЛицо, Роль, ИНН, ОбъектХозяина, Кандидат, Состояние (строка для формы).
Функция ЛюдиДляСвязи(Организация, Начало, Конец, ТолькоНесвязанные = Истина) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫБОР
	|		КОГДА Приход.Плательщик <> ЗНАЧЕНИЕ(Справочник.УЗ_ФизЛица.ПустаяСсылка)
	|			ТОГДА Приход.Плательщик
	|		ИНАЧЕ Приход.ФизЛицо
	|	КОНЕЦ КАК ФизЛицо,
	|	&РольПлательщик КАК Роль
	|ПОМЕСТИТЬ ВТЛюди
	|ИЗ
	|	Документ.УЗ_ПриходДенег КАК Приход
	|ГДЕ
	|	Приход.Проведен
	|	И Приход.Дата МЕЖДУ &Начало И &Конец
	|	И (&ВсеОрганизации ИЛИ Приход.Организация = &Организация)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА Расход.Получатель <> ЗНАЧЕНИЕ(Справочник.УЗ_ФизЛица.ПустаяСсылка)
	|			ТОГДА Расход.Получатель
	|		ИНАЧЕ Расход.ФизЛицо
	|	КОНЕЦ,
	|	&РольПлательщик
	|ИЗ
	|	Документ.УЗ_РасходДенег КАК Расход
	|ГДЕ
	|	Расход.Проведен
	|	И Расход.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыОпераций.КассаУченики)
	|	И Расход.Дата МЕЖДУ &Начало И &Конец
	|	И (&ВсеОрганизации ИЛИ Расход.Организация = &Организация)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ФизЛица.Ссылка,
	|	&РольПедагог
	|ИЗ
	|	Справочник.УЗ_ФизЛица КАК ФизЛица
	|ГДЕ
	|	ФизЛица.ЭтоПедагог
	|	И НЕ ФизЛица.ПометкаУдаления
	|	И НЕ ФизЛица.ЭтоГруппа
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Приход.Касса,
	|	&РольКасса
	|ИЗ
	|	Документ.УЗ_ПриходДенег КАК Приход
	|ГДЕ
	|	&СКассами
	|	И Приход.Проведен
	|	И Приход.Дата МЕЖДУ &Начало И &Конец
	|	И (&ВсеОрганизации ИЛИ Приход.Организация = &Организация)
	|	И Приход.Касса <> ЗНАЧЕНИЕ(Справочник.УЗ_Кассы.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Люди.ФизЛицо КАК ФизЛицо,
	|	Люди.Роль КАК Роль,
	|	ЕСТЬNULL(Документы.ИНН, """") КАК ИНН,
	|	Связи.ОбъектХозяина КАК ОбъектХозяина
	|ИЗ
	|	ВТЛюди КАК Люди
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УЗ_СвязиСУчетомХозяина КАК Связи
	|		ПО Люди.ФизЛицо = Связи.Объект
	|			И Люди.Роль = Связи.Роль
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УЗ_ДокументыФизЛиц КАК Документы
	|		ПО Люди.ФизЛицо = Документы.ФизЛицо
	|ГДЕ
	|	Люди.ФизЛицо <> ЗНАЧЕНИЕ(Справочник.УЗ_ФизЛица.ПустаяСсылка)
	|	И Люди.ФизЛицо <> ЗНАЧЕНИЕ(Справочник.УЗ_Кассы.ПустаяСсылка)
	|	И (НЕ &ТолькоНесвязанные
	|			ИЛИ Связи.ОбъектХозяина ЕСТЬ NULL)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Роль,
	|	Люди.ФизЛицо.Наименование";
	Запрос.УстановитьПараметр("РольПлательщик", РольПлательщик());
	Запрос.УстановитьПараметр("РольПедагог", РольПедагог());
	Запрос.УстановитьПараметр("РольКасса", РольКасса());
	Запрос.УстановитьПараметр("СКассами", ЕстьСправочник("Кассы"));
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВсеОрганизации", Не ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("ТолькоНесвязанные", ТолькоНесвязанные);
	Люди = Запрос.Выполнить().Выгрузить();
	Люди.Колонки.Добавить("Кандидат");
	Люди.Колонки.Добавить("Состояние", Новый ОписаниеТипов("Строка"));

	Возможно = Возможности();
	Для Каждого Человек Из Люди Цикл
		Если ЗначениеЗаполнено(Человек.ОбъектХозяина) Тогда
			Человек.Состояние = НСтр("ru = 'Связан'");
			Продолжить;
		КонецЕсли;
		ИмяСправочника = ИмяСправочникаРоли(Человек.Роль, Возможно);
		Если ПустаяСтрока(ИмяСправочника) Тогда
			Человек.Состояние = НСтр("ru = 'В программе нет справочника для связи'");
			Продолжить;
		КонецЕсли;
		Поиск = НайтиКандидата(ИмяСправочника, Человек.ФизЛицо, Человек.ИНН);
		Человек.Кандидат = Поиск.Кандидат;
		Человек.Состояние = ?(Человек.Роль = РольКасса() И Поиск.Кандидат <> Неопределено,
			НСтр("ru = 'Не связана: найдена по наименованию'"), Поиск.Состояние);
	КонецЦикла;
	Возврат Люди;

КонецФункции

//Ссылка программы, связанная с человеком в роли; Неопределено — связи нет.
Функция СвязанныйОбъект(ФизЛицо, Роль) Экспорт

	Запись = РегистрыСведений.УЗ_СвязиСУчетомХозяина.СоздатьМенеджерЗаписи();
	Запись.Объект = ФизЛицо;
	Запись.Роль = Роль;
	Запись.Прочитать();
	Если Запись.Выбран() И ЗначениеЗаполнено(Запись.ОбъектХозяина) Тогда
		Возврат Запись.ОбъектХозяина;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

//Связывает человека с элементом программы. Пустая строка — связано; иначе — почему нет.
Функция Связать(ФизЛицо, Роль, ОбъектХозяина) Экспорт

	ИмяСправочника = ИмяСправочникаРоли(Роль, Возможности());
	Если ПустаяСтрока(ИмяСправочника) Тогда
		Возврат НСтр("ru = 'В программе нет справочника для связи.'");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ОбъектХозяина)
		Или ОбъектХозяина.Метаданные() <> Метаданные.Справочники[ИмяСправочника] Тогда
		Возврат СтрШаблон(НСтр("ru = 'Выберите элемент справочника «%1».'"),
			Метаданные.Справочники[ИмяСправочника].Синоним);
	КонецЕсли;
	Запись = РегистрыСведений.УЗ_СвязиСУчетомХозяина.СоздатьМенеджерЗаписи();
	Запись.Объект = ФизЛицо;
	Запись.Роль = Роль;
	Запись.ОбъектХозяина = ОбъектХозяина;
	Запись.Дата = ТекущаяДатаСеанса();
	Запись.Автор = УЗ_Среда.ТекущийПользователь();
	Запись.Записать();
	Возврат "";

КонецФункции

//Снимает связь человека в роли.
Процедура Отвязать(ФизЛицо, Роль) Экспорт

	Набор = РегистрыСведений.УЗ_СвязиСУчетомХозяина.СоздатьНаборЗаписей();
	Набор.Отбор.Объект.Установить(ФизЛицо);
	Набор.Отбор.Роль.Установить(Роль);
	Набор.Записать();

КонецПроцедуры

//Создаёт элемент программы по человеку и связывает: плательщик — контрагент (физическое лицо; в Управлении
//торговлей с партнёром), педагог — физическое лицо Управления торговлей. Сотрудника Бухгалтерии и УНФ не создаём:
//его принимает на работу бухгалтер, у нас — только «Подобрать».
//Структура: Ссылка (созданное или Неопределено), Ошибка (строка; пустая — создано и связано).
Функция СоздатьУХозяина(ФизЛицо, Роль) Экспорт

	Итог = Новый Структура("Ссылка, Ошибка", Неопределено, "");
	Возможно = Возможности();
	ИмяСправочника = ИмяСправочникаРоли(Роль, Возможно);
	Если ПустаяСтрока(ИмяСправочника) Тогда
		Итог.Ошибка = НСтр("ru = 'В программе нет справочника для связи.'");
		Возврат Итог;
	КонецЕсли;
	Если Роль = РольКасса() Тогда
		Итог.Ошибка = НСтр("ru = 'Кассу заводит бухгалтер в программе, затем — «Выбрать в программе» здесь.'");
		Возврат Итог;
	КонецЕсли;
	Если Роль = РольПедагог() И Не Возможно.СоздаватьПедагогов Тогда
		Итог.Ошибка = СтрШаблон(НСтр("ru = 'Сотрудника принимает на работу бухгалтер в программе (справочник «%1»), "
			+ "затем — «Подобрать» здесь.'"), Метаданные.Справочники[ИмяСправочника].Синоним);
		Возврат Итог;
	КонецЕсли;
	Уже = СвязанныйОбъект(ФизЛицо, Роль);
	Если Уже <> Неопределено Тогда
		Итог.Ссылка = Уже;
		Возврат Итог;
	КонецЕсли;
	Причина = НетПраваДобавлять(ИмяСправочника);
	Если Возможно.Партнеры И Роль = РольПлательщик() И ПустаяСтрока(Причина) Тогда
		Причина = НетПраваДобавлять("Партнеры");
	КонецЕсли;
	Если Не ПустаяСтрока(Причина) Тогда
		Итог.Ошибка = Причина;
		Возврат Итог;
	КонецЕсли;

	ФИО = СокрЛП(ФизЛицо.Наименование);
	ИНН = ИННДляПрограммы(ФизЛицо);
	НачатьТранзакцию();
	Попытка
		Если Роль = РольПлательщик() Тогда
			Итог.Ссылка = НовыйКонтрагентФизЛицо(ФИО, ИНН);
		Иначе
			Итог.Ссылка = ЗаписатьНовый(ИмяСправочника, Новый Структура("Наименование, ИНН, ДатаРождения", ФИО, ИНН,
				ФизЛицо.ДатаРождения), Неопределено);
		КонецЕсли;
		Ошибка = Связать(ФизЛицо, Роль, Итог.Ссылка);
		Если Не ПустаяСтрока(Ошибка) Тогда
			ВызватьИсключение Ошибка;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Итог.Ссылка = Неопределено;
		Итог.Ошибка = СтрШаблон(НСтр("ru = 'Не создан в программе: %1'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Учёт занятий.Мост'"), УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Справочники.УЗ_ФизЛица, ФизЛицо, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Итог;

КонецФункции

