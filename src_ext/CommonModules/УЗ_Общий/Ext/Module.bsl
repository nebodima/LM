//Общие серверные функции «Учёта занятий»: чтение реквизитов объектов хозяина
//без заимствования реквизитов (заимствованный реквизит с чужим типом отключает
//всё расширение при обновлении конфигурации покупателя).

//Есть ли у объекта метаданных реквизит (свой или стандартный).
//  ПолноеИмя — "Справочник.Организации"; ИмяРеквизита — "ИНН".
Функция ЕстьРеквизит(ПолноеИмя, ИмяРеквизита) Экспорт

	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	//у коллекции стандартных реквизитов нет метода Найти
	Для Каждого Стандартный Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
		Если Стандартный.Имя = ИмяРеквизита Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

//Значение реквизита ссылки; если реквизита у хозяина нет или ссылка пуста —
//ЗначениеПоУмолчанию. Читается запросом, а не через ссылку: ссылка кэширует реквизиты.
Функция ЗначениеРеквизита(Ссылка, ИмяРеквизита, ЗначениеПоУмолчанию = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	ПолноеИмя = Ссылка.Метаданные().ПолноеИмя();
	Если Не ЕстьРеквизит(ПолноеИмя, ИмяРеквизита) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Таблица.%1 КАК Значение
	|ИЗ
	|	%2 КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &Ссылка", ИмяРеквизита, ПолноеИмя);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

//Ошибка, перехваченная в ветке Исключение: подробности — в журнал регистрации
//(событие «Учёт занятий.<Событие>»), краткий текст — пользователю (если Сообщать).
//  Событие — где случилось ("Абонемент.Оплаты"); Информация — ИнформацияОбОшибке();
//  Пояснение — что не получилось, для пользователя ("Не удалось посчитать оплаты").
Процедура ЗаписатьОшибку(Событие, Информация, Пояснение = "", Сообщать = Истина) Экспорт

	ЗаписьЖурналаРегистрации(НСтр("ru = 'Учёт занятий'") + "." + Событие, УровеньЖурналаРегистрации.Ошибка,
		, , ПодробноеПредставлениеОшибки(Информация));
	Если Сообщать Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(
			?(ПустаяСтрока(Пояснение), "", Пояснение + ": ") + КраткоеПредставлениеОшибки(Информация));
	КонецЕсли;

КонецПроцедуры

//Запись урока по решению В10 (как в типовых): урок нельзя провести раньше его начала.
//  Урок — ДокументОбъект.УЗ_Урок; Провести — Истина: проводить, но урок, который ещё не начался,
//  только записывается (проведённый ранее — с отменой проведения); Ложь — обычная запись.
//Возврат — Структура: Успех; Пометка — «записан без проведения: …» или ""; Текст — почему не записан:
//сообщения проведения (пересечение педагога/помещения, закрытый период, нет цены) или текст ошибки.
Функция ЗаписатьУрок(Урок, Провести) Экспорт

	Итог = Новый Структура("Успех, Пометка, Текст", Истина, "", "");
	Если Не Провести Тогда
		Режим = РежимЗаписиДокумента.Запись;
	ИначеЕсли Урок.Дата <= ТекущаяДатаСеанса() Тогда
		Режим = РежимЗаписиДокумента.Проведение;
	Иначе
		Режим = ?(Урок.Проведен, РежимЗаписиДокумента.ОтменаПроведения, РежимЗаписиДокумента.Запись);
		Итог.Пометка = НСтр("ru = 'записан без проведения: урок ещё не начался, проведите его после начала'");
	КонецЕсли;

	Попытка
		Урок.Записать(Режим);
	Исключение
		Информация = ИнформацияОбОшибке();
		//отказ проведения платформа сообщает общей фразой, причины — в сообщениях обработки проведения
		Причины = Новый Массив;
		Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			Причины.Добавить(Сообщение.Текст);
		КонецЦикла;
		Если Причины.Количество() = 0 Тогда
			Причины.Добавить(КраткоеПредставлениеОшибки(Информация));
		КонецЕсли;
		Итог.Успех = Ложь;
		Итог.Пометка = "";
		Итог.Текст = СтрСоединить(Причины, "; ");
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Учёт занятий'") + ".ЗаписьУрока", УровеньЖурналаРегистрации.Предупреждение,
			Урок.Метаданные(), Урок.Ссылка, ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
	Возврат Итог;

КонецФункции

//Действует ли безопасный режим (расширение загружено из файла — 1С включает его сама,
//или профиль безопасности). В нём не работают привилегированный режим и ИнтернетПочта.
//Спрашивать каждый раз: режим — величина момента, кэшировать нельзя.
Функция БезопасныйРежимДействует() Экспорт

	Возврат БезопасныйРежим() <> Ложь;

КонецФункции

//Готовый текст для пользователя: что сделать администратору, чтобы снять безопасный режим.
Функция КакСнятьБезопасныйРежим() Экспорт

	Возврат НСтр("ru = 'У расширения «Учёт занятий» включён безопасный режим. Администратору: Администрирование — Печатные формы, отчёты и обработки — Расширения — выбрать «Учёт занятий» — снять флажок «Безопасный режим», затем перезапустить программу.'");

КонецФункции
