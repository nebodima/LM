//Отбор «ИмяПоля = Значение» в настройках отчёта и в его пользовательской настройке.
Процедура ВключитьОтборОтчета(Компоновщик, ИмяПоля, Значение)

	Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Для Каждого ЭлементОтбора Из Компоновщик.Настройки.Отбор.Элементы Цикл
		Если ТипЗнч(ЭлементОтбора) <> Тип("ЭлементОтбораКомпоновкиДанных") Или ЭлементОтбора.ЛевоеЗначение <> Поле Тогда
			Продолжить;
		КонецЕсли;
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = Значение;
		ЭлементОтбора.Использование = Истина;
		ОтборПользователя = ПользовательскаяНастройкаОтчета(Компоновщик, ЭлементОтбора);
		Если ТипЗнч(ОтборПользователя) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			ЗаполнитьЗначенияСвойств(ОтборПользователя, ЭлементОтбора, "ВидСравнения, ПравоеЗначение, Использование");
		КонецЕсли;
		Возврат;
	КонецЦикла;

КонецПроцедуры

//Пользовательская настройка, связанная с элементом настроек отчёта (или Неопределено).
Функция ПользовательскаяНастройкаОтчета(Компоновщик, ЭлементНастроек)

	Если ЭлементНастроек = Неопределено
		Или Не ЗначениеЗаполнено(ЭлементНастроек.ИдентификаторПользовательскойНастройки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Компоновщик.ПользовательскиеНастройки.Элементы.Найти(
		ЭлементНастроек.ИдентификаторПользовательскойНастройки);

КонецФункции

#КонецОбласти
