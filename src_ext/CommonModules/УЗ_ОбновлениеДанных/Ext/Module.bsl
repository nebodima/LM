//Обновление данных учёта занятий — своя замена обработчиков обновления БСП
//(в LM — ОбновлениеИнформационнойБазыМК). Образец — координатор ПЛ_ext («Путевые листы»).
//
//Версия данных в регистре УЗ_ВерсииДанных (одна запись) — номер последнего выполненного
//шага. Координатор идёт от Версия + 1 до АктуальнаяВерсияДанных(); после каждого шага —
//контрольная точка (короткая транзакция под исключительной блокировкой регистра), так что
//прерванное обновление продолжает со следующего шага, а не с первого.
//
//Замок от параллельного запуска — отметка ОбновлениеНачато в той же записи, занимается той
//же короткой транзакцией: два сеанса занять её одновременно не могут. Пока отметка свежее
//СрокЗамка(), второй сеанс уходит молча — данные догонит первый. Упавший шаг замок не
//отпускает: повтор не чаще срока замка, а не при каждом открытии формы. Шаги идемпотентны.
//
//Кто зовёт: ПриСозданииНаСервере журнала уроков и кассового журнала (первое открытие
//раздела). Когда обновлять нечего — одно чтение регистра (тысячные доли секунды), вход
//в программу не тормозит. Внутри транзакции записи не запускается.

#Область ПрограммныйИнтерфейс

//Номер последнего шага — последний в ВыполнитьШаг.
//1 — первичное заполнение: запись настроек (организация и касса по умолчанию, периоды
//    оповещений), основная касса отмечена «Основная» (v1.0)
//2 — виды расхода (решение владельца В7): РКО «Внутренняя касса» с физ. лицом — «Выплата зарплаты»,
//    без физ. лица — «Прочий расход» (v1.1)
//3 — старые выплаты зарплаты без расчёта в основании (В9): на каждую — проведённый расчёт-перенос; уроки
//    проведённых расчётов — в регистр УЗ_УрокиВРасчетахЗарплаты (v1.1)
//4 — граница просмотра кассы менеджера (S04) в регистре УЗ_ГраницаПросмотраКассы вместо параметра сеанса
//    УЗ_НачалоПросмотраКассы: запись должна быть сразу после обновления — без неё менеджер кассу не видит
//    (v1.1)
//5 — R24: доплаты и зафиксированные начисления педагогу из уроков — в документы «Начисление педагогам» на
//    основании урока (урок больше не хранит начислений; перепроведение урока их бы потеряло) (v1.1)
Функция АктуальнаяВерсияДанных() Экспорт

	Возврат 5;

КонецФункции

//Единая точка догона данных до версии расширения. Ленивая, идемпотентная, никогда не
//роняет вызвавшую форму: ошибка шага — в журнал регистрации и в ресурс ОшибкиОбновления.
Процедура ОбновитьДанныеПриНеобходимости() Экспорт

	Попытка
		Если ВерсияДанных() >= АктуальнаяВерсияДанных() Тогда
			Возврат;
		КонецЕсли;
		Если ТранзакцияАктивна() Тогда
			Возврат;
		КонецЕсли;
		//шаги пишут общие настройки, кассы, расходы и зарплату — права руководителя и администратора;
		//менеджер данные не догоняет (в безопасном режиме расширения привилегированный режим не действует)
		Если Не МожноОбновлятьДанные() Тогда
			Возврат;
		КонецЕсли;

		//без безопасного режима — привилегированно
		УстановитьПривилегированныйРежим(Истина);

		Состояние = ЗанятьЗамок();
		Если Состояние = Неопределено Тогда
			Возврат;
		КонецЕсли;

		Номер = Состояние.Версия + 1;
		Пока Номер <= АктуальнаяВерсияДанных() Цикл
			ВыполнитьШаг(Номер);
			ОтметитьВыполненныйШаг(Номер, Номер = АктуальнаяВерсияДанных());
			Номер = Номер + 1;
		КонецЦикла;

	Исключение
		Подробно = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Учёт занятий.Обновление данных'"),
			УровеньЖурналаРегистрации.Ошибка, , , Подробно);
		Попытка
			ЗаписатьОшибку(Подробно);
		Исключение
			//честно: журнал регистрации уже получил ошибку строкой выше — регистр версий не обязателен
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры

//Что помешало обновить данные — текст для пользователя; пусто, если всё в порядке
//(или обновление прямо сейчас идёт в другом сеансе). Зовётся формой после
//ОбновитьДанныеПриНеобходимости: отказ не должен теряться молча.
Функция ПроблемаОбновления() Экспорт

	Если ВерсияДанных() >= АктуальнаяВерсияДанных() Тогда
		Возврат "";
	КонецЕсли;
	Если Не МожноОбновлятьДанные() Тогда
		Возврат НСтр(
			"ru = 'Учёт занятий ждёт подготовки своих данных после обновления: руководителю или администратору открыть "
			+ "журнал уроков.'");
	КонецЕсли;
	Если УЗ_Общий.БезопасныйРежимДействует() Тогда
		Возврат НСтр("ru = 'Учёт занятий не смог подготовить свои данные.'") + " " + УЗ_Общий.КакСнятьБезопасныйРежим();
	КонецЕсли;
	Ошибки = СостояниеОбновления().Ошибки;
	Если ПустаяСтрока(Ошибки) Тогда
		Возврат "";
	КонецЕсли;
	Возврат НСтр("ru = 'Учёт занятий не смог подготовить свои данные:'") + " "
		+ СтрПолучитьСтроку(Ошибки, 1) + " "
			+ НСтр("ru = 'Подробности — в журнале регистрации, событие «Учёт занятий.Обновление данных».'");

КонецФункции

//Состояние для проверок и тестов: Структура(Версия, ОбновлениеНачато, Ошибки).
Функция СостояниеОбновления() Экспорт

	Состояние = Новый Структура("Версия, ОбновлениеНачато, Ошибки", 0, '00010101', "");
	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.УЗ_ВерсииДанных.СоздатьМенеджерЗаписи();
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Состояние.Версия = Запись.Версия;
		Состояние.ОбновлениеНачато = Запись.ОбновлениеНачато;
		Состояние.Ошибки = Запись.ОшибкиОбновления;
	КонецЕсли;
	Возврат Состояние;

КонецФункции

#Область Шаги

Процедура ВыполнитьШаг(Номер)

	Если Номер = 1 Тогда
		ШагПервичногоЗаполнения();	//v1.0
	ИначеЕсли Номер = 2 Тогда
		ШагВидыРасхода();	//v1.1
	ИначеЕсли Номер = 3 Тогда
		ШагРасчетыСтарыхВыплат();	//v1.1
	ИначеЕсли Номер = 4 Тогда
		УЗ_ДатыЗапрета.ОбновитьГраницуПросмотраКассы();	//v1.1, повторный вызов в тот же день ничего не пишет
	ИначеЕсли Номер = 5 Тогда
		ШагДоплатыУроков();	//v1.1
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Шага обновления данных № %1 нет'"), Номер);
	КонецЕсли;

КонецПроцедуры

//Шаг 1. Запись настроек и основная касса. Заполняет только пустое: повторный проход
//и настройки, уже введённые пользователем, не трогает.
Процедура ШагПервичногоЗаполнения()

	ОсновнаяКасса = Справочники.УЗ_Кассы.ОсновнаяКасса;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Кассы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УЗ_Кассы КАК Кассы
	|ГДЕ
	|	Кассы.Основная
	|	И НЕ Кассы.ПометкаУдаления";
	Если Запрос.Выполнить().Пустой() Тогда
		Касса = ОсновнаяКасса.ПолучитьОбъект();
		Касса.Основная = Истина;
		Касса.Записать();
	КонецЕсли;

	Настройки = РегистрыСведений.УЗ_Настройки.Настройки();
	Значения = Новый Структура;
	Если НЕ ЗначениеЗаполнено(Настройки.Касса) Тогда
		Значения.Вставить("Касса", ОсновнаяКасса);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Настройки.Организация) Тогда
		Организация = ПерваяОрганизация();
		Если ЗначениеЗаполнено(Организация) Тогда
			Значения.Вставить("Организация", Организация);
		КонецЕсли;
	КонецЕсли;
	Если Настройки.ПериодОповещения = 0 Тогда
		//одно значение с формой настроек и показом
		Значения.Вставить("ПериодОповещения", УЗ_ОбщийКлиентСервер.ПериодОповещенияПоУмолчанию());
	КонецЕсли;
	Если Настройки.ОповещатьОЗадолженности = 0 Тогда
		Значения.Вставить("ОповещатьОЗадолженности", 2);	//2 дня
	КонецЕсли;
	Если Значения.Количество() > 0 Тогда
		РегистрыСведений.УЗ_Настройки.ЗаписатьНастройки(Значения);
	КонецЕсли;

КонецПроцедуры

//Шаг 2. Раньше любой РКО «Внутренняя касса» был выплатой зарплаты: аренда на педагога гасила его долг,
//без физ. лица в долг писалась «выплата» пустому педагогу. Теперь выплата — вид «Выплата зарплаты»,
//остальное — «Прочий расход» (решение В7). Старые РКО: с физ. лицом — выплата (движения те же, долг
//не меняется), без физ. лица — прочий расход, его строка в УЗ_РасчетыПоЗарплате убирается (как дало бы
//перепроведение). Раздел кассы у обоих видов прежний — «Внутренняя касса», движения кассы не трогаем.
//Документы пишутся в режиме загрузки: мимо дат запрета и без перепроведения. Идемпотентен: берёт только
//РКО, оставшиеся «Внутренней кассой».
Процедура ШагВидыРасхода()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Расходы.Ссылка КАК Ссылка,
	|	Расходы.ФизЛицо КАК ФизЛицо
	|ИЗ
	|	Документ.УЗ_РасходДенег КАК Расходы
	|ГДЕ
	|	Расходы.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыОпераций.ВнутренняяКасса)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭтоВыплата = ЗначениеЗаполнено(Выборка.ФизЛицо);
		НачатьТранзакцию();
		Попытка
			Документ = Выборка.Ссылка.ПолучитьОбъект();
			Документ.ВидОперации = ?(ЭтоВыплата, Перечисления.УЗ_ВидыОпераций.ВыплатаЗарплаты,
				Перечисления.УЗ_ВидыОпераций.ПрочийРасход);
			Документ.ОбменДанными.Загрузка = Истина;
			Документ.Записать();
			Если НЕ ЭтоВыплата Тогда
				Набор = РегистрыНакопления.УЗ_РасчетыПоЗарплате.СоздатьНаборЗаписей();
				Набор.Отбор.Регистратор.Установить(Выборка.Ссылка);
				Набор.ОбменДанными.Загрузка = Истина;
				Набор.Записать();
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

//Шаг 3. С версии 1.1 выплата зарплаты проводится только на основании проведённого расчёта (В9). Старые выплаты
//(шаг 2 и прежние версии) расчёта в основании не имеют — перепроведение такого РКО (дата запрета снята, правка
//комментария) отказывало бы. Как в типовых при вводе нового правила учёта — обработчик обновления приводит старые
//данные к нему. Выплата, у которой есть проведённый расчёт того же педагога с этим РКО в реквизите «РКО» (расчёт
//версии 1.0), получает его в основание. Иначе создаётся проведённый расчёт-перенос того же педагога, организации и
//кассы на сумму выплаты, и в него попадают начисления, которые эта выплата оплатила (R01 ревью 28.09): невыплаченные
//начисления педагога в организации по дату выплаты (Документы.УЗ_РасчетЗарплаты.НевыплаченныеНачисления) по
//порядку дат — целиком, последнее — на остаток суммы; сумма сверх начислений (аванс) — строкой без документа.
//Прежде перенос был одной строкой без документа, и новый расчёт за тот же период подбирал оплаченные старой
//выплатой уроки второй раз (начислено 700, выплачено 700 — после обновления можно было выплатить ещё 700).
//Выплаты — по порядку дат: перенос ранней выплаты уже виден следующей. Движения выплаты не меняются, расчёт-перенос
//движений долга не пишет (ведомость переноса — только основание), его уроки фиксируются регистром
//УЗ_УрокиВРасчетахЗарплаты (ниже). Идемпотентен: берёт выплаты без основания; каждая — под блокировкой и
//перечитанная в транзакции переноса (R23: второй координатор, взявший просроченный замок, уже привязанную
//выплату пропускает, второго переноса не создаёт).
Процедура ШагРасчетыСтарыхВыплат() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Выплаты.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УЗ_РасходДенег КАК Выплаты
	|ГДЕ
	|	Выплаты.Проведен
	|	И Выплаты.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыОпераций.ВыплатаЗарплаты)
	|	И (Выплаты.ДокументОснования = НЕОПРЕДЕЛЕНО
	|			ИЛИ НЕ Выплаты.ДокументОснования ССЫЛКА Документ.УЗ_РасчетЗарплаты
	|			ИЛИ Выплаты.ДокументОснования = ЗНАЧЕНИЕ(Документ.УЗ_РасчетЗарплаты.ПустаяСсылка))
	|	И Выплаты.ФизЛицо <> ЗНАЧЕНИЕ(Справочник.УЗ_ФизЛица.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Выплаты.Дата";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НачатьТранзакцию();
		Попытка
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Документ.УЗ_РасходДенег");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Блокировка.Заблокировать();
			Выплата = Выборка.Ссылка.ПолучитьОбъект();
			//перечитана под блокировкой: основание уже есть (другой координатор успел) — пропуск
			Если НЕ (ТипЗнч(Выплата.ДокументОснования) = Тип("ДокументСсылка.УЗ_РасчетЗарплаты")
				И ЗначениеЗаполнено(Выплата.ДокументОснования)) Тогда
				ПривязатьСтаруюВыплату(Выплата);
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;

	//уроки проведённых расчётов — в регистр УЗ_УрокиВРасчетахЗарплаты (как пишет проведение расчёта с 1.1):
	//урок из ведомости, проведённой до обновления, тоже не отменяется и не меняет начисление
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Расчеты.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УЗ_РасчетЗарплаты КАК Расчеты
	|ГДЕ
	|	Расчеты.Проведен";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Расчет = Выборка.Ссылка.ПолучитьОбъект();
		Набор = РегистрыСведений.УЗ_УрокиВРасчетахЗарплаты.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Выборка.Ссылка);
		Расчет.ЗаписатьУрокиВРасчете(Набор, Расчет);
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Записать();
	КонецЦикла;

КонецПроцедуры

//Шаг 5 (R24 ревью 28.09). До версии 1.1 начисления педагогу жили в табличной части урока «Начисления педагогу»:
//строка по ставке (комментарий с «#»), ручные доплаты (без «#») и зафиксированные «Не изменять». Теперь урок
//начислений не хранит (менеджер читал их запросом): проведение пишет в регистр только начисление по ставке, а
//доплаты — документ «Начисление педагогам» на основании урока. Табличной части больше нет, но прежние доплаты
//остались движениями урока в УЗ_РасчетыПоЗарплате — перепроведение урока стёрло бы их. Шаг переносит каждую такую
//строку движений урока (без «#» или с «Не изменять») в проведённый документ «Начисление педагогам» на основании
//урока — дата, педагог, организация, комментарий и сумма строки; движения урока остаются только по ставке. У
//зафиксированного начисления по ставке («#» и «Не изменять») ставка урока очищается: урок не начислит второй раз,
//зафиксированная сумма — в документе. Долг педагогу не меняется. Документы и наборы — загрузкой (мимо дат запрета).
//Уроки, вошедшие в расчёт зарплаты (УЗ_УрокиВРасчетахЗарплаты), не трогаются: ведомость уже выплатила их
//начисление целиком по уроку, перенос разделил бы его и следующий расчёт выплатил бы доплату второй раз; такие уроки
//— в журнале регистрации предупреждением (их начисление менять и так нельзя — В9). Идемпотентен: берёт только
//строки, ещё оставшиеся у урока.
Процедура ШагДоплатыУроков() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Движения.Регистратор КАК Урок,
	|	Движения.Период КАК Период,
	|	Движения.Педагог КАК Педагог,
	|	Движения.Организация КАК Организация,
	|	Движения.Сумма КАК Сумма,
	|	Движения.Комментарий КАК Комментарий,
	|	Движения.НеИзменять КАК НеИзменять,
	|	ВЫБОР
	|		КОГДА Движения.Регистратор В
	|				(ВЫБРАТЬ
	|					Уроки.Урок
	|				ИЗ
	|					РегистрСведений.УЗ_УрокиВРасчетахЗарплаты КАК Уроки
	|				ГДЕ
	|					Уроки.Активность)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ВРасчете
	|ИЗ
	|	РегистрНакопления.УЗ_РасчетыПоЗарплате КАК Движения
	|ГДЕ
	|	Движения.Регистратор ССЫЛКА Документ.УЗ_Урок
	|	И Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И Движения.Активность
	|	И (Движения.НеИзменять
	|			ИЛИ НЕ Движения.Комментарий ПОДОБНО ""%#%"")
	|
	|УПОРЯДОЧИТЬ ПО
	|	Движения.Регистратор,
	|	Движения.НомерСтроки
	|ИТОГИ ПО
	|	Урок";
	ПоУрокам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ПоУрокам.Следующий() Цикл
		Строки = ПоУрокам.Выбрать();
		Если Не Строки.Следующий() Тогда
			Продолжить;
		КонецЕсли;
		Если Строки.ВРасчете Тогда
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Учёт занятий.Обновление данных'"),
				УровеньЖурналаРегистрации.Предупреждение, , ПоУрокам.Урок,
				НСтр("ru = 'Доплаты педагогу в уроке, вошедшем в расчёт зарплаты, оставлены движениями урока (шаг 5): "
				+ "урок не перепроводить с изменением начисления.'"));
			Продолжить;
		КонецЕсли;
		НачатьТранзакцию();
		Попытка
			ПеренестиДоплатыУрока(ПоУрокам.Урок, Строки);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

//Строки — выборка строк одного урока, спозиционированная на первой (шаг 5).
Процедура ПеренестиДоплатыУрока(Урок, Строки)

	Доплата = Документы.УЗ_НачисленияПедагогам.СоздатьДокумент();
	Доплата.Дата = Строки.Период;
	Доплата.Педагог = Строки.Педагог;
	Доплата.Организация = Строки.Организация;
	Доплата.ДокументОснования = Урок;
	Доплата.Комментарий = НСтр("ru = 'Перенос: доплаты урока до версии 1.1 (обновление данных)'");
	Зафиксировано = Ложь;
	Пока Истина Цикл
		Строка = Доплата.НачисленияПедагогам.Добавить();
		Строка.Комментарий = Строки.Комментарий;
		Строка.Сумма = Строки.Сумма;
		Зафиксировано = Зафиксировано Или СтрНайти(Строки.Комментарий, "#") > 0;
		Если Не Строки.Следующий() Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Доплата.СуммаДокумента = Доплата.НачисленияПедагогам.Итог("Сумма");
	Доплата.ОбменДанными.Загрузка = Истина;
	Доплата.Проведен = Истина;
	Доплата.Записать();
	//движения — как у проведённого документа (ОбработкаПроведения «Начисления педагогам»)
	Набор = РегистрыНакопления.УЗ_РасчетыПоЗарплате.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Доплата.Ссылка);
	Для Каждого Строка Из Доплата.НачисленияПедагогам Цикл
		Движение = Набор.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Доплата.Дата;
		Движение.Педагог = Доплата.Педагог;
		Движение.Организация = Доплата.Организация;
		Движение.Сумма = Строка.Сумма;
		Движение.Комментарий = Строка.Комментарий;
	КонецЦикла;
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();

	//у урока — только начисление по ставке
	Набор = РегистрыНакопления.УЗ_РасчетыПоЗарплате.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Урок);
	Набор.Прочитать();
	Индекс = Набор.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Движение = Набор[Индекс];
		Если Движение.ВидДвижения = ВидДвиженияНакопления.Приход
			И (Движение.НеИзменять Или СтрНайти(Движение.Комментарий, "#") = 0) Тогда
			Набор.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();

	Если Зафиксировано Тогда
		УрокОбъект = Урок.ПолучитьОбъект();
		УрокОбъект.СтавкаПедагога = Справочники.УЗ_СтавкиПедагогов.ПустаяСсылка();
		УрокОбъект.ОбменДанными.Загрузка = Истина;
		УрокОбъект.Записать();
	КонецЕсли;

КонецПроцедуры

//Основание старой выплаты (в транзакции ШагРасчетыСтарыхВыплат, выплата заблокирована): расчёт версии 1.0 с этим
//РКО в реквизите «РКО» или новый расчёт-перенос с начислениями, которые выплата оплатила (см. шаг 3).
Процедура ПривязатьСтаруюВыплату(Выплата)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Расчеты.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УЗ_РасчетЗарплаты КАК Расчеты
	|ГДЕ
	|	Расчеты.РКО = &Выплата
	|	И Расчеты.Проведен
	|	И Расчеты.Педагог = &Педагог
	|
	|УПОРЯДОЧИТЬ ПО
	|	Расчеты.Дата";
	Запрос.УстановитьПараметр("Выплата", Выплата.Ссылка);
	Запрос.УстановитьПараметр("Педагог", Выплата.ФизЛицо);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Выплата.ДокументОснования = Выборка.Ссылка;
		Выплата.ОбменДанными.Загрузка = Истина;
		Выплата.Записать();
		Возврат;
	КонецЕсли;

	Расчет = Документы.УЗ_РасчетЗарплаты.СоздатьДокумент();
	Расчет.Дата = Выплата.Дата;
	Расчет.Педагог = Выплата.ФизЛицо;
	Расчет.Организация = Выплата.Организация;
	Расчет.Касса = Выплата.Касса;
	Расчет.ДатаНачала = НачалоДня(Выплата.Дата);
	Расчет.ДатаОкончания = НачалоДня(Выплата.Дата);
	Расчет.РКО = Выплата.Ссылка;
	Расчет.Комментарий = НСтр("ru = 'Перенос: выплата до версии 1.1 (обновление данных)'");
	//начисления, оплаченные выплатой: невыплаченные на дату выплаты, по порядку дат
	Осталось = Выплата.СуммаДокумента;
	Начисления = Документы.УЗ_РасчетЗарплаты.НевыплаченныеНачисления(Выплата.ФизЛицо, Выплата.Организация,
		'00010101', Выплата.Дата);
	Для Каждого Начисление Из Начисления Цикл
		Если Осталось <= 0 Тогда
			Прервать;
		КонецЕсли;
		Если Начисление.Сумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Оплачено = Мин(Начисление.Сумма, Осталось);
		СтрокаДД = Расчет.ДД.Добавить();
		СтрокаДД.Документ = Начисление.Документ;
		СтрокаДД.Комментарий = ?(Оплачено < Начисление.Сумма,
			СтрШаблон(НСтр("ru = 'Выплата %1 до версии 1.1: %2 из %3'"), Выплата.Ссылка,
				Формат(Оплачено, "ЧДЦ=2; ЧН=0"),
				Формат(Начисление.Сумма, "ЧДЦ=2; ЧН=0")),
			СтрШаблон(НСтр("ru = 'Выплата %1 до версии 1.1'"), Выплата.Ссылка));
		СтрокаДД.Начисление = Оплачено;
		СтрокаДД.КОплате = Оплачено;
		Осталось = Осталось - Оплачено;
	КонецЦикла;
	Если Осталось > 0 Тогда
		СтрокаДД = Расчет.ДД.Добавить();
		СтрокаДД.Комментарий =
			СтрШаблон(НСтр("ru = 'Выплата %1 до версии 1.1 сверх начислений (аванс)'"), Выплата.Ссылка);
		СтрокаДД.Начисление = Осталось;
		СтрокаДД.КОплате = Осталось;
	КонецЕсли;
	Расчет.СуммаДокумента = Выплата.СуммаДокумента;
	//загрузкой: мимо дат запрета; движения — как у проведённого расчёта (ЗП приход и расход, долг не меняют)
	Расчет.ОбменДанными.Загрузка = Истина;
	Расчет.Проведен = Истина;
	Расчет.Записать();
	Набор = РегистрыНакопления.УЗ_РасчетыПоЗарплате.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Установить(Расчет.Ссылка);
	Для Каждого Вид Из ВидыДвижения() Цикл
		Движение = Набор.Добавить();
		Движение.ВидДвижения = Вид;
		Движение.Период = КонецДня(Расчет.ДатаОкончания);
		Движение.Педагог = Расчет.Педагог;
		Движение.Организация = Расчет.Организация;
		Движение.ЗП = Расчет.СуммаДокумента;
	КонецЦикла;
	Набор.ОбменДанными.Загрузка = Истина;
	Набор.Записать();
	Выплата.ДокументОснования = Расчет.Ссылка;
	Выплата.ОбменДанными.Загрузка = Истина;
	Выплата.Записать();

КонецПроцедуры

Функция ВидыДвижения()
	Виды = Новый Массив;
	Виды.Добавить(ВидДвиженияНакопления.Приход);
	Виды.Добавить(ВидДвиженияНакопления.Расход);
	Возврат Виды;
КонецФункции

//Организация хозяина: у УНФ/БП/УТ справочник Организации есть у всех, берём первую
//непомеченную по наименованию (у малого бизнеса она обычно одна).
Функция ПерваяОрганизация()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организации.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Организации.ПустаяСсылка();

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//Хватит ли прав текущего пользователя на шаги обновления: запись настроек и версии данных есть у
//руководителя (УЗ_Руководитель) и администратора, у менеджера (УЗ_ОсновнаяРоль) — нет.
Функция МожноОбновлятьДанные()

	Возврат ПравоДоступа("Изменение", Метаданные.РегистрыСведений.УЗ_Настройки)
		И ПравоДоступа("Изменение", Метаданные.РегистрыСведений.УЗ_ВерсииДанных);

КонецФункции

#Область Замок

//Срок, после которого отметка «обновление начато» считается брошенной (сеанс упал).
Функция СрокЗамка()

	Возврат 600;

КонецФункции

Функция ВерсияДанных()

	//быстрый путь: одно чтение без блокировок
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Версии.Версия КАК Версия
	|ИЗ
	|	РегистрСведений.УЗ_ВерсииДанных КАК Версии";
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Версия, 0);

КонецФункции

Процедура ЗаписатьСостояние(Состояние)

	Запись = РегистрыСведений.УЗ_ВерсииДанных.СоздатьМенеджерЗаписи();
	Запись.Версия = Состояние.Версия;
	Запись.ОбновлениеНачато = Состояние.ОбновлениеНачато;
	Запись.ОшибкиОбновления = Лев(Состояние.Ошибки, 1000);
	Запись.Записать();

КонецПроцедуры

//Все правки состояния — короткой транзакцией под исключительной блокировкой: два сеанса
//не прочитают одно состояние и не запишут каждый своё поверх чужого.
Функция ЗаблокироватьСостояние()

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.УЗ_ВерсииДанных");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Возврат СостояниеОбновления();	//перечитываем под блокировкой

КонецФункции

//Неопределено — догонять нечего или замок держит другой сеанс; иначе состояние.
Функция ЗанятьЗамок()

	Занято = Неопределено;
	НачатьТранзакцию();
	Попытка
		Состояние = ЗаблокироватьСостояние();
		Если Состояние.Версия < АктуальнаяВерсияДанных() И НЕ ЗамокСвеж(Состояние) Тогда
			Состояние.ОбновлениеНачато = ТекущаяУниверсальнаяДата();
			ЗаписатьСостояние(Состояние);
			Занято = Состояние;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Занято;

КонецФункции

Функция ЗамокСвеж(Состояние)

	Если НЕ ЗначениеЗаполнено(Состояние.ОбновлениеНачато) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Состояние.ОбновлениеНачато > ТекущаяУниверсальнаяДата() - СрокЗамка();

КонецФункции

//Контрольная точка: номер шага пишется атомарно; последний шаг отпускает замок,
//промежуточный — продлевает; ошибка прошлого прогона стирается.
Процедура ОтметитьВыполненныйШаг(Номер, ЭтоПоследний)

	НачатьТранзакцию();
	Попытка
		Состояние = ЗаблокироватьСостояние();
		Состояние.Версия = Макс(Состояние.Версия, Номер);
		Состояние.ОбновлениеНачато = ?(ЭтоПоследний, '00010101', ТекущаяУниверсальнаяДата());
		Состояние.Ошибки = "";
		ЗаписатьСостояние(Состояние);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

//Текст ошибки упавшего шага — в запись версий; замок остаётся (повтор не раньше срока).
Процедура ЗаписатьОшибку(Текст)

	НачатьТранзакцию();
	Попытка
		Состояние = ЗаблокироватьСостояние();
		Состояние.Ошибки = Текст;
		ЗаписатьСостояние(Состояние);
