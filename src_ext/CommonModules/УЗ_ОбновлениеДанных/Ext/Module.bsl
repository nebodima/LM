//Обновление данных учёта занятий — своя замена обработчиков обновления БСП
//(в LM — ОбновлениеИнформационнойБазыМК). Образец — координатор ПЛ_ext («Путевые листы»).
//
//Версия данных в регистре УЗ_ВерсииДанных (одна запись) — номер последнего выполненного
//шага. Координатор идёт от Версия + 1 до АктуальнаяВерсияДанных(); после каждого шага —
//контрольная точка (короткая транзакция под исключительной блокировкой регистра), так что
//прерванное обновление продолжает со следующего шага, а не с первого.
//
//Замок от параллельного запуска — отметка ОбновлениеНачато в той же записи, занимается той
//же короткой транзакцией: два сеанса занять её одновременно не могут. Пока отметка свежее
//СрокЗамка(), второй сеанс уходит молча — данные догонит первый. Упавший шаг замок не
//отпускает: повтор не чаще срока замка, а не при каждом открытии формы. Шаги идемпотентны.
//
//Кто зовёт: ПриСозданииНаСервере журнала уроков и кассового журнала (первое открытие
//раздела). Когда обновлять нечего — одно чтение регистра (тысячные доли секунды), вход
//в программу не тормозит. Внутри транзакции записи не запускается.

//Номер последнего шага — последний в ВыполнитьШаг.
//1 — первичное заполнение: запись настроек (организация и касса по умолчанию, периоды
//    оповещений), основная касса отмечена «Основная» (v1.0)
//2 — виды расхода (решение владельца В7): РКО «Внутренняя касса» с физ. лицом — «Выплата зарплаты»,
//    без физ. лица — «Прочий расход» (v1.1)
Функция АктуальнаяВерсияДанных() Экспорт

	Возврат 2;

КонецФункции

//Единая точка догона данных до версии расширения. Ленивая, идемпотентная, никогда не
//роняет вызвавшую форму: ошибка шага — в журнал регистрации и в ресурс ОшибкиОбновления.
Процедура ОбновитьДанныеПриНеобходимости() Экспорт

	Попытка
		Если ВерсияДанных() >= АктуальнаяВерсияДанных() Тогда
			Возврат;
		КонецЕсли;
		Если ТранзакцияАктивна() Тогда
			Возврат;
		КонецЕсли;

		//шаги пишут настройки и справочники; сотрудник с урезанной ролью тоже может
		//открыть журнал первым — шаги безопасны, выполняем привилегированно
		УстановитьПривилегированныйРежим(Истина);

		Состояние = ЗанятьЗамок();
		Если Состояние = Неопределено Тогда
			Возврат;
		КонецЕсли;

		Номер = Состояние.Версия + 1;
		Пока Номер <= АктуальнаяВерсияДанных() Цикл
			ВыполнитьШаг(Номер);
			ОтметитьВыполненныйШаг(Номер, Номер = АктуальнаяВерсияДанных());
			Номер = Номер + 1;
		КонецЦикла;

	Исключение
		Подробно = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Учёт занятий.Обновление данных'"),
			УровеньЖурналаРегистрации.Ошибка, , , Подробно);
		Попытка
			ЗаписатьОшибку(Подробно);
		Исключение
			//журнал регистрации уже получил ошибку — регистр версий не обязателен
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры

//Что помешало обновить данные — текст для пользователя; пусто, если всё в порядке
//(или обновление прямо сейчас идёт в другом сеансе). Зовётся формой после
//ОбновитьДанныеПриНеобходимости: отказ не должен теряться молча.
Функция ПроблемаОбновления() Экспорт

	Если ВерсияДанных() >= АктуальнаяВерсияДанных() Тогда
		Возврат "";
	КонецЕсли;
	Если УЗ_Общий.БезопасныйРежимДействует() Тогда
		Возврат НСтр("ru = 'Учёт занятий не смог подготовить свои данные.'") + " " + УЗ_Общий.КакСнятьБезопасныйРежим();
	КонецЕсли;
	Ошибки = СостояниеОбновления().Ошибки;
	Если ПустаяСтрока(Ошибки) Тогда
		Возврат "";
	КонецЕсли;
	Возврат НСтр("ru = 'Учёт занятий не смог подготовить свои данные:'") + " "
		+ СтрПолучитьСтроку(Ошибки, 1) + " " + НСтр("ru = 'Подробности — в журнале регистрации, событие «Учёт занятий.Обновление данных».'");

КонецФункции

//Состояние для проверок и тестов: Структура(Версия, ОбновлениеНачато, Ошибки).
Функция СостояниеОбновления() Экспорт

	Состояние = Новый Структура("Версия, ОбновлениеНачато, Ошибки", 0, '00010101', "");
	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.УЗ_ВерсииДанных.СоздатьМенеджерЗаписи();
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Состояние.Версия = Запись.Версия;
		Состояние.ОбновлениеНачато = Запись.ОбновлениеНачато;
		Состояние.Ошибки = Запись.ОшибкиОбновления;
	КонецЕсли;
	Возврат Состояние;

КонецФункции

#Область Шаги

Процедура ВыполнитьШаг(Номер)

	Если Номер = 1 Тогда
		ШагПервичногоЗаполнения();	//v1.0
	ИначеЕсли Номер = 2 Тогда
		ШагВидыРасхода();	//v1.1
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Шага обновления данных № %1 нет'"), Номер);
	КонецЕсли;

КонецПроцедуры

//Шаг 1. Запись настроек и основная касса. Заполняет только пустое: повторный проход
//и настройки, уже введённые пользователем, не трогает.
Процедура ШагПервичногоЗаполнения()

	ОсновнаяКасса = Справочники.УЗ_Кассы.ОсновнаяКасса;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Кассы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УЗ_Кассы КАК Кассы
	|ГДЕ
	|	Кассы.Основная
	|	И НЕ Кассы.ПометкаУдаления";
	Если Запрос.Выполнить().Пустой() Тогда
		Касса = ОсновнаяКасса.ПолучитьОбъект();
		Касса.Основная = Истина;
		Касса.Записать();
	КонецЕсли;

	Настройки = РегистрыСведений.УЗ_Настройки.Настройки();
	Значения = Новый Структура;
	Если НЕ ЗначениеЗаполнено(Настройки.Касса) Тогда
		Значения.Вставить("Касса", ОсновнаяКасса);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Настройки.Организация) Тогда
		Организация = ПерваяОрганизация();
		Если ЗначениеЗаполнено(Организация) Тогда
			Значения.Вставить("Организация", Организация);
		КонецЕсли;
	КонецЕсли;
	Если Настройки.ПериодОповещения = 0 Тогда
		Значения.Вставить("ПериодОповещения", 300);	//5 минут, как в форме настроек
	КонецЕсли;
	Если Настройки.ОповещатьОЗадолженности = 0 Тогда
		Значения.Вставить("ОповещатьОЗадолженности", 2);	//2 дня
	КонецЕсли;
	Если Значения.Количество() > 0 Тогда
		РегистрыСведений.УЗ_Настройки.ЗаписатьНастройки(Значения);
	КонецЕсли;

КонецПроцедуры

//Шаг 2. Раньше любой РКО «Внутренняя касса» был выплатой зарплаты: аренда на педагога гасила его долг,
//без физ. лица в долг писалась «выплата» пустому педагогу. Теперь выплата — вид «Выплата зарплаты»,
//остальное — «Прочий расход» (решение В7). Старые РКО: с физ. лицом — выплата (движения те же, долг
//не меняется), без физ. лица — прочий расход, его строка в УЗ_РасчетыПоЗарплате убирается (как дало бы
//перепроведение). Раздел кассы у обоих видов прежний — «Внутренняя касса», движения кассы не трогаем.
//Документы пишутся в режиме загрузки: мимо дат запрета и без перепроведения. Идемпотентен: берёт только
//РКО, оставшиеся «Внутренней кассой».
Процедура ШагВидыРасхода()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Расходы.Ссылка КАК Ссылка,
	|	Расходы.ФизЛицо КАК ФизЛицо
	|ИЗ
	|	Документ.УЗ_РасходДенег КАК Расходы
	|ГДЕ
	|	Расходы.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыОпераций.ВнутренняяКасса)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭтоВыплата = ЗначениеЗаполнено(Выборка.ФизЛицо);
		НачатьТранзакцию();
		Попытка
			Документ = Выборка.Ссылка.ПолучитьОбъект();
			Документ.ВидОперации = ?(ЭтоВыплата, Перечисления.УЗ_ВидыОпераций.ВыплатаЗарплаты,
				Перечисления.УЗ_ВидыОпераций.ПрочийРасход);
			Документ.ОбменДанными.Загрузка = Истина;
			Документ.Записать();
			Если НЕ ЭтоВыплата Тогда
				Набор = РегистрыНакопления.УЗ_РасчетыПоЗарплате.СоздатьНаборЗаписей();
				Набор.Отбор.Регистратор.Установить(Выборка.Ссылка);
				Набор.ОбменДанными.Загрузка = Истина;
				Набор.Записать();
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

//Организация хозяина: у УНФ/БП/УТ справочник Организации есть у всех, берём первую
//непомеченную по наименованию (у малого бизнеса она обычно одна).
Функция ПерваяОрганизация()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организации.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Организации.ПустаяСсылка();

КонецФункции

#КонецОбласти

#Область Замок

//Срок, после которого отметка «обновление начато» считается брошенной (сеанс упал).
Функция СрокЗамка()

	Возврат 600;

КонецФункции

Функция ВерсияДанных()

	//быстрый путь: одно чтение без блокировок
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Версии.Версия КАК Версия
	|ИЗ
	|	РегистрСведений.УЗ_ВерсииДанных КАК Версии";
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Версия, 0);

КонецФункции

Процедура ЗаписатьСостояние(Состояние)

	Запись = РегистрыСведений.УЗ_ВерсииДанных.СоздатьМенеджерЗаписи();
	Запись.Версия = Состояние.Версия;
	Запись.ОбновлениеНачато = Состояние.ОбновлениеНачато;
	Запись.ОшибкиОбновления = Лев(Состояние.Ошибки, 1000);
	Запись.Записать();

КонецПроцедуры

//Все правки состояния — короткой транзакцией под исключительной блокировкой: два сеанса
//не прочитают одно состояние и не запишут каждый своё поверх чужого.
Функция ЗаблокироватьСостояние()

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.УЗ_ВерсииДанных");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Возврат СостояниеОбновления();	//перечитываем под блокировкой

КонецФункции

//Неопределено — догонять нечего или замок держит другой сеанс; иначе состояние.
Функция ЗанятьЗамок()

	Занято = Неопределено;
	НачатьТранзакцию();
	Попытка
		Состояние = ЗаблокироватьСостояние();
		Если Состояние.Версия < АктуальнаяВерсияДанных() И НЕ ЗамокСвеж(Состояние) Тогда
			Состояние.ОбновлениеНачато = ТекущаяУниверсальнаяДата();
			ЗаписатьСостояние(Состояние);
			Занято = Состояние;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Занято;

КонецФункции

Функция ЗамокСвеж(Состояние)

	Если НЕ ЗначениеЗаполнено(Состояние.ОбновлениеНачато) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Состояние.ОбновлениеНачато > ТекущаяУниверсальнаяДата() - СрокЗамка();

КонецФункции

//Контрольная точка: номер шага пишется атомарно; последний шаг отпускает замок,
//промежуточный — продлевает; ошибка прошлого прогона стирается.
Процедура ОтметитьВыполненныйШаг(Номер, ЭтоПоследний)

	НачатьТранзакцию();
	Попытка
		Состояние = ЗаблокироватьСостояние();
		Состояние.Версия = Макс(Состояние.Версия, Номер);
		Состояние.ОбновлениеНачато = ?(ЭтоПоследний, '00010101', ТекущаяУниверсальнаяДата());
		Состояние.Ошибки = "";
		ЗаписатьСостояние(Состояние);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

//Текст ошибки упавшего шага — в запись версий; замок остаётся (повтор не раньше срока).
Процедура ЗаписатьОшибку(Текст)

	НачатьТранзакцию();
	Попытка
		Состояние = ЗаблокироватьСостояние();
		Состояние.Ошибки = Текст;
		ЗаписатьСостояние(Состояние);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти
