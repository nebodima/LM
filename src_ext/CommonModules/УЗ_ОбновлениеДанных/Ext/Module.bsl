//Обновление данных учёта занятий — своя замена обработчиков обновления БСП
//(в LM — ОбновлениеИнформационнойБазыМК). Образец — координатор ПЛ_ext («Путевые листы»).
//
//Версия данных в регистре УЗ_ВерсииДанных (одна запись) — номер последнего выполненного
//шага. Координатор идёт от Версия + 1 до АктуальнаяВерсияДанных(); после каждого шага —
//контрольная точка (короткая транзакция под исключительной блокировкой регистра), так что
//прерванное обновление продолжает со следующего шага, а не с первого.
//
//Замок от параллельного запуска — отметка ОбновлениеНачато в той же записи, занимается той
//же короткой транзакцией: два сеанса занять её одновременно не могут. Пока отметка свежее
//СрокЗамка(), второй сеанс уходит молча — данные догонит первый. Упавший шаг замок не
//отпускает: повтор не чаще срока замка, а не при каждом открытии формы. Шаги идемпотентны.
//
//Кто зовёт: ПриСозданииНаСервере журнала уроков и кассового журнала (первое открытие
//раздела). Когда обновлять нечего — одно чтение регистра (тысячные доли секунды), вход
//в программу не тормозит. Внутри транзакции записи не запускается.

#Область ПрограммныйИнтерфейс

//Номер последнего шага — последний в ВыполнитьШаг. «Учёт занятий 2.0» ставится на чистые данные (перенос
//из прежней конфигурации «УчетУроков» не предусмотрен), поэтому нумерация шагов начинается заново с 2.0;
//следующие шаги добавляются по мере выпуска версий, изменяющих данные.
//1 — первичное заполнение: запись настроек (организация и касса по умолчанию, периоды оповещений), основная
//    касса отмечена «Основная», граница просмотра кассы менеджера в регистре УЗ_ГраницаПросмотраКассы (без
//    неё менеджер кассовых документов не видит) (v2.0)
//2 — плательщики (v2.1, В33–В39): прежний «Родитель (родств.)» ученика → основной плательщик (табличная часть
//    «Плательщики»); приходы денег 2.0 — строка расшифровки платежа из шапки; движения кассы «Касса ученики» —
//    реквизит «Плательщик» (приход — плательщик прихода, пусто — сам ученик; возврат — получатель)
Функция АктуальнаяВерсияДанных() Экспорт

	Возврат 2;

КонецФункции

//Единая точка догона данных до версии расширения. Ленивая, идемпотентная, никогда не
//роняет вызвавшую форму: ошибка шага — в журнал регистрации и в ресурс ОшибкиОбновления.
Процедура ОбновитьДанныеПриНеобходимости() Экспорт

	Попытка
		Если ВерсияДанных() >= АктуальнаяВерсияДанных() Тогда
			Возврат;
		КонецЕсли;
		Если ТранзакцияАктивна() Тогда
			Возврат;
		КонецЕсли;
		//шаги пишут общие настройки, кассы, расходы и зарплату — права руководителя и администратора;
		//менеджер данные не догоняет (в безопасном режиме расширения привилегированный режим не действует)
		Если Не МожноОбновлятьДанные() Тогда
			Возврат;
		КонецЕсли;

		//без безопасного режима — привилегированно
		УстановитьПривилегированныйРежим(Истина);

		Состояние = ЗанятьЗамок();
		Если Состояние = Неопределено Тогда
			Возврат;
		КонецЕсли;

		Номер = Состояние.Версия + 1;
		Пока Номер <= АктуальнаяВерсияДанных() Цикл
			ВыполнитьШаг(Номер);
			ОтметитьВыполненныйШаг(Номер, Номер = АктуальнаяВерсияДанных());
			Номер = Номер + 1;
		КонецЦикла;

	Исключение
		Подробно = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Учёт занятий.Обновление данных'"),
			УровеньЖурналаРегистрации.Ошибка, , , Подробно);
		Попытка
			ЗаписатьОшибку(Подробно);
		Исключение
			//честно: журнал регистрации уже получил ошибку строкой выше — регистр версий не обязателен
		КонецПопытки;
	КонецПопытки;

КонецПроцедуры

//Что помешало обновить данные — текст для пользователя; пусто, если всё в порядке
//(или обновление прямо сейчас идёт в другом сеансе). Зовётся формой после
//ОбновитьДанныеПриНеобходимости: отказ не должен теряться молча.
Функция ПроблемаОбновления() Экспорт

	Если ВерсияДанных() >= АктуальнаяВерсияДанных() Тогда
		Возврат "";
	КонецЕсли;
	Если Не МожноОбновлятьДанные() Тогда
		Возврат НСтр(
			"ru = 'Учёт занятий ждёт подготовки своих данных после обновления: руководителю или администратору открыть "
			+ "журнал уроков.'");
	КонецЕсли;
	Если УЗ_Общий.БезопасныйРежимДействует() Тогда
		Возврат НСтр("ru = 'Учёт занятий не смог подготовить свои данные.'") + " " + УЗ_Общий.КакСнятьБезопасныйРежим();
	КонецЕсли;
	Ошибки = СостояниеОбновления().Ошибки;
	Если ПустаяСтрока(Ошибки) Тогда
		Возврат "";
	КонецЕсли;
	Возврат НСтр("ru = 'Учёт занятий не смог подготовить свои данные:'") + " "
		+ СтрПолучитьСтроку(Ошибки, 1) + " "
			+ НСтр("ru = 'Подробности — в журнале регистрации, событие «Учёт занятий.Обновление данных».'");

КонецФункции

//Состояние для проверок и тестов: Структура(Версия, ОбновлениеНачато, Ошибки).
Функция СостояниеОбновления() Экспорт

	Состояние = Новый Структура("Версия, ОбновлениеНачато, Ошибки", 0, '00010101', "");
	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.УЗ_ВерсииДанных.СоздатьМенеджерЗаписи();
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Состояние.Версия = Запись.Версия;
		Состояние.ОбновлениеНачато = Запись.ОбновлениеНачато;
		Состояние.Ошибки = Запись.ОшибкиОбновления;
	КонецЕсли;
	Возврат Состояние;

КонецФункции

#Область Шаги

Процедура ВыполнитьШаг(Номер)

	Если Номер = 1 Тогда
		ШагПервичногоЗаполнения();	//v2.0
	ИначеЕсли Номер = 2 Тогда
		ШагПлательщики();	//v2.1
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Шага обновления данных № %1 нет'"), Номер);
	КонецЕсли;

КонецПроцедуры

//Шаг 1. Запись настроек, основная касса и граница просмотра кассы. Заполняет только пустое: повторный
//проход и настройки, уже введённые пользователем, не трогает.
Процедура ШагПервичногоЗаполнения()

	ОсновнаяКасса = Справочники.УЗ_Кассы.ОсновнаяКасса;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Кассы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УЗ_Кассы КАК Кассы
	|ГДЕ
	|	Кассы.Основная
	|	И НЕ Кассы.ПометкаУдаления";
	Если Запрос.Выполнить().Пустой() Тогда
		Касса = ОсновнаяКасса.ПолучитьОбъект();
		Касса.Основная = Истина;
		Касса.Записать();
	КонецЕсли;

	Настройки = РегистрыСведений.УЗ_Настройки.Настройки();
	Значения = Новый Структура;
	Если НЕ ЗначениеЗаполнено(Настройки.Касса) Тогда
		Значения.Вставить("Касса", ОсновнаяКасса);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Настройки.Организация) Тогда
		Организация = ПерваяОрганизация();
		Если ЗначениеЗаполнено(Организация) Тогда
			Значения.Вставить("Организация", Организация);
		КонецЕсли;
	КонецЕсли;
	Если Настройки.ПериодОповещения = 0 Тогда
		//одно значение с формой настроек и показом
		Значения.Вставить("ПериодОповещения", УЗ_ОбщийКлиентСервер.ПериодОповещенияПоУмолчанию());
	КонецЕсли;
	Если Настройки.ОповещатьОЗадолженности = 0 Тогда
		Значения.Вставить("ОповещатьОЗадолженности", 2);	//2 дня
	КонецЕсли;
	Если Значения.Количество() > 0 Тогда
		РегистрыСведений.УЗ_Настройки.ЗаписатьНастройки(Значения);
	КонецЕсли;

	//повторный вызов в тот же день ничего не пишет
	УЗ_ДатыЗапрета.ОбновитьГраницуПросмотраКассы();

КонецПроцедуры

//Шаг 2 (v2.1). Плательщики вместо одного «родителя» ученика и плательщик в каждой оплате (В33–В39). Идемпотентен:
//перенесённый родитель очищается в прежнем реквизите, приходы берутся только без расшифровки, движения — только без
//плательщика. Запись — в режиме загрузки (данные прежних версий переносятся как есть, без проверок и перепроведения:
//суммы и остатки не меняются), по одному объекту, без общей транзакции.
Процедура ШагПлательщики()

	//1. Родитель1Прежний → основной плательщик (если такого плательщика у ученика ещё нет)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ФизЛица.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УЗ_ФизЛица КАК ФизЛица
	|ГДЕ
	|	НЕ ФизЛица.ЭтоГруппа
	|	И ФизЛица.Родитель1Прежний <> ЗНАЧЕНИЕ(Справочник.УЗ_ФизЛица.ПустаяСсылка)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Ученик = Выборка.Ссылка.ПолучитьОбъект();
		Родитель = Ученик.Родитель1Прежний;
		Если Ученик.Плательщики.Найти(Родитель, "Плательщик") = Неопределено И Родитель <> Ученик.Ссылка Тогда
			Если Ученик.Плательщики.Количество() = 0 Тогда
				Справочники.УЗ_ФизЛица.УстановитьОсновногоПлательщика(Ученик, Родитель);
			Иначе
				Ученик.Плательщики.Добавить().Плательщик = Родитель;
			КонецЕсли;
		КонецЕсли;
		Ученик.Родитель1Прежний = Справочники.УЗ_ФизЛица.ПустаяСсылка();
		Ученик.ОбменДанными.Загрузка = Истина;
		Ученик.Записать();
	КонецЦикла;

	//2. Приходы «Касса ученики» без расшифровки — строка из шапки (ученик, предмет, абонемент, тариф, сумма)
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПКО.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УЗ_ПриходДенег КАК ПКО
	|ГДЕ
	|	ПКО.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыОпераций.КассаУченики)
	|	И (ПКО.ФизЛицо <> ЗНАЧЕНИЕ(Справочник.УЗ_ФизЛица.ПустаяСсылка)
	|			ИЛИ ПКО.СуммаДокумента <> 0)
	|	И НЕ ПКО.Ссылка В
	|				(ВЫБРАТЬ
	|					Строки.Ссылка
	|				ИЗ
	|					Документ.УЗ_ПриходДенег.РасшифровкаПлатежа КАК Строки)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Приход = Выборка.Ссылка.ПолучитьОбъект();
		СтрокаОплаты = Приход.РасшифровкаПлатежа.Добавить();
		СтрокаОплаты.Ученик = Приход.ФизЛицо;
		СтрокаОплаты.ПредметОбучения = Приход.ПредметОбучения;
		СтрокаОплаты.Абонемент = Приход.Абонемент;
		СтрокаОплаты.Тариф = Приход.Тариф;
		СтрокаОплаты.Сумма = Приход.СуммаДокумента;
		Приход.ОбменДанными.Загрузка = Истина;
		Приход.Записать();
	КонецЦикла;

	//3. Движения кассы «Касса ученики» без плательщика: приход — плательщик прихода (пусто — ученик); возврат (после
	//всех приходов: получатель по умолчанию ищется по плательщикам оплат) — получатель расхода (пусто — кто платил за
	//ученика до возврата: УЗ_Сервер.ПолучательВозврата; он же — в документ)
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Движения.Регистратор КАК Регистратор,
	|	ВЫБОР
	|		КОГДА Движения.Регистратор ССЫЛКА Документ.УЗ_РасходДенег
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Порядок,
	|	Движения.Период КАК Период
	|ИЗ
	|	РегистрНакопления.УЗ_Касса КАК Движения
	|ГДЕ
	|	Движения.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыОпераций.КассаУченики)
	|	И Движения.Плательщик = ЗНАЧЕНИЕ(Справочник.УЗ_ФизЛица.ПустаяСсылка)
	|	И (Движения.Регистратор ССЫЛКА Документ.УЗ_ПриходДенег
	|			ИЛИ Движения.Регистратор ССЫЛКА Документ.УЗ_РасходДенег)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	Период";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Регистратор = Выборка.Регистратор;
		Набор = РегистрыНакопления.УЗ_Касса.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Регистратор);
		Набор.Прочитать();
		ЭтоВозврат = (ТипЗнч(Регистратор) = Тип("ДокументСсылка.УЗ_РасходДенег"));
		Получатель = Неопределено;
		Для Каждого Запись Из Набор Цикл
			Если Запись.ВидОперации <> Перечисления.УЗ_ВидыОпераций.КассаУченики
				Или ЗначениеЗаполнено(Запись.Плательщик) Тогда
				Продолжить;
			КонецЕсли;
			Если ЭтоВозврат Тогда
				Если Получатель = Неопределено Тогда
					Получатель = ПолучательПрежнегоВозврата(Регистратор, Запись);
				КонецЕсли;
				Запись.Плательщик = Получатель;
			Иначе
				Плательщик = Регистратор.Плательщик;
				Запись.Плательщик = ?(ЗначениеЗаполнено(Плательщик), Плательщик, Запись.Клиент);
			КонецЕсли;
		КонецЦикла;
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Записать();
	КонецЦикла;

КонецПроцедуры

//Получатель прежнего возврата (расход «Касса ученики» 2.0 без получателя): кто платил за ученика до даты возврата;
//записывается и в документ (режим загрузки, без перепроведения).
Функция ПолучательПрежнегоВозврата(ДокументВозврата, Запись)

	Документ = ДокументВозврата.ПолучитьОбъект();
	Если НЕ ЗначениеЗаполнено(Документ.Получатель) Тогда
		Документ.Получатель = УЗ_Сервер.ПолучательВозврата(Запись.Клиент, Запись.Организация, Запись.ПредметОбучения,
			Запись.Период);
		Документ.ОбменДанными.Загрузка = Истина;
		Документ.Записать();
	КонецЕсли;
	Возврат Документ.Получатель;

КонецФункции

//Организация хозяина: у УНФ/БП/УТ справочник Организации есть у всех, берём первую
//непомеченную по наименованию (у малого бизнеса она обычно одна).
Функция ПерваяОрганизация()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организации.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Организации.ПустаяСсылка();

КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//Хватит ли прав текущего пользователя на шаги обновления: запись настроек и версии данных есть у
//руководителя (УЗ_Руководитель) и администратора, у менеджера (УЗ_ОсновнаяРоль) — нет.
Функция МожноОбновлятьДанные()

	Возврат ПравоДоступа("Изменение", Метаданные.РегистрыСведений.УЗ_Настройки)
		И ПравоДоступа("Изменение", Метаданные.РегистрыСведений.УЗ_ВерсииДанных);

КонецФункции

#Область Замок

//Срок, после которого отметка «обновление начато» считается брошенной (сеанс упал).
Функция СрокЗамка()

	Возврат 600;

КонецФункции

Функция ВерсияДанных()

	//быстрый путь: одно чтение без блокировок
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Версии.Версия КАК Версия
	|ИЗ
	|	РегистрСведений.УЗ_ВерсииДанных КАК Версии";
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Версия, 0);

КонецФункции

Процедура ЗаписатьСостояние(Состояние)

	Запись = РегистрыСведений.УЗ_ВерсииДанных.СоздатьМенеджерЗаписи();
	Запись.Версия = Состояние.Версия;
	Запись.ОбновлениеНачато = Состояние.ОбновлениеНачато;
	Запись.ОшибкиОбновления = Лев(Состояние.Ошибки, 1000);
	Запись.Записать();

КонецПроцедуры

//Все правки состояния — короткой транзакцией под исключительной блокировкой: два сеанса
//не прочитают одно состояние и не запишут каждый своё поверх чужого.
Функция ЗаблокироватьСостояние()

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.УЗ_ВерсииДанных");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Возврат СостояниеОбновления();	//перечитываем под блокировкой

КонецФункции

//Неопределено — догонять нечего или замок держит другой сеанс; иначе состояние.
Функция ЗанятьЗамок()

	Занято = Неопределено;
	НачатьТранзакцию();
	Попытка
		Состояние = ЗаблокироватьСостояние();
		Если Состояние.Версия < АктуальнаяВерсияДанных() И НЕ ЗамокСвеж(Состояние) Тогда
			Состояние.ОбновлениеНачато = ТекущаяУниверсальнаяДата();
			ЗаписатьСостояние(Состояние);
			Занято = Состояние;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Возврат Занято;

КонецФункции

Функция ЗамокСвеж(Состояние)

	Если НЕ ЗначениеЗаполнено(Состояние.ОбновлениеНачато) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Состояние.ОбновлениеНачато > ТекущаяУниверсальнаяДата() - СрокЗамка();

КонецФункции

//Контрольная точка: номер шага пишется атомарно; последний шаг отпускает замок,
//промежуточный — продлевает; ошибка прошлого прогона стирается.
Процедура ОтметитьВыполненныйШаг(Номер, ЭтоПоследний)

	НачатьТранзакцию();
	Попытка
		Состояние = ЗаблокироватьСостояние();
		Состояние.Версия = Макс(Состояние.Версия, Номер);
		Состояние.ОбновлениеНачато = ?(ЭтоПоследний, '00010101', ТекущаяУниверсальнаяДата());
		Состояние.Ошибки = "";
		ЗаписатьСостояние(Состояние);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

//Текст ошибки упавшего шага — в запись версий; замок остаётся (повтор не раньше срока).
Процедура ЗаписатьОшибку(Текст)

	НачатьТранзакцию();
	Попытка
		Состояние = ЗаблокироватьСостояние();
		Состояние.Ошибки = Текст;
		ЗаписатьСостояние(Состояние);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#КонецОбласти
