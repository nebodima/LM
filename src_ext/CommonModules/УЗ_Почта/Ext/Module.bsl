//Отправка писем ученикам и родителям средствами платформы (ИнтернетПочта),
//без подсистем хозяина. Настройки SMTP — регистр УЗ_НастройкиПочты, одна запись
//с идентификатором "ОСНОВНАЯ"; пароль читается только в привилегированном режиме.
//Наружу письмо уходит только из функции Послать; в песочнице сеанса (ВключитьПесочницу — тесты на копиях
//баз) оно пишется в журнал регистрации и к серверу SMTP не подключаемся.

#Область ПрограммныйИнтерфейс

//Ключ единственной записи настроек SMTP в регистре УЗ_НастройкиПочты.
Функция ИдентификаторНастроек() Экспорт
	Возврат "ОСНОВНАЯ";
КонецФункции

//Настройки почты без пароля — для формы и проверок.
//Структура: Включена, СерверSMTP, Порт, ИспользоватьSSL, Логин, АдресОтправителя,
//ИмяОтправителя, ПарольЗадан, ПисьмаОЗадолженности, БазаПароля (строка соединения базы, где введён пароль).
Функция Настройки() Экспорт

	Результат = Новый Структура("Включена, СерверSMTP, Порт, ИспользоватьSSL, Логин,
		|АдресОтправителя, ИмяОтправителя, ПарольЗадан, ПисьмаОЗадолженности, БазаПароля",
		Ложь, "", 0, Ложь, "", "", "", Ложь, Ложь, "");

	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.УЗ_НастройкиПочты.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = ИдентификаторНастроек();
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		//список полей явно: с исключением «ПарольЗадан» (его нет у записи) платформа падала «Поле не обнаружено»,
		//как только настройки почты хоть раз сохранили (тест_оповещения, 28.09.2026)
		ЗаполнитьЗначенияСвойств(Результат, Запись, "Включена, СерверSMTP, Порт, ИспользоватьSSL, Логин,
			|АдресОтправителя, ИмяОтправителя, ПисьмаОЗадолженности");
		Результат.ПарольЗадан = Не ПустаяСтрока(Запись.Пароль);
		Результат.БазаПароля = Запись.База;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;

КонецФункции

//Готова ли почта к отправке; Причина — что не заполнено.
Функция ПочтаНастроена(Причина = "") Экспорт

	Параметры = Настройки();
	Если Не Параметры.Включена Тогда
		Причина = НСтр("ru = 'Отправка писем выключена в настройках почты.'");
	ИначеЕсли ПустаяСтрока(Параметры.СерверSMTP) Тогда
		Причина = НСтр("ru = 'Не указан сервер SMTP.'");
	ИначеЕсли ПустаяСтрока(Параметры.АдресОтправителя) Тогда
		Причина = НСтр("ru = 'Не указан адрес отправителя.'");
	ИначеЕсли Не ПустаяСтрока(ПричинаЧужойБазы(Параметры.БазаПароля)) Тогда
		Причина = ПричинаЧужойБазы(Параметры.БазаПароля);
	Иначе
		Причина = "";
	КонецЕсли;
	Возврат ПустаяСтрока(Причина);

КонецФункции

//A12-04: ключ или пароль сервиса введён в другой базе — эта база, вероятно, копия рабочей (тесты, обучение):
//с теми же ключами она слала бы ученикам настоящие напоминания и забирала бы сообщения бота у рабочей базы.
//"" — своя база, ключ вводили до 2.3.0.2 (база не запомнена) или включена песочница.
Функция ПричинаЧужойБазы(База) Экспорт

	Если ПустаяСтрока(База) Или База = СтрокаСоединенияИнформационнойБазы() Или ПесочницаВключена() Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Ключ доступа (пароль) введён в другой базе (%1): похоже, это копия рабочей базы — "
		+ "из неё сообщения не отправляются. Если это рабочая база (её перенесли), введите ключ заново "
		+ "в настройках сообщений.'"), База);

КонецФункции

//Почему почта не готова к отправке ("" — готова). То же, что ПочтаНастроена, но строкой.
Функция ПричинаНеготовности() Экспорт
	Причина = "";
	ПочтаНастроена(Причина);
	Возврат Причина;
КонецФункции

#Область Песочница

//Истина — письма этого сеанса не отправляются, а пишутся в журнал регистрации (параметр сеанса
//УЗ_ПесочницаПочты). Параметр не установлен — песочницы нет: включают её только явно (ВключитьПесочницу).
//Модуля сеанса у расширения нет намеренно: в безопасном режиме платформа его не применяет и при каждом
//входе пишет «Ошибка применения расширения конфигурации» (ConfigExtensionApplyError, 28.09.2026).
Функция ПесочницаВключена() Экспорт
	Попытка
		Возврат ПараметрыСеанса.УЗ_ПесочницаПочты = Истина;
	Исключение
		//честно: параметр сеанса не установлен — песочницы нет (см. описание выше)
		Возврат Ложь;
	КонецПопытки;
КонецФункции

//Включить песочницу до конца сеанса: тесты и проверки на копиях баз с рабочими настройками SMTP.
//Выключающей пары нет намеренно — сеанс, в котором включили песочницу, писем не отправит.
Процедура ВключитьПесочницу() Экспорт
	ПараметрыСеанса.УЗ_ПесочницаПочты = Истина;
	ЗаписьЖурналаРегистрации(СобытиеПесочницы(), УровеньЖурналаРегистрации.Информация, , ,
		НСтр("ru = 'Песочница почты включена: письма этого сеанса не отправляются.'"));
КонецПроцедуры

//Событие журнала регистрации для писем, задержанных песочницей.
Функция СобытиеПесочницы() Экспорт
	Возврат НСтр("ru = 'Учёт занятий.Почта.Песочница'");
КонецФункции

//Событие журнала регистрации для отправленных и неотправленных писем.
Функция СобытиеОтправки() Экспорт
	Возврат НСтр("ru = 'Учёт занятий.Почта.Отправка'");
КонецФункции

#КонецОбласти

#Область ПисьмаУченикам

//Письмо о задолженности, если его нужно отправить: почта включена, в настройках почты включены
//письма о задолженности и у ученика или его родителя отмечено «Оповестить по email» и есть адрес.
//Иначе Неопределено. Структура — см. ПодготовитьПисьмоОЗадолженности.
Функция ПисьмоОЗадолженности(Ученик, Долг, Организация = Неопределено) Экспорт

	Параметры = Настройки();
	Если Не Параметры.Включена Или Не Параметры.ПисьмаОЗадолженности Тогда
		Возврат Неопределено;
	КонецЕсли;
	Письмо = ПодготовитьПисьмоОЗадолженности(Ученик, Долг, Организация);
	Если Письмо.Адреса.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Письмо;

КонецФункции

//Текст и адреса письма о задолженности (без проверки настроек — для просмотра и проверок).
//Адреса: e-mail ученика и его плательщиков (В33: мама, папа, бабушка — табличная часть «Плательщики»), у кого
//отмечено «Оповестить по email».
//Организация — где долг (В12: деньги учеников раздельно по организациям); пустая — строки об организации нет.
//Структура: Адреса (Массив строк), Тема, Текст.
Функция ПодготовитьПисьмоОЗадолженности(Ученик, Долг, Организация = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ФизЛица.Наименование КАК Имя,
	|	ФизЛица.EMail КАК EMail,
	|	ФизЛица.ОповеститьПоEmail КАК ОповеститьПоEmail
	|ИЗ
	|	Справочник.УЗ_ФизЛица КАК ФизЛица
	|ГДЕ
	|	ФизЛица.Ссылка = &Ученик
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Плательщики.Плательщик.EMail КАК EMail
	|ИЗ
	|	Справочник.УЗ_ФизЛица.Плательщики КАК Плательщики
	|ГДЕ
	|	Плательщики.Ссылка = &Ученик
	|	И Плательщики.Плательщик.ОповеститьПоEmail
	|
	|УПОРЯДОЧИТЬ ПО
	|	Плательщики.Основной УБЫВ,
	|	Плательщики.НомерСтроки";
	Запрос.УстановитьПараметр("Ученик", Ученик);
	Пакет = Запрос.ВыполнитьПакет();
	Выборка = Пакет[0].Выбрать();

	Письмо = Новый Структура("Адреса, Тема, Текст", Новый Массив, "", "");
	Если Не Выборка.Следующий() Тогда
		Возврат Письмо;
	КонецЕсли;
	Если Выборка.ОповеститьПоEmail = Истина И СтрНайти(Выборка.EMail, "@") > 1 Тогда
		Письмо.Адреса.Добавить(СокрЛП(Выборка.EMail));
	КонецЕсли;
	Плательщики = Пакет[1].Выбрать();
	Пока Плательщики.Следующий() Цикл
		Адрес = СокрЛП(Плательщики.EMail);
		Если СтрНайти(Адрес, "@") > 1 И Письмо.Адреса.Найти(Адрес) = Неопределено Тогда
			Письмо.Адреса.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;

	Письмо.Тема = НСтр("ru = 'Задолженность за занятия'");
	СтрокаОрганизации = "";
	Если ЗначениеЗаполнено(Организация) Тогда
		СтрокаОрганизации = Символы.ПС + СтрШаблон(НСтр("ru = 'Организация: %1.'"), Организация);
	КонецЕсли;
	Письмо.Текст = СтрШаблон(НСтр("ru = 'Здравствуйте!
		|
		|По занятиям ученика %1 образовалась задолженность %2 руб.%3
		|Пожалуйста, пополните баланс при следующем посещении.
		|
		|Это письмо отправлено автоматически.'"), Выборка.Имя, Формат(Долг, "ЧДЦ=2; ЧН=0"), СтрокаОрганизации);
	Возврат Письмо;

КонецФункции

#КонецОбласти

#Область НастройкиПочты

//Настраивать почту может только администратор базы (роль полных прав хозяина даёт право
//«Администрирование»): в настройках пароль от почтового ящика.
Функция ЕстьПравоНастройки() Экспорт
	Возврат ПравоДоступа("Администрирование", Метаданные);
КонецФункции

//Записать настройки почты. Пароль меняется, только если ИзменитьПароль = Истина
//(в форму он не передаётся, поле пароля пустое).
Процедура СохранитьНастройки(Данные, НовыйПароль = "", ИзменитьПароль = Ложь) Экспорт

	Если Не ЕстьПравоНастройки() Тогда
		ВызватьИсключение НСтр("ru = 'Настройки почты может менять только администратор.'");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.УЗ_НастройкиПочты.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = ИдентификаторНастроек();
	Запись.Прочитать();
	Пароль = Запись.Пароль;
	Запись.Идентификатор = ИдентификаторНастроек();
	ЗаполнитьЗначенияСвойств(Запись, Данные, "Включена, СерверSMTP, Порт, ИспользоватьSSL, Логин,
		|АдресОтправителя, ИмяОтправителя, ПисьмаОЗадолженности");
	Запись.Пароль = ?(ИзменитьПароль, НовыйПароль, Пароль);
	Если ИзменитьПароль Тогда
		Запись.База = СтрокаСоединенияИнформационнойБазы();
	КонецЕсли;
	Запись.Записать();

КонецПроцедуры

//Кнопка «Проверить» формы настроек: письмо на адрес отправителя (себе).
Функция ОтправитьТестовоеПисьмо(ТекстОшибки = "") Экспорт

	Если Не ЕстьПравоНастройки() Тогда
		ТекстОшибки = НСтр("ru = 'Проверять почту может только администратор.'");
		Возврат Ложь;
	КонецЕсли;
	Параметры = Настройки();
	Если Не ПочтаНастроена(ТекстОшибки) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Отправить(Параметры.АдресОтправителя, НСтр("ru = 'Учёт занятий: проверка почты'"),
		НСтр("ru = 'Если вы читаете это письмо, отправка почты из «Учёта занятий» настроена верно.'"), ТекстОшибки);

КонецФункции

//Кнопка «Проверить» без ожидания на клиенте (архитектор, 2.3, 28.09.2026): письмо уходит фоновым заданием, форма
//спрашивает его состояние (УЗ_Общий.СостояниеДлительнойОперации). Прежде SMTP с таймаутом 30 с держал клиента.
//Безопасный режим — задание не запускается, в Ошибке — как его снять. Фоновое задание не запустилось — письмо
//отправляется здесь же (синхронно), результат — в Результате.
//Структура: Задание, АдресРезультата (см. УЗ_Общий.ЗапуститьФоновоеЗадание), Результат (Структура Отправлено,
//ТекстОшибки — если отправлено без задания), Ошибка.
Функция НачатьОтправкуТестовогоПисьма(ИдентификаторФормы) Экспорт

	Итог = Новый Структура("Задание, АдресРезультата, Результат, Ошибка", Неопределено, "", Неопределено, "");
	Если Не ЕстьПравоНастройки() Тогда
		Итог.Ошибка = НСтр("ru = 'Проверять почту может только администратор.'");
		Возврат Итог;
	КонецЕсли;
	//в песочнице (тесты на копиях) письмо наружу не уходит — безопасный режим ей не помеха
	Если УЗ_Общий.БезопасныйРежимДействует() И Не ПесочницаВключена() Тогда
		Итог.Ошибка = НСтр("ru = 'Отправка почты в безопасном режиме запрещена.'") + " "
			+ УЗ_Общий.КакСнятьБезопасныйРежим();
		Возврат Итог;
	КонецЕсли;
	Запуск = УЗ_Общий.ЗапуститьФоновоеЗадание("УЗ_Почта.ОтправитьТестовоеПисьмоВФоне", Новый Массив, ИдентификаторФормы,
		НСтр("ru = 'Учёт занятий: проверочное письмо'"));
	Если Запуск = Неопределено Тогда
		ТекстОшибки = "";
		Итог.Результат = Новый Структура("Отправлено, ТекстОшибки", ОтправитьТестовоеПисьмо(ТекстОшибки), ТекстОшибки);
	Иначе
		ЗаполнитьЗначенияСвойств(Итог, Запуск);
	КонецЕсли;
	Возврат Итог;

КонецФункции

//Фоновое задание кнопки «Проверить»: Песочница — песочница вызвавшего сеанса; результат — Структура Отправлено,
//ТекстОшибки во временное хранилище.
Процедура ОтправитьТестовоеПисьмоВФоне(Песочница, АдресРезультата) Экспорт

	УЗ_Общий.ПриНачалеФоновогоЗадания(Песочница);
	ТекстОшибки = "";
	Отправлено = ОтправитьТестовоеПисьмо(ТекстОшибки);
	ПоместитьВоВременноеХранилище(Новый Структура("Отправлено, ТекстОшибки", Отправлено, ТекстОшибки), АдресРезультата);

КонецПроцедуры

//Фоновое задание «Рассылки должникам» (Обработки.УЗ_РассылкаДолжникам.ОтправитьПисьма): метод фонового задания —
//только процедура общего модуля (из модуля менеджера обработки ФоновыеЗадания.Выполнить не запускает, проверено
//28.09.2026). Песочница — вызвавшего сеанса; результат — массив итогов по ученикам во временное хранилище.
Процедура ОтправитьПисьмаДолжникамВФоне(Песочница, Получатели, Тема, Шаблон, НеЧащеДней, АдресРезультата) Экспорт

	УЗ_Общий.ПриНачалеФоновогоЗадания(Песочница);
	ПоместитьВоВременноеХранилище(Обработки.УЗ_РассылкаДолжникам.ОтправитьПисьма(Получатели, Тема, Шаблон, НеЧащеДней),
		АдресРезультата);

КонецПроцедуры

//Разрешена ли интернет-почта коду расширения. Расширение, загруженное из файла, по умолчанию
//работает в безопасном режиме, а в нём интернет-почта запрещена. Проверяем подключением к
//закрытому порту этой же машины: письмо никуда не уходит, по тексту ошибки видно, кто отказал.
//Структура: Разрешена, БезопасныйРежим, Текст.
Функция ДоступностьИнтернетПочты() Экспорт

	Результат = Новый Структура("Разрешена, БезопасныйРежим, Текст", Ложь, Ложь, "");
	Попытка
		Профиль = Новый ИнтернетПочтовыйПрофиль;
		Профиль.АдресСервераSMTP = "127.0.0.1";
		Профиль.ПортSMTP = 1;
		Профиль.Таймаут = 2;
		Почта = Новый ИнтернетПочта;
		Почта.Подключиться(Профиль);
		Почта.Отключиться();
		Результат.Разрешена = Истина;
	Исключение
		Результат.Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат.БезопасныйРежим = СтрНайти(НРег(Результат.Текст), "безопасн") > 0;
		Результат.Разрешена = Не Результат.БезопасныйРежим;
	КонецПопытки;
	Возврат Результат;

КонецФункции

#КонецОбласти

//Отправить письмо. Возвращает Истина или Ложь; ТекстОшибки — почему не ушло.
//  Адреса — строка "a@b.ru; c@d.ru" или массив строк.
Функция Отправить(Адреса, Тема, Текст, ТекстОшибки = "") Экспорт

	Если Не ПочтаНастроена(ТекстОшибки) Тогда
		Возврат Ложь;
	КонецЕсли;

	СписокАдресов = ?(ТипЗнч(Адреса) = Тип("Массив"), Адреса,
		СтрРазделить(СтрЗаменить(Адреса, ",", ";"), ";", Ложь));
	Получатели = Новый Массив;
	Для Каждого Адрес Из СписокАдресов Цикл
		Адрес = СокрЛП(Адрес);
		Если СтрНайти(Адрес, "@") > 1 Тогда
			Получатели.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;
	Если Получатели.Количество() = 0 Тогда
		ТекстОшибки = НСтр("ru = 'Нет ни одного корректного адреса получателя.'");
		Возврат Ложь;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Запись = РегистрыСведений.УЗ_НастройкиПочты.СоздатьМенеджерЗаписи();
	Запись.Идентификатор = ИдентификаторНастроек();
	Запись.Прочитать();
	Профиль = Новый ИнтернетПочтовыйПрофиль;
	Профиль.АдресСервераSMTP = Запись.СерверSMTP;
	Профиль.ПортSMTP = ?(Запись.Порт = 0, ?(Запись.ИспользоватьSSL, 465, 25), Запись.Порт);
	Профиль.ИспользоватьSSLSMTP = Запись.ИспользоватьSSL;
	Если Не ПустаяСтрока(Запись.Логин) Тогда
		Профиль.ПользовательSMTP = Запись.Логин;
		Профиль.ПарольSMTP = Запись.Пароль;
	КонецЕсли;
	Профиль.Таймаут = 30;
	АдресОтправителя = Запись.АдресОтправителя;
	ИмяОтправителя = Запись.ИмяОтправителя;
	УстановитьПривилегированныйРежим(Ложь);

	Письмо = Новый ИнтернетПочтовоеСообщение;
	Письмо.Отправитель = АдресОтправителя;
	Письмо.ИмяОтправителя = ИмяОтправителя;
	Письмо.Тема = Тема;
	Для Каждого Адрес Из Получатели Цикл
		Письмо.Получатели.Добавить(Адрес);
	КонецЦикла;
	Письмо.Тексты.Добавить(Текст, ТипТекстаПочтовогоСообщения.ПростойТекст);

	Возврат Послать(Профиль, Письмо, Получатели, ТекстОшибки);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//Единственная точка, где письмо уходит из базы наружу (аудит внешний_мир держит это правило).
//В песочнице (параметр сеанса УЗ_ПесочницаПочты) к серверу SMTP не подключаемся: письмо считается
//принятым и пишется в журнал регистрации событием «Учёт занятий.Почта.Песочница». Каждая настоящая
//попытка отправки — событие «Учёт занятий.Почта.Отправка» ДО подключения: по журналу видно, что
//письма уходили (или не уходили — так проверяют тесты).
Функция Послать(Профиль, Письмо, Получатели, ТекстОшибки)

	Описание = СтрШаблон(НСтр("ru = 'Кому: %1; тема: %2'"), СтрСоединить(Получатели, ", "), Письмо.Тема);
	Если ПесочницаВключена() Тогда
		ЗаписьЖурналаРегистрации(СобытиеПесочницы(), УровеньЖурналаРегистрации.Информация, , , Описание);
		Возврат Истина;
	КонецЕсли;
	ЗаписьЖурналаРегистрации(СобытиеОтправки(), УровеньЖурналаРегистрации.Информация, , , Описание);

	Почта = Новый ИнтернетПочта;
	//в профиле задан только SMTP: входящая почта не нужна, подключение идёт к серверу отправки
	Попытка
		Почта.Подключиться(Профиль);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьОшибку(ТекстОшибки);
		Возврат Ложь;
	КонецПопытки;

	Попытка
		Почта.Послать(Письмо);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьОшибку(ТекстОшибки);
		Отключиться(Почта);
		Возврат Ложь;
	КонецПопытки;
	//письмо ушло: ошибка отключения — только в журнал (прежде письмо считалось неотправленным, и повторная
	//рассылка отправляла его ещё раз)
	Отключиться(Почта);
	Возврат Истина;

КонецФункции

//Отключиться от сервера SMTP; ошибка отключения — в журнал регистрации, результат отправки она не меняет.
Процедура Отключиться(Почта)

	Попытка
		Почта.Отключиться();
	Исключение
		ЗаписатьОшибку(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

Процедура ЗаписатьОшибку(ТекстОшибки)

	ЗаписьЖурналаРегистрации(НСтр("ru = 'Учёт занятий.Почта'"),
		УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);

КонецПроцедуры

#КонецОбласти
