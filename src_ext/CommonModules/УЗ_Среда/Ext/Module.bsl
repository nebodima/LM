//Паспорт среды: в какой конфигурации работает «Учёт занятий» и что здесь есть.
//
//Одна поставка работает на УНФ, Бухгалтерии, Управлении торговлей и демо-пустышке.
//Всё, что расширение берёт у хозяина, проходит через этот модуль: единая точка,
//посчитанная один раз на сеанс (повторное использование возвращаемых значений).
//
//Библиотеку стандартных подсистем расширение не поставляет и не копирует. Если она
//есть у хозяина (купленная покупателем), её методы зовутся ТОЛЬКО отсюда, строкой через
//Вычислить/Выполнить после проверки метаданных: прямое имя модуля не скомпилировалось бы
//в базе без него.

//Структура:
//  ИмяКонфигурации — имя основной конфигурации;
//  Семейство       — "УНФ" / "БП" / "УТ" / "КА" / "ЕРП" / "Демо" / "Другая";
//  ЕстьБСП         — у хозяина есть библиотека стандартных подсистем;
//  ВерсияБСП       — строка версии ("" если нет);
//  ЕстьПечатьБСП   — можно встраиваться в подменю «Печать» хозяина.
Функция Паспорт() Экспорт

	Паспорт = Новый Структура;
	Паспорт.Вставить("ИмяКонфигурации", Метаданные.Имя);
	Паспорт.Вставить("ЕстьБСП", ЕстьОбщийМодуль("СтандартныеПодсистемыСервер"));
	Паспорт.Вставить("ВерсияБСП", "");
	Если Паспорт.ЕстьБСП Тогда
		Попытка
			Паспорт.ВерсияБСП = Строка(Вычислить("СтандартныеПодсистемыСервер.ВерсияБиблиотеки()"));
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Учёт занятий.Среда'"), УровеньЖурналаРегистрации.Предупреждение,
				, , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Паспорт.ВерсияБСП = "";
		КонецПопытки;
	КонецЕсли;
	Паспорт.Вставить("ЕстьПечатьБСП",
		ЕстьОбщийМодуль("УправлениеПечатью") И ЕстьОбщийМодуль("УправлениеПечатьюКлиент"));
	Паспорт.Вставить("Семейство", Семейство(Паспорт.ИмяКонфигурации));
	Возврат Паспорт;

КонецФункции

//Ссылка на элемент справочника Пользователи для текущего пользователя сеанса.
//Ищется по идентификатору пользователя информационной базы. По имени — только если у хозяина
//нет реквизита ИдентификаторПользователяИБ (демо без БСП) и карточка с таким именем одна.
//В базе без пользователей (демо) — пустая ссылка.
Функция ТекущийПользователь() Экспорт

	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ПользовательИБ = Неопределено Или ПустаяСтрока(ПользовательИБ.Имя) Тогда
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;
	Возврат ПользовательПоДаннымИБ(Строка(ПользовательИБ.УникальныйИдентификатор), ПользовательИБ.Имя,
		ПользовательИБ.ПолноеИмя);

КонецФункции

//Карточка Пользователи для пользователя ИБ (вынесено из ТекущийПользователь для проверок). Идентификатор —
//строкой: модуль с повторным использованием значений не принимает УникальныйИдентификатор параметром.
//Не нашлась по идентификатору, а реквизит у хозяина есть, — пустая ссылка: одноимённая карточка
//может быть другим сотрудником (его дата запрета и напоминания достались бы не тому).
Функция ПользовательПоДаннымИБ(Идентификатор, Имя, ПолноеИмя) Экспорт

	//реквизит ИдентификаторПользователяИБ принадлежит хозяину и не заимствован:
	//текст запроса разбирается при выполнении, поэтому сборка от него не зависит
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.ИдентификаторПользователяИБ = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор", Новый УникальныйИдентификатор(Идентификатор));
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
		Возврат Справочники.Пользователи.ПустаяСсылка();
	Исключение
		//у хозяина нет такого реквизита — ищем по имени ниже
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Учёт занятий.Текущий пользователь'"),
			УровеньЖурналаРегистрации.Предупреждение, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Найденный = ЕдинственныйПоНаименованию(ПолноеИмя);
	Если Не ЗначениеЗаполнено(Найденный) Тогда
		Найденный = ЕдинственныйПоНаименованию(Имя);
	КонецЕсли;
	Возврат Найденный;

КонецФункции

//Карточка Пользователи с таким наименованием, если она одна; иначе пустая ссылка.
Функция ЕдинственныйПоНаименованию(Наименование)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
	|	Пользователи.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Найденные = Запрос.Выполнить().Выгрузить();
	Если Найденные.Количество() = 1 Тогда
		Возврат Найденные[0].Ссылка;
	КонецЕсли;
	Возврат Справочники.Пользователи.ПустаяСсылка();

КонецФункции

//Имя формы печати БСП хозяина ("ОбщаяФорма.ПечатьДокументов") или "", если печатать своей формой.
//
//Документы «Учёта занятий» печатаются в подменю «Печать» хозяина, если у него есть БСП: форма
//«Печать документов» сама вызывает процедуру Печать модуля менеджера нашего документа (сигнатура
//БСП), и покупатель получает всё, что умеет его конфигурация: комплекты, сохранение, отправку почтой.
//Наличия модулей мало (в демо-пустышке модуль бывает без методов), поэтому проверяем делом —
//пробной подготовкой коллекции печатных форм — один раз за сеанс.
Функция ФормаПечатиХозяина() Экспорт

	Если Не Паспорт().ЕстьПечатьБСП
		Или Метаданные.НайтиПоПолномуИмени("ОбщаяФорма.ПечатьДокументов") = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Проба = Вычислить("УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм(""УЗ_Проба"")");
		Если ТипЗнч(Проба) <> Тип("ТаблицаЗначений")
			Или Проба.Колонки.Найти("ИмяВРЕГ") = Неопределено
			Или Проба.Колонки.Найти("ТабличныйДокумент") = Неопределено Тогда
			Возврат "";
		КонецЕсли;
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Учёт занятий.Печать'"),
			УровеньЖурналаРегистрации.Предупреждение, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат "";
	КонецПопытки;
	Возврат "ОбщаяФорма.ПечатьДокументов";

КонецФункции

//Реквизиты справочника «Организации» хозяина, которые печать и справки читают (этап 2.1, В40): только те, что
//есть в его метаданных. Справочник заимствован без реквизитов, а у УНФ, Бухгалтерии и Управления торговлей имена
//разные: сокращённое наименование есть не везде, признак ИП — «ЮридическоеФизическоеЛицо» (УНФ, БП) или
//«ЮрФизЛицо» (УТ). Метаданные за сеанс не меняются — список считается один раз; сами значения читает
//УЗ_Печать.СведенияОбОрганизации запросом по этому списку (нет реквизита — пустая строка, а не ошибка).
//ФиксированныйМассив имён.
Функция РеквизитыОрганизацииХозяина() Экспорт

	Имена = Новый Массив;
	Для Каждого ИмяРеквизита Из СтрРазделить("Наименование,НаименованиеСокращенное,НаименованиеПолное,ИНН,КПП,"
		+ "КодПоОКПО,ЮридическоеФизическоеЛицо,ЮрФизЛицо", ",") Цикл
		Если УЗ_Общий.ЕстьРеквизит("Справочник.Организации", ИмяРеквизита) Тогда
			Имена.Добавить(ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый ФиксированныйМассив(Имена);

КонецФункции

//Онлайн-касса хозяина (чеки 54-ФЗ, В61): библиотека подключаемого оборудования УНФ, Бухгалтерии и Управления
//торговлей — общие модули фискализации и перечисления реквизитов чека. Одинаковы у всех трёх (сверено 30.09.2026:
//УНФ 3.0.12, БП 3.0.174/3.0.196, УТ 11.5.25/11.5.26). Считается один раз за сеанс — метаданные не меняются.
//ФиксированнаяСтруктура: Есть — Булево; Причина — почему чек не пробить ("" — можно).
Функция ОнлайнКассаХозяина() Экспорт

	Возврат ОнлайнКассаПоМетаданным(
		"ОборудованиеЧекопечатающиеУстройстваКлиент,ОборудованиеЧекопечатающиеУстройстваКлиентСервер,"
		+ "МенеджерОборудованияКлиент,МенеджерОборудованияВызовСервера",
		"ПризнакиСпособаРасчета,ПризнакиПредметаРасчета,ТипыСистемНалогообложенияККТ,ТипыОплатыККТ,"
		+ "ТипыРасчетаДенежнымиСредствами,ТипыПодключаемогоОборудования");

КонецФункции

//Проверка ОнлайнКассаХозяина по спискам имён через запятую (вынесено для проверки отказа тестом: у всех трёх
//хозяев модули есть — отсутствие подсистемы иначе не воспроизвести).
Функция ОнлайнКассаПоМетаданным(ИменаМодулей, ИменаПеречислений) Экспорт

	Нет = Новый Массив;
	Для Каждого ИмяМодуля Из СтрРазделить(ИменаМодулей, ",", Ложь) Цикл
		Если Не ЕстьОбщийМодуль(СокрЛП(ИмяМодуля)) Тогда
			Нет.Добавить(СокрЛП(ИмяМодуля));
		КонецЕсли;
	КонецЦикла;
	Для Каждого ИмяПеречисления Из СтрРазделить(ИменаПеречислений, ",", Ложь) Цикл
		Если Метаданные.Перечисления.Найти(СокрЛП(ИмяПеречисления)) = Неопределено Тогда
			Нет.Добавить(СокрЛП(ИмяПеречисления));
		КонецЕсли;
	КонецЦикла;
	Если Метаданные.Справочники.Найти("ПодключаемоеОборудование") = Неопределено Тогда
		Нет.Добавить("ПодключаемоеОборудование");
	КонецЕсли;
	Причина = "";
	Если Нет.Количество() > 0 Тогда
		Причина = СтрШаблон(НСтр("ru = 'В этой программе (%1) нет подключаемого оборудования для онлайн-касс: чек "
			+ "пробивается в программе с онлайн-кассой (1С:УНФ, 1С:Бухгалтерия, 1С:Управление торговлей). "
			+ "Не хватает: %2.'"),
			Метаданные.Синоним, СтрСоединить(Нет, ", "));
	КонецЕсли;
	Возврат Новый ФиксированнаяСтруктура("Есть, Причина", Нет.Количество() = 0, Причина);

КонецФункции

Функция ЕстьОбщийМодуль(ИмяМодуля)

	Возврат Метаданные.ОбщиеМодули.Найти(ИмяМодуля) <> Неопределено;

КонецФункции

Функция Семейство(ИмяКонфигурации)

	Имя = ВРег(ИмяКонфигурации);
	Если СтрНайти(Имя, "НЕБОЛЬШОЙФИРМ") > 0 Или СтрНайти(Имя, "НАШЕЙФИРМ") > 0 Тогда
		Возврат "УНФ";
	ИначеЕсли СтрНайти(Имя, "БУХГАЛТЕРИЯ") > 0 Тогда
		Возврат "БП";
	ИначеЕсли СтрНайти(Имя, "УПРАВЛЕНИЕТОРГОВЛЕЙ") > 0 Тогда
		Возврат "УТ";
	ИначеЕсли СтрНайти(Имя, "КОМПЛЕКСНАЯ") > 0 Тогда
		Возврат "КА";
	ИначеЕсли СтрНайти(Имя, "ПРЕДПРИЯТИЕМ") > 0 Тогда
		Возврат "ЕРП";
	ИначеЕсли СтрНайти(Имя, "ДЕМО") > 0 Тогда
		Возврат "Демо";
	КонецЕсли;
	Возврат "Другая";

КонецФункции
