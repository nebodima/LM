//Онлайн-касса хозяина: сервер (чеки 54-ФЗ, этап 2.2, В61, В62).
//
//Чек пробивает библиотека подключаемого оборудования хозяина (УНФ, Бухгалтерия, Управление торговлей — одна и та же
//библиотека, сверено 30.09.2026): её касса, её драйвер, её кассовая смена и её журнал фискальных операций. Здесь —
//только перевод данных чека «Учёта занятий» (УЗ_Чеки.ДанныеЧека, простые значения) в параметры операции
//фискализации хозяина. Модули хозяина вызываются строкой через Вычислить после проверки метаданных
//(УЗ_Среда.ОнлайнКассаХозяина): прямое имя не скомпилировалось бы в программе без них. Слой совместимости, как
//УЗ_Среда, но без повторного использования значений: параметры — данные конкретного чека.

#Область ПрограммныйИнтерфейс

//Есть ли в программе хоть одна используемая онлайн-касса (элемент «Подключаемое оборудование» вида «Фискальный
//регистратор»). Рабочее место компьютера сервер не знает: к какому компьютеру она подключена, проверяет выбор
//устройства на клиенте (УЗ_СредаКлиент). Нет справочника или поля — Ложь с записью в журнал.
Функция ЕстьОнлайнКасса() Экспорт

	Если Не УЗ_Среда.ОнлайнКассаХозяина().Есть Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Оборудование.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПодключаемоеОборудование КАК Оборудование
	|ГДЕ
	|	Оборудование.ТипОборудования = ЗНАЧЕНИЕ(Перечисление.ТипыПодключаемогоОборудования.ФискальныйРегистратор)
	|	И Оборудование.УстройствоИспользуется
	|	И НЕ Оборудование.ПометкаУдаления";
	Попытка
		Возврат Не Запрос.Выполнить().Пустой();
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Учёт занятий.Чеки'"), УровеньЖурналаРегистрации.Предупреждение, , ,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ложь;
	КонецПопытки;

КонецФункции

//Системы налогообложения онлайн-кассы хозяина (перечисление ТипыСистемНалогообложенияККТ) — СписокЗначений:
//значение — имя значения перечисления, представление — его синоним. Без подсистемы — пустой список.
Функция СистемыНалогообложения() Экспорт

	Список = Новый СписокЗначений;
	Перечисление = Метаданные.Перечисления.Найти("ТипыСистемНалогообложенияККТ");
	Если Перечисление = Неопределено Тогда
		Возврат Список;
	КонецЕсли;
	Для Каждого Значение Из Перечисление.ЗначенияПеречисления Цикл
		Список.Добавить(Значение.Имя, Значение.Синоним);
	КонецЦикла;
	Возврат Список;

КонецФункции

//Параметры операции фискализации чека хозяина (ОборудованиеЧекопечатающиеУстройстваКлиентСервер
//.ПараметрыОперацииФискализацииЧека) по данным чека УЗ_Чеки.ДанныеЧека. Значения перечислений хозяина — по именам
//(ПризнакиСпособаРасчета.ПредоплатаПолная, ПризнакиПредметаРасчета.Услуга…); ставка НДС — Неопределено («без
//НДС»). Вызывающий заранее проверил УЗ_Среда.ОнлайнКассаХозяина().
Функция ПараметрыЧекаХозяина(ДанныеЧека) Экспорт

	Параметры = Вычислить("ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОперацииФискализацииЧека()");
	Параметры.ДокументОснование = ДанныеЧека.Документ;
	Параметры.Организация = ДанныеЧека.Организация;
	Параметры.ОрганизацияНазвание = ДанныеЧека.ОрганизацияНазвание;
	Параметры.ОрганизацияИНН = ДанныеЧека.ОрганизацияИНН;
	Параметры.Кассир = ДанныеЧека.Кассир;
	Параметры.ТипРасчета = ЗначениеХозяина("ТипыРасчетаДенежнымиСредствами",
		?(ДанныеЧека.ТипРасчета = "ВозвратПрихода", "ВозвратДенежныхСредств", "ПриходДенежныхСредств"));
	Параметры.СистемаНалогообложения = ЗначениеХозяина("ТипыСистемНалогообложенияККТ",
		ДанныеЧека.СистемаНалогообложения);
	Параметры.Электронно = ДанныеЧека.Электронно;
	Параметры.ПокупательEmail = ДанныеЧека.ПокупательEmail;
	Параметры.ПокупательНомер = ДанныеЧека.ПокупательНомер;
	Для Каждого Позиция Из ДанныеЧека.Позиции Цикл
		СтрокаЧека = Вычислить("ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыФискальнойСтрокиЧека()");
		СтрокаЧека.НомерСтрокиТовара = Параметры.ПозицииЧека.Количество() + 1;
		СтрокаЧека.Наименование = Позиция.Наименование;
		СтрокаЧека.Количество = Позиция.Количество;
		СтрокаЧека.Цена = Позиция.Цена;
		СтрокаЧека.ЦенаСоСкидками = Позиция.Цена;
		СтрокаЧека.Сумма = Позиция.Сумма;
		СтрокаЧека.СуммаСкидок = 0;
		СтрокаЧека.СтавкаНДС = Неопределено;
		СтрокаЧека.СуммаНДС = 0;
		СтрокаЧека.ПризнакСпособаРасчета = ЗначениеХозяина("ПризнакиСпособаРасчета", Позиция.СпособРасчета);
		СтрокаЧека.ПризнакПредметаРасчета = ЗначениеХозяина("ПризнакиПредметаРасчета", Позиция.ПредметРасчета);
		Параметры.ПозицииЧека.Добавить(СтрокаЧека);
	КонецЦикла;
	Оплата = Вычислить("ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыСтрокиОплаты(0)");
	Оплата.Сумма = ДанныеЧека.Сумма;
	Оплата.ТипОплаты = ЗначениеХозяина("ТипыОплатыККТ", ДанныеЧека.ВидОплаты);
	Параметры.ТаблицаОплат.Добавить(Оплата);
	Возврат Параметры;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//Значение перечисления хозяина по именам: исключение с понятным текстом, если такого значения у хозяина нет.
Функция ЗначениеХозяина(ИмяПеречисления, ИмяЗначения)

	Перечисление = Метаданные.Перечисления.Найти(ИмяПеречисления);
	Если Перечисление = Неопределено Или Перечисление.ЗначенияПеречисления.Найти(ИмяЗначения) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'В программе нет значения «%1» перечисления «%2» онлайн-кассы.'"),
			ИмяЗначения, ИмяПеречисления);
	КонецЕсли;
	Возврат ПредопределенноеЗначение("Перечисление." + ИмяПеречисления + "." + ИмяЗначения);

КонецФункции

#КонецОбласти
