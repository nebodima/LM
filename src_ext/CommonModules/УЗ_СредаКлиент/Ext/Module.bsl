//Онлайн-касса хозяина: клиент (чеки 54-ФЗ, этап 2.2, В61).
//
//Выбор кассы рабочего места и фискализация чека — библиотекой подключаемого оборудования хозяина (УНФ, Бухгалтерия,
//Управление торговлей): её форма выбора, её драйвер и кассовая смена, её журнал фискальных операций. Клиентские
//модули хозяина получаем строкой (МодульХозяина) — только после проверки на сервере
//(УЗ_Среда.ОнлайнКассаХозяина, УЗ_Чеки.ПодготовитьЧек): прямое имя не скомпилировалось бы в программе без них.
//Слой совместимости, как УЗ_Среда: только здесь клиентский код «Учёта занятий» обращается к модулям хозяина.

#Область ПрограммныйИнтерфейс

//Выбрать онлайн-кассу рабочего места и пробить на ней чек. ПараметрыОперации — УЗ_Чеки.ПодготовитьЧек.
//Оповещение получает Структуру: Успех, ОписаниеОшибки, НомерЧека, НомерСмены, ФискальныйПризнак, ДатаЧека, Устройство.
Процедура НачатьФискализациюЧека(Оповещение, ИдентификаторКлиента, ПараметрыОперации) Экспорт

	Контекст = Новый Структура("Оповещение, ИдентификаторКлиента, ПараметрыОперации, Устройство", Оповещение,
		ИдентификаторКлиента, ПараметрыОперации, Неопределено);
	ТипыОборудования = Новый Массив;
	ТипыОборудования.Добавить("ФискальныйРегистратор");
	Попытка
		МодульХозяина("МенеджерОборудованияКлиент").ВыбратьУстройство(
			Новый ОписаниеОповещения("ФискализацияУстройствоВыбрано", ЭтотОбъект, Контекст), ТипыОборудования,
			НСтр("ru = 'Выберите онлайн-кассу'"),
			НСтр("ru = 'К этому компьютеру не подключена онлайн-касса (Администрирование → Подключаемое оборудование, "
			+ "рабочее место этого компьютера).'"),
			НСтр("ru = 'Касса не выбрана.'"));
	Исключение
		Завершить(Контекст, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//Касса выбрана (МенеджерОборудованияКлиент.ВыбратьУстройство) — пробить на ней чек.
Процедура ФискализацияУстройствоВыбрано(Результат, Контекст) Экспорт

	Если ТипЗнч(Результат) <> Тип("Структура") Или Не Результат.Свойство("Результат") Или Не Результат.Результат Тогда
		Завершить(Контекст, ?(ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("ОписаниеОшибки"),
			Результат.ОписаниеОшибки, НСтр("ru = 'Касса не выбрана.'")));
		Возврат;
	КонецЕсли;
	Контекст.Устройство = Результат.ИдентификаторУстройства;
	Попытка
		МодульХозяина("ОборудованиеЧекопечатающиеУстройстваКлиент").НачатьФискализациюЧекаНаФискальномУстройстве(
			Новый ОписаниеОповещения("ФискализацияЗавершена", ЭтотОбъект, Контекст), Контекст.ИдентификаторКлиента,
			Контекст.Устройство, Контекст.ПараметрыОперации);
	Исключение
		Завершить(Контекст, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

//Ответ кассы: номер чека, смены, фискальный признак — в итог для УЗ_Чеки.ОтметитьЧек.
Процедура ФискализацияЗавершена(Результат, Контекст) Экспорт

	Если ТипЗнч(Результат) <> Тип("Структура") Или Не Результат.Свойство("Результат") Тогда
		Завершить(Контекст, НСтр("ru = 'Касса не вернула результат.'"));
		Возврат;
	КонецЕсли;
	Если Не Результат.Результат Тогда
		Завершить(Контекст, ?(Результат.Свойство("ОписаниеОшибки"), Результат.ОписаниеОшибки,
			НСтр("ru = 'Касса отказала без описания.'")));
		Возврат;
	КонецЕсли;
	Итог = НовыйИтог(Истина, "", Контекст.Устройство);
	Для Каждого Поле Из СтрРазделить("НомерЧекаККТ:НомерЧека,НомерСменыККТ:НомерСмены,ФискальныйПризнак:"
		+ "ФискальныйПризнак,ДатаВремяЧека:ДатаЧека", ",") Цикл
		Имена = СтрРазделить(Поле, ":");
		Значение = Неопределено;
		Если Результат.Свойство(Имена[0], Значение) И Значение <> Неопределено Тогда
			Итог[Имена[1]] = Значение;
		КонецЕсли;
	КонецЦикла;
	ВыполнитьОбработкуОповещения(Контекст.Оповещение, Итог);

КонецПроцедуры

Процедура Завершить(Контекст, ОписаниеОшибки)

	ВыполнитьОбработкуОповещения(Контекст.Оповещение, НовыйИтог(Ложь, ОписаниеОшибки, Контекст.Устройство));

КонецПроцедуры

Функция НовыйИтог(Успех, ОписаниеОшибки, Устройство)

	Возврат Новый Структура("Успех, ОписаниеОшибки, НомерЧека, НомерСмены, ФискальныйПризнак, ДатаЧека, Устройство",
		Успех, Строка(ОписаниеОшибки), "", "", "", Неопределено, Устройство);

КонецФункции

//Клиентский общий модуль хозяина по имени (вызывающий заранее проверил, что он есть).
Функция МодульХозяина(ИмяМодуля)

	Возврат Вычислить(ИмяМодуля);

КонецФункции

#КонецОбласти
