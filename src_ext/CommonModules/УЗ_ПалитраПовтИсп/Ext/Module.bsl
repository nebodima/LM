//Палитра «Учёта занятий»: значения цветов и шрифтов — в элементах стиля УЗ_* (StyleItems), формы и макеты
//ссылаются на них как style:УЗ_…, а код получает их только здесь (docs\визуал\дизайнер.md, раздел 3). На клиенте
//коллекций ЦветаСтиля и ШрифтыСтиля нет — клиент получает палитру вызовом сервера, один раз за сеанс.

#Область ПрограммныйИнтерфейс

//Цвета стиля: Структура «имя без префикса УЗ_ → Цвет» («ЦветПлюсаДенег», «ФонШапки»…).
Функция Цвета() Экспорт

	Цвета = Новый Структура;
	Цвета.Вставить("ЦветПлюсаДенег", ЦветСтиля(ЦветаСтиля.УЗ_ЦветПлюсаДенег, "УЗ_ЦветПлюсаДенег"));
	Цвета.Вставить("ЦветМинусаДенег", ЦветСтиля(ЦветаСтиля.УЗ_ЦветМинусаДенег, "УЗ_ЦветМинусаДенег"));
	Цвета.Вставить("ЦветПояснения", ЦветСтиля(ЦветаСтиля.УЗ_ЦветПояснения, "УЗ_ЦветПояснения"));
	Цвета.Вставить("ЦветТекстаНаЗаливке", ЦветСтиля(ЦветаСтиля.УЗ_ЦветТекстаНаЗаливке, "УЗ_ЦветТекстаНаЗаливке"));
	Цвета.Вставить("ЦветЛинийСетки", ЦветСтиля(ЦветаСтиля.УЗ_ЦветЛинийСетки, "УЗ_ЦветЛинийСетки"));
	Цвета.Вставить("ЦветТекстаНаТемном", ЦветСтиля(ЦветаСтиля.УЗ_ЦветТекстаНаТемном, "УЗ_ЦветТекстаНаТемном"));
	Цвета.Вставить("ФонПлюса", ЦветСтиля(ЦветаСтиля.УЗ_ФонПлюса, "УЗ_ФонПлюса"));
	Цвета.Вставить("ФонИзменения", ЦветСтиля(ЦветаСтиля.УЗ_ФонИзменения, "УЗ_ФонИзменения"));
	Цвета.Вставить("ФонУдаления", ЦветСтиля(ЦветаСтиля.УЗ_ФонУдаления, "УЗ_ФонУдаления"));
	Цвета.Вставить("ФонНеактивного", ЦветСтиля(ЦветаСтиля.УЗ_ФонНеактивного, "УЗ_ФонНеактивного"));
	Цвета.Вставить("ФонШапки", ЦветСтиля(ЦветаСтиля.УЗ_ФонШапки, "УЗ_ФонШапки"));
	Цвета.Вставить("ФонУрокаБезЦвета", ЦветСтиля(ЦветаСтиля.УЗ_ФонУрокаБезЦвета, "УЗ_ФонУрокаБезЦвета"));
	Цвета.Вставить("ФонРабочихЧасов", ЦветСтиля(ЦветаСтиля.УЗ_ФонРабочихЧасов, "УЗ_ФонРабочихЧасов"));
	Цвета.Вставить("ФонНапоминания", ЦветСтиля(ЦветаСтиля.УЗ_ФонНапоминания, "УЗ_ФонНапоминания"));
	Возврат Новый ФиксированнаяСтруктура(Цвета);

КонецФункции

//Шрифты стиля: Структура «имя без префикса УЗ_ → Шрифт» («ШрифтПечати», «ШрифтЗаголовкаПечати»…).
Функция Шрифты() Экспорт

	Шрифты = Новый Структура;
	Шрифты.Вставить("ШрифтЗаголовка", ШрифтСтиля(ШрифтыСтиля.УЗ_ШрифтЗаголовка, "УЗ_ШрифтЗаголовка"));
	Шрифты.Вставить("ШрифтПечати", ШрифтСтиля(ШрифтыСтиля.УЗ_ШрифтПечати, "УЗ_ШрифтПечати"));
	Шрифты.Вставить("ШрифтПечатиЖирный", ШрифтСтиля(ШрифтыСтиля.УЗ_ШрифтПечатиЖирный, "УЗ_ШрифтПечатиЖирный"));
	Шрифты.Вставить("ШрифтЗаголовкаПечати", ШрифтСтиля(ШрифтыСтиля.УЗ_ШрифтЗаголовкаПечати, "УЗ_ШрифтЗаголовкаПечати"));
	Возврат Новый ФиксированнаяСтруктура(Шрифты);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//Цвет стиля; во внешнем соединении и фоновом задании стиля нет (цвет «авто», компоненты −1) — тогда значение
//элемента стиля из метаданных (то же значение: чужие стили элементы стиля расширения не переопределяют).
Функция ЦветСтиля(Цвет, ИмяЭлемента)

	Если Цвет.Красный >= 0 Тогда
		Возврат Цвет;
	КонецЕсли;
	Возврат Метаданные.ЭлементыСтиля.Найти(ИмяЭлемента).Значение;

КонецФункции

//Шрифт стиля; без стиля (внешнее соединение, фоновое задание) — значение элемента стиля из метаданных.
Функция ШрифтСтиля(Шрифт, ИмяЭлемента)

	Если Шрифт.Размер > 0 Или Не ПустаяСтрока(Шрифт.Имя) Тогда
		Возврат Шрифт;
	КонецЕсли;
	Возврат Метаданные.ЭлементыСтиля.Найти(ИмяЭлемента).Значение;

КонецФункции

#КонецОбласти
