Функция РеквизитыСчета(Счет)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Счета.Статус КАК Статус,
	|	Счета.Организация КАК Организация,
	|	Счета.Плательщик КАК Плательщик,
	|	Счета.СуммаДокумента КАК СуммаДокумента,
	|	Счета.ИдентификаторQR КАК ИдентификаторQR,
	|	Счета.СсылкаНаОплату КАК СсылкаНаОплату,
	|	Счета.СрокДействия КАК СрокДействия,
	|	Счета.ДатаОплаты КАК ДатаОплаты,
	|	Счета.ИдОперацииБанка КАК ИдОперацииБанка,
	|	Счета.ПриходДенег КАК ПриходДенег,
	|	Счета.КартинкаQR КАК КартинкаQR
	|ИЗ
	|	Документ.УЗ_СчетНаОплатуQR КАК Счета
	|ГДЕ
	|	Счета.Ссылка = &Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Строки.Ученик КАК Ученик,
	|	Строки.Сумма КАК Сумма
	|ИЗ
	|	Документ.УЗ_СчетНаОплатуQR.Расшифровка КАК Строки
	|ГДЕ
	|	Строки.Ссылка = &Счет
	|
	|УПОРЯДОЧИТЬ ПО
	|	Строки.НомерСтроки";
	Запрос.УстановитьПараметр("Счет", Счет);
	Пакет = Запрос.ВыполнитьПакет();
	Выборка = Пакет[0].Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Счёт на оплату по QR не найден: %1'"), Счет);
	КонецЕсли;
	Итог = Новый Структура("Статус, Организация, Плательщик, СуммаДокумента, ИдентификаторQR, СсылкаНаОплату,
		|СрокДействия, ДатаОплаты, ИдОперацииБанка, ПриходДенег, КартинкаQR");
	ЗаполнитьЗначенияСвойств(Итог, Выборка);
	Итог.Вставить("Расшифровка", Пакет[1].Выгрузить());
	Возврат Итог;

КонецФункции

Процедура ЗаписатьСтатус(Счет, Статус, ТекстОшибки)

	Объект = Счет.ПолучитьОбъект();
	Объект.Статус = Статус;
	Объект.ТекстОшибки = Лев(ТекстОшибки, 500);
	ЗаписатьСлужебно(Объект);

КонецПроцедуры

//Запись служебных полей счёта (статус, QR, приход) мимо запрета правки выставленного счёта и мимо даты запрета:
//оплату банк подтверждает, когда подтверждает, — счёт вчерашнего закрытого дня всё равно становится «Оплачен»
//(сам приход — датой оплаты, его дата запрета проверяет как обычно).
Процедура ЗаписатьСлужебно(Объект)

	Объект.ДополнительныеСвойства.Вставить(КлючСлужебнойЗаписи(), Истина);
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();

КонецПроцедуры

//Приход с основанием — этим счётом (не помеченный на удаление): его и считаем оплатой, второй не создаём.
Функция ПриходПоСчету(Счет)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Приходы.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УЗ_ПриходДенег КАК Приходы
	|ГДЕ
	|	Приходы.ДокументОснования = &Счет
	|	И НЕ Приходы.ПометкаУдаления";
	Запрос.УстановитьПараметр("Счет", Счет);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Документы.УЗ_ПриходДенег.ПустаяСсылка());

КонецФункции

//Приход денег по оплате: «Касса ученики», касса поступлений по QR, расшифровка по ученикам из счёта (одна строка —
//полями шапки: так приход с одной строкой устроен всегда, СинхронизироватьРасшифровку), проводится.
Функция СоздатьПриход(Объект, ДанныеОплаты, ДатаОплаты)

	Причина = "";
	Параметры = УЗ_ПровайдерыОплатQR.ПараметрыБанка(Объект.Организация, Причина);
	Если Параметры = Неопределено Тогда
		ВызватьИсключение Причина;
	КонецЕсли;
	Причина = ПричинаКассы(Параметры);
	Если Не ПустаяСтрока(Причина) Тогда
		ВызватьИсключение Причина;
	КонецЕсли;
	Приход = Документы.УЗ_ПриходДенег.СоздатьДокумент();
	Приход.Заполнить(Неопределено);
	Приход.Дата = ДатаОплаты;
	Приход.Организация = Объект.Организация;
	Приход.Касса = Параметры.Касса;
	Приход.ВидОперации = Перечисления.УЗ_ВидыОпераций.КассаУченики;
	Приход.Плательщик = Объект.Плательщик;
	Приход.ДокументОснования = Объект.Ссылка;
	Приход.АвторДокумента = Объект.АвторДокумента;
	Приход.НазначениеПлатежа = СтрШаблон(НСтр("ru = 'Оплата по QR (СБП) по счёту № %1 от %2%3'"), СокрЛП(Объект.Номер),
		Формат(Объект.Дата, "ДФ=dd.MM.yyyy"), ?(ПустаяСтрока(ДанныеОплаты.ИдОперации), "",
			", операция " + ДанныеОплаты.ИдОперации));
	Приход.Комментарий = Лев(Приход.НазначениеПлатежа, 255);
	Если Объект.Расшифровка.Количество() = 1 Тогда
		СтрокаОплаты = Объект.Расшифровка[0];
		Приход.ФизЛицо = СтрокаОплаты.Ученик;
		Приход.ПредметОбучения = СтрокаОплаты.ПредметОбучения;
		Приход.Абонемент = СтрокаОплаты.Абонемент;
		Приход.Тариф = СтрокаОплаты.Тариф;
		Приход.СуммаДокумента = СтрокаОплаты.Сумма;
	Иначе
		Для Каждого СтрокаОплаты Из Объект.Расшифровка Цикл
			ЗаполнитьЗначенияСвойств(Приход.РасшифровкаПлатежа.Добавить(), СтрокаОплаты,
				"Ученик, ПредметОбучения, Абонемент, Тариф, Сумма");
		КонецЦикла;
		Приход.СуммаДокумента = Объект.Расшифровка.Итог("Сумма");
	КонецЕсли;
	Приход.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Возврат Приход.Ссылка;

КонецФункции

//Текст ошибки проведения прихода: сообщения проверок (касса, абонемент, дата запрета) — они понятнее «Операция не
//выполнена».
Функция ТекстОшибкиПрихода(Информация)

	Тексты = Новый Массив;
	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Тексты.Добавить(Сообщение.Текст);
	КонецЦикла;
	Если Тексты.Количество() = 0 Тогда
		Тексты.Добавить(КраткоеПредставлениеОшибки(Информация));
	КонецЕсли;
	Возврат СтрСоединить(Тексты, " ");

КонецФункции

Функция ОжидающиеСчета(Счета)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Счета.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УЗ_СчетНаОплатуQR КАК Счета
	|ГДЕ
	|	НЕ Счета.ПометкаУдаления
	|	И (&ВсеСчета
	|			ИЛИ Счета.Ссылка В (&Счета))
	|	И (Счета.Статус = ЗНАЧЕНИЕ(Перечисление.УЗ_СтатусыОплатыQR.Ожидает)
	|			ИЛИ Счета.Статус = ЗНАЧЕНИЕ(Перечисление.УЗ_СтатусыОплатыQR.Отменен)
	|				И Счета.СрокДействия > &Граница
	|			ИЛИ Счета.Статус = ЗНАЧЕНИЕ(Перечисление.УЗ_СтатусыОплатыQR.Оплачен)
	|				И Счета.ПриходДенег = ЗНАЧЕНИЕ(Документ.УЗ_ПриходДенег.ПустаяСсылка))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Счета.Дата";
	Запрос.УстановитьПараметр("ВсеСчета", Счета = Неопределено);
	Запрос.УстановитьПараметр("Счета", ?(Счета = Неопределено, Новый Массив, Счета));
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() - ЗапасСрокаСекунд());
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

