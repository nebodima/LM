//Организации, где у учеников есть долг (остаток денег < 0), — по наименованию.
Функция ОрганизацииСДолгом(Ученики)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Организация КАК Организация,
	|	Остатки.Организация.Наименование КАК Наименование
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки.Остатки(, Клиент В (&Ученики)) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Организация,
	|	Остатки.Организация.Наименование
	|
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.СуммаОстаток) < 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Запрос.УстановитьПараметр("Ученики", Ученики);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Организация");

КонецФункции

//Строка ответа бота по одной организации: ссылка на оплату долга или почему нельзя.
Функция СтрокаОплатыБота(Плательщик, Ученики, Организация)

	Строки = СтрокиПоДолгам(Ученики, Организация);
	Сумма = 0;
	Для Каждого СтрокаОплаты Из Строки Цикл
		Сумма = Сумма + СтрокаОплаты.Сумма;
	КонецЦикла;
	Если Сумма <= 0 Тогда
		Возврат СтрШаблон(НСтр("ru = '«%1»: долга нет.'"), Организация);
	КонецЕсли;
	Если Не ПустаяСтрока(ПричинаНеготовности(Организация)) Тогда
		Возврат СтрШаблон(НСтр("ru = '«%1»: долг %2 руб. Оплата по ссылке не подключена — оплатите у администратора.'"),
			Организация, Формат(Сумма, "ЧДЦ=2; ЧН=0,00"));
	КонецЕсли;
	Счет = ДействующийСчетБота(Плательщик, Организация, Сумма);
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Объект = Документы.УЗ_СчетНаОплатуQR.СоздатьДокумент();
		Объект.Дата = ТекущаяДатаСеанса();
		Объект.Организация = Организация;
		Объект.Плательщик = Плательщик;
		Объект.Комментарий = НСтр("ru = 'Бот Telegram: /оплатить'");
		Для Каждого СтрокаОплаты Из Строки Цикл
			ЗаполнитьЗначенияСвойств(Объект.Расшифровка.Добавить(), СтрокаОплаты);
		КонецЦикла;
		Объект.Записать();
		Счет = Объект.Ссылка;
	КонецЕсли;
	Выставлено = ВыставитьQRСчета(Счет);
	Если Не Выставлено.Успех Тогда
		ЗаписьЖурналаРегистрации(УЗ_ПровайдерыОплатQR.СобытиеОшибки(), УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Документы.УЗ_СчетНаОплатуQR, Счет, Выставлено.ТекстОшибки);
		Возврат СтрШаблон(НСтр("ru = '«%1»: долг %2 руб. Ссылку на оплату получить не удалось — попробуйте позже или
			|оплатите у администратора.'"), Организация, Формат(Сумма, "ЧДЦ=2; ЧН=0,00"));
	КонецЕсли;
	Возврат ТекстСсылки(Счет);

КонецФункции

//Счёт этого плательщика и организации на ту же сумму, чей QR ещё действует не меньше 5 минут.
Функция ДействующийСчетБота(Плательщик, Организация, Сумма)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Счета.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УЗ_СчетНаОплатуQR КАК Счета
	|ГДЕ
	|	Счета.Плательщик = &Плательщик
	|	И Счета.Организация = &Организация
	|	И Счета.СуммаДокумента = &Сумма
	|	И Счета.Статус = ЗНАЧЕНИЕ(Перечисление.УЗ_СтатусыОплатыQR.Ожидает)
	|	И Счета.СрокДействия > &Граница
	|	И НЕ Счета.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Счета.СрокДействия УБЫВ";
	Запрос.УстановитьПараметр("Плательщик", Плательщик);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Сумма", Сумма);
	Запрос.УстановитьПараметр("Граница", ТекущаяДатаСеанса() + 300);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, Документы.УЗ_СчетНаОплатуQR.ПустаяСсылка());

КонецФункции

