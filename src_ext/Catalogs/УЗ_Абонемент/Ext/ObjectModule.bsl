
//Копия — новый абонемент: без наименования (составится само), цены, активации и приостановок оригинала;
//карточка заполнит сроки, уроки и цену заново из тарифа
Процедура ПриКопировании(ОбъектКопирования)
	Наименование = "";
	ЦенаАбонемента = 0;
	ДатаАктивации = Неопределено;
	Приостановки.Очистить();
	ДатаНачала = Неопределено;
	ДатаОкончания = Неопределено;
	Активный = Неопределено;
	КоличествоЗанятий = Неопределено;
	КоличествоЧасов = Неопределено;
	Комментарий = Неопределено;
КонецПроцедуры

//Наименование обязательно и уникально — не заполнили руками, составляем сами (до проверки заполнения).
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ПустаяСтрока(Наименование) Тогда
		Наименование = Справочники.УЗ_Абонемент.АвтоНаименование(ФизЛицо, ДатаНачала, Ссылка);
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ЗначениеЗаполнено(ДатаНачала) и ДатаНачала > ДатаОкончания Тогда
		Сообщить("Ошибка! Дата начала больше даты окончания!");
		Отказ = Истина;
	КонецЕсли;
	
	Если Активный Тогда
		
		// Проверка по сроку абонемента — та же, что в карточке (Справочники.УЗ_Абонемент.ОшибкаПриостановки)
		Для Каждого СтрПриостановка из Приостановки Цикл
			ТекстОшибки = Справочники.УЗ_Абонемент.ОшибкаПриостановки(ЭтотОбъект,
				СтрПриостановка.ДатаПриостановки, СтрПриостановка.ДатаВозобновления);
			Если ЗначениеЗаполнено(ТекстОшибки) Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Ошибка в датах приостановки, строка " + СтрПриостановка.НомерСтроки + ": " + ТекстОшибки;
				Сообщение.Поле = "Приостановки[" + Формат(СтрПриостановка.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ДатаПриостановки";
				Сообщение.УстановитьДанные(ЭтотОбъект);
				Сообщение.Сообщить();
				Отказ = Истина;
			КонецЕсли;
		КонецЦикла;
		
		// Проверка по пересечениям приостановок
		Для Каждого ПроверяемаяПриостановка из Приостановки Цикл 			
			
			Для Каждого СтрПриостановка из Приостановки Цикл 			
				
				Если ПроверяемаяПриостановка.НомерСтроки = СтрПриостановка.НомерСтроки Тогда
					Продолжить;
				КонецЕсли;
				
				Если ПроверяемаяПриостановка.ДатаПриостановки >= СтрПриостановка.ДатаПриостановки и ПроверяемаяПриостановка.ДатаПриостановки < СтрПриостановка.ДатаВозобновления Тогда
					Сообщить("Ошибка в датах приостановок! Строка: " +СтрПриостановка.НомерСтроки);
					Отказ = Истина;
				КонецЕсли;
				Если ПроверяемаяПриостановка.ДатаВозобновления >= СтрПриостановка.ДатаПриостановки и ПроверяемаяПриостановка.ДатаВозобновления < СтрПриостановка.ДатаВозобновления Тогда
					Сообщить("Ошибка в датах приостановок! Строка: " +СтрПриостановка.НомерСтроки);
					Отказ = Истина;
				КонецЕсли;
			КонецЦикла;		
		КонецЦикла;
	КонецЕсли;             	

КонецПроцедуры
