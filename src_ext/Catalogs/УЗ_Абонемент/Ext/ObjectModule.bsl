
//Копия — новый абонемент: без наименования (составится само), цены, активации и приостановок оригинала;
//карточка заполнит сроки, уроки и цену заново из тарифа
Процедура ПриКопировании(ОбъектКопирования)
	Наименование = "";
	ЦенаАбонемента = 0;
	ДатаАктивации = Неопределено;
	Приостановки.Очистить();
	ДатаНачала = Неопределено;
	ДатаОкончания = Неопределено;
	Активный = Неопределено;
	КоличествоЗанятий = Неопределено;
	КоличествоЧасов = Неопределено;
	Комментарий = Неопределено;
КонецПроцедуры

//В12: новый абонемент — в организации из настроек учёта (как ПКО и урок); пустая организация — любая.
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если ЭтоНовый() И Не ЗначениеЗаполнено(Организация) Тогда
		Организация = РегистрыСведений.УЗ_Настройки.Настройки().Организация;
	КонецЕсли;

КонецПроцедуры

//Наименование обязательно и уникально — не заполнили руками, составляем сами (до проверки заполнения).
Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ПустаяСтрока(Наименование) Тогда
		Наименование = Справочники.УЗ_Абонемент.АвтоНаименование(ФизЛицо, ДатаНачала, Ссылка);
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	//пустая дата окончания — бессрочный абонемент (Р-1: прежде пустая дата давала отказ «дата начала больше»)
	Если ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаОкончания) И ДатаНачала > ДатаОкончания Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Дата начала абонемента больше даты окончания'");
		Сообщение.Поле = "ДатаОкончания";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЕсли;

	//«Активный» без даты активации (загрузка, обработка) урок, помощник и панель считали по-разному (Р-6):
	//активный абонемент всегда с датой активации
	Если Активный И Не ЗначениеЗаполнено(ДатаАктивации) Тогда
		ДатаАктивации = ТекущаяДатаСеанса();
	КонецЕсли;

	//даты приостановок — у любого абонемента, не только активного (З-9): каждая строка — одним правилом с окном
	//карточки (срок, проведённые уроки — В17), пересечения — полуинтервалами, бессрочная участвует (З-1, З-2)
	Для Каждого Ошибка Из Справочники.УЗ_Абонемент.ОшибкиПриостановок(ЭтотОбъект) Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон(НСтр("ru = 'Ошибка в датах приостановки, строка %1: %2'"), Ошибка.НомерСтроки, Ошибка.Текст);
		Сообщение.Поле = "Приостановки[" + Формат(Ошибка.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ДатаПриостановки";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;

КонецПроцедуры
