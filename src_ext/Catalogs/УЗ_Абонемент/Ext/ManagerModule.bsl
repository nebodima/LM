
Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Статус = "";
	
	Если Данные.Ссылка.Активный Тогда

		//приостановка — по тому же правилу, что у урока и карточки (с первого дня по день возобновления не включая)
		Состояние = СостояниеАбонемента(Данные.Ссылка, ТекущаяДатаСеанса());
		Если Состояние.Приостановлен Тогда
			Статус = ?(ЗначениеЗаполнено(Состояние.ДатаВозобновления),
				" (приостановлен до " + Формат(Состояние.ДатаВозобновления, "ДФ=dd.MM.yy") + ")", " (приостановлен)");
		КонецЕсли;

	Иначе
		Статус = " (НЕАКТИВНЫЙ)";
	КонецЕсли;
	
	Представление = Данные.Ссылка.Наименование+ Статус; 
	
КонецПроцедуры

//Наименование абонемента по умолчанию: «Кузнецов Михаил с 28.09.26» (длина наименования — 30,
//оно уникально: у второго абонемента того же ученика с той же даты — « (2)», « (3)» …).
//  Исключить — ссылка самого абонемента (при перезаписи он не мешает сам себе).
Функция АвтоНаименование(ФизЛицо, ДатаНачала, Исключить = Неопределено) Экспорт

	Длина = Метаданные.Справочники.УЗ_Абонемент.ДлинаНаименования;
	Хвост = ?(ЗначениеЗаполнено(ДатаНачала), " с " + Формат(ДатаНачала, "ДФ=dd.MM.yy"), "");
	Имя = ?(ЗначениеЗаполнено(ФизЛицо), СокрЛП(ФизЛицо.Наименование), НСтр("ru = 'Абонемент'"));
	Основа = Лев(Имя, Длина - СтрДлина(Хвост) - 4) + Хвост;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Абонементы.Наименование КАК Наименование
	|ИЗ
	|	Справочник.УЗ_Абонемент КАК Абонементы
	|ГДЕ
	|	Абонементы.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
	|	И Абонементы.Ссылка <> &Исключить";
	Запрос.УстановитьПараметр("Шаблон", ЭкранироватьДляПодобно(Основа) + "%");
	Запрос.УстановитьПараметр("Исключить", ?(ЗначениеЗаполнено(Исключить), Исключить, Справочники.УЗ_Абонемент.ПустаяСсылка()));
	Занятые = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Наименование");

	Итог = Основа;
	Номер = 1;
	Пока Занятые.Найти(Итог) <> Неопределено Цикл
		Номер = Номер + 1;
		Итог = Основа + " (" + Номер + ")";
	КонецЦикла;
	Возврат Итог;

КонецФункции

Функция ЭкранироватьДляПодобно(Текст)

	Итог = Текст;
	Для Каждого Знак Из СтрРазделить("~,%,_,[,]", ",") Цикл
		Итог = СтрЗаменить(Итог, Знак, "~" + Знак);
	КонецЦикла;
	Возврат Итог;

КонецФункции

//Количество уроков, часов и цена абонемента по тарифу на дату: Структура(Сумма, КоличествоЧасов,
//КоличествоУроков) или Неопределено, если цены у тарифа нет. Правило цены то же, что у урока.
Функция ЗначенияПоТарифу(Тариф, Дата) Экспорт

	Если Не ЗначениеЗаполнено(Тариф) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Документы.УЗ_Урок.ЦенаТарифаНаДату(Тариф, ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса()));

КонецФункции

//Ошибка в датах одной приостановки (одна проверка для карточки и для записи абонемента) или "".
//В4: приостановка — с даты начала включительно по дату возобновления не включая; срок абонемента продлевается
//на дни приостановок (Документы.УЗ_Урок.ДатаОкончанияАбонемента), поэтому приостановка может начаться и в
//продлённом сроке — продление дают приостановки, начатые раньше этой, — а возобновление может быть и после
//окончания. Пустая дата возобновления — приостановлен бессрочно.
//  Абонемент — абонемент, его объект или данные формы (ДатаНачала, ДатаОкончания, Приостановки).
Функция ОшибкаПриостановки(Абонемент, ДатаПриостановки, ДатаВозобновления) Экспорт

	Если Не ЗначениеЗаполнено(ДатаПриостановки) Тогда
		Возврат НСтр("ru = 'Не указана дата приостановки'");
	КонецЕсли;
	Начало = НачалоДня(ДатаПриостановки);
	Если ЗначениеЗаполнено(ДатаВозобновления) И НачалоДня(ДатаВозобновления) <= Начало Тогда
		Возврат НСтр("ru = 'Дата возобновления должна быть позже даты приостановки'");
	КонецЕсли;
	Если ЗначениеЗаполнено(Абонемент.ДатаНачала) И Начало < НачалоДня(Абонемент.ДатаНачала) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Приостановка раньше начала абонемента (%1)'"), Формат(Абонемент.ДатаНачала, "ДЛФ=D"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Абонемент.ДатаОкончания) Тогда
		Срок = НачалоДня(Абонемент.ДатаОкончания) + ДнейПриостановокДо(Абонемент, Начало) * 86400;
		Если Начало > Срок Тогда
			Возврат СтрШаблон(НСтр("ru = 'Приостановка после окончания абонемента (%1)'"), Формат(Срок, "ДЛФ=D"));
		КонецЕсли;
	КонецЕсли;
	Возврат "";

КонецФункции

//Дни приостановок, начатых раньше дня Начало, — по тому же правилу, что Документы.УЗ_Урок.ДнейПриостановкиАбонемента.
Функция ДнейПриостановокДо(Абонемент, Начало)

	Дней = 0;
	Для Каждого СтрПриостановка Из Абонемент.Приостановки Цикл
		Если Не ЗначениеЗаполнено(СтрПриостановка.ДатаПриостановки) Или Не ЗначениеЗаполнено(СтрПриостановка.ДатаВозобновления)
			Или НачалоДня(СтрПриостановка.ДатаПриостановки) >= Начало Тогда
			Продолжить;
		КонецЕсли;
		Дней = Дней + Макс(НачалоДня(СтрПриостановка.ДатаВозобновления) - НачалоДня(СтрПриостановка.ДатаПриостановки), 0) / 86400;
	КонецЦикла;
	Возврат Дней;

КонецФункции

//Состояние абонемента на дату для карточки: приостановлен ли (и до какого дня), срок с продлением на дни
//приостановок — общими функциями урока (Документы.УЗ_Урок), чтобы карточка и урок считали одинаково.
//  Абонемент — абонемент, его объект или данные формы.
Функция СостояниеАбонемента(Абонемент, НаДату) Экспорт

	Состояние = Новый Структура("Приостановлен, ДатаВозобновления, Срок, ДнейПриостановки", Ложь, '00010101', '00010101', 0);
	Если Документы.УЗ_Урок.АбонементПриостановленНаДату(Абонемент, НаДату) Тогда
		Состояние.Приостановлен = Истина;
		День = НачалоДня(НаДату);
		Для Каждого СтрПриостановка Из Абонемент.Приостановки Цикл
			Если ЗначениеЗаполнено(СтрПриостановка.ДатаПриостановки) И День >= НачалоДня(СтрПриостановка.ДатаПриостановки)
				И (Не ЗначениеЗаполнено(СтрПриостановка.ДатаВозобновления) Или День < НачалоДня(СтрПриостановка.ДатаВозобновления)) Тогда
				Состояние.ДатаВозобновления = СтрПриостановка.ДатаВозобновления;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Состояние.Срок = Документы.УЗ_Урок.ДатаОкончанияАбонемента(Абонемент);
	Состояние.ДнейПриостановки = Документы.УЗ_Урок.ДнейПриостановкиАбонемента(Абонемент);
	Возврат Состояние;

КонецФункции
