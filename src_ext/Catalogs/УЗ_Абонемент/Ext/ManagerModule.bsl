#Область ПрограммныйИнтерфейс

//Наименование абонемента по умолчанию: «Кузнецов Михаил с 28.09.26» (длина наименования — 30,
//оно уникально: у второго абонемента того же ученика с той же даты — « (2)», « (3)» …).
//  Исключить — ссылка самого абонемента (при перезаписи он не мешает сам себе).
Функция АвтоНаименование(ФизЛицо, ДатаНачала, Исключить = Неопределено) Экспорт

	Длина = Метаданные.Справочники.УЗ_Абонемент.ДлинаНаименования;
	Хвост = ?(ЗначениеЗаполнено(ДатаНачала), " с " + Формат(ДатаНачала, "ДФ=dd.MM.yy"), "");
	Имя = ?(ЗначениеЗаполнено(ФизЛицо), СокрЛП(ФизЛицо.Наименование), НСтр("ru = 'Абонемент'"));
	Основа = Лев(Имя, Длина - СтрДлина(Хвост) - 4) + Хвост;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Абонементы.Наименование КАК Наименование
	|ИЗ
	|	Справочник.УЗ_Абонемент КАК Абонементы
	|ГДЕ
	|	Абонементы.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
	|	И Абонементы.Ссылка <> &Исключить";
	Запрос.УстановитьПараметр("Шаблон", ЭкранироватьДляПодобно(Основа) + "%");
	Запрос.УстановитьПараметр("Исключить",
		?(ЗначениеЗаполнено(Исключить), Исключить, Справочники.УЗ_Абонемент.ПустаяСсылка()));
	Занятые = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Наименование");

	Итог = Основа;
	Номер = 1;
	Пока Занятые.Найти(Итог) <> Неопределено Цикл
		Номер = Номер + 1;
		Итог = Основа + " (" + Номер + ")";
	КонецЦикла;
	Возврат Итог;

КонецФункции

//Количество уроков, часов и цена абонемента по тарифу на дату: Структура(Сумма, КоличествоЧасов,
//КоличествоУроков) или Неопределено, если цены у тарифа нет. Правило цены то же, что у урока.
Функция ЗначенияПоТарифу(Тариф, Дата) Экспорт

	Если Не ЗначениеЗаполнено(Тариф) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Документы.УЗ_Урок.ЦенаТарифаНаДату(Тариф, ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса()));

КонецФункции

#Область СрокИПриостановки

//Логика абонементов и заморозок — в одном месте (здесь). Урок, помощник, панель ученика, карточка абонемента
//и продление/перевод группы зовут эти функции, своих копий правил у них нет (прежде «действующий», «остаток» и
//«приостановлен» считались в пяти местах по-разному — docs/логики/абонементы.md, заморозки.md).
//Параметр Абонемент — ссылка, объект или данные формы (реквизиты и ТЧ Приостановки).

//В4 (решение владельца 28.09.2026): число дней приостановок абонемента — на них продлевается срок.
//Приостановка — с даты начала включительно по дату возобновления не включая; без даты возобновления
//(бессрочная) срок не продлевает — абонемент приостановлен до возобновления.
Функция ДнейПриостановки(Абонемент) Экспорт

	Дней = 0;
	Для Каждого СтрПриостановка Из Абонемент.Приостановки Цикл
		Если Не ЗначениеЗаполнено(СтрПриостановка.ДатаПриостановки)
			Или Не ЗначениеЗаполнено(СтрПриостановка.ДатаВозобновления) Тогда
			Продолжить;
		КонецЕсли;
		НачалоПриостановки = НачалоДня(СтрПриостановка.ДатаПриостановки);
		Возобновление = НачалоДня(СтрПриостановка.ДатаВозобновления);
		Если Возобновление > НачалоПриостановки Тогда
			Дней = Дней + (Возобновление - НачалоПриостановки) / 86400;
		КонецЕсли;
	КонецЦикла;
	Возврат Дней;

КонецФункции

//Срок абонемента с продлением на дни приостановок (начало последнего дня срока); пустая дата — бессрочный.
Функция СрокСПродлением(Абонемент) Экспорт

	Если Не ЗначениеЗаполнено(Абонемент.ДатаОкончания) Тогда
		Возврат '00010101';
	КонецЕсли;
	Возврат НачалоДня(Абонемент.ДатаОкончания) + ДнейПриостановки(Абонемент) * 86400;

КонецФункции

//Строка приостановки, действующая на день Дата (с даты приостановки включительно по дату возобновления не
//включая; пустое возобновление — бессрочно), или Неопределено.
Функция ПриостановкаНаДату(Абонемент, Дата) Экспорт

	День = НачалоДня(Дата);
	Для Каждого СтрПриостановка Из Абонемент.Приостановки Цикл
		Если Не ЗначениеЗаполнено(СтрПриостановка.ДатаПриостановки) Тогда
			Продолжить;
		КонецЕсли;
		Если День >= НачалоДня(СтрПриостановка.ДатаПриостановки)
			И (Не ЗначениеЗаполнено(СтрПриостановка.ДатаВозобновления)
				Или День < НачалоДня(СтрПриостановка.ДатаВозобновления)) Тогда
			Возврат СтрПриостановка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

//Истина — на Дата абонемент на паузе (есть приостановка, в которую попадает дата).
Функция ПриостановленНаДату(Абонемент, Дата) Экспорт
	Возврат ПриостановкаНаДату(Абонемент, Дата) <> Неопределено;
КонецФункции

//Дата возобновления по последнему дню паузы из окна «Приостановить» («с 10.10 по 14.10» → возобновление
//15.10); пустое «по» — бессрочная приостановка (пустая дата возобновления). Прежде пустое «по» давало
//02.01.0001 и отказ «Дата возобновления должна быть позже даты приостановки» (З-3).
Функция ВозобновлениеПоПоследнемуДню(ПоследнийДень) Экспорт

	Если Не ЗначениеЗаполнено(ПоследнийДень) Тогда
		Возврат '00010101';
	КонецЕсли;
	Возврат НачалоДня(ПоследнийДень) + 86400;

КонецФункции

//Ошибка в датах одной приостановки (одна проверка для окна карточки и для записи абонемента) или "".
//В4: приостановка — с даты начала включительно по дату возобновления не включая; срок абонемента продлевается
//на дни приостановок (СрокСПродлением), поэтому приостановка может начаться и в продлённом сроке — продление
//дают приостановки, начатые раньше этой, — а возобновление может быть и после окончания. Пустая дата
//возобновления — приостановлен бессрочно.
//В17: приостановка не ложится на проведённые уроки «К оплате» по этому абонементу — в ответе перечень уроков.
//  Абонемент — абонемент, его объект или данные формы (Ссылка, ДатаНачала, ДатаОкончания, Приостановки).
Функция ОшибкаПриостановки(Абонемент, ДатаПриостановки, ДатаВозобновления) Экспорт

	Если Не ЗначениеЗаполнено(ДатаПриостановки) Тогда
		Возврат НСтр("ru = 'Не указана дата приостановки'");
	КонецЕсли;
	Начало = НачалоДня(ДатаПриостановки);
	Если ЗначениеЗаполнено(ДатаВозобновления) И НачалоДня(ДатаВозобновления) <= Начало Тогда
		Возврат НСтр("ru = 'Дата возобновления должна быть позже даты приостановки'");
	КонецЕсли;
	Если ЗначениеЗаполнено(Абонемент.ДатаНачала) И Начало < НачалоДня(Абонемент.ДатаНачала) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Приостановка раньше начала абонемента (%1)'"),
			Формат(Абонемент.ДатаНачала, "ДЛФ=D"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Абонемент.ДатаОкончания) Тогда
		Срок = НачалоДня(Абонемент.ДатаОкончания) + ДнейПриостановокДо(Абонемент, Начало) * 86400;
		Если Начало > Срок Тогда
			Возврат СтрШаблон(НСтр("ru = 'Приостановка после окончания абонемента (%1)'"), Формат(Срок, "ДЛФ=D"));
		КонецЕсли;
	КонецЕсли;
	Уроки = ПроведенныеУрокиВПериоде(Абонемент.Ссылка, Начало, ДатаВозобновления);
	Если Уроки.Количество() > 0 Тогда
		Перечень = Новый Массив;
		Для Каждого Урок Из Уроки Цикл
			Перечень.Добавить(СтрШаблон(НСтр("ru = '№ %1 от %2'"), УЗ_ОбщийКлиентСервер.НомерБезНулей(Урок.Номер),
				Формат(Урок.Дата, "ДФ=dd.MM.yyyy")));
		КонецЦикла;
		Возврат СтрШаблон(
			НСтр("ru = 'В дни приостановки уже проведены уроки по этому абонементу: %1. Приостановка поверх "
			+ "проведённых уроков запрещена — отмените проведение уроков или снимите в них абонемент'"),
			СтрСоединить(Перечень, ", "));
	КонецЕсли;
	Возврат "";

КонецФункции

//Все ошибки ТЧ «Приостановки» при записи абонемента (любого, не только активного — З-9): каждая строка по
//ОшибкаПриостановки и попарные пересечения. Пересечение — полуинтервалы [приостановка; возобновление), пустое
//возобновление — бесконечность (З-2: бессрочная тоже участвует); смежные «10→15» и «15→20» не пересекаются (З-1).
//Возврат: Массив из Структура(НомерСтроки, Текст).
Функция ОшибкиПриостановок(Абонемент) Экспорт

	Ошибки = Новый Массив;
	Для Каждого СтрПриостановка Из Абонемент.Приостановки Цикл
		ТекстОшибки =
			ОшибкаПриостановки(Абонемент, СтрПриостановка.ДатаПриостановки, СтрПриостановка.ДатаВозобновления);
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			Ошибки.Добавить(Новый Структура("НомерСтроки, Текст", СтрПриостановка.НомерСтроки, ТекстОшибки));
		КонецЕсли;
	КонецЦикла;

	Бесконечность = '39991231';
	Для Каждого Первая Из Абонемент.Приостановки Цикл
		Если Не ЗначениеЗаполнено(Первая.ДатаПриостановки) Тогда
			Продолжить;
		КонецЕсли;
		НачалоПервой = НачалоДня(Первая.ДатаПриостановки);
		КонецПервой =
			?(ЗначениеЗаполнено(Первая.ДатаВозобновления), НачалоДня(Первая.ДатаВозобновления), Бесконечность);
		Для Каждого Вторая Из Абонемент.Приостановки Цикл
			Если Вторая.НомерСтроки <= Первая.НомерСтроки Или Не ЗначениеЗаполнено(Вторая.ДатаПриостановки) Тогда
				Продолжить;
			КонецЕсли;
			НачалоВторой = НачалоДня(Вторая.ДатаПриостановки);
			КонецВторой =
				?(ЗначениеЗаполнено(Вторая.ДатаВозобновления), НачалоДня(Вторая.ДатаВозобновления), Бесконечность);
			Если НачалоПервой < КонецВторой И НачалоВторой < КонецПервой Тогда
				Ошибки.Добавить(Новый Структура("НомерСтроки, Текст", Вторая.НомерСтроки,
					СтрШаблон(НСтр("ru = 'приостановка пересекается с приостановкой в строке %1'"),
						Первая.НомерСтроки)));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ошибки;

КонецФункции

//Дни приостановок, начатых раньше дня Начало, — по тому же правилу, что ДнейПриостановки.
Функция ДнейПриостановокДо(Абонемент, Начало)

	Дней = 0;
	Для Каждого СтрПриостановка Из Абонемент.Приостановки Цикл
		Если Не ЗначениеЗаполнено(СтрПриостановка.ДатаПриостановки)
			Или Не ЗначениеЗаполнено(СтрПриостановка.ДатаВозобновления)
			Или НачалоДня(СтрПриостановка.ДатаПриостановки) >= Начало Тогда
			Продолжить;
		КонецЕсли;
		Дней = Дней
			+ Макс(НачалоДня(СтрПриостановка.ДатаВозобновления) - НачалоДня(СтрПриостановка.ДатаПриостановки),
			0) / 86400;
	КонецЦикла;
	Возврат Дней;

КонецФункции

//Проведённые уроки со строкой «К оплате» по абонементу с дня Начало по день возобновления не включая
//(пустое возобновление — все после начала). Новый абонемент (пустая ссылка) уроков не имеет.
Функция ПроведенныеУрокиВПериоде(СсылкаАбонемента, Начало, ДатаВозобновления)

	Если Не ЗначениеЗаполнено(СсылкаАбонемента) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Строки.Ссылка.Номер КАК Номер,
	|	Строки.Ссылка.Дата КАК Дата
	|ИЗ
	|	Документ.УЗ_Урок.Ученики КАК Строки
	|ГДЕ
	|	Строки.Абонемент = &Абонемент
	|	И Строки.СписатьОплату
	|	И Строки.Ссылка.Проведен
	|	И Строки.Ссылка.Дата >= &Начало
	|	И Строки.Ссылка.Дата < &Конец
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	Запрос.УстановитьПараметр("Абонемент", СсылкаАбонемента);
	Запрос.УстановитьПараметр("Начало", НачалоДня(Начало));
	Запрос.УстановитьПараметр("Конец",
		?(ЗначениеЗаполнено(ДатаВозобновления), НачалоДня(ДатаВозобновления), '39991231'));
	Итог = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Итог.Добавить(Новый Структура("Номер, Дата", Выборка.Номер, Выборка.Дата));
	КонецЦикла;
	Возврат Итог;

КонецФункции

//Состояние абонемента на дату для карточки и панели: приостановлен ли (и до какого дня), срок с продлением на
//дни приостановок.
//  Абонемент — абонемент, его объект или данные формы.
Функция СостояниеАбонемента(Абонемент, НаДату) Экспорт

	Состояние =
		Новый Структура("Приостановлен, ДатаВозобновления, Срок, ДнейПриостановки", Ложь, '00010101', '00010101', 0);
	Строка = ПриостановкаНаДату(Абонемент, НаДату);
	Если Строка <> Неопределено Тогда
		Состояние.Приостановлен = Истина;
		Состояние.ДатаВозобновления = Строка.ДатаВозобновления;
	КонецЕсли;
	Состояние.Срок = СрокСПродлением(Абонемент);
	Состояние.ДнейПриостановки = ДнейПриостановки(Абонемент);
	Возврат Состояние;

КонецФункции

#КонецОбласти

#Область ДействиеИОстаток

//Подходит ли абонемент строке урока: ученик, предмет (абонемент без предмета — на любой, Codex A08) и
//организация (В12: абонемент организации А не оплачивает уроки организации Б; пустая — любая).
//Возврат: "" — подходит, иначе причина.
Функция ОшибкаПринадлежности(Абонемент, Ученик, ПредметОбучения, Организация = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Абонемент) Тогда
		Возврат НСтр("ru = 'Абонемент не выбран'");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Абонемент.ФизЛицо) Тогда
		Возврат "У абонемента " + Абонемент + " не указан ученик — списать по нему урок ученика " + Ученик + " нельзя";
	ИначеЕсли Абонемент.ФизЛицо <> Ученик Тогда
		Возврат "Абонемент " + Абонемент + " — другого ученика (" + Абонемент.ФизЛицо + "), а в уроке — " + Ученик;
	КонецЕсли;
	Если ЗначениеЗаполнено(Абонемент.ПредметОбучения) И Абонемент.ПредметОбучения <> ПредметОбучения Тогда
		Возврат "Абонемент " + Абонемент + " — по предмету «" + Абонемент.ПредметОбучения + "», а урок — "
			+ ?(ЗначениеЗаполнено(ПредметОбучения), "по предмету «" + ПредметОбучения + "»", "без предмета");
	КонецЕсли;
	Если ЗначениеЗаполнено(Абонемент.Организация) И ЗначениеЗаполнено(Организация)
		И Абонемент.Организация <> Организация Тогда
		Возврат "Абонемент " + Абонемент + " — организации «" + Абонемент.Организация + "», а урок — организации «"
			+ Организация + "»";
	КонецЕсли;
	Возврат "";

КонецФункции

//Действует ли абонемент на день урока: не помечен на удаление, активен (Активный и дата активации — одно правило
//везде, Р-6), ДатаНачала ≤ день, срок с продлением на приостановки не истёк, не приостановлен на день.
//Возврат: "" — действует, иначе причина (тексты — те же, что прежде давало проведение урока).
Функция ОшибкаДействия(Абонемент, Дата, Ученик = Неопределено) Экспорт

	Кто = ?(ЗначениеЗаполнено(Ученик), Ученик, Абонемент.ФизЛицо);
	Если Абонемент.ПометкаУдаления Тогда
		Возврат "Абонемент " + Абонемент + " помечен на удаление";
	КонецЕсли;
	Если Не Абонемент.Активный Или Не ЗначениеЗаполнено(Абонемент.ДатаАктивации) Тогда
		Возврат "У ученика " + Кто + " не активен абонемент: " + Абонемент;
	КонецЕсли;
	День = НачалоДня(Дата);
	Если ПриостановленНаДату(Абонемент, День) Тогда
		Возврат "На " + Формат(Дата, "ДФ=dd.MM.yy") + " у ученика " + Кто + " приостановлен абонемент: " + Абонемент;
	КонецЕсли;
	Если ЗначениеЗаполнено(Абонемент.ДатаНачала) И НачалоДня(Абонемент.ДатаНачала) > День Тогда
		Возврат "У ученика " + Кто + " дата начала абонемента больше даты урока";
	КонецЕсли;
	Срок = СрокСПродлением(Абонемент);
	Если ЗначениеЗаполнено(Срок) И Срок < День Тогда
		ДнейПриостановки = ДнейПриостановки(Абонемент);
		Возврат "У ученика " + Кто + " дата окончания абонемента " + Формат(Абонемент.ДатаОкончания, "ДЛФ=D")
			+ ?(ДнейПриостановки > 0, " (с продлением на " + ДнейПриостановки + " дн. приостановки — "
				+ Формат(Срок, "ДЛФ=D") + ")", "")
			+ " меньше даты урока";
	КонецЕсли;
	Возврат "";

КонецФункции

Функция НовоеИспользование()
	Возврат Новый Структура("Уроков, Секунд, Сумма", 0, 0, 0);
КонецФункции

//Сколько абонемента израсходовано: Структура(Уроков, Секунд, Сумма). Расход — строки уроков «К оплате» (Р7, их
//движения УЗ_СписанияСуммЗаУроки несут абонемент: КоличествоУроков −1 видом Расход, Часы — секунды) и
//корректировки абонемента документом «Списание остатков» (R07 ревью 28.09, как в типовых — остаток по всем
//движениям: списали 2 занятия из 8 — осталось 6; отрицательная строка возвращает занятие). Возвраты денег (РКО) и
//оплаты (ПКО) занятий не двигают.
//  ИсключитьУрок — без этого урока (его перепроведение не считает свои же движения);
//  СЗаписанными — плюс записанные планом (непроведённые, непомеченные) уроки «К оплате» с абонементом: помощник,
//  заполняя месяц вперёд, не раздаёт одно занятие дважды. Проведение урока смотрит только проведённые.
Функция Использовано(Абонемент, ИсключитьУрок = Неопределено, СЗаписанными = Ложь) Экспорт

	Если Не ЗначениеЗаполнено(Абонемент) Тогда
		Возврат НовоеИспользование();
	КонецЕсли;
	Абонементы = Новый Массив;
	Абонементы.Добавить(Абонемент);
	Возврат ИспользованоАбонементов(Абонементы, ИсключитьУрок, СЗаписанными)[Абонемент];

КонецФункции

//Использовано (см. выше) сразу для многих абонементов — одним-двумя запросами (R20 ревью 28.09: подбор 30 учеников
//делал 90 запросов). Возврат: Соответствие Абонемент → Структура(Уроков, Секунд, Сумма) — для каждого из Абонементы.
Функция ИспользованоАбонементов(Абонементы, ИсключитьУрок = Неопределено, СЗаписанными = Ложь) Экспорт

	Итог = Новый Соответствие;
	Для Каждого Абонемент Из Абонементы Цикл
		Итог.Вставить(Абонемент, НовоеИспользование());
	КонецЦикла;
	Если Итог.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;
	Исключить = ?(ЗначениеЗаполнено(ИсключитьУрок), ИсключитьУрок, Документы.УЗ_Урок.ПустаяСсылка());

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Движения.Абонемент КАК Абонемент,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|					ТОГДА -Движения.КоличествоУроков
	|				ИНАЧЕ Движения.КоличествоУроков
	|			КОНЕЦ), 0) КАК Уроков,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|					ТОГДА Движения.Часы
	|				ИНАЧЕ -Движения.Часы
	|			КОНЕЦ), 0) КАК Секунд,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА Движения.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|					ТОГДА Движения.Сумма
	|				ИНАЧЕ -Движения.Сумма
	|			КОНЕЦ), 0) КАК Сумма
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки КАК Движения
	|ГДЕ
	|	Движения.Абонемент В (&Абонементы)
	|	И Движения.Активность
	|	И (Движения.Регистратор ССЫЛКА Документ.УЗ_Урок
	|			ИЛИ Движения.Регистратор ССЫЛКА Документ.УЗ_СписаниеОстатков)
	|	И Движения.Регистратор <> &Исключить
	|
	|СГРУППИРОВАТЬ ПО
	|	Движения.Абонемент";
	//Планы — РАЗРЕШЕННЫЕ: роль «Учёт занятий: педагог» читает только свои уроки, а абонемент ученика бывает общим
	//у двух педагогов. Без РАЗРЕШЕННЫЕ проведение урока педагогом (подбор абонемента строке «К оплате») падало
	//«недостаточно прав» на записанный планом урок другого педагога. Чужие планы педагог не учитывает — это
	//прогноз помощника уроков; расход проведёнными уроками — из регистра выше, он виден всем и без ограничения.
	//У ролей без ограничения по урокам (менеджер, руководитель) РАЗРЕШЕННЫЕ ничего не меняет.
	Если СЗаписанными Тогда
		Запрос.Текст = Запрос.Текст + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Строки.Абонемент КАК Абонемент,
		|	Строки.Ссылка.КоличествоЧасов КАК КоличествоЧасов
		|ИЗ
		|	Документ.УЗ_Урок.Ученики КАК Строки
		|ГДЕ
		|	Строки.Абонемент В (&Абонементы)
		|	И Строки.СписатьОплату
		|	И НЕ Строки.Ссылка.Проведен
		|	И НЕ Строки.Ссылка.ПометкаУдаления
		|	И Строки.Ссылка <> &Исключить";
	КонецЕсли;
	Запрос.УстановитьПараметр("Абонементы", Абонементы);
	Запрос.УстановитьПараметр("Исключить", Исключить);
	Результаты = Запрос.ВыполнитьПакет();
	Выборка = Результаты[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Итог[Выборка.Абонемент] <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Итог[Выборка.Абонемент], Выборка, "Уроков, Секунд, Сумма");
		КонецЕсли;
	КонецЦикла;
	Если СЗаписанными Тогда
		Выборка = Результаты[1].Выбрать();
		Пока Выборка.Следующий() Цикл
			Исп = Итог[Выборка.Абонемент];
			Если Исп <> Неопределено Тогда
				Исп.Уроков = Исп.Уроков + 1;
				Исп.Секунд = Исп.Секунд + Документы.УЗ_Урок.СекундУрока(Выборка.КоличествоЧасов);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Итог;

КонецФункции

Функция КопияИспользования(Исп)
	Возврат Новый Структура("Уроков, Секунд, Сумма", Исп.Уроков, Исп.Секунд, Исп.Сумма);
КонецФункции

//Оплата абонемента — одна функция для карточки абонемента и прихода денег на основании абонемента (R13 ревью 28.09:
//карточка считала «Оплачено» всем приходом, а ПКО — приходом за вычетом возвратов; цена 8 000, ПКО 8 000, возврат
//3 000 — карточка «оплачен полностью», ПКО просил доплатить 3 000). Как взаиморасчёты по договору в типовых:
//  Оплачено        — приходы денег по абонементу минус возвраты по нему (УЗ_Сервер.ОплаченоПоАбонементу);
//Остаток         — неизрасходованные деньги абонемента (оплата минус уроки и
//корректировки; УЗ_Сервер.ОстатокДенегПоАбонементу);
//  Израсходовано   — Оплачено − Остаток (уроки и корректировки абонемента);
//  ОсталосьОплатить — цена минус оплачено (не меньше 0), ОплаченПолностью — цена задана и оплачена.
//Возврат: Структура(Цена, Оплачено, Израсходовано, Остаток, ОсталосьОплатить, ОплаченПолностью).
Функция ОплатаАбонемента(Абонемент) Экспорт

	Итог = Новый Структура("Цена, Оплачено, Израсходовано, Остаток, ОсталосьОплатить, ОплаченПолностью", 0, 0, 0, 0, 0,
		Ложь);
	Если Не ЗначениеЗаполнено(Абонемент) Тогда
		Возврат Итог;
	КонецЕсли;
	Итог.Цена = Абонемент.ЦенаАбонемента;
	Итог.Оплачено = УЗ_Сервер.ОплаченоПоАбонементу(Абонемент);
	Итог.Остаток = УЗ_Сервер.ОстатокДенегПоАбонементу(Абонемент);
	Итог.Израсходовано = Итог.Оплачено - Итог.Остаток;
	Итог.ОсталосьОплатить = Макс(0, Итог.Цена - Итог.Оплачено);
	Итог.ОплаченПолностью = Итог.Цена > 0 И Итог.Оплачено >= Итог.Цена;
	Возврат Итог;

КонецФункции

//Остаток абонемента — одна функция для карточки абонемента, формы урока, помощника и панели ученика (Р-5):
//Структура(Ограничен, ПоЧасам, Всего, Израсходовано, Осталось, ОсталосьСекунд, Исчерпан, Текст).
//Занятия — КоличествоЗанятий − использовано; часы — в целых секундах (В13/В25: 40 мин = 2 400 с), Осталось —
//часы с 2 знаками. Абонемент без числа занятий и часов (Ограничен = Ложь) не исчерпывается.
//  Использовано — готовая Структура(Уроков, Секунд, Сумма); не задана — Использовано(Абонемент) (проведённые уроки).
Функция ОстатокАбонемента(Абонемент, Использовано = Неопределено) Экспорт

	Итог = Новый Структура("Ограничен, ПоЧасам, Всего, Израсходовано, Осталось, ОсталосьСекунд, Исчерпан, Текст",
		Ложь, Ложь, 0, 0, 0, 0, Ложь, "");
	Если Не ЗначениеЗаполнено(Абонемент) Тогда
		Возврат Итог;
	КонецЕсли;
	Исп = ?(Использовано = Неопределено, Использовано(Абонемент), Использовано);
	Если Абонемент.КоличествоЗанятий > 0 Тогда
		Итог.Ограничен = Истина;
		Итог.Всего = Абонемент.КоличествоЗанятий;
		Итог.Израсходовано = Исп.Уроков;
		Итог.Осталось = Итог.Всего - Исп.Уроков;
		Итог.Исчерпан = Итог.Осталось < 1;
		Итог.Текст = ?(Итог.Исчерпан, НСтр("ru = 'исчерпан: '") + Формат(Итог.Израсходовано, "ЧН=0; ЧГ=") + " из "
			+ Формат(Итог.Всего, "ЧГ=") + " зан.",
			Формат(Итог.Осталось, "ЧГ=") + " из " + Формат(Итог.Всего, "ЧГ=") + " зан.");
	ИначеЕсли Абонемент.КоличествоЧасов > 0 Тогда
		Итог.Ограничен = Истина;
		Итог.ПоЧасам = Истина;
		Итог.Всего = Абонемент.КоличествоЧасов;
		Итог.ОсталосьСекунд = Документы.УЗ_Урок.СекундУрока(Абонемент.КоличествоЧасов) - Исп.Секунд;
		Итог.Израсходовано = Окр(Исп.Секунд / 3600, 2);
		Итог.Осталось = Окр(Итог.ОсталосьСекунд / 3600, 2);
		Итог.Исчерпан = Итог.ОсталосьСекунд <= 0;
		//часы — «ч:мм», как во всех формах (40 мин из 2 ч — «1:20 из 2:00 ч»)
		Итог.Текст =
			?(Итог.Исчерпан, НСтр("ru = 'исчерпан: '") + УЗ_ОбщийКлиентСервер.ЧасыМинуты(Исп.Секунд / 3600) + " из "
			+ УЗ_ОбщийКлиентСервер.ЧасыМинуты(Итог.Всего) + " ч",
			УЗ_ОбщийКлиентСервер.ЧасыМинуты(Итог.ОсталосьСекунд / 3600) + " из "
				+ УЗ_ОбщийКлиентСервер.ЧасыМинуты(Итог.Всего) + " ч");
	Иначе
		Итог.Текст = НСтр("ru = 'без ограничения занятий'");
	КонецЕсли;
	Возврат Итог;

КонецФункции

//Текст остатка абонемента «7 из 8 зан.», «1:20 из 2:00 ч», «исчерпан: 8 из 8 зан.» — одинаково во всех формах.
Функция ТекстОстатка(Абонемент) Экспорт

	Если Не ЗначениеЗаполнено(Абонемент) Тогда
		Возврат "";
	КонецЕсли;
	Возврат ОстатокАбонемента(Абонемент).Текст;

КонецФункции

//Хватает ли абонемента на урок длительностью КоличествоЧасов при израсходованном Использовано.
Функция ХватаетНаУрок(Абонемент, Использовано, КоличествоЧасов) Экспорт

	Если Абонемент.КоличествоЗанятий > 0 Тогда
		Возврат Абонемент.КоличествоЗанятий - Использовано.Уроков >= 1;
	ИначеЕсли Абонемент.КоличествоЧасов > 0 Тогда
		Возврат Документы.УЗ_Урок.СекундУрока(Абонемент.КоличествоЧасов) - Использовано.Секунд
			- Документы.УЗ_Урок.СекундУрока(КоличествоЧасов) >= 0;
	КонецЕсли;
	Возврат Истина;

КонецФункции

//Действующий абонемент ученика на ДАТУ урока по предмету: подходит (ОшибкаПринадлежности), действует на день
//(ОшибкаДействия) и хватает на урок с учётом записанных планом уроков (Использовано … СЗаписанными). Из
//нескольких — тот, что кончается раньше (он первым и расходуется; бессрочный — последним), при равных —
//начавшийся раньше. Исчерпанный не берётся (Р-4): переход на новый абонемент — сам, до конца срока старого.
//  Взято — Соответствие Абонемент → Структура(Уроков, Секунд, Сумма): строки выше в этом же уроке.
//Возврат: Структура(Абонемент, Исчерпанный, Приостановленный, Предупреждение) — Абонемент пустой, если
//действующего нет; Предупреждение — почему строка пойдёт по тарифу (В16), если у ученика был подходящий.
Функция ПодобратьАбонемент(Ученик, ПредметОбучения, Дата, Организация = Неопределено, КоличествоЧасов = 0,
	ИсключитьУрок = Неопределено, Взято = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Ученик) Тогда
		Возврат НовыйПодбор();
	КонецЕсли;
	Ученики = Новый Массив;
	Ученики.Добавить(Ученик);
	Возврат ПодборАбонементов(Ученики, ПредметОбучения, Дата, Организация, КоличествоЧасов, ИсключитьУрок,
		Взято)[Ученик];

КонецФункции

Функция НовыйПодбор()
	Возврат Новый Структура("Абонемент, Исчерпанный, Приостановленный, Предупреждение",
		Справочники.УЗ_Абонемент.ПустаяСсылка(), Справочники.УЗ_Абонемент.ПустаяСсылка(),
		Справочники.УЗ_Абонемент.ПустаяСсылка(), "");
КонецФункции

//ПодобратьАбонемент (правила — там) сразу для многих учеников: кандидаты, их приостановки и использование — тремя
//запросами на всех (R20 ревью 28.09: прежде по каждому ученику поиск и по два запроса использования на кандидата;
//30 учеников — 90 запросов). Реквизиты кандидата читаются из запроса (Структура вместо ссылки — те же функции
//ОшибкаДействия, ПриостановленНаДату, ХватаетНаУрок, СрокСПродлением), без чтения каждого абонемента.
//Возврат: Соответствие Ученик → Структура(Абонемент, Исчерпанный, Приостановленный, Предупреждение).
Функция ПодборАбонементов(Ученики, ПредметОбучения, Дата, Организация, КоличествоЧасов, ИсключитьУрок, Взято)

	Итоги = Новый Соответствие;
	СписокУчеников = Новый Массив;
	Для Каждого Ученик Из Ученики Цикл
		Если ЗначениеЗаполнено(Ученик) И Итоги[Ученик] = Неопределено Тогда
			Итоги.Вставить(Ученик, НовыйПодбор());
			СписокУчеников.Добавить(Ученик);
		КонецЕсли;
	КонецЦикла;
	Если СписокУчеников.Количество() = 0 Тогда
		Возврат Итоги;
	КонецЕсли;
	ДатаУрока = ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса());

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Абонементы.Ссылка КАК Ссылка,
	|	Абонементы.ФизЛицо КАК ФизЛицо,
	|	Абонементы.ДатаНачала КАК ДатаНачала,
	|	Абонементы.ДатаОкончания КАК ДатаОкончания,
	|	Абонементы.Активный КАК Активный,
	|	Абонементы.ДатаАктивации КАК ДатаАктивации,
	|	Абонементы.ПометкаУдаления КАК ПометкаУдаления,
	|	Абонементы.КоличествоЗанятий КАК КоличествоЗанятий,
	|	Абонементы.КоличествоЧасов КАК КоличествоЧасов
	|ПОМЕСТИТЬ ВТ_Абонементы
	|ИЗ
	|	Справочник.УЗ_Абонемент КАК Абонементы
	|ГДЕ
	|	Абонементы.ФизЛицо В (&Ученики)
	|	И Абонементы.Активный
	|	И Абонементы.ДатаАктивации <> ДАТАВРЕМЯ(1, 1, 1)
	|	И НЕ Абонементы.ПометкаУдаления
	|	И (Абонементы.ПредметОбучения = &ПредметОбучения
	|			ИЛИ Абонементы.ПредметОбучения = ЗНАЧЕНИЕ(Справочник.УЗ_ПредметыОбучения.ПустаяСсылка))
	|	И (&ЛюбаяОрганизация
	|			ИЛИ Абонементы.Организация = &Организация
	|			ИЛИ Абонементы.Организация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|	И Абонементы.ДатаНачала <= &Дата
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Абонементы.Ссылка КАК Ссылка,
	|	ВТ_Абонементы.ФизЛицо КАК ФизЛицо,
	|	ВТ_Абонементы.ДатаНачала КАК ДатаНачала,
	|	ВТ_Абонементы.ДатаОкончания КАК ДатаОкончания,
	|	ВТ_Абонементы.Активный КАК Активный,
	|	ВТ_Абонементы.ДатаАктивации КАК ДатаАктивации,
	|	ВТ_Абонементы.ПометкаУдаления КАК ПометкаУдаления,
	|	ВТ_Абонементы.КоличествоЗанятий КАК КоличествоЗанятий,
	|	ВТ_Абонементы.КоличествоЧасов КАК КоличествоЧасов
	|ИЗ
	|	ВТ_Абонементы КАК ВТ_Абонементы
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаНачала
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Приостановки.Ссылка КАК Абонемент,
	|	Приостановки.ДатаПриостановки КАК ДатаПриостановки,
	|	Приостановки.ДатаВозобновления КАК ДатаВозобновления
	|ИЗ
	|	Справочник.УЗ_Абонемент.Приостановки КАК Приостановки
	|ГДЕ
	|	Приостановки.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ_Абонементы.Ссылка
	|			ИЗ
	|				ВТ_Абонементы КАК ВТ_Абонементы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приостановки.НомерСтроки";
	Запрос.УстановитьПараметр("Ученики", СписокУчеников);
	Запрос.УстановитьПараметр("ПредметОбучения", ПредметОбучения);
	Запрос.УстановитьПараметр("ЛюбаяОрганизация", Не ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата", КонецДня(ДатаУрока));
	Результаты = Запрос.ВыполнитьПакет();
	Кандидаты = Результаты[1].Выгрузить();
	ВсеПриостановки = Результаты[2].Выгрузить();
	Использование = ИспользованоАбонементов(Кандидаты.ВыгрузитьКолонку("Ссылка"), ИсключитьУрок, Истина);

	ЛучшиеСроки = Новый Соответствие;
	Для Каждого Кандидат Из Кандидаты Цикл
		Абонемент = Кандидат.Ссылка;
		Итог = Итоги[Кандидат.ФизЛицо];
		//реквизиты и приостановки кандидата — из запроса (функции действия принимают и данные, не только ссылку)
		Данные = Новый Структура(
			"Ссылка, ФизЛицо, ДатаНачала, ДатаОкончания, Активный, ДатаАктивации, ПометкаУдаления, "
			+ "КоличествоЗанятий, КоличествоЧасов");
		ЗаполнитьЗначенияСвойств(Данные, Кандидат);
		Данные.Вставить("Приостановки", ВсеПриостановки.НайтиСтроки(Новый Структура("Абонемент", Абонемент)));
		Если ПриостановленНаДату(Данные, ДатаУрока) Тогда
			Итог.Приостановленный = Абонемент;
			Продолжить;
		КонецЕсли;
		Если ОшибкаДействия(Данные, ДатаУрока) <> "" Тогда
			Продолжить;
		КонецЕсли;
		Исп = КопияИспользования(Использование[Абонемент]);
		ВУроке = ?(Взято = Неопределено, Неопределено, Взято[Абонемент]);
		Если ВУроке <> Неопределено Тогда
			Исп.Уроков = Исп.Уроков + ВУроке.Уроков;
			Исп.Секунд = Исп.Секунд + ВУроке.Секунд;
		КонецЕсли;
		Если Не ХватаетНаУрок(Данные, Исп, КоличествоЧасов) Тогда
			Итог.Исчерпанный = Абонемент;
			Продолжить;
		КонецЕсли;
		Срок = СрокСПродлением(Данные);
		Сравнить = ?(ЗначениеЗаполнено(Срок), Срок, '39991231');
		ЛучшийСрок = ЛучшиеСроки[Кандидат.ФизЛицо];
		Если ЛучшийСрок = Неопределено Или Сравнить < ЛучшийСрок Тогда
			Итог.Абонемент = Абонемент;
			ЛучшиеСроки.Вставить(Кандидат.ФизЛицо, Сравнить);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Элемент Из Итоги Цикл
		Итог = Элемент.Значение;
		Если ЗначениеЗаполнено(Итог.Абонемент) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Итог.Исчерпанный) Тогда
			Итог.Предупреждение = СтрШаблон(НСтр("ru = 'Абонемент %1 ученика %2 исчерпан (%3) — урок %4 по тарифу'"),
				Итог.Исчерпанный, Элемент.Ключ, ОстатокАбонемента(Итог.Исчерпанный).Текст,
					Формат(ДатаУрока, "ДФ=dd.MM.yyyy"));
		ИначеЕсли ЗначениеЗаполнено(Итог.Приостановленный) Тогда
			Итог.Предупреждение =
				СтрШаблон(НСтр("ru = 'У ученика %1 приостановлен абонемент %2 на %3 — урок по тарифу'"),
				Элемент.Ключ, Итог.Приостановленный, Формат(ДатаУрока, "ДФ=dd.MM.yyyy"));
		КонецЕсли;
	КонецЦикла;
	Возврат Итоги;

КонецФункции

//Действующие абонементы учеников на дату (правила — ПодобратьАбонемент): Соответствие Ученик → Абонемент
//(ученика без действующего абонемента в нём нет). Один пакетный подбор на всех учеников (R20).
Функция ДействующиеАбонементы(Ученики, ПредметОбучения, Дата, Организация = Неопределено, КоличествоЧасов = 0) Экспорт

	Результат = Новый Соответствие;
	Для Каждого Элемент Из ПодборАбонементов(Ученики, ПредметОбучения, Дата, Организация, КоличествоЧасов,
		Неопределено, Неопределено) Цикл
		Если ЗначениеЗаполнено(Элемент.Значение.Абонемент) Тогда
			Результат.Вставить(Элемент.Ключ, Элемент.Значение.Абонемент);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

//Подстановка абонемента в строки урока — везде, где строка ученика создаётся или урок переносится на другую
//дату/предмет: форма урока (выбор ученика, подбор, копирование, смена даты), помощник (на дату КАЖДОГО урока),
//панель ученика, продление группы, перевод. Абонемент строки, который действует на дату урока и которого хватает,
//остаётся (В20: абонемент строки главнее тарифа); иначе — ПодобратьАбонемент (может быть пустым — тогда строка
//по тарифу, В16).
//  Урок — ДокументОбъект.УЗ_Урок или данные формы; Строки — массив строк Урок.Ученики (Неопределено — все).
//Возврат: Массив предупреждений (исчерпан/приостановлен — урок по тарифу).
Функция ПодставитьАбонементы(Урок, Строки = Неопределено) Экспорт

	Предупреждения = Новый Массив;
	ДатаУрока = ?(ЗначениеЗаполнено(Урок.Дата), Урок.Дата, ТекущаяДатаСеанса());
	ИсключитьУрок = Урок.Ссылка;
	Взято = Новый Соответствие;
	//использование абонементов, уже стоящих в строках, — одним запросом (R20: прежде по два на строку)
	АбонементыСтрок = Новый Массив;
	Для Каждого Стр Из Урок.Ученики Цикл
		Если ЗначениеЗаполнено(Стр.Абонемент) И АбонементыСтрок.Найти(Стр.Абонемент) = Неопределено Тогда
			АбонементыСтрок.Добавить(Стр.Абонемент);
		КонецЕсли;
	КонецЦикла;
	ИспользованиеСтрок = ИспользованоАбонементов(АбонементыСтрок, ИсключитьУрок, Истина);
	Для Каждого Стр Из Урок.Ученики Цикл
		Если (Строки = Неопределено Или Строки.Найти(Стр) <> Неопределено) И ЗначениеЗаполнено(Стр.Ученик) Тогда
			Если Не АбонементГоденДляСтроки(Стр.Абонемент, Стр.Ученик, Урок, ДатаУрока, Взято, ИспользованиеСтрок) Тогда
				Подбор = ПодобратьАбонемент(Стр.Ученик, Урок.ПредметОбучения, ДатаУрока, Урок.Организация,
					Урок.КоличествоЧасов, ИсключитьУрок, Взято);
				Стр.Абонемент = Подбор.Абонемент;
				Если ЗначениеЗаполнено(Подбор.Предупреждение) Тогда
					Предупреждения.Добавить(Подбор.Предупреждение);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если Стр.СписатьОплату И ЗначениеЗаполнено(Стр.Абонемент) Тогда
			ВУроке = Взято[Стр.Абонемент];
			Если ВУроке = Неопределено Тогда
				ВУроке = НовоеИспользование();
				Взято.Вставить(Стр.Абонемент, ВУроке);
			КонецЕсли;
			ВУроке.Уроков = ВУроке.Уроков + 1;
			ВУроке.Секунд = ВУроке.Секунд + Документы.УЗ_Урок.СекундУрока(Урок.КоличествоЧасов);
		КонецЕсли;
	КонецЦикла;
	Возврат Предупреждения;

КонецФункции

Функция АбонементГоденДляСтроки(Абонемент, Ученик, Урок, ДатаУрока, Взято, Использование)

	Если Не ЗначениеЗаполнено(Абонемент)
		Или ОшибкаПринадлежности(Абонемент, Ученик, Урок.ПредметОбучения, Урок.Организация) <> ""
		Или ОшибкаДействия(Абонемент, ДатаУрока) <> "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Исп = ?(Использование[Абонемент] = Неопределено, Использовано(Абонемент, Урок.Ссылка, Истина),
		КопияИспользования(Использование[Абонемент]));
	ВУроке = Взято[Абонемент];
	Если ВУроке <> Неопределено Тогда
		Исп.Уроков = Исп.Уроков + ВУроке.Уроков;
		Исп.Секунд = Исп.Секунд + ВУроке.Секунд;
	КонецЕсли;
	Возврат ХватаетНаУрок(Абонемент, Исп, Урок.КоличествоЧасов);

КонецФункции

//Перед записью урока (модуль объекта): В16 — строка «К оплате» с исчерпанным абонементом идёт по тарифу:
//абонемент из строки снимается, пользователь получает предупреждение у поля строки (прежде проведение
//отказывало «Не хватает занятий»). Остаток — по проведённым урокам без этого урока и строкам выше.
//Проведение = Истина — ещё и З-6: строка «К оплате» без абонемента у ученика, чей абонемент приостановлен на
//день урока, — предупреждение «урок по тарифу» (заморозку не обходят молча).
Процедура ПроверитьАбонементыУрока(Урок, Проведение) Экспорт

	Взято = Новый Соответствие;
	Для Каждого Стр Из Урок.Ученики Цикл
		Если Не Стр.СписатьОплату Тогда
			Продолжить;
		КонецЕсли;
		Поле = "Ученики[" + Формат(Стр.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Абонемент";
		Если Не ЗначениеЗаполнено(Стр.Абонемент) Тогда
			Если Проведение И ЗначениеЗаполнено(Стр.Ученик) Тогда
				Подбор = ПодобратьАбонемент(Стр.Ученик, Урок.ПредметОбучения, Урок.Дата, Урок.Организация,
					Урок.КоличествоЧасов, Урок.Ссылка);
				Если Не ЗначениеЗаполнено(Подбор.Абонемент) И ЗначениеЗаполнено(Подбор.Приостановленный) Тогда
					СообщитьОСтроке(Урок, "Строка " + Стр.НомерСтроки + ": " + Подбор.Предупреждение, Поле);
				КонецЕсли;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если ОшибкаПринадлежности(Стр.Абонемент, Стр.Ученик, Урок.ПредметОбучения, Урок.Организация) <> "" Тогда
			Продолжить; //чужой абонемент отклонит проведение (модуль объекта урока)
		КонецЕсли;
		Исп = Взято[Стр.Абонемент];
		Если Исп = Неопределено Тогда
			Исп = Использовано(Стр.Абонемент, Урок.Ссылка);
			Взято.Вставить(Стр.Абонемент, Исп);
		КонецЕсли;
		Если Не ХватаетНаУрок(Стр.Абонемент, Исп, Урок.КоличествоЧасов) Тогда
			СообщитьОСтроке(Урок,
				СтрШаблон(НСтр("ru = 'Строка %1: абонемент %2 исчерпан (%3) — урок ученика %4 по тарифу'"),
				Стр.НомерСтроки, Стр.Абонемент, ОстатокАбонемента(Стр.Абонемент, Исп).Текст, Стр.Ученик), Поле);
			Стр.Абонемент = Справочники.УЗ_Абонемент.ПустаяСсылка();
			Продолжить;
		КонецЕсли;
		Исп.Уроков = Исп.Уроков + 1;
		Исп.Секунд = Исп.Секунд + Документы.УЗ_Урок.СекундУрока(Урок.КоличествоЧасов);
	КонецЦикла;

КонецПроцедуры

Процедура СообщитьОСтроке(Урок, Текст, Поле)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(Урок);
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#Область Цена

//Цена занятия по абонементу (В2, как в типовых): ЦенаАбонемента / КоличествоЗанятий; часовой —
//ЦенаАбонемента × секунды урока / секунды абонемента. Деньги — до копеек (ДоРублей — настройка «Округление»).
//В25: хвост округления — на последний урок: урок, который исчерпывает абонемент, стоит ЦенаАбонемента минус
//сумма прежних уроков (10 000 / 12: 11 × 833,33 + 833,37 = 10 000). В23: скидка в цену абонемента уже вошла
//при продаже — урок по абонементу скидку не применяет (РассчитатьТабличнуюЧасть урока).
//  Использовано — Структура(Уроков, Секунд, Сумма) прежних уроков (без этого урока) и строк выше; не задано —
//  без хвоста. Неопределено — у абонемента нет цены или количества (тогда цена по тарифу).
Функция ЦенаЗанятия(Абонемент, КоличествоЧасов, Использовано = Неопределено, ДоРублей = Ложь) Экспорт

	Если Не ЗначениеЗаполнено(Абонемент) Или Абонемент.ЦенаАбонемента <= 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Абонемент.КоличествоЗанятий > 0 Тогда
		Цена = Абонемент.ЦенаАбонемента / Абонемент.КоличествоЗанятий;
		Последний = Использовано <> Неопределено И Использовано.Уроков + 1 >= Абонемент.КоличествоЗанятий;
	ИначеЕсли Абонемент.КоличествоЧасов > 0 Тогда
		СекундВсего = Документы.УЗ_Урок.СекундУрока(Абонемент.КоличествоЧасов);
		СекундУрока = Документы.УЗ_Урок.СекундУрока(КоличествоЧасов);
		Цена = Абонемент.ЦенаАбонемента * СекундУрока / СекундВсего;
		Последний = Использовано <> Неопределено И Использовано.Секунд + СекундУрока >= СекундВсего;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Цена = ?(ДоРублей, Окр(Цена), Окр(Цена, 2));
	Если Последний Тогда
		Цена = Макс(Абонемент.ЦенаАбонемента - Использовано.Сумма, 0);
	КонецЕсли;
	Возврат Цена;

КонецФункции

//Цены строк урока по абонементу: Соответствие НомерСтроки → цена (строки без цены абонемента в нём нет — они по
//тарифу). Строки «К оплате» с подходящим абонементом (ученик, предмет, организация), по порядку — хвост В25
//достаётся строке, исчерпавшей абонемент.
//Перепроведение не меняет цену (как в типовых: цена фиксируется в строке документа при первом проведении, а
//не пересчитывается от справочника): проведённый урок, где строка того же ученика с тем же абонементом уже была,
//берёт свою записанную цену — смена ЦеныАбонемента или числа занятий уже проведённые уроки не переписывает (Р-7).
//Часовой абонемент пересчитывается, если у урока сменилась длительность.
Функция ЦеныСтрокУрока(Урок, ДоРублей = Ложь) Экспорт

	Цены = Новый Соответствие;
	Сохраненные = СохраненныеЦеныАбонементов(Урок);
	ИспользованоПоАбонементам = Новый Соответствие;
	Для Каждого Стр Из Урок.Ученики Цикл
		Если Не Стр.СписатьОплату Или Не ЗначениеЗаполнено(Стр.Абонемент)
			Или ОшибкаПринадлежности(Стр.Абонемент, Стр.Ученик, Урок.ПредметОбучения, Урок.Организация) <> "" Тогда
			Продолжить;
		КонецЕсли;
		Абонемент = Стр.Абонемент;
		Исп = ИспользованоПоАбонементам[Абонемент];
		Если Исп = Неопределено Тогда
			Исп = Использовано(Абонемент, Урок.Ссылка);
			ИспользованоПоАбонементам.Вставить(Абонемент, Исп);
		КонецЕсли;
		Цена = Неопределено;
		Сохраненная = Сохраненные.Найти(Абонемент, "Абонемент");
		Если Сохраненная <> Неопределено И Сохраненная.Ученик = Стр.Ученик
			И (Абонемент.КоличествоЗанятий > 0
				Или Документы.УЗ_Урок.СекундУрока(Сохраненная.КоличествоЧасов) =
					Документы.УЗ_Урок.СекундУрока(Урок.КоличествоЧасов)) Тогда
			Цена = Сохраненная.Цена;
			Сохраненные.Удалить(Сохраненная);
		КонецЕсли;
		Если Цена = Неопределено Тогда
			Цена = ЦенаЗанятия(Абонемент, Урок.КоличествоЧасов, Исп, ДоРублей);
		КонецЕсли;
		Если Цена = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Цены.Вставить(Стр.НомерСтроки, Цена);
		Исп.Уроков = Исп.Уроков + 1;
		Исп.Секунд = Исп.Секунд + Документы.УЗ_Урок.СекундУрока(Урок.КоличествоЧасов);
		Исп.Сумма = Исп.Сумма + Цена;
	КонецЦикла;
	Возврат Цены;

КонецФункции

Функция СохраненныеЦеныАбонементов(Урок)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Строки.Ученик КАК Ученик,
	|	Строки.Абонемент КАК Абонемент,
	|	Строки.ЦенаТарифа КАК Цена,
	|	Строки.Ссылка.КоличествоЧасов КАК КоличествоЧасов
	|ИЗ
	|	Документ.УЗ_Урок.Ученики КАК Строки
	|ГДЕ
	|	Строки.Ссылка = &Ссылка
	|	И Строки.Ссылка.Проведен
	|	И Строки.СписатьОплату
	|	И Строки.Абонемент <> ЗНАЧЕНИЕ(Справочник.УЗ_Абонемент.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Строки.НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка",
		?(ЗначениеЗаполнено(Урок.Ссылка), Урок.Ссылка, Документы.УЗ_Урок.ПустаяСсылка()));
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Статус = "";

	Если Данные.Ссылка.Активный Тогда

		//приостановка — по тому же правилу, что у урока и карточки (с первого дня по день возобновления не включая)
		Состояние = СостояниеАбонемента(Данные.Ссылка, ТекущаяДатаСеанса());
		Если Состояние.Приостановлен Тогда
			Статус = ?(ЗначениеЗаполнено(Состояние.ДатаВозобновления),
				" (приостановлен до " + Формат(Состояние.ДатаВозобновления, "ДФ=dd.MM.yy") + ")", " (приостановлен)");
		КонецЕсли;

	Иначе
		Статус = " (НЕАКТИВНЫЙ)";
	КонецЕсли;

	Представление = Данные.Ссылка.Наименование+ Статус;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭкранироватьДляПодобно(Текст)

	Итог = Текст;
	Для Каждого Знак Из СтрРазделить("~,%,_,[,]", ",") Цикл
		Итог = СтрЗаменить(Итог, Знак, "~" + Знак);
	КонецЦикла;
	Возврат Итог;

КонецФункции

#КонецОбласти
