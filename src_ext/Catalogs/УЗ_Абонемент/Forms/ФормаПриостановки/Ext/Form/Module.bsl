
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	//приостановка по умолчанию — с сегодняшнего дня (как в LM: «дата возобновления = сегодня»)
	Если Не ЗначениеЗаполнено(ПериодПриостановки.ДатаНачала) Тогда
		ПериодПриостановки.ДатаНачала = НачалоДня(УЗ_Сервер.ДатаСеанса());	//сегодня по серверу (Codex Т2)
	КонецЕсли;
КонецПроцедуры

//Период уходит в карточку только по «ОК»; крестик и «Отмена» закрывают окно без приостановки
//(раньше период передавался при любом закрытии окна).
&НаКлиенте
Процедура Применить(Команда)
	
	ДанныеС = Новый Структура;
	ДанныеС.Вставить("ПериодПриостановки",ПериодПриостановки);
	ДанныеС.Вставить("Причина",Причина);
	Закрыть(ДанныеС);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть(Неопределено);
КонецПроцедуры
