
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	//приостановка по умолчанию — с сегодняшнего дня (как в LM: «дата возобновления = сегодня»)
	Если Не ЗначениеЗаполнено(ПериодПриостановки.ДатаНачала) Тогда
		ПериодПриостановки.ДатаНачала = НачалоДня(ТекущаяДата());
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	ДанныеС = Новый Структура;
	ДанныеС.Вставить("ПериодПриостановки",ПериодПриостановки);
	ДанныеС.Вставить("Причина",Причина);
	
	ОповеститьОВыборе(ДанныеС);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	ПериодПриостановки = Неопределено;
	Причина = "";
	Закрыть();
КонецПроцедуры
