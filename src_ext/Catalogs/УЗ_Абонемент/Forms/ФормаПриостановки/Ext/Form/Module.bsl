
&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	ДанныеС = Новый Структура;
	ДанныеС.Вставить("ПериодПриостановки",ПериодПриостановки);
	ДанныеС.Вставить("Причина",Причина);
	
	ОповеститьОВыборе(ДанныеС);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	ПериодПриостановки = Неопределено;
	Причина = "";
	Закрыть();
КонецПроцедуры
