&НаКлиенте
Процедура ОплаченоНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОткрытия = ОткрытьВзаиморасчетыНаСервере(Объект.Ссылка);
	ОткрытьФорму("Отчет.УЗ_Взаиморасчеты.Форма", ПараметрыОткрытия, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ОткрытьВзаиморасчетыНаСервере(Значение)
	
	КомпоновщикНастроек = Отчеты.УЗ_Взаиморасчеты.Создать().КомпоновщикНастроек; 
	Настройки 			= КомпоновщикНастроек.Настройки; 
	
	ЭлементНастройки = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период")); 
	Если ЗначениеЗаполнено(ЭлементНастройки.ИдентификаторПользовательскойНастройки) Тогда 
		ПользовательскийПараметр = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ЭлементНастройки.ИдентификаторПользовательскойНастройки); 
		Если ТипЗнч(ПользовательскийПараметр) = Тип("ЗначениеПараметраНастроекКомпоновкиДанных") Тогда 
			ПользовательскийПараметр.Использование = Ложь;
		КонецЕсли; 
	КонецЕсли; 
	
	ОтборАбонемент = Новый ПолеКомпоновкиДанных("Абонемент");
	
	Для Каждого ЭлементНастройки Из Настройки.Отбор.Элементы Цикл 
		Если ЭлементНастройки.ЛевоеЗначение = ОтборАбонемент Тогда 
			ЭлементНастройки.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно; 
			ЭлементНастройки.ПравоеЗначение = Значение; 
			ЭлементНастройки.Использование = Истина; 
			Если ЗначениеЗаполнено(ЭлементНастройки.ИдентификаторПользовательскойНастройки) Тогда 
				ПользовательскийПараметр = КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(ЭлементНастройки.ИдентификаторПользовательскойНастройки); 
				Если ТипЗнч(ПользовательскийПараметр) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда 
					ПользовательскийПараметр.ВидСравнения = ЭлементНастройки.ВидСравнения; 
					ПользовательскийПараметр.ПравоеЗначение = ЭлементНастройки.ПравоеЗначение; 
					ПользовательскийПараметр.Использование = ЭлементНастройки.Использование; 
				КонецЕсли; 
			КонецЕсли;
			Прервать; 
		КонецЕсли; 
	КонецЦикла; 
	
	ПараметрыОткрытия = Новый Структура(); 
	ПараметрыОткрытия.Вставить("СформироватьПриОткрытии", Истина); 
	ПараметрыОткрытия.Вставить("Вариант", Настройки); 
	ПараметрыОткрытия.Вставить("ПользовательскиеНастройки", КомпоновщикНастроек.ПользовательскиеНастройки); 
	
	Возврат ПараметрыОткрытия;
	
КонецФункции

&НаКлиенте
Процедура ФизЛицоПриИзменении(Элемент)
	ФизЛицоПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ФизЛицоПриИзмененииНаСервере()
	//тариф ученика — в новый абонемент, если тариф ещё не выбран
	Если Объект.Ссылка.Пустая() И Не ЗначениеЗаполнено(Объект.Тариф) И ЗначениеЗаполнено(Объект.ФизЛицо) Тогда
		Объект.Тариф = Объект.ФизЛицо.Тариф;
		ЗаполнитьПоТарифу(Ложь);
	КонецЕсли;
	ОбновитьАвтоНаименование();
	ПоказатьФото();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	//В12: организация абонемента — только если в базе есть организации (как в форме урока)
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Организации.Ссылка КАК Ссылка ИЗ Справочник.Организации КАК Организации");
	Элементы.Организация.Видимость = Не Запрос.Выполнить().Пустой();

	Если Объект.Ссылка.Пустая() Тогда
		Если Не ЗначениеЗаполнено(Объект.Тариф) И ЗначениеЗаполнено(Объект.ФизЛицо) Тогда
			Объект.Тариф = Объект.ФизЛицо.Тариф;
		КонецЕсли;
		//новый абонемент — на месяц с сегодняшнего дня (период можно поправить)
		Если Не ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
			Объект.ДатаНачала = НачалоДня(ТекущаяДатаСеанса());
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
			Объект.ДатаОкончания = ДобавитьМесяц(Объект.ДатаНачала, 1) - 86400;
		КонецЕсли;
		ЗаполнитьПоТарифу(Ложь);
		ОбновитьАвтоНаименование();
	Иначе
		ПоследнееАвтоНаименование = Справочники.УЗ_Абонемент.АвтоНаименование(Объект.ФизЛицо, Объект.ДатаНачала, Объект.Ссылка);
	КонецЕсли;

КонецПроцедуры

//Уроки, часы и цена из тарифа. Перезаписать = Ложь — заполняются только пустые.
&НаСервере
Процедура ЗаполнитьПоТарифу(Перезаписать)

	Значения = Справочники.УЗ_Абонемент.ЗначенияПоТарифу(Объект.Тариф, Объект.ДатаНачала);
	Если Значения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Перезаписать Или (Объект.КоличествоЗанятий = 0 И Объект.КоличествоЧасов = 0) Тогда
		Объект.КоличествоЗанятий = Значения.КоличествоУроков;
		Объект.КоличествоЧасов = ?(Значения.КоличествоУроков > 0, 0, Значения.КоличествоЧасов);
	КонецЕсли;
	Если Перезаписать Или Объект.ЦенаАбонемента = 0 Тогда
		Объект.ЦенаАбонемента = Значения.Сумма;
	КонецЕсли;

КонецПроцедуры

//Наименование составляется само, пока его не поправили руками.
&НаСервере
Процедура ОбновитьАвтоНаименование()

	Если ПустаяСтрока(Объект.Наименование) Или Объект.Наименование = ПоследнееАвтоНаименование Тогда
		Объект.Наименование = Справочники.УЗ_Абонемент.АвтоНаименование(Объект.ФизЛицо, Объект.ДатаНачала, Объект.Ссылка);
	КонецЕсли;
	ПоследнееАвтоНаименование = Объект.Наименование;

КонецПроцедуры

&НаКлиенте
Процедура ТарифПриИзменении(Элемент)
	ТарифПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ТарифПриИзмененииНаСервере()
	//у записанного абонемента уроки и цена закрыты кнопками «Изменить» — там не перезаписываем
	ЗаполнитьПоТарифу(Объект.Ссылка.Пустая());
КонецПроцедуры

//После записи оплаты или урока по этому абонементу — пересчитать «Оплачено» и остаток без F5.
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "Запись_УЗ_ПриходДенег" Или ИмяСобытия = "ЗакрытьФормуУрока" Тогда
		ЗаполнитьТЗОплат();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПоказатьФото()
	Если НЕ Объект.ФизЛицо.Пустая() и НЕ Объект.ФизЛицо.Фото.Пустая() Тогда
		Фото = ПоместитьВоВременноеХранилище(Объект.ФизЛицо.Фото.Файл.Получить());
	Иначе
		Фото = "";
	КонецЕсли;
	//нет фото — нет и пустой рамки на пол-экрана
	Элементы.Фото.Видимость = ЗначениеЗаполнено(Фото);
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьЦенуАбонемента(Команда)
	Элементы.ЦенаАбонемента.ТолькоПросмотр = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПриостановкиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	ОбновитьВидимость();
КонецПроцедуры


&НаКлиенте
Процедура ИтогоПосещенийНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыОткрытия = ОткрытьВзаиморасчетыНаСервере(Объект.Ссылка);
	ОткрытьФорму("Отчет.УЗ_Взаиморасчеты.Форма", ПараметрыОткрытия, ЭтаФорма);

КонецПроцедуры


&НаКлиенте
Процедура КоличествоЧасовПриИзменении(Элемент)
	Объект.КоличествоЗанятий = 0;
КонецПроцедуры


&НаКлиенте
Процедура КоличествоЗанятийПриИзменении(Элемент)
	Объект.КоличествоЧасов = 0;
КонецПроцедуры


&НаКлиенте
Процедура Обновить(Команда)
	ЗаполнитьТЗОплат();
КонецПроцедуры

