#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Активировать(Команда)

	Объект.Активный = НЕ Объект.Активный;

	Если Объект.Активный Тогда
		Объект.ДатаАктивации = УЗ_Сервер.ДатаСеанса();	//время сервера, а не компьютера пользователя (Codex Т2)
	КонецЕсли;

	ОбновитьВидимость();

КонецПроцедуры

&НаКлиенте
Процедура Приостановить(Команда)

	Если Объект.Активный Тогда
		ОП = Новый ОписаниеОповещения("ЗапросДнейПриостановки",ЭтотОбъект);
		ОткрытьФорму("Справочник.УЗ_Абонемент.Форма.ФормаПриостановки",,ЭтотОбъект,,,,ОП,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;

	ОбновитьВидимость();

КонецПроцедуры

