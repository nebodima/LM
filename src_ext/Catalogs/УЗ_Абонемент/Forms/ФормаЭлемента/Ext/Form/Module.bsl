#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ЗаполнитьТЗОплат();

	ОбновитьВидимость();

КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЧасыТекстом = УЗ_ОбщийКлиентСервер.ЧасыМинуты(Объект.КоличествоЧасов, Истина);
	//В12: организация абонемента — только если в базе есть организации (как в форме урока)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Организации.Ссылка КАК Ссылка ИЗ Справочник.Организации КАК Организации");
	Элементы.Организация.Видимость = Не Запрос.Выполнить().Пустой();

	Если Объект.Ссылка.Пустая() Тогда
		Если Не ЗначениеЗаполнено(Объект.Тариф) И ЗначениеЗаполнено(Объект.ФизЛицо) Тогда
			Объект.Тариф = Объект.ФизЛицо.Тариф;
		КонецЕсли;
		//новый абонемент — на месяц с сегодняшнего дня (период можно поправить)
		Если Не ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
			Объект.ДатаНачала = НачалоДня(ТекущаяДатаСеанса());
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
			Объект.ДатаОкончания = ДобавитьМесяц(Объект.ДатаНачала, 1) - 86400;
		КонецЕсли;
		ЗаполнитьПоТарифу(Ложь);
		ОбновитьАвтоНаименование();
	Иначе
		ПоследнееАвтоНаименование =
			Справочники.УЗ_Абонемент.АвтоНаименование(Объект.ФизЛицо, Объект.ДатаНачала, Объект.Ссылка);
	КонецЕсли;

КонецПроцедуры

//После записи оплаты или урока по этому абонементу — пересчитать «Оплачено» и остаток без F5.
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "Запись_УЗ_ПриходДенег" Или ИмяСобытия = "ЗакрытьФормуУрока" Тогда
		ЗаполнитьТЗОплат();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

