
//Основная касса: непомеченная касса с реквизитом «Основная» (её ставит команда «Сделать основной»),
//иначе предопределённая «Основная касса».
Функция ПолучитьОсновнуюКассу() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Кассы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УЗ_Кассы КАК Кассы
	|ГДЕ
	|	Кассы.Основная
	|	И НЕ Кассы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Кассы.Код";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.УЗ_Кассы.ОсновнаяКасса;

КонецФункции

//Остаток денег в кассе на текущий момент — по всем клиентам, предметам, статьям и видам операций.
Функция ОстатокДенег(Касса) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.УЗ_Касса.Остатки(, Касса = &Касса) КАК Остатки";
	Запрос.УстановитьПараметр("Касса", Касса);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.СуммаОстаток;

КонецФункции

//«Сделать основной» (формы списка и выбора касс): отметка «Основная» — у одной кассы. Возврат: "" —
//сделано, иначе причина отказа для пользователя (не выбрана строка, группа, помеченная касса, ошибка записи).
Функция НазначитьОсновной(Касса) Экспорт

	Если НЕ ЗначениеЗаполнено(Касса) Или ТипЗнч(Касса) <> Тип("СправочникСсылка.УЗ_Кассы") Тогда
		Возврат НСтр("ru = 'Выберите в списке кассу, которую сделать основной.'");
	КонецЕсли;
	Если Касса.ЭтоГруппа Тогда
		Возврат СтрШаблон(НСтр("ru = '«%1» — группа касс: основной можно сделать только кассу.'"), Касса);
	КонецЕсли;
	Если Касса.ПометкаУдаления Тогда
		Возврат СтрШаблон(НСтр("ru = 'Касса «%1» помечена на удаление — основной её сделать нельзя.'"), Касса);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Кассы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УЗ_Кассы КАК Кассы
	|ГДЕ
	|	Кассы.Основная
	|	И Кассы.Ссылка <> &Касса";
	Запрос.УстановитьПараметр("Касса", Касса);

	НачатьТранзакцию();
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Прежняя = Выборка.Ссылка.ПолучитьОбъект();
			Прежняя.Основная = Ложь;
			Прежняя.Записать();
		КонецЦикла;
		Новая = Касса.ПолучитьОбъект();
		Если НЕ Новая.Основная Тогда
			Новая.Основная = Истина;
			Новая.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		УЗ_Общий.ЗаписатьОшибку("Касса.Основная", ИнформацияОбОшибке(), НСтр("ru = 'Не удалось сделать кассу основной'"));
		Возврат СтрШаблон(НСтр("ru = 'Не удалось сделать кассу «%1» основной: %2'"), Касса,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат "";

КонецФункции