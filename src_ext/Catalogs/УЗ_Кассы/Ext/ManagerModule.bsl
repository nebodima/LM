
//Основная касса: непомеченная касса с реквизитом «Основная» (её ставит команда «Сделать основной»),
//иначе предопределённая «Основная касса».
Функция ПолучитьОсновнуюКассу() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Кассы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УЗ_Кассы КАК Кассы
	|ГДЕ
	|	Кассы.Основная
	|	И НЕ Кассы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Кассы.Код";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.УЗ_Кассы.ОсновнаяКасса;

КонецФункции

//Остаток денег в кассе на текущий момент — по всем клиентам, предметам, статьям и видам операций.
Функция ОстатокДенег(Касса) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.УЗ_Касса.Остатки(, Касса = &Касса) КАК Остатки";
	Запрос.УстановитьПараметр("Касса", Касса);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.СуммаОстаток;

КонецФункции

//В14 (C04, решение владельца 28.09.2026): касса не уходит в минус ни расходом, ни перемещением. Сколько документ
//(ДокументОбъект в обработке проведения: РКО, перемещение между кассами) может взять из кассы — меньшее из двух
//остатков по всем клиентам, организациям, предметам, статьям и видам операций:
//  * на момент документа — задним числом нельзя выдать деньги, которые пришли позже;
//  * текущий (все движения, в том числе будущими датами) — нельзя выдать деньги, уже потраченные позже.
//Оба — без движений самого документа (при перепроведении старые движения ещё в регистре). Блокировка кассы —
//до чтения: два расхода из одной кассы, проводимые одновременно, не израсходуют один остаток дважды.
Функция ДоступныйОстатокДляРасхода(Касса, Документ) Экспорт

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.УЗ_Касса");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Касса", Касса);
	Блокировка.Заблокировать();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Данные.НаДату), 0) КАК НаДату,
	|	ЕСТЬNULL(СУММА(Данные.Текущий), 0) КАК Текущий
	|ИЗ
	|	(ВЫБРАТЬ
	|		Остатки.СуммаОстаток КАК НаДату,
	|		0 КАК Текущий
	|	ИЗ
	|		РегистрНакопления.УЗ_Касса.Остатки(&Граница, Касса = &Касса) КАК Остатки
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		0,
	|		Остатки.СуммаОстаток
	|	ИЗ
	|		РегистрНакопления.УЗ_Касса.Остатки(, Касса = &Касса) КАК Остатки
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ВЫБОР
	|			КОГДА Свои.Период < &Дата
	|				ТОГДА ВЫБОР
	|						КОГДА Свои.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|							ТОГДА Свои.Сумма
	|						ИНАЧЕ -Свои.Сумма
	|					КОНЕЦ
	|			ИНАЧЕ 0
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА Свои.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|				ТОГДА Свои.Сумма
	|			ИНАЧЕ -Свои.Сумма
	|		КОНЕЦ
	|	ИЗ
	|		РегистрНакопления.УЗ_Касса КАК Свои
	|	ГДЕ
	|		Свои.Регистратор = &Ссылка
	|		И Свои.Касса = &Касса
	|		И Свои.Активность) КАК Данные";
	Запрос.УстановитьПараметр("Касса", Касса);
	Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);
	Запрос.УстановитьПараметр("Дата", Документ.Дата);
	Запрос.УстановитьПараметр("Граница", Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая));
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Мин(Выборка.НаДату, Выборка.Текущий);

КонецФункции

//Текст отказа расхода, после которого касса ушла бы в минус.
Функция ТекстКассаУйдетВМинус(Касса, Остаток, Сумма) Экспорт

	Возврат СтрШаблон(НСтр("ru = 'В кассе %1 остаток %2 — выдать %3 нельзя, касса уйдёт в минус. Остаток — меньшее из остатка на дату документа и текущего (с документами более поздними датами).'"),
		?(ЗначениеЗаполнено(Касса), Касса, НСтр("ru = '(не указана)'")), Формат(Остаток, "ЧДЦ=2; ЧН=0,00"), Формат(Сумма, "ЧДЦ=2; ЧН=0,00"));

КонецФункции

//«Сделать основной» (формы списка и выбора касс): отметка «Основная» — у одной кассы. Возврат: "" —
//сделано, иначе причина отказа для пользователя (не выбрана строка, группа, помеченная касса, ошибка записи).
Функция НазначитьОсновной(Касса) Экспорт

	Если НЕ ЗначениеЗаполнено(Касса) Или ТипЗнч(Касса) <> Тип("СправочникСсылка.УЗ_Кассы") Тогда
		Возврат НСтр("ru = 'Выберите в списке кассу, которую сделать основной.'");
	КонецЕсли;
	Если Касса.ЭтоГруппа Тогда
		Возврат СтрШаблон(НСтр("ru = '«%1» — группа касс: основной можно сделать только кассу.'"), Касса);
	КонецЕсли;
	Если Касса.ПометкаУдаления Тогда
		Возврат СтрШаблон(НСтр("ru = 'Касса «%1» помечена на удаление — основной её сделать нельзя.'"), Касса);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Кассы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УЗ_Кассы КАК Кассы
	|ГДЕ
	|	Кассы.Основная
	|	И Кассы.Ссылка <> &Касса";
	Запрос.УстановитьПараметр("Касса", Касса);

	НачатьТранзакцию();
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Прежняя = Выборка.Ссылка.ПолучитьОбъект();
			Прежняя.Основная = Ложь;
			Прежняя.Записать();
		КонецЦикла;
		Новая = Касса.ПолучитьОбъект();
		Если НЕ Новая.Основная Тогда
			Новая.Основная = Истина;
			Новая.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		УЗ_Общий.ЗаписатьОшибку("Касса.Основная", ИнформацияОбОшибке(), НСтр("ru = 'Не удалось сделать кассу основной'"));
		Возврат СтрШаблон(НСтр("ru = 'Не удалось сделать кассу «%1» основной: %2'"), Касса,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат "";

КонецФункции