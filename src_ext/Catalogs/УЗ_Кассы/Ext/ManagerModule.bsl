
//Основная касса: непомеченная касса с реквизитом «Основная» (её ставит команда «Сделать основной»),
//иначе предопределённая «Основная касса».
Функция ПолучитьОсновнуюКассу() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Кассы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УЗ_Кассы КАК Кассы
	|ГДЕ
	|	Кассы.Основная
	|	И НЕ Кассы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Кассы.Код";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.УЗ_Кассы.ОсновнаяКасса;

КонецФункции

//Остаток денег в кассе на текущий момент (с документами будущих дат) — по всем клиентам, предметам, статьям и
//видам операций; Организация — Неопределено: по всем организациям, иначе — деньги этой организации в кассе (В12).
//Для отчётов и тестов. Сколько можно выдать — ДоступныйОстатокДляРасхода.
Функция ОстатокДенег(Касса, Организация = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.УЗ_Касса.Остатки(, Касса = &Касса) КАК Остатки";
	Если Организация <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Касса = &Касса", "Касса = &Касса И Организация = &Организация");
		Запрос.УстановитьПараметр("Организация", Организация);
	КонецЕсли;
	Запрос.УстановитьПараметр("Касса", Касса);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.СуммаОстаток;

КонецФункции

//В14 (C04) и В12 (решения владельца 28.09.2026): касса не уходит в минус ни расходом, ни перемещением, ни отменой
//прихода; деньги в кассе — раздельно по организациям (как касса организации в типовых): расход организации Б не
//берёт наличные, которые принесли в кассу организации А. Одна функция для всех мест: РКО, перемещение, списание
//остатков, отмена и уменьшение прихода (через ПроверитьОстаткиКасс) и расчёт зарплаты («Остаток в кассе»,
//«Переместить деньги»). Сколько можно взять из кассы — меньшее из двух остатков денег организации в кассе (все
//клиенты, предметы, статьи, разделы):
//  * на момент документа — задним числом нельзя выдать деньги, которые пришли позже;
//  * текущий (все движения, в том числе будущими датами) — нельзя выдать деньги, уже потраченные позже.
//Оба — без движений самого документа (при перепроведении старые движения ещё в регистре).
//  Документ — ДокументОбъект (Ссылка, Дата, МоментВремени, Организация) или Неопределено: «сейчас», без документа
//  (расчёт зарплаты показывает и перемещает ровно то, что потом разрешит проведение перемещения).
//  Организация — Неопределено: организация документа.
//В транзакции — блокировка кассы организации до чтения: два расхода из одной кассы, проводимые одновременно, не
//израсходуют один остаток дважды.
Функция ДоступныйОстатокДляРасхода(Касса, Документ, Организация = Неопределено) Экспорт

	Если Документ = NULL Тогда   //из внешнего соединения «нет документа» приходит NULL
		Документ = Неопределено;
	КонецЕсли;
	Если Организация = Неопределено И Документ <> Неопределено Тогда
		Организация = Документ.Организация;
	КонецЕсли;
	Если ТранзакцияАктивна() Тогда
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.УЗ_Касса");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Касса", Касса);
		ЭлементБлокировки.УстановитьЗначение("Организация", Организация);
		Блокировка.Заблокировать();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Данные.НаДату), 0) КАК НаДату,
	|	ЕСТЬNULL(СУММА(Данные.Текущий), 0) КАК Текущий
	|ИЗ
	|	(ВЫБРАТЬ
	|		Остатки.СуммаОстаток КАК НаДату,
	|		0 КАК Текущий
	|	ИЗ
	|		РегистрНакопления.УЗ_Касса.Остатки(&Граница, Касса = &Касса И Организация = &Организация) КАК Остатки
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		0,
	|		Остатки.СуммаОстаток
	|	ИЗ
	|		РегистрНакопления.УЗ_Касса.Остатки(, Касса = &Касса И Организация = &Организация) КАК Остатки
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ВЫБОР
	|			КОГДА Свои.Период < &Дата
	|				ТОГДА ВЫБОР
	|						КОГДА Свои.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|							ТОГДА Свои.Сумма
	|						ИНАЧЕ -Свои.Сумма
	|					КОНЕЦ
	|			ИНАЧЕ 0
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА Свои.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|				ТОГДА Свои.Сумма
	|			ИНАЧЕ -Свои.Сумма
	|		КОНЕЦ
	|	ИЗ
	|		РегистрНакопления.УЗ_Касса КАК Свои
	|	ГДЕ
	|		Свои.Регистратор = &Ссылка
	|		И Свои.Касса = &Касса
	|		И Свои.Организация = &Организация
	|		И Свои.Активность) КАК Данные";
	Запрос.УстановитьПараметр("Касса", Касса);
	Запрос.УстановитьПараметр("Организация", Организация);
	Если Документ = Неопределено Тогда
		Сейчас = ТекущаяДатаСеанса();
		Запрос.УстановитьПараметр("Ссылка", Неопределено);
		Запрос.УстановитьПараметр("Дата", Сейчас);
		Запрос.УстановитьПараметр("Граница", Новый Граница(Сейчас, ВидГраницы.Включая));
	Иначе
		Запрос.УстановитьПараметр("Ссылка", Документ.Ссылка);
		Запрос.УстановитьПараметр("Дата", Документ.Дата);
		Запрос.УстановитьПараметр("Граница", Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая));
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Мин(Выборка.НаДату, Выборка.Текущий);

КонецФункции

//В14 для любого документа, который пишет движения кассы (РКО, ПКО, перемещение, списание остатков), — при
//проведении и при отмене проведения (пометке удаления). Сравнивает новые движения документа (НаборДвижений — ещё
//не записанный набор УЗ_Касса; при отмене проведения — пустой) с прежними, уже записанными в регистр, по каждой
//паре «касса + организация». Где документ уменьшает деньги кассы (расход, уменьшение или отмена прихода,
//перенос в другую кассу), остаток после документа — ДоступныйОстатокДляРасхода плюс новые движения — не должен
//стать меньше нуля. Где не уменьшает (приход без изменений, перепроведение прихода), проверки нет: уже ушедшая в
//минус касса (данные старых версий) не мешает принимать деньги.
Процедура ПроверитьОстаткиКасс(Документ, НаборДвижений, Отказ) Экспорт

	Изменения = Новый ТаблицаЗначений;
	Изменения.Колонки.Добавить("Касса");
	Изменения.Колонки.Добавить("Организация");
	Изменения.Колонки.Добавить("Новое", Новый ОписаниеТипов("Число"));
	Изменения.Колонки.Добавить("Прежнее", Новый ОписаниеТипов("Число"));
	Для Каждого Запись Из НаборДвижений Цикл
		Изменение = Изменения.Добавить();
		Изменение.Касса = Запись.Касса;
		Изменение.Организация = Запись.Организация;
		Изменение.Новое = ?(Запись.ВидДвижения = ВидДвиженияНакопления.Приход, Запись.Сумма, -Запись.Сумма);
	КонецЦикла;
	//прежние движения — запомненные в ПередЗаписью (при перепроведении платформа удаляет их из регистра до
	//ОбработкаПроведения), иначе — из регистра
	Прежние = Неопределено;
	Если НЕ Документ.ДополнительныеСвойства.Свойство("УЗ_ПрежниеДвиженияКассы", Прежние) Тогда
		Прежние = ДвиженияКассыДокумента(Документ.Ссылка);
	КонецЕсли;
	Для Каждого Прежнее Из Прежние Цикл
		Изменение = Изменения.Добавить();
		Изменение.Касса = Прежнее.Касса;
		Изменение.Организация = Прежнее.Организация;
		Изменение.Прежнее = Прежнее.Сумма;
	КонецЦикла;
	Изменения.Свернуть("Касса, Организация", "Новое, Прежнее");

	Для Каждого Изменение Из Изменения Цикл
		Если НЕ ЗначениеЗаполнено(Изменение.Касса) Или (Изменение.Новое >= 0 И Изменение.Новое >= Изменение.Прежнее) Тогда
			Продолжить;
		КонецЕсли;
		Остаток = ДоступныйОстатокДляРасхода(Изменение.Касса, Документ, Изменение.Организация);
		Если Остаток + Изменение.Новое >= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Изменение.Новое < 0 Тогда
			Текст = ТекстКассаУйдетВМинус(Изменение.Касса, Остаток, -Изменение.Новое, Изменение.Организация);
		Иначе
			Текст = СтрШаблон(НСтр("ru = 'В кассе %1%2 без этого документа остаток %3, а документ оставляет в ней %4 — касса уйдёт в минус: эти деньги уже выданы другими документами. Сначала отмените или уменьшите расход.'"),
				Изменение.Касса, ПредставлениеОрганизации(Изменение.Организация), Формат(Остаток, "ЧДЦ=2; ЧН=0,00"),
				Формат(Изменение.Новое, "ЧДЦ=2; ЧН=0,00"));
		КонецЕсли;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Текст;
		Сообщение.УстановитьДанные(Документ);
		Сообщение.Сообщить();
		Отказ = Истина;
	КонецЦикла;

КонецПроцедуры

//Движения документа по кассе, свёрнутые по «касса + организация» (приход +, расход −): ТаблицаЗначений.
Функция ДвиженияКассыДокумента(Ссылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Свои.Касса КАК Касса,
	|	Свои.Организация КАК Организация,
	|	СУММА(ВЫБОР
	|			КОГДА Свои.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА Свои.Сумма
	|			ИНАЧЕ -Свои.Сумма
	|		КОНЕЦ) КАК Сумма
	|ИЗ
	|	РегистрНакопления.УЗ_Касса КАК Свои
	|ГДЕ
	|	Свои.Регистратор = &Ссылка
	|	И Свои.Активность
	|
	|СГРУППИРОВАТЬ ПО
	|	Свои.Касса,
	|	Свои.Организация";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

//Из ПередЗаписью документа, двигающего кассу: запомнить его прежние движения кассы (ДополнительныеСвойства) —
//для ПроверитьОстаткиКасс при перепроведении; при отмене проведения — сразу проверить, что касса не уйдёт в минус.
Процедура ПередЗаписьюДокументаКассы(Документ, РежимЗаписи, Отказ) Экспорт

	Если Документ.ОбменДанными.Загрузка Или Документ.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	Документ.ДополнительныеСвойства.Вставить("УЗ_ПрежниеДвиженияКассы", ДвиженияКассыДокумента(Документ.Ссылка));
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		ПроверитьОстаткиКасс(Документ, РегистрыНакопления.УЗ_Касса.СоздатьНаборЗаписей(), Отказ);
	КонецЕсли;

КонецПроцедуры

//В12: касса с заполненной организацией принадлежит ей — документ другой организации по ней не проводится.
//Возврат: "" — можно, иначе текст отказа.
Функция ТекстКассаДругойОрганизации(Касса, Организация) Экспорт

	Если НЕ ЗначениеЗаполнено(Касса) Тогда
		Возврат "";
	КонецЕсли;
	Владелец = Касса.Организация;
	Если НЕ ЗначениеЗаполнено(Владелец) Или Владелец = Организация Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Касса %1 принадлежит организации «%2», а документ — от «%3». Выберите кассу своей организации.'"),
		Касса, Владелец, ?(ЗначениеЗаполнено(Организация), Организация, НСтр("ru = '(организация не указана)'")));

КонецФункции

//Текст отказа расхода, после которого касса ушла бы в минус.
Функция ТекстКассаУйдетВМинус(Касса, Остаток, Сумма, Организация = Неопределено) Экспорт

	Возврат СтрШаблон(НСтр("ru = 'В кассе %1%4 остаток %2 — выдать %3 нельзя, касса уйдёт в минус. Остаток — меньшее из остатка на дату документа и текущего (с документами более поздними датами).'"),
		?(ЗначениеЗаполнено(Касса), Касса, НСтр("ru = '(не указана)'")), Формат(Остаток, "ЧДЦ=2; ЧН=0,00"), Формат(Сумма, "ЧДЦ=2; ЧН=0,00"),
		ПредставлениеОрганизации(Организация));

КонецФункции

Функция ПредставлениеОрганизации(Организация)

	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = ' (деньги организации «%1»)'"), Организация);

КонецФункции

//«Сделать основной» (формы списка и выбора касс): отметка «Основная» — у одной кассы. Возврат: "" —
//сделано, иначе причина отказа для пользователя (не выбрана строка, группа, помеченная касса, ошибка записи).
Функция НазначитьОсновной(Касса) Экспорт

	Если НЕ ЗначениеЗаполнено(Касса) Или ТипЗнч(Касса) <> Тип("СправочникСсылка.УЗ_Кассы") Тогда
		Возврат НСтр("ru = 'Выберите в списке кассу, которую сделать основной.'");
	КонецЕсли;
	Если Касса.ЭтоГруппа Тогда
		Возврат СтрШаблон(НСтр("ru = '«%1» — группа касс: основной можно сделать только кассу.'"), Касса);
	КонецЕсли;
	Если Касса.ПометкаУдаления Тогда
		Возврат СтрШаблон(НСтр("ru = 'Касса «%1» помечена на удаление — основной её сделать нельзя.'"), Касса);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Кассы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УЗ_Кассы КАК Кассы
	|ГДЕ
	|	Кассы.Основная
	|	И Кассы.Ссылка <> &Касса";
	Запрос.УстановитьПараметр("Касса", Касса);

	НачатьТранзакцию();
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Прежняя = Выборка.Ссылка.ПолучитьОбъект();
			Прежняя.Основная = Ложь;
			Прежняя.Записать();
		КонецЦикла;
		Новая = Касса.ПолучитьОбъект();
		Если НЕ Новая.Основная Тогда
			Новая.Основная = Истина;
			Новая.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		УЗ_Общий.ЗаписатьОшибку("Касса.Основная", ИнформацияОбОшибке(), НСтр("ru = 'Не удалось сделать кассу основной'"));
		Возврат СтрШаблон(НСтр("ru = 'Не удалось сделать кассу «%1» основной: %2'"), Касса,
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат "";

КонецФункции