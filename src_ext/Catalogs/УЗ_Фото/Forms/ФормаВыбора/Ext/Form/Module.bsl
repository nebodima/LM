Процедура СписокПриАктивизацииСтроки(Элемент)
	ОтобразитьФотоНаСервере();
КонецПроцедуры

Процедура ОтобразитьФотоНаСервере()
	//нет текущей строки — фото не показываем
	Текущая = Элементы.Список.ТекущаяСтрока;
	Если ТипЗнч(Текущая) = Тип("СправочникСсылка.УЗ_Фото") И Не Текущая.Пустая() Тогда
		Фото = ПоместитьВоВременноеХранилище(Текущая.Файл.Получить());
	Иначе
		Фото = "";
	КонецЕсли;
КонецПроцедуры

