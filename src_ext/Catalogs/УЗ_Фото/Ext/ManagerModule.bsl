#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Картинка карточки (предмета обучения): заменяет файл текущего фото, а без фото — создаёт новое.
// Раньше каждое «Выбрать фото» создавало ещё одну запись «Фото», старая оставалась мусором в справочнике.
//
// Параметры:
//   Фото - СправочникСсылка.УЗ_Фото - текущее фото карточки (может быть пустым).
//   Наименование - Строка - наименование нового фото (для загрузки по имени файла в «Обработке фото»).
//   Данные - ДвоичныеДанные - картинка.
//
// Возвращаемое значение:
//   СправочникСсылка.УЗ_Фото - то же фото или новое.
//
Функция ФотоСКартинкой(Фото, Наименование, Данные) Экспорт

	Причина = ПричинаНеПодходит(Данные);
	Если Не ПустаяСтрока(Причина) Тогда
		ВызватьИсключение Причина;
	КонецЕсли;

	Если ЗначениеЗаполнено(Фото) Тогда
		ФотоОбъект = Фото.ПолучитьОбъект();
	Иначе
		ФотоОбъект = СоздатьЭлемент();
		ФотоОбъект.Наименование = Наименование;
	КонецЕсли;
	ФотоОбъект.Файл = Новый ХранилищеЗначения(Данные);
	ФотоОбъект.Записать();
	Возврат ФотоОбъект.Ссылка;

КонецФункции

//A8-03: в фото — только картинка (JPEG, PNG, GIF, BMP…) не больше 5 МБ: снимок телефона в 20 МБ тянулся бы целиком
//при каждом открытии карточки. "" — подходит, иначе — почему нет.
Функция ПричинаНеПодходит(Данные) Экспорт

	Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
		Возврат НСтр("ru = 'Выбранный файл — не картинка.'");
	КонецЕсли;
	Предел = 5;
	Если Данные.Размер() > Предел * 1048576 Тогда
		Возврат СтрШаблон(НСтр("ru = 'Фото %1 МБ — больше %2 МБ: уменьшите его перед загрузкой.'"),
			Формат(Данные.Размер() / 1048576, "ЧДЦ=1"), Предел);
	КонецЕсли;
	Попытка
		Картинка = Новый Картинка(Данные);
		ФорматФайла = Картинка.Формат();
	Исключение
		//честно: платформа не прочитала файл как картинку — это и есть ответ «не картинка»
		ФорматФайла = ФорматКартинки.НеизвестныйФормат;
	КонецПопытки;
	Если ФорматФайла = ФорматКартинки.НеизвестныйФормат Тогда
		Возврат НСтр("ru = 'Выбранный файл — не картинка (нужен JPEG, PNG, GIF или BMP).'");
	КонецЕсли;
	Возврат "";

КонецФункции

#КонецОбласти

#КонецЕсли
