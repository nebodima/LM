КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//Папка «Педагоги» или вложенная в неё.
&НаСервереБезКонтекста
Функция ЭтоПапкаПедагогов(Папка)

	Педагоги = Справочники.УЗ_ФизЛица.Педагоги;
	Текущая = Папка;
	Пока ЗначениеЗаполнено(Текущая) Цикл
		Если Текущая = Педагоги Тогда
			Возврат Истина;
		КонецЕсли;
		Текущая = Текущая.Родитель;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#Область Работа_с_фото

Процедура ПоказатьКартинки()

	Фото = УЗ_Общий.АдресФото(Объект.Фото);
	//нет фото — нет пустой рамки (остаётся ссылка «Выбрать фото»)
	Элементы.Фото.Видимость = ЗначениеЗаполнено(Фото);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФото(Команда)
	Оповещение = Новый ОписаниеОповещения("ОбработатьВыборФайла",ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение,,,Истина,УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборФайла(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт

	Если Не Результат Тогда
		Возврат;
	КонецЕсли;

	//выбранный файл только показывается: в базу он попадёт при записи карточки (ПередЗаписьюНаСервере → модуль
	//объекта, в той же транзакции). Прежде фото перезаписывалось в базе сразу при выборе — закрыли карточку без
	//записи, а фото ученика уже другое
	Фото = Адрес;
	ФотоВыбрано = Истина;
	Модифицированность = Истина;
	Элементы.Фото.Видимость = Истина;

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если ФотоВыбрано И ЭтоАдресВременногоХранилища(Фото) Тогда
		ТекущийОбъект.ДополнительныеСвойства.Вставить("УЗ_НовоеФото", ПолучитьИзВременногоХранилища(Фото));
	КонецЕсли;
	//ИНН и документ (В41): проверены здесь (ошибка — у поля), записывает их модуль объекта в транзакции карточки
	Если Элементы.ГруппаДляСправки.Видимость
		И ПравоДоступа("Изменение", Метаданные.РегистрыСведений.УЗ_ДокументыФизЛиц) Тогда
		Данные = РегистрыСведений.УЗ_ДокументыФизЛиц.НовыеДанныеФизЛица();
		Данные.ИНН = СокрЛП(ИННФизЛица);
		Данные.КодВидаДокумента = СокрЛП(КодВидаДокумента);
		Данные.СерияНомерДокумента = СокрЛП(СерияНомерДокумента);
		Данные.ДатаВыдачиДокумента = ДатаВыдачиДокумента;
		Для Каждого ТекстОшибки Из РегистрыСведений.УЗ_ДокументыФизЛиц.ОшибкиДанных(Данные) Цикл
			УЗ_ОбщийКлиентСервер.СообщитьПользователю(ТекстОшибки,
				?(СтрНайти(ТекстОшибки, "ИНН") = 1, "ИННФизЛица", "КодВидаДокумента"), , Отказ);
		КонецЦикла;
		ТекущийОбъект.ДополнительныеСвойства.Вставить("УЗ_ДокументФизЛица", Данные);
	КонецЕсли;

КонецПроцедуры

