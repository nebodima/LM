#КонецОбласти

//Возраст — полных лет на сегодня от даты рождения (УЗ_ОбщийКлиентСервер.ВозрастНаДату; при записи карточки он не
//хранится, если дата рождения известна). Без даты рождения — введённый вручную.
&НаСервере
Процедура РассчитатьВозраст()

	Если ЗначениеЗаполнено(Объект.ДатаРождения) Тогда
		Объект.Возраст = УЗ_ОбщийКлиентСервер.ВозрастНаДату(Объект.ДатаРождения, ТекущаяДатаСеанса());
	КонецЕсли;

КонецПроцедуры

Функция ОткрытьВзаиморасчетыНаСервере()

	//по одному человеку — вариант с документами (его движения дёшевы); основной вариант — без документов
	//(нагрузка: все движения регистра за год — 12–17 с, docs/нагрузка_2026-09-28.md)
	Отборы = Новый Структура;
	Отборы.Вставить(?(Объект.ЭтоПедагог, "Педагог", "Клиент"), Объект.Ссылка);
	Отборы.Вставить("Тариф", Объект.Тариф);
	Возврат УЗ_Общий.ПараметрыОткрытияОтчета("УЗ_Взаиморасчеты", Отборы, "ВзаиморасчетыПодробно");
КонецФункции

&НаКлиенте
Процедура ОткрытьВзаиморасчетыНаКлиенте()

	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПараметрыОткрытия = ОткрытьВзаиморасчетыНаСервере();
		ОткрытьФорму("Отчет.УЗ_Взаиморасчеты.Форма", ПараметрыОткрытия, ЭтаФорма);
	Иначе
		ОткрытьФорму("Отчет.УЗ_Взаиморасчеты.Форма", , ЭтаФорма);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриВыбореWebЦвета(ВыбраныйWebЦвет, ДополнительныеПараметры) Экспорт

	//Обработка выбора цветв
	Если НЕ ВыбраныйWebЦвет = Неопределено Тогда
		//в справочнике — ключ WebЦвета (общая функция, та же у помещений и предметов): имя, собранное из
		//представления («Королевскийголубой»), в WebЦвета не находилось, и карточка падала при открытии
		Объект.Цвет = УЗ_ОбщийКлиентСервер.ИмяWebЦвета(ВыбраныйWebЦвет);
		Модифицированность = Истина;
		ПоказатьЦвет();
	КонецЕсли;

КонецПроцедуры

//Цвет педагога на кнопке: сохранённое имя (ключ WebЦвета) читается общей функцией; неизвестное имя — кнопка без
//цвета, карточка не падает.
&НаКлиенте
Процедура ПоказатьЦвет()

	ЗначениеЦвета = УЗ_ОбщийКлиентСервер.WebЦветПоИмени(Объект.Цвет);
	Элементы.ПриНажатииКнопкиВыборЦвета.ЦветФона = ЗначениеЦвета;
	Если ЗначениеЦвета <> Новый Цвет Тогда
		Элементы.ПриНажатииКнопкиВыборЦвета.Заголовок = УЗ_ОбщийКлиентСервер.ИмяЦветаСловами(ЗначениеЦвета);
	КонецЕсли;

КонецПроцедуры

//Остатки денег ученика по организациям (В12, как взаиморасчёты в типовых): строки «организация × предмет» —
//УЗ_Сервер.ОстаткиДенегУченика, итог — по каждой организации через УЗ_Сервер.ОстатокДенегУченика (та же функция,
//что в уроке, ПКО и панели ученика). Аванс 8 000 в А и долг 1 000 в Б — «А: +8 000,00; Б: -1 000,00», а не общие
//+7 000. Блок «по тарифу» — Справочники.УЗ_ФизЛица.ОстатокПоТарифу в организации остатков списков (настройки учёта):
//цена тарифа на сегодня (история цен, В8), без деления на ноль.
&НаСервере
Процедура ЗаполнитьИтоги()

	Если Объект.Ссылка.Пустая() Или Объект.ЭтоПедагог Тогда
		Возврат;
	КонецЕсли;

	Долги.Очистить();
	Организации = Новый Массив;
	Для Каждого СтрокаОстатка Из УЗ_Сервер.ОстаткиДенегУченика(Объект.Ссылка) Цикл
		НоваяСтрока = Долги.Добавить();
		НоваяСтрока.Организация = СтрокаОстатка.Организация;
		НоваяСтрока.Предмет = СтрокаОстатка.ПредметОбучения;
		НоваяСтрока.Долг = СтрокаОстатка.Остаток;
		Если Организации.Найти(СтрокаОстатка.Организация) = Неопределено Тогда
			Организации.Добавить(СтрокаОстатка.Организация);
		КонецЕсли;
	КонецЦикла;
	Элементы.ДолгиОрганизация.Видимость = Организации.Количество() > 1;

	Части = Новый Массив;
	ЕстьДолг = Ложь;
	Для Каждого Организация Из Организации Цикл
		Остаток = УЗ_Сервер.ОстатокДенегУченика(Объект.Ссылка, Организация);
		ЕстьДолг = ЕстьДолг Или Остаток < 0;
		Части.Добавить(?(Организации.Количество() > 1, Строка(Организация) + ": ", "") + ОстатокСтрокой(Остаток));
	КонецЦикла;
	Элементы.ДекорацияЗадолженность.Заголовок = СтрСоединить(Части, "; ");
	Элементы.ДекорацияЗадолженность.ЦветТекста =
		?(ЕстьДолг, УЗ_ОбщийКлиентСервер.ЦветМинусаДенег(), УЗ_ОбщийКлиентСервер.ЦветПлюсаДенег());

	ОстатокДенегПоТарифу = "";
	ОстатокЕдиницПоТарифу = "";
	ВсегоУроковПоТарифу = 0;
	ВсегоЯвокПоТарифу = 0;
	Если ЗначениеЗаполнено(Объект.Тариф) Тогда
		ПоТарифу = Справочники.УЗ_ФизЛица.ОстатокПоТарифу(Объект.Ссылка, Объект.Тариф, УЗ_Сервер.ОрганизацияОстатков());
		Если ПоТарифу.Остаток <> 0 Тогда
			ОстатокДенегПоТарифу = ОстатокСтрокой(ПоТарифу.Остаток);
			Элементы.ОстатокДенегПоТарифу1.ЦветТекста =
				?(ПоТарифу.Остаток > 0, УЗ_ОбщийКлиентСервер.ЦветПлюсаДенег(), УЗ_ОбщийКлиентСервер.ЦветМинусаДенег());
		КонецЕсли;
		Если ПоТарифу.Единиц <> Неопределено Тогда
			//часы — «ч:мм», уроки — числом
			ОстатокЕдиницПоТарифу = ?(ПоТарифу.ЕдиницаИзмерения = НСтр("ru = 'ч'"),
				УЗ_ОбщийКлиентСервер.ЧасыМинуты(ПоТарифу.Единиц), Формат(ПоТарифу.Единиц, "ЧН=0; ЧГ="));
		КонецЕсли;
		Элементы.ОстатокЕдиницПоТарифу.Заголовок = ?(ПоТарифу.ЕдиницаИзмерения = НСтр("ru = 'ч'"),
			НСтр("ru = 'Осталось часов'"), НСтр("ru = 'Осталось уроков'"));
		ВсегоУроковПоТарифу = ПоТарифу.Уроков;
		ВсегоЯвокПоТарифу = ПоТарифу.Явок;
	КонецЕсли;

КонецПроцедуры

//«+8 000,00» — оплачено вперёд, «-1 000,00» — долг.
&НаСервереБезКонтекста
Функция ОстатокСтрокой(Остаток)
	Возврат ?(Остаток > 0, Формат(Остаток, "ЧДЦ=2; ЧФ=+Ч"), Формат(Остаток, "ЧДЦ=2; ЧН=0,00"));
КонецФункции

&НаКлиенте
Процедура ОбновитьВидимостьЭлементов()

	ПоказатьЦвет();

	ЗаполнитьИтоги();

	Если Объект.ЭтоПедагог Тогда
		Элементы.ОсновнойПлательщик.Видимость = Ложь;
		Элементы.ГруппаПлательщики.Видимость = Ложь;
		//ставка педагога — только руководителю (у менеджера нет права на зарплату)
		Если ЗарплатаДоступна = Неопределено Тогда
			ЗарплатаДоступна = ДоступнаЗарплата();
		КонецЕсли;
		Элементы.СтавкаПедагога.Видимость = ЗарплатаДоступна;
		//под каким пользователем педагог входит в программу (роль «Учёт занятий: педагог» — только свои уроки)
		Элементы.Пользователь.Видимость = Истина;
		Элементы.Скидка.Видимость = Ложь;
		Элементы.Тариф.Видимость = Ложь;
	Иначе
		Элементы.ОсновнойПлательщик.Видимость = Истина;
		Элементы.ГруппаПлательщики.Видимость = Истина;
		Элементы.СтавкаПедагога.Видимость = Ложь;
		Элементы.Пользователь.Видимость = Ложь;
		Элементы.Скидка.Видимость = Истина;
		Элементы.Тариф.Видимость = Истина;
	КонецЕсли;

	ПоказатьКартинки();

КонецПроцедуры

//Группы ученика — интервалы членства по регистру состава групп (РегистрыСведений.УЗ_СоставГрупп.ГруппыУченика):
//с какого по какое число и каким документом; «По» пусто — состоит сейчас.
&НаСервере
Процедура ЗаполнитьГруппыУченика()

	ГруппыУченика.Очистить();
	Для Каждого Интервал Из РегистрыСведений.УЗ_СоставГрупп.ГруппыУченика(Объект.Ссылка) Цикл
		ЗаполнитьЗначенияСвойств(ГруппыУченика.Добавить(), Интервал);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура УстановитьОсновногоПлательщикаНаСервере()
	Справочники.УЗ_ФизЛица.УстановитьОсновногоПлательщика(Объект, ОсновнойПлательщик);
	ОсновнойПлательщик = ОсновнойПлательщикКарточки(Объект.Плательщики);
КонецПроцедуры

//Основной плательщик строк карточки: отмеченный, иначе первый (он станет основным при записи), иначе пусто.
&НаКлиентеНаСервереБезКонтекста
Функция ОсновнойПлательщикКарточки(Плательщики)

	Для Каждого СтрокаПлательщика Из Плательщики Цикл
		Если СтрокаПлательщика.Основной Тогда
			Возврат СтрокаПлательщика.Плательщик;
		КонецЕсли;
	КонецЦикла;
	Если Плательщики.Количество() > 0 Тогда
		Возврат Плательщики[0].Плательщик;
	КонецЕсли;
	Возврат ПредопределенноеЗначение("Справочник.УЗ_ФизЛица.ПустаяСсылка");

КонецФункции

&НаСервереБезКонтекста
Функция ДоступнаЗарплата()
	Возврат УЗ_Общий.ДоступнаЗарплата();
КонецФункции

