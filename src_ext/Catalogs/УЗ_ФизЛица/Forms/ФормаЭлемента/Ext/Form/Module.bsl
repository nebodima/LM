&НаКлиенте
Перем ЗарплатаДоступна;	//видна ли ставка педагога (роль руководителя); спрашивается у сервера один раз

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Документы.УстановитьОбязательноеИспользование("Часы", Истина); //для «ч:мм» в ДокументыПриПолученииДанныхНаСервере

	Если Объект.Ссылка.Пустая() Тогда
		//«(создать)» из поля Родитель/Ученик: папка по имени предопределённой группы и набранное ФИО
		Если ТипЗнч(Параметры.Ключ2) = Тип("Структура") Тогда
			Если Параметры.Ключ2.Свойство("Группа")
				И Справочники.УЗ_ФизЛица.ПолучитьИменаПредопределенных().Найти(
					Параметры.Ключ2.Группа) <> Неопределено Тогда
				Объект.Родитель = Справочники.УЗ_ФизЛица[Параметры.Ключ2.Группа];
			КонецЕсли;
			Если Параметры.Ключ2.Свойство("Наименование") И ПустаяСтрока(Объект.Наименование) Тогда
				Объект.Наименование = Параметры.Ключ2.Наименование;
			КонецЕсли;
		КонецЕсли;
		//создают в папке «Педагоги» — это педагог
		Если Не Объект.ЭтоПедагог И ЭтоПапкаПедагогов(Объект.Родитель) Тогда
			Объект.ЭтоПедагог = Истина;
		КонецЕсли;
	КонецЕсли;
	//возраст не хранится при известной дате рождения — показываем вычисленный на сегодня
	РассчитатьВозраст();
	ЗаполнитьГруппыУченика();
	ОсновнойПлательщик = ОсновнойПлательщикКарточки(Объект.Плательщики);
	ПрочитатьДокументФизЛица();
	ПоказатьСостояниеСообщений();

КонецПроцедуры

//Сообщения (В45): Telegram привязан или нет; кнопки — у кого есть права (педагогу привязок не видно).
&НаСервере
Процедура ПоказатьСостояниеСообщений()

	МожноПривязки = ПравоДоступа("Изменение", Метаданные.РегистрыСведений.УЗ_ПривязкиКаналов);
	Элементы.ГруппаТелеграм.Видимость = ПравоДоступа("Чтение", Метаданные.РегистрыСведений.УЗ_ПривязкиКаналов);
	Элементы.СсылкаДляТелеграм.Видимость = МожноПривязки;
	Элементы.НаписатьСообщение.Видимость = ПравоДоступа("Использование", Метаданные.Обработки.УЗ_ОтправкаСообщения);
	Если Элементы.ГруппаТелеграм.Видимость Тогда
		СостояниеТелеграм = УЗ_Сообщения.СостояниеТелеграм(Объект.Ссылка);
	КонецЕсли;

КонецПроцедуры

//Страница «Для справки в налоговую» (В41): ИНН и документ — из регистра УЗ_ДокументыФизЛиц (у педагога прав на него
//нет, у кого нет права изменения — только просмотр).
&НаСервере
Процедура ПрочитатьДокументФизЛица()

	Регистр = Метаданные.РегистрыСведений.УЗ_ДокументыФизЛиц;
	Если Не ПравоДоступа("Чтение", Регистр) Тогда
		Элементы.ГруппаДляСправки.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	Данные = РегистрыСведений.УЗ_ДокументыФизЛиц.ДанныеФизЛица(Объект.Ссылка);
	ИННФизЛица = Данные.ИНН;
	КодВидаДокумента = Данные.КодВидаДокумента;
	СерияНомерДокумента = Данные.СерияНомерДокумента;
	ДатаВыдачиДокумента = Данные.ДатаВыдачиДокумента;
	Элементы.КодВидаДокумента.СписокВыбора.Очистить();
	Для Каждого Вид Из РегистрыСведений.УЗ_ДокументыФизЛиц.ВидыДокументов() Цикл
		Элементы.КодВидаДокумента.СписокВыбора.Добавить(Вид.Значение, Вид.Представление);
	КонецЦикла;
	Если Не ПравоДоступа("Изменение", Регистр) Тогда
		Элементы.ГруппаДляСправки.ТолькоПросмотр = Истина;
	КонецЕсли;

КонецПроцедуры

//Перевод ученика записан (форма документа оповещает) — группы на вкладке «Группы обучения» перечитываются.
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "УЗ_ПереводУченика" И ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ЗаполнитьГруппыУченика();
	КонецЕсли;

КонецПроцедуры

//Конец расчет возраста
&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)

	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Оповестить(Объект.Ссылка);
	КонецЕсли;

КонецПроцедуры

