	ОткрытьВзаиморасчетыНаКлиенте();

КонецПроцедуры

//Зачисление, перевод и выбытие — только документом «Перевод ученика» (В29: состав групп — регистр, у каждого
//изменения есть дата и документ; прежде строки групп правились в карточке без следа).
&НаКлиенте
Процедура ПеревестиВГруппу(Команда)

	Если Объект.Ссылка.Пустая() Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Сначала запишите карточку ученика — затем переведите его в группу'"));
		Возврат;
	КонецЕсли;
	ОткрытьФорму("Документ.УЗ_ПереводУченика.ФормаОбъекта", Новый Структура("Основание", Объект.Ссылка), ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПриНажатииКнопкиВыборЦвета(Команда)

	Кнопка = ЭтаФорма.ТекущийЭлемент;

	Обработчик = Новый ОписаниеОповещения("ПриВыбореWebЦвета", ЭтаФорма);
	Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	ДопПарам = Новый Структура("ИмяКнопки", Кнопка.Имя);

	//Форма текущей демо обработки
