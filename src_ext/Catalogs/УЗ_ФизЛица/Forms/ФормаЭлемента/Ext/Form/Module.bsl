&НаКлиенте
Процедура СсылкаДляТелеграм(Команда)

	Если Объект.Ссылка.Пустая() Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(НСтр("ru = 'Сначала запишите карточку.'"), "Объект.Наименование");
		Возврат;
	КонецЕсли;
	Ошибка = ПолучитьСсылкуТелеграм();
	Если Не ПустаяСтрока(Ошибка) Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(Ошибка, "СсылкаТелеграм");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ПолучитьСсылкуТелеграм()

	Итог = УЗ_Сообщения.СсылкаПривязкиТелеграм(Объект.Ссылка);
	СсылкаТелеграм = Итог.Ссылка;
	Элементы.СсылкаТелеграм.Видимость = Не ПустаяСтрока(СсылкаТелеграм);
	СостояниеТелеграм = УЗ_Сообщения.СостояниеТелеграм(Объект.Ссылка);
	Возврат Итог.Ошибка;

КонецФункции

