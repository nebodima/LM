
Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Или ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;

	//ставку педагога назначает руководитель (R24): менеджеру — отказ и в обход формы
	УЗ_ЗарплатаУрока.ПроверитьСтавкуСправочника(ЭтотОбъект, Отказ);

	//новый педагог без папки — в группу «Педагоги» (не в корень справочника)
	Если ЭтоНовый() И ЭтоПедагог И Не ЗначениеЗаполнено(Родитель) Тогда
		Родитель = Справочники.УЗ_ФизЛица.Педагоги;
	КонецЕсли;
	//возраст не хранится, если известна дата рождения: его вычисляют от даты рождения (списки, карточка, дни
	//рождения — УЗ_ОбщийКлиентСервер.ВозрастНаДату). Хранимый «Возраст» — только когда даты рождения нет
	Если ЗначениеЗаполнено(ДатаРождения) Тогда
		Возраст = 0;
	КонецЕсли;
	ПроверитьПользователяПрограммы(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	//новое фото, выбранное в карточке (ДополнительныеСвойства.УЗ_НовоеФото — ДвоичныеДанные), применяется только при
	//записи карточки и в её транзакции: не записали карточку — фото в базе прежнее. Картинка — в текущее фото
	//(новая запись «Фото» — только если фото не было), Справочники.УЗ_Фото.ФотоСКартинкой — как у предмета
	НовоеФото = Неопределено;
	Если ДополнительныеСвойства.Свойство("УЗ_НовоеФото", НовоеФото) И ТипЗнч(НовоеФото) = Тип("ДвоичныеДанные") Тогда
		Фото = Справочники.УЗ_Фото.ФотоСКартинкой(Фото, Наименование, НовоеФото);
		ДополнительныеСвойства.Удалить("УЗ_НовоеФото");
	КонецЕсли;

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	Тариф = Неопределено;
	Скидка = Неопределено;
	Наименование = Неопределено;
	ЭтоПедагог = Неопределено;
	СтавкаПедагога = Неопределено;
	Родитель = Неопределено;
	Родитель1 = Неопределено;
	Возраст = Неопределено;
	ДатаРождения = Неопределено;
	Пол = Неопределено;
	Цвет = Неопределено;
	Фото = Неопределено;
	//учётная запись — у человека своя: копия карточки педагога без связи с пользователем (Codex 3, находка 4 —
	//прежде копия Сергея под именем Андрея входила в «Мои уроки» Сергея)
	Пользователь = Неопределено;

	ГруппыОбученияПрежние.Очистить();

КонецПроцедуры

//«Пользователь программы» — вход педагога в «Мои уроки» (роль педагога видит уроки и зарплату по этой связи). Codex 3,
//находка 4: связь меняет только тот, у кого есть право на это поле (руководитель; у менеджера поле только для
//просмотра — запрет действует и в обход формы, программной записью), и один пользователь связан не больше чем
//с одним действующим (не помеченным на удаление) педагогом.
Процедура ПроверитьПользователяПрограммы(Отказ)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ФизЛица.Пользователь КАК Пользователь
	|ИЗ
	|	Справочник.УЗ_ФизЛица КАК ФизЛица
	|ГДЕ
	|	ФизЛица.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ФизЛица.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УЗ_ФизЛица КАК ФизЛица
	|ГДЕ
	|	ФизЛица.Пользователь = &Пользователь
	|	И ФизЛица.Ссылка <> &Ссылка
	|	И ФизЛица.ЭтоПедагог
	|	И НЕ ФизЛица.ПометкаУдаления
	|	И НЕ ФизЛица.ЭтоГруппа");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Пакет = Запрос.ВыполнитьПакет();
	Прежний = Пакет[0].Выбрать();
	Изменен = ?(Прежний.Следующий(), Прежний.Пользователь <> Пользователь, ЗначениеЗаполнено(Пользователь));
	Если Изменен И Не ПравоДоступа("Редактирование", Метаданные().Реквизиты.Пользователь) Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Пользователя программы у педагога указывает руководитель — у вас это поле только для "
				+ "просмотра'"),
			"Объект.Пользователь", , Отказ);
		Возврат;
	КонецЕсли;
	Если Не ЭтоПедагог Или ПометкаУдаления Или Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат;
	КонецЕсли;
	Занят = Пакет[1].Выбрать();
	Если Занят.Следующий() Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(
			СтрШаблон(НСтр(
				"ru = 'Пользователь программы %1 уже связан с педагогом %2: у педагога своя учётная запись'"),
			Пользователь, Занят.Ссылка), "Объект.Пользователь", , Отказ);
	КонецЕсли;

КонецПроцедуры
