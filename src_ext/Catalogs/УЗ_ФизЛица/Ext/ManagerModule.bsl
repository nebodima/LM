#Область Остатки

//Блок «по тарифу» карточки ученика: остаток денег по тарифу карточки в организации (В12) и сколько уроков (часов)
//он покрывает по цене тарифа на дату (В8: Документы.УЗ_Урок.ЦенаТарифаНаДату — та же цена, что в уроке и панели;
//было: цена карточки тарифа — у тарифа с историей цен блок молчал). Цены нет или в ней 0 уроков и 0 часов —
//единиц не считаем (было: деление на ноль).
//Структура: Остаток (число), Единиц (число или Неопределено — не считается), ЕдиницаИзмерения («уроков»/«ч»),
//Уроков, Явок (проведено по тарифу).
Функция ОстатокПоТарифу(Ученик, Тариф, Организация, Дата = Неопределено) Экспорт

	Итог = Новый Структура("Остаток, Единиц, ЕдиницаИзмерения, Уроков, Явок", 0, Неопределено, "", 0, 0);
	Если Не ЗначениеЗаполнено(Ученик) Или Не ЗначениеЗаполнено(Тариф) Тогда
		Возврат Итог;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК Остаток,
	|	ЕСТЬNULL(СУММА(Остатки.КоличествоУроковОстаток), 0) КАК Уроков,
	|	ЕСТЬNULL(СУММА(Остатки.КоличествоЯвокОстаток), 0) КАК Явок
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки.Остатки(
	|			,
	|			Клиент = &Ученик
	|				И Тариф = &Тариф
	|				И (&ВсеОрганизации
	|					ИЛИ Организация = &Организация)) КАК Остатки";
	Запрос.УстановитьПараметр("Ученик", Ученик);
	Запрос.УстановитьПараметр("Тариф", Тариф);
	Запрос.УстановитьПараметр("ВсеОрганизации", Организация = Неопределено);
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Итог.Остаток = Выборка.Остаток;
	Итог.Уроков = Выборка.Уроков;
	Итог.Явок = Выборка.Явок;
	Если Итог.Остаток <= 0 Тогда
		Возврат Итог;
	КонецЕсли;
	//цена единицы — одна функция с панелью ученика (Документы.УЗ_Урок.ЦенаЕдиницыТарифа: цена на дату, уроки или часы)
	Цена = Документы.УЗ_Урок.ЦенаЕдиницыТарифа(Тариф, ?(Дата = Неопределено, ТекущаяДатаСеанса(), Дата));
	Если Цена = Неопределено Или Цена.Цена <= 0 Тогда
		Возврат Итог;
	КонецЕсли;
	Итог.Единиц = Окр(Итог.Остаток / Цена.Цена, 2);
	Итог.ЕдиницаИзмерения = ?(Цена.Единица = "ч.", НСтр("ru = 'ч'"), НСтр("ru = 'уроков'"));
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область Плательщики

//В33 (этап 2.1): плательщики ученика — табличная часть «Плательщики» карточки (мама, папа, бабушка — физ. лица),
//один из них основной. Основной подставляется в приход денег (поле «Плательщик»); строк нет — пустая ссылка
//(платит сам ученик). Отмеченного основного нет (данные записаны мимо проверки) — первый по порядку.
Функция ОсновнойПлательщик(Ученик) Экспорт

	Если НЕ ЗначениеЗаполнено(Ученик) Тогда
		Возврат ПустаяСсылка();
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Плательщики.Плательщик КАК Плательщик
	|ИЗ
	|	Справочник.УЗ_ФизЛица.Плательщики КАК Плательщики
	|ГДЕ
	|	Плательщики.Ссылка = &Ученик
	|	И Плательщики.Плательщик <> ЗНАЧЕНИЕ(Справочник.УЗ_ФизЛица.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Плательщики.Основной УБЫВ,
	|	Плательщики.НомерСтроки";
	Запрос.УстановитьПараметр("Ученик", Ученик);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Плательщик, ПустаяСсылка());

КонецФункции

//Ученики, за которых платит Плательщик (он есть в их плательщиках), кроме выбывших и помеченных на удаление —
//по наименованию. Массив ссылок.
Функция УченикиПлательщика(Плательщик) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Плательщики.Ссылка КАК Ученик,
	|	Плательщики.Ссылка.Наименование КАК Наименование
	|ИЗ
	|	Справочник.УЗ_ФизЛица.Плательщики КАК Плательщики
	|ГДЕ
	|	Плательщики.Плательщик = &Плательщик
	|	И НЕ Плательщики.Ссылка.ПометкаУдаления
	|	И НЕ Плательщики.Ссылка.Выбыл
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Запрос.УстановитьПараметр("Плательщик", Плательщик);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ученик");

КонецФункции

//Проверка плательщиков карточки перед записью (В33): у каждой строки указан плательщик, плательщик не повторяется
//и не сам ученик (платит сам — в оплате плательщик пустой), основной — один; ни одной отмеченной строки — основным
//становится первая. Ошибки — у поля строки.
Процедура ПроверитьПлательщиков(ФизЛицо, Отказ) Экспорт

	Плательщики = ФизЛицо.Плательщики;
	Встречались = Новый Соответствие;
	Основных = 0;
	Для Каждого СтрокаПлательщика Из Плательщики Цикл
		Поле = СтрШаблон("Объект.Плательщики[%1].Плательщик", Формат(СтрокаПлательщика.НомерСтроки - 1, "ЧН=0; ЧГ=0"));
		Если НЕ ЗначениеЗаполнено(СтрокаПлательщика.Плательщик) Тогда
			УЗ_ОбщийКлиентСервер.СообщитьПользователю(СтрШаблон(НСтр(
				"ru = 'Плательщики, строка %1: укажите плательщика (или удалите пустую строку).'"),
				СтрокаПлательщика.НомерСтроки), Поле, , Отказ);
			Продолжить;
		КонецЕсли;
		Если СтрокаПлательщика.Плательщик = ФизЛицо.Ссылка И НЕ ФизЛицо.Ссылка.Пустая() Тогда
			УЗ_ОбщийКлиентСервер.СообщитьПользователю(СтрШаблон(НСтр(
				"ru = 'Плательщики, строка %1: ученик не может быть своим плательщиком — если платит сам, в приходе "
				+ "денег поле «Плательщик» остаётся пустым.'"), СтрокаПлательщика.НомерСтроки), Поле, , Отказ);
		КонецЕсли;
		Если Встречались[СтрокаПлательщика.Плательщик] <> Неопределено Тогда
			УЗ_ОбщийКлиентСервер.СообщитьПользователю(СтрШаблон(НСтр(
				"ru = 'Плательщики, строка %1: %2 уже есть в строке %3.'"), СтрокаПлательщика.НомерСтроки,
				СтрокаПлательщика.Плательщик, Встречались[СтрокаПлательщика.Плательщик]), Поле, , Отказ);
		КонецЕсли;
		Встречались.Вставить(СтрокаПлательщика.Плательщик, СтрокаПлательщика.НомерСтроки);
		Если СтрокаПлательщика.Основной Тогда
			Основных = Основных + 1;
		КонецЕсли;
	КонецЦикла;
	Если Основных > 1 Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Основной плательщик — один: снимите отметку «Основной» у остальных.'"),
			"Объект.Плательщики", , Отказ);
	ИначеЕсли Основных = 0 И Плательщики.Количество() > 0 Тогда
		Плательщики[0].Основной = Истина;
	КонецЕсли;

КонецПроцедуры

//Сделать Плательщик основным плательщиком карточки (поле «Основной плательщик» на главной странице, первая
//настройка, шаг обновления данных 2): есть в строках — отметка переходит к нему, нет — добавляется строка. Пусто —
//строка прежнего основного удаляется (как очистка прежнего поля «Родитель»); основным при записи станет первый из
//оставшихся. ФизЛицо — объект справочника или данные формы.
Процедура УстановитьОсновногоПлательщика(ФизЛицо, Плательщик, КемПриходится = "") Экспорт

	Найдена = Неопределено;
	Прежние = Новый Массив;
	Для Каждого СтрокаПлательщика Из ФизЛицо.Плательщики Цикл
		Если СтрокаПлательщика.Основной Тогда
			Прежние.Добавить(СтрокаПлательщика);
		КонецЕсли;
		СтрокаПлательщика.Основной = Ложь;
		Если ЗначениеЗаполнено(Плательщик) И СтрокаПлательщика.Плательщик = Плательщик Тогда
			Найдена = СтрокаПлательщика;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЗначениеЗаполнено(Плательщик) Тогда
		Для Каждого СтрокаПлательщика Из Прежние Цикл
			ФизЛицо.Плательщики.Удалить(СтрокаПлательщика);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	Если Найдена = Неопределено Тогда
		Найдена = ФизЛицо.Плательщики.Добавить();
		Найдена.Плательщик = Плательщик;
		Найдена.КемПриходится = КемПриходится;
	КонецЕсли;
	Найдена.Основной = Истина;

КонецПроцедуры

#КонецОбласти

#Область ДниРождения

//Дни рождения сегодня и в ближайшие Дней дней (журнал уроков). «Осталось дней» — до ближайшего дня рождения
//(0 — сегодня; 29 февраля в невисокосный год — 1 марта), «Исполнится» — сколько лет исполнится в этот день
//(вычисляется от даты рождения; было: хранимый «Возраст», устаревал), «Кто» — ученик или педагог.
//ТаблицаЗначений: ФизЛицо, Дата, ОсталосьДней, Исполнится, Кто — по «Осталось дней».
Функция ДниРождения(Сегодня, Дней = 10) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ФизЛица.Ссылка КАК ФизЛицо,
	|	ФизЛица.ДатаРождения КАК Дата,
	|	ФизЛица.ЭтоПедагог КАК ЭтоПедагог
	|ИЗ
	|	Справочник.УЗ_ФизЛица КАК ФизЛица
	|ГДЕ
	|	НЕ ФизЛица.ПометкаУдаления
	|	И НЕ ФизЛица.ЭтоГруппа
	|	И НЕ ФизЛица.Выбыл
	|	И ФизЛица.ДатаРождения <> ДАТАВРЕМЯ(1, 1, 1)";
	Выборка = Запрос.Выполнить().Выбрать();

	Итог = Новый ТаблицаЗначений;
	Итог.Колонки.Добавить("ФизЛицо", Новый ОписаниеТипов("СправочникСсылка.УЗ_ФизЛица"));
	Итог.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	Итог.Колонки.Добавить("ОсталосьДней", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0)));
	Итог.Колонки.Добавить("Исполнится", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0)));
	Итог.Колонки.Добавить("Кто", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(10)));
	НачалоСегодня = НачалоДня(Сегодня);
	Пока Выборка.Следующий() Цикл
		Осталось = ДнейДоДняРождения(Выборка.Дата, НачалоСегодня);
		Если Осталось > Дней Тогда
			Продолжить;
		КонецЕсли;
		СтрокаДня = Итог.Добавить();
		СтрокаДня.ФизЛицо = Выборка.ФизЛицо;
		СтрокаДня.Дата = Выборка.Дата;
		СтрокаДня.ОсталосьДней = Осталось;
		СтрокаДня.Исполнится = УЗ_ОбщийКлиентСервер.ВозрастНаДату(Выборка.Дата, НачалоСегодня + Осталось * 86400);
		СтрокаДня.Кто = ?(Выборка.ЭтоПедагог, НСтр("ru = 'педагог'"), НСтр("ru = 'ученик'"));
	КонецЦикла;
	Итог.Сортировать("ОсталосьДней, Дата");
	Возврат Итог;

КонецФункции

//Дней от Сегодня до ближайшего дня рождения (29 февраля в невисокосный год — 1 марта).
Функция ДнейДоДняРождения(ДатаРождения, Сегодня) Экспорт

	Для Смещение = 0 По 1 Цикл
		ГодДня = Год(Сегодня) + Смещение;
		Если Месяц(ДатаРождения) = 2 И День(ДатаРождения) = 29 И День(КонецМесяца(Дата(ГодДня, 2, 1))) = 28 Тогда
			ДеньРождения = Дата(ГодДня, 3, 1);
		Иначе
			ДеньРождения = Дата(ГодДня, Месяц(ДатаРождения), День(ДатаРождения));
		КонецЕсли;
		Если ДеньРождения >= НачалоДня(Сегодня) Тогда
			Возврат (ДеньРождения - НачалоДня(Сегодня)) / 86400;
		КонецЕсли;
	КонецЦикла;
	Возврат 366;

КонецФункции

