#Область ПрограммныйИнтерфейс

#Область СоставГрупп

//Единое правило «член группы на дату урока» (docs/логики/группы_и_расписание.md, Р3–Р4): группы ученика — строки ТЧ
//ГруппыОбучения карточки. Строка действует на дату, если «Дата начала» пустая или не позже даты и «Дата окончания»
//пустая или дата не позже конца её дня. Строк одной группы несколько (ушёл и вернулся) — достаточно одной
//действующей (было: одна просроченная строка запрещала урок, хотя другая действовала; «Дата начала» не проверялась).
//  Возвращает "" — ученик в группе на дату; иначе причину словами для сообщения.
Функция ПроверитьЧленствоВГруппе(Ученик, ГруппаОбучения, Дата) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Группы.ДатаНачала КАК ДатаНачала,
	|	Группы.ДатаОкончания КАК ДатаОкончания
	|ИЗ
	|	Справочник.УЗ_ФизЛица.ГруппыОбучения КАК Группы
	|ГДЕ
	|	Группы.Ссылка = &Ученик
	|	И Группы.ГруппаОбучения = &ГруппаОбучения";
	Запрос.УстановитьПараметр("Ученик", Ученик);
	Запрос.УстановитьПараметр("ГруппаОбучения", ГруппаОбучения);
	Возврат ПричинаПоСтрокамГруппы(Запрос.Выполнить().Выгрузить(), ГруппаОбучения, Дата);

КонецФункции

//"" — одна из строк группы (ТаблицаЗначений или Массив строк с ДатаНачала, ДатаОкончания) действует на дату, иначе
//причина словами (ПроверитьЧленствоВГруппе).
Функция ПричинаПоСтрокамГруппы(Строки, ГруппаОбучения, Дата)

	Если Строки.Количество() = 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'не разрешена группа %1 (её нет в карточке ученика)'"), ГруппаОбучения);
	КонецЕсли;
	Начало = Неопределено;
	Окончание = Неопределено;
	Для Каждого СтрокаГруппы Из Строки Цикл
		Если СтрокаДействуетНаДату(СтрокаГруппы, Дата) Тогда
			Возврат "";
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаГруппы.ДатаНачала) И СтрокаГруппы.ДатаНачала > Дата Тогда
			Начало = ?(Начало = Неопределено, СтрокаГруппы.ДатаНачала, Мин(Начало, СтрокаГруппы.ДатаНачала));
		Иначе
			Окончание =
				?(Окончание = Неопределено, СтрокаГруппы.ДатаОкончания, Макс(Окончание, СтрокаГруппы.ДатаОкончания));
		КонецЕсли;
	КонецЦикла;
	Если Окончание <> Неопределено Тогда
		Возврат СтрШаблон(НСтр("ru = 'окончен срок группы %1 (%2)'"), ГруппаОбучения, Формат(Окончание, "ДЛФ=D"));
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'группа %1 у ученика начинается с %2'"), ГруппаОбучения, Формат(Начало, "ДЛФ=D"));

КонецФункции

//Ученик в группе на дату (см. ПроверитьЧленствоВГруппе).
Функция ЧленГруппыНаДату(Ученик, ГруппаОбучения, Дата) Экспорт
	Возврат ПустаяСтрока(ПроверитьЧленствоВГруппе(Ученик, ГруппаОбучения, Дата));
КонецФункции

//Состав группы на дату урока — одно правило для помощника уроков, продления группы, календаря: ученики, у которых
//строка группы действует на дату (правило — ПроверитьЧленствоВГруппе), без педагогов, выбывших (В18) и помеченных
//на удаление. Массив ссылок, по наименованию.
Функция СоставГруппыНаДату(ГруппаОбучения, Дата) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Группы.Ссылка КАК Ученик,
	|	Группы.Ссылка.Наименование КАК Наименование
	|ИЗ
	|	Справочник.УЗ_ФизЛица.ГруппыОбучения КАК Группы
	|ГДЕ
	|	Группы.ГруппаОбучения = &ГруппаОбучения
	|	И (Группы.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ Группы.ДатаНачала <= &Дата)
	|	И (Группы.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ Группы.ДатаОкончания >= &НачалоДня)
	|	И НЕ Группы.Ссылка.ПометкаУдаления
	|	И НЕ Группы.Ссылка.ЭтоПедагог
	|	И НЕ Группы.Ссылка.Выбыл
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Запрос.УстановитьПараметр("ГруппаОбучения", ГруппаОбучения);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(Дата));
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ученик");

КонецФункции

//Ученики из списка, которых нельзя записать в урок группы на дату (В18, Р3–Р4, В22) — Соответствие «ученик → причина
//словами»: выбывший (отметка «Выбыл») — всегда; ученик, у которого в карточке есть строки этой группы, но ни одна не
//действует на дату урока (выбыл из группы — «Дата окончания», переведён в другую — В22, ещё не начал — «Дата
//начала»). Ученика без строк этой группы (добавлен в урок вручную, старые данные) не отбрасываем. Для записи уроков
//группы помощником (Документы.УЗ_Урок.ЗаписатьУчениковВУрок) — на дату КАЖДОГО урока, а не одну на весь период.
Функция НеЗаписыватьВУрокГруппы(ГруппаОбучения, Ученики, Дата) Экспорт

	Итог = Новый Соответствие;
	Если Ученики.Количество() = 0 Или Не ЗначениеЗаполнено(ГруппаОбучения) Тогда
		Возврат Итог;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ФизЛица.Ссылка КАК Ученик,
	|	ФизЛица.Выбыл КАК Выбыл,
	|	ЕСТЬNULL(Группы.НомерСтроки, 0) КАК НомерСтроки,
	|	Группы.ДатаНачала КАК ДатаНачала,
	|	Группы.ДатаОкончания КАК ДатаОкончания
	|ИЗ
	|	Справочник.УЗ_ФизЛица КАК ФизЛица
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.УЗ_ФизЛица.ГруппыОбучения КАК Группы
	|		ПО (Группы.Ссылка = ФизЛица.Ссылка)
	|			И (Группы.ГруппаОбучения = &ГруппаОбучения)
	|ГДЕ
	|	ФизЛица.Ссылка В (&Ученики)";
	Запрос.УстановитьПараметр("ГруппаОбучения", ГруппаОбучения);
	Запрос.УстановитьПараметр("Ученики", Ученики);
	Строки = Запрос.Выполнить().Выгрузить();

	СтрокиУчеников = Новый Соответствие;    //ученик → Массив его строк этой группы
	Для Каждого СтрокаУченика Из Строки Цикл
		Если СтрокаУченика.Выбыл Тогда
			Итог.Вставить(СтрокаУченика.Ученик, НСтр("ru = 'выбыл (отметка «Выбыл» в карточке ученика)'"));
		КонецЕсли;
		Если СтрокаУченика.НомерСтроки = 0 Тогда
			Продолжить;
		КонецЕсли;
		Свои = СтрокиУчеников[СтрокаУченика.Ученик];
		Если Свои = Неопределено Тогда
			Свои = Новый Массив;
			СтрокиУчеников.Вставить(СтрокаУченика.Ученик, Свои);
		КонецЕсли;
		Свои.Добавить(СтрокаУченика);
	КонецЦикла;
	Для Каждого СтрокиУченика Из СтрокиУчеников Цикл
		Если Итог[СтрокиУченика.Ключ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Причина = ПричинаПоСтрокамГруппы(СтрокиУченика.Значение, ГруппаОбучения, Дата);
		Если Не ПустаяСтрока(Причина) Тогда
			Итог.Вставить(СтрокиУченика.Ключ, Причина);
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

Функция СтрокаДействуетНаДату(СтрокаГруппы, Дата)

	Возврат (Не ЗначениеЗаполнено(СтрокаГруппы.ДатаНачала) Или СтрокаГруппы.ДатаНачала <= Дата)
		И (Не ЗначениеЗаполнено(СтрокаГруппы.ДатаОкончания) Или Дата <= КонецДня(СтрокаГруппы.ДатаОкончания));

КонецФункции

//В22: перевод в другую группу закрывает старую группу и открывает новую в карточке ученика — как кадровый перевод
//в типовых. Строка старой группы, действующая на дату перевода, получает «Дата окончания» — день перед переводом;
//новая группа — строка с «Дата начала» = дата перевода (если уже действует — не добавляется). Для панели ученика и
//помощника уроков («Перевод из группы») — вызывать в той же транзакции, что и перенос уроков.
Процедура ПеревестиВГруппу(Ученик, ИзГруппы, ВГруппу, ДатаПеревода) Экспорт

	ДеньПеревода = НачалоДня(ДатаПеревода);
	Объект = Ученик.ПолучитьОбъект();
	Для Каждого СтрокаГруппы Из Объект.ГруппыОбучения Цикл
		Если СтрокаГруппы.ГруппаОбучения = ИзГруппы И СтрокаДействуетНаДату(СтрокаГруппы, ДеньПеревода) Тогда
			СтрокаГруппы.ДатаОкончания = ДеньПеревода - 86400;
		КонецЕсли;
	КонецЦикла;
	Действует = Ложь;
	Для Каждого СтрокаГруппы Из Объект.ГруппыОбучения Цикл
		Если СтрокаГруппы.ГруппаОбучения = ВГруппу И СтрокаДействуетНаДату(СтрокаГруппы, ДеньПеревода) Тогда
			Действует = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Не Действует Тогда
		СтрокаГруппы = Объект.ГруппыОбучения.Добавить();
		СтрокаГруппы.ГруппаОбучения = ВГруппу;
		СтрокаГруппы.ДатаНачала = ДеньПеревода;
	КонецЕсли;
	Объект.Записать();

КонецПроцедуры

#КонецОбласти

#Область Остатки

//Блок «по тарифу» карточки ученика: остаток денег по тарифу карточки в организации (В12) и сколько уроков (часов)
//он покрывает по цене тарифа на дату (В8: Документы.УЗ_Урок.ЦенаТарифаНаДату — та же цена, что в уроке и панели;
//было: цена карточки тарифа — у тарифа с историей цен блок молчал). Цены нет или в ней 0 уроков и 0 часов —
//единиц не считаем (было: деление на ноль).
//Структура: Остаток (число), Единиц (число или Неопределено — не считается), ЕдиницаИзмерения («уроков»/«ч»),
//Уроков, Явок (проведено по тарифу).
Функция ОстатокПоТарифу(Ученик, Тариф, Организация, Дата = Неопределено) Экспорт

	Итог = Новый Структура("Остаток, Единиц, ЕдиницаИзмерения, Уроков, Явок", 0, Неопределено, "", 0, 0);
	Если Не ЗначениеЗаполнено(Ученик) Или Не ЗначениеЗаполнено(Тариф) Тогда
		Возврат Итог;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК Остаток,
	|	ЕСТЬNULL(СУММА(Остатки.КоличествоУроковОстаток), 0) КАК Уроков,
	|	ЕСТЬNULL(СУММА(Остатки.КоличествоЯвокОстаток), 0) КАК Явок
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки.Остатки(
	|			,
	|			Клиент = &Ученик
	|				И Тариф = &Тариф
	|				И (&ВсеОрганизации
	|					ИЛИ Организация = &Организация)) КАК Остатки";
	Запрос.УстановитьПараметр("Ученик", Ученик);
	Запрос.УстановитьПараметр("Тариф", Тариф);
	Запрос.УстановитьПараметр("ВсеОрганизации", Организация = Неопределено);
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Итог.Остаток = Выборка.Остаток;
	Итог.Уроков = Выборка.Уроков;
	Итог.Явок = Выборка.Явок;
	Если Итог.Остаток <= 0 Тогда
		Возврат Итог;
	КонецЕсли;
	//цена единицы — одна функция с панелью ученика (Документы.УЗ_Урок.ЦенаЕдиницыТарифа: цена на дату, уроки или часы)
	Цена = Документы.УЗ_Урок.ЦенаЕдиницыТарифа(Тариф, ?(Дата = Неопределено, ТекущаяДатаСеанса(), Дата));
	Если Цена = Неопределено Или Цена.Цена <= 0 Тогда
		Возврат Итог;
	КонецЕсли;
	Итог.Единиц = Окр(Итог.Остаток / Цена.Цена, 2);
	Итог.ЕдиницаИзмерения = ?(Цена.Единица = "ч.", НСтр("ru = 'ч'"), НСтр("ru = 'уроков'"));
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область ДниРождения

//Дни рождения сегодня и в ближайшие Дней дней (журнал уроков). «Осталось дней» — до ближайшего дня рождения
//(0 — сегодня; 29 февраля в невисокосный год — 1 марта), «Исполнится» — сколько лет исполнится в этот день
//(вычисляется от даты рождения; было: хранимый «Возраст», устаревал), «Кто» — ученик или педагог.
//ТаблицаЗначений: ФизЛицо, Дата, ОсталосьДней, Исполнится, Кто — по «Осталось дней».
Функция ДниРождения(Сегодня, Дней = 10) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ФизЛица.Ссылка КАК ФизЛицо,
	|	ФизЛица.ДатаРождения КАК Дата,
	|	ФизЛица.ЭтоПедагог КАК ЭтоПедагог
	|ИЗ
	|	Справочник.УЗ_ФизЛица КАК ФизЛица
	|ГДЕ
	|	НЕ ФизЛица.ПометкаУдаления
	|	И НЕ ФизЛица.ЭтоГруппа
	|	И НЕ ФизЛица.Выбыл
	|	И ФизЛица.ДатаРождения <> ДАТАВРЕМЯ(1, 1, 1)";
	Выборка = Запрос.Выполнить().Выбрать();

	Итог = Новый ТаблицаЗначений;
	Итог.Колонки.Добавить("ФизЛицо", Новый ОписаниеТипов("СправочникСсылка.УЗ_ФизЛица"));
	Итог.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	Итог.Колонки.Добавить("ОсталосьДней", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0)));
	Итог.Колонки.Добавить("Исполнится", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0)));
	Итог.Колонки.Добавить("Кто", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(10)));
	НачалоСегодня = НачалоДня(Сегодня);
	Пока Выборка.Следующий() Цикл
		Осталось = ДнейДоДняРождения(Выборка.Дата, НачалоСегодня);
		Если Осталось > Дней Тогда
			Продолжить;
		КонецЕсли;
		СтрокаДня = Итог.Добавить();
		СтрокаДня.ФизЛицо = Выборка.ФизЛицо;
		СтрокаДня.Дата = Выборка.Дата;
		СтрокаДня.ОсталосьДней = Осталось;
		СтрокаДня.Исполнится = УЗ_ОбщийКлиентСервер.ВозрастНаДату(Выборка.Дата, НачалоСегодня + Осталось * 86400);
		СтрокаДня.Кто = ?(Выборка.ЭтоПедагог, НСтр("ru = 'педагог'"), НСтр("ru = 'ученик'"));
	КонецЦикла;
	Итог.Сортировать("ОсталосьДней, Дата");
	Возврат Итог;

КонецФункции

//Дней от Сегодня до ближайшего дня рождения (29 февраля в невисокосный год — 1 марта).
Функция ДнейДоДняРождения(ДатаРождения, Сегодня) Экспорт

	Для Смещение = 0 По 1 Цикл
		ГодДня = Год(Сегодня) + Смещение;
		Если Месяц(ДатаРождения) = 2 И День(ДатаРождения) = 29 И День(КонецМесяца(Дата(ГодДня, 2, 1))) = 28 Тогда
			ДеньРождения = Дата(ГодДня, 3, 1);
		Иначе
			ДеньРождения = Дата(ГодДня, Месяц(ДатаРождения), День(ДатаРождения));
		КонецЕсли;
		Если ДеньРождения >= НачалоДня(Сегодня) Тогда
