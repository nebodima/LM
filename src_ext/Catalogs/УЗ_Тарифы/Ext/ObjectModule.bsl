
Процедура ПередЗаписью(Отказ)

	Если ОбменДанными.Загрузка Или ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;

	//цена с обеими единицами («8 уроков, 8 ч») — считается за уроки везде: урок, подсказки,
	//представление (Т1: прежде подсказки говорили «за 1 час», а урок считал «за урок»); предупреждаем
	Если КоличествоУроков > 0 И КоличествоЧасов > 0 Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Указаны и уроки, и часы — цена считается за урок, количество часов не используется'"));
	КонецЕсли;

	//предупреждения о неполной цене — только у одной цены в карточке: у цен по датам поля карточки не используются
	//(прежде «Не указана сумма!!!» выводилось при каждой записи тарифа с историей цен)
	Если Не ИспользоватьИсториюЦен Тогда
		Если КоличествоУроков = 0 И КоличествоЧасов = 0 Тогда
			УЗ_ОбщийКлиентСервер.СообщитьПользователю(
				НСтр("ru = 'У тарифа не указано количество уроков или часов — цены нет, урок «К оплате» с ним не "
				+ "проведётся'"));
		КонецЕсли;
		Если Сумма = 0 Тогда
			УЗ_ОбщийКлиентСервер.СообщитьПользователю(
				НСтр("ru = 'У тарифа не указана сумма — цены нет, урок «К оплате» с ним не проведётся'"));
		КонецЕсли;
	КонецЕсли;

	//Р2/В8 (решение владельца 28.09.2026, как в типовых): одна цена в карточке тоже фиксируется на дату —
	//прежняя и новая цены пишутся в историю цен (РегистрыСведений.УЗ_ЦеныТарифов.ЗафиксироватьЦенуКарточки),
	//урок берёт цену на свою дату, и перепроведение старого урока новую цену не возьмёт
	Если Не ЭтоНовый() Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Тарифы.Сумма КАК Сумма,
		|	Тарифы.КоличествоЧасов КАК КоличествоЧасов,
		|	Тарифы.КоличествоУроков КАК КоличествоУроков
		|ИЗ
		|	Справочник.УЗ_Тарифы КАК Тарифы
		|ГДЕ
		|	Тарифы.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий()
			И (Выборка.Сумма <> Сумма Или Выборка.КоличествоЧасов <> КоличествоЧасов
				Или Выборка.КоличествоУроков <> КоличествоУроков) Тогда
			ДополнительныеСвойства.Вставить("ПрежняяЦенаКарточки",
				Новый Структура("Сумма, КоличествоЧасов, КоличествоУроков",
				Выборка.Сумма, Выборка.КоличествоЧасов, Выборка.КоличествоУроков));
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)

	Если ОбменДанными.Загрузка Или ЭтоГруппа Или Не ДополнительныеСвойства.Свойство("ПрежняяЦенаКарточки") Тогда
		Возврат;
	КонецЕсли;

	НоваяЦена = Новый Структура("Сумма, КоличествоЧасов, КоличествоУроков", Сумма, КоличествоЧасов, КоличествоУроков);
	РегистрыСведений.УЗ_ЦеныТарифов.ЗафиксироватьЦенуКарточки(Ссылка, ДополнительныеСвойства.ПрежняяЦенаКарточки,
		НоваяЦена, Не ИспользоватьИсториюЦен);

КонецПроцедуры
