
//Представление тарифа без истории цен: «Наименование (1 000,00 за 1 урок)». Порядок единиц — как считает урок
//(Документы.УЗ_Урок.ЦенаСтрокиУрока): сначала уроки, затем часы — прежде здесь часы были важнее, и тариф с обеими
//единицами показывался «за 1 час», а считался «за урок».
Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)

	Если Данные.Ссылка.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;

	Если Данные.Ссылка.ИспользоватьИсториюЦен Тогда
		Возврат;
	КонецЕсли;

	Если Данные.Ссылка.Сумма > 0 Тогда
		Если Данные.Ссылка.КоличествоУроков > 0 Тогда
			СтандартнаяОбработка = Ложь;
			Представление = Данные.Ссылка.Наименование+ " ("
				+Формат(Данные.Ссылка.Сумма/Данные.Ссылка.КоличествоУроков,"ЧДЦ=2")+ " за 1 урок)";
		ИначеЕсли Данные.Ссылка.КоличествоЧасов > 0 Тогда
			СтандартнаяОбработка = Ложь;
			Представление = Данные.Ссылка.Наименование+ " ("
				+Формат(Данные.Ссылка.Сумма/Данные.Ссылка.КоличествоЧасов,"ЧДЦ=2")+ " за 1 час)";
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры
