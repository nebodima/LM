
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	//для «ч:мм» в ЦеныТарифовПриПолученииДанныхНаСервере
	ЦеныТарифов.УстановитьОбязательноеИспользование("КоличествоЧасов", Истина);

	ЦеныТарифов.Параметры.УстановитьЗначениеПараметра("Тариф",Объект.Ссылка);
	ЧасыТекстом = УЗ_ОбщийКлиентСервер.ЧасыМинуты(Объект.КоличествоЧасов, Истина);

	Если Объект.Наименование = "" Тогда
		Объект.Наименование = "Тариф " +Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	ЦеныТарифов.Параметры.УстановитьЗначениеПараметра("Тариф",Объект.Ссылка);
	ОбновитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЦену(Команда)

	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда

		Если Не ЗначениеЗаполнено(Объект.Наименование) Тогда
			Сообщить("Не заполнено наименование тарифа!");
			Возврат;
		КонецЕсли;

		Оповещение = Новый ОписаниеОповещения("СоздатьЦенуЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, "Тариф еще не записан! Записать?", РежимДиалогаВопрос.ДаНет, 0);
		Возврат;
	КонецЕсли;

	ОткрытьФормуЦены();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьЦенуЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Записать();
	ОткрытьФормуЦены();

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЦены()

	ПараметрыФормы = Новый Структура("Тариф", Объект.Ссылка);
	ОткрытьФорму("РегистрСведений.УЗ_ЦеныТарифов.Форма.ФормаЗаписиТолькоЧтение",ПараметрыФормы,,,
		ВариантОткрытияОкна.ОтдельноеОкно);

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьВидимость();
КонецПроцедуры

Процедура ОбновитьВидимость()

	ЗаполнитьСтрокуЦены();
	//строка с ценой — только когда есть что сказать (пустая жёлтая полоса путала)
	Элементы.ЦенаТекстом.Видимость = Не ПустаяСтрока(ЦенаТекстом);

КонецПроцедуры

//Строка цены — то же, что посчитает урок (Документы.УЗ_Урок.ПредставлениеЦеныТарифа: сначала уроки, затем часы).
//Записанный тариф без правок — цена НА СЕГОДНЯ по истории цен (как урок сегодня): после смены цены карточки при
//уроке, проведённом сегодня, новая цена действует с завтра — прежде подпись говорила «действующая на сегодня: новая».
//Новый или изменённый тариф — цена карточки (ещё не записана).
Процедура ЗаполнитьСтрокуЦены()

	ЦенаТекстом = "";
	Элементы.ЦенаТекстом.Заголовок = НСтр("ru = 'Действующая цена'");

	Если Объект.ИспользоватьИсториюЦен Тогда
		Элементы.ЦеныТарифов.Видимость = Истина;
		Элементы.Вертикальная.Видимость = Ложь;
	Иначе
		Элементы.ЦеныТарифов.Видимость = Ложь;
		Элементы.Вертикальная.Видимость = Истина;
	КонецЕсли;

	Сегодня = ТекущаяДатаСеанса();
	Если Не Объект.ИспользоватьИсториюЦен И (Объект.Ссылка.Пустая() Или Модифицированность) Тогда
		Если ЗначениеЗаполнено(Объект.Сумма) Тогда
			Элементы.ЦенаТекстом.Заголовок = НСтр("ru = 'Цена в карточке'");
			ЦенаТекстом =
				Документы.УЗ_Урок.ПредставлениеЦеныТарифа(Новый Структура("Сумма, КоличествоЧасов, КоличествоУроков",
				Объект.Сумма, Объект.КоличествоЧасов, Объект.КоличествоУроков));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;

	Цена = Документы.УЗ_Урок.ЦенаТарифаНаДату(Объект.Ссылка, Сегодня);
	Если Цена = Неопределено Тогда
		ЦенаТекстом = НСтр("ru = 'Нет действующих цен! Создайте новую цену!'");
	Иначе
		Элементы.ЦенаТекстом.Заголовок = "Цена на " + Формат(Сегодня, "ДЛФ=D");
		ЦенаТекстом = Документы.УЗ_Урок.ПредставлениеЦеныТарифа(Цена);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КоличествоЧасовПриИзменении(Элемент)
	//часы вводятся строкой «ч:мм» (реквизит формы ЧасыТекстом), хранятся числом часов
	Часы = УЗ_ОбщийКлиентСервер.ЧасыИзСтроки(ЧасыТекстом);
	Если Часы = Неопределено Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(НСтр("ru = 'Часы вводятся как ч:мм, например 1:30.'"), "ЧасыТекстом");
		ЧасыТекстом = УЗ_ОбщийКлиентСервер.ЧасыМинуты(Объект.КоличествоЧасов, Истина);
		Возврат;
	КонецЕсли;
	Объект.КоличествоЧасов = Часы;
	ЧасыТекстом = УЗ_ОбщийКлиентСервер.ЧасыМинуты(Часы, Истина);
	Объект.КоличествоУроков = 0;
	ОбновитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура КоличествоУроковПриИзменении(Элемент)
	Объект.КоличествоЧасов = 0;
	ЧасыТекстом = "";
	ОбновитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура СуммаПриИзменении(Элемент)
	ОбновитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьИсториюЦенПриИзменении(Элемент)
	ОбновитьВидимость();
КонецПроцедуры

//Часы — строкой «ч:мм» (в запросе поле ЧасыТекстом — пустая строка)
&НаСервереБезКонтекста
Процедура ЦеныТарифовПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	УЗ_Общий.ЗаполнитьЧасыМинуты(Строки);
КонецПроцедуры
