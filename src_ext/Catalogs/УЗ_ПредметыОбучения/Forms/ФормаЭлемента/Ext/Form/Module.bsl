&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 	
	ОтобразитьФото();	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьФото(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ОбработатьВыборФайла",ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение,,,Истина,УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборФайла(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	
	//новый файл заменит картинку текущего фото при записи (а не создаст ещё одну запись «Фото»)
	Фото = Адрес;
	ФотоВыбрано = Истина;
	Модифицированность = Истина;
	Элементы.ФотоОбъект.Видимость = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ФотоОчистка(Элемент, СтандартнаяОбработка)
	Фото = Неопределено;
	ФотоВыбрано = Ложь;
	Элементы.ФотоОбъект.Видимость = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ФотоПриИзменении(Элемент) 	
	ОтобразитьФото();
КонецПроцедуры
&НаСервере
Процедура ОтобразитьФото()
	Фото = "";
	Если ЗначениеЗаполнено(Объект.Фото) Тогда
		Попытка
			Фото = ПоместитьВоВременноеХранилище(Объект.Фото.Файл.Получить());
		Исключение
			Фото = "";
		КонецПопытки;
	КонецЕсли;
	//без фото — без пустой белой области на пол-карточки
	Элементы.ФотоОбъект.Видимость = ЗначениеЗаполнено(Фото);
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если ФотоВыбрано И ЗначениеЗаполнено(Фото) Тогда
		ТекущийОбъект.Фото = Справочники.УЗ_Фото.ФотоСКартинкой(ТекущийОбъект.Фото, ТекущийОбъект.Наименование,
			ПолучитьИзВременногоХранилища(Фото));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ФотоВыбрано = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПоказатьЦвет();

КонецПроцедуры

//Цвет — поле с выбором (имя цвета словами) и образец рядом, а не кнопка
&НаКлиенте
Процедура ПоказатьЦвет()

	ЦветОтображения = "";
	Элементы.ОбразецЦвета.ЦветФона = Новый Цвет;
	Если ЗначениеЗаполнено(Объект.Цвет) Тогда
		Попытка
			ЗначениеЦвета = WebЦвета[Объект.Цвет];
			ЦветОтображения = ИмяЦветаСловами(ЗначениеЦвета);
			Элементы.ОбразецЦвета.ЦветФона = ЗначениеЦвета;
		Исключение
			ЦветОтображения = Объект.Цвет;
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

//«Темно-красный (DarkRed)» -> «Темно-красный»
&НаКлиенте
Функция ИмяЦветаСловами(ЗначениеЦвета)

	Имя = Строка(ЗначениеЦвета);
	Поз = СтрНайти(Имя, " (");
	Возврат ?(Поз > 0, Лев(Имя, Поз - 1), Имя);

КонецФункции

&НаКлиенте
Процедура ЦветОтображенияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("Обработка.УЗ_ВыборWebЦвета.Форма.ПалитраWebЦветовУправляемая", , ЭтотОбъект, , , ,
		Новый ОписаниеОповещения("ЦветОтображенияВыбран", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ЦветОтображенияВыбран(ВыбранныйЦвет, ДополнительныеПараметры) Экспорт

	Если ВыбранныйЦвет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	//в справочнике хранится ключ WebЦвета: «Темно-красный» -> «Темнокрасный» (имя свойства без учёта регистра)
	Ключ = СтрЗаменить(СтрЗаменить(ИмяЦветаСловами(ВыбранныйЦвет), "-", ""), " ", "");
	Если НРег(Ключ) = НРег("КоролевскийГолубой") Тогда
		Ключ = "КоролевскиГолубой"; //единственное имя, у которого представление не совпадает с ключом
	КонецЕсли;
	Объект.Цвет = Ключ;
	Модифицированность = Истина;
	ПоказатьЦвет();

КонецПроцедуры

&НаКлиенте
Процедура ЦветОтображенияОчистка(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Объект.Цвет = "";
	Модифицированность = Истина;
	ПоказатьЦвет();

КонецПроцедуры
