//Доп. расходы — неденежный или уже оплаченный расход студии по статьям (отчёт «Расходы»). Денежный расход из кассы
//— РКО «Прочий расход», он сам пишет расход по статье. Правило «один расход вводится один раз»:
//  * материалы урока — таблица «Расходы» в самом уроке ИЛИ документ «Доп. расходы» на основании урока, не оба:
//    документ по уроку с непустыми расходами урока не проводится, урок с расходами — при проведённом документе
//    по нему (подписка УЗ_РасходыУрокаОдинИсточник); документ по уроку виден в уроке — «Связанные документы»;
//  * организация документа по уроку — организация урока (В12).
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если НЕ ЗначениеЗаполнено(АвторДокумента) Тогда
		АвторДокумента = УЗ_Среда.ТекущийПользователь();
	КонецЕсли;

	СуммаДокумента = Расходы.Итог("Сумма");

	Если ЗначениеЗаполнено(ДокументОснования) Тогда
		Организация = ДокументОснования.Организация;
	ИначеЕсли НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = РегистрыСведений.УЗ_Настройки.Настройки().Организация;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Если ЭтоНовый() Тогда
		LMНастроки = РегистрыСведений.УЗ_Настройки.Настройки();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, LMНастроки);
	КонецЕсли;

	//на основании урока: основание и организация урока (прежде организация бралась из настроек и затирала урок)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УЗ_Урок") И ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		ДокументОснования = ДанныеЗаполнения;
		Организация = ДанныеЗаполнения.Организация;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	ПроверитьСтроки(Отказ);
	Если ЗначениеЗаполнено(ДокументОснования) Тогда
		РасходыУрока = ДокументОснования.Расходы.Выгрузить();
		Если РасходыУрока.Количество() > 0 Тогда
			СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Расходы урока %1 уже введены в самом уроке (вкладка «Доп. расходы»): %2. Один расход вводится один раз — либо в уроке, либо этим документом.'"),
				ДокументОснования, Формат(РасходыУрока.Итог("Сумма"), "ЧДЦ=2; ЧН=0,00")), "ДокументОснования", Отказ);
		КонецЕсли;
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// регистр УЗ_Расходы Расход
	Движения.УЗ_Расходы.Записывать = Истина;
	Для Каждого ТекСтрокаРасходы Из Расходы Цикл
		Движение = Движения.УЗ_Расходы.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период 			= Дата;
		Движение.СтатьяЗатрат 		= ТекСтрокаРасходы.СтатьяЗатрат;
		Движение.Сумма 				= ТекСтрокаРасходы.Сумма;
		Движение.Организация 		= Организация;
	КонецЦикла;

КонецПроцедуры

//Строка расхода: статья обязательна (по ней отчёт «Расходы»), сумма больше нуля.
Процедура ПроверитьСтроки(Отказ)

	Если Расходы.Количество() = 0 Тогда
		СообщитьОбОшибке(НСтр("ru = 'Добавьте строки расходов: статья и сумма.'"), "Расходы", Отказ);
	КонецЕсли;
	Для Каждого ТекСтрокаРасходы Из Расходы Цикл
		Текст = УЗ_Сервер.ОшибкаСтрокиРасхода(ТекСтрокаРасходы);
		Если ЗначениеЗаполнено(Текст) Тогда
			СообщитьОбОшибке(Текст, СтрШаблон("Расходы[%1].Сумма", ТекСтрокаРасходы.НомерСтроки - 1), Отказ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	ДокументОснования = Неопределено;
	Если Не ЗначениеЗаполнено(ОбъектКопирования.Организация) Тогда
		LMНастроки = РегистрыСведений.УЗ_Настройки.Настройки();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, LMНастроки);
	КонецЕсли;
КонецПроцедуры

Процедура СообщитьОбОшибке(Текст, Поле, Отказ)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	Отказ = Истина;

КонецПроцедуры
