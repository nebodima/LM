
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если НЕ ЗначениеЗаполнено(АвторДокумента) Тогда
		АвторДокумента = УЗ_Среда.ТекущийПользователь();
	КонецЕсли;

	СуммаДокумента = НачисленияПедагогам.Итог("Сумма");

	Если НЕ ОбменДанными.Загрузка И НЕ ЭтоНовый() Тогда
		ПроверитьНачислениеВРасчете(Отказ, РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Или ПометкаУдаления);
	КонецЕсли;

КонецПроцедуры

Процедура ПередУдалением(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ПроверитьНачислениеВРасчете(Отказ, Истина);

КонецПроцедуры

//В9 (как урок, R11 ревью 28.09): начисление, вошедшее в проведённый расчёт зарплаты (или в расчёт с проведённой
//выплатой), нельзя отменить, пометить на удаление, удалить и изменить (педагог, организация, дата, строки и суммы)
//— иначе ведомость выплатила бы то, чего больше нет в долге педагогу (начислено 0, выдано 1 000). Сначала отменяют
//проведение расчёта. Правка комментария документа — можно.
Процедура ПроверитьНачислениеВРасчете(Отказ, Отмена)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Строки.Ссылка КАК Расчет
	|ИЗ
	|	Документ.УЗ_РасчетЗарплаты.ДД КАК Строки
	|ГДЕ
	|	Строки.Документ = &Начисление
	|	И (Строки.Ссылка.Проведен
	|			ИЛИ Строки.Ссылка В (ВЫБРАТЬ Выплаты.ДокументОснования ИЗ Документ.УЗ_РасходДенег КАК Выплаты
	|				ГДЕ Выплаты.Проведен И Выплаты.ВидОперации =
	|		ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыОпераций.ВыплатаЗарплаты)))";
	Запрос.УстановитьПараметр("Начисление", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	Если Отмена Тогда
		Действие = НСтр("ru = 'отменить проведение, пометить на удаление или удалить'");
	ИначеЕсли НачисленияИзменились() Тогда
		Действие = НСтр("ru = 'изменить (педагог, организация, дата, строки и суммы начислений)'");
	Иначе
		Возврат;
	КонецЕсли;
	УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
		СтрШаблон(НСтр(
		"ru = 'Начисление использовано в %1 — его нельзя %2. Сначала отмените проведение расчёта зарплаты.'"),
		Выборка.Расчет, Действие), "НачисленияПедагогам", Отказ);

КонецПроцедуры

//Отличаются ли педагог, организация, дата или строки начислений (сумма и комментарий) от записанных в базе.
Функция НачисленияИзменились()

	Прежний = Ссылка;
	Если Прежний.Педагог <> Педагог Или Прежний.Организация <> Организация Или Прежний.Дата <> Дата
		Или Прежний.НачисленияПедагогам.Количество() <> НачисленияПедагогам.Количество() Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Строка Из НачисленияПедагогам Цикл
		СтрокаПрежняя = Прежний.НачисленияПедагогам[Строка.НомерСтроки - 1];
		Если СтрокаПрежняя.Сумма <> Строка.Сумма Или СтрокаПрежняя.Комментарий <> Строка.Комментарий Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Если ЭтоНовый() Тогда
		LMНастроки = РегистрыСведений.УЗ_Настройки.Настройки();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, LMНастроки);
	КонецЕсли;
	//R24: доплата педагогу за урок — на основании урока (страница «Начисления педагогу» формы урока руководителя):
	//педагог, организация и дата урока; начисление по ставке делает сам урок, здесь — только сверх ставки
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УЗ_Урок") И ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		ДокументОснования = ДанныеЗаполнения;
		Педагог = ДанныеЗаполнения.Педагог;
		Организация = ДанныеЗаполнения.Организация;
		Дата = ДанныеЗаполнения.Дата;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	//без педагога начисление ушло бы в долг «никому» и не попало ни в один расчёт зарплаты
	Если НЕ ЗначениеЗаполнено(Педагог) Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Укажите педагога: начисление делается педагогу.'"),
			"Педагог", Отказ);
		Возврат;
	КонецЕсли;
	Если НЕ Педагог.ЭтоПедагог Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
			СтрШаблон(НСтр(
			"ru = '%1 — не педагог (в карточке не отмечено «Это педагог»): начислять можно только педагогу.'"),
			Педагог),
			"Педагог", Отказ);
		Возврат;
	КонецЕсли;

	// регистр УЗ_РасчетыПоЗарплате Приход
	Движения.УЗ_РасчетыПоЗарплате.Записывать = Истина;
	Для Каждого ТекСтрока Из НачисленияПедагогам Цикл
		Движение = Движения.УЗ_РасчетыПоЗарплате.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период 			= Дата;
		Движение.Педагог 			= Педагог;
		Движение.Сумма 				= ТекСтрока.Сумма;
		Движение.Комментарий 		= ТекСтрока.Комментарий;
		Движение.Организация 		= Организация;
	КонецЦикла;

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Если Не ЗначениеЗаполнено(ОбъектКопирования.Организация) Тогда
		LMНастроки = РегистрыСведений.УЗ_Настройки.Настройки();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, LMНастроки);
	КонецЕсли;
КонецПроцедуры
