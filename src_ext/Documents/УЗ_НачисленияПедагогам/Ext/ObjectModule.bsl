КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	//без педагога начисление ушло бы в долг «никому» и не попало ни в один расчёт зарплаты
	Если НЕ ЗначениеЗаполнено(Педагог) Тогда
		СообщитьОбОшибке(НСтр("ru = 'Укажите педагога: начисление делается педагогу.'"), "Педагог", Отказ);
		Возврат;
	КонецЕсли;
	Если НЕ Педагог.ЭтоПедагог Тогда
		СообщитьОбОшибке(СтрШаблон(НСтр("ru = '%1 — не педагог (в карточке не отмечено «Это педагог»): начислять можно только педагогу.'"), Педагог),
			"Педагог", Отказ);
		Возврат;
	КонецЕсли;

	// регистр УЗ_РасчетыПоЗарплате Приход
	Движения.УЗ_РасчетыПоЗарплате.Записывать = Истина;
	Для Каждого ТекСтрока Из НачисленияПедагогам Цикл
		Движение = Движения.УЗ_РасчетыПоЗарплате.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период 			= Дата;
		Движение.Педагог 			= Педагог;
		Движение.Сумма 				= ТекСтрока.Сумма;
		Движение.Комментарий 		= ТекСтрока.Комментарий;
		Движение.Организация 		= Организация;
	КонецЦикла; 	

КонецПроцедуры

Процедура СообщитьОбОшибке(Текст, Поле, Отказ)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	Отказ = Истина;

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	Если Не ЗначениеЗаполнено(ОбъектКопирования.Организация) Тогда
		LMНастроки = РегистрыСведений.УЗ_Настройки.Настройки();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, LMНастроки);
	КонецЕсли;
КонецПроцедуры

