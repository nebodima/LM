
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УЗ_ДатыЗапрета.ФормаПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	ЗапомнитьПолучателяПоУмолчанию();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	//новый документ — на текущее время, а не на полночь
	Если Объект.Ссылка.Пустая() И Объект.Дата = НачалоДня(Объект.Дата) Тогда
		Сейчас = НачалоМинуты(ТекущаяДатаСеанса());
		Объект.Дата = НачалоДня(?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, Сейчас)) + (Сейчас - НачалоДня(Сейчас));
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации";
	Если Запрос.Выполнить().Выгрузить().Количество() = 0 Тогда
		Элементы.Организация.Видимость = Ложь;
	КонецЕсли;

	//вид «Внутренняя касса» для расхода не используется (решение В7): выплата педагогу — «Выплата
	//зарплаты», аренда и прочее — «Прочий расход»
	Элементы.ВидОперации.РежимВыбораИзСписка = Истина;
	Элементы.ВидОперации.СписокВыбора.Очистить();
	Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.УЗ_ВидыОпераций.КассаУченики);
	//выплата зарплаты и прочий расход — только руководителю: у менеджера роль разрешает записывать
	//лишь возврат ученику (ограничение по виду операции в роли УЗ_ОсновнаяРоль)
	Если УЗ_Общий.ДоступнаЗарплата() Тогда
		Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.УЗ_ВидыОпераций.ВыплатаЗарплаты);
		Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.УЗ_ВидыОпераций.ПрочийРасход);
	ИначеЕсли Объект.ВидОперации <> Перечисления.УЗ_ВидыОпераций.КассаУченики Тогда
		Если Объект.Ссылка.Пустая() Тогда
			Объект.ВидОперации = Перечисления.УЗ_ВидыОпераций.КассаУченики;
		Иначе
			//выплату и прочий расход менеджер видит, но не меняет; вид — в списке, иначе поле пустое
			Элементы.ВидОперации.СписокВыбора.Добавить(Объект.ВидОперации);
			ТолькоПросмотр = Истина;
		КонецЕсли;
	КонецЕсли;
	Если Объект.Ссылка.Пустая() Тогда
		ЗапомнитьПолучателяПоУмолчанию();
		Если НЕ ЗначениеЗаполнено(Объект.Получатель) Тогда
			Объект.Получатель = ПолучательПоУмолчанию;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

//В38: возврат — тому, кто платил за ученика (плательщик последней оплаты по предмету, иначе основной плательщик,
//иначе сам ученик); смена ученика или предмета подставляет получателя заново
&НаКлиенте
Процедура КлиентПриИзменении(Элемент)
	ПодставитьПолучателя();
КонецПроцедуры

&НаКлиенте
Процедура ПредметОбученияПриИзменении(Элемент)
	ПодставитьПолучателя();
КонецПроцедуры

//Находка 7 аудита Codex 2.1 (30.09.2026): получатель — кто платил на дату возврата в организации возврата; смена даты
//или организации пересчитывает получателя, если он подставлен программой (выбранного вручную не трогает).
&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	ПодставитьПолучателя(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ПодставитьПолучателя(Ложь);
КонецПроцедуры

//Всегда — получатель по умолчанию (смена ученика, предмета); не всегда — только если получатель пуст или подставлен
//программой (совпадает с прежним получателем по умолчанию).
&НаСервере
Процедура ПодставитьПолучателя(Всегда = Истина)

	Если Объект.ВидОперации <> Перечисления.УЗ_ВидыОпераций.КассаУченики Тогда
		Возврат;
	КонецЕсли;
	Подставлен = НЕ ЗначениеЗаполнено(Объект.Получатель) Или Объект.Получатель = ПолучательПоУмолчанию;
	ЗапомнитьПолучателяПоУмолчанию();
	Если Всегда Или Подставлен Тогда
		Объект.Получатель = ПолучательПоУмолчанию;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗапомнитьПолучателяПоУмолчанию()

	Если Объект.ВидОперации <> Перечисления.УЗ_ВидыОпераций.КассаУченики Или НЕ ЗначениеЗаполнено(Объект.ФизЛицо) Тогда
		ПолучательПоУмолчанию = Справочники.УЗ_ФизЛица.ПустаяСсылка();
		Возврат;
	КонецЕсли;
	ПолучательПоУмолчанию = УЗ_Сервер.ПолучательВозврата(Объект.ФизЛицо, Объект.Организация, Объект.ПредметОбучения,
		?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса()));

КонецПроцедуры
