
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УЗ_ДатыЗапрета.ФормаПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	//новый документ — на текущее время, а не на полночь
	Если Объект.Ссылка.Пустая() И Объект.Дата = НачалоДня(Объект.Дата) Тогда
		Сейчас = НачалоМинуты(ТекущаяДатаСеанса());
		Объект.Дата = НачалоДня(?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, Сейчас)) + (Сейчас - НачалоДня(Сейчас));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации";	
	Если Запрос.Выполнить().Выгрузить().Количество() = 0 Тогда
		Элементы.Организация.Видимость = Ложь;
	КонецЕсли;

	//вид «Внутренняя касса» для расхода не используется (решение В7): выплата педагогу — «Выплата
	//зарплаты», аренда и прочее — «Прочий расход»
	Элементы.ВидОперации.РежимВыбораИзСписка = Истина;
	Элементы.ВидОперации.СписокВыбора.Очистить();
	Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.УЗ_ВидыОпераций.КассаУченики);
	//выплата зарплаты и прочий расход — только руководителю: у менеджера роль разрешает записывать
	//лишь возврат ученику (ограничение по виду операции в роли УЗ_ОсновнаяРоль)
	Если УЗ_Общий.ДоступнаЗарплата() Тогда
		Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.УЗ_ВидыОпераций.ВыплатаЗарплаты);
		Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.УЗ_ВидыОпераций.ПрочийРасход);
	ИначеЕсли Объект.ВидОперации <> Перечисления.УЗ_ВидыОпераций.КассаУченики Тогда
		Если Объект.Ссылка.Пустая() Тогда
			Объект.ВидОперации = Перечисления.УЗ_ВидыОпераций.КассаУченики;
		Иначе
			//выплату и прочий расход менеджер видит, но не меняет; вид — в списке, иначе поле пустое
			Элементы.ВидОперации.СписокВыбора.Добавить(Объект.ВидОперации);
			ТолькоПросмотр = Истина;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

