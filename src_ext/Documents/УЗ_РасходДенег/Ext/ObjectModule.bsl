
//Виды расхода (решения владельца 28.09.2026):
//  «Касса ученики»    — возврат денег ученику: только деньги (В5 — часы урока второй раз не списываются);
//  «Выплата зарплаты» — педагогу, только на основании проведённого расчёта, закрывает долг по зарплате (В7, В9);
//  «Прочий расход»    — аренда, хозрасходы: только касса, долг педагогу не меняет (В7);
//  «Внутренняя касса» — прежний общий вид, для расхода больше не используется (обновление данных, шаг 2,
//                       разнесло старые РКО по двум видам выше).
//В регистре УЗ_Касса выплата и прочий расход — раздел «Внутренняя касса», как и раньше.
Процедура ОбработкаПроведения(Отказ, Режим)

	//дата запрета проверяется подпиской УЗ_ДатаЗапретаПередЗаписью (модуль УЗ_ДатыЗапрета)

	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.ВнутренняяКасса Тогда
		СообщитьОбОшибке(НСтр("ru = 'Вид «Внутренняя касса» для расхода больше не используется: выберите «Выплата зарплаты» (педагогу) или «Прочий расход» (аренда, хозяйственные расходы).'"),
			"Объект.ВидОперации", Отказ);
		Возврат;
	КонецЕсли;
	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.ВыплатаЗарплаты Тогда
		ПроверитьВыплатуЗарплаты(Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ПроверитьЗаполнениеРасхода(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	//В5: возврат ученику — не больше его аванса по предмету в организации ордера на дату ордера (как перемещение
	//между предметами); прежде возврат больше аванса молча делал долг
	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.КассаУченики Тогда
		ПредметОстатка = ?(ЗначениеЗаполнено(ПредметОбучения), ПредметОбучения, Неопределено);
		УЗ_Сервер.ЗаблокироватьДеньгиУченика(ФизЛицо, Организация, ПредметОстатка);
		Аванс = УЗ_Сервер.ОстатокДенегУченика(ФизЛицо, Организация, ПредметОстатка,
			Новый Граница(МоментВремени(), ВидГраницы.Исключая));
		Если СуммаДокумента > Аванс Тогда
			СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Вернуть %1 нельзя: у ученика %2 в организации «%3» по предмету «%4» на %5 оплачено вперёд %6. Возврат — только из аванса; долг возвратом не оформляют.'"),
				Формат(СуммаДокумента, "ЧДЦ=2; ЧН=0,00"), ФизЛицо, Организация,
				?(ЗначениеЗаполнено(ПредметОбучения), ПредметОбучения, НСтр("ru = 'все предметы'")),
				Формат(Дата, "ДЛФ=DT"), Формат(Макс(Аванс, 0), "ЧДЦ=2; ЧН=0,00")), "Объект.СуммаДокумента", Отказ);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// регистр Касса Расход
	Движения.УЗ_Касса.Записывать = Истина;
	Движение = Движения.УЗ_Касса.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
	Движение.Период 	 = Дата;
	Движение.Клиент 	 = ФизЛицо;
	Движение.Сумма 		 = СуммаДокумента;
	Движение.Касса		 = Касса;
	Движение.ВидОперации = РазделКассы();
	Движение.ПредметОбучения = ПредметОбучения;
	Движение.СтатьяЗатрат = СтатьяЗатрат;
	Движение.Организация = Организация;

	//В14 (C04), В12: касса организации не уходит в минус — ни на дату ордера, ни в текущем остатке (с блокировкой)
	Справочники.УЗ_Кассы.ПроверитьОстаткиКасс(ЭтотОбъект, Движения.УЗ_Касса, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.ПрочийРасход Тогда
		//прочий расход (аренда, материалы, оплаченные наличными) — и в отчёт «Расходы» по статье: одна правда
		//«на что ушли деньги» (неденежный или уже оплаченный расход — документ «Доп. расходы» или расходы урока)
		Движения.УЗ_Расходы.Записывать = Истина;
		Движение = Движения.УЗ_Расходы.Добавить();
		Движение.ВидДвижения  = ВидДвиженияНакопления.Расход;
		Движение.Период       = Дата;
		Движение.СтатьяЗатрат = СтатьяЗатрат;
		Движение.Организация  = Организация;
		Движение.Сумма        = СуммаДокумента;
	КонецЕсли;

	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.КассаУченики Тогда
		// регистр СписанияСуммЗаУроки: возвращаются только деньги (В5)
		Движения.УЗ_СписанияСуммЗаУроки.Записывать = Истина;
		Движение = Движения.УЗ_СписанияСуммЗаУроки.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период 	 = Дата;
		Движение.Клиент 	 = ФизЛицо;
		Движение.Сумма  	 = СуммаДокумента;
		Движение.ПредметОбучения    = ПредметОбучения;
		Движение.Организация = Организация;

		//тариф — только у урока-основания: основанием бывает и ученик (возврат из карточки),
		//абонемент, расчёт зарплаты — табличной части «Ученики» у них нет
		Если ТипЗнч(ДокументОснования) = Тип("ДокументСсылка.УЗ_Урок") И ЗначениеЗаполнено(ДокументОснования) Тогда
			СтрокаУченика = ДокументОснования.Ученики.Найти(ФизЛицо,"Ученик");
			Если ЗначениеЗаполнено(СтрокаУченика) Тогда
				Движение.Тариф = СтрокаУченика.Тариф;
			КонецЕсли;
		КонецЕсли;
		//возврат по абонементу уменьшает оплату абонемента (карточка абонемента не показывает «оплачен полностью»)
		Если ТипЗнч(ДокументОснования) = Тип("СправочникСсылка.УЗ_Абонемент") И ЗначениеЗаполнено(ДокументОснования) Тогда
			Движение.Абонемент = ДокументОснования;
		КонецЕсли;

	ИначеЕсли ВидОперации = Перечисления.УЗ_ВидыОпераций.ВыплатаЗарплаты Тогда
		// регистр УЗ_РасчетыПоЗарплате Расход: выплата закрывает долг педагогу
		Движения.УЗ_РасчетыПоЗарплате.Записывать = Истина;
		Движение = Движения.УЗ_РасчетыПоЗарплате.Добавить();
		Движение.ВидДвижения 		= ВидДвиженияНакопления.Расход;
		Движение.Период 	 		= Дата;
		Движение.Педагог 	 	= ФизЛицо;
		Движение.Сумма				= СуммаДокумента;
		Движение.Организация		= Организация;
	КонецЕсли;

КонецПроцедуры

//Обязательное в любом расходе (касса, сумма > 0, касса своей организации — В12) и по виду: возврат — ученику,
//прочий расход — со статьёй (попадает в отчёт «Расходы» по статье).
Процедура ПроверитьЗаполнениеРасхода(Отказ)

	Если НЕ ЗначениеЗаполнено(Касса) Тогда
		СообщитьОбОшибке(НСтр("ru = 'Укажите кассу, из которой выдаются деньги.'"), "Объект.Касса", Отказ);
	КонецЕсли;
	Если СуммаДокумента <= 0 Тогда
		СообщитьОбОшибке(НСтр("ru = 'Укажите сумму расхода больше нуля.'"), "Объект.СуммаДокумента", Отказ);
	КонецЕсли;
	ТекстКассы = Справочники.УЗ_Кассы.ТекстКассаДругойОрганизации(Касса, Организация);
	Если ЗначениеЗаполнено(ТекстКассы) Тогда
		СообщитьОбОшибке(ТекстКассы, "Объект.Касса", Отказ);
	КонецЕсли;
	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.КассаУченики И НЕ ЗначениеЗаполнено(ФизЛицо) Тогда
		СообщитьОбОшибке(НСтр("ru = 'Возврат денег — укажите ученика (физ. лицо).'"), "Объект.ФизЛицо", Отказ);
	КонецЕсли;
	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.ПрочийРасход И НЕ ЗначениеЗаполнено(СтатьяЗатрат) Тогда
		СообщитьОбОшибке(НСтр("ru = 'Прочий расход — укажите статью затрат: по ней расход виден в отчёте «Расходы».'"),
			"Объект.СтатьяЗатрат", Отказ);
	КонецЕсли;

КонецПроцедуры

//Раздел денег в кассе (измерение ВидОперации регистра УЗ_Касса): деньги учеников или внутренняя касса.
Функция РазделКассы()

	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.ВыплатаЗарплаты
		Или ВидОперации = Перечисления.УЗ_ВидыОпераций.ПрочийРасход Тогда
		Возврат Перечисления.УЗ_ВидыОпераций.ВнутренняяКасса;
	КонецЕсли;
	Возврат ВидОперации;

КонецФункции

//Выплата зарплаты (решения В7, В9 от 28.09.2026) — педагогу (физ. лицо с отметкой «Это педагог») и только
//на основании проведённого расчёта зарплаты того же педагога, не больше невыплаченного остатка расчёта.
//Без расчёта долг педагогу гасился бы мимо ведомости.
Процедура ПроверитьВыплатуЗарплаты(Отказ)

	Если НЕ ЗначениеЗаполнено(ФизЛицо) Тогда
		СообщитьОбОшибке(НСтр("ru = 'Выплата зарплаты — укажите педагога (физ. лицо).'"), "Объект.ФизЛицо", Отказ);
		Возврат;
	КонецЕсли;
	Если НЕ ФизЛицо.ЭтоПедагог Тогда
		СообщитьОбОшибке(СтрШаблон(НСтр("ru = '%1 — не педагог (в карточке не отмечено «Это педагог»): зарплату выплачивают только педагогу. Возврат денег ученику — вид «Касса ученики», прочие расходы — «Прочий расход».'"), ФизЛицо),
			"Объект.ФизЛицо", Отказ);
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ДокументОснования) <> Тип("ДокументСсылка.УЗ_РасчетЗарплаты") Или НЕ ЗначениеЗаполнено(ДокументОснования) Тогда
		СообщитьОбОшибке(НСтр("ru = 'Выплата зарплаты проводится только на основании проведённого расчёта зарплаты: откройте расчёт педагога и нажмите «Выписать расходный кассовый ордер» (или «Создать на основании» → «Расходный кассовый ордер»).'"),
			"Объект.ДокументОснования", Отказ);
		Возврат;
	КонецЕсли;

	Расчет = ДанныеРасчета(ДокументОснования);
	Если НЕ Расчет.Проведен Тогда
		СообщитьОбОшибке(СтрШаблон(НСтр("ru = '%1 не проведён — выплата по нему невозможна.'"), ДокументОснования),
			"Объект.ДокументОснования", Отказ);
		Возврат;
	КонецЕсли;
	Если Расчет.Педагог <> ФизЛицо Тогда
		СообщитьОбОшибке(СтрШаблон(НСтр("ru = '%1 — расчёт педагога %2, а выплата на %3.'"), ДокументОснования, Расчет.Педагог, ФизЛицо),
			"Объект.ФизЛицо", Отказ);
		Возврат;
	КонецЕсли;
	//N02: выплата гасит долг организации расчёта — РКО другой организации засчитывался в оплату ведомости А,
	//а долг А оставался и в Б появлялась переплата
	Если Расчет.Организация <> Организация Тогда
		СообщитьОбОшибке(СтрШаблон(НСтр("ru = '%1 — расчёт организации «%2», а выплата от «%3»: зарплату по ведомости выплачивает та же организация.'"),
			ДокументОснования, Расчет.Организация, Организация), "Объект.Организация", Отказ);
		Возврат;
	КонецЕсли;
	Выплачено = ВыплаченоПоРасчету(ДокументОснования);
	Если Выплачено + СуммаДокумента > Расчет.СуммаДокумента Тогда
		СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'По %1 к выплате %2, уже выплачено %3 — остаток %4, а в ордере %5.'"),
			ДокументОснования, Формат(Расчет.СуммаДокумента, "ЧДЦ=2; ЧН=0"), Формат(Выплачено, "ЧДЦ=2; ЧН=0"),
			Формат(Расчет.СуммаДокумента - Выплачено, "ЧДЦ=2; ЧН=0"), Формат(СуммаДокумента, "ЧДЦ=2; ЧН=0")),
			"Объект.СуммаДокумента", Отказ);
	КонецЕсли;

КонецПроцедуры

Функция ДанныеРасчета(Расчет)

	Возврат Новый Структура("Проведен, Педагог, Организация, Касса, СуммаДокумента",
		Расчет.Проведен, Расчет.Педагог, Расчет.Организация, Расчет.Касса, Расчет.СуммаДокумента);

КонецФункции

//Сколько уже выплачено по расчёту другими проведёнными РКО. В проведении — под блокировкой выплат
//педагога: два РКО по одному расчёту, проводимые одновременно, не переплатят остаток оба.
Функция ВыплаченоПоРасчету(Расчет)

	Если ТранзакцияАктивна() Тогда
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.УЗ_РасчетыПоЗарплате");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Педагог", ФизЛицо);
		Блокировка.Заблокировать();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Выплаты.СуммаДокумента), 0) КАК Сумма
	|ИЗ
	|	Документ.УЗ_РасходДенег КАК Выплаты
	|ГДЕ
	|	Выплаты.Проведен
	|	И Выплаты.ДокументОснования = &Расчет
	|	И Выплаты.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыОпераций.ВыплатаЗарплаты)
	|	И Выплаты.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("Расчет", Расчет);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Сумма;

КонецФункции

Процедура СообщитьОбОшибке(Текст, Поле, Отказ)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	Отказ = Истина;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.АвторДокумента) Тогда
		ЭтотОбъект.АвторДокумента = УЗ_Среда.ТекущийПользователь();
	КонецЕсли;

	//В12: касса и деньги ученика — по организации; документ, созданный программно без организации, — в организации
	//по умолчанию (как перемещение, C03), иначе его деньги легли бы в «пустую» организацию
	Если НЕ ЗначениеЗаполнено(Организация) И НЕ ОбменДанными.Загрузка Тогда
		Организация = РегистрыСведений.УЗ_Настройки.Настройки().Организация;
	КонецЕсли;

	//прежние движения кассы — для контроля остатка при перепроведении (В14)
	Справочники.УЗ_Кассы.ПередЗаписьюДокументаКассы(ЭтотОбъект, РежимЗаписи, Отказ);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	АвторДокумента = Неопределено;
	Комментарий    = Неопределено;
	ДокументОснования = Неопределено;

	Если Не ЗначениеЗаполнено(ОбъектКопирования.Организация) Тогда
		LMНастроки = РегистрыСведений.УЗ_Настройки.Настройки();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, LMНастроки);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если ЭтоНовый() Тогда
		LMНастроки = РегистрыСведений.УЗ_Настройки.Настройки();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, LMНастроки);
	КонецЕсли;

	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.УЗ_Абонемент") Тогда

		//возврат по абонементу: ученик, предмет, абонемент — расход денег ученика пишется по абонементу
		ВидОперации       = Перечисления.УЗ_ВидыОпераций.КассаУченики;
		ДокументОснования = ДанныеЗаполнения;
		ФизЛицо           = ДанныеЗаполнения.ФизЛицо;
		ПредметОбучения   = ДанныеЗаполнения.ПредметОбучения;
		Если ЗначениеЗаполнено(ДанныеЗаполнения.Организация) Тогда
			Организация = ДанныеЗаполнения.Организация;   //возврат — от организации, которой оплачен абонемент
		КонецЕсли;
		СуммаДокумента    = Макс(0, УЗ_Сервер.ОстатокДенегПоАбонементу(ДанныеЗаполнения));   //неизрасходованная оплата

	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.УЗ_ФизЛица") Тогда

		ВидОперации	= Перечисления.УЗ_ВидыОпераций.КассаУченики;
		ФизЛицо	= ДанныеЗаполнения.Ссылка;
		ДокументОснования = ДанныеЗаполнения.Ссылка;

	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УЗ_РасчетЗарплаты") Тогда

		//выплата по расчёту зарплаты (В9): педагог, касса и невыплаченный остаток расчёта
		Расчет = ДанныеРасчета(ДанныеЗаполнения);
		ВидОперации       = Перечисления.УЗ_ВидыОпераций.ВыплатаЗарплаты;
		ДокументОснования = ДанныеЗаполнения;
		ФизЛицо           = Расчет.Педагог;
		Организация       = Расчет.Организация;   //N02: выплата — только от организации расчёта
		Если ЗначениеЗаполнено(Расчет.Касса) Тогда
			Касса = Расчет.Касса;
		КонецЕсли;
		СуммаДокумента    = Макс(0, Расчет.СуммаДокумента - ВыплаченоПоРасчету(ДанныеЗаполнения));

	КонецЕсли;

КонецПроцедуры
