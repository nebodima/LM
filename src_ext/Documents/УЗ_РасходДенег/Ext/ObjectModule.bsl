#Область ОбработчикиСобытий

//Виды расхода (решения владельца 28.09.2026):
//  «Касса ученики»    — возврат денег ученику: только деньги (В5 — часы урока второй раз не списываются);
//  «Выплата зарплаты» — педагогу, только на основании проведённого расчёта, закрывает долг по зарплате (В7, В9);
//  «Прочий расход»    — аренда, хозрасходы: только касса, долг педагогу не меняет (В7);
//  «Внутренняя касса» — вид перемещений и прихода, для расхода не применяется (отказ при проведении).
//В регистре УЗ_Касса выплата и прочий расход — раздел «Внутренняя касса».
Процедура ОбработкаПроведения(Отказ, Режим)

	//дата запрета проверяется подпиской УЗ_ДатаЗапретаПередЗаписью (модуль УЗ_ДатыЗапрета)

	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.ВнутренняяКасса Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
			НСтр("ru = 'Вид «Внутренняя касса» для расхода не применяется: выберите «Выплата зарплаты» "
			+ "(педагогу) или «Прочий расход» (аренда, хозяйственные расходы).'"),
			"Объект.ВидОперации", Отказ);
		Возврат;
	КонецЕсли;
	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.ВыплатаЗарплаты Тогда
		ПроверитьВыплатуЗарплаты(Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ПроверитьЗаполнениеРасхода(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	//В5: возврат ученику — не больше его аванса в организации ордера на дату ордера (как перемещение между
	//предметами); прежде возврат больше аванса молча делал долг. Находка 1 третьего аудита Codex (28.09.2026):
	//проверяется тот же разрез, в который пишется расход, — предмет ордера; возврат без предмета — из свободного
	//аванса без предмета (не зачтённого в долги предметов). Прежде без предмета проверялась сумма всех предметов, а
	//расход ложился в пустой предмет: аванс математики 1 000 возвращался «без предмета», и потом ещё раз «по
	//математике» — ученик внёс 1 000, получил 2 000.
	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.КассаУченики Тогда
		УЗ_Сервер.ЗаблокироватьДеньгиУченика(ФизЛицо, Организация);
		Граница = Новый Граница(МоментВремени(), ВидГраницы.Исключая);
		Если ЗначениеЗаполнено(ПредметОбучения) Тогда
			Аванс = УЗ_Сервер.ОстатокДенегУченика(ФизЛицо, Организация, ПредметОбучения, Граница);
		Иначе
			Аванс = УЗ_Сервер.СвободныйАвансБезПредмета(ФизЛицо, Организация, Граница);
		КонецЕсли;
		Если СуммаДокумента > Аванс Тогда
			УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
				СтрШаблон(НСтр(
				"ru = 'Вернуть %1 нельзя: у ученика %2 в организации «%3» %4 на %5 оплачено вперёд %6. "
				+ "Возврат — только из аванса того предмета, по которому он выдаётся (аванс по предмету — укажите "
				+ "предмет); долг возвратом не оформляют.'"),
				Формат(СуммаДокумента, "ЧДЦ=2; ЧН=0,00"), ФизЛицо, Организация,
				?(ЗначениеЗаполнено(ПредметОбучения), "по предмету «" + ПредметОбучения + "»",
					НСтр("ru = 'без предмета (за вычетом долгов по предметам)'")),
				Формат(Дата, "ДЛФ=DT"), Формат(Макс(Аванс, 0), "ЧДЦ=2; ЧН=0,00")), "Объект.СуммаДокумента", Отказ);
			Возврат;
		КонецЕсли;
		Если ТипЗнч(ДокументОснования) = Тип("СправочникСсылка.УЗ_Абонемент")
			И ЗначениеЗаполнено(ДокументОснования) Тогда
			ПроверитьВозвратПоАбонементу(Отказ);
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	// регистр Касса Расход
	Движения.УЗ_Касса.Записывать = Истина;
	Движение = Движения.УЗ_Касса.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
	Движение.Период 	 = Дата;
	Движение.Клиент 	 = ФизЛицо;
	Движение.Сумма 		 = СуммаДокумента;
	Движение.Касса		 = Касса;
	Движение.ВидОперации = РазделКассы();
	Движение.ПредметОбучения = ПредметОбучения;
	Движение.СтатьяЗатрат = СтатьяЗатрат;
	Движение.Организация = Организация;
	//В38: возврат ученику уменьшает внесённое получателем (отчёт «Оплаты по плательщикам»)
	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.КассаУченики Тогда
		Движение.Плательщик = Получатель;
	КонецЕсли;

	//В14 (C04), В12: касса организации не уходит в минус — ни на дату ордера, ни в текущем остатке (с блокировкой)
	Справочники.УЗ_Кассы.ПроверитьОстаткиКасс(ЭтотОбъект, Движения.УЗ_Касса, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.ПрочийРасход Тогда
		//прочий расход (аренда, материалы, оплаченные наличными) — и в отчёт «Расходы» по статье: одна правда
		//«на что ушли деньги» (неденежный или уже оплаченный расход — документ «Доп. расходы» или расходы урока)
		Движения.УЗ_Расходы.Записывать = Истина;
		Движение = Движения.УЗ_Расходы.Добавить();
		Движение.ВидДвижения  = ВидДвиженияНакопления.Расход;
		Движение.Период       = Дата;
		Движение.СтатьяЗатрат = СтатьяЗатрат;
		Движение.Организация  = Организация;
		Движение.Сумма        = СуммаДокумента;
	КонецЕсли;

	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.КассаУченики Тогда
		// регистр СписанияСуммЗаУроки: возвращаются только деньги (В5)
		Движения.УЗ_СписанияСуммЗаУроки.Записывать = Истина;
		Движение = Движения.УЗ_СписанияСуммЗаУроки.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период 	 = Дата;
		Движение.Клиент 	 = ФизЛицо;
		Движение.Сумма  	 = СуммаДокумента;
		Движение.ПредметОбучения    = ПредметОбучения;
		Движение.Организация = Организация;

		//тариф — только у урока-основания: основанием бывает и ученик (возврат из карточки),
		//абонемент, расчёт зарплаты — табличной части «Ученики» у них нет
		Если ТипЗнч(ДокументОснования) = Тип("ДокументСсылка.УЗ_Урок") И ЗначениеЗаполнено(ДокументОснования) Тогда
			СтрокаУченика = ДокументОснования.Ученики.Найти(ФизЛицо,"Ученик");
			Если ЗначениеЗаполнено(СтрокаУченика) Тогда
				Движение.Тариф = СтрокаУченика.Тариф;
			КонецЕсли;
		КонецЕсли;
		//возврат по абонементу уменьшает оплату абонемента (карточка абонемента не показывает «оплачен полностью»)
		Если ТипЗнч(ДокументОснования) = Тип("СправочникСсылка.УЗ_Абонемент")
			И ЗначениеЗаполнено(ДокументОснования) Тогда
			Движение.Абонемент = ДокументОснования;
		КонецЕсли;

	ИначеЕсли ВидОперации = Перечисления.УЗ_ВидыОпераций.ВыплатаЗарплаты Тогда
		// регистр УЗ_РасчетыПоЗарплате Расход: выплата закрывает долг педагогу
		Движения.УЗ_РасчетыПоЗарплате.Записывать = Истина;
		Движение = Движения.УЗ_РасчетыПоЗарплате.Добавить();
		Движение.ВидДвижения 		= ВидДвиженияНакопления.Расход;
		Движение.Период 	 		= Дата;
		Движение.Педагог 	 	= ФизЛицо;
		Движение.Сумма				= СуммаДокумента;
		Движение.Организация		= Организация;
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	УЗ_Общий.ЗаполнитьАвтораИОрганизацию(ЭтотОбъект);
	//В38: возврат ученику без получателя (создан программно) — тому, кто за него платил
	Если НЕ ОбменДанными.Загрузка И ВидОперации = Перечисления.УЗ_ВидыОпераций.КассаУченики
		И НЕ ЗначениеЗаполнено(Получатель) Тогда
		Получатель = УЗ_Сервер.ПолучательВозврата(ФизЛицо, Организация, ПредметОбучения, Дата);
	КонецЕсли;

	//прежние движения кассы — для контроля остатка при перепроведении (В14)
	Справочники.УЗ_Кассы.ПередЗаписьюДокументаКассы(ЭтотОбъект, РежимЗаписи, Отказ);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	АвторДокумента = Неопределено;
	Комментарий    = Неопределено;
	ДокументОснования = Неопределено;

	Если Не ЗначениеЗаполнено(ОбъектКопирования.Организация) Тогда
		LMНастроки = РегистрыСведений.УЗ_Настройки.Настройки();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, LMНастроки);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если ЭтоНовый() Тогда
		LMНастроки = РегистрыСведений.УЗ_Настройки.Настройки();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, LMНастроки);
	КонецЕсли;

	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.УЗ_Абонемент") Тогда

		//возврат по абонементу: ученик, предмет, абонемент — расход денег ученика пишется по абонементу
		ВидОперации       = Перечисления.УЗ_ВидыОпераций.КассаУченики;
		ДокументОснования = ДанныеЗаполнения;
		ФизЛицо           = ДанныеЗаполнения.ФизЛицо;
		ПредметОбучения   = ДанныеЗаполнения.ПредметОбучения;
		Если ЗначениеЗаполнено(ДанныеЗаполнения.Организация) Тогда
			Организация = ДанныеЗаполнения.Организация;   //возврат — от организации, которой оплачен абонемент
		КонецЕсли;
		СуммаДокумента    = Макс(0, УЗ_Сервер.ОстатокДенегПоАбонементу(ДанныеЗаполнения));   //неизрасходованная оплата
		Получатель = УЗ_Сервер.ПолучательВозврата(ФизЛицо, Организация, ПредметОбучения, ДатаВозврата());

	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.УЗ_ФизЛица") Тогда

		ВидОперации	= Перечисления.УЗ_ВидыОпераций.КассаУченики;
		ФизЛицо	= ДанныеЗаполнения.Ссылка;
		ДокументОснования = ДанныеЗаполнения.Ссылка;
		Получатель = УЗ_Сервер.ПолучательВозврата(ФизЛицо, Организация, , ДатаВозврата());

	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.УЗ_РасчетЗарплаты") Тогда

		//выплата по расчёту зарплаты (В9): педагог, касса и невыплаченный остаток расчёта
		Расчет = ДанныеРасчета(ДанныеЗаполнения);
		ВидОперации       = Перечисления.УЗ_ВидыОпераций.ВыплатаЗарплаты;
		ДокументОснования = ДанныеЗаполнения;
		ФизЛицо           = Расчет.Педагог;
		Организация       = Расчет.Организация;   //N02: выплата — только от организации расчёта
		Если ЗначениеЗаполнено(Расчет.Касса) Тогда
			Касса = Расчет.Касса;
		КонецЕсли;
		СуммаДокумента    = Макс(0, Расчет.СуммаДокумента - ВыплаченоПоРасчету(ДанныеЗаполнения));

	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//Дата, на которую ищется получатель возврата (В38): дата документа, у нового без даты — сейчас. Находка 7 аудита
//Codex 2.1 (30.09.2026): заполнение искало без даты — получателем становился плательщик оплаты будущей датой.
Функция ДатаВозврата()

	Возврат ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса());

КонецФункции

//Обязательное в любом расходе (касса, сумма > 0, касса своей организации — В12) и по виду: возврат — ученику,
//прочий расход — со статьёй (попадает в отчёт «Расходы» по статье).
Процедура ПроверитьЗаполнениеРасхода(Отказ)

	Если НЕ ЗначениеЗаполнено(Касса) Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Укажите кассу, из которой выдаются деньги.'"),
			"Объект.Касса", Отказ);
	КонецЕсли;
	Если СуммаДокумента <= 0 Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Укажите сумму расхода больше нуля.'"),
			"Объект.СуммаДокумента", Отказ);
	КонецЕсли;
	ТекстКассы = Справочники.УЗ_Кассы.ТекстКассаДругойОрганизации(Касса, Организация);
	Если ЗначениеЗаполнено(ТекстКассы) Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, ТекстКассы, "Объект.Касса", Отказ);
	КонецЕсли;
	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.КассаУченики И НЕ ЗначениеЗаполнено(ФизЛицо) Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Возврат денег — укажите ученика (физ. лицо).'"),
			"Объект.ФизЛицо", Отказ);
	КонецЕсли;
	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.ПрочийРасход И НЕ ЗначениеЗаполнено(СтатьяЗатрат) Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
			НСтр("ru = 'Прочий расход — укажите статью затрат: по ней расход виден в отчёте «Расходы».'"),
			"Объект.СтатьяЗатрат", Отказ);
	КонецЕсли;

КонецПроцедуры

//Раздел денег в кассе (измерение ВидОперации регистра УЗ_Касса): деньги учеников или внутренняя касса.
Функция РазделКассы()

	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.ВыплатаЗарплаты
		Или ВидОперации = Перечисления.УЗ_ВидыОпераций.ПрочийРасход Тогда
		Возврат Перечисления.УЗ_ВидыОпераций.ВнутренняяКасса;
	КонецЕсли;
	Возврат ВидОперации;

КонецФункции

//Выплата зарплаты (решения В7, В9 от 28.09.2026) — педагогу (физ. лицо с отметкой «Это педагог») и только
//на основании проведённого расчёта зарплаты того же педагога, не больше невыплаченного остатка расчёта.
//Без расчёта долг педагогу гасился бы мимо ведомости.
Процедура ПроверитьВыплатуЗарплаты(Отказ)

	Если НЕ ЗначениеЗаполнено(ФизЛицо) Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Выплата зарплаты — укажите педагога (физ. лицо).'"),
			"Объект.ФизЛицо", Отказ);
		Возврат;
	КонецЕсли;
	Если НЕ ФизЛицо.ЭтоПедагог Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
			СтрШаблон(НСтр(
			"ru = '%1 — не педагог (в карточке не отмечено «Это педагог»): зарплату выплачивают только педагогу. "
			+ "Возврат денег ученику — вид «Касса ученики», прочие расходы — «Прочий расход».'"), ФизЛицо),
			"Объект.ФизЛицо", Отказ);
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ДокументОснования) <> Тип("ДокументСсылка.УЗ_РасчетЗарплаты")
		Или НЕ ЗначениеЗаполнено(ДокументОснования) Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
			НСтр("ru = 'Выплата зарплаты проводится только на основании проведённого расчёта зарплаты: откройте расчёт "
			+ "педагога и нажмите «Выписать расходный кассовый ордер» (или «Создать на основании» → "
			+ "«Расходный кассовый ордер»).'"),
			"Объект.ДокументОснования", Отказ);
		Возврат;
	КонецЕсли;

	Расчет = ДанныеРасчета(ДокументОснования);
	Если НЕ Расчет.Проведен Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
			СтрШаблон(НСтр("ru = '%1 не проведён — выплата по нему невозможна.'"), ДокументОснования),
			"Объект.ДокументОснования", Отказ);
		Возврат;
	КонецЕсли;
	Если Расчет.Педагог <> ФизЛицо Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
			СтрШаблон(НСтр("ru = '%1 — расчёт педагога %2, а выплата на %3.'"), ДокументОснования, Расчет.Педагог,
			ФизЛицо),
			"Объект.ФизЛицо", Отказ);
		Возврат;
	КонецЕсли;
	//N02: выплата гасит долг организации расчёта — РКО другой организации засчитывался в оплату ведомости А,
	//а долг А оставался и в Б появлялась переплата
	Если Расчет.Организация <> Организация Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
			СтрШаблон(НСтр(
			"ru = '%1 — расчёт организации «%2», а выплата от «%3»: зарплату по ведомости выплачивает та же "
			+ "организация.'"),
			ДокументОснования, Расчет.Организация, Организация), "Объект.Организация", Отказ);
		Возврат;
	КонецЕсли;
	Выплачено = ВыплаченоПоРасчету(ДокументОснования);
	Если Выплачено + СуммаДокумента > Расчет.СуммаДокумента Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
			СтрШаблон(НСтр("ru = 'По %1 к выплате %2, уже выплачено %3 — остаток %4, а в ордере %5.'"),
			ДокументОснования, Формат(Расчет.СуммаДокумента, "ЧДЦ=2; ЧН=0"), Формат(Выплачено, "ЧДЦ=2; ЧН=0"),
			Формат(Расчет.СуммаДокумента - Выплачено, "ЧДЦ=2; ЧН=0"), Формат(СуммаДокумента, "ЧДЦ=2; ЧН=0")),
			"Объект.СуммаДокумента", Отказ);
	КонецЕсли;

КонецПроцедуры

//R14 (ревью 28.09): возврат по абонементу расходует деньги самого абонемента — абонемент этого ученика, его предмета и
//организации, сумма не больше неизрасходованной оплаты абонемента (как автозаполнение «на основании»). Прежде
//проверялся лишь общий аванс ученика по предмету: при двух оплаченных абонементах по 1 000 возврат 1 500 по первому
//проходил, у первого оставалось −500. Остаток читается под блокировкой движений абонемента.
Процедура ПроверитьВозвратПоАбонементу(Отказ)

	Абонемент = ДокументОснования;
	Реквизиты = Новый Структура("ФизЛицо, ПредметОбучения, Организация", Абонемент.ФизЛицо, Абонемент.ПредметОбучения,
		Абонемент.Организация);
	Если Реквизиты.ФизЛицо <> ФизЛицо Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
			СтрШаблон(НСтр("ru = 'Абонемент %1 — ученика %2, а возврат — %3.'"), Абонемент, Реквизиты.ФизЛицо, ФизЛицо),
			"Объект.ФизЛицо", Отказ);
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Реквизиты.ПредметОбучения) И Реквизиты.ПредметОбучения <> ПредметОбучения Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
			СтрШаблон(НСтр("ru = 'Абонемент %1 — по предмету «%2», а возврат — %3.'"), Абонемент,
			Реквизиты.ПредметОбучения, ?(ЗначениеЗаполнено(ПредметОбучения), "по предмету «" + ПредметОбучения + "»",
			НСтр("ru = 'без предмета'"))), "Объект.ПредметОбучения", Отказ);
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Реквизиты.Организация) И Реквизиты.Организация <> Организация Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
			СтрШаблон(НСтр("ru = 'Абонемент %1 оплачен организации «%2», а возврат — от «%3».'"), Абонемент,
			Реквизиты.Организация, Организация), "Объект.Организация", Отказ);
		Возврат;
	КонецЕсли;

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.УЗ_СписанияСуммЗаУроки");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Абонемент", Абонемент);
	Блокировка.Заблокировать();
	Остаток = УЗ_Сервер.ОстатокДенегПоАбонементу(Абонемент);
	Если СуммаДокумента > Остаток Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
			СтрШаблон(НСтр(
			"ru = 'Вернуть %1 по абонементу %2 нельзя: неизрасходованная оплата абонемента %3. Возврат по абонементу — "
			+ "только из его денег.'"),
			Формат(СуммаДокумента, "ЧДЦ=2; ЧН=0,00"), Абонемент, Формат(Макс(Остаток, 0), "ЧДЦ=2; ЧН=0,00")),
			"Объект.СуммаДокумента", Отказ);
	КонецЕсли;

КонецПроцедуры

Функция ДанныеРасчета(Расчет)

	Возврат Новый Структура("Проведен, Педагог, Организация, Касса, СуммаДокумента",
		Расчет.Проведен, Расчет.Педагог, Расчет.Организация, Расчет.Касса, Расчет.СуммаДокумента);

КонецФункции

//Сколько уже выплачено по расчёту другими проведёнными РКО. В проведении — под блокировкой выплат
//педагога: два РКО по одному расчёту, проводимые одновременно, не переплатят остаток оба.
Функция ВыплаченоПоРасчету(Расчет)

	Если ТранзакцияАктивна() Тогда
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.УЗ_РасчетыПоЗарплате");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.УстановитьЗначение("Педагог", ФизЛицо);
		Блокировка.Заблокировать();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Выплаты.СуммаДокумента), 0) КАК Сумма
	|ИЗ
	|	Документ.УЗ_РасходДенег КАК Выплаты
	|ГДЕ
	|	Выплаты.Проведен
	|	И Выплаты.ДокументОснования = &Расчет
	|	И Выплаты.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыОпераций.ВыплатаЗарплаты)
	|	И Выплаты.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("Расчет", Расчет);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Сумма;

КонецФункции

#КонецОбласти
