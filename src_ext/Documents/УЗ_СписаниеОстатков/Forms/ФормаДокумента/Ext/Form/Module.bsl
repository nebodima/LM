
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УЗ_ДатыЗапрета.ФормаПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображение()
	
	 Если Объект.ТЗСписания.Количество()>0 Тогда
		Элементы.ГруппаДокумент.Заголовок = "Взаиморасчеты (" +Объект.ТЗСписания.Количество()+")";
	КонецЕсли;
	
	Если Объект.ДисконтныеКарты.Количество()>0 Тогда
		Элементы.ГруппаДокумент1.Заголовок = "Бонусы (" +Объект.ДисконтныеКарты.Количество()+")";
	КонецЕсли;
	
	Если Объект.ТЗСписаниеКасса.Количество()>0 Тогда
		Элементы.ГруппаДокумент2.Заголовок = "Касса (" +Объект.ТЗСписаниеКасса.Количество()+")";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьОтображение();
КонецПроцедуры

&НаКлиенте
Процедура ТЗСписанияПриИзменении(Элемент)
	ОбновитьОтображение();
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияДокумента(Команда)
	ДанныеС = Новый Структура;
	ДанныеС.Вставить("Документ",Объект.Ссылка);
	ОткрытьФорму("Отчет.УЗ_ДвиженияДокумента.Форма.ДвиженияДокумента",ДанныеС ,ЭтаФорма, , , , ,РежимОткрытияОкнаФормы.Независимый);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ЗаполнитьЧасыТекстом();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации";	
	Если Запрос.Выполнить().Выгрузить().Количество() = 0 Тогда
		Элементы.Организация.Видимость = Ложь;
	КонецЕсли; 

КонецПроцедуры

//Часы вводятся и показываются строкой «ч:мм» (доп. колонка ЧасыТекстом), хранятся числом часов
&НаСервере
Процедура ЗаполнитьЧасыТекстом()
	Для Каждого Стр Из Объект.ТЗСписания Цикл
		Стр.ЧасыТекстом = УЗ_ОбщийКлиентСервер.ЧасыМинуты(Стр.КоличествоЧасов, Истина);
	КонецЦикла;
	ЧасыТекстом = УЗ_ОбщийКлиентСервер.ЧасыМинуты(Объект.ТЗСписания.Итог("КоличествоЧасов"));
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ЗаполнитьЧасыТекстом();
КонецПроцедуры

&НаКлиенте
Процедура ТЗСписанияКоличествоЧасовПриИзменении(Элемент)
	Стр = Элементы.ТЗСписания.ТекущиеДанные;
	Часы = УЗ_ОбщийКлиентСервер.ЧасыИзСтроки(Стр.ЧасыТекстом);
	Если Часы = Неопределено Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(НСтр("ru = 'Часы вводятся как ч:мм, например 1:30.'"));
	Иначе
		Стр.КоличествоЧасов = Часы;
	КонецЕсли;
	Стр.ЧасыТекстом = УЗ_ОбщийКлиентСервер.ЧасыМинуты(Стр.КоличествоЧасов, Истина);
	ЧасыТекстом = УЗ_ОбщийКлиентСервер.ЧасыМинуты(Объект.ТЗСписания.Итог("КоличествоЧасов"));
КонецПроцедуры
