
Процедура ОбработкаПроведения(Отказ, Режим)
	
	//КолСекунд = -(Дата("01.01.0001 0:00:00") - КоличествоЧасов);
	
	// регистр СписанияСуммЗаУроки Приход
	Движения.УЗ_СписанияСуммЗаУроки.Записывать = Истина;	
	Для Каждого Стр из ТЗСписания Цикл
		Движение = Движения.УЗ_СписанияСуммЗаУроки.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период 			= Дата;
		Движение.Клиент 			= Стр.Ученик;
		Движение.Педагог 			= Стр.Педагог;
		Движение.Часы 				= Стр.КоличествоЧасов * 3600; //регистр хранит секунды
		//знаки — как у проведённого урока (Документ.УЗ_Урок: Расход, уроки и явки −1): положительное
		//«Кол-во ур.»/«Кол-во явок» списывается так же, как проведённые уроки, отрицательное — возвращает
		//(было: +N в Расход — списание уроков действовало обратно уроку)
		Движение.КоличествоУроков 	= -Стр.КоличествоУроков;
		Движение.КоличествоЯвок		= -Стр.КоличествоЯвок;
		Движение.Сумма 				= Стр.Сумма;
		Движение.Тариф 				= Стр.Тариф;
		Движение.ПредметОбучения 	= Стр.ПредметОбучения;
		Движение.ГруппаОбучения 	= Стр.ГруппаОбучения;
		Движение.Организация 		= Организация;
	КонецЦикла;
	
	// регистр ДвижениеДисконтныхКарт Приход
	Движения.УЗ_ДвижениеДисконтныхКарт.Записывать = Истина;
	Для Каждого Стр из ДисконтныеКарты Цикл
		Движение = Движения.УЗ_ДвижениеДисконтныхКарт.Добавить();
		Движение.ВидДвижения 		= ВидДвиженияНакопления.Расход;
		Движение.Период 			= Дата;
		Движение.Клиент 			= Стр.ДисконтнаяКарта.Владелец;
		Движение.ДисконтнаяКарта 	= Стр.ДисконтнаяКарта;
		Движение.СуммаБонусов 		= Стр.СуммаБонусов;
		Движение.Организация 		= Организация;
	КонецЦикла; 
	
	// регистр Касса Расход
	Движения.УЗ_Касса.Записывать = Истина;
	Для Каждого Стр из ТЗСписаниеКасса Цикл
		Движение = Движения.УЗ_Касса.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период 		= Дата;
		Движение.Клиент 		= Стр.Ученик;
		Движение.Касса 			= Стр.Касса;
		Движение.СтатьяЗатрат 	= Стр.СтатьяЗатрат; 		
		Движение.ПредметОбучения = Стр.ПредметОбучения;		
		Движение.ВидОперации 	= Стр.ВидОперации;		
		Движение.Сумма 			= Стр.Сумма;
		Движение.Организация 	= Организация;
	КонецЦикла;  

КонецПроцедуры

//На основании физ. лица (кнопка «Ввести на основании» в списке физ. лиц): строка взаиморасчётов на каждый
//предмет с ненулевым остатком денег ученика, сумма — весь остаток (проведение списывает его в ноль:
//переплату — положительной суммой, долг — отрицательной). Нет остатков — одна строка с учеником. Остатки — в
//организации документа (В12: деньги учеников раздельно по организациям; списание пишет движения в неё же).
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоНовый() И Не ЗначениеЗаполнено(Организация) Тогда
		Организация = РегистрыСведений.УЗ_Настройки.Настройки().Организация;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) <> Тип("СправочникСсылка.УЗ_ФизЛица") Или Не ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.ПредметОбучения КАК ПредметОбучения,
	|	СУММА(Остатки.СуммаОстаток) КАК Сумма
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки.Остатки(, Клиент = &Ученик И Организация = &Организация) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.ПредметОбучения
	|
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.СуммаОстаток) <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПредметОбучения";
	Запрос.УстановитьПараметр("Ученик", ДанныеЗаполнения);
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТЗСписания.Очистить();
	Пока Выборка.Следующий() Цикл
		Строка = ТЗСписания.Добавить();
		Строка.Ученик = ДанныеЗаполнения;
		Строка.ПредметОбучения = Выборка.ПредметОбучения;
		Строка.Сумма = Выборка.Сумма;
	КонецЦикла;
	Если ТЗСписания.Количество() = 0 Тогда
		ТЗСписания.Добавить().Ученик = ДанныеЗаполнения;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.АвторДокумента) Тогда
		ЭтотОбъект.АвторДокумента = УЗ_Среда.ТекущийПользователь();
	КонецЕсли;
	
	Сумма 			= ТЗСписания.Итог("Сумма");
	СуммаБонусов 	= ДисконтныеКарты.Итог("СуммаБонусов");
	СуммаПоКассе	= ТЗСписаниеКасса.Итог("Сумма");
	КоличествоЧасов = ТЗСписания.Итог("КоличествоЧасов"); 

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	 АвторДокумента = Неопределено;
	 Комментарий    = Неопределено;
КонецПроцедуры
