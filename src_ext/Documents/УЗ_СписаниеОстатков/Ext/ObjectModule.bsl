//Списание (оприходование) остатков — ручная правка остатков ученика, бонусов карты и денег кассы. Положительные
//значения действуют как расход (как проведённый урок, как выдача из кассы), отрицательные — как приход. Правка
//подчиняется тем же правилам, что и обычные документы: касса не уходит в минус (В14, В12 — по организации),
//бонусы — единые проверки карты (В24), абонемент — строка по абонементу меняет его остаток.
Процедура ОбработкаПроведения(Отказ, Режим)

	//дата запрета проверяется подпиской УЗ_ДатаЗапретаПередЗаписью (модуль УЗ_ДатыЗапрета)

	ПроверитьСтроки(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// регистр СписанияСуммЗаУроки: знаки — как у проведённого урока (Документ.УЗ_Урок: Расход суммы и часов,
	// уроки и явки −1). Положительные «Кол-во ур.»/«Кол-во явок» списываются так же, как проведённые уроки,
	// отрицательные — возвращаются (было: +N в Расход — списание уроков действовало обратно уроку)
	Движения.УЗ_СписанияСуммЗаУроки.Записывать = Истина;
	Для Каждого Стр из ТЗСписания Цикл
		Движение = Движения.УЗ_СписанияСуммЗаУроки.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период 			= Дата;
		Движение.Клиент 			= Стр.Ученик;
		Движение.Педагог 			= Стр.Педагог;
		Движение.Часы 				= Документы.УЗ_Урок.СекундУрока(Стр.КоличествоЧасов); //регистр хранит секунды, от целых минут (В13)
		Движение.КоличествоУроков 	= -Стр.КоличествоУроков;
		Движение.КоличествоЯвок		= -Стр.КоличествоЯвок;
		Движение.Сумма 				= Стр.Сумма;
		Движение.Тариф 				= Стр.Тариф;
		Движение.Абонемент 			= Стр.Абонемент;   //списание по абонементу закрывает его остаток (деньги, уроки, часы)
		Движение.ПредметОбучения 	= Стр.ПредметОбучения;
		Движение.ГруппаОбучения 	= Стр.ГруппаОбучения;
		Движение.Организация 		= Организация;
	КонецЦикла;

	// регистр ДвижениеДисконтныхКарт: положительные бонусы списываются с карты, отрицательные — начисляются
	Движения.УЗ_ДвижениеДисконтныхКарт.Записывать = Истина;
	Для Каждого Стр из ДисконтныеКарты Цикл
		Движение = Движения.УЗ_ДвижениеДисконтныхКарт.Добавить();
		Движение.ВидДвижения 		= ВидДвиженияНакопления.Расход;
		Движение.Период 			= Дата;
		Движение.Клиент 			= Стр.ДисконтнаяКарта.Владелец;
		Движение.ДисконтнаяКарта 	= Стр.ДисконтнаяКарта;
		Движение.СуммаБонусов 		= Стр.СуммаБонусов;
		Движение.Организация 		= Организация;
	КонецЦикла;

	// регистр Касса Расход
	Движения.УЗ_Касса.Записывать = Истина;
	Для Каждого Стр из ТЗСписаниеКасса Цикл
		Движение = Движения.УЗ_Касса.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период 		= Дата;
		Движение.Клиент 		= Стр.Ученик;
		Движение.Касса 			= Стр.Касса;
		Движение.СтатьяЗатрат 	= Стр.СтатьяЗатрат;
		Движение.ПредметОбучения = Стр.ПредметОбучения;
		Движение.ВидОперации 	= РазделКассы(Стр.ВидОперации);
		Движение.Сумма 			= Стр.Сумма;
		Движение.Организация 	= Организация;
	КонецЦикла;

	//В14/В12: ручной расход кассы — тоже расход: касса организации не уходит в минус (прежде уходила, и справка
	//это узаконивала)
	Справочники.УЗ_Кассы.ПроверитьОстаткиКасс(ЭтотОбъект, Движения.УЗ_Касса, Отказ);

КонецПроцедуры

//Строки документа: пустые и нулевые строки не проводятся (прежде давали движения с пустым учеником, кассой, картой);
//абонемент — этого ученика и предмета (как в уроке); касса — своей организации; бонусы — единые проверки карты
//по итогу строк карты (В24: срок, «Не действует», сумма ≥ 0, остаток при списании).
Процедура ПроверитьСтроки(Отказ)

	Для Каждого Стр Из ТЗСписания Цикл
		Поле = СтрШаблон("ТЗСписания[%1].", Стр.НомерСтроки - 1);
		Если НЕ ЗначениеЗаполнено(Стр.Ученик) Тогда
			СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Взаиморасчёты, строка %1: не указан ученик.'"), Стр.НомерСтроки), Поле + "Ученик", Отказ);
		КонецЕсли;
		Если Стр.Сумма = 0 И Стр.КоличествоЧасов = 0 И Стр.КоличествоУроков = 0 И Стр.КоличествоЯвок = 0 Тогда
			СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Взаиморасчёты, строка %1: нечего списывать — сумма, часы, уроки и явки нулевые.'"), Стр.НомерСтроки),
				Поле + "Сумма", Отказ);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.Абонемент) Тогда
			Если Стр.Абонемент.ФизЛицо <> Стр.Ученик Тогда
				СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Взаиморасчёты, строка %1: абонемент «%2» — другого ученика (%3).'"),
					Стр.НомерСтроки, Стр.Абонемент, Стр.Абонемент.ФизЛицо), Поле + "Абонемент", Отказ);
			ИначеЕсли ЗначениеЗаполнено(Стр.Абонемент.ПредметОбучения) И Стр.Абонемент.ПредметОбучения <> Стр.ПредметОбучения Тогда
				СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Взаиморасчёты, строка %1: абонемент «%2» — по предмету «%3», а в строке «%4».'"),
					Стр.НомерСтроки, Стр.Абонемент, Стр.Абонемент.ПредметОбучения, Стр.ПредметОбучения), Поле + "ПредметОбучения", Отказ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	ИтогиКарт = Новый Соответствие;
	Для Каждого Стр Из ДисконтныеКарты Цикл
		Если НЕ ЗначениеЗаполнено(Стр.ДисконтнаяКарта) Или Стр.СуммаБонусов = 0 Тогда
			СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Бонусы, строка %1: укажите карту и сумму бонусов (плюс — списать, минус — начислить).'"), Стр.НомерСтроки),
				СтрШаблон("ДисконтныеКарты[%1].ДисконтнаяКарта", Стр.НомерСтроки - 1), Отказ);
			Продолжить;
		КонецЕсли;
		ИтогиКарт.Вставить(Стр.ДисконтнаяКарта, ?(ИтогиКарт[Стр.ДисконтнаяКарта] = Неопределено, 0, ИтогиКарт[Стр.ДисконтнаяКарта]) + Стр.СуммаБонусов);
	КонецЦикла;
	Для Каждого ИтогКарты Из ИтогиКарт Цикл
		Если ИтогКарты.Значение > 0 Тогда
			Текст = Документы.УЗ_ПриходДенег.ПроверитьСписаниеБонусов(ИтогКарты.Ключ, Дата, ИтогКарты.Значение, Ссылка);
		Иначе
			Текст = Документы.УЗ_ПриходДенег.ПроверитьНачислениеБонусов(ИтогКарты.Ключ, Дата, -ИтогКарты.Значение);
		КонецЕсли;
		Если ЗначениеЗаполнено(Текст) Тогда
			СообщитьОбОшибке(Текст, "ДисконтныеКарты", Отказ);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Стр Из ТЗСписаниеКасса Цикл
		Поле = СтрШаблон("ТЗСписаниеКасса[%1].", Стр.НомерСтроки - 1);
		Если НЕ ЗначениеЗаполнено(Стр.Касса) Или Стр.Сумма = 0 Тогда
			СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Касса, строка %1: укажите кассу и сумму (плюс — выдача из кассы, минус — излишек, приход в кассу).'"), Стр.НомерСтроки),
				Поле + "Касса", Отказ);
		КонецЕсли;
		ТекстКассы = Справочники.УЗ_Кассы.ТекстКассаДругойОрганизации(Стр.Касса, Организация);
		Если ЗначениеЗаполнено(ТекстКассы) Тогда
			СообщитьОбОшибке(ТекстКассы, Поле + "Касса", Отказ);
		КонецЕсли;
		Если ЗначениеЗаполнено(Стр.ВидОперации) И Стр.ВидОперации <> Перечисления.УЗ_ВидыОпераций.КассаУченики
			И Стр.ВидОперации <> Перечисления.УЗ_ВидыОпераций.ВнутренняяКасса Тогда
			СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Касса, строка %1: раздел кассы — «Касса ученики» (деньги учеников) или «Внутренняя касса»; «%2» — вид расходного ордера, а не раздел.'"),
				Стр.НомерСтроки, Стр.ВидОперации), Поле + "ВидОперации", Отказ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

//Раздел кассы строки: пустой — «Внутренняя касса» (недостача и излишек — деньги студии).
Функция РазделКассы(ВидОперацииСтроки)

	Возврат ?(ЗначениеЗаполнено(ВидОперацииСтроки), ВидОперацииСтроки, Перечисления.УЗ_ВидыОпераций.ВнутренняяКасса);

КонецФункции

//На основании физ. лица (кнопка «Ввести на основании» в списке физ. лиц): строка взаиморасчётов на каждый
//остаток денег ученика в разрезе предмета, абонемента, тарифа и группы, сумма — весь остаток (проведение списывает
//его в ноль: переплату — положительной суммой, долг — отрицательной; остаток абонемента и «по тарифу» тоже
//обнуляются). Нет остатков — одна строка с учеником. Остатки — в организации документа (В12) и на дату документа
//(новый документ — текущие; задним числом не закрываются деньги, пришедшие позже).
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если ЭтоНовый() И Не ЗначениеЗаполнено(Организация) Тогда
		Организация = РегистрыСведений.УЗ_Настройки.Настройки().Организация;
	КонецЕсли;

	Если ТипЗнч(ДанныеЗаполнения) <> Тип("СправочникСсылка.УЗ_ФизЛица") Или Не ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.ПредметОбучения КАК ПредметОбучения,
	|	Остатки.Абонемент КАК Абонемент,
	|	Остатки.Тариф КАК Тариф,
	|	Остатки.ГруппаОбучения КАК ГруппаОбучения,
	|	СУММА(Остатки.СуммаОстаток) КАК Сумма
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки.Остатки(&Граница, Клиент = &Ученик И Организация = &Организация) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.ПредметОбучения,
	|	Остатки.Абонемент,
	|	Остатки.Тариф,
	|	Остатки.ГруппаОбучения
	|
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.СуммаОстаток) <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПредметОбучения";
	Запрос.УстановитьПараметр("Ученик", ДанныеЗаполнения);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Граница", ?(ЭтоНовый() Или НЕ ЗначениеЗаполнено(Дата), Неопределено,
		Новый Граница(МоментВремени(), ВидГраницы.Исключая)));
	Если ЭтоНовый() Или НЕ ЗначениеЗаполнено(Дата) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Остатки(&Граница,", "Остатки(,");
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();

	ТЗСписания.Очистить();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТЗСписания.Добавить();
		НоваяСтрока.Ученик = ДанныеЗаполнения;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка, "ПредметОбучения, Абонемент, Тариф, ГруппаОбучения, Сумма");
	КонецЦикла;
	Если ТЗСписания.Количество() = 0 Тогда
		ТЗСписания.Добавить().Ученик = ДанныеЗаполнения;
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.АвторДокумента) Тогда
		ЭтотОбъект.АвторДокумента = УЗ_Среда.ТекущийПользователь();
	КонецЕсли;

	//В12: касса и деньги ученика — по организации; документ, созданный программно без организации, — в организации
	//по умолчанию (как перемещение, C03), иначе его деньги легли бы в «пустую» организацию
	Если НЕ ЗначениеЗаполнено(Организация) И НЕ ОбменДанными.Загрузка Тогда
		Организация = РегистрыСведений.УЗ_Настройки.Настройки().Организация;
	КонецЕсли;

	Сумма 			= ТЗСписания.Итог("Сумма");
	СуммаБонусов 	= ДисконтныеКарты.Итог("СуммаБонусов");
	СуммаПоКассе	= ТЗСписаниеКасса.Итог("Сумма");
	КоличествоЧасов = ТЗСписания.Итог("КоличествоЧасов");

	//В14: отмена проведения оприходования кассы (строки с минусом) не уводит кассу в минус
	Справочники.УЗ_Кассы.ПередЗаписьюДокументаКассы(ЭтотОбъект, РежимЗаписи, Отказ);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	 АвторДокумента = Неопределено;
	 Комментарий    = Неопределено;
КонецПроцедуры

Процедура СообщитьОбОшибке(Текст, Поле, Отказ)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	Отказ = Истина;

КонецПроцедуры
