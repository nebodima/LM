
Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Номер = Данные.Номер;
	Пока Лев(Номер, 1) = "0" Цикл 
		Номер = Прав(Номер, СтрДлина(Номер) - 1);
	КонецЦикла;

	Представление = "Урок " +Номер+ " от " +Формат(Данные.Дата,"ДФ='д.ММ.гг (Ч:мм) (ддд)'")+ " "
	+Данные.Ссылка.ПредметОбучения; 
	
КонецПроцедуры

//B07: ставка педагога урока по умолчанию. Урок, созданный программно (панель ученика, помощник, календарь,
//обработки), ставку не получал и начислял педагогу 0. Одна функция для всех маршрутов: заполняет только пустую
//ставку (выбранную вручную не трогает); запись нового урока зовёт её сама.
Процедура ЗаполнитьСтавкуПедагога(Объект) Экспорт

	Если ЗначениеЗаполнено(Объект.СтавкаПедагога) Или Не ЗначениеЗаполнено(Объект.Педагог) Тогда
		Возврат;
	КонецЕсли;
	Объект.СтавкаПедагога = СтавкаПедагогаПоУмолчанию(Объект.Педагог, Объект.ГруппаОбучения);

КонецПроцедуры

//Ставка урока по умолчанию — как «ставка по виду работ» в типовых: у группы задана «Ставка педагога» — групповой
//урок начисляет по ней (педагог ведёт индивидуальные уроки «за час», а группы — «с человека»); иначе — ставка из
//карточки педагога. Одна функция для формы урока, календаря, помощника, панели и записи урока.
Функция СтавкаПедагогаПоУмолчанию(Педагог, ГруппаОбучения = Неопределено) Экспорт

	Если ЗначениеЗаполнено(ГруппаОбучения) И ЗначениеЗаполнено(ГруппаОбучения.СтавкаПедагога) Тогда
		Возврат ГруппаОбучения.СтавкаПедагога;
	КонецЕсли;
	Если ЗначениеЗаполнено(Педагог) Тогда
		Возврат Педагог.СтавкаПедагога;
	КонецЕсли;
	Возврат Справочники.УЗ_СтавкиПедагогов.ПустаяСсылка();

КонецФункции

//Смена педагога урока (форма): ставка — по умолчанию для нового педагога и группы урока, начисления пересчитываются;
//ручные доплаты и удержания (строки без «#») остаются — прежде форма очищала всю таблицу начислений.
Процедура ПриСменеПедагога(Объект) Экспорт

	Объект.СтавкаПедагога = СтавкаПедагогаПоУмолчанию(Объект.Педагог, Объект.ГруппаОбучения);
	ПересчитатьНачисленияПедагога(Объект);

КонецПроцедуры

Процедура ПересчитатьНачисленияПедагога(Объект) Экспорт
	        	
	ВремСтараяТЗ = Объект.НачисленияПедагогу.Выгрузить();
	
	Объект.НачисленияПедагогу.Очистить();
	
	Ставка = Объект.СтавкаПедагога;
	
	//В6 (решение владельца 28.09.2026): урок без единой явки не считается проведённым — «за занятие» и «за час»
	//не начисляются; «с человека» — по явке; «% с оплаты» — от суммы оплаты учеников (оплаченная неявка тоже)
	КоличествоЯвок = 0;
	КоличествоОплат = 0;
	Для Каждого СтрУч из Объект.Ученики Цикл
		Если СтрУч.Явка Тогда
			КоличествоЯвок = КоличествоЯвок + 1;
		КонецЕсли;
		Если СтрУч.СписатьОплату Тогда
			КоличествоОплат = КоличествоОплат + 1;
		КонецЕсли;
	КонецЦикла;
	
	//«Не изменять» у автоматического начисления (комментарий с «#») — строка остаётся как есть, ставка его не
	//пересчитывает (прежде отметка на пересчёт не влияла: строки с «#» всегда считались заново)
	Зафиксировано = Ложь;
	Для Каждого СтрокаСтаройТЗ Из ВремСтараяТЗ Цикл
		Если СтрокаСтаройТЗ.НеИзменять И СтрНайти(СтрокаСтаройТЗ.Комментарий, "#") > 0 Тогда
			Зафиксировано = Истина;
			НовНачисление = Объект.НачисленияПедагогу.Добавить();
			НовНачисление.СуммаНачисления 	= СтрокаСтаройТЗ.СуммаНачисления;
			НовНачисление.Комментарий 		= СтрокаСтаройТЗ.Комментарий;
			НовНачисление.НеИзменять 		= Истина;
		КонецЕсли;
	КонецЦикла;

	Если НЕ Ставка.Пустая() И НЕ Зафиксировано И СтавкаДействуетНаДату(Ставка, Объект.Дата) Тогда

		СуммаНачисления = 0;
		Если Ставка.ОплатаСЧеловека > 0 Тогда
			СуммаНачисления = КоличествоЯвок * Ставка.ОплатаСЧеловека;
			Комментарий 	= "#ОплатаСЧеловека (" + КоличествоЯвок + " уч.)";
		ИначеЕсли Ставка.ПроцентСОплатыУченика > 0 Тогда
			//В15: процент — от оплаты учеников (сумма строк после скидки), материалы и доп. расходы не вычитаются
			СуммаНачисления = Окр(Объект.Ученики.Итог("Сумма") * Ставка.ПроцентСОплатыУченика / 100, 2);
			Комментарий 	= "#ПроцентСОплатыУченика (" + КоличествоОплат + " уч.)";
		ИначеЕсли Ставка.ОплатаЗаЗанятие > 0 Тогда
			СуммаНачисления = ?(КоличествоЯвок > 0, Ставка.ОплатаЗаЗанятие, 0);
			Комментарий 	= "#ОплатаЗаЗанятие";
		ИначеЕсли Ставка.ОплатаЗаЧас > 0 Тогда
			СуммаНачисления = ?(КоличествоЯвок > 0, Окр(Ставка.ОплатаЗаЧас * ЧасовУрока(Объект.КоличествоЧасов), 2), 0); //В13: от целых минут
			Комментарий 	= "#ОплатаЗаЧас";
		КонецЕсли;
		
		Если СуммаНачисления <> 0 Тогда
			НовНачисление = Объект.НачисленияПедагогу.Добавить();
			НовНачисление.СуммаНачисления 	= СуммаНачисления;
			НовНачисление.Комментарий 		= Комментарий;
		КонецЕсли;
		
	КонецЕсли; 		
	
	// Возвращаем ручные начисления (без пометки "#"). B06: ручная доплата без комментария тоже остаётся —
	// прежде строка без комментария выбрасывалась при каждой записи урока, даже с "Не изменять"; пропускаются
	// только пустые строки (без комментария и без суммы)
	Для Каждого СтрокаСтаройТЗ из ВремСтараяТЗ Цикл		
		Если СтрНайти(СтрокаСтаройТЗ.Комментарий,"#")>0
			Или Не ЗначениеЗаполнено(СтрокаСтаройТЗ.Комментарий) И СтрокаСтаройТЗ.СуммаНачисления = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НовНачисление = Объект.НачисленияПедагогу.Добавить();
		НовНачисление.СуммаНачисления 	= СтрокаСтаройТЗ.СуммаНачисления;
		НовНачисление.Комментарий 		= СтрокаСтаройТЗ.Комментарий;
		НовНачисление.НеИзменять 		= СтрокаСтаройТЗ.НеИзменять; 		
	КонецЦикла; 	
	
КонецПроцедуры

//Проведённый расчёт зарплаты, в ведомость которого вошёл урок (В9): Структура(Номер, Дата) или Неопределено.
//Читается регистр УЗ_УрокиВРасчетахЗарплаты (движения расчёта) — он виден и менеджеру, которому сами расчёты
//зарплаты не видны (права): проверка при записи урока работает у всех. Урок с проведённой выплатой всегда в
//проведённом расчёте (оплаченный расчёт не отменяется, N01).
Функция РасчетЗарплатыСУроком(СсылкаУрока) Экспорт

	Если Не ЗначениеЗаполнено(СсылкаУрока) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Уроки.НомерРасчета КАК Номер,
	|	Уроки.ДатаРасчета КАК Дата
	|ИЗ
	|	РегистрСведений.УЗ_УрокиВРасчетахЗарплаты КАК Уроки
	|ГДЕ
	|	Уроки.Урок = &Урок
	|	И Уроки.Активность
	|
	|УПОРЯДОЧИТЬ ПО
	|	Уроки.ДатаРасчета";
	Запрос.УстановитьПараметр("Урок", СсылкаУрока);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Номер, Дата", НомерБезНулей(Выборка.Номер), Выборка.Дата);

КонецФункции

//Действует ли ставка педагога на дату урока: «Действует с» / «по» (границы включительно, пустая — без ограничения).
//Ставка вне срока не начисляет — прежде срок ставки нигде не учитывался.
Функция СтавкаДействуетНаДату(Ставка, Дата) Экспорт

	Если ЗначениеЗаполнено(Ставка.НачалоДействия) И Дата < НачалоДня(Ставка.НачалоДействия) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(Ставка.ОкончаниеДействия) И Дата > КонецДня(Ставка.ОкончаниеДействия) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

//Цена тарифа на дату: Структура(Сумма, КоличествоЧасов, КоличествоУроков) или Неопределено — цены нет.
//Цена всегда на дату урока — последняя запись регистра УЗ_ЦеныТарифов на дату. Р2/В8 (как в типовых): смена
//одной цены в карточке тарифа тоже пишется в регистр с даты (РегистрыСведений.УЗ_ЦеныТарифов.ЗафиксироватьЦенуКарточки),
//поэтому перепроведение старого урока берёт цену его даты, а не новую. Тариф без истории цен, у которого записей
//на дату нет (цену карточки ни разу не меняли), — цена из карточки (так её и показывает представление тарифа).
//Запись с суммой 0 — явно бесплатный тариф: цена есть и равна нулю. Нет цены — урок «К оплате» не проводится.
Функция ЦенаТарифаНаДату(Тариф, Дата) Экспорт

	ЦенаНаДату = РегистрыСведений.УЗ_ЦеныТарифов.ПолучитьСуммуТарифаНаДату(Тариф, Дата);
	Если ЦенаНаДату <> Неопределено Или Тариф.ИспользоватьИсториюЦен Тогда
		Возврат ЦенаНаДату;
	КонецЕсли;

	Если РегистрыСведений.УЗ_ЦеныТарифов.ЦенаКарточкиЗаполнена(Тариф) Тогда
		Возврат Новый Структура("Сумма, КоличествоЧасов, КоличествоУроков",
			Тариф.Сумма, Тариф.КоличествоЧасов, Тариф.КоличествоУроков);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

//Текст отказа для строки учеников, у тарифа которой нет цены на дату урока.
Функция ТекстНетЦеныТарифа(Тариф, Дата, НомерСтроки) Экспорт

	Возврат СтрШаблон("Строка %1: у тарифа «%2» нет цены на %3. Укажите цену в карточке тарифа или снимите отметку «К оплате»",
		НомерСтроки, Тариф, Формат(Дата, "ДЛФ=D"));

КонецФункции

//Сумма скидки строки урока: от 0 до цены (скидка не делает сумму отрицательной).
//Нет скидки или оба коэффициента 0 — 0. Скидка вне срока действия (ПериодДействияС/По, границы включительно) — Неопределено.
Функция СуммаСкидки(Скидка, Цена, Дата) Экспорт

	Если Не ЗначениеЗаполнено(Скидка) Тогда
		Возврат 0;
	КонецЕсли;

	Если ЗначениеЗаполнено(Скидка.ПериодДействияС) И Дата < НачалоДня(Скидка.ПериодДействияС)
		Или ЗначениеЗаполнено(Скидка.ПериодДействияПо) И Дата > КонецДня(Скидка.ПериодДействияПо) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Скидка.КоэффициентСумма <> 0 Тогда
		Результат = Скидка.КоэффициентСумма;
	ИначеЕсли Скидка.КоэффициентПроцент <> 0 Тогда
		Результат = Цена / 100 * Скидка.КоэффициентПроцент;
	Иначе
		Результат = 0;
	КонецЕсли;

	Возврат Макс(0, Мин(Результат, Цена));

КонецФункции

Функция ТекстСкидкаВнеСрока(Скидка, Дата, НомерСтроки) Экспорт

	Возврат СтрШаблон("Строка %1: скидка «%2» на %3 не действует (срок действия с %4 по %5) — не применена",
		НомерСтроки, Скидка, Формат(Дата, "ДЛФ=D"),
		?(ЗначениеЗаполнено(Скидка.ПериодДействияС), Формат(Скидка.ПериодДействияС, "ДЛФ=D"), "…"),
		?(ЗначениеЗаполнено(Скидка.ПериодДействияПо), Формат(Скидка.ПериодДействияПо, "ДЛФ=D"), "…"));

КонецФункции

//Цена одного урока по тарифу на дату: уроковый тариф — сумма / число уроков, часовой — пропорционально часам урока.
//Неопределено — у тарифа нет цены на дату (или цена без единицы, или часовой тариф при уроке 0 ч — В25).
Функция ЦенаУрокаПоТарифу(Тариф, Дата, КоличествоЧасов) Экспорт

	Итог = ЦенаЕдиницыПоТарифу(ЦенаТарифаНаДату(Тариф, Дата), КоличествоЧасов);
	Возврат ?(Итог.ТекстОшибки = "", Итог.Цена, Неопределено);

КонецФункции

//Цена урока по цене тарифа (Структура(Сумма, КоличествоЧасов, КоличествоУроков) или Неопределено) — одно правило
//единиц для урока, подсказок и представления тарифа: сначала «за уроки», затем «за часы».
//Возврат: Структура(Цена, Единица, ТекстОшибки): Единица — "урок" / "час" / "бесплатно" / ""; ТекстОшибки — "" или
//почему цены нет («нет цены», «нет единицы», «часовой тариф при уроке 0 ч» — В25).
Функция ЦенаЕдиницыПоТарифу(ЦенаТарифа, КоличествоЧасов)

	Итог = Новый Структура("Цена, Единица, ТекстОшибки", 0, "", "");
	Если ЦенаТарифа = Неопределено Тогда
		Итог.ТекстОшибки = "нет цены";
	ИначеЕсли ЦенаТарифа.Сумма = 0 Тогда
		Итог.Единица = "бесплатно"; //явно бесплатная цена (запись истории с суммой 0)
	ИначеЕсли ЦенаТарифа.КоличествоУроков > 0 Тогда
		Итог.Единица = "урок";
		Итог.Цена = ЦенаТарифа.Сумма / ЦенаТарифа.КоличествоУроков;
	ИначеЕсли ЦенаТарифа.КоличествоЧасов > 0 Тогда
		Итог.Единица = "час";
		//и часы урока, и часы тарифа — целыми минутами (В13/В25): «1 000 за 40 мин» (0,6667 ч) — урок 40 мин ровно 1 000
		ЧасовТарифа = ЧасовУрока(ЦенаТарифа.КоличествоЧасов);
		Если ЧасовУрока(КоличествоЧасов) <= 0 Тогда
			Итог.ТекстОшибки = "урок 0 ч";
		ИначеЕсли ЧасовТарифа <= 0 Тогда
			Итог.ТекстОшибки = "нет единицы";
		Иначе
			Итог.Цена = ЦенаТарифа.Сумма * ЧасовУрока(КоличествоЧасов) / ЧасовТарифа;
		КонецЕсли;
	Иначе
		Итог.ТекстОшибки = "нет единицы";
	КонецЕсли;
	Возврат Итог;

КонецФункции

//Подсказка цены тарифа — одинаковая в форме тарифа, форме записи цены, помощнике уроков и представлении тарифа:
//«1 000,00 за 1 урок (8 000,00 / 8 ур.)» или «1 000,00 за 1 час (1 000,00 / 1 ч.)». Порядок единиц — как считает
//урок (ЦенаЕдиницыПоТарифу): сначала уроки, затем часы. Цена — Структура(Сумма, КоличествоЧасов, КоличествоУроков).
Функция ПредставлениеЦеныТарифа(Цена, Кратко = Ложь) Экспорт

	Если Цена = Неопределено Тогда
		Возврат НСтр("ru = 'нет цены'");
	ИначеЕсли Цена.Сумма = 0 Тогда
		Возврат НСтр("ru = 'Бесплатно'");
	ИначеЕсли Цена.КоличествоУроков > 0 Тогда
		Возврат Формат(Цена.Сумма / Цена.КоличествоУроков, "ЧДЦ=2") + " за 1 урок" + ?(Кратко, "",
			" (" + Формат(Цена.Сумма, "ЧДЦ=2") + " / " + Цена.КоличествоУроков + " ур.)");
	ИначеЕсли ЧасовУрока(Цена.КоличествоЧасов) > 0 Тогда
		Возврат Формат(Цена.Сумма / ЧасовУрока(Цена.КоличествоЧасов), "ЧДЦ=2") + " за 1 час" + ?(Кратко, "",
			" (" + Формат(Цена.Сумма, "ЧДЦ=2") + " / " + Формат(Цена.КоличествоЧасов, "ЧГ=") + " ч.)");
	КонецЕсли;
	Возврат НСтр("ru = 'нет цены: не указано количество уроков или часов'");

КонецФункции

//Подсказка цены тарифа на дату (история цен или карточка — как урок, ЦенаТарифаНаДату).
Функция ПредставлениеЦеныТарифаНаДату(Тариф, Дата) Экспорт

	Если Не ЗначениеЗаполнено(Тариф) Тогда
		Возврат "";
	КонецЕсли;
	Возврат ПредставлениеЦеныТарифа(ЦенаТарифаНаДату(Тариф, Дата));

КонецФункции

//Сумма всего тарифа на дату (цена пакета «N ₽ за K уроков»), 0 — цены нет. Для ПКО «По тарифу»: прежде ПКО брал
//сумму карточки без даты — у тарифа с историей цен 0 или устаревшую цену.
Функция СуммаТарифаНаДату(Тариф, Дата) Экспорт

	Цена = ЦенаТарифаНаДату(Тариф, ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса()));
	Возврат ?(Цена = Неопределено, 0, Цена.Сумма);

КонецФункции

//Цена единицы тарифа на дату — для остатка «N уроков / N ч» (карточка ученика, панель): Структура(Цена, Единица),
//Единица "ур." / "ч."; Неопределено — цены нет или тариф бесплатный.
Функция ЦенаЕдиницыТарифа(Тариф, Дата) Экспорт

	Цена = ЦенаТарифаНаДату(Тариф, ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса()));
	Если Цена = Неопределено Или Цена.Сумма = 0 Тогда
		Возврат Неопределено;
	ИначеЕсли Цена.КоличествоУроков > 0 Тогда
		Возврат Новый Структура("Цена, Единица", Цена.Сумма / Цена.КоличествоУроков, "ур.");
	ИначеЕсли ЧасовУрока(Цена.КоличествоЧасов) > 0 Тогда
		Возврат Новый Структура("Цена, Единица", Цена.Сумма / ЧасовУрока(Цена.КоличествоЧасов), "ч.");
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

//В20 (решение владельца 28.09.2026): тариф строки ученика по умолчанию — индивидуальный тариф ученика
//(личная договорённость важнее общей), иначе тариф группы, иначе тариф урока. Одна функция для формы урока,
//помощника уроков и панели ученика (прежде у панели тариф группы был важнее личного). Абонемент строки ещё
//важнее тарифа — это уже цена (ЦенаСтрокиУрока).
Функция ТарифСтрокиУченика(Ученик, ГруппаОбучения = Неопределено, ТарифУрока = Неопределено) Экспорт

	Тариф = ТарифНовойСтроки(Ученик, ГруппаОбучения, ТарифУрока);
	Возврат ?(ЗначениеЗаполнено(Тариф), Тариф, Справочники.УЗ_Тарифы.ПустаяСсылка());

КонецФункции

//Цена строки урока — ЕДИНАЯ функция (форма урока, запись и проведение урока, помощник, панель, обработки):
//  1. без «К оплате» — 0 (бесплатное занятие);
//  2. абонемент строки (этого ученика, предмет урока или без предмета, с ценой) — В2: цена абонемента / число
//     занятий, часовой — цена × часы урока / часы абонемента; хвост округления — на последнее занятие (часы):
//     сумма уроков по абонементу = цене абонемента (В25); скидка строки к абонементу НЕ применяется — она уже в
//     цене абонемента (В23, как в типовых: скидка при продаже);
//  3. иначе тариф строки на дату урока (В8): «за уроки» — сумма / уроки, «за часы» — сумма × часы урока / часы
//     (В13: от целых минут); урок 0 ч по часовому тарифу или абонементу — цены нет (В25), не бесплатно;
//     скидка строки — с каждой строки: процент от цены, рубли — со строки (В23), в пределах [0; цена];
//  4. деньги — до копеек (цена, скидка, сумма = цена − скидка); «Использовать округление» — цена и скидка до
//     рубля, сумма — разностью (цена = сумма + скидка всегда).
//Параметры:
//  Стр - строка «Ученики» или Структура: Ученик, Тариф, Абонемент, Скидка, СписатьОплату
//  Урок - объект урока или Структура: Ссылка, Дата, КоличествоЧасов, ПредметОбучения
//  ЦеныАбонементов - Соответствие НомерСтроки → цена по абонементу (Справочники.УЗ_Абонемент.ЦеныСтрокУрока — с
//                    хвостом В25 и ценой проведённого урока); Неопределено — цена занятия без хвоста
//  ИспользоватьОкругление - Булево, Неопределено — из настроек учёта
//Возврат: Структура — Цена, СуммаСкидки, Сумма; Источник ("Бесплатно", "Абонемент", "Тариф", "НетЦены");
//  ТекстОшибки — почему «К оплате» без цены (для отказа проведения) или ""; СкидкаВнеСрока — Булево.
Функция ЦенаСтрокиУрока(Стр, Урок, ЦеныАбонементов = Неопределено, ИспользоватьОкругление = Неопределено) Экспорт

	Итог = Новый Структура("Цена, СуммаСкидки, Сумма, Источник, ТекстОшибки, СкидкаВнеСрока", 0, 0, 0, "Бесплатно", "", Ложь);
	Если ИспользоватьОкругление = Неопределено Тогда
		ИспользоватьОкругление = ИспользоватьОкруглениеЦен();
	КонецЕсли;
	Если Не Стр.СписатьОплату Тогда
		Возврат Итог;
	КонецЕсли;

	НомерСтроки = ?(ЕстьСвойство(Стр, "НомерСтроки"), Стр.НомерСтроки, 1);
	Организация = ?(ЕстьСвойство(Урок, "Организация"), Урок.Организация, Неопределено);
	Если АбонементПодходитКУроку(Стр.Абонемент, Стр.Ученик, Урок.ПредметОбучения, Организация) Тогда
		Абонемент = Стр.Абонемент;
		Если Абонемент.ЦенаАбонемента > 0 И Абонемент.КоличествоЗанятий = 0 И Абонемент.КоличествоЧасов > 0
			И СекундУрока(Урок.КоличествоЧасов) = 0 Тогда
			Итог.Источник = "НетЦены";
			Итог.ТекстОшибки = СтрШаблон(НСтр("ru = 'Строка %1: абонемент «%2» — по часам, а длительность урока 0 ч: списать нечего. Укажите длительность урока или снимите отметку «К оплате»'"),
				НомерСтроки, Абонемент);
			Возврат Итог;
		КонецЕсли;
		Если ЦеныАбонементов <> Неопределено Тогда
			ЦенаПоАбонементу = ЦеныАбонементов[НомерСтроки];
		Иначе
			ЦенаПоАбонементу = Справочники.УЗ_Абонемент.ЦенаЗанятия(Абонемент, Урок.КоличествоЧасов, , ИспользоватьОкругление);
		КонецЕсли;
		Если ЦенаПоАбонементу <> Неопределено Тогда
			Итог.Источник = "Абонемент";
			Итог.Цена = Окр(ЦенаПоАбонементу, 2);
			Итог.Сумма = Итог.Цена;
			Возврат Итог;
		КонецЕсли;
	КонецЕсли;

	Итог.Источник = "Тариф";
	Если Не ЗначениеЗаполнено(Стр.Тариф) Тогда
		Итог.Источник = "НетЦены";
		Итог.ТекстОшибки = СтрШаблон(НСтр("ru = 'Строка %1: ученик %2 отмечен «К оплате», но тариф не указан — цены нет. Укажите тариф или снимите отметку «К оплате»'"),
			НомерСтроки, Стр.Ученик);
		Возврат Итог;
	КонецЕсли;
	ПоТарифу = ЦенаЕдиницыПоТарифу(ЦенаТарифаНаДату(Стр.Тариф, Урок.Дата), Урок.КоличествоЧасов);
	Если ПоТарифу.ТекстОшибки = "урок 0 ч" Тогда
		Итог.Источник = "НетЦены";
		Итог.ТекстОшибки = СтрШаблон(НСтр("ru = 'Строка %1: тариф «%2» — за час, а длительность урока 0 ч: цена 0 молча сделала бы урок бесплатным. Укажите длительность урока или снимите отметку «К оплате»'"),
			НомерСтроки, Стр.Тариф);
		Возврат Итог;
	ИначеЕсли ПоТарифу.ТекстОшибки <> "" Тогда
		Итог.Источник = "НетЦены";
		Итог.ТекстОшибки = ТекстНетЦеныТарифа(Стр.Тариф, Урок.Дата, НомерСтроки);
		Возврат Итог;
	КонецЕсли;

	Итог.Цена = ОкруглитьЦену(ПоТарифу.Цена, ИспользоватьОкругление);
	Если Итог.Цена <> 0 Тогда
		Скидка = СуммаСкидки(Стр.Скидка, Итог.Цена, Урок.Дата);
		Если Скидка = Неопределено Тогда
			Итог.СкидкаВнеСрока = Истина;
		Иначе
			Итог.СуммаСкидки = Мин(ОкруглитьЦену(Скидка, ИспользоватьОкругление), Итог.Цена);
		КонецЕсли;
	КонецЕсли;
	Итог.Сумма = Итог.Цена - Итог.СуммаСкидки;
	Возврат Итог;

КонецФункции

Функция ОкруглитьЦену(Сумма, ДоРубля)
	Возврат ?(ДоРубля, Окр(Сумма), Окр(Сумма, 2));
КонецФункции

Функция ИспользоватьОкруглениеЦен()

	LMНастроки = РегистрыСведений.УЗ_Настройки.Настройки();
	Возврат LMНастроки.Свойство("ИспользоватьОкругление") И LMНастроки.ИспользоватьОкругление = Истина;

КонецФункции

Функция ЕстьСвойство(Значение, Имя)

	Проба = Новый Структура(Имя, Null);
	ЗаполнитьЗначенияСвойств(Проба, Значение);
	Возврат Проба[Имя] <> Null;

КонецФункции

//В13 (решение владельца 28.09.2026): длительность урока — с точностью до минуты. Часы хранятся с 4 знаками
//(40 мин = 0,6667 ч, 50 мин = 0,8333 ч); время, секунды регистра и деньги считаются от целых минут, поэтому
//40 минут — ровно 2 400 секунд и 2/3 часа (1 000 ₽/ч → 666,67 ₽), а не 0,67 ч → 2 412 с и 670 ₽.
//Старые значения с 2 знаками (0,67, 0,83) округляются до тех же минут (40, 50).
Функция СекундУрока(КоличествоЧасов) Экспорт
	Возврат Окр(КоличествоЧасов * 60) * 60;
КонецФункции

//Точная доля часа по целым минутам урока — множитель для цены и оплаты «за час» (деньги потом — до копеек).
Функция ЧасовУрока(КоличествоЧасов) Экспорт
	Возврат Окр(КоличествоЧасов * 60) / 60;
КонецФункции

//Функции абонемента — прослойка к единому месту логики абонементов и заморозок (Справочники.УЗ_Абонемент):
//прежние вызовы (тесты, модули других форм) работают, правило одно.

//Подходит ли абонемент строке урока для цены (Codex A08, В12): ученик, предмет, организация.
Функция АбонементПодходитКУроку(Абонемент, Ученик, ПредметОбучения, Организация = Неопределено) Экспорт
	Возврат ЗначениеЗаполнено(Абонемент)
		И Справочники.УЗ_Абонемент.ОшибкаПринадлежности(Абонемент, Ученик, ПредметОбучения, Организация) = "";
КонецФункции

//В2: цена занятия по абонементу без хвоста В25 (хвост считает ЦеныСтрокУрока при записи урока).
Функция ЦенаУрокаПоАбонементу(Абонемент, КоличествоЧасов) Экспорт
	Возврат Справочники.УЗ_Абонемент.ЦенаЗанятия(Абонемент, КоличествоЧасов);
КонецФункции

Функция ДнейПриостановкиАбонемента(Абонемент) Экспорт
	Возврат Справочники.УЗ_Абонемент.ДнейПриостановки(Абонемент);
КонецФункции

Функция ДатаОкончанияАбонемента(Абонемент) Экспорт
	Возврат Справочники.УЗ_Абонемент.СрокСПродлением(Абонемент);
КонецФункции

Функция АбонементПриостановленНаДату(Абонемент, Дата) Экспорт
	Возврат Справочники.УЗ_Абонемент.ПриостановленНаДату(Абонемент, Дата);
КонецФункции

//Соответствие Ученик → действующий абонемент на Дата (с остатком, Р-4) — Справочники.УЗ_Абонемент.ПодобратьАбонемент.
Функция ДействующиеАбонементы(Ученики, ПредметОбучения, Дата, Организация = Неопределено) Экспорт
	Возврат Справочники.УЗ_Абонемент.ДействующиеАбонементы(Ученики, ПредметОбучения, Дата, Организация);
КонецФункции

//Цены строк учеников — по единой функции ЦенаСтрокиУрока (считаются заново при каждой записи: часы, дата, тариф,
//абонемент могли измениться; ручной цены нет). Сообщать = Ложь — без сообщений (при записи: отказ проведения
//сообщает ОбработкаПроведения). Возврат: Массив из Структура(НомерСтроки, Текст) — строки «К оплате» без цены.
Функция РассчитатьТабличнуюЧасть(Объект, Сообщать = Истина) Экспорт

	ИспользоватьОкругление = ИспользоватьОкруглениеЦен();
	//В2/В25/Р-7: цены строк по абонементу — логика абонементов (хвост округления на последний урок, цена проведённого
	//урока при перепроведении не меняется, абонемент другого ученика, предмета, организации цену не задаёт)
	ЦеныАбонементов = Справочники.УЗ_Абонемент.ЦеныСтрокУрока(Объект, ИспользоватьОкругление);
	БезЦены = Новый Массив;
	Для Каждого Стр из Объект.Ученики Цикл

		Цена = ЦенаСтрокиУрока(Стр, Объект, ЦеныАбонементов, ИспользоватьОкругление);
		Стр.ЦенаТарифа 	= Цена.Цена;
		Стр.СуммаСкидки = Цена.СуммаСкидки;
		Стр.Сумма 		= Цена.Сумма;

		ПутьСтроки = "Ученики[" + Формат(Стр.НомерСтроки - 1, "ЧН=0; ЧГ=") + "]";
		Если Цена.ТекстОшибки <> "" Тогда
			БезЦены.Добавить(Новый Структура("НомерСтроки, Текст", Стр.НомерСтроки, Цена.ТекстОшибки));
			//сообщение — у поля «Тариф» этой строки; остальные строки считаются дальше
			Если Сообщать Тогда
				УЗ_ОбщийКлиентСервер.СообщитьПользователю(Цена.ТекстОшибки, ПутьСтроки + ".Тариф", "Объект");
			КонецЕсли;
		КонецЕсли;
		Если Цена.СкидкаВнеСрока И Сообщать Тогда
			УЗ_ОбщийКлиентСервер.СообщитьПользователю(ТекстСкидкаВнеСрока(Стр.Скидка, Объект.Дата, Стр.НомерСтроки),
				ПутьСтроки + ".Скидка", "Объект");
		КонецЕсли;

	КонецЦикла;
	Возврат БезЦены;

КонецФункции

Функция ПроверитьДокументПоГрафикуРабочегоВремени(Объект) Экспорт
	
	//Проверка урока на график габочего времени педагога
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ГрафикРабочегоВремениПедагога.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УЗ_ГрафикРабочегоВремениПедагога КАК ГрафикРабочегоВремениПедагога
	|ГДЕ
	|	ГрафикРабочегоВремениПедагога.Проведен
	|	И ГрафикРабочегоВремениПедагога.Педагог = &Педагог
	|	И ГрафикРабочегоВремениПедагога.Дата = &Дата";	
	Запрос.УстановитьПараметр("Дата", КонецМесяца(Объект.Дата));
	Запрос.УстановитьПараметр("Педагог", Объект.Педагог); 	
	ГрафикиРабочегоВремени = Запрос.Выполнить().Выгрузить();
	
	Если ГрафикиРабочегоВремени.Количество()>0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ГрафикРабочегоВремениПедагогаТЧ.Дата КАК Дата,
		|	ГрафикРабочегоВремениПедагогаТЧ.ВремяНачала КАК ВремяНачала,
		|	ГрафикРабочегоВремениПедагогаТЧ.ВремяОкончания КАК ВремяОкончания
		|ИЗ
		|	Документ.УЗ_ГрафикРабочегоВремениПедагога.ТЧ КАК ГрафикРабочегоВремениПедагогаТЧ
		|ГДЕ
		|	ГрафикРабочегоВремениПедагогаТЧ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ГрафикРабочегоВремениПедагогаТЧ.ВремяНачала <= &НачалоУрока
		|	И ГрафикРабочегоВремениПедагогаТЧ.ВремяОкончания >= &КонецУрока
		|	И ГрафикРабочегоВремениПедагогаТЧ.Ссылка = &Ссылка";

		Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Объект.Дата));
		Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Объект.Дата));
		Запрос.УстановитьПараметр("Ссылка", ГрафикиРабочегоВремени[0].Ссылка);
		//урок целиком в рабочем интервале: и начало, и конец (прежде проверялся только конец урока — урок,
		//начатый раньше рабочего времени, не предупреждался). Время графика хранится датой 01.01.0001.
		НачалоУрока = '00010101' + (Объект.Дата - НачалоДня(Объект.Дата));
		Запрос.УстановитьПараметр("НачалоУрока", НачалоУрока);
		Запрос.УстановитьПараметр("КонецУрока", НачалоУрока + СекундУрока(Объект.КоличествоЧасов));
		
		СвободныеПериоды = Запрос.Выполнить().Выгрузить();
		
		Если СвободныеПериоды.Количество()>0 Тогда //То есть существует документ ГрафикУчетаРабВремени
			
		Иначе
			ДанныеС = Новый Структура;
			ДанныеС.Вставить("Ссылка",ГрафикиРабочегоВремени[0].Ссылка);
			ДанныеС.Вставить("Педагог",ГрафикиРабочегоВремени[0].Ссылка.Педагог);
			ДанныеС.Вставить("Дата",ГрафикиРабочегоВремени[0].Ссылка.Дата);
			Возврат ДанныеС;
		КонецЕсли;
	КонецЕсли;
	
	//1. Найти все интервалы даты и время Педагога в графике
	//2. Проверить этот урок в интервале   
	Возврат Неопределено;

КонецФункции

//Проведённый урок того же педагога или в том же помещении, интервал которого пересекается с интервалом Объекта:
//чужое начало раньше нашего конца И чужой конец позже нашего начала (ловит и вложенный, и накрывающий урок;
//стык 12:00 после урока до 12:00 — не пересечение). Урок 0 ч занимает 1 секунду.
//Конец чужого урока в запросе — часы × 3 600 минус 30 секунд (В13): часы хранятся с 4 знаками, 40 мин = 0,6667 ч =
//2 400,12 с; начала уроков — ровно минуты, поэтому полминуты допуска не ловят стык и не пропускают пересечение
//на минуту (округление ВЫРАЗИТЬ в запросе у разных СУБД разное — на него не полагаемся).
//Помещение не проверяется, если оно пустое или у него флаг «Не контролировать пересечения».
//Возврат: Структура(Ссылка, Номер, Дата, КоличествоЧасов, Педагог, Помещение, Поле) — Поле "Педагог"/"Помещение" —
//или Неопределено.
//ВключаяЗаписанные — Истина: и записанные планом (непроведённые, не помеченные на удаление) уроки — помощник
//уроков так не создаёт будущий урок поверх чужого (Codex N03); проведение проверяет только проведённые.
Функция ДокументПересекаетсяСДругими(Объект, ВключаяЗаписанные = Ложь) Экспорт

	ПроверятьПедагога 	= ЗначениеЗаполнено(Объект.Педагог);
	ПроверятьПомещение 	= ЗначениеЗаполнено(Объект.Помещение)
		И Не Объект.Помещение.НеКонтролироватьПересечения;
	Если Не ПроверятьПедагога И Не ПроверятьПомещение Тогда
		Возврат Неопределено;
	КонецЕсли;

	Начало 		= Объект.Дата;
	Окончание 	= Объект.Дата + Макс(СекундУрока(Объект.КоличествоЧасов), 1);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Урок.Ссылка КАК Ссылка,
	|	Урок.Номер КАК Номер,
	|	Урок.Дата КАК Дата,
	|	Урок.КоличествоЧасов КАК КоличествоЧасов,
	|	Урок.Педагог КАК Педагог,
	|	Урок.Помещение КАК Помещение,
	|	ВЫБОР
	|		КОГДА &ПроверятьПедагога
	|				И Урок.Педагог = &Педагог
	|			ТОГДА ""Педагог""
	|		ИНАЧЕ ""Помещение""
	|	КОНЕЦ КАК Поле,
	|	ВЫБОР
	|		КОГДА &ПроверятьПедагога
	|				И Урок.Педагог = &Педагог
	|			ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК Порядок
	|ИЗ
	|	Документ.УЗ_Урок КАК Урок
	|ГДЕ
	|	(Урок.Проведен
	|			ИЛИ &ВключаяЗаписанные
	|				И НЕ Урок.ПометкаУдаления)
	|	И Урок.Ссылка <> &Ссылка
	|	И Урок.Дата > &НачалоПоиска
	|	И Урок.Дата < &Окончание
	|	И ДОБАВИТЬКДАТЕ(Урок.Дата, СЕКУНДА, ВЫБОР
	|				КОГДА Урок.КоличествоЧасов > 0
	|					ТОГДА Урок.КоличествоЧасов * 3600 - 30
	|				ИНАЧЕ 1
	|			КОНЕЦ) > &Начало
	|	И (&ПроверятьПедагога
	|				И Урок.Педагог = &Педагог
	|			ИЛИ &ПроверятьПомещение
	|				И Урок.Помещение = &Помещение)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	Дата";
	//сначала пересечение по педагогу, затем по помещению
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("Педагог", Объект.Педагог);
	Запрос.УстановитьПараметр("Помещение", Объект.Помещение);
	Запрос.УстановитьПараметр("ПроверятьПедагога", ПроверятьПедагога);
	Запрос.УстановитьПараметр("ПроверятьПомещение", ПроверятьПомещение);
	Запрос.УстановитьПараметр("ВключаяЗаписанные", ВключаяЗаписанные);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	//урок длиннее суток не бывает — поиск ограничен сутками до начала (индекс по дате)
	Запрос.УстановитьПараметр("НачалоПоиска", Начало - 86400);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура("Ссылка, Номер, Дата, КоличествоЧасов, Педагог, Помещение, Поле");
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	Возврат Результат;

КонецФункции

//Номер документа без лидирующих нулей.
Функция НомерБезНулей(Номер)

	Результат = СокрЛП(Номер);
	Пока СтрНачинаетсяС(Результат, "0") Цикл
		Результат = Сред(Результат, 2);
	КонецЦикла;
	Возврат Результат;

КонецФункции

//Проверки расписания при проведении. Пересечение по педагогу/помещению — отказ с сообщением у поля
//«Педагог»/«Помещение»; выход за график рабочего времени педагога — только предупреждение.
Процедура ПроверкаПересечений(Объект, Отказ = Ложь) Экспорт

	Номер = НомерБезНулей(Объект.Номер);

	Если ЗначениеЗаполнено(Объект.Педагог) Тогда
		ИтогПроверки = ПроверитьДокументПоГрафикуРабочегоВремени(Объект);
		Если ИтогПроверки <> Неопределено Тогда
			ТекстСообщения = "Урок № " + Номер + " от " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy") + " с " + Формат(Объект.Дата, "ДФ=HH:mm") +
			" по " + Формат(Объект.Дата + СекундУрока(Объект.КоличествоЧасов), "ДФ=HH:mm") + " не входит в график учета рабочего времени педагога "
			+ ИтогПроверки.Педагог + " (" + Формат(ИтогПроверки.Дата, "ДФ='ММММ гггг ""г"".'") + ")";
			УЗ_ОбщийКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
	КонецЕсли;

	Пересечение = ДокументПересекаетсяСДругими(Объект);
	Если Пересечение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Пересечение.Поле = "Педагог" Тогда
		Кто = "педагог " + Пересечение.Педагог + " занят";
	Иначе
		Кто = "помещение " + Пересечение.Помещение + " занято";
	КонецЕсли;

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон("Урок № %1 от %2 с %3 по %4 пересекается по времени с уроком № %5 с %6 по %7: %8. Урок не проведён",
		Номер, Формат(Объект.Дата, "ДФ=dd.MM.yyyy"), Формат(Объект.Дата, "ДФ=HH:mm"),
		Формат(Объект.Дата + СекундУрока(Объект.КоличествоЧасов), "ДФ=HH:mm"),
		НомерБезНулей(Пересечение.Номер), Формат(Пересечение.Дата, "ДФ=HH:mm"),
		Формат(Пересечение.Дата + СекундУрока(Пересечение.КоличествоЧасов), "ДФ=HH:mm"), Кто);
	Сообщение.Поле = Пересечение.Поле;
	Сообщение.УстановитьДанные(Объект);
	Сообщение.Сообщить();
	Отказ = Истина;

КонецПроцедуры

#Область ПомощникУроков

//Помощник создания уроков (Codex N03): записать учеников в урок на дату. В существующий урок — только если это
//именно заданный урок: то же начало, группа, педагог, предмет и помещение (прежде группа и педагог в поиске были
//закомментированы — ученик группы Б попадал в урок группы А того же помещения; подходил и любой более короткий урок
//внутри интервала). Такого урока нет — создаётся новый, но не поверх чужого: урок того же педагога, в том же
//помещении или той же группы, пересекающийся по времени (проведённый или записанный планом), — отказ с причиной.
//Проведённый урок при добавлении учеников перепроводится всегда (Codex A01, УЗ_Общий.ЗаписатьУрок).
//
//Параметры:
//  ПараметрыУрока - Структура - Дата (начало урока), КоличествоЧасов, ПредметОбучения, Педагог, Помещение,
//                   ГруппаОбучения; необязательные Статус, Тариф
//  Ученики - Массив из Структура - Ученик и необязательные Тариф, Скидка, СписатьОплату, Явка, Абонемент
//  Провести - Булево - провести урок (не начавшийся только записывается, В10); Ложь — записать без проведения
//
//Возвращаемое значение:
//  Структура - Успех; Урок - ДокументСсылка.УЗ_Урок или Неопределено; Создан - Булево;
//              Строки - Массив из Структура(Описание, Урок) — строки журнала помощника.
Функция ЗаписатьУчениковВУрок(ПараметрыУрока, Ученики, Провести) Экспорт

	Итог = НовыйИтогПомощника();
	Начало = ПараметрыУрока.Дата;
	Найденные = УрокиПомощникаНаДату(ПараметрыУрока);
	Если Найденные.Количество() > 1 Тогда
		Итог.Успех = Ложь;
		ДобавитьСтрокуПомощника(Итог, СтрШаблон(НСтр("ru = 'На %1 уже %2 урока с этими группой, педагогом, предметом и помещением — ученики не добавлены'"),
			Формат(Начало, "ДЛФ=DT"), Найденные.Количество()), Найденные[0].Ссылка);
		Возврат Итог;
	КонецЕсли;

	Если Найденные.Количество() = 1 Тогда
		Найденный = Найденные[0];
		Если СекундУрока(Найденный.КоличествоЧасов) <> СекундУрока(ПараметрыУрока.КоличествоЧасов) Тогда
			Итог.Успех = Ложь;
			ДобавитьСтрокуПомощника(Итог, СтрШаблон(НСтр("ru = 'На %1 уже есть урок № %2 другой длительности (%3 мин, задано %4 мин) — ученики не добавлены'"),
				Формат(Начало, "ДЛФ=DT"), НомерБезНулей(Найденный.Номер), СекундУрока(Найденный.КоличествоЧасов) / 60,
				СекундУрока(ПараметрыУрока.КоличествоЧасов) / 60), Найденный.Ссылка);
			Возврат Итог;
		КонецЕсли;
		Урок = Найденный.Ссылка.ПолучитьОбъект();
	Иначе
		Урок = Документы.УЗ_Урок.СоздатьДокумент();
		Урок.Дата = Начало;
		Урок.КоличествоЧасов = ПараметрыУрока.КоличествоЧасов;
		Урок.ПредметОбучения = ПараметрыУрока.ПредметОбучения;
		Урок.Педагог = ПараметрыУрока.Педагог;
		Урок.Помещение = ПараметрыУрока.Помещение;
		Урок.ГруппаОбучения = ПараметрыУрока.ГруппаОбучения;
		Если ПараметрыУрока.Свойство("Статус") Тогда
			Урок.Статус = ПараметрыУрока.Статус;
		КонецЕсли;
		Если ПараметрыУрока.Свойство("Тариф") Тогда
			Урок.Тариф = ПараметрыУрока.Тариф;
		КонецЕсли;
		//организация — до подбора абонемента (В12: абонемент другой организации строке не подходит)
		Если ПараметрыУрока.Свойство("Организация") И ЗначениеЗаполнено(ПараметрыУрока.Организация) Тогда
			Урок.Организация = ПараметрыУрока.Организация;
		Иначе
			ЗаполнитьЗначенияСвойств(Урок, РегистрыСведений.УЗ_Настройки.Настройки(), "Организация");
		КонецЕсли;
		ЗаполнитьСтавкуПедагога(Урок); //ставка группы, иначе педагога
		ТекстКонфликта = КонфликтНовогоУрокаПомощника(Урок);
		Если ТекстКонфликта <> "" Тогда
			Итог.Успех = Ложь;
			ДобавитьСтрокуПомощника(Итог, ТекстКонфликта);
			Возврат Итог;
		КонецЕсли;
		Итог.Создан = Истина;
	КонецЕсли;

	Добавлено = 0;
	НовыеСтроки = Новый Массив;
	Для Каждого ДанныеУченика Из Ученики Цикл
		Если Не ЗначениеЗаполнено(ДанныеУченика.Ученик) Тогда
			Продолжить;
		КонецЕсли;
		//ученик уже в уроке (или дважды в таблице помощника) — второй строкой не добавляется: двойное списание
		Если Урок.Ученики.Найти(ДанныеУченика.Ученик, "Ученик") <> Неопределено Тогда
			Если Не Итог.Создан Тогда
				ДобавитьСтрокуПомощника(Итог, СтрШаблон(НСтр("ru = 'Ученик %1 уже присутствует в уроке № %2 от %3 с %4 по %5. Пропускаем...'"),
					ДанныеУченика.Ученик, НомерБезНулей(Урок.Номер), Формат(Урок.Дата, "ДФ=dd.MM.yyyy"), Формат(Урок.Дата, "ДФ=HH:mm"),
					Формат(Урок.Дата + СекундУрока(Урок.КоличествоЧасов), "ДФ=HH:mm")), Урок.Ссылка);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		СтрокаУченика = Урок.Ученики.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаУченика, ДанныеУченика);
		НовыеСтроки.Добавить(СтрокаУченика);
		Добавлено = Добавлено + 1;
	КонецЦикла;

	//абонемент — на дату ЭТОГО урока (Р-3, З-7): абонемент из таблицы помощника (на первую дату) остаётся, если
	//действует в этот день и его хватает с учётом уже записанных уроков, иначе — другой действующий или тариф (В16)
	Для Каждого Предупреждение Из Справочники.УЗ_Абонемент.ПодставитьАбонементы(Урок, НовыеСтроки) Цикл
		ДобавитьСтрокуПомощника(Итог, Предупреждение);
	КонецЦикла;

	Если Добавлено = 0 И Не Итог.Создан Тогда
		Итог.Урок = Урок.Ссылка;
		Возврат Итог;
	КонецЕсли;

	Записан = УЗ_Общий.ЗаписатьУрок(Урок, Провести);
	Если ЗначениеЗаполнено(Урок.Ссылка) Тогда
		Итог.Урок = Урок.Ссылка;
	КонецЕсли;
	Если Не Записан.Успех Тогда
		Итог.Успех = Ложь;
		ДобавитьСтрокуПомощника(Итог, ?(Итог.Создан, НСтр("ru = 'Не удалось создать урок! '"),
			НСтр("ru = 'Не удалось записать урок! '")) + Записан.Текст, Итог.Урок);
		Возврат Итог;
	КонецЕсли;
	ДобавитьСтрокуПомощника(Итог, ?(Итог.Создан, НСтр("ru = 'Создан'"), НСтр("ru = 'Выполнено добавление учеников'"))
		+ ?(Записан.Пометка = "", "", " — " + Записан.Пометка), Итог.Урок);
	Возврат Итог;

КонецФункции

//Перевод учеников в урок на дату (страница «Перевод из группы» помощника, Codex Q03): ученики убираются из уроков
//группы ИзГруппы в день урока и записываются в урок ПараметрыУрока (ЗаписатьУчениковВУрок) — в одной транзакции.
//Не записался хоть один урок — не меняется ничего: прежде старые уроки менялись до попытки записать новый, и отказ
//нового урока (нет цены, пересечение) оставлял ученика без занятий.
//Параметры и результат — как у ЗаписатьУчениковВУрок; при отказе Строки — одна строка с причиной.
Функция ПеревестиУчениковВУрок(ПараметрыУрока, ИзГруппы, Ученики, Провести) Экспорт

	Итог = НовыйИтогПомощника();
	НачатьТранзакцию();
	Попытка
		Для Каждого ДанныеУченика Из Ученики Цикл
			Если Не ЗначениеЗаполнено(ДанныеУченика.Ученик) Тогда
				Продолжить;
			КонецЕсли;
			//В22: перевод закрывает старую группу и открывает новую в карточке ученика — в той же транзакции
			//(до записи урока новой группы: у ученика «только выбранные группы» урок иначе откажет)
			ПеревестиВКарточкеУченика(ДанныеУченика.Ученик, ИзГруппы, ПараметрыУрока.ГруппаОбучения, ПараметрыУрока.Дата);
			Для Каждого СсылкаУрока Из УрокиГруппыСУченикомНаДень(ИзГруппы, ДанныеУченика.Ученик, ПараметрыУрока.Дата) Цикл
				Урок = СсылкаУрока.ПолучитьОбъект();
				Для Каждого СтрокаУченика Из Урок.Ученики.НайтиСтроки(Новый Структура("Ученик", ДанныеУченика.Ученик)) Цикл
					Урок.Ученики.Удалить(СтрокаУченика);
				КонецЦикла;
				Если Урок.Ученики.Количество() = 0 Тогда
					Урок.УстановитьПометкуУдаления(Истина);
					ДобавитьСтрокуПомощника(Итог, НСтр("ru = 'Удален урок. Перевод из группы ученика '") + ДанныеУченика.Ученик, СсылкаУрока);
				Иначе
					Записан = УЗ_Общий.ЗаписатьУрок(Урок, Провести);
					Если Не Записан.Успех Тогда
						ВызватьИсключение СтрШаблон(НСтр("ru = 'урок %1 группы %2 не записан: %3'"), СсылкаУрока, ИзГруппы, Записан.Текст);
					КонецЕсли;
					ДобавитьСтрокуПомощника(Итог, НСтр("ru = 'Изменен урок. Перевод из группы ученика '") + ДанныеУченика.Ученик
						+ ?(Записан.Пометка = "", "", " — " + Записан.Пометка), СсылкаУрока);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		ВУрок = ЗаписатьУчениковВУрок(ПараметрыУрока, Ученики, Провести);
		Для Каждого СтрокаЖурнала Из ВУрок.Строки Цикл
			Итог.Строки.Добавить(СтрокаЖурнала);
		КонецЦикла;
		Если Не ВУрок.Успех Тогда
			ВызватьИсключение ВУрок.Строки[ВУрок.Строки.Количество() - 1].Описание;
		КонецЕсли;
		Итог.Урок = ВУрок.Урок;
		Итог.Создан = ВУрок.Создан;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Итог = НовыйИтогПомощника();
		Итог.Успех = Ложь;
		ДобавитьСтрокуПомощника(Итог, СтрШаблон(НСтр("ru = 'Перевод на %1 отменён, прежние уроки не изменены: %2'"),
			Формат(ПараметрыУрока.Дата, "ДЛФ=DT"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Возврат Итог;

КонецФункции

Функция НовыйИтогПомощника()
	Возврат Новый Структура("Успех, Урок, Создан, Строки", Истина, Неопределено, Ложь, Новый Массив);
КонецФункции

Процедура ДобавитьСтрокуПомощника(Итог, Описание, Урок = Неопределено)
	Итог.Строки.Добавить(Новый Структура("Описание, Урок", Описание, Урок));
КонецПроцедуры

//Непомеченные на удаление уроки (проведённые и записанные планом) ровно с заданными началом, группой, педагогом,
//предметом и помещением.
Функция УрокиПомощникаНаДату(ПараметрыУрока)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Урок.Ссылка КАК Ссылка,
	|	Урок.Номер КАК Номер,
	|	Урок.КоличествоЧасов КАК КоличествоЧасов
	|ИЗ
	|	Документ.УЗ_Урок КАК Урок
	|ГДЕ
	|	НЕ Урок.ПометкаУдаления
	|	И Урок.Дата = &Дата
	|	И Урок.ГруппаОбучения = &ГруппаОбучения
	|	И Урок.Педагог = &Педагог
	|	И Урок.ПредметОбучения = &ПредметОбучения
	|	И Урок.Помещение = &Помещение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Урок.Проведен УБЫВ";
	Запрос.УстановитьПараметр("Дата", ПараметрыУрока.Дата);
	Запрос.УстановитьПараметр("ГруппаОбучения", ПараметрыУрока.ГруппаОбучения);
	Запрос.УстановитьПараметр("Педагог", ПараметрыУрока.Педагог);
	Запрос.УстановитьПараметр("ПредметОбучения", ПараметрыУрока.ПредметОбучения);
	Запрос.УстановитьПараметр("Помещение", ПараметрыУрока.Помещение);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

//Почему новый урок помощника нельзя записать поверх других: урок того же педагога или в том же помещении
//(ДокументПересекаетсяСДругими, включая записанные планом) либо урок той же группы, пересекающийся по времени.
//Возврат: текст отказа или "".
Функция КонфликтНовогоУрокаПомощника(Урок)

	Пересечение = ДокументПересекаетсяСДругими(Урок, Истина);
	Если Пересечение <> Неопределено Тогда
		Если Пересечение.Поле = "Педагог" Тогда
			Кто = СтрШаблон(НСтр("ru = 'педагог %1 занят'"), Пересечение.Педагог);
		Иначе
			Кто = СтрШаблон(НСтр("ru = 'помещение %1 занято'"), Пересечение.Помещение);
		КонецЕсли;
		Возврат СтрШаблон(НСтр("ru = 'Урок на %1 не создан: %2 уроком № %3 с %4 по %5'"), Формат(Урок.Дата, "ДЛФ=DT"), Кто,
			НомерБезНулей(Пересечение.Номер), Формат(Пересечение.Дата, "ДФ=HH:mm"),
			Формат(Пересечение.Дата + СекундУрока(Пересечение.КоличествоЧасов), "ДФ=HH:mm"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Урок.ГруппаОбучения) Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Урок.Номер КАК Номер,
	|	Урок.Дата КАК Дата,
	|	Урок.КоличествоЧасов КАК КоличествоЧасов,
	|	Урок.Педагог КАК Педагог,
	|	Урок.ПредметОбучения КАК ПредметОбучения,
	|	Урок.Помещение КАК Помещение
	|ИЗ
	|	Документ.УЗ_Урок КАК Урок
	|ГДЕ
	|	НЕ Урок.ПометкаУдаления
	|	И Урок.ГруппаОбучения = &ГруппаОбучения
	|	И Урок.Дата > &НачалоПоиска
	|	И Урок.Дата < &Окончание
	|	И ДОБАВИТЬКДАТЕ(Урок.Дата, СЕКУНДА, ВЫБОР
	|				КОГДА Урок.КоличествоЧасов > 0
	|					ТОГДА Урок.КоличествоЧасов * 3600 - 30
	|				ИНАЧЕ 1
	|			КОНЕЦ) > &Начало
	|
	|УПОРЯДОЧИТЬ ПО
	|	Урок.Дата";
	Запрос.УстановитьПараметр("ГруппаОбучения", Урок.ГруппаОбучения);
	Запрос.УстановитьПараметр("Начало", Урок.Дата);
	Запрос.УстановитьПараметр("Окончание", Урок.Дата + Макс(СекундУрока(Урок.КоличествоЧасов), 1));
	Запрос.УстановитьПараметр("НачалоПоиска", Урок.Дата - 86400);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Урок на %1 не создан: у группы %2 уже есть урок № %3 с %4 по %5 (педагог %6, предмет %7, помещение %8) — задайте те же педагога, предмет, помещение и время, чтобы добавить учеников в него'"),
		Формат(Урок.Дата, "ДЛФ=DT"), Урок.ГруппаОбучения, НомерБезНулей(Выборка.Номер), Формат(Выборка.Дата, "ДФ=HH:mm"),
		Формат(Выборка.Дата + СекундУрока(Выборка.КоличествоЧасов), "ДФ=HH:mm"), Выборка.Педагог, Выборка.ПредметОбучения,
		Выборка.Помещение);

КонецФункции

//Непомеченные на удаление уроки группы в день Дата, где есть ученик.
Функция УрокиГруппыСУченикомНаДень(ГруппаОбучения, Ученик, Дата)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УрокУченики.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УЗ_Урок.Ученики КАК УрокУченики
	|ГДЕ
	|	УрокУченики.Ученик = &Ученик
	|	И НЕ УрокУченики.Ссылка.ПометкаУдаления
	|	И УрокУченики.Ссылка.ГруппаОбучения = &ГруппаОбучения
	|	И УрокУченики.Ссылка.Дата МЕЖДУ &Начало И &Окончание";
	Запрос.УстановитьПараметр("ГруппаОбучения", ГруппаОбучения);
	Запрос.УстановитьПараметр("Ученик", Ученик);
	Запрос.УстановитьПараметр("Начало", НачалоДня(Дата));
	Запрос.УстановитьПараметр("Окончание", КонецДня(Дата));
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

//В21 (решение владельца 28.09.2026): время и длительность урока группы в день — из расписания дня недели группы;
//общее время и «Продолжительность» — только если у дня нет своего времени. Одна функция для формы урока,
//помощника (создание, продление, перевод) и панели ученика.
//Возврат: Структура(Начало — дата и время начала урока, КоличествоЧасов) или Неопределено — день не отмечен в
//расписании группы (в этот день группа не занимается).
Функция РасписаниеГруппыНаДень(ГруппаОбучения, День) Экспорт

	Если Не ЗначениеЗаполнено(ГруппаОбучения) Или Не ЗначениеЗаполнено(День) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Префикс = СтрРазделить("ПН,ВТ,СР,ЧТ,ПТ,СБ,ВС", ",")[ДеньНедели(День) - 1];
	Если ГруппаОбучения[Префикс] <> Истина Тогда
		Возврат Неопределено;
	КонецЕсли;
	ВремяС = ГруппаОбучения[Префикс + "Время"];
	ВремяПо = ГруппаОбучения[Префикс + "Время2"];
	Если ЗначениеЗаполнено(ВремяС) И ЗначениеЗаполнено(ВремяПо) И ВремяПо > ВремяС Тогда
		Часов = (ВремяПо - ВремяС) / 3600;
	Иначе
		Часов = (ГруппаОбучения.Продолжительность - НачалоДня(ГруппаОбучения.Продолжительность)) / 3600;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВремяС) Тогда
		ВремяС = ГруппаОбучения.Время;
	КонецЕсли;
	Возврат Новый Структура("Начало, КоличествоЧасов", НачалоДня(День) + (ВремяС - НачалоДня(ВремяС)), Часов);

КонецФункции

//Дни занятий группы по расписанию (РасписаниеГруппыНаДень) за Дней дней с даты Начало включительно — массив дат
//(начало дня). «Создать уроки на неделю» помощника первого запуска: помощник создания уроков, открытый с параметром
//ГруппаОбучения, выделяет в календаре ровно эти дни (тест tools\тесты\тест_первый_запуск.py).
Функция ДатыЗанятийГруппы(ГруппаОбучения, Начало, Дней = 7) Экспорт

	Даты = Новый Массив;
	Если Не ЗначениеЗаполнено(ГруппаОбучения) Тогда
		Возврат Даты;
	КонецЕсли;
	День = НачалоДня(Начало);
	Для НомерДня = 1 По Дней Цикл
		Если РасписаниеГруппыНаДень(ГруппаОбучения, День) <> Неопределено Тогда
			Даты.Добавить(День);
		КонецЕсли;
		День = День + 86400;
	КонецЦикла;
	Возврат Даты;

КонецФункции

//В20 (решение владельца 28.09.2026): тариф новой строки ученика — тариф ученика (индивидуальная договорённость),
//иначе тариф группы, иначе ТарифПоУмолчанию (тариф урока/помощника). Абонемент строки главнее любого тарифа
//(РассчитатьТабличнуюЧасть). Одинаково в форме урока, помощнике, панели ученика и продлении группы.
Функция ТарифНовойСтроки(Ученик, ГруппаОбучения = Неопределено, ТарифПоУмолчанию = Неопределено) Экспорт

	Если ЗначениеЗаполнено(Ученик) И ЗначениеЗаполнено(Ученик.Тариф) Тогда
		Возврат Ученик.Тариф;
	ИначеЕсли ЗначениеЗаполнено(ГруппаОбучения) И ЗначениеЗаполнено(ГруппаОбучения.Тариф) Тогда
		Возврат ГруппаОбучения.Тариф;
	КонецЕсли;
	Возврат ТарифПоУмолчанию;

КонецФункции

//В22 (решение владельца 28.09.2026, как «кадровый перевод» в типовых): перевод ученика из группы в группу с
//даты ДатаПеревода закрывает строку старой группы в карточке ученика (окончание — день перед переводом) и
//открывает строку новой (начало — день перевода). Повтор на следующие даты того же перевода ничего не меняет;
//дата раньше уже записанной — сдвигает её. Строка старой группы, начатая с даты перевода или позже, удаляется.
Процедура ПеревестиВКарточкеУченика(Ученик, ИзГруппы, ВГруппу, ДатаПеревода) Экспорт

	Если Не ЗначениеЗаполнено(Ученик) Или Не ЗначениеЗаполнено(ВГруппу) Или ИзГруппы = ВГруппу Тогда
		Возврат;
	КонецЕсли;
	День = НачалоДня(ДатаПеревода);
	Карточка = Ученик.ПолучитьОбъект();
	Изменена = Ложь;

	Если ЗначениеЗаполнено(ИзГруппы) Тогда
		Для Каждого СтрокаГруппы Из Карточка.ГруппыОбучения.НайтиСтроки(Новый Структура("ГруппаОбучения", ИзГруппы)) Цикл
			Если ЗначениеЗаполнено(СтрокаГруппы.ДатаНачала) И НачалоДня(СтрокаГруппы.ДатаНачала) >= День Тогда
				Карточка.ГруппыОбучения.Удалить(СтрокаГруппы);
				Изменена = Истина;
			ИначеЕсли Не ЗначениеЗаполнено(СтрокаГруппы.ДатаОкончания) Или НачалоДня(СтрокаГруппы.ДатаОкончания) >= День Тогда
				СтрокаГруппы.ДатаОкончания = День - 86400;
				Изменена = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Открыта = Ложь;
	Для Каждого СтрокаГруппы Из Карточка.ГруппыОбучения.НайтиСтроки(Новый Структура("ГруппаОбучения", ВГруппу)) Цикл
		Если (Не ЗначениеЗаполнено(СтрокаГруппы.ДатаНачала) Или НачалоДня(СтрокаГруппы.ДатаНачала) <= День)
			И (Не ЗначениеЗаполнено(СтрокаГруппы.ДатаОкончания) Или НачалоДня(СтрокаГруппы.ДатаОкончания) >= День) Тогда
			Открыта = Истина;
		ИначеЕсли Не Открыта И НачалоДня(СтрокаГруппы.ДатаНачала) > День И Не ЗначениеЗаполнено(СтрокаГруппы.ДатаОкончания) Тогда
			СтрокаГруппы.ДатаНачала = День;
			Открыта = Истина;
			Изменена = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Не Открыта Тогда
		НоваяСтрока = Карточка.ГруппыОбучения.Добавить();
		НоваяСтрока.ГруппаОбучения = ВГруппу;
		НоваяСтрока.ДатаНачала = День;
		Изменена = Истина;
	КонецЕсли;

	Если Изменена Тогда
		Карточка.Записать();
	КонецЕсли;

КонецПроцедуры

//«Продление группы» помощника: на каждую дату — урок группы по её расписанию дня (В21) с составом группы НА ДАТУ
//урока (R16 ревью 28.09, единое правило состава В18/В22 — Справочники.УЗ_ФизЛица.СоставГруппыНаДату: строка группы
//в карточке действует на дату, выбывший не подбирается), тарифом по В20 и абонементом на дату урока
//(ЗаписатьУчениковВУрок: проверки конфликтов, В10, подстановка абонемента). Ученики последнего урока группы без
//единой строки этой группы в карточке (старые данные — записывали только в уроки) остаются, если не выбыли; у
//последнего урока берутся и настройки строки ученика (тариф, скидка, «К оплате»). Прежде копировался последний
//урок: ушедший ученик получал уроки (и списания) чужой группы, принятый — ни одного. День, в который у группы уже
//есть урок, пропускается; у группы нет ни урока, ни состава — строка журнала вместо ошибки выполнения (Р9).
//Возврат: Массив из Структура(Описание, Урок) — строки журнала помощника.
Функция ПродлитьГруппу(ГруппаОбучения, Даты, Провести = Истина) Экспорт

	Строки = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Урок.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УЗ_Урок КАК Урок
	|ГДЕ
	|	НЕ Урок.ПометкаУдаления
	|	И Урок.ГруппаОбучения = &ГруппаОбучения
	|
	|УПОРЯДОЧИТЬ ПО
	|	Урок.Дата УБЫВ";
	Запрос.УстановитьПараметр("ГруппаОбучения", ГруппаОбучения);
	Выборка = Запрос.Выполнить().Выбрать();
	//строки последнего урока: настройки ученика (тариф, скидка, «К оплате»)
	ИзПоследнего = Новый Соответствие;
	ПорядокПоследнего = Новый Массив;
	Если Выборка.Следующий() Тогда
		Для Каждого СтрУченик Из Выборка.Ссылка.Ученики Цикл
			Если ЗначениеЗаполнено(СтрУченик.Ученик) И ИзПоследнего[СтрУченик.Ученик] = Неопределено Тогда
				ИзПоследнего.Вставить(СтрУченик.Ученик, Новый Структура("Ученик, Тариф, Скидка, СписатьОплату",
					СтрУченик.Ученик, ТарифНовойСтроки(СтрУченик.Ученик, ГруппаОбучения, СтрУченик.Тариф),
					СтрУченик.Скидка, СтрУченик.СписатьОплату));
				ПорядокПоследнего.Добавить(СтрУченик.Ученик);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	БезКарточки = УченикиБезСтрокиГруппы(ГруппаОбучения, ПорядокПоследнего);

	Для Каждого ДатаКалендаря Из Даты Цикл
		День = ?(ТипЗнч(ДатаКалендаря) = Тип("ЭлементСпискаЗначений"), ДатаКалендаря.Значение, ДатаКалендаря);
		Уже = УрокиГруппыНаДень(ГруппаОбучения, День);
		Если Уже.Количество() > 0 Тогда
			Строки.Добавить(Новый Структура("Описание, Урок", "На " + Формат(День, "ДФ='dd.MM.yyyy'") + " у "
				+ ГруппаОбучения + " уже есть " + Уже[0] + ". Пропускаем...", Уже[0]));
			Продолжить;
		КонецЕсли;
		Расписание = РасписаниеГруппыНаДень(ГруппаОбучения, День);
		Если Расписание = Неопределено Тогда
			Строки.Добавить(Новый Структура("Описание, Урок", СтрШаблон(НСтр("ru = '%1: в этот день группа %2 по расписанию не занимается — пропущено'"),
				Формат(День, "ДФ='dd.MM.yyyy'"), ГруппаОбучения), Неопределено));
			Продолжить;
		КонецЕсли;
		Ученики = Новый Массив;
		Для Каждого Ученик Из Справочники.УЗ_ФизЛица.СоставГруппыНаДату(ГруппаОбучения, Расписание.Начало) Цикл
			Строка = ИзПоследнего[Ученик];
			Ученики.Добавить(?(Строка <> Неопределено, Строка, Новый Структура("Ученик, Тариф, Скидка, СписатьОплату",
				Ученик, ТарифНовойСтроки(Ученик, ГруппаОбучения), Справочники.УЗ_Скидки.ПустаяСсылка(), Истина)));
		КонецЦикла;
		Для Каждого Ученик Из БезКарточки Цикл
			Ученики.Добавить(ИзПоследнего[Ученик]);
		КонецЦикла;
		Если Ученики.Количество() = 0 Тогда
			Строки.Добавить(Новый Структура("Описание, Урок", СтрШаблон(НСтр("ru = '%1: в группе %2 на эту дату нет учеников (ни урока группы, ни строки группы в карточках) — пропущено'"),
				Формат(День, "ДФ='dd.MM.yyyy'"), ГруппаОбучения), Неопределено));
			Продолжить;
		КонецЕсли;
		ПараметрыУрока = Новый Структура("Дата, КоличествоЧасов, ПредметОбучения, Педагог, Помещение, ГруппаОбучения",
			Расписание.Начало, Расписание.КоличествоЧасов, ГруппаОбучения.ПредметОбучения, ГруппаОбучения.Педагог,
			ГруппаОбучения.Помещение, ГруппаОбучения);
		Итог = ЗаписатьУчениковВУрок(ПараметрыУрока, Ученики, Провести);
		Для Каждого СтрокаЖурнала Из Итог.Строки Цикл
			Строки.Добавить(Новый Структура("Описание, Урок", СтрокаЖурнала.Описание + НСтр("ru = '. Продление группы'"),
				СтрокаЖурнала.Урок));
		КонецЦикла;
	КонецЦикла;
	Возврат Строки;

КонецФункции

//Ученики из списка (по порядку), у которых в карточке нет ни одной строки этой группы (записывали только в уроки —
//старые данные), не выбывшие и не помеченные на удаление: при продлении они остаются в уроках группы.
Функция УченикиБезСтрокиГруппы(ГруппаОбучения, Ученики)

	Итог = Новый Массив;
	Если Ученики.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Ученики.Ссылка КАК Ученик
	|ИЗ
	|	Справочник.УЗ_ФизЛица КАК Ученики
	|ГДЕ
	|	Ученики.Ссылка В (&Ученики)
	|	И НЕ Ученики.Выбыл
	|	И НЕ Ученики.ПометкаУдаления
	|	И НЕ Ученики.Ссылка В
	|				(ВЫБРАТЬ
	|					Группы.Ссылка
	|				ИЗ
	|					Справочник.УЗ_ФизЛица.ГруппыОбучения КАК Группы
	|				ГДЕ
	|					Группы.ГруппаОбучения = &ГруппаОбучения)";
	Запрос.УстановитьПараметр("Ученики", Ученики);
	Запрос.УстановитьПараметр("ГруппаОбучения", ГруппаОбучения);
	Подходят = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Подходят.Вставить(Выборка.Ученик, Истина);
	КонецЦикла;
	Для Каждого Ученик Из Ученики Цикл
		Если Подходят[Ученик] = Истина Тогда
			Итог.Добавить(Ученик);
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

//Непомеченные на удаление уроки группы в день (любые — проведённые и записанные планом).
Функция УрокиГруппыНаДень(ГруппаОбучения, День)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Урок.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УЗ_Урок КАК Урок
	|ГДЕ
	|	Урок.Дата МЕЖДУ &Начало И &Окончание
	|	И Урок.ГруппаОбучения = &ГруппаОбучения
	|	И НЕ Урок.ПометкаУдаления";
	Запрос.УстановитьПараметр("ГруппаОбучения", ГруппаОбучения);
	Запрос.УстановитьПараметр("Начало", НачалоДня(День));
	Запрос.УстановитьПараметр("Окончание", КонецДня(День));
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

#КонецОбласти
