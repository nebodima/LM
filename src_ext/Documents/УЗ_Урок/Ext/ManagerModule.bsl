
Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Номер = Данные.Номер;
	Пока Лев(Номер, 1) = "0" Цикл 
		Номер = Прав(Номер, СтрДлина(Номер) - 1);
	КонецЦикла;

	Представление = "Урок " +Номер+ " от " +Формат(Данные.Дата,"ДФ='д.ММ.гг (Ч:мм) (ддд)'")+ " "
	+Данные.Ссылка.ПредметОбучения; 
	
КонецПроцедуры

//B07: ставка педагога урока по умолчанию — из карточки педагога урока. Урок, созданный программно (панель
//ученика, помощник, календарь, обработки), ставку не получал и начислял педагогу 0. Одна функция для всех
//маршрутов: заполняет только пустую ставку (выбранную вручную не трогает); запись нового урока зовёт её сама.
Процедура ЗаполнитьСтавкуПедагога(Объект) Экспорт

	Если ЗначениеЗаполнено(Объект.СтавкаПедагога) Или Не ЗначениеЗаполнено(Объект.Педагог) Тогда
		Возврат;
	КонецЕсли;
	Объект.СтавкаПедагога = Объект.Педагог.СтавкаПедагога;

КонецПроцедуры

Процедура ПересчитатьНачисленияПедагога(Объект) Экспорт
	        	
	ВремСтараяТЗ = Объект.НачисленияПедагогу.Выгрузить();
	
	Объект.НачисленияПедагогу.Очистить();
	
	Ставка = Объект.СтавкаПедагога;
	
	//В6 (решение владельца 28.09.2026): урок без единой явки не считается проведённым — «за занятие» и «за час»
	//не начисляются; «с человека» — по явке; «% с оплаты» — от суммы оплаты учеников (оплаченная неявка тоже)
	КоличествоЯвок = 0;
	КоличествоОплат = 0;
	Для Каждого СтрУч из Объект.Ученики Цикл
		Если СтрУч.Явка Тогда
			КоличествоЯвок = КоличествоЯвок + 1;
		КонецЕсли;
		Если СтрУч.СписатьОплату Тогда
			КоличествоОплат = КоличествоОплат + 1;
		КонецЕсли;
	КонецЦикла;
	
	//«Не изменять» у автоматического начисления (комментарий с «#») — строка остаётся как есть, ставка его не
	//пересчитывает (прежде отметка на пересчёт не влияла: строки с «#» всегда считались заново)
	Зафиксировано = Ложь;
	Для Каждого СтрокаСтаройТЗ Из ВремСтараяТЗ Цикл
		Если СтрокаСтаройТЗ.НеИзменять И СтрНайти(СтрокаСтаройТЗ.Комментарий, "#") > 0 Тогда
			Зафиксировано = Истина;
			НовНачисление = Объект.НачисленияПедагогу.Добавить();
			НовНачисление.СуммаНачисления 	= СтрокаСтаройТЗ.СуммаНачисления;
			НовНачисление.Комментарий 		= СтрокаСтаройТЗ.Комментарий;
			НовНачисление.НеИзменять 		= Истина;
		КонецЕсли;
	КонецЦикла;

	Если НЕ Ставка.Пустая() И НЕ Зафиксировано И СтавкаДействуетНаДату(Ставка, Объект.Дата) Тогда

		СуммаНачисления = 0;
		Если Ставка.ОплатаСЧеловека > 0 Тогда
			СуммаНачисления = КоличествоЯвок * Ставка.ОплатаСЧеловека;
			Комментарий 	= "#ОплатаСЧеловека (" + КоличествоЯвок + " уч.)";
		ИначеЕсли Ставка.ПроцентСОплатыУченика > 0 Тогда
			СуммаНачисления = Объект.Ученики.Итог("Сумма") * Ставка.ПроцентСОплатыУченика / 100;
			Комментарий 	= "#ПроцентСОплатыУченика (" + КоличествоОплат + " уч.)";
		ИначеЕсли Ставка.ОплатаЗаЗанятие > 0 Тогда
			СуммаНачисления = ?(КоличествоЯвок > 0, Ставка.ОплатаЗаЗанятие, 0);
			Комментарий 	= "#ОплатаЗаЗанятие";
		ИначеЕсли Ставка.ОплатаЗаЧас > 0 Тогда
			СуммаНачисления = ?(КоличествоЯвок > 0, Окр(Ставка.ОплатаЗаЧас * ЧасовУрока(Объект.КоличествоЧасов), 2), 0); //В13: от целых минут
			Комментарий 	= "#ОплатаЗаЧас";
		КонецЕсли;
		
		Если СуммаНачисления <> 0 Тогда
			НовНачисление = Объект.НачисленияПедагогу.Добавить();
			НовНачисление.СуммаНачисления 	= СуммаНачисления;
			НовНачисление.Комментарий 		= Комментарий;
		КонецЕсли;
		
	КонецЕсли; 		
	
	// Возвращаем ручные начисления (без пометки "#"). B06: ручная доплата без комментария тоже остаётся —
	// прежде строка без комментария выбрасывалась при каждой записи урока, даже с "Не изменять"; пропускаются
	// только пустые строки (без комментария и без суммы)
	Для Каждого СтрокаСтаройТЗ из ВремСтараяТЗ Цикл		
		Если СтрНайти(СтрокаСтаройТЗ.Комментарий,"#")>0
			Или Не ЗначениеЗаполнено(СтрокаСтаройТЗ.Комментарий) И СтрокаСтаройТЗ.СуммаНачисления = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НовНачисление = Объект.НачисленияПедагогу.Добавить();
		НовНачисление.СуммаНачисления 	= СтрокаСтаройТЗ.СуммаНачисления;
		НовНачисление.Комментарий 		= СтрокаСтаройТЗ.Комментарий;
		НовНачисление.НеИзменять 		= СтрокаСтаройТЗ.НеИзменять; 		
	КонецЦикла; 	
	
КонецПроцедуры

//Действует ли ставка педагога на дату урока: «Действует с» / «по» (границы включительно, пустая — без ограничения).
//Ставка вне срока не начисляет — прежде срок ставки нигде не учитывался.
Функция СтавкаДействуетНаДату(Ставка, Дата) Экспорт

	Если ЗначениеЗаполнено(Ставка.НачалоДействия) И Дата < НачалоДня(Ставка.НачалоДействия) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(Ставка.ОкончаниеДействия) И Дата > КонецДня(Ставка.ОкончаниеДействия) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

//Цена тарифа на дату: Структура(Сумма, КоличествоЧасов, КоличествоУроков) или Неопределено — цены нет.
//Цена всегда на дату урока — последняя запись регистра УЗ_ЦеныТарифов на дату. Р2/В8 (как в типовых): смена
//одной цены в карточке тарифа тоже пишется в регистр с даты (РегистрыСведений.УЗ_ЦеныТарифов.ЗафиксироватьЦенуКарточки),
//поэтому перепроведение старого урока берёт цену его даты, а не новую. Тариф без истории цен, у которого записей
//на дату нет (цену карточки ни разу не меняли), — цена из карточки (так её и показывает представление тарифа).
//Запись с суммой 0 — явно бесплатный тариф: цена есть и равна нулю. Нет цены — урок «К оплате» не проводится.
Функция ЦенаТарифаНаДату(Тариф, Дата) Экспорт

	ЦенаНаДату = РегистрыСведений.УЗ_ЦеныТарифов.ПолучитьСуммуТарифаНаДату(Тариф, Дата);
	Если ЦенаНаДату <> Неопределено Или Тариф.ИспользоватьИсториюЦен Тогда
		Возврат ЦенаНаДату;
	КонецЕсли;

	Если РегистрыСведений.УЗ_ЦеныТарифов.ЦенаКарточкиЗаполнена(Тариф) Тогда
		Возврат Новый Структура("Сумма, КоличествоЧасов, КоличествоУроков",
			Тариф.Сумма, Тариф.КоличествоЧасов, Тариф.КоличествоУроков);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

//Текст отказа для строки учеников, у тарифа которой нет цены на дату урока.
Функция ТекстНетЦеныТарифа(Тариф, Дата, НомерСтроки) Экспорт

	Возврат СтрШаблон("Строка %1: у тарифа «%2» нет цены на %3. Укажите цену в карточке тарифа или снимите отметку «К оплате»",
		НомерСтроки, Тариф, Формат(Дата, "ДЛФ=D"));

КонецФункции

//Сумма скидки строки урока: от 0 до цены (скидка не делает сумму отрицательной).
//Нет скидки или оба коэффициента 0 — 0. Скидка вне срока действия (ПериодДействияС/По, границы включительно) — Неопределено.
Функция СуммаСкидки(Скидка, Цена, Дата) Экспорт

	Если Не ЗначениеЗаполнено(Скидка) Тогда
		Возврат 0;
	КонецЕсли;

	Если ЗначениеЗаполнено(Скидка.ПериодДействияС) И Дата < НачалоДня(Скидка.ПериодДействияС)
		Или ЗначениеЗаполнено(Скидка.ПериодДействияПо) И Дата > КонецДня(Скидка.ПериодДействияПо) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если Скидка.КоэффициентСумма <> 0 Тогда
		Результат = Скидка.КоэффициентСумма;
	ИначеЕсли Скидка.КоэффициентПроцент <> 0 Тогда
		Результат = Цена / 100 * Скидка.КоэффициентПроцент;
	Иначе
		Результат = 0;
	КонецЕсли;

	Возврат Макс(0, Мин(Результат, Цена));

КонецФункции

Функция ТекстСкидкаВнеСрока(Скидка, Дата, НомерСтроки)

	Возврат СтрШаблон("Строка %1: скидка «%2» на %3 не действует (срок действия с %4 по %5) — не применена",
		НомерСтроки, Скидка, Формат(Дата, "ДЛФ=D"),
		?(ЗначениеЗаполнено(Скидка.ПериодДействияС), Формат(Скидка.ПериодДействияС, "ДЛФ=D"), "…"),
		?(ЗначениеЗаполнено(Скидка.ПериодДействияПо), Формат(Скидка.ПериодДействияПо, "ДЛФ=D"), "…"));

КонецФункции

//Цена одного урока по тарифу на дату: уроковый тариф — сумма / число уроков, часовой — пропорционально часам урока.
//Неопределено — у тарифа нет цены на дату.
Функция ЦенаУрокаПоТарифу(Тариф, Дата, КоличествоЧасов) Экспорт
	
	СтруктураЦеныТарифа = ЦенаТарифаНаДату(Тариф, Дата);
	Если СтруктураЦеныТарифа = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли СтруктураЦеныТарифа.КоличествоУроков > 0 Тогда
		Возврат СтруктураЦеныТарифа.Сумма / СтруктураЦеныТарифа.КоличествоУроков;
	ИначеЕсли СтруктураЦеныТарифа.КоличествоЧасов > 0 Тогда
		Возврат СтруктураЦеныТарифа.Сумма * ЧасовУрока(КоличествоЧасов) / СтруктураЦеныТарифа.КоличествоЧасов;
	КонецЕсли;
	Возврат 0;

КонецФункции

//В13 (решение владельца 28.09.2026): длительность урока — с точностью до минуты. Часы хранятся с 4 знаками
//(40 мин = 0,6667 ч, 50 мин = 0,8333 ч); время, секунды регистра и деньги считаются от целых минут, поэтому
//40 минут — ровно 2 400 секунд и 2/3 часа (1 000 ₽/ч → 666,67 ₽), а не 0,67 ч → 2 412 с и 670 ₽.
//Старые значения с 2 знаками (0,67, 0,83) округляются до тех же минут (40, 50).
Функция СекундУрока(КоличествоЧасов) Экспорт
	Возврат Окр(КоличествоЧасов * 60) * 60;
КонецФункции

//Точная доля часа по целым минутам урока — множитель для цены и оплаты «за час» (деньги потом — до копеек).
Функция ЧасовУрока(КоличествоЧасов) Экспорт
	Возврат Окр(КоличествоЧасов * 60) / 60;
КонецФункции

//Подходит ли абонемент строке урока для цены (Codex A08): абонемент этого ученика и того же предмета, что урок
//(абонемент без предмета — на любой предмет). Неподходящий абонемент проведение отклоняет (модуль объекта,
//ПроверитьАбонемент), а цену строка берёт по тарифу — прежде цена чужого предмета попадала в сумму урока.
Функция АбонементПодходитКУроку(Абонемент, Ученик, ПредметОбучения) Экспорт

	Если Не ЗначениеЗаполнено(Абонемент) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Абонемент.ФизЛицо = Ученик
		И (Не ЗначениеЗаполнено(Абонемент.ПредметОбучения) Или Абонемент.ПредметОбучения = ПредметОбучения);

КонецФункции


//В2 (решение владельца 28.09.2026, как в типовых): урок по абонементу стоит ЦенаАбонемента / КоличествоЗанятий,
//часовой абонемент — ЦенаАбонемента × часы урока / КоличествоЧасов. Неопределено — абонемента нет или у него нет
//цены или количества (тогда цена по тарифу).
Функция ЦенаУрокаПоАбонементу(Абонемент, КоличествоЧасов) Экспорт
	
	Если Не ЗначениеЗаполнено(Абонемент) Или Абонемент.ЦенаАбонемента <= 0 Тогда
		Возврат Неопределено;
	ИначеЕсли Абонемент.КоличествоЗанятий > 0 Тогда
		Возврат Абонемент.ЦенаАбонемента / Абонемент.КоличествоЗанятий;
	ИначеЕсли Абонемент.КоличествоЧасов > 0 Тогда
		Возврат Абонемент.ЦенаАбонемента * ЧасовУрока(КоличествоЧасов) / Абонемент.КоличествоЧасов;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции
//В4 (решение владельца 28.09.2026): число дней приостановок абонемента — на них продлевается срок.
//Приостановка — с даты начала включительно по дату возобновления не включая; без даты возобновления
//(бессрочная) срок не продлевает — абонемент приостановлен до возобновления.
Функция ДнейПриостановкиАбонемента(Абонемент) Экспорт

	Дней = 0;
	Для Каждого СтрПриостановка Из Абонемент.Приостановки Цикл
		Если Не ЗначениеЗаполнено(СтрПриостановка.ДатаПриостановки)
			Или Не ЗначениеЗаполнено(СтрПриостановка.ДатаВозобновления) Тогда
			Продолжить;
		КонецЕсли;
		НачалоПриостановки = НачалоДня(СтрПриостановка.ДатаПриостановки);
		Возобновление = НачалоДня(СтрПриостановка.ДатаВозобновления);
		Если Возобновление > НачалоПриостановки Тогда
			Дней = Дней + (Возобновление - НачалоПриостановки) / 86400;
		КонецЕсли;
	КонецЦикла;
	Возврат Дней;

КонецФункции

//Срок абонемента с продлением на дни приостановок (начало дня последнего дня срока); пустая дата — бессрочный.
//Одна функция для урока, помощника уроков и подбора абонемента — срок везде считается одинаково.
Функция ДатаОкончанияАбонемента(Абонемент) Экспорт

	Если Не ЗначениеЗаполнено(Абонемент.ДатаОкончания) Тогда
		Возврат '00010101';
	КонецЕсли;
	Возврат НачалоДня(Абонемент.ДатаОкончания) + ДнейПриостановкиАбонемента(Абонемент) * 86400;

КонецФункции

//Приостановлен ли абонемент на день Дата (с даты приостановки включительно по дату возобновления не включая).
Функция АбонементПриостановленНаДату(Абонемент, Дата) Экспорт

	ДеньУрока = НачалоДня(Дата);
	Для Каждого СтрПриостановка Из Абонемент.Приостановки Цикл
		Если Не ЗначениеЗаполнено(СтрПриостановка.ДатаПриостановки) Тогда
			Продолжить;
		КонецЕсли;
		Если ДеньУрока >= НачалоДня(СтрПриостановка.ДатаПриостановки)
			И (Не ЗначениеЗаполнено(СтрПриостановка.ДатаВозобновления)
				Или ДеньУрока < НачалоДня(СтрПриостановка.ДатаВозобновления)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

//Действующие на Дата абонементы учеников по предмету (или без предмета): активированы, не приостановлены,
//срок с продлением на дни приостановок (ДатаОкончанияАбонемента) не истёк. У ученика несколько — берётся тот,
//что кончается раньше (он первым и расходуется; бессрочный — последним).
//Возврат: Соответствие Ученик → Абонемент (ученика без действующего абонемента в нём нет).
Функция ДействующиеАбонементы(Ученики, ПредметОбучения, Дата) Экспорт

	Результат = Новый Соответствие;
	Если Ученики.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Абонементы.Ссылка КАК Абонемент,
	|	Абонементы.ФизЛицо КАК Ученик
	|ИЗ
	|	Справочник.УЗ_Абонемент КАК Абонементы
	|ГДЕ
	|	Абонементы.ФизЛицо В (&Ученики)
	|	И Абонементы.Активный
	|	И Абонементы.ДатаАктивации <> ДАТАВРЕМЯ(1, 1, 1)
	|	И НЕ Абонементы.ПометкаУдаления
	|	И (Абонементы.ПредметОбучения = &ПредметОбучения
	|			ИЛИ Абонементы.ПредметОбучения = ЗНАЧЕНИЕ(Справочник.УЗ_ПредметыОбучения.ПустаяСсылка))
	|	И Абонементы.ДатаНачала <= &Дата";
	Запрос.УстановитьПараметр("Ученики", Ученики);
	Запрос.УстановитьПараметр("ПредметОбучения", ПредметОбучения);
	Запрос.УстановитьПараметр("Дата", КонецДня(Дата));
	Выборка = Запрос.Выполнить().Выбрать();

	ДеньУрока = НачалоДня(Дата);
	СрокиВыбранных = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Абонемент = Выборка.Абонемент;
		Срок = ДатаОкончанияАбонемента(Абонемент);
		Если ЗначениеЗаполнено(Срок) И Срок < ДеньУрока
			Или АбонементПриостановленНаДату(Абонемент, ДеньУрока) Тогда
			Продолжить;
		КонецЕсли;
		Сравнить = ?(ЗначениеЗаполнено(Срок), Срок, '39991231');
		Прежний = СрокиВыбранных[Выборка.Ученик];
		Если Прежний = Неопределено Или Сравнить < Прежний Тогда
			Результат.Вставить(Выборка.Ученик, Абонемент);
			СрокиВыбранных.Вставить(Выборка.Ученик, Сравнить);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

//Сообщать = Ложь — без сообщений (при записи: отказ проведения сообщает ОбработкаПроведения).
Процедура РассчитатьТабличнуюЧасть(Объект, Сообщать = Истина) Экспорт
	
	LMНастроки = РегистрыСведений.УЗ_Настройки.Настройки();
	Если LMНастроки.Свойство("ИспользоватьОкругление") и LMНастроки.ИспользоватьОкругление Тогда
		ИспользоватьОкругление = Истина;
	Иначе
		ИспользоватьОкругление = Ложь;
	КонецЕсли; 	
	
	Для Каждого Стр из Объект.Ученики Цикл		   
		   
		//«Требовать описание к неоплаченным урокам» — проверка при проведении (ОбработкаПроведения урока)
		
		//цена строки считается заново при каждой записи — часы, дата, тариф, группа могли измениться
		//(поле цены в форме только для чтения, ручной цены нет; прежде считалась только при цене 0)
		Если Не Стр.СписатьОплату Тогда
			Цена = 0;
		Иначе
			//В2: урок по абонементу — цена абонемента / число занятий; абонемент без цены и урок без абонемента — по тарифу
			//абонемент другого ученика или другого предмета цену не задаёт (A08: проведение его отклонит)
			Если АбонементПодходитКУроку(Стр.Абонемент, Стр.Ученик, Объект.ПредметОбучения) Тогда
				Цена = ЦенаУрокаПоАбонементу(Стр.Абонемент, Объект.КоличествоЧасов);
			Иначе
				Цена = Неопределено;
			КонецЕсли;
			Если Цена = Неопределено И Не Стр.Тариф.Пустая() Тогда
				Цена = ЦенаУрокаПоТарифу(Стр.Тариф, Объект.Дата, Объект.КоличествоЧасов);
				Если Цена = Неопределено Тогда
					//сообщение — у поля «Тариф» этой строки; остальные строки считаются дальше
					Если Сообщать Тогда
						УЗ_ОбщийКлиентСервер.СообщитьПользователю(ТекстНетЦеныТарифа(Стр.Тариф, Объект.Дата, Стр.НомерСтроки),
							"Ученики[" + Формат(Стр.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Тариф", "Объект");
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			Если Цена = Неопределено Тогда
				Цена = 0;
			КонецЕсли;
		КонецЕсли;
		
		//деньги — до копеек по правилам 1С (В13): цена 40 мин по 1 000 ₽/ч = 666,67; скидка и сумма от
		//округлённой цены, чтобы цена = сумма + скидка
		Цена = Окр(Цена, 2);
		Стр.ЦенаТарифа = Цена;
		СуммаСкидкиСтроки = ?(Цена = 0, 0, СуммаСкидки(Стр.Скидка, Цена, Объект.Дата));
		Если СуммаСкидкиСтроки <> Неопределено Тогда
			СуммаСкидкиСтроки = Окр(СуммаСкидкиСтроки, 2);
		КонецЕсли;
		Если СуммаСкидкиСтроки = Неопределено Тогда
			Если Сообщать Тогда
				УЗ_ОбщийКлиентСервер.СообщитьПользователю(ТекстСкидкаВнеСрока(Стр.Скидка, Объект.Дата, Стр.НомерСтроки),
					"Ученики[" + Формат(Стр.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Скидка", "Объект");
			КонецЕсли;
			СуммаСкидкиСтроки = 0;
		КонецЕсли;
		Стр.СуммаСкидки = СуммаСкидкиСтроки;
		Стр.Сумма 		= Цена - СуммаСкидкиСтроки;
				Если ИспользоватьОкругление Тогда
			Стр.ЦенаТарифа 		= Окр(Стр.ЦенаТарифа);
			Стр.Сумма 			= Окр(Стр.Сумма);
			Стр.СуммаСкидки 	= Окр(Стр.СуммаСкидки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПроверитьДокументПоГрафикуРабочегоВремени(Объект) Экспорт
	
	//Проверка урока на график габочего времени педагога
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ГрафикРабочегоВремениПедагога.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УЗ_ГрафикРабочегоВремениПедагога КАК ГрафикРабочегоВремениПедагога
	|ГДЕ
	|	ГрафикРабочегоВремениПедагога.Проведен
	|	И ГрафикРабочегоВремениПедагога.Педагог = &Педагог
	|	И ГрафикРабочегоВремениПедагога.Дата = &Дата";	
	Запрос.УстановитьПараметр("Дата", КонецМесяца(Объект.Дата));
	Запрос.УстановитьПараметр("Педагог", Объект.Педагог); 	
	ГрафикиРабочегоВремени = Запрос.Выполнить().Выгрузить();
	
	Если ГрафикиРабочегоВремени.Количество()>0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ГрафикРабочегоВремениПедагогаТЧ.Дата КАК Дата,
		|	ГрафикРабочегоВремениПедагогаТЧ.ВремяНачала КАК ВремяНачала,
		|	ГрафикРабочегоВремениПедагогаТЧ.ВремяОкончания КАК ВремяОкончания
		|ИЗ
		|	Документ.УЗ_ГрафикРабочегоВремениПедагога.ТЧ КАК ГрафикРабочегоВремениПедагогаТЧ
		|ГДЕ
		|	ГрафикРабочегоВремениПедагогаТЧ.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|	И ГрафикРабочегоВремениПедагогаТЧ.ВремяНачала <= &НачалоУрока
		|	И ГрафикРабочегоВремениПедагогаТЧ.ВремяОкончания >= &КонецУрока
		|	И ГрафикРабочегоВремениПедагогаТЧ.Ссылка = &Ссылка";

		Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(Объект.Дата));
		Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(Объект.Дата));
		Запрос.УстановитьПараметр("Ссылка", ГрафикиРабочегоВремени[0].Ссылка);
		//урок целиком в рабочем интервале: и начало, и конец (прежде проверялся только конец урока — урок,
		//начатый раньше рабочего времени, не предупреждался). Время графика хранится датой 01.01.0001.
		НачалоУрока = '00010101' + (Объект.Дата - НачалоДня(Объект.Дата));
		Запрос.УстановитьПараметр("НачалоУрока", НачалоУрока);
		Запрос.УстановитьПараметр("КонецУрока", НачалоУрока + СекундУрока(Объект.КоличествоЧасов));
		
		СвободныеПериоды = Запрос.Выполнить().Выгрузить();
		
		Если СвободныеПериоды.Количество()>0 Тогда //То есть существует документ ГрафикУчетаРабВремени
			
		Иначе
			ДанныеС = Новый Структура;
			ДанныеС.Вставить("Ссылка",ГрафикиРабочегоВремени[0].Ссылка);
			ДанныеС.Вставить("Педагог",ГрафикиРабочегоВремени[0].Ссылка.Педагог);
			ДанныеС.Вставить("Дата",ГрафикиРабочегоВремени[0].Ссылка.Дата);
			Возврат ДанныеС;
		КонецЕсли;
	КонецЕсли;
	
	//1. Найти все интервалы даты и время Педагога в графике
	//2. Проверить этот урок в интервале   
	Возврат Неопределено;

КонецФункции

//Проведённый урок того же педагога или в том же помещении, интервал которого пересекается с интервалом Объекта:
//чужое начало раньше нашего конца И чужой конец позже нашего начала (ловит и вложенный, и накрывающий урок;
//стык 12:00 после урока до 12:00 — не пересечение). Урок 0 ч занимает 1 секунду.
//Конец чужого урока в запросе — часы × 3 600 минус 30 секунд (В13): часы хранятся с 4 знаками, 40 мин = 0,6667 ч =
//2 400,12 с; начала уроков — ровно минуты, поэтому полминуты допуска не ловят стык и не пропускают пересечение
//на минуту (округление ВЫРАЗИТЬ в запросе у разных СУБД разное — на него не полагаемся).
//Помещение не проверяется, если оно пустое или у него флаг «Не контролировать пересечения».
//Возврат: Структура(Ссылка, Номер, Дата, КоличествоЧасов, Педагог, Помещение, Поле) — Поле "Педагог"/"Помещение" —
//или Неопределено.
//ВключаяЗаписанные — Истина: и записанные планом (непроведённые, не помеченные на удаление) уроки — помощник
//уроков так не создаёт будущий урок поверх чужого (Codex N03); проведение проверяет только проведённые.
Функция ДокументПересекаетсяСДругими(Объект, ВключаяЗаписанные = Ложь) Экспорт

	ПроверятьПедагога 	= ЗначениеЗаполнено(Объект.Педагог);
	ПроверятьПомещение 	= ЗначениеЗаполнено(Объект.Помещение)
		И Не Объект.Помещение.НеКонтролироватьПересечения;
	Если Не ПроверятьПедагога И Не ПроверятьПомещение Тогда
		Возврат Неопределено;
	КонецЕсли;

	Начало 		= Объект.Дата;
	Окончание 	= Объект.Дата + Макс(СекундУрока(Объект.КоличествоЧасов), 1);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Урок.Ссылка КАК Ссылка,
	|	Урок.Номер КАК Номер,
	|	Урок.Дата КАК Дата,
	|	Урок.КоличествоЧасов КАК КоличествоЧасов,
	|	Урок.Педагог КАК Педагог,
	|	Урок.Помещение КАК Помещение,
	|	ВЫБОР
	|		КОГДА &ПроверятьПедагога
	|				И Урок.Педагог = &Педагог
	|			ТОГДА ""Педагог""
	|		ИНАЧЕ ""Помещение""
	|	КОНЕЦ КАК Поле,
	|	ВЫБОР
	|		КОГДА &ПроверятьПедагога
	|				И Урок.Педагог = &Педагог
	|			ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК Порядок
	|ИЗ
	|	Документ.УЗ_Урок КАК Урок
	|ГДЕ
	|	(Урок.Проведен
	|			ИЛИ &ВключаяЗаписанные
	|				И НЕ Урок.ПометкаУдаления)
	|	И Урок.Ссылка <> &Ссылка
	|	И Урок.Дата > &НачалоПоиска
	|	И Урок.Дата < &Окончание
	|	И ДОБАВИТЬКДАТЕ(Урок.Дата, СЕКУНДА, ВЫБОР
	|				КОГДА Урок.КоличествоЧасов > 0
	|					ТОГДА Урок.КоличествоЧасов * 3600 - 30
	|				ИНАЧЕ 1
	|			КОНЕЦ) > &Начало
	|	И (&ПроверятьПедагога
	|				И Урок.Педагог = &Педагог
	|			ИЛИ &ПроверятьПомещение
	|				И Урок.Помещение = &Помещение)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	Дата";
	//сначала пересечение по педагогу, затем по помещению
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("Педагог", Объект.Педагог);
	Запрос.УстановитьПараметр("Помещение", Объект.Помещение);
	Запрос.УстановитьПараметр("ПроверятьПедагога", ПроверятьПедагога);
	Запрос.УстановитьПараметр("ПроверятьПомещение", ПроверятьПомещение);
	Запрос.УстановитьПараметр("ВключаяЗаписанные", ВключаяЗаписанные);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Окончание", Окончание);
	//урок длиннее суток не бывает — поиск ограничен сутками до начала (индекс по дате)
	Запрос.УстановитьПараметр("НачалоПоиска", Начало - 86400);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура("Ссылка, Номер, Дата, КоличествоЧасов, Педагог, Помещение, Поле");
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	Возврат Результат;

КонецФункции

//Номер документа без лидирующих нулей.
Функция НомерБезНулей(Номер)

	Результат = СокрЛП(Номер);
	Пока СтрНачинаетсяС(Результат, "0") Цикл
		Результат = Сред(Результат, 2);
	КонецЦикла;
	Возврат Результат;

КонецФункции

//Проверки расписания при проведении. Пересечение по педагогу/помещению — отказ с сообщением у поля
//«Педагог»/«Помещение»; выход за график рабочего времени педагога — только предупреждение.
Процедура ПроверкаПересечений(Объект, Отказ = Ложь) Экспорт

	Номер = НомерБезНулей(Объект.Номер);

	Если ЗначениеЗаполнено(Объект.Педагог) Тогда
		ИтогПроверки = ПроверитьДокументПоГрафикуРабочегоВремени(Объект);
		Если ИтогПроверки <> Неопределено Тогда
			ТекстСообщения = "Урок № " + Номер + " от " + Формат(Объект.Дата, "ДФ=dd.MM.yyyy") + " с " + Формат(Объект.Дата, "ДФ=HH:mm") +
			" по " + Формат(Объект.Дата + СекундУрока(Объект.КоличествоЧасов), "ДФ=HH:mm") + " не входит в график учета рабочего времени педагога "
			+ ИтогПроверки.Педагог + " (" + Формат(ИтогПроверки.Дата, "ДФ='ММММ гггг ""г"".'") + ")";
			УЗ_ОбщийКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
	КонецЕсли;

	Пересечение = ДокументПересекаетсяСДругими(Объект);
	Если Пересечение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Пересечение.Поле = "Педагог" Тогда
		Кто = "педагог " + Пересечение.Педагог + " занят";
	Иначе
		Кто = "помещение " + Пересечение.Помещение + " занято";
	КонецЕсли;

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтрШаблон("Урок № %1 от %2 с %3 по %4 пересекается по времени с уроком № %5 с %6 по %7: %8. Урок не проведён",
		Номер, Формат(Объект.Дата, "ДФ=dd.MM.yyyy"), Формат(Объект.Дата, "ДФ=HH:mm"),
		Формат(Объект.Дата + СекундУрока(Объект.КоличествоЧасов), "ДФ=HH:mm"),
		НомерБезНулей(Пересечение.Номер), Формат(Пересечение.Дата, "ДФ=HH:mm"),
		Формат(Пересечение.Дата + СекундУрока(Пересечение.КоличествоЧасов), "ДФ=HH:mm"), Кто);
	Сообщение.Поле = Пересечение.Поле;
	Сообщение.УстановитьДанные(Объект);
	Сообщение.Сообщить();
	Отказ = Истина;

КонецПроцедуры

#Область ПомощникУроков

//Помощник создания уроков (Codex N03): записать учеников в урок на дату. В существующий урок — только если это
//именно заданный урок: то же начало, группа, педагог, предмет и помещение (прежде группа и педагог в поиске были
//закомментированы — ученик группы Б попадал в урок группы А того же помещения; подходил и любой более короткий урок
//внутри интервала). Такого урока нет — создаётся новый, но не поверх чужого: урок того же педагога, в том же
//помещении или той же группы, пересекающийся по времени (проведённый или записанный планом), — отказ с причиной.
//Проведённый урок при добавлении учеников перепроводится всегда (Codex A01, УЗ_Общий.ЗаписатьУрок).
//
//Параметры:
//  ПараметрыУрока - Структура - Дата (начало урока), КоличествоЧасов, ПредметОбучения, Педагог, Помещение,
//                   ГруппаОбучения; необязательные Статус, Тариф
//  Ученики - Массив из Структура - Ученик и необязательные Тариф, Скидка, СписатьОплату, Явка, Абонемент
//  Провести - Булево - провести урок (не начавшийся только записывается, В10); Ложь — записать без проведения
//
//Возвращаемое значение:
//  Структура - Успех; Урок - ДокументСсылка.УЗ_Урок или Неопределено; Создан - Булево;
//              Строки - Массив из Структура(Описание, Урок) — строки журнала помощника.
Функция ЗаписатьУчениковВУрок(ПараметрыУрока, Ученики, Провести) Экспорт

	Итог = НовыйИтогПомощника();
	Начало = ПараметрыУрока.Дата;
	Найденные = УрокиПомощникаНаДату(ПараметрыУрока);
	Если Найденные.Количество() > 1 Тогда
		Итог.Успех = Ложь;
		ДобавитьСтрокуПомощника(Итог, СтрШаблон(НСтр("ru = 'На %1 уже %2 урока с этими группой, педагогом, предметом и помещением — ученики не добавлены'"),
			Формат(Начало, "ДЛФ=DT"), Найденные.Количество()), Найденные[0].Ссылка);
		Возврат Итог;
	КонецЕсли;

	Если Найденные.Количество() = 1 Тогда
		Найденный = Найденные[0];
		Если СекундУрока(Найденный.КоличествоЧасов) <> СекундУрока(ПараметрыУрока.КоличествоЧасов) Тогда
			Итог.Успех = Ложь;
			ДобавитьСтрокуПомощника(Итог, СтрШаблон(НСтр("ru = 'На %1 уже есть урок № %2 другой длительности (%3 мин, задано %4 мин) — ученики не добавлены'"),
				Формат(Начало, "ДЛФ=DT"), НомерБезНулей(Найденный.Номер), СекундУрока(Найденный.КоличествоЧасов) / 60,
				СекундУрока(ПараметрыУрока.КоличествоЧасов) / 60), Найденный.Ссылка);
			Возврат Итог;
		КонецЕсли;
		Урок = Найденный.Ссылка.ПолучитьОбъект();
	Иначе
		Урок = Документы.УЗ_Урок.СоздатьДокумент();
		Урок.Дата = Начало;
		Урок.КоличествоЧасов = ПараметрыУрока.КоличествоЧасов;
		Урок.ПредметОбучения = ПараметрыУрока.ПредметОбучения;
		Урок.Педагог = ПараметрыУрока.Педагог;
		Урок.Помещение = ПараметрыУрока.Помещение;
		Урок.ГруппаОбучения = ПараметрыУрока.ГруппаОбучения;
		Если ПараметрыУрока.Свойство("Статус") Тогда
			Урок.Статус = ПараметрыУрока.Статус;
		КонецЕсли;
		Если ПараметрыУрока.Свойство("Тариф") Тогда
			Урок.Тариф = ПараметрыУрока.Тариф;
		КонецЕсли;
		Если ЗначениеЗаполнено(Урок.Педагог) Тогда
			Урок.СтавкаПедагога = Урок.Педагог.СтавкаПедагога;
		КонецЕсли;
		ТекстКонфликта = КонфликтНовогоУрокаПомощника(Урок);
		Если ТекстКонфликта <> "" Тогда
			Итог.Успех = Ложь;
			ДобавитьСтрокуПомощника(Итог, ТекстКонфликта);
			Возврат Итог;
		КонецЕсли;
		Итог.Создан = Истина;
	КонецЕсли;

	Добавлено = 0;
	Для Каждого ДанныеУченика Из Ученики Цикл
		Если Не ЗначениеЗаполнено(ДанныеУченика.Ученик) Тогда
			Продолжить;
		КонецЕсли;
		//ученик уже в уроке (или дважды в таблице помощника) — второй строкой не добавляется: двойное списание
		Если Урок.Ученики.Найти(ДанныеУченика.Ученик, "Ученик") <> Неопределено Тогда
			Если Не Итог.Создан Тогда
				ДобавитьСтрокуПомощника(Итог, СтрШаблон(НСтр("ru = 'Ученик %1 уже присутствует в уроке № %2 от %3 с %4 по %5. Пропускаем...'"),
					ДанныеУченика.Ученик, НомерБезНулей(Урок.Номер), Формат(Урок.Дата, "ДФ=dd.MM.yyyy"), Формат(Урок.Дата, "ДФ=HH:mm"),
					Формат(Урок.Дата + СекундУрока(Урок.КоличествоЧасов), "ДФ=HH:mm")), Урок.Ссылка);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		СтрокаУченика = Урок.Ученики.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаУченика, ДанныеУченика);
		Добавлено = Добавлено + 1;
	КонецЦикла;

	Если Добавлено = 0 И Не Итог.Создан Тогда
		Итог.Урок = Урок.Ссылка;
		Возврат Итог;
	КонецЕсли;

	Записан = УЗ_Общий.ЗаписатьУрок(Урок, Провести);
	Если ЗначениеЗаполнено(Урок.Ссылка) Тогда
		Итог.Урок = Урок.Ссылка;
	КонецЕсли;
	Если Не Записан.Успех Тогда
		Итог.Успех = Ложь;
		ДобавитьСтрокуПомощника(Итог, ?(Итог.Создан, НСтр("ru = 'Не удалось создать урок! '"),
			НСтр("ru = 'Не удалось записать урок! '")) + Записан.Текст, Итог.Урок);
		Возврат Итог;
	КонецЕсли;
	ДобавитьСтрокуПомощника(Итог, ?(Итог.Создан, НСтр("ru = 'Создан'"), НСтр("ru = 'Выполнено добавление учеников'"))
		+ ?(Записан.Пометка = "", "", " — " + Записан.Пометка), Итог.Урок);
	Возврат Итог;

КонецФункции

//Перевод учеников в урок на дату (страница «Перевод из группы» помощника, Codex Q03): ученики убираются из уроков
//группы ИзГруппы в день урока и записываются в урок ПараметрыУрока (ЗаписатьУчениковВУрок) — в одной транзакции.
//Не записался хоть один урок — не меняется ничего: прежде старые уроки менялись до попытки записать новый, и отказ
//нового урока (нет цены, пересечение) оставлял ученика без занятий.
//Параметры и результат — как у ЗаписатьУчениковВУрок; при отказе Строки — одна строка с причиной.
Функция ПеревестиУчениковВУрок(ПараметрыУрока, ИзГруппы, Ученики, Провести) Экспорт

	Итог = НовыйИтогПомощника();
	НачатьТранзакцию();
	Попытка
		Для Каждого ДанныеУченика Из Ученики Цикл
			Если Не ЗначениеЗаполнено(ДанныеУченика.Ученик) Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого СсылкаУрока Из УрокиГруппыСУченикомНаДень(ИзГруппы, ДанныеУченика.Ученик, ПараметрыУрока.Дата) Цикл
				Урок = СсылкаУрока.ПолучитьОбъект();
				Для Каждого СтрокаУченика Из Урок.Ученики.НайтиСтроки(Новый Структура("Ученик", ДанныеУченика.Ученик)) Цикл
					Урок.Ученики.Удалить(СтрокаУченика);
				КонецЦикла;
				Если Урок.Ученики.Количество() = 0 Тогда
					Урок.УстановитьПометкуУдаления(Истина);
					ДобавитьСтрокуПомощника(Итог, НСтр("ru = 'Удален урок. Перевод из группы ученика '") + ДанныеУченика.Ученик, СсылкаУрока);
				Иначе
					Записан = УЗ_Общий.ЗаписатьУрок(Урок, Провести);
					Если Не Записан.Успех Тогда
						ВызватьИсключение СтрШаблон(НСтр("ru = 'урок %1 группы %2 не записан: %3'"), СсылкаУрока, ИзГруппы, Записан.Текст);
					КонецЕсли;
					ДобавитьСтрокуПомощника(Итог, НСтр("ru = 'Изменен урок. Перевод из группы ученика '") + ДанныеУченика.Ученик
						+ ?(Записан.Пометка = "", "", " — " + Записан.Пометка), СсылкаУрока);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		ВУрок = ЗаписатьУчениковВУрок(ПараметрыУрока, Ученики, Провести);
		Для Каждого СтрокаЖурнала Из ВУрок.Строки Цикл
			Итог.Строки.Добавить(СтрокаЖурнала);
		КонецЦикла;
		Если Не ВУрок.Успех Тогда
			ВызватьИсключение ВУрок.Строки[ВУрок.Строки.Количество() - 1].Описание;
		КонецЕсли;
		Итог.Урок = ВУрок.Урок;
		Итог.Создан = ВУрок.Создан;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Итог = НовыйИтогПомощника();
		Итог.Успех = Ложь;
		ДобавитьСтрокуПомощника(Итог, СтрШаблон(НСтр("ru = 'Перевод на %1 отменён, прежние уроки не изменены: %2'"),
			Формат(ПараметрыУрока.Дата, "ДЛФ=DT"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;
	Возврат Итог;

КонецФункции

Функция НовыйИтогПомощника()
	Возврат Новый Структура("Успех, Урок, Создан, Строки", Истина, Неопределено, Ложь, Новый Массив);
КонецФункции

Процедура ДобавитьСтрокуПомощника(Итог, Описание, Урок = Неопределено)
	Итог.Строки.Добавить(Новый Структура("Описание, Урок", Описание, Урок));
КонецПроцедуры

//Непомеченные на удаление уроки (проведённые и записанные планом) ровно с заданными началом, группой, педагогом,
//предметом и помещением.
Функция УрокиПомощникаНаДату(ПараметрыУрока)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Урок.Ссылка КАК Ссылка,
	|	Урок.Номер КАК Номер,
	|	Урок.КоличествоЧасов КАК КоличествоЧасов
	|ИЗ
	|	Документ.УЗ_Урок КАК Урок
	|ГДЕ
	|	НЕ Урок.ПометкаУдаления
	|	И Урок.Дата = &Дата
	|	И Урок.ГруппаОбучения = &ГруппаОбучения
	|	И Урок.Педагог = &Педагог
	|	И Урок.ПредметОбучения = &ПредметОбучения
	|	И Урок.Помещение = &Помещение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Урок.Проведен УБЫВ";
	Запрос.УстановитьПараметр("Дата", ПараметрыУрока.Дата);
	Запрос.УстановитьПараметр("ГруппаОбучения", ПараметрыУрока.ГруппаОбучения);
	Запрос.УстановитьПараметр("Педагог", ПараметрыУрока.Педагог);
	Запрос.УстановитьПараметр("ПредметОбучения", ПараметрыУрока.ПредметОбучения);
	Запрос.УстановитьПараметр("Помещение", ПараметрыУрока.Помещение);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

//Почему новый урок помощника нельзя записать поверх других: урок того же педагога или в том же помещении
//(ДокументПересекаетсяСДругими, включая записанные планом) либо урок той же группы, пересекающийся по времени.
//Возврат: текст отказа или "".
Функция КонфликтНовогоУрокаПомощника(Урок)

	Пересечение = ДокументПересекаетсяСДругими(Урок, Истина);
	Если Пересечение <> Неопределено Тогда
		Если Пересечение.Поле = "Педагог" Тогда
			Кто = СтрШаблон(НСтр("ru = 'педагог %1 занят'"), Пересечение.Педагог);
		Иначе
			Кто = СтрШаблон(НСтр("ru = 'помещение %1 занято'"), Пересечение.Помещение);
		КонецЕсли;
		Возврат СтрШаблон(НСтр("ru = 'Урок на %1 не создан: %2 уроком № %3 с %4 по %5'"), Формат(Урок.Дата, "ДЛФ=DT"), Кто,
			НомерБезНулей(Пересечение.Номер), Формат(Пересечение.Дата, "ДФ=HH:mm"),
			Формат(Пересечение.Дата + СекундУрока(Пересечение.КоличествоЧасов), "ДФ=HH:mm"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Урок.ГруппаОбучения) Тогда
		Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Урок.Номер КАК Номер,
	|	Урок.Дата КАК Дата,
	|	Урок.КоличествоЧасов КАК КоличествоЧасов,
	|	Урок.Педагог КАК Педагог,
	|	Урок.ПредметОбучения КАК ПредметОбучения,
	|	Урок.Помещение КАК Помещение
	|ИЗ
	|	Документ.УЗ_Урок КАК Урок
	|ГДЕ
	|	НЕ Урок.ПометкаУдаления
	|	И Урок.ГруппаОбучения = &ГруппаОбучения
	|	И Урок.Дата > &НачалоПоиска
	|	И Урок.Дата < &Окончание
	|	И ДОБАВИТЬКДАТЕ(Урок.Дата, СЕКУНДА, ВЫБОР
	|				КОГДА Урок.КоличествоЧасов > 0
	|					ТОГДА Урок.КоличествоЧасов * 3600 - 30
	|				ИНАЧЕ 1
	|			КОНЕЦ) > &Начало
	|
	|УПОРЯДОЧИТЬ ПО
	|	Урок.Дата";
	Запрос.УстановитьПараметр("ГруппаОбучения", Урок.ГруппаОбучения);
	Запрос.УстановитьПараметр("Начало", Урок.Дата);
	Запрос.УстановитьПараметр("Окончание", Урок.Дата + Макс(СекундУрока(Урок.КоличествоЧасов), 1));
	Запрос.УстановитьПараметр("НачалоПоиска", Урок.Дата - 86400);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Урок на %1 не создан: у группы %2 уже есть урок № %3 с %4 по %5 (педагог %6, предмет %7, помещение %8) — задайте те же педагога, предмет, помещение и время, чтобы добавить учеников в него'"),
		Формат(Урок.Дата, "ДЛФ=DT"), Урок.ГруппаОбучения, НомерБезНулей(Выборка.Номер), Формат(Выборка.Дата, "ДФ=HH:mm"),
		Формат(Выборка.Дата + СекундУрока(Выборка.КоличествоЧасов), "ДФ=HH:mm"), Выборка.Педагог, Выборка.ПредметОбучения,
		Выборка.Помещение);

КонецФункции

//Непомеченные на удаление уроки группы в день Дата, где есть ученик.
Функция УрокиГруппыСУченикомНаДень(ГруппаОбучения, Ученик, Дата)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УрокУченики.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.УЗ_Урок.Ученики КАК УрокУченики
	|ГДЕ
	|	УрокУченики.Ученик = &Ученик
	|	И НЕ УрокУченики.Ссылка.ПометкаУдаления
	|	И УрокУченики.Ссылка.ГруппаОбучения = &ГруппаОбучения
	|	И УрокУченики.Ссылка.Дата МЕЖДУ &Начало И &Окончание";
	Запрос.УстановитьПараметр("ГруппаОбучения", ГруппаОбучения);
	Запрос.УстановитьПараметр("Ученик", Ученик);
	Запрос.УстановитьПараметр("Начало", НачалоДня(Дата));
	Запрос.УстановитьПараметр("Окончание", КонецДня(Дата));
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

#КонецОбласти
