#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	// Убираем секунды из даты
	Если Дата <> НачалоМинуты(Дата) Тогда
		Дата = НачалоМинуты(Дата);
	КонецЕсли;

	//проведённый урок нельзя «просто записать» с датой в будущем: его движения остались бы
	//на прошлой дате (В10) — сначала отменить проведение (форма делает это сама)
	Если РежимЗаписи = РежимЗаписиДокумента.Запись И Проведен И Дата > ТекущаяДатаСеанса() Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(СтрШаблон(
			"Урок проведён, а его начало (%1) ещё не наступило — отмените проведение, чтобы оставить урок планом.",
			Формат(Дата, "ДФ='dd.MM.yyyy HH:mm'")), "Дата", "Объект", Отказ);
		Возврат;
	КонецЕсли;

	Если ЭтоНовый() и Организация.Пустая() Тогда
		LMНастроки = РегистрыСведений.УЗ_Настройки.Настройки();
		Организация = LMНастроки.Организация;
	КонецЕсли;

	Если НЕ ПометкаУдаления Тогда

		Если НЕ ЗначениеЗаполнено(ЭтотОбъект.АвторДокумента) Тогда
			ЭтотОбъект.АвторДокумента = УЗ_Среда.ТекущийПользователь();
		КонецЕсли;

		Если ЗначениеЗаполнено(ГруппаОбучения) и ПроверкаНаКорректностьВыбраннойГруппыОбучения() Тогда
			Отказ = Истина;
		КонецЕсли;

		//B07: новый урок без ставки (создан панелью, помощником, обработкой) — ставка из карточки педагога
		Если ЭтоНовый() Тогда
			Документы.УЗ_Урок.ЗаполнитьСтавкуПедагога(ЭтотОбъект);
		КонецЕсли;

		//R21 (ревью 28.09): остаток абонементов — под блокировкой ДО расчёта цен строк (ПередЗаписью уже в транзакции
		//записи): хвост округления В25 считается по тому же остатку, что проверит проведение, — два сеанса не
		//посчитают оба урок «не последним» (999,99 вместо 1 000)
		Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			ЗаблокироватьОстаткиАбонементов();
		КонецЕсли;

		//В16: исчерпанный абонемент строки «К оплате» снимается — строка по тарифу с предупреждением;
		//З-6: строка без абонемента у ученика с приостановленным абонементом — предупреждение
		Справочники.УЗ_Абонемент.ПроверитьАбонементыУрока(ЭтотОбъект, РежимЗаписи = РежимЗаписиДокумента.Проведение);

		//цены строк — единая функция Документы.УЗ_Урок.ЦенаСтрокиУрока; строки «К оплате» без цены проведение отклонит
		ДополнительныеСвойства.Вставить("СтрокиБезЦены", Документы.УЗ_Урок.РассчитатьТабличнуюЧасть(ЭтотОбъект, Ложь));

		//В13: длительность — до минуты (часы с 4 знаками, 40 мин = 0,6667 ч); время и секунды — от целых минут
		Окончание = Дата + Документы.УЗ_Урок.СекундУрока(КоличествоЧасов);

		СуммаБонусов 		= Ученики.Итог("СуммаБонусов");
		Сумма 				= Ученики.Итог("Сумма");
		СуммаСкидки 		= Ученики.Итог("СуммаСкидки");
		СуммаДопРасходов 	= Расходы.Итог("Сумма");

	КонецЕсли;

	Если Не ОбменДанными.Загрузка И Не ЭтоНовый() Тогда
		ПроверитьУрокВРасчетеЗарплаты(Отказ, РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Или ПометкаУдаления);
	КонецЕсли;

	//находка 3 третьего аудита Codex: урок — источник бонусов; отмена проведения не изымает потраченные бонусы
	Документы.УЗ_ПриходДенег.ПередЗаписьюДокументаБонусов(ЭтотОбъект, РежимЗаписи, Отказ);

КонецПроцедуры

Процедура ПередУдалением(Отказ)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ПроверитьУрокВРасчетеЗарплаты(Отказ, Истина);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	//дата запрета проверяется подпиской УЗ_ДатаЗапретаПередЗаписью (модуль УЗ_ДатыЗапрета)

	//В10 (решение владельца 28.09.2026, как в типовых): проведённый урок — факт оказанной услуги; раньше начала
	//урок не проводится, будущие уроки — только записанными (план)
	Если Дата > ТекущаяДатаСеанса() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст =
			СтрШаблон("Урок начинается %1 — провести его раньше начала нельзя. Запишите урок без проведения (план) и "
			+ "проведите после занятия",
			Формат(Дата, "ДФ='дд.ММ.гггг ЧЧ:мм'"));
		Сообщение.Поле = "Дата";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	ПроверитьПедагогаИУчеников(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	ЗаблокироватьОстаткиАбонементов();
	ТребоватьЗаметку = ТребоватьЗаметкуКНеоплаченным();
	Если ДополнительныеСвойства.Свойство("СтрокиБезЦены") Тогда
		СтрокиБезЦены = ДополнительныеСвойства.СтрокиБезЦены;
	Иначе
		СтрокиБезЦены = Документы.УЗ_Урок.РассчитатьТабличнуюЧасть(ЭтотОбъект, Ложь);
	КонецЕсли;
	ИспользованоВДокументе = Новый Соответствие; //Абонемент → Структура(Уроков, Секунд) строк выше в этом уроке

	Для Каждого Стр из Ученики Цикл

		//настройка «Требовать описание к неоплаченным урокам» (с даты): строка без «К оплате» — с заметкой
		Если ТребоватьЗаметку И НЕ Стр.СписатьОплату И ПустаяСтрока(Стр.Заметка) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст =
				СтрШаблон("Строка %1: у неоплачиваемого урока ученика %2 не указана заметка (почему урок не к оплате) "
				+ "— так требуют настройки учёта",
				Стр.НомерСтроки, Стр.Ученик);
			Сообщение.Поле = "Ученики[" + Формат(Стр.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Заметка";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;

		Если НЕ Стр.Явка и НЕ Стр.СписатьОплату Тогда
			Продолжить;
		КонецЕсли;

		//скидка вне срока не применена (ЦенаСтрокиУрока) — предупреждение, как в форме; урок проводится
		Если Стр.СписатьОплату И ЗначениеЗаполнено(Стр.Скидка)
			И Документы.УЗ_Урок.СуммаСкидки(Стр.Скидка, 1, Дата) = Неопределено Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = Документы.УЗ_Урок.ТекстСкидкаВнеСрока(Стр.Скидка, Дата, Стр.НомерСтроки);
			Сообщение.Поле = "Ученики[" + Формат(Стр.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Скидка";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
		КонецЕсли;

		//к оплате без цены — не проводим: сумма 0 молча списала бы бесплатный урок. Цены нет (ЦенаСтрокиУрока):
		//нет подходящего абонемента с ценой и тариф пустой, у тарифа нет цены на дату или единицы, урок 0 ч по
		//часовому тарифу или абонементу (В25). Явно бесплатный тариф (запись истории с суммой 0) проводится.
		ТекстБезЦены = ТекстСтрокиБезЦены(СтрокиБезЦены, Стр.НомерСтроки);
		Если Стр.СписатьОплату И ТекстБезЦены <> "" Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстБезЦены;
			Сообщение.Поле = "Ученики[" + Формат(Стр.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Тариф";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;

		//Р7 (решение координатора 28.09.2026, как в типовых): явка без «К оплате» — бесплатное занятие,
		//абонемент (занятия и часы) не расходует; расходует только строка «К оплате» (в т.ч. неявка — В3).
		АбонементСтроки = ?(Стр.СписатьОплату, Стр.Абонемент, Справочники.УЗ_Абонемент.ПустаяСсылка());

		Если ЗначениеЗаполнено(АбонементСтроки) Тогда
			Ответ = ПроверитьАбонемент(Стр, ИспользованоВДокументе);
			Если Ответ <> Неопределено Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = Ответ;
				Сообщение.Поле = "Ученики[" + Формат(Стр.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Абонемент";
				Сообщение.УстановитьДанные(ЭтотОбъект);
				Сообщение.Сообщить();
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;

		//Регистр УЗ_СписанияСуммЗаУроки — Расход на каждую строку с явкой или «К оплате». Смысл ресурсов (знаки
		//согласованы со списанием остатков; справка регистра, docs\логики\урок_и_списание.md):
		//Сумма            +деньги, списанные с ученика (после скидки) —
		//остаток Сумма = деньги ученика (+ аванс, − долг);
		//Часы             +секунды урока на КАЖДОГО ученика (ученико-секунды,
		//от целых минут, В13) — остаток уходит в минус:
		//                   −остаток = использовано секунд (часовой абонемент);
		//  КоличествоУроков −1 на строку — остаток растёт: +остаток = использовано занятий (абонемент по занятиям);
		//  КоличествоЯвок   −1 только при явке — +остаток = число явок.
		//Приход (ПКО) пишет только Сумму.
		Движения.УЗ_СписанияСуммЗаУроки.Записывать = Истина;
		Движение = Движения.УЗ_СписанияСуммЗаУроки.Добавить();
		Движение.ВидДвижения 		= ВидДвиженияНакопления.Расход;
		Движение.Период 	 		= Дата;
		Движение.Клиент 	 		= Стр.Ученик;
		Движение.Педагог 	 		= Педагог;
		Движение.ПредметОбучения 	= ПредметОбучения;
		Движение.Тариф  	 		= Стр.Тариф;
		Движение.Часы 		 		= Документы.УЗ_Урок.СекундУрока(КоличествоЧасов); //в секундах, от целых минут (В13)
		Движение.Сумма  	 		= Стр.Сумма;
		Движение.Скидка  	 		= Стр.Скидка;
		Движение.ГруппаОбучения 	= ГруппаОбучения;
		Движение.Организация 		= Организация;
		Движение.Явка				= Стр.Явка;
		Движение.Абонемент			= АбонементСтроки;
		Движение.КоличествоУроков	= -1;
		Если Стр.Явка Тогда
			Движение.КоличествоЯвок		= -1;
		КонецЕсли;

		Если ЗначениеЗаполнено(Стр.ДисконтнаяКарта) Тогда

			//В24: единые проверки карты при начислении — одна функция с «Начислением бонусов» и ПКО
			//(Документы.УЗ_ПриходДенег.ПроверитьНачислениеБонусов: срок, «Не действует», бонусы ≥ 0); в уроке ещё —
			//карта ученика строки (чужой картой бонусы не начисляются)
			ТекстОшибкиКарты =
				Документы.УЗ_ПриходДенег.ПроверитьНачислениеБонусов(Стр.ДисконтнаяКарта, Дата, Стр.СуммаБонусов);
			Если Не ЗначениеЗаполнено(ТекстОшибкиКарты) И Стр.ДисконтнаяКарта.Владелец <> Стр.Ученик Тогда
				ТекстОшибкиКарты =
					СтрШаблон(НСтр("ru = 'Дисконтная карта «%1» — карта %2, а не %3'"), Стр.ДисконтнаяКарта,
					Стр.ДисконтнаяКарта.Владелец, Стр.Ученик);
			КонецЕсли;
			Если ЗначениеЗаполнено(ТекстОшибкиКарты) Тогда
				Отказ = Истина;
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Строка " + Стр.НомерСтроки + ": " + ТекстОшибкиКарты;
				Сообщение.Поле = "Ученики[" + Формат(Стр.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ДисконтнаяКарта";
				Сообщение.УстановитьДанные(ЭтотОбъект);
				Сообщение.Сообщить();
			КонецЕсли;

			//Регистр УЗ_ДвижениеДисконтныхКарт — Приход: урок НАЧИСЛЯЕТ бонусы на карту (сумма вводится вручную);
			//сумму урока бонусы не уменьшают (оплата бонусами — в ПКО)
			Движения.УЗ_ДвижениеДисконтныхКарт.Записывать = Истина;
			Движение = Движения.УЗ_ДвижениеДисконтныхКарт.Добавить();
			Движение.ВидДвижения 		= ВидДвиженияНакопления.Приход;
			Движение.Период 	 		= Дата;
			Движение.Клиент 	 		= Стр.Ученик;
			Движение.ДисконтнаяКарта	= Стр.ДисконтнаяКарта;
			Движение.СуммаБонусов  	 	= Стр.СуммаБонусов;
			Движение.Организация 		= Организация;
		КонецЕсли;

	КонецЦикла;

	//Регистр УЗ_РасчетыПоЗарплате Приход — начисление по ставке (R24): считается здесь, в уроке не хранится;
	//менеджер пишет движение, но прочитать регистр не может
	Движения.УЗ_РасчетыПоЗарплате.Записывать = Истина;
	Для Каждого Начисление Из Документы.УЗ_Урок.НачисленияПоСтавке(ЭтотОбъект) Цикл
		Движение = Движения.УЗ_РасчетыПоЗарплате.Добавить();
		Движение.ВидДвижения 		= ВидДвиженияНакопления.Приход;
		Движение.Период 	 		= Дата;
		Движение.Педагог 	 		= Педагог;
		Движение.Сумма				= Начисление.Сумма;
		Движение.Организация 		= Организация;
		Движение.Комментарий 		= Начисление.Комментарий;
	КонецЦикла;

	// Регистр УЗ_Расходы Приход
	Для Каждого Стр из Расходы Цикл
		Движения.УЗ_Расходы.Записывать = Истина;
		Движение = Движения.УЗ_Расходы.Добавить();
		Движение.ВидДвижения 		= ВидДвиженияНакопления.Расход;
		Движение.Период 	 		= Дата;
		Движение.Сумма				= Стр.Сумма;
		Движение.Организация 		= Организация;
		Движение.СтатьяЗатрат 		= Стр.СтатьяЗатрат;
	КонецЦикла;

	Документы.УЗ_Урок.ПроверкаПересечений(ЭтотОбъект, Отказ);

	//находка 3 третьего аудита Codex: уменьшение бонусов строки, смена карты — не за счёт уже потраченных бонусов
	Документы.УЗ_ПриходДенег.ПроверитьИзъятиеБонусов(ЭтотОбъект, Движения.УЗ_ДвижениеДисконтныхКарт, Отказ);

	//ставка вне срока «Действует с/по» не начисляет (НачисленияПоСтавке) — предупреждаем
	Если ЗначениеЗаполнено(СтавкаПедагога) И Не Документы.УЗ_Урок.СтавкаДействуетНаДату(СтавкаПедагога, Дата) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст =
			СтрШаблон("Ставка педагога «%1» не действует на %2 — начисление педагогу по ставке не сделано. Выберите "
			+ "действующую ставку",
			СтавкаПедагога, Формат(Дата, "ДЛФ=D"));
		Сообщение.Поле = "СтавкаПедагога";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
	КонецЕсли;

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	АвторДокумента = Неопределено;
	Комментарий    = Неопределено;

	Расходы.Очистить();

	Ученики.Очистить();
	Для Каждого стр из ОбъектКопирования.Ученики Цикл
		НовУч = Ученики.Добавить();
		НовУч.Ученик 			= Стр.Ученик;
		НовУч.Тариф 			= Стр.Тариф;
		НовУч.ДисконтнаяКарта 	= Стр.ДисконтнаяКарта;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(ОбъектКопирования.Организация) Тогда
		LMНастроки = РегистрыСведений.УЗ_Настройки.Настройки();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, LMНастроки);
	КонецЕсли;

	//абонемент копии — действующий на дату нового урока (копия без даты — на сегодня; форма урока подставит
	//заново при смене даты), а не абонемент оригинала, который мог кончиться или исчерпаться
	Справочники.УЗ_Абонемент.ПодставитьАбонементы(ЭтотОбъект);

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если ЭтоНовый() Тогда
		LMНастроки = РегистрыСведений.УЗ_Настройки.Настройки();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, LMНастроки);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//Тест тексты_отказов (29.09.2026): проведённый урок — факт занятия; без педагога и без учеников он проводился молча
//и ничего не учитывал (ни зарплаты, ни списаний, пересечения педагога не проверялись), а в отчётах по педагогам давал
//пустую строку. План без учеников (В30) — записанный урок, его это не касается.
Процедура ПроверитьПедагогаИУчеников(Отказ)

	Если НЕ ЗначениеЗаполнено(Педагог) Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Укажите педагога, который провёл урок.'"), "Педагог",
			Отказ);
	КонецЕсли;
	Если Ученики.Количество() = 0 Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
			НСтр("ru = 'В уроке нет учеников — добавьте их или запишите урок без проведения (план).'"), "Ученики",
			Отказ);
	КонецЕсли;

КонецПроцедуры

//В9 (как в типовых: «документ использован в ведомости»): урок, вошедший в проведённый расчёт зарплаты, нельзя
//отменить, пометить на удаление, удалить и перепровести с другим начислением педагогу (педагог, организация,
//дата, суммы и строки начислений) — иначе долг педагогу в регистре расходится с ведомостью, а разница никогда не
//попадёт в новый расчёт (урок из расчётов исключается целиком). Перепроведение и запись без изменения начислений
//(правка комментария, темы, явки ученика без влияния на ставку) — можно. Сначала отменяют проведение расчёта.
//R02 (ревью 28.09): изменение начисления проверяется при ЛЮБОЙ записи, не только при перепроведении — прежде
//«просто записать» сохраняло в документе 300 вместо 500 (регистр и ведомость — 500), а следующее перепроведение
//сравнивало уже 300 с 300 и проходило.
Процедура ПроверитьУрокВРасчетеЗарплаты(Отказ, Отмена)

	Расчет = Документы.УЗ_Урок.РасчетЗарплатыСУроком(Ссылка);
	Если Расчет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Отмена Тогда
		Действие = НСтр("ru = 'отменить проведение, пометить на удаление или удалить'");
	ИначеЕсли НачисленияИзменились() Тогда
		Действие = НСтр(
			"ru = 'записать или перепровести с другим начислением педагогу (педагог, организация, дата, суммы "
			+ "начислений)'");
	Иначе
		Возврат;
	КонецЕсли;
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст =
		СтрШаблон(НСтр(
		"ru = 'Урок использован в расчёте зарплаты № %1 от %2 (педагог %3) — его нельзя %4. Сначала отмените "
		+ "проведение расчёта зарплаты.'"),
		Расчет.Номер, Формат(Расчет.Дата, "ДЛФ=D"), Ссылка.Педагог, Действие);
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	Отказ = Истина;

КонецПроцедуры

//Отличается ли начисление педагогу (как его запишет проведение) от начисления записанного урока. Урок начисление не
//хранит (R24), поэтому обе стороны считает одна функция НачисленияПоСтавке — по уроку в базе и по записываемому:
//педагог, организация, дата, ставка, явки, часы и оплата учеников. Регистр менеджеру не виден.
Функция НачисленияИзменились()

	Прежний = Ссылка;
	Было = Новый Массив;
	Для Каждого Начисление Из Документы.УЗ_Урок.НачисленияПоСтавке(Прежний) Цикл
		Было.Добавить(
			КлючНачисления(Прежний.Дата, Прежний.Педагог, Прежний.Организация, Начисление.Комментарий,
			Начисление.Сумма));
	КонецЦикла;
	Стало = Новый Массив;
	Для Каждого Начисление Из Документы.УЗ_Урок.НачисленияПоСтавке(ЭтотОбъект) Цикл
		Стало.Добавить(КлючНачисления(Дата, Педагог, Организация, Начисление.Комментарий, Начисление.Сумма));
	КонецЦикла;
	Возврат СтрСоединить(Было, Символы.ПС) <> СтрСоединить(Стало, Символы.ПС);

КонецФункции

Функция КлючНачисления(Период, ПедагогНачисления, ОрганизацияНачисления, КомментарийНачисления, Сумма)
	Возврат Формат(Период, "ДФ=yyyyMMddHHmmss") + "|" + XMLСтрока(ПедагогНачисления) + "|"
		+ XMLСтрока(ОрганизацияНачисления)
		+ "|" + КомментарийНачисления + "|" + Формат(Сумма, "ЧДЦ=2; ЧГ=; ЧН=0");
КонецФункции

//Текст отказа строки «К оплате» без цены (из РассчитатьТабличнуюЧасть) или "".
Функция ТекстСтрокиБезЦены(СтрокиБезЦены, НомерСтроки)

	Для Каждого БезЦены Из СтрокиБезЦены Цикл
		Если БезЦены.НомерСтроки = НомерСтроки Тогда
			Возврат БезЦены.Текст;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

//Настройка учёта «Требовать описание к неоплаченным урокам» действует на дату урока (с даты «…С» или всегда).
Функция ТребоватьЗаметкуКНеоплаченным()

	Настройки = РегистрыСведений.УЗ_Настройки.Настройки();
	Если Не Настройки.ТребоватьОписаниеКНеоплаченнымУрокам Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Не ЗначениеЗаполнено(Настройки.ТребоватьОписаниеКНеоплаченнымУрокамС)
		Или НачалоДня(Дата) >= НачалоДня(Настройки.ТребоватьОписаниеКНеоплаченнымУрокамС);

КонецФункции

//Исключительная управляемая блокировка остатков абонементов урока до чтения остатка: два сеанса не
//израсходуют одно последнее занятие. (Файловая база и без неё сериализует проведения — нужна клиент-серверной.)
Процедура ЗаблокироватьОстаткиАбонементов()

	Блокировка = Новый БлокировкаДанных;
	Заблокированные = Новый Соответствие;
	Для Каждого Стр Из Ученики Цикл
		Если Стр.СписатьОплату И ЗначениеЗаполнено(Стр.Абонемент)
			И Заблокированные[Стр.Абонемент] = Неопределено Тогда
			ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.УЗ_СписанияСуммЗаУроки");
			ЭлементБлокировки.УстановитьЗначение("Абонемент", Стр.Абонемент);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Заблокированные.Вставить(Стр.Абонемент, Истина);
		КонецЕсли;
	КонецЦикла;

	Если Заблокированные.Количество() > 0 Тогда
		Блокировка.Заблокировать();
	КонецЕсли;

КонецПроцедуры

//Можно ли списать занятие строки Стр с абонемента. Возврат: текст отказа или Неопределено.
//Правила — единые функции абонемента (Справочники.УЗ_Абонемент): принадлежность (ученик, предмет — Codex A08,
//организация — В12), действие на день урока (помечен на удаление, активен, приостановка и срок с продлением — В4),
//остаток. Исчерпанный абонемент строку сюда не доводит: перед записью его снимает ПроверитьАбонементыУрока (В16),
//здесь остаток читается второй раз под блокировкой — гонка двух сеансов за последнее занятие даёт отказ.
//ИспользованоВДокументе — Соответствие Абонемент → Структура(Уроков, Секунд, Сумма): прежние уроки и строки выше.
Функция ПроверитьАбонемент(Стр, ИспользованоВДокументе)

	Абонемент = Стр.Абонемент;
	ГдеСтрока = " (строка " + Формат(Стр.НомерСтроки, "ЧГ=") + ")";

	Причина = Справочники.УЗ_Абонемент.ОшибкаПринадлежности(Абонемент, Стр.Ученик, ПредметОбучения, Организация);
	Если Причина = "" Тогда
		Причина = Справочники.УЗ_Абонемент.ОшибкаДействия(Абонемент, Дата, Стр.Ученик);
	КонецЕсли;
	Если Причина <> "" Тогда
		Возврат Причина + ГдеСтрока;
	КонецЕсли;

	Использовано = ИспользованоВДокументе[Абонемент];
	Если Использовано = Неопределено Тогда
		Использовано = Справочники.УЗ_Абонемент.Использовано(Абонемент, Ссылка);
		ИспользованоВДокументе.Вставить(Абонемент, Использовано);
	КонецЕсли;
	Если Не Справочники.УЗ_Абонемент.ХватаетНаУрок(Абонемент, Использовано, КоличествоЧасов) Тогда
		Остаток = Справочники.УЗ_Абонемент.ОстатокАбонемента(Абонемент, Использовано);
		Возврат "Не хватает " + ?(Остаток.ПоЧасам, "часов", "занятий") + " по абонементу " + Абонемент + ": "
			+ Остаток.Текст + ГдеСтрока;
	КонецЕсли;

	Использовано.Уроков = Использовано.Уроков + 1;
	Использовано.Секунд = Использовано.Секунд + Документы.УЗ_Урок.СекундУрока(КоличествоЧасов);

	Возврат Неопределено;

КонецФункции

//Ученик с «Только выбранные группы обучения» — член группы урока на дату урока: единое правило «в группе на дату» —
//регистр состава групп (В29, РегистрыСведений.УЗ_СоставГрупп.ПричинаПоИстории), история всех таких учеников урока —
//одним запросом.
Функция ПроверкаНаКорректностьВыбраннойГруппыОбучения()

	Проверяемые = Новый Массив;
	Для Каждого Стр из Ученики Цикл
		Если Стр.Ученик.ТолькоВыбранныеГруппыОбучения И Проверяемые.Найти(Стр.Ученик) = Неопределено Тогда
			Проверяемые.Добавить(Стр.Ученик);
		КонецЕсли;
	КонецЦикла;
	Если Проверяемые.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Группы = Новый Массив;
	Группы.Добавить(ГруппаОбучения);
	История = РегистрыСведений.УЗ_СоставГрупп.ИсторияПар(Проверяемые, Группы);

	ЕстьОграничения = Ложь;
	Для Каждого Ученик Из Проверяемые Цикл
		Причина = РегистрыСведений.УЗ_СоставГрупп.ПричинаПоИстории(История, Ученик, ГруппаОбучения, Дата);
		Если Не ПустаяСтрока(Причина) Тогда
			Сообщить(""+Ссылка+ " для ученика " +Ученик+ ": " + Причина + "!");
			ЕстьОграничения = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат ЕстьОграничения;

КонецФункции

#КонецОбласти
