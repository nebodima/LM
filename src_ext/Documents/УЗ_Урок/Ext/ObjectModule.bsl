Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	// Убираем секунды из даты
	Если Дата <> НачалоМинуты(Дата) Тогда
		Дата = НачалоМинуты(Дата);
	КонецЕсли;
		
	Если ЭтоНовый() и Организация.Пустая() Тогда		
		LMНастроки = РегистрыСведений.УЗ_Настройки.Настройки();
		Организация = LMНастроки.Организация;
	КонецЕсли;

	Если НЕ ПометкаУдаления Тогда
		
		Если НЕ ЗначениеЗаполнено(ЭтотОбъект.АвторДокумента) Тогда
			ЭтотОбъект.АвторДокумента = УЗ_Среда.ТекущийПользователь();
		КонецЕсли;     	
		
		Если ЗначениеЗаполнено(ГруппаОбучения) и ПроверкаНаКорректностьВыбраннойГруппыОбучения() Тогда
			Отказ = Истина;
		КонецЕсли;
		
		//B07: новый урок без ставки (создан панелью, помощником, обработкой) — ставка из карточки педагога
		Если ЭтоНовый() Тогда
			Документы.УЗ_Урок.ЗаполнитьСтавкуПедагога(ЭтотОбъект);
		КонецЕсли;

		Документы.УЗ_Урок.РассчитатьТабличнуюЧасть(ЭтотОбъект, Ложь);
				
		//В13: длительность — до минуты (часы с 4 знаками, 40 мин = 0,6667 ч); время и секунды — от целых минут
		Окончание = Дата + Документы.УЗ_Урок.СекундУрока(КоличествоЧасов);
		
		Документы.УЗ_Урок.ПересчитатьНачисленияПедагога(ЭтотОбъект);
		
		НачисленоПедагогу 	= НачисленияПедагогу.Итог("СуммаНачисления");
		СуммаБонусов 		= Ученики.Итог("СуммаБонусов");
		Сумма 				= Ученики.Итог("Сумма");
		СуммаСкидки 		= Ученики.Итог("СуммаСкидки");
		СуммаДопРасходов 	= Расходы.Итог("Сумма");
				
	КонецЕсли;	
		
КонецПроцедуры

Функция ДокументПересекаетсяСДругими()                               	
	Возврат Документы.УЗ_Урок.ДокументПересекаетсяСДругими(ЭтотОбъект);	
КонецФункции     

Функция ПроверитьДокументПоГрафикуРабочегоВремени()                                 	
	Возврат Документы.УЗ_Урок.ПроверитьДокументПоГрафикуРабочегоВремени(ЭтотОбъект);	
КонецФункции

Процедура ОбработкаПроведения(Отказ, Режим)
	
	//дата запрета проверяется подпиской УЗ_ДатаЗапретаПередЗаписью (модуль УЗ_ДатыЗапрета)
	
	//В10 (решение владельца 28.09.2026, как в типовых): проведённый урок — факт оказанной услуги; раньше начала
	//урок не проводится, будущие уроки — только записанными (план)
	Если Дата > ТекущаяДатаСеанса() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон("Урок начинается %1 — провести его раньше начала нельзя. Запишите урок без проведения (план) и проведите после занятия",
			Формат(Дата, "ДФ='дд.ММ.гггг ЧЧ:мм'"));
		Сообщение.Поле = "Дата";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ЗаблокироватьОстаткиАбонементов();
	ТребоватьЗаметку = ТребоватьЗаметкуКНеоплаченным();
	ИспользованоВДокументе = Новый Соответствие; //Абонемент → Структура(Уроков, Секунд) строк выше в этом уроке
	
	Для Каждого Стр из Ученики Цикл
		
		//настройка «Требовать описание к неоплаченным урокам» (с даты): строка без «К оплате» — с заметкой
		Если ТребоватьЗаметку И НЕ Стр.СписатьОплату И ПустаяСтрока(Стр.Заметка) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Строка %1: у неоплачиваемого урока ученика %2 не указана заметка (почему урок не к оплате) — так требуют настройки учёта",
				Стр.НомерСтроки, Стр.Ученик);
			Сообщение.Поле = "Ученики[" + Формат(Стр.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Заметка";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;

		Если НЕ Стр.Явка и НЕ Стр.СписатьОплату Тогда
			Продолжить;
		КонецЕсли;

		//к оплате без цены — не проводим: сумма 0 молча списала бы бесплатный урок. Цены нет, если нет цены
		//абонемента (В2) и тариф пустой или у тарифа нет цены на дату (явно бесплатный тариф — запись истории
		//цен с суммой 0 — проводится). Прежде пустой тариф проверку пропускал.
		Если Стр.СписатьОплату
			И Документы.УЗ_Урок.ЦенаУрокаПоАбонементу(Стр.Абонемент, КоличествоЧасов) = Неопределено
			И (Не ЗначениеЗаполнено(Стр.Тариф)
				Или Документы.УЗ_Урок.ЦенаТарифаНаДату(Стр.Тариф, Дата) = Неопределено) Тогда
			Сообщение = Новый СообщениеПользователю;
			Если ЗначениеЗаполнено(Стр.Тариф) Тогда
				Сообщение.Текст = Документы.УЗ_Урок.ТекстНетЦеныТарифа(Стр.Тариф, Дата, Стр.НомерСтроки);
			Иначе
				Сообщение.Текст = СтрШаблон("Строка %1: ученик %2 отмечен «К оплате», но тариф не указан — цены нет. Укажите тариф или снимите отметку «К оплате»",
					Стр.НомерСтроки, Стр.Ученик);
			КонецЕсли;
			Сообщение.Поле = "Ученики[" + Формат(Стр.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Тариф";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;

		//Р7 (решение координатора 28.09.2026, как в типовых): явка без «К оплате» — бесплатное занятие,
		//абонемент (занятия и часы) не расходует; расходует только строка «К оплате» (в т.ч. неявка — В3).
		АбонементСтроки = ?(Стр.СписатьОплату, Стр.Абонемент, Справочники.УЗ_Абонемент.ПустаяСсылка());

		Если ЗначениеЗаполнено(АбонементСтроки) Тогда
			Ответ = ПроверитьАбонемент(Стр, ИспользованоВДокументе);
			Если Ответ <> Неопределено Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = Ответ;
				Сообщение.Поле = "Ученики[" + Формат(Стр.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Абонемент";
				Сообщение.УстановитьДанные(ЭтотОбъект);
				Сообщение.Сообщить();
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;

		// Регистр СписанияСуммЗаУроки Расход 		
		Движения.УЗ_СписанияСуммЗаУроки.Записывать = Истина;
		Движение = Движения.УЗ_СписанияСуммЗаУроки.Добавить();
		Движение.ВидДвижения 		= ВидДвиженияНакопления.Расход;
		Движение.Период 	 		= Дата;
		Движение.Клиент 	 		= Стр.Ученик;
		Движение.Педагог 	 		= Педагог;
		Движение.ПредметОбучения 	= ПредметОбучения;
		Движение.Тариф  	 		= Стр.Тариф;
		Движение.Часы 		 		= Документы.УЗ_Урок.СекундУрока(КоличествоЧасов); //в секундах, от целых минут (В13)
		Движение.Сумма  	 		= Стр.Сумма;
		Движение.Скидка  	 		= Стр.Скидка;
		Движение.ГруппаОбучения 	= ГруппаОбучения;
		Движение.Организация 		= Организация;
		Движение.Явка				= Стр.Явка;
		Движение.Абонемент			= АбонементСтроки;
		Движение.КоличествоУроков	= -1;
		Если Стр.Явка Тогда
			Движение.КоличествоЯвок		= -1;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Стр.ДисконтнаяКарта) Тогда
			
			//срок карты — одинаково с ПКО (Документы.УЗ_ПриходДенег.ПроверитьСрокДисконтнойКарты)
			ТекстОшибкиКарты = Документы.УЗ_ПриходДенег.ПроверитьСрокДисконтнойКарты(Стр.ДисконтнаяКарта, Дата);
			Если ЗначениеЗаполнено(ТекстОшибкиКарты) Тогда
				Отказ = Истина;
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Строка " + Стр.НомерСтроки + ": " + ТекстОшибкиКарты;
				Сообщение.Поле = "Ученики[" + Формат(Стр.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ДисконтнаяКарта";
				Сообщение.УстановитьДанные(ЭтотОбъект);
				Сообщение.Сообщить();
			КонецЕсли;
			
			// Регистр ДвижениеДисконтныхКарт Расход 		
			Движения.УЗ_ДвижениеДисконтныхКарт.Записывать = Истина;
			Движение = Движения.УЗ_ДвижениеДисконтныхКарт.Добавить();
			Движение.ВидДвижения 		= ВидДвиженияНакопления.Приход;
			Движение.Период 	 		= Дата;
			Движение.Клиент 	 		= Стр.Ученик;
			Движение.ДисконтнаяКарта	= Стр.ДисконтнаяКарта;
			Движение.СуммаБонусов  	 	= Стр.СуммаБонусов;
			Движение.Организация 		= Организация;
		КонецЕсли;
		
	КонецЦикла;
	
	// Регистр УЗ_РасчетыПоЗарплате Приход
	Для Каждого Стр из НачисленияПедагогу Цикл 		
		Если ЗначениеЗаполнено(Стр.СуммаНачисления) Тогда
			Движения.УЗ_РасчетыПоЗарплате.Записывать = Истина;
			Движение = Движения.УЗ_РасчетыПоЗарплате.Добавить();
			Движение.ВидДвижения 		= ВидДвиженияНакопления.Приход;
			Движение.Период 	 		= Дата;
			Движение.Педагог 	 		= Педагог;
			Движение.Сумма				= Стр.СуммаНачисления;
			Движение.НеИзменять 		= Стр.НеИзменять;
			Движение.Организация 		= Организация;
			Движение.Комментарий 		= Стр.Комментарий;
		КонецЕсли;		
	КонецЦикла;	
	
	// Регистр УЗ_Расходы Приход
	Для Каждого Стр из Расходы Цикл		 		
		Движения.УЗ_Расходы.Записывать = Истина;
		Движение = Движения.УЗ_Расходы.Добавить();
		Движение.ВидДвижения 		= ВидДвиженияНакопления.Расход;
		Движение.Период 	 		= Дата;
		Движение.Сумма				= Стр.Сумма;
		Движение.Организация 		= Организация;
		Движение.СтатьяЗатрат 		= Стр.СтатьяЗатрат;
	КонецЦикла;
	
	Документы.УЗ_Урок.ПроверкаПересечений(ЭтотОбъект, Отказ);

	//ставка вне срока «Действует с/по» не начисляет (ПересчитатьНачисленияПедагога) — предупреждаем
	Если ЗначениеЗаполнено(СтавкаПедагога) И Не Документы.УЗ_Урок.СтавкаДействуетНаДату(СтавкаПедагога, Дата) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтрШаблон("Ставка педагога «%1» не действует на %2 — начисление педагогу по ставке не сделано. Выберите действующую ставку",
			СтавкаПедагога, Формат(Дата, "ДЛФ=D"));
		Сообщение.Поле = "СтавкаПедагога";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
	КонецЕсли;

КонецПроцедуры

//Настройка учёта «Требовать описание к неоплаченным урокам» действует на дату урока (с даты «…С» или всегда).
Функция ТребоватьЗаметкуКНеоплаченным()
	
	Настройки = РегистрыСведений.УЗ_Настройки.Настройки();
	Если Не Настройки.ТребоватьОписаниеКНеоплаченнымУрокам Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Не ЗначениеЗаполнено(Настройки.ТребоватьОписаниеКНеоплаченнымУрокамС)
		Или НачалоДня(Дата) >= НачалоДня(Настройки.ТребоватьОписаниеКНеоплаченнымУрокамС);
	
КонецФункции

//Исключительная управляемая блокировка остатков абонементов урока до чтения остатка: два сеанса не
//израсходуют одно последнее занятие. (Файловая база и без неё сериализует проведения — нужна клиент-серверной.)
Процедура ЗаблокироватьОстаткиАбонементов()
	
	Блокировка = Новый БлокировкаДанных;
	Заблокированные = Новый Соответствие;
	Для Каждого Стр Из Ученики Цикл
		Если Стр.СписатьОплату И ЗначениеЗаполнено(Стр.Абонемент)
			И Заблокированные[Стр.Абонемент] = Неопределено Тогда
			ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.УЗ_СписанияСуммЗаУроки");
			ЭлементБлокировки.УстановитьЗначение("Абонемент", Стр.Абонемент);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Заблокированные.Вставить(Стр.Абонемент, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Если Заблокированные.Количество() > 0 Тогда
		Блокировка.Заблокировать();
	КонецЕсли;
	
КонецПроцедуры

//Можно ли списать занятие строки Стр с абонемента. Возврат: текст отказа или Неопределено.
//ИспользованоВДокументе — Соответствие Абонемент → Структура(Уроков, Секунд): расход строк выше в этом же уроке
//(их движения ещё не записаны, остаток регистра их не видит); после успешной проверки строка добавляется туда.
//Остаток — СУММА по абонементу из виртуальной таблицы (платформа и так сворачивает прочие измерения — явка,
//педагог, тариф — в одну строку; факт проверен тестом тест_урок_абонемент.py). Остаток регистра: КоличествоУроков —
//число использованных занятий (Расход −1), Часы — минус использованные секунды.
Функция ПроверитьАбонемент(Стр, ИспользованоВДокументе)

	Абонемент = Стр.Абонемент;
	ГдеСтрока = " (строка " + Формат(Стр.НомерСтроки, "ЧГ=") + ")";

	//Codex A08: абонемент без ученика не списывается (прежде пустой владелец проверку проходил), предмет
	//абонемента — предмет урока (абонемент на гитару не оплачивает ударные); абонемент без предмета — на любой
	//предмет (так же его подбирает ДействующиеАбонементы)
	Если Не ЗначениеЗаполнено(Абонемент.ФизЛицо) Тогда
		Возврат "У абонемента " + Абонемент + " не указан ученик — списать по нему урок ученика " + Стр.Ученик
			+ " нельзя" + ГдеСтрока;
	ИначеЕсли Абонемент.ФизЛицо <> Стр.Ученик Тогда
		Возврат "Абонемент " + Абонемент + " — другого ученика (" + Абонемент.ФизЛицо
			+ "), а в уроке — " + Стр.Ученик + ГдеСтрока;
	КонецЕсли;
	Если ЗначениеЗаполнено(Абонемент.ПредметОбучения) И Абонемент.ПредметОбучения <> ПредметОбучения Тогда
		Возврат "Абонемент " + Абонемент + " — по предмету «" + Абонемент.ПредметОбучения + "», а урок — "
			+ ?(ЗначениеЗаполнено(ПредметОбучения), "по предмету «" + ПредметОбучения + "»", "без предмета")
			+ ГдеСтрока;
	КонецЕсли;

	Если НЕ Абонемент.Активный Или НЕ ЗначениеЗаполнено(Абонемент.ДатаАктивации) Тогда
		Возврат "У ученика " + Стр.Ученик + " не активен абонемент: " + Абонемент + ГдеСтрока;
	КонецЕсли;

	//В4 (решение владельца 28.09.2026): приостановка — с даты начала включительно по дату возобновления
	//не включая (пустая дата возобновления — приостановлен бессрочно); срок абонемента продлевается на дни
	//приостановок. Срок и приостановка считаются общими функциями модуля менеджера (их же берёт помощник уроков).
	ДеньУрока = НачалоДня(Дата);
	Если Документы.УЗ_Урок.АбонементПриостановленНаДату(Абонемент, ДеньУрока) Тогда
		Возврат "На " + Формат(Дата, "ДФ=dd.MM.yy") + " у ученика " + Стр.Ученик + " приостановлен абонемент: " + Абонемент + ГдеСтрока;
	КонецЕсли;
	ДнейПриостановки = Документы.УЗ_Урок.ДнейПриостановкиАбонемента(Абонемент);
	Срок = Документы.УЗ_Урок.ДатаОкончанияАбонемента(Абонемент);

	Если Абонемент.ДатаНачала > ДеньУрока Тогда
		Возврат "У ученика " + Стр.Ученик + " дата начала абонемента больше даты урока" + ГдеСтрока;
	ИначеЕсли ЗначениеЗаполнено(Срок) И Срок < ДеньУрока Тогда
		Возврат "У ученика " + Стр.Ученик + " дата окончания абонемента " + Формат(Абонемент.ДатаОкончания, "ДЛФ=D")
			+ ?(ДнейПриостановки > 0, " (с продлением на " + ДнейПриостановки + " дн. приостановки — "
				+ Формат(Срок, "ДЛФ=D") + ")", "")
			+ " меньше даты урока" + ГдеСтрока;
	КонецЕсли;

	ВДокументе = ИспользованоВДокументе[Абонемент];
	Если ВДокументе = Неопределено Тогда
		ВДокументе = Новый Структура("Уроков, Секунд", 0, 0);
		ИспользованоВДокументе.Вставить(Абонемент, ВДокументе);
	КонецЕсли;

	Если ЗначениеЗаполнено(Абонемент.КоличествоЗанятий) Или ЗначениеЗаполнено(Абонемент.КоличествоЧасов) Тогда

		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Остатки.КоличествоУроковОстаток), 0) КАК УрокиОстаток,
		|	ЕСТЬNULL(СУММА(Остатки.ЧасыОстаток), 0) КАК ЧасыОстаток
		|ИЗ
		|	РегистрНакопления.УЗ_СписанияСуммЗаУроки.Остатки(, Абонемент = &Абонемент) КАК Остатки";
		Запрос.УстановитьПараметр("Абонемент", Абонемент);
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();

		Если ЗначениеЗаполнено(Абонемент.КоличествоЗанятий) Тогда
			Использовано = Выборка.УрокиОстаток + ВДокументе.Уроков;
			Если Абонемент.КоличествоЗанятий - Использовано < 1 Тогда
				Возврат "Не хватает занятий по абонементу " + Абонемент + ": всего " + Абонемент.КоличествоЗанятий
					+ ", использовано " + Использовано + ГдеСтрока;
			КонецЕсли;
		Иначе
			//в целых секундах (В13): три урока по 40 мин ровно исчерпывают абонемент на 2 ч — дробные часы
			//(0,67 × 3 = 2,01) давали ложное «не хватает»
			ИспользованоСекунд = -Выборка.ЧасыОстаток + ВДокументе.Секунд;
			Разница = Абонемент.КоличествоЧасов * 3600 - ИспользованоСекунд - Документы.УЗ_Урок.СекундУрока(КоличествоЧасов);
			Если Разница < 0 Тогда
				Возврат "Не хватает " + Формат(-Разница / 3600, "ЧДЦ=2") + " ч по абонементу " + Абонемент + ": всего "
					+ Абонемент.КоличествоЧасов + " ч, использовано " + Формат(ИспользованоСекунд / 3600, "ЧДЦ=2; ЧН=0")
					+ " ч" + ГдеСтрока;
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;

	ВДокументе.Уроков = ВДокументе.Уроков + 1;
	ВДокументе.Секунд = ВДокументе.Секунд + Документы.УЗ_Урок.СекундУрока(КоличествоЧасов);

	Возврат Неопределено;

КонецФункции

Процедура ПриКопировании(ОбъектКопирования)
	
	АвторДокумента = Неопределено;
	Комментарий    = Неопределено;
	
	НачисленияПедагогу.Очистить();
	Расходы.Очистить();
	
	Ученики.Очистить();	
	Для Каждого стр из ОбъектКопирования.Ученики Цикл		
		НовУч = Ученики.Добавить();
		НовУч.Ученик 			= Стр.Ученик;
		НовУч.Тариф 			= Стр.Тариф;
		НовУч.ДисконтнаяКарта 	= Стр.ДисконтнаяКарта;
	КонецЦикла;	
	
	Если Не ЗначениеЗаполнено(ОбъектКопирования.Организация) Тогда
		LMНастроки = РегистрыСведений.УЗ_Настройки.Настройки();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, LMНастроки);
	КонецЕсли;
	
КонецПроцедуры

//Ученик с «Только выбранные группы обучения» — член группы урока на дату урока: единое правило «член группы на дату»
//(Справочники.УЗ_ФизЛица.ПроверитьЧленствоВГруппе: и «Дата начала», и «Дата окончания», достаточно одной действующей
//строки группы).
Функция ПроверкаНаКорректностьВыбраннойГруппыОбучения()
	
	ЕстьОграничения = Ложь;
	Для Каждого Стр из Ученики Цикл
		
		Если НЕ Стр.Ученик.ТолькоВыбранныеГруппыОбучения Тогда
			Продолжить;
		КонецЕсли;
		
		Причина = Справочники.УЗ_ФизЛица.ПроверитьЧленствоВГруппе(Стр.Ученик, ГруппаОбучения, Дата);
		Если Не ПустаяСтрока(Причина) Тогда
			Сообщить(""+Ссылка+ " для ученика " +Стр.Ученик+ ": " + Причина + "!");
			ЕстьОграничения = Истина;
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат ЕстьОграничения;
	
КонецФункции

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если ЭтоНовый() Тогда		
		LMНастроки = РегистрыСведений.УЗ_Настройки.Настройки();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, LMНастроки);
	КонецЕсли;
	
КонецПроцедуры

