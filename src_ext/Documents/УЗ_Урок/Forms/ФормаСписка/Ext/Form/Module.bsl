//Дни рождения сегодня и в ближайшие 10 дней — Справочники.УЗ_ФизЛица.ДниРождения: «Осталось дней» по дате
//(29 февраля в невисокосный год — 1 марта), «Исполнится» — от даты рождения (было: хранимый «Возраст», устаревал),
//выбывшие не показываются.
Процедура СформироватьСписокДнейРождений()

	ДниРождения.Очистить();
	Для Каждого СтрокаДня Из Справочники.УЗ_ФизЛица.ДниРождения(ТекущаяДатаСеанса(), 10) Цикл
		НоваяСтрока = ДниРождения.Добавить();
		НоваяСтрока.ФизЛицо = СтрокаДня.ФизЛицо;
		НоваяСтрока.Дата = СтрокаДня.Дата;
		НоваяСтрока.ДеньГода = ДеньГода(СтрокаДня.Дата);
		НоваяСтрока.Возраст = СтрокаДня.Исполнится;
		НоваяСтрока.ОсталосьДней = СтрокаДня.ОсталосьДней;
	КонецЦикла;

КонецПроцедуры

