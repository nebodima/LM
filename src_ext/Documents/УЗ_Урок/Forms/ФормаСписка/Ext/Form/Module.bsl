	ТекДанные = Элементы.Расшифровка.ТекущиеДанные;
	
	ПараметрыОткрытия = ОткрытьВзаиморасчетыНаСервере(ТекДанные.Ученик);
	ОткрытьФорму("Отчет.УЗ_Взаиморасчеты.Форма", ПараметрыОткрытия, ЭтаФорма);
	
КонецПроцедуры

