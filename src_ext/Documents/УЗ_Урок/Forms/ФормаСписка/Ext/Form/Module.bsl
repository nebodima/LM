	Если ЗначениеЗаполнено(Ученик) Тогда		
		ПараметрыОткрытия = ОткрытьВзаиморасчетыНаСервере(Ученик);
		ОткрытьФорму("Отчет.УЗ_Взаиморасчеты.Форма", ПараметрыОткрытия, ЭтаФорма);
	Иначе
		ОткрытьФорму("Отчет.УЗ_Взаиморасчеты.Форма", , ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
