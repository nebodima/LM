//Краткое имя дня недели по номеру (ДеньНедели), а не по строковому виду даты: Формат(Дата, "ДФ=ддд") зависит
//от языка и региональных настроек пользователя.
Функция ИмяДняНедели(Дата)
	Возврат СтрРазделить("Пн,Вт,Ср,Чт,Пт,Сб,Вс", ",")[ДеньНедели(Дата) - 1];
КонецФункции

//Время и длительность урока на дату — по расписанию дня группы, без своего времени у дня — общее (В21,
//Документы.УЗ_Урок.РасписаниеГруппыНаДень, одна функция с формой урока и панелью ученика): ставит «Время начала» и
//«Продолжительность» помощника. День, в который группа не занимается, — строка журнала и Ложь.
Функция ВзятьВремяГруппы(ДатаКалендаря, Группа)

	Расписание = Документы.УЗ_Урок.РасписаниеГруппыНаДень(Группа, ДатаКалендаря);
	Если Расписание = Неопределено Тогда
		ИнформационнаяТЗ.Добавить().Описание = СтрШаблон(НСтр("ru = '%1 (%2): у группы %3 в этот день нет занятия по расписанию — пропущено'"),
			Формат(ДатаКалендаря, "ДФ=dd.MM.yyyy"), ИмяДняНедели(ДатаКалендаря), Группа);
		Возврат Ложь;
	КонецЕсли;
	ВремяНачала = '00010101' + (Расписание.Начало - НачалоДня(Расписание.Начало));
	КоличествоЧасов = '00010101' + Окр(Расписание.КоличествоЧасов * 3600);
	Возврат Истина;

КонецФункции

//Решение владельца В10 (как в типовых): урок нельзя провести раньше его начала — будущий урок в режиме
//«Проводить» только записывается (УЗ_Общий.ЗаписатьУрок). Возвращает пометку для колонки результата
//("" — сделано как просили); отказ записи — исключение с причинами (пересечения, закрытый период…).
Функция ЗаписатьУрок(Урок, Провести)
	
	Итог = УЗ_Общий.ЗаписатьУрок(Урок, Провести);
	Если Не Итог.Успех Тогда
		ВызватьИсключение Итог.Текст;
	КонецЕсли;
	Возврат ?(Итог.Пометка = "", "", " — " + Итог.Пометка);
	
КонецФункции

//Параметры урока помощника на дату календаря: начало — дата + «Время начала», длительность — «Продолжительность».
Функция ПараметрыУрокаНаДату(ДатаКалендаря)
	
	ПараметрыУрока = Новый Структура;
	ПараметрыУрока.Вставить("Дата", ДатаКалендаря - ('00010101' - ВремяНачала));
	ПараметрыУрока.Вставить("КоличествоЧасов", (КоличествоЧасов - '00010101') / 3600);
	ПараметрыУрока.Вставить("ПредметОбучения", ПредметОбучения);
	ПараметрыУрока.Вставить("Педагог", Педагог);
	ПараметрыУрока.Вставить("Помещение", Помещение);
	ПараметрыУрока.Вставить("ГруппаОбучения", ГруппаОбучения);
	ПараметрыУрока.Вставить("Статус", СтатусУрока);
	ПараметрыУрока.Вставить("Тариф", Тариф);
	Возврат ПараметрыУрока;
	
КонецФункции

//Ученики таблицы помощника — массив структур для Документы.УЗ_Урок.ЗаписатьУчениковВУрок.
Функция ДанныеУчениковПомощника()
	
	ДанныеУчеников = Новый Массив;
	Для Каждого СтрУченик Из Ученики Цикл
		Если Не ЗначениеЗаполнено(СтрУченик.Ученик) Тогда
			Продолжить;
		КонецЕсли;
		ДанныеУчеников.Добавить(Новый Структура("Ученик, Тариф, Скидка, СписатьОплату, Явка, Абонемент",
			СтрУченик.Ученик, СтрУченик.Тариф, СтрУченик.Скидка, СтрУченик.СписатьОплату, СтрУченик.Явка, СтрУченик.Абонемент));
	КонецЦикла;
	Возврат ДанныеУчеников;
	
КонецФункции

//Строки итога помощника (Документы.УЗ_Урок.ЗаписатьУчениковВУрок / ПеревестиУчениковВУрок) — в таблицу «Результат».
Процедура ПоказатьИтогПомощника(Итог, Пометка)
	
	Для Каждого СтрокаИтога Из Итог.Строки Цикл
		НовСтр = ИнформационнаяТЗ.Добавить();
		НовСтр.Описание = СтрокаИтога.Описание + Пометка;
		Если ЗначениеЗаполнено(СтрокаИтога.Урок) Тогда
			НовСтр.Урок = СтрокаИтога.Урок;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыполнитьНаСервере()
	
	//время: из расписания группы (группа выбрана, «Заполнять из группы обучения», ручное время не задано)
	//или ручное — тогда начало и продолжительность обязательны (прежде без группы и без времени проверки не было —
	//создавался урок в 00:00 длительностью 0; ручное время при «Заполнять из группы» игнорировалось)
	ВремяИзГруппы = ЗначениеЗаполнено(ГруппаОбучения) И ЗаполнятьИзГруппыОбучения И НЕ УстановитьВремяВручную;
	Если ВремяИзГруппы Тогда
		Если Не ГруппаОбучения.ПН и Не ГруппаОбучения.ВТ и не ГруппаОбучения.СР и не ГруппаОбучения.ЧТ и не ГруппаОбучения.ПТ и не ГруппаОбучения.СБ и не ГруппаОбучения.ВС Тогда
			ТекстСообщения = "Не заполнено время по дням неделям в группе обучения!";
			УЗ_ОбщийКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли; 		
	Иначе
		Если Не ЗначениеЗаполнено(ВремяНачала) или Не ЗначениеЗаполнено(КоличествоЧасов) Тогда
			ТекстСообщения = "Не заполнено время начала или продолжительность!";
			УЗ_ОбщийКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли; 		
	КонецЕсли;
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.Страница1 Тогда	
		
		ИнформационнаяТЗ.Добавить().Описание = "Создание уроков и добавление в существующие, " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");
		  
		//урок на дату ищется строго: то же начало, группа, педагог, предмет, помещение; нет — создаётся, но не поверх
		//урока того же педагога/помещения/группы (Codex N03); логика — Документы.УЗ_Урок.ЗаписатьУчениковВУрок
		ДанныеУчеников = ДанныеУчениковПомощника();
		Для Каждого Стр из Элементы.Календарь.ВыделенныеДаты Цикл
			Если ВремяИзГруппы И Не ВзятьВремяГруппы(Стр, ГруппаОбучения) Тогда
				Продолжить;
			КонецЕсли;
			Итог = Документы.УЗ_Урок.ЗаписатьУчениковВУрок(ПараметрыУрокаНаДату(Стр), ДанныеУчеников, Не Записывать);
			ПоказатьИтогПомощника(Итог, "");
		КонецЦикла;
				
	ИначеЕсли ПродлениеГруппы И Элементы.Страница2.Видимость И Элементы.Страницы.ТекущаяСтраница = Элементы.Страница2 Тогда
		
		ИнформационнаяТЗ.Добавить().Описание = "Продление группы, " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");

		//урок на дату — по расписанию дня группы (В21), ученики последнего урока с тарифом по В20 и абонементом на
		//дату урока, проверки конфликтов и В10 — Документы.УЗ_Урок.ПродлитьГруппу (прежде: общее время группы,
		//без абонемента и конфликтов; у группы без уроков — ошибка выполнения)
		Для Каждого СтрокаЖурнала Из Документы.УЗ_Урок.ПродлитьГруппу(ГруппаОбучения, Элементы.Календарь.ВыделенныеДаты) Цикл
			НовСтр = ИнформационнаяТЗ.Добавить();
			НовСтр.Описание = СтрокаЖурнала.Описание;
			Если ЗначениеЗаполнено(СтрокаЖурнала.Урок) Тогда
				НовСтр.Урок = СтрокаЖурнала.Урок;
			КонецЕсли;
		КонецЦикла;

	ИначеЕсли ПереводИзГруппы И Элементы.Страница3.Видимость И Элементы.Страницы.ТекущаяСтраница = Элементы.Страница3 Тогда
		
		ИнформационнаяТЗ.Добавить().Описание = "Перевод из группы, " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");
		
		//на каждую дату — одной транзакцией: ученики убираются из уроков прежней группы и записываются в урок новой;
		//не записался хоть один урок — на эту дату не меняется ничего (Codex Q03; прежде старые уроки менялись до
		//попытки записать новый). Логика — Документы.УЗ_Урок.ПеревестиУчениковВУрок
		ДанныеУчеников = ДанныеУчениковПомощника();
		Для Каждого Стр из Элементы.Календарь.ВыделенныеДаты Цикл
			Если ВремяИзГруппы И Не ВзятьВремяГруппы(Стр, ГруппаОбучения) Тогда
				Продолжить;
			КонецЕсли;
			Итог = Документы.УЗ_Урок.ПеревестиУчениковВУрок(ПараметрыУрокаНаДату(Стр), ИзГруппыОбучения, ДанныеУчеников, Истина);
			ПоказатьИтогПомощника(Итог, " (перевод)");
		КонецЦикла;
		
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействие(Команда)
	
	Отказ = Ложь;
	
	ИнформационнаяТЗ.Очистить();

	//«Выполнить» — только с вкладки своего режима: прежде с «Найденных документов» или «Результата» запускались
	//скрытые режимы (продление группы, перевод), если их отметки остались в сохранённых настройках формы
	ТекущаяСтраница = Элементы.Страницы.ТекущаяСтраница;
	Если ТекущаяСтраница <> Элементы.Страница1
		И Не (ТекущаяСтраница.Видимость И (ТекущаяСтраница = Элементы.Страница2 Или ТекущаяСтраница = Элементы.Страница3)) Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(НСтр("ru = 'Перейдите на вкладку «Создание уроков» и нажмите «Выполнить» там'"));
		Возврат;
	КонецЕсли;

	Если Элементы.Календарь.ВыделенныеДаты.Количество() = 0 Тогда
		Сообщить("Не выбраны даты уроков!");
		Отказ = Истина;
	КонецЕсли;
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.Страница1 Тогда
		Если Ученики.Количество() = 0 Тогда
			Сообщить("Не выбраны ученики!");
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
			
	//Если ПереводИзГруппы и НЕ ЗначениеЗаполнено(ИзГруппыОбучения) Тогда
	//	Сообщить("Не выбрана Группа обучения из которой планируется перевод ученика(ов)!");
	//	Отказ = Истина;
	//КонецЕсли;
	
	//Если НЕ ДобавлениеВСуществующиеЗанятия и НЕ ПродлениеГруппы и НЕ ПереводИзГруппы Тогда
	//	Если ВремяНачала = '00010101' или КоличествоЧасов = '00010101' или НЕ ЗначениеЗаполнено(ПредметОбучения) Тогда 
	//		Сообщить("Не выбраны параметры создания уроков!");
	//		Отказ = Истина;
	//	КонецЕсли;
	//КонецЕсли; 
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Состояние("Идет выполение...");
	ВыполнитьНаСервере();  	
	
	Оповестить("ЗакрытьФорму");
	Результат = Результат + "Выполнено!"+Символы.ПС;
	Состояние("Завершено!");
	
	Если ИнформационнаяТЗ.Количество()>0 Тогда
		Элементы.Страницы.ТекущаяСтраница  = Элементы.Страница5;
	КонецЕсли; 	
	
КонецПроцедуры

Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
	НайтиДокументыНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПродлениеГруппыПриИзменении(Элемент)
	
	Если ЭтотОбъект.ПродлениеГруппы Тогда
		ДобавлениеВСуществующиеЗанятия 	= Ложь;
		ПереводИзГруппы					= Ложь;
	КонецЕсли;
	
	ОбновитьВидимость();
	
	ГруппаОбученияПриИзмененииНаСервере(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПереводИзГруппыПриИзменении(Элемент)
	
	Если ЭтотОбъект.ПереводИзГруппы Тогда
		ДобавлениеВСуществующиеЗанятия 	= Ложь;
		ПродлениеГруппы					= Ложь;
	КонецЕсли;
	
	ОбновитьВидимость();
	
	ГруппаОбученияПриИзмененииНаСервере(Ложь);
	      	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаОбученияПриИзменении(Элемент)
	
	УстановитьВремяВручную = Ложь;
	
	ГруппаОбученияПриИзмененииНаСервере(Ложь);
	Если ЗаполнятьИзГруппыОбучения И Не ПродлениеГруппы Тогда
		ЗаполнитьУчениковИзГруппы();
	КонецЕсли;
	
	ОбновитьВидимость();
	
КонецПроцедуры

//Ученики, у которых эта группа в карточке (вкладка «Группы обучения», на дату — сегодня),
//с их тарифом (или тарифом группы), скидкой и действующим абонементом по предмету группы.
&НаСервере
Процедура ЗаполнитьУчениковИзГруппы()
	
	Ученики.Очистить();
	Если Не ЗначениеЗаполнено(ГруппаОбучения) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГруппыУченика.Ссылка КАК Ученик,
	|	ГруппыУченика.Ссылка.Наименование КАК Наименование,
	|	ГруппыУченика.Ссылка.Тариф КАК Тариф,
	|	ГруппыУченика.Ссылка.Скидка КАК Скидка
	|ПОМЕСТИТЬ ВТ_Ученики
	|ИЗ
	|	Справочник.УЗ_ФизЛица.ГруппыОбучения КАК ГруппыУченика
	|ГДЕ
	|	ГруппыУченика.ГруппаОбучения = &ГруппаОбучения
	|	И НЕ ГруппыУченика.Ссылка.ПометкаУдаления
	|	И НЕ ГруппыУченика.Ссылка.ЭтоПедагог
	|	И (ГруппыУченика.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ГруппыУченика.ДатаНачала <= &Дата)
	|	И (ГруппыУченика.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ГруппыУченика.ДатаОкончания >= &Дата)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Ученики.Ученик КАК Ученик,
	|	ВТ_Ученики.Наименование КАК Наименование,
	|	ВТ_Ученики.Тариф КАК Тариф,
	|	ВТ_Ученики.Скидка КАК Скидка
	|ИЗ
	|	ВТ_Ученики КАК ВТ_Ученики
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Запрос.УстановитьПараметр("ГруппаОбучения", ГруппаОбучения);
	Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДатаСеанса()));
	Таблица = Запрос.Выполнить().Выгрузить();

	Для Каждого Выборка Из Таблица Цикл
		Если Ученики.НайтиСтроки(Новый Структура("Ученик", Выборка.Ученик)).Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Ученики.Добавить();
		НоваяСтрока.Ученик 		= Выборка.Ученик;
		НоваяСтрока.Тариф 		= Документы.УЗ_Урок.ТарифНовойСтроки(Выборка.Ученик, ГруппаОбучения, Тариф);
		НоваяСтрока.Скидка 		= Выборка.Скидка;
	КонецЦикла;
	ЗаполнитьАбонементы();

КонецПроцедуры

//Абонемент и его остаток в таблице учеников — на первую выбранную дату (без дат — на сегодня), теми же функциями,
//что урок (Справочники.УЗ_Абонемент.ПодобратьАбонемент). Это подсказка: при записи каждого урока абонемент
//подбирается заново на дату ЭТОГО урока (Документы.УЗ_Урок.ЗаписатьУчениковВУрок) — на дни паузы, после
//окончания или исчерпания в уроке будет другой абонемент или тариф.
&НаСервере
Процедура ЗаполнитьАбонементы()

	ДатаПодбора = ТекущаяДатаСеанса();
	Если Элементы.Календарь.ВыделенныеДаты.Количество() > 0 Тогда
		ДатаПодбора = Элементы.Календарь.ВыделенныеДаты[0];
		Для Каждого ДатаКалендаря Из Элементы.Календарь.ВыделенныеДаты Цикл
			ДатаПодбора = Мин(ДатаПодбора, ДатаКалендаря);
		КонецЦикла;
	КонецЕсли;
	Часов = (КоличествоЧасов - '00010101') / 3600;
	Организация = РегистрыСведений.УЗ_Настройки.Настройки().Организация;
	Для Каждого СтрУченик Из Ученики Цикл
		Подбор = Справочники.УЗ_Абонемент.ПодобратьАбонемент(СтрУченик.Ученик, ПредметОбучения, ДатаПодбора, Организация, Часов);
		СтрУченик.Абонемент = Подбор.Абонемент;
		Если ЗначениеЗаполнено(Подбор.Абонемент) Тогда
			СтрУченик.ОстатокАбонемента = Справочники.УЗ_Абонемент.ТекстОстатка(Подбор.Абонемент);
		ИначеЕсли ЗначениеЗаполнено(Подбор.Исчерпанный) Тогда
			СтрУченик.ОстатокАбонемента = НСтр("ru = 'исчерпан — по тарифу'");
		ИначеЕсли ЗначениеЗаполнено(Подбор.Приостановленный) Тогда
			СтрУченик.ОстатокАбонемента = НСтр("ru = 'приостановлен — по тарифу'");
		Иначе
			СтрУченик.ОстатокАбонемента = "";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
Процедура ГруппаОбученияПриИзмененииНаСервере(СледМесяц)
	
	Элементы.Календарь.ВыделенныеДаты.Очистить();	
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ГруппаОбучения) Тогда
		
		ЗаполнятьИзГруппыОбучения = Истина;
		
		Если ЭтотОбъект.ГруппаОбучения.ПН Тогда
			ДобавитьВСписок(1,"Календарь",СледМесяц);	
		КонецЕсли;
		Если ЭтотОбъект.ГруппаОбучения.ВТ Тогда
			ДобавитьВСписок(2,"Календарь",СледМесяц);	
		КонецЕсли;  
		Если ЭтотОбъект.ГруппаОбучения.СР Тогда
			ДобавитьВСписок(3,"Календарь",СледМесяц);	
		КонецЕсли; 
		Если ЭтотОбъект.ГруппаОбучения.ЧТ Тогда
			ДобавитьВСписок(4,"Календарь",СледМесяц);	
		КонецЕсли;
		Если ЭтотОбъект.ГруппаОбучения.ПТ Тогда
			ДобавитьВСписок(5,"Календарь",СледМесяц);	
		КонецЕсли;
		Если ЭтотОбъект.ГруппаОбучения.СБ Тогда
			ДобавитьВСписок(6,"Календарь",СледМесяц);	
		КонецЕсли;
		Если ЭтотОбъект.ГруппаОбучения.ВС Тогда
			ДобавитьВСписок(7,"Календарь",СледМесяц);	
		КонецЕсли;
		
		Если ДобавлениеВСуществующиеЗанятия Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ФизЛицаГруппыОбучения.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.УЗ_ФизЛица.ГруппыОбучения КАК ФизЛицаГруппыОбучения
			|ГДЕ
			|	ФизЛицаГруппыОбучения.Ссылка.ТолькоВыбранныеГруппыОбучения
			|	И ФизЛицаГруппыОбучения.ГруппаОбучения = &ГруппаОбучения";	
			Запрос.УстановитьПараметр("ГруппаОбучения", ГруппаОбучения);	
			РезультатЗапроса = Запрос.Выполнить(); 	
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			//повторное заполнение («Заполнить этот/след. месяц», открытие формы) не дописывает тех, кто уже есть
			//(прежде ученик попадал в урок дважды — двойное списание денег и абонемента)
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Если Ученики.НайтиСтроки(Новый Структура("Ученик", ВыборкаДетальныеЗаписи.Ссылка)).Количество() > 0 Тогда
					Продолжить;
				КонецЕсли;
				НовУч = Ученики.Добавить();
				НовУч.Ученик = ВыборкаДетальныеЗаписи.Ссылка;
				НовУч.Тариф = Документы.УЗ_Урок.ТарифНовойСтроки(ВыборкаДетальныеЗаписи.Ссылка, ГруппаОбучения, ГруппаОбучения.Тариф);
				НовУч.Скидка = ВыборкаДетальныеЗаписи.Ссылка.Скидка;
			КонецЦикла;
						
		КонецЕсли;
		
		Педагог 		= ЭтотОбъект.ГруппаОбучения.Педагог;
		ПредметОбучения = ЭтотОбъект.ГруппаОбучения.ПредметОбучения;
		ВремяНачала 	= ЭтотОбъект.ГруппаОбучения.Время;
		КоличествоЧасов = ЭтотОбъект.ГруппаОбучения.Продолжительность;
		Помещение 		= ЭтотОбъект.ГруппаОбучения.Помещение;
		Тариф 			= ЭтотОбъект.ГруппаОбучения.Тариф;
		
	Иначе
		
		ЗаполнятьИзГруппыОбучения = Ложь;
		
	КонецЕсли; 	
	
	Если ЗначениеЗаполнено(ГруппаОбучения) и ПродлениеГруппы Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Урок.Ссылка,
		|	Урок.Дата КАК Дата
		|ИЗ
		|	Документ.УЗ_Урок КАК Урок
		|ГДЕ
		|	НЕ Урок.ПометкаУдаления
		|	И Урок.ГруппаОбучения = &ГруппаОбучения
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ
		|АВТОУПОРЯДОЧИВАНИЕ";
		Запрос.УстановитьПараметр("ГруппаОбучения", ГруппаОбучения);
		РезультатЗапроса = Запрос.Выполнить();				
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Ученики.Очистить();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Для Каждого Стр из ВыборкаДетальныеЗаписи.Ссылка.Ученики Цикл
				НовСтрУч = Ученики.Добавить();
				НовСтрУч.Ученик = Стр.Ученик;
				НовСтрУч.Тариф 	= Документы.УЗ_Урок.ТарифНовойСтроки(Стр.Ученик, ГруппаОбучения, Стр.Тариф);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;

	Если ЗначениеЗаполнено(ГруппаОбучения) Тогда
		ЗаполнитьАбонементы();
	КонецЕсли;
		
КонецПроцедуры

Процедура ДобавитьВСписок(ДеньНедели, Календ, СледМесяц)

	Если СледМесяц Тогда
		ДатаНач 	= КонецМесяца(ТекущаяДатаСеанса())+1;
	Иначе
		ДатаНач 	= ТекущаяДатаСеанса();
	КонецЕсли;
	
	ДатаКонец 	= КонецМесяца(ДатаНач); 
	Пока ДатаНач <= ДатаКонец Цикл
		Если ДеньНедели(ДатаНач) = ДеньНедели Тогда
			Элементы[Календ].ВыделенныеДаты.Добавить(НачалоДня(ДатаНач));
		КонецЕсли;
		ДатаНач = ДатаНач +86400;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимость()
	
	Если ПереводИзГруппы Тогда 
		Элементы.ИзГруппыОбучения.Видимость = Истина;
	Иначе
		Элементы.ИзГруппыОбучения.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ВремяНачала.Доступность 		= Истина;
	Элементы.КоличествоЧасов.Доступность 	= Истина;

	//введённое время не стираем: обновление видимости вызывает и смена тарифа (прежде время обнулялось)
	
	Если ЗаполнятьИзГруппыОбучения Тогда 
		Элементы.Помещение.Доступность 			= Ложь;
		Элементы.Педагог.Доступность 			= Ложь;
		Элементы.ПредметОбучения.Доступность 	= Ложь;
		Элементы.ВремяНачала.Видимость 			= Ложь;
		Элементы.КоличествоЧасов.Видимость 		= Ложь;
		Элементы.Тариф.Доступность 				= Ложь;
	Иначе
		Элементы.Помещение.Доступность 			= Истина;
		Элементы.Педагог.Доступность 			= Истина;
		Элементы.ПредметОбучения.Доступность 	= Истина;
		Элементы.Тариф.Доступность 				= Истина;
	КонецЕсли;
	
	Если НЕ УстановитьВремяВручную Тогда
		Элементы.ВремяНачала.Видимость 		= Ложь;
		Элементы.КоличествоЧасов.Видимость 	= Ложь;
	Иначе
		Элементы.ВремяНачала.Видимость 		= Истина;
		Элементы.КоличествоЧасов.Видимость 	= Истина;
	КонецЕсли;
	
	ОбновитьВидимостьНаСервере();
		
КонецПроцедуры

Процедура ОбновитьВидимостьНаСервере()
	
	Если ЗаполнятьИзГруппыОбучения Тогда 
		
		//ручное время по умолчанию — время группы, но введённое пользователем не затираем
		Если УстановитьВремяВручную И Не ЗначениеЗаполнено(ВремяНачала) Тогда
			ВремяНачала 	= ГруппаОбучения.Время;
		КонецЕсли;
		Если УстановитьВремяВручную И Не ЗначениеЗаполнено(КоличествоЧасов) Тогда
			КоличествоЧасов = ГруппаОбучения.Продолжительность;
		КонецЕсли;
		
		Педагог			= ГруппаОбучения.Педагог;
		Помещение		= ГруппаОбучения.Помещение;
		ПредметОбучения	= ГруппаОбучения.ПредметОбучения;
		Тариф			= ГруппаОбучения.Тариф;
		
	КонецЕсли;
	
	Если НЕ Тариф.Пустая() Тогда
		//цена — по тем же правилам, что при проведении урока: карточка тарифа без истории цен
		//или история цен (раньше смотрели только историю — и писали «нет цен» при цене в карточке)
		Цена = Документы.УЗ_Урок.ЦенаТарифаНаДату(Тариф, ТекущаяДатаСеанса());
		//справка о цене — серым поясняющим текстом; красным (цвет минуса палитры) — только «нет цены»
		Элементы.Декорация3.ЦветТекста = ?(Цена = Неопределено, УЗ_ОбщийКлиентСервер.ЦветМинусаДенег(),
			УЗ_ОбщийКлиентСервер.ЦветПояснения());
		Если Цена = Неопределено Тогда
			Элементы.Декорация3.Заголовок = НСтр("ru = 'У тарифа нет цены на сегодня. Укажите цену в карточке тарифа'");
		ИначеЕсли Цена.КоличествоЧасов > 0 Тогда
			Элементы.Декорация3.Заголовок = "" +Формат(Цена.Сумма/Цена.КоличествоЧасов,"ЧДЦ=2")+ " за 1 час ("
			+Формат(Цена.Сумма,"ЧДЦ=2")+ " за " + УЗ_ОбщийКлиентСервер.ПредставлениеДлительности(Цена.КоличествоЧасов) + ")";
		ИначеЕсли Цена.КоличествоУроков > 0 Тогда
			Элементы.Декорация3.Заголовок = "" +Формат(Цена.Сумма/Цена.КоличествоУроков,"ЧДЦ=2")+ " за 1 урок ("
			+Формат(Цена.Сумма,"ЧДЦ=2")+ " / " +Цена.КоличествоУроков+ " ур.)";
		Иначе
			Элементы.Декорация3.Заголовок = НСтр("ru = 'Бесплатно'");
		КонецЕсли;
		
	Иначе		
		//Элементы.Декорация3.Заголовок = "Тариф не выбран: - цены не рассчитаны!"; 		
	КонецЕсли;

КонецПроцедуры        

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ГруппаОбученияПриИзмененииНаСервере(Ложь);
	
	ОбновитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзГруппыОбученияПриИзменении(Элемент)
	ИзГруппыОбученияПриИзмененииНаСервере(Ложь);
КонецПроцедуры
Процедура ИзГруппыОбученияПриИзмененииНаСервере(СледМесяц)
	
	Элементы.Календарь.ВыделенныеДаты.Очистить();
	
	Если ЗначениеЗаполнено(ЭтотОбъект.ИзГруппыОбучения) Тогда
		Если ЭтотОбъект.ИзГруппыОбучения.ПН Тогда
			ДобавитьВСписок(1,"Календарь",СледМесяц);	
		КонецЕсли;
		Если ЭтотОбъект.ИзГруппыОбучения.ВТ Тогда
			ДобавитьВСписок(2,"Календарь",СледМесяц);	
		КонецЕсли;  
		Если ЭтотОбъект.ИзГруппыОбучения.СР Тогда
			ДобавитьВСписок(3,"Календарь",СледМесяц);	
		КонецЕсли; 
		Если ЭтотОбъект.ИзГруппыОбучения.ЧТ Тогда
			ДобавитьВСписок(4,"Календарь",СледМесяц);	
		КонецЕсли;
		Если ЭтотОбъект.ИзГруппыОбучения.ПТ Тогда
			ДобавитьВСписок(5,"Календарь",СледМесяц);	
		КонецЕсли;
		Если ЭтотОбъект.ИзГруппыОбучения.СБ Тогда
			ДобавитьВСписок(6,"Календарь",СледМесяц);	
		КонецЕсли;
		Если ЭтотОбъект.ИзГруппыОбучения.ВС Тогда
			ДобавитьВСписок(7,"Календарь",СледМесяц);	
		КонецЕсли; 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УченикиУченикСоздание(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыСтроки = Новый Структура;
	ПараметрыСтроки.Вставить("Наименование", СокрЛП(Элемент.ТекстРедактирования));
	ПараметрыСтроки.Вставить("Группа","Ученики");
	
	Пар = Новый Структура("Ключ2", ПараметрыСтроки);
	
	ОткрытьФорму("Справочник.УЗ_ФизЛица.Форма.ФормаЭлемента",Пар,ЭтотОбъект,УникальныйИдентификатор,ВариантОткрытияОкна.ОтдельноеОкно,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)
	
	ИзГруппыОбучения 				= Неопределено;
	ГруппаОбучения   				= Неопределено;
	ДобавлениеВСуществующиеЗанятия 	= Истина;
	ПереводИзГруппы				 	= Ложь;
	ПродлениеГруппы				 	= Ложь;
	Помещение						= Неопределено;
	Педагог							= Неопределено;
	ПредметОбучения					= Неопределено;
	ВремяНачала						= '00010101';
	КоличествоЧасов					= '00010101';
	ЗаполнятьИзГруппыОбучения		= Ложь;
	УстановитьВремяВручную			= Истина;
	СтатусУрока						= Неопределено;
	
	Результат = "";
	Ученики.Очистить();
	ИнформационнаяТЗ.Очистить();
	Элементы.Календарь.ВыделенныеДаты.Очистить();
	
	ОбновитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура СписатьОплаты(Команда) 	
	Для Каждого Стр из Ученики Цикл
		Стр.СписатьОплату = Истина;
	КонецЦикла;	
КонецПроцедуры
&НаКлиенте
Процедура УбратьСписатьОплаты(Команда) 	
	Для Каждого Стр из Ученики Цикл
		Стр.СписатьОплату = Ложь;
	КонецЦикла; 	
КонецПроцедуры

Функция ВернутьПапкуУченики()
	Возврат Справочники.УЗ_ФизЛица.Ученики.Ссылка;
КонецФункции

&НаКлиенте
Процедура ПодборУчениковЗавершение(Результат,Параметры) Экспорт
	Если Результат <> Неопределено Тогда
		Для Каждого Ученик Из Результат Цикл
			НоваяСтрока = Ученики.Добавить();
			НоваяСтрока.Ученик = Ученик;
			НоваяСтрока.Скидка = ПолучитьСкидкуУченика(Ученик);
			НоваяСтрока.Тариф = ПолучитьТарифУченика(Ученик);
		КонецЦикла;
		ЗаполнитьАбонементы();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПодборУчеников(Команда)
	ОП = Новый ОписаниеОповещения("ПодборУчениковЗавершение",ЭтотОбъект);
	ПП = Новый Структура("МножественныйВыбор",Истина);  
	Отбор = Новый Структура("Родитель",ВернутьПапкуУченики());
	ПП.Вставить("Отбор", Отбор);
	ОткрытьФорму("Справочник.УЗ_ФизЛица.Форма.ФормаВыбора",ПП,ЭтотОбъект,,,,ОП,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

Процедура НайтиДокументыНаСервере()
	
	МассивУроков = Новый Массив;
	
	Для Каждого Стр из Элементы.Календарь.ВыделенныеДаты Цикл
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Урок.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.УЗ_Урок КАК Урок
		|ГДЕ
		|	НЕ Урок.ПометкаУдаления
		|	И Урок.Окончание <= &ДатаОкончания
		|	И Урок.Дата >= &ДатаНачала
		//|	И Урок.Педагог = &Педагог
		|	И Урок.ПредметОбучения = &ПредметОбучения
		|	И Урок.Помещение = &Помещение";			
		
		Если ЗаполнятьИзГруппыОбучения Тогда
			Расписание = Документы.УЗ_Урок.РасписаниеГруппыНаДень(ГруппаОбучения, Стр);
			Если Расписание = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Запрос.УстановитьПараметр("ДатаНачала", Расписание.Начало);
			Запрос.УстановитьПараметр("ДатаОкончания", Расписание.Начало + Окр(Расписание.КоличествоЧасов * 3600));
		Иначе
			Запрос.УстановитьПараметр("ДатаНачала", Стр-('00010101'-ВремяНачала)); 
			Запрос.УстановитьПараметр("ДатаОкончания", Стр-('00010101'-ВремяНачала)-('00010101'-КоличествоЧасов));
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ПредметОбучения", ПредметОбучения);
		//Запрос.УстановитьПараметр("Педагог", Педагог);
		Запрос.УстановитьПараметр("Помещение", Помещение);
		
		РезультатЗапроса = Запрос.Выполнить();				
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			МассивУроков.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
		КонецЦикла;				
		
	КонецЦикла;
	
	Урок = Элементы.НайденныеДокументы2.ТекущаяСтрока;
	НайденныеДокументы2.Отбор.Элементы.Очистить();
	ЭлементОтбора = НайденныеДокументы2.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ЭлементОтбора.ПравоеЗначение = МассивУроков;
	ЭлементОтбора = НайденныеДокументы2.Отбор.Элементы[0];
	ЭлементОтбора.Использование = Истина;
	Элементы.НайденныеДокументы2.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиДокументы(Команда) 	
	НайтиДокументыНаСервере(); 	
КонецПроцедуры

Функция ПолучитьВремяИзГруппыОбучения(Стр)	
	
	ВремяЗанятия = ВремяНачала;
	
	ДеньНедели = ИмяДняНедели(Стр);
	Если ДеньНедели = "Пн" Тогда
		ВремяЗанятия = ?(ГруппаОбучения.ПН,ГруппаОбучения.ПНВремя,ВремяЗанятия);
	ИначеЕсли ДеньНедели = "Вт" Тогда
		ВремяЗанятия = ?(ГруппаОбучения.ВТ,ГруппаОбучения.ВТВремя,ВремяЗанятия);
	ИначеЕсли ДеньНедели = "Ср" Тогда
		ВремяЗанятия = ?(ГруппаОбучения.СР,ГруппаОбучения.СРВремя,ВремяЗанятия);
	ИначеЕсли ДеньНедели = "Чт" Тогда
		ВремяЗанятия = ?(ГруппаОбучения.ЧТ,ГруппаОбучения.ЧТВремя,ВремяЗанятия);
	ИначеЕсли ДеньНедели = "Пт" Тогда
		ВремяЗанятия = ?(ГруппаОбучения.ПТ,ГруппаОбучения.ПТВремя,ВремяЗанятия);
	ИначеЕсли ДеньНедели = "Сб" Тогда
		ВремяЗанятия = ?(ГруппаОбучения.СБ,ГруппаОбучения.СБВремя,ВремяЗанятия);
	ИначеЕсли ДеньНедели = "Вс" Тогда
		ВремяЗанятия = ?(ГруппаОбучения.ВС,ГруппаОбучения.ВСВремя,ВремяЗанятия);
	КонецЕсли;
	
	Возврат ВремяЗанятия;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнятьИзГруппыОбученияПриИзменении(Элемент)
	
	Если ЗаполнятьИзГруппыОбучения Тогда
		Элементы.ВремяБратьИзГруппы.Доступность = Истина;
		УстановитьВремяВручную 					= Ложь;
		Элементы.ВремяНачала.Видимость 			= Ложь;
		Элементы.КоличествоЧасов.Видимость 		= Ложь;
		Если ЗначениеЗаполнено(ГруппаОбучения) И Ученики.Количество() = 0 Тогда
			ЗаполнитьУчениковИзГруппы();
		КонецЕсли;
	Иначе
		Элементы.ВремяБратьИзГруппы.Доступность = Ложь;
		УстановитьВремяВручную 					= Истина;
		Элементы.ВремяНачала.Видимость 			= Истина;
		Элементы.КоличествоЧасов.Видимость 		= Истина;
	КонецЕсли;
	
	ОбновитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ВремяБратьИзГруппыПриИзменении(Элемент)
	
	Если НЕ УстановитьВремяВручную и ЗначениеЗаполнено(ГруппаОбучения) Тогда
		Элементы.ВремяНачала.Видимость 		= Ложь;
		Элементы.КоличествоЧасов.Видимость 	= Ложь;
	Иначе
		Элементы.ВремяНачала.Видимость 		= Истина;
		Элементы.КоличествоЧасов.Видимость 	= Истина;
	КонецЕсли;
	
	ВремяНачала = Неопределено;
	КоличествоЧасов = Неопределено;

КонецПроцедуры

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.Страница4 Тогда
		НайтиДокументыНаСервере();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСледующийМесяц(Команда)
	ГруппаОбученияПриИзмененииНаСервере(Истина);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЭтотМесяц(Команда)
	ГруппаОбученияПриИзмененииНаСервере(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура УченикиУченикПриИзменении(Элемент) 	
	ТекДанные = Элементы.Ученики.ТекущиеДанные;
	ТекДанные.Скидка 	= ПолучитьСкидкуУченика(ТекДанные.Ученик);
	ТекДанные.Тариф 	= ПолучитьТарифУченика(ТекДанные.Ученик);
	ЗаполнитьАбонементы();
КонецПроцедуры 
Функция ПолучитьСкидкуУченика(Ученик)
	Возврат Ученик.Скидка;
КонецФункции
//В20: тариф ученика, иначе тариф группы, иначе тариф помощника (прежде строка оставалась без тарифа)
Функция ПолучитьТарифУченика(Ученик)
	Возврат Документы.УЗ_Урок.ТарифНовойСтроки(Ученик, ГруппаОбучения, Тариф);
КонецФункции

&НаКлиенте
Процедура ТарифПриИзменении(Элемент)
	
	Для Каждого Стр из Ученики Цикл
		Стр.Тариф = Тариф;
	КонецЦикла;
	
	ОбновитьВидимость();
	
КонецПроцедуры

