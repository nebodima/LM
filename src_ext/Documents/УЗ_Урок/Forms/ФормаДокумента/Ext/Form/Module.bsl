Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//новый урок — на текущее время, а не на полночь; время из календаря/помощника не трогаем
	Если Объект.Ссылка.Пустая() Тогда
		Если Параметры.Свойство("Дата") И ЗначениеЗаполнено(Параметры.Дата) Тогда
			Объект.Дата = Параметры.Дата;
		ИначеЕсли Объект.Дата = НачалоДня(Объект.Дата) Тогда
			Сейчас = НачалоМинуты(ТекущаяДатаСеанса());
			Объект.Дата = НачалоДня(?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, Сейчас)) + (Сейчас - НачалоДня(Сейчас));
		КонецЕсли;
	КонецЕсли;

	//дата запрета: «только просмотр» ставит ПриЧтенииНаСервере (УЗ_ДатыЗапрета)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации";
	Если Запрос.Выполнить().Пустой() Тогда
		Элементы.Организация.Видимость = Ложь;
	КонецЕсли;

	//ставка и начисления педагогу — только руководителю; у менеджера страница скрыта (начисление
	//считается при записи урока и без неё)
	ДоступнаЗарплата = УЗ_Общий.ДоступнаЗарплата();
	Элементы.СтавкаПедагога.Видимость = ДоступнаЗарплата;
	Элементы.ГруппаНачисленияПедагогу.Видимость = ДоступнаЗарплата;

КонецПроцедуры
Функция ПроверитьДокументПоГрафикуРабочегоВремени()	
	Возврат Документы.УЗ_Урок.ПроверитьДокументПоГрафикуРабочегоВремени(Объект);	
КонецФункции 
Процедура ПересчитатьТабличнуюЧасть()
	
	Документы.УЗ_Урок.РассчитатьТабличнуюЧасть(Объект);
	
	Объект.Сумма 		= Объект.Ученики.Итог("Сумма");
	Объект.СуммаСкидки 	= Объект.Ученики.Итог("СуммаСкидки");
	
	Объект.Окончание = Объект.Дата + Окр(Объект.КоличествоЧасов * 60) * 60;
	
КонецПроцедуры

