&НаКлиенте
Перем ЗаписьУрокаПодтверждена;

#Область ОбработчикиСобытийФормы

Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УЗ_ДатыЗапрета.ФормаПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
КонецПроцедуры

Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	//новый урок — на текущее время, а не на полночь; время из календаря/помощника не трогаем
	Если Объект.Ссылка.Пустая() Тогда
		//черновик из календаря: время, помещение, группа/педагог со ставкой, предмет, тариф — ЗначенияЗаполнения.
		//У реквизитов урока «Заполнять из данных заполнения» выключено (платформа их не заполняет), поэтому — здесь,
		//поимённо, до расчёта длительности «Ч:ММ» ниже
		ЗначенияЗаполнения = Неопределено;
		Если Параметры.Свойство("ЗначенияЗаполнения", ЗначенияЗаполнения)
			И ТипЗнч(ЗначенияЗаполнения) = Тип("Структура") Тогда
			Для Каждого Имя Из СтрРазделить(
				"ГруппаОбучения,Педагог,СтавкаПедагога,ПредметОбучения,Тариф,Помещение,КоличествоЧасов", ",") Цикл
				Если ЗначенияЗаполнения.Свойство(Имя) И ЗначениеЗаполнено(ЗначенияЗаполнения[Имя]) Тогда
					Объект[Имя] = ЗначенияЗаполнения[Имя];
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Параметры.Свойство("Дата") И ЗначениеЗаполнено(Параметры.Дата) Тогда
			Объект.Дата = Параметры.Дата;
		ИначеЕсли Объект.Дата = НачалоДня(Объект.Дата) Тогда
			Сейчас = НачалоМинуты(ТекущаяДатаСеанса());
			Объект.Дата = НачалоДня(?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, Сейчас))
				+ (Сейчас - НачалоДня(Сейчас));
		КонецЕсли;
	КонецЕсли;

	//дата запрета: «только просмотр» ставит ПриЧтенииНаСервере (УЗ_ДатыЗапрета)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации";
	Если Запрос.Выполнить().Пустой() Тогда
		Элементы.Организация.Видимость = Ложь;
	КонецЕсли;

	//ставка и начисления педагогу — только руководителю; у менеджера страница скрыта (начисление по ставке
	//считает проведение урока, в уроке оно не хранится — R24)
	ДоступнаЗарплата = УЗ_Общий.ДоступнаЗарплата();
	Элементы.СтавкаПедагога.Видимость = ДоступнаЗарплата;
	Элементы.ГруппаНачисленияПедагогу.Видимость = ДоступнаЗарплата;
	ПересчитатьНачисленияПедагога();

	//длительность на экране — «Ч:ММ» (реквизит формы), в объекте — число часов
	Длительность = УЗ_ОбщийКлиентСервер.ВремяИзЧасов(Объект.КоличествоЧасов);
	Если Объект.Ссылка.Пустая() И Не ЗначениеЗаполнено(Объект.Окончание) И Объект.КоличествоЧасов > 0 Тогда
		Объект.Окончание = Объект.Дата + Окр(Объект.КоличествоЧасов * 60) * 60; //«до» у черновика из календаря
	КонецЕсли;
	//остаток по предмету: плюс — цветом плюса со знаком, минус — цветом минуса, ноль — пусто
	УЗ_Общий.ОформитьОстатокДенег(УсловноеОформление, "УченикиЗадолженностьПоПредмету",
		"Объект.Ученики.ЗадолженностьПоПредмету");
	ОбновитьЗаголовокУчеников();
	ОбновитьКолонкиАбонементов();

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	Длительность = УЗ_ОбщийКлиентСервер.ВремяИзЧасов(Объект.КоличествоЧасов);
	ПересчитатьНачисленияПедагога();
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	Оповестить("ЗакрытьФормуУрока");
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	//будущий урок «Провести» не проводит, а записывает планом — как в типовых (факт услуги
	//фиксируется после занятия); запрет на сервере остаётся для обработок и обменов (В10)
	//решение «план или факт» — по часам сервера (сеанса), а не компьютера пользователя (Codex Т2)
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение И УрокЕщеНеНачался(Объект.Дата) Тогда
		//проведённый урок, перенесённый в будущее, — снять проведение: простая запись оставила бы
		//прошлые движения (списание ученика, зарплату педагога) на старой дате
		ПараметрыЗаписи.РежимЗаписи = ?(Объект.Проведен, РежимЗаписиДокумента.ОтменаПроведения,
			РежимЗаписиДокумента.Запись);
		//пояснение — после записи: показанное здесь перекрывало стандартное оповещение «Изменение»
		ПараметрыЗаписи.Вставить("ЗаписанКакПлан", Истина);
	КонецЕсли;

	Если ЗаписьУрокаПодтверждена = Истина Тогда
		ЗаписьУрокаПодтверждена = Ложь;
		Возврат;
	КонецЕсли;
	ТекстПредупреждения = "";

	// Проверка
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение и ЗначениеЗаполнено(Объект.Педагог) Тогда

		НомерБезНулей = Объект.Номер;
		Пока Найти(НомерБезНулей,"0") = 1 Цикл
			НомерБезНулей = Сред(НомерБезНулей,2); //удаляет лидирующие нули
		КонецЦикла;

		ИтогПроверки = ПроверитьДокументПоГрафикуРабочегоВремени();

		Если ИтогПроверки <> Неопределено Тогда

			ТекстОповещения = "Урок № "+НомерБезНулей+ " от " +Формат(Объект.Дата,"ДФ=dd.MM.yyyy")+ " с "
				+Формат(Объект.Дата,"ДФ=HH:mm")+
			" по " +Формат(Объект.Дата + Окр(Объект.КоличествоЧасов * 60) * 60,"ДФ=HH:mm")
				+ " не входит в график учета рабочего времени педагога "
			+ИтогПроверки.Педагог+ " (" +Формат(ИтогПроверки.Дата,"ДФ='ММММ гггг ""г"".'")+ ") !!!";

			ТекстПредупреждения = ТекстОповещения;

		КонецЕсли;

		//пересечение по педагогу/помещению не спрашиваем: проведение отказывает само, сообщение — у поля
		//(Документы.УЗ_Урок.ПроверкаПересечений)

	КонецЕсли;

	Если Не ПустаяСтрока(ТекстПредупреждения) Тогда
		Отказ = Истина;
		ПараметрыОповещения = Новый Структура("ПараметрыЗаписи", ПараметрыЗаписи);
		Оповещение = Новый ОписаниеОповещения("ПередЗаписьюЗавершение", ЭтотОбъект, ПараметрыОповещения);
		ПоказатьВопрос(Оповещение, ТекстПредупреждения + Символы.ПС + "Продолжить запись урока?",
			РежимДиалогаВопрос.ДаНет, 0);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьВидимостьРасходы();
	ОбновитьВидимость();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДвиженияДокумента(Команда)
	ДанныеС = Новый Структура;
	ДанныеС.Вставить("Документ",Объект.Ссылка);
	ОткрытьФорму("Отчет.УЗ_ДвиженияДокумента.Форма.ДвиженияДокумента",ДанныеС ,ЭтаФорма, , , , ,
		РежимОткрытияОкнаФормы.Независимый);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РассчитатьЗадолженность(Ученик, ПредметОбучения)

	Если Не ЗначениеЗаполнено(Ученик) или Не ЗначениеЗаполнено(ПредметОбучения) Тогда
		Возврат 0;
	КонецЕсли;

	//В12: остаток денег ученика по предмету — в организации урока (деньги учеников раздельно по организациям)
	Возврат УЗ_Сервер.ОстатокДенегУченика(Ученик, Объект.Организация, ПредметОбучения);

КонецФункции

Функция ОткрытьВзаиморасчетыНаСервере(Ученик)

	Возврат УЗ_Общий.ПараметрыОткрытияОтчета("УЗ_Взаиморасчеты", Новый Структура("Клиент, ПредметОбучения", Ученик,
		Объект.ПредметОбучения));
КонецФункции

//Вкладка «Ученики (5)» — сколько записано на урок.
&НаСервере
Процедура ОбновитьЗаголовокУчеников()
	Количество = Объект.Ученики.Количество();
	Элементы.ГруппаУченикиСтраница.Заголовок = ?(Количество = 0, "Ученики", СтрШаблон("Ученики (%1)", Количество));
КонецПроцедуры

//Колонки «Абонемент» и «Остаток абонемента» — только если хоть у одной строки есть абонемент: у разовых
//учеников они пустые и только занимают место.
&НаСервере
Процедура ОбновитьКолонкиАбонементов()
	ЕстьАбонементы = Ложь;
	Для Каждого Стр Из Объект.Ученики Цикл
		Если ЗначениеЗаполнено(Стр.Абонемент) Тогда
			ЕстьАбонементы = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Элементы.УченикиАбонемент.Видимость = ЕстьАбонементы;
	Элементы.УченикиОстатокАбонемента.Видимость = ЕстьАбонементы;
КонецПроцедуры

Функция ПроверитьДокументПоГрафикуРабочегоВремени()
	Возврат Документы.УЗ_Урок.ПроверитьДокументПоГрафикуРабочегоВремени(Объект);
КонецФункции

Процедура ПересчитатьТабличнуюЧасть()

	Документы.УЗ_Урок.РассчитатьТабличнуюЧасть(Объект);

	Объект.Сумма 		= Объект.Ученики.Итог("Сумма");
	Объект.СуммаСкидки 	= Объект.Ученики.Итог("СуммаСкидки");

	Объект.Окончание = Объект.Дата + Окр(Объект.КоличествоЧасов * 60) * 60;
	Длительность = УЗ_ОбщийКлиентСервер.ВремяИзЧасов(Объект.КоличествоЧасов);
	ОбновитьЗаголовокУчеников();

КонецПроцедуры

//Начало урока ещё не наступило — по ТекущаяДатаСеанса, как проверка проведения в модуле объекта (В10).
&НаСервереБезКонтекста
Функция УрокЕщеНеНачался(Знач ДатаУрока)
	Возврат ДатаУрока > ТекущаяДатаСеанса();
КонецФункции

&НаКлиенте
Процедура ПередЗаписьюЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаписьУрокаПодтверждена = Истина;
		Записать(ДополнительныеПараметры.ПараметрыЗаписи);
	КонецЕсли;

КонецПроцедуры

Процедура ОбновитьВидимость()

	Для Каждого Стр из Объект.Ученики Цикл
		Стр.ЗадолженностьПоПредмету = РассчитатьЗадолженность(Стр.Ученик, Объект.ПредметОбучения);
	КонецЦикла;
	ОбновитьОстаткиБонусов();
	ОбновитьОстаткиАбонементов();
	ОбновитьЗаголовокУчеников();

	ПоказатьКартинки();

КонецПроцедуры

Процедура ПоказатьКартинки()

	КартинкаПредметаОбучения = ?(ЗначениеЗаполнено(Объект.ПредметОбучения),
		УЗ_Общий.АдресФото(Объект.ПредметОбучения.Фото), "");

КонецПроцедуры

#Область Ученики

&НаКлиенте
Процедура Подбор(Команда)

	УЗ_ОбщийКлиент.ПодобратьУчеников(ЭтотОбъект, Новый ОписаниеОповещения("ПодборУчениковЗавершение", ЭтотОбъект));
КонецПроцедуры

&НаКлиенте
Процедура ПодборУчениковЗавершение(Результат,Параметры) Экспорт
	Если Результат <> Неопределено Тогда
		ДобавитьВыбранных(Результат);
		ПересчитатьТабличнуюЧасть();
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьВыбранных(Выбранные)

	//из подбора приходит массив, из обычного выбора — одна ссылка (раньше она молча терялась в Попытке)
	Если ТипЗнч(Выбранные) = Тип("Массив") Тогда
		Список = Выбранные;
	Иначе
		Список = Новый Массив;
		Список.Добавить(Выбранные);
	КонецЕсли;
	//строка ученика заполняется как при выборе ученика в строке: тариф (из карточки или тариф урока), скидка,
	//дисконтная карта (прежде тариф оставался пустым — строка «К оплате» проводилась бы бесплатно)
	Карты = ДисконтныеКартыУчеников(Список);
	Для Каждого Стр из Список Цикл
		НовСтр = Объект.Ученики.Добавить();
		НовСтр.Ученик 			= Стр;
		НовСтр.Тариф 			= ВернутьТариф(Стр);
		НовСтр.Скидка 			= ВернутьСкидку(Стр);
		НовСтр.ДисконтнаяКарта =
			?(Карты[Стр] = Неопределено, Справочники.УЗ_ДисконтныеКарты.ПустаяСсылка(), Карты[Стр]);
	КонецЦикла;
	ПодставитьАбонементы();

КонецПроцедуры

//Абонемент строк — на дату урока, единой функцией (Справочники.УЗ_Абонемент.ПодставитьАбонементы): при выборе и
//подборе ученика, смене даты, предмета, группы, организации. Абонемент строки, который действует и которого
//хватает, остаётся; исчерпан или приостановлен — строка по тарифу с предупреждением (В16).
Процедура ПодставитьАбонементы()

	Для Каждого Предупреждение Из Справочники.УЗ_Абонемент.ПодставитьАбонементы(Объект) Цикл
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(Предупреждение);
	КонецЦикла;
	ОбновитьОстаткиАбонементов();

КонецПроцедуры

//Остаток абонемента строки — тем же текстом, что в карточке абонемента, помощнике и панели ученика.
Процедура ОбновитьОстаткиАбонементов()

	Для Каждого Стр Из Объект.Ученики Цикл
		Стр.ОстатокАбонемента = Справочники.УЗ_Абонемент.ТекстОстатка(Стр.Абонемент);
	КонецЦикла;
	ОбновитьКолонкиАбонементов();

КонецПроцедуры

&НаКлиенте
Процедура УченикиАбонементПриИзменении(Элемент)
	ОбновитьОстаткиАбонементов();
	ПересчитатьТабличнуюЧасть();
КонецПроцедуры

&НаКлиенте
Процедура УченикиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	ДобавитьВыбранных(ВыбранноеЗначение);

	ПересчитатьТабличнуюЧасть();

КонецПроцедуры

&НаКлиенте
Процедура УченикиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	ТекДанные = Элементы.Ученики.ТекущиеДанные;

	Если Поле.Имя = "УченикиЗадолженностьПоПредмету" Тогда
		ПараметрыОткрытия = ОткрытьВзаиморасчетыНаСервере(ТекДанные.Ученик);
		ОткрытьФорму("Отчет.УЗ_Взаиморасчеты.Форма", ПараметрыОткрытия, ЭтаФорма);
	ИначеЕсли Поле.Имя = "Ученики1ОстатокБонусов" Тогда
		ОткрытьФорму("Отчет.УЗ_ОтчетПоДисконтнымКартам.Форма", , ЭтаФорма);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УченикиУченикСоздание(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ПараметрыСтроки = Новый Структура;

	Назв = СокрЛП(Элемент.ТекстРедактирования);

	Если Найти(Назв," ") > 0 Тогда
		Симв1 = Найти(Назв," ");
		ПараметрыСтроки.Вставить("Наименование",Лев(Назв,Симв1-1));
		Назв = СокрЛП(Сред(Назв,Симв1+1));
	Иначе
		ПараметрыСтроки.Вставить("Наименование",Назв);
		Назв = "";
	КонецЕсли;

	ПараметрыСтроки.Вставить("Группа","Ученики");

	Пар = Новый Структура("Ключ2", ПараметрыСтроки);

	ОткрытьФорму("Справочник.УЗ_ФизЛица.Форма.ФормаЭлемента",Пар,ЭтотОбъект,ЭтаФорма.УникальныйИдентификатор,
		ВариантОткрытияОкна.ОтдельноеОкно,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура УченикиУченикПриИзменении(Элемент)

	ТекДанные = Элементы.Ученики.ТекущиеДанные;

	ТекДанные.ДисконтнаяКарта 	= НайтиДисконтнуюКарту(ТекДанные.Ученик);
	ТекДанные.Скидка 			= ВернутьСкидку(ТекДанные.Ученик);
	ТекДанные.Тариф 			= ВернутьТариф(ТекДанные.Ученик);

	ПодставитьАбонементы();
	ПересчитатьТабличнуюЧасть();

КонецПроцедуры

Функция ВернутьСкидку(Ученик)
	Возврат Ученик.Скидка;
КонецФункции

//В20: тариф ученика, иначе тариф группы, иначе тариф урока — общей функцией (абонемент строки главнее тарифа)
Функция ВернутьТариф(Ученик)

	Возврат Документы.УЗ_Урок.ТарифНовойСтроки(Ученик, Объект.ГруппаОбучения, Объект.Тариф);

КонецФункции

