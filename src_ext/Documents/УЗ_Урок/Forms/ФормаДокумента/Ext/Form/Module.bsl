Процедура НачисленияПедагогуВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Строка = НачисленияПедагогу.НайтиПоИдентификатору(ВыбраннаяСтрока);
