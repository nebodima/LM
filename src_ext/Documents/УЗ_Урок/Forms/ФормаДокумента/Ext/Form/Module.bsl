//R24: страница «Начисления педагогу» (только руководителю) — начисление по ставке, как его запишет проведение
//(Документы.УЗ_Урок.НачисленияПоСтавке), и доплаты сверх ставки: проведённые документы «Начисление педагогам» на
//основании урока. Урок начисление не хранит — таблица только для просмотра; у менеджера страница скрыта и данные
//не читаются.
&НаСервере
Процедура ПересчитатьНачисленияПедагога()

	НачисленияПедагогу.Очистить();
	Если Не Элементы.ГруппаНачисленияПедагогу.Видимость Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Начисление Из Документы.УЗ_Урок.НачисленияПоСтавке(Объект) Цикл
		Строка = НачисленияПедагогу.Добавить();
		Строка.Документ = Объект.Ссылка;
		Строка.Комментарий = Начисление.Комментарий;
		Строка.СуммаНачисления = Начисление.Сумма;
	КонецЦикла;
	Если Не Объект.Ссылка.Пустая() Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Строки.Ссылка КАК Документ,
		|	Строки.Комментарий КАК Комментарий,
		|	Строки.Сумма КАК СуммаНачисления
		|ИЗ
		|	Документ.УЗ_НачисленияПедагогам.НачисленияПедагогам КАК Строки
		|ГДЕ
		|	Строки.Ссылка.ДокументОснования = &Урок
		|	И Строки.Ссылка.Проведен
		|
		|УПОРЯДОЧИТЬ ПО
		|	Строки.Ссылка.Дата,
		|	Строки.НомерСтроки";
		Запрос.УстановитьПараметр("Урок", Объект.Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(НачисленияПедагогу.Добавить(), Выборка);
		КонецЦикла;
	КонецЕсли;
	Итого = НачисленияПедагогу.Итог("СуммаНачисления");
	Элементы.ГруппаНачисленияПедагогу.Заголовок = ?(Итого = 0, НСтр("ru = 'Начисления педагогу'"),
		НСтр("ru = 'Педагогу:'") + " " + Формат(Итого, "ЧДЦ=2; ЧН=0,00"));

КонецПроцедуры

