#Region Ученики

&НаКлиенте
Процедура Подбор(Команда)
	
	ОП = Новый ОписаниеОповещения("ПодборУчениковЗавершение",ЭтотОбъект);
	ПП = Новый Структура("МножественныйВыбор",Истина);
	Отбор = Новый Структура("Родитель",ВернутьПапкуУченики());
	ПП.Вставить("Отбор", Отбор); 
	ОткрытьФорму("Справочник.УЗ_ФизЛица.Форма.ФормаВыбора",ПП,ЭтотОбъект,,,,ОП,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры
Функция ВернутьПапкуУченики()
	Возврат Справочники.УЗ_ФизЛица.Ученики.Ссылка;
КонецФункции
&НаКлиенте
Процедура ПодборУчениковЗавершение(Результат,Параметры) Экспорт
	Если Результат <> Неопределено Тогда
		ДобавитьВыбранных(Результат);
		ПересчитатьТабличнуюЧасть();
	КонецЕсли;
КонецПроцедуры
Процедура ДобавитьВыбранных(Выбранные)
	
	//из подбора приходит массив, из обычного выбора — одна ссылка (раньше она молча терялась в Попытке)
	Если ТипЗнч(Выбранные) = Тип("Массив") Тогда
		Список = Выбранные;
	Иначе
		Список = Новый Массив;
		Список.Добавить(Выбранные);
	КонецЕсли;
	//строка ученика заполняется как при выборе ученика в строке: тариф (из карточки или тариф урока), скидка,
	//дисконтная карта (прежде тариф оставался пустым — строка «К оплате» проводилась бы бесплатно)
	Для Каждого Стр из Список Цикл
		НовСтр = Объект.Ученики.Добавить();
		НовСтр.Ученик 			= Стр;
		НовСтр.Тариф 			= ВернутьТариф(Стр);
		НовСтр.Скидка 			= ВернутьСкидку(Стр);
		НовСтр.ДисконтнаяКарта 	= НайтиДисконтнуюКарту(Стр);
	КонецЦикла;
	ПодставитьАбонементы();

КонецПроцедуры

//Абонемент строк — на дату урока, единой функцией (Справочники.УЗ_Абонемент.ПодставитьАбонементы): при выборе и
//подборе ученика, смене даты, предмета, группы, организации. Абонемент строки, который действует и которого
//хватает, остаётся; исчерпан или приостановлен — строка по тарифу с предупреждением (В16).
Процедура ПодставитьАбонементы()

	Для Каждого Предупреждение Из Справочники.УЗ_Абонемент.ПодставитьАбонементы(Объект) Цикл
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(Предупреждение);
	КонецЦикла;
	ОбновитьОстаткиАбонементов();

КонецПроцедуры

//Остаток абонемента строки — тем же текстом, что в карточке абонемента, помощнике и панели ученика.
Процедура ОбновитьОстаткиАбонементов()

	Для Каждого Стр Из Объект.Ученики Цикл
		Стр.ОстатокАбонемента = Справочники.УЗ_Абонемент.ТекстОстатка(Стр.Абонемент);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УченикиАбонементПриИзменении(Элемент)
	ОбновитьОстаткиАбонементов();
	ПересчитатьТабличнуюЧасть();
КонецПроцедуры
&НаКлиенте
Процедура УченикиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ДобавитьВыбранных(ВыбранноеЗначение);
	
	ПересчитатьТабличнуюЧасть();
	
КонецПроцедуры
&НаКлиенте
Процедура УченикиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Ученики.ТекущиеДанные;
	
	Если Поле.Имя = "УченикиЗадолженностьПоПредмету" Тогда
		ПараметрыОткрытия = ОткрытьВзаиморасчетыНаСервере(ТекДанные.Ученик);
		ОткрытьФорму("Отчет.УЗ_Взаиморасчеты.Форма", ПараметрыОткрытия, ЭтаФорма);
	ИначеЕсли Поле.Имя = "Ученики1ОстатокБонусов" Тогда
		ОткрытьФорму("Отчет.УЗ_ОтчетПоДисконтнымКартам.Форма", , ЭтаФорма);	
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура УченикиУченикСоздание(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыСтроки = Новый Структура;
	
	Назв = СокрЛП(Элемент.ТекстРедактирования);
	
	Если Найти(Назв," ") > 0 Тогда
		Симв1 = Найти(Назв," ");
		ПараметрыСтроки.Вставить("Наименование",Лев(Назв,Симв1-1));
		Назв = СокрЛП(Сред(Назв,Симв1+1));
	Иначе
		ПараметрыСтроки.Вставить("Наименование",Назв);
		Назв = "";
	КонецЕсли;
	
	ПараметрыСтроки.Вставить("Группа","Ученики");
	
	Пар = Новый Структура("Ключ2", ПараметрыСтроки);
	
	ОткрытьФорму("Справочник.УЗ_ФизЛица.Форма.ФормаЭлемента",Пар,ЭтотОбъект,ЭтаФорма.УникальныйИдентификатор,ВариантОткрытияОкна.ОтдельноеОкно,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры
&НаКлиенте
Процедура УченикиУченикПриИзменении(Элемент)
	
	ТекДанные = Элементы.Ученики.ТекущиеДанные;
	
	ТекДанные.ДисконтнаяКарта 	= НайтиДисконтнуюКарту(ТекДанные.Ученик);
	ТекДанные.Скидка 			= ВернутьСкидку(ТекДанные.Ученик);
	ТекДанные.Тариф 			= ВернутьТариф(ТекДанные.Ученик);

	ПодставитьАбонементы();
	ПересчитатьТабличнуюЧасть();
	
КонецПроцедуры
Функция ВернутьСкидку(Ученик)
	Возврат Ученик.Скидка;
КонецФункции
//В20: тариф ученика, иначе тариф группы, иначе тариф урока — общей функцией (абонемент строки главнее тарифа)
Функция ВернутьТариф(Ученик)

	Возврат Документы.УЗ_Урок.ТарифНовойСтроки(Ученик, Объект.ГруппаОбучения, Объект.Тариф);

КонецФункции

&НаКлиенте
Процедура ПересчитатьЦеныПоТарифу(Команда)
	
	Для Каждого Стр из Объект.Ученики Цикл
		Стр.ЦенаТарифа = 0;
		Стр.СуммаСкидки = 0;
		Стр.Сумма = 0;
	КонецЦикла;
	
	ПересчитатьТабличнуюЧасть();
	
КонецПроцедуры

