//Остаток бонусов каждой строки учеников (ученик + его дисконтная карта, по всем организациям) — одним запросом
//на всю таблицу (прежде — запрос, а с клиента ещё и вызов сервера, на каждую строку).
&НаСервере
Процедура ОбновитьОстаткиБонусов()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Клиент КАК Клиент,
	|	Остатки.ДисконтнаяКарта КАК ДисконтнаяКарта,
	|	СУММА(Остатки.СуммаБонусовОстаток) КАК Остаток
	|ИЗ
	|	РегистрНакопления.УЗ_ДвижениеДисконтныхКарт.Остатки(, ДисконтнаяКарта В (&Карты)) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Клиент,
	|	Остатки.ДисконтнаяКарта";
	Запрос.УстановитьПараметр("Карты",
		Объект.Ученики.Выгрузить(, "ДисконтнаяКарта").ВыгрузитьКолонку("ДисконтнаяКарта"));
	Остатки = Запрос.Выполнить().Выгрузить();
	Для Каждого Стр Из Объект.Ученики Цикл
		Найдено = Остатки.НайтиСтроки(Новый Структура("Клиент, ДисконтнаяКарта", Стр.Ученик, Стр.ДисконтнаяКарта));
		Стр.ОстатокБонусов = ?(Найдено.Количество() = 0 Или Не ЗначениеЗаполнено(Стр.Ученик)
			Или Не ЗначениеЗаполнено(Стр.ДисконтнаяКарта), 0, Найдено[0].Остаток);
	КонецЦикла;

КонецПроцедуры

//Дисконтные карты учеников, действующие на дату урока: Соответствие Ученик → карта (у ученика ровно одна
//такая карта; нет или несколько — ученика в соответствии нет, как в НайтиДисконтнуюКарту).
&НаСервере
Функция ДисконтныеКартыУчеников(Ученики)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДисконтныеКарты.Владелец КАК Владелец,
	|	МАКСИМУМ(ДисконтныеКарты.Ссылка) КАК Ссылка,
	|	КОЛИЧЕСТВО(ДисконтныеКарты.Ссылка) КАК Карт
	|ИЗ
	|	Справочник.УЗ_ДисконтныеКарты КАК ДисконтныеКарты
	|ГДЕ
	|	ДисконтныеКарты.Владелец В (&Владельцы)
	|	И (ДисконтныеКарты.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ДисконтныеКарты.ДатаОкончанияДействия >= &НачалоДняУрока)
	|	И ДисконтныеКарты.ДатаНачалаДействия <= &ДатаУрока
	|	И НЕ ДисконтныеКарты.НеДействует
	|	И НЕ ДисконтныеКарты.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	ДисконтныеКарты.Владелец";
	ДатаУрока = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Владельцы", Ученики);
	Запрос.УстановитьПараметр("НачалоДняУрока", НачалоДня(ДатаУрока));
	Запрос.УстановитьПараметр("ДатаУрока", ДатаУрока);
	Итог = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Карт = 1 Тогда
			Итог.Вставить(Выборка.Владелец, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

Функция НайтиДисконтнуюКарту(Ученик)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДисконтныеКарты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.УЗ_ДисконтныеКарты КАК ДисконтныеКарты
	|ГДЕ
	|	ДисконтныеКарты.Владелец = &Владелец
	|	И (ДисконтныеКарты.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ДисконтныеКарты.ДатаОкончанияДействия >= &НачалоДняУрока)
	|	И ДисконтныеКарты.ДатаНачалаДействия <= &ДатаУрока
	|	И НЕ ДисконтныеКарты.НеДействует
	|	И ДисконтныеКарты.ПометкаУдаления = ЛОЖЬ";
	//срок — как при проведении (Документы.УЗ_ПриходДенег.ПроверитьСрокДисконтнойКарты): бессрочная карта
	//и карта, действующая по день урока включительно, подходят
	ДатаУрока = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Владелец", Ученик);
	Запрос.УстановитьПараметр("НачалоДняУрока", НачалоДня(ДатаУрока));
	Запрос.УстановитьПараметр("ДатаУрока", ДатаУрока);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();

	Если РезультатЗапроса.Количество()=1 Тогда
		Возврат РезультатЗапроса[0].Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область ПрочиеСобытия

&НаКлиенте
Процедура УченикиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	ТекДанные = Элементы.Ученики.ТекущиеДанные;
	Если Копирование Тогда
		ТекДанные.ЗадолженностьПоПредмету = 0;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ОбновитьВидимость();
	Если ПараметрыЗаписи.Свойство("ЗаписанКакПлан") Тогда
		УЗ_ПоказатьПослеЗаписи(НСтр("ru = 'Урок записан как план'"),
			СтрШаблон(НСтр("ru = 'Урок начинается %1 — провести его можно после занятия.'"),
				Формат(Объект.Дата, "ДФ='dd.MM.yyyy HH:mm'")));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СделатьОплаченными(Команда)

	Для Каждого Стр из Объект.Ученики Цикл
		Стр.СписатьОплату = Истина;
	КонецЦикла;
	ПересчитатьПослеОтметок();

КонецПроцедуры

&НаКлиенте
Процедура СделатьПосещенными(Команда)
	Для Каждого Стр из Объект.Ученики Цикл
		Стр.Явка = Истина;
	КонецЦикла;
	ПересчитатьПослеОтметок();
КонецПроцедуры

//суммы строк и начисления педагогу — сразу на форме, как при отметке одной строки (прежде до записи
//на экране оставались старые суммы)
&НаКлиенте
Процедура ПересчитатьПослеОтметок()
	ПересчитатьТабличнуюЧасть();
	ПересчитатьНачисленияПедагога();
КонецПроцедуры

#КонецОбласти

#КонецОбласти
