КонецПроцедуры
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	Если ЗаписьУрокаПодтверждена = Истина Тогда
		ЗаписьУрокаПодтверждена = Ложь;
		Возврат;
	КонецЕсли;
	ТекстПредупреждения = "";

	// Проверка
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение и ЗначениеЗаполнено(Объект.Педагог) Тогда
		
		НомерБезНулей = Объект.Номер;
		Пока Найти(НомерБезНулей,"0") = 1 Цикл
			НомерБезНулей = Сред(НомерБезНулей,2); //удаляет лидирующие нули
		КонецЦикла;
			
		ИтогПроверки = ПроверитьДокументПоГрафикуРабочегоВремени();
		
		Если ИтогПроверки <> Неопределено Тогда 			
			
			ТекстОповещения = "Урок № "+НомерБезНулей+ " от " +Формат(Объект.Дата,"ДФ=dd.MM.yyyy")+ " с " +Формат(Объект.Дата,"ДФ=HH:mm")+ 
			" по " +Формат(Объект.Дата + Окр(Объект.КоличествоЧасов * 60) * 60,"ДФ=HH:mm") + " не входит в график учета рабочего времени педагога " 
			+ИтогПроверки.Педагог+ " (" +Формат(ИтогПроверки.Дата,"ДФ='ММММ гггг ""г"".'")+ ") !!!";
			
			ТекстПредупреждения = ТекстОповещения;
			
		КонецЕсли;
		
		//пересечение по педагогу/помещению не спрашиваем: проведение отказывает само, сообщение — у поля
		//(Документы.УЗ_Урок.ПроверкаПересечений)

	КонецЕсли;

	Если Не ПустаяСтрока(ТекстПредупреждения) Тогда
		Отказ = Истина;
		ПараметрыОповещения = Новый Структура("ПараметрыЗаписи", ПараметрыЗаписи);
		Оповещение = Новый ОписаниеОповещения("ПередЗаписьюЗавершение", ЭтотОбъект, ПараметрыОповещения);
		ПоказатьВопрос(Оповещение, ТекстПредупреждения + Символы.ПС + "Продолжить запись урока?",
			РежимДиалогаВопрос.ДаНет, 0);
	КонецЕсли;

КонецПроцедуры

