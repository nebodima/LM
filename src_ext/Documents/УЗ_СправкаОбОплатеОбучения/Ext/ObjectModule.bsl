//Справка об оплате обучения (КНД 1151158, В42): не проводится, движений нет — это выданный документ. Отказы
//записи (Документы.УЗ_СправкаОбОплатеОбучения.ПричиныОтказа) проверяются при любой записи — из формы и программной:
//организация без лицензии и не ИП, который учит сам; налогоплательщик без ИНН и без документа; сумма 0.
//Аудит Codex 2.1 (30.09.2026, находки 2–4): печать фиксирует выдачу («Выдана») — выданную не переписывают и не
//удаляют; корректирующая и аннулирующая — только к выданной первичной («Исходная справка»); справки супругов за
//обучающегося вместе — не больше их общих расходов.

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = РегистрыСведений.УЗ_Настройки.Настройки().Организация;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Год) Тогда
		//справку чаще просят в начале года за прошедший
		Сегодня = ТекущаяДатаСеанса();
		Год = Число(Формат(Сегодня, "ДФ=yyyy")) - ?(Месяц(Сегодня) <= 4, 1, 0);
	КонецЕсли;
	//на основании ученика: обучающийся — он, налогоплательщик — основной плательщик (нет — сам ученик)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.УЗ_ФизЛица") И ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Обучающийся = ДанныеЗаполнения;
		Налогоплательщик = Справочники.УЗ_ФизЛица.ОсновнойПлательщик(ДанныеЗаполнения);
		Если НЕ ЗначениеЗаполнено(Налогоплательщик) Тогда
			Налогоплательщик = ДанныеЗаполнения;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
	КонецЕсли;
	ЗаполнитьПоУчету();

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	//копия — корректирующая справка к той же справке (п. 18–19): номер справки тот же, корректировка — следующая,
	//сумма — по кассе на сегодня; исходная — первичная справка (у копии корректирующей — её исходная)
	АвторДокумента = Неопределено;
	Комментарий = "";
	Выдана = Ложь;
	НапечатаннаяСправка = Новый ХранилищеЗначения(Неопределено);
	ИсходнаяСправка = ?(ЗначениеЗаполнено(ОбъектКопирования.ИсходнаяСправка), ОбъектКопирования.ИсходнаяСправка,
		ОбъектКопирования.Ссылка);
	НомерКорректировки = Документы.УЗ_СправкаОбОплатеОбучения.СледующийНомерКорректировки(Организация, Год,
		НомерСправки);
	Сумма = 0;
	ЗаполнитьПоУчету();

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	//созданный программно без даты — на сейчас (форма ставит дату сама)
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(АвторДокумента) Тогда
		АвторДокумента = УЗ_Среда.ТекущийПользователь();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = РегистрыСведений.УЗ_Настройки.Настройки().Организация;
	КонецЕсли;
	//находка 3: выданная справка — бумага на руках у налогоплательщика
	Если НЕ ЭтоНовый() И ПроверитьВыданную(Отказ) Тогда
		Возврат;
	КонецЕсли;
	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	ПроверитьИсходнуюСправку(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	//программно созданная справка без суммы — по кассе
	Если Сумма = 0 И НомерКорректировки <> 999 Тогда
		ЗаполнитьПоУчету();
	КонецЕсли;

	Данные = Документы.УЗ_СправкаОбОплатеОбучения.ДанныеСправки(ЭтотОбъект);
	Если НЕ ЗначениеЗаполнено(Ответственный) Тогда
		Ответственный = Данные.Ответственный;
	КонецЕсли;
	Для Каждого Причина Из Документы.УЗ_СправкаОбОплатеОбучения.ПричиныОтказа(Данные) Цикл
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(Причина, , , Отказ);
	КонецЦикла;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("Документ.УЗ_СправкаОбОплатеОбучения");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

	//новый номер — только первичной (у корректирующей — номер исходной, ПроверитьИсходнуюСправку)
	Если НомерСправки = 0 И НомерКорректировки = 0 Тогда
		НомерСправки = Документы.УЗ_СправкаОбОплатеОбучения.СледующийНомерСправки(Организация, Год, Ссылка);
	КонецЕсли;
	ПроверитьПовтор(Отказ);
	//находка 2: справки супругов за обучающегося вместе — не больше их общих расходов (под той же блокировкой)
	Если НЕ Отказ И НомерКорректировки <> 999 Тогда
		Текст = Документы.УЗ_СправкаОбОплатеОбучения.ТекстПревышенияРасходовСупругов(ЭтотОбъект);
		Если ЗначениеЗаполнено(Текст) Тогда
			УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, Текст, "Сумма", Отказ);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

//Находка 3 аудита Codex 2.1: выданная (напечатанная) справка. Истина — справка выдана: печатаемое изменить нельзя
//(отказ с перечнем изменённого), пометить на удаление — нельзя (выданную отменяет аннулирующая, 999); комментарий —
//можно, остальные проверки записи тогда не нужны: печатаемое не менялось.
Функция ПроверитьВыданную(Отказ)

	Было = Документы.УЗ_СправкаОбОплатеОбучения.ВыданнаяСправка(Ссылка);
	Если Было = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Выдана = Истина;
	Представление = СтрШаблон(НСтр("ru = 'Справка № %1 (корректировка %2) за %3 год выдана'"),
		Формат(Было.НомерСправки, "ЧГ="), Формат(Было.НомерКорректировки, "ЧН=0; ЧГ="), Формат(Было.Год, "ЧГ="));
	Если ПометкаУдаления Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, СтрШаблон(НСтр("ru = '%1 — её не удаляют: выданную отменяет "
			+ "аннулирующая справка (корректирующая с номером корректировки 999).'"), Представление), , Отказ);
		Возврат Истина;
	КонецЕсли;
	Изменено = Новый Массив;
	Для Каждого КлючИЗначение Из Было Цикл
		Если ЭтотОбъект[КлючИЗначение.Ключ] = КлючИЗначение.Значение Тогда
			Продолжить;
		КонецЕсли;
		Реквизит = Метаданные().Реквизиты.Найти(КлючИЗначение.Ключ);
		Изменено.Добавить(?(Реквизит = Неопределено, НСтр("ru = 'дата'"), НРег(Реквизит.Синоним)));
	КонецЦикла;
	Если Изменено.Количество() > 0 Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, СтрШаблон(НСтр("ru = '%1 — что в ней напечатано, изменить нельзя "
			+ "(изменено: %2). Исправление — корректирующей справкой (кнопка «Корректирующая справка»).'"),
			Представление, СтрСоединить(Изменено, ", ")), , Отказ);
	КонецЕсли;
	Возврат Истина;

КонецФункции

//Находка 4 аудита Codex 2.1: корректирующая (1…998) и аннулирующая (999) справки — только к выданной первичной
//(«Исходная справка»): та же организация, год, налогоплательщик и обучающийся, номер справки — её. У первичной
//исходной нет.
Процедура ПроверитьИсходнуюСправку(Отказ)

	Если НомерКорректировки = 0 Тогда
		ИсходнаяСправка = Документы.УЗ_СправкаОбОплатеОбучения.ПустаяСсылка();
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ИсходнаяСправка) Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Корректирующая и аннулирующая справки оформляются "
			+ "к выданной первичной справке (в ней — кнопка «Корректирующая справка»): нет исходной справки. Новая "
			+ "справка — первичная, номер корректировки 0.'"), "НомерКорректировки", Отказ);
		Возврат;
	КонецЕсли;
	Исходная = Документы.УЗ_СправкаОбОплатеОбучения.РеквизитыИсходнойСправки(ИсходнаяСправка);
	Если Исходная = Неопределено Или Исходная.ПометкаУдаления Или Исходная.НомерКорректировки <> 0 Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, СтрШаблон(НСтр("ru = 'Исходная справка «%1» — не действующая "
			+ "первичная справка (помечена на удаление или сама корректирующая).'"), ИсходнаяСправка),
			"НомерКорректировки", Отказ);
		Возврат;
	КонецЕсли;
	Если НЕ Исходная.Выдана Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, СтрШаблон(НСтр("ru = 'Исходная справка № %1 ещё не выдана (не "
			+ "напечатана) — исправьте её саму, корректирующая не нужна.'"), Формат(Исходная.НомерСправки, "ЧГ=")),
			"НомерКорректировки", Отказ);
		Возврат;
	КонецЕсли;
	Если Исходная.Организация <> Организация Или Исходная.Год <> Год Или Исходная.Налогоплательщик <> Налогоплательщик
		Или Исходная.Обучающийся <> Обучающийся Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, СтрШаблон(НСтр("ru = 'Корректирующая справка — о тех же "
			+ "расходах, что исходная справка № %1: организация «%2», %3 год, налогоплательщик %4, обучающийся %5. "
			+ "Другие лица, год или организация — новая первичная справка.'"), Формат(Исходная.НомерСправки, "ЧГ="),
			Исходная.Организация, Формат(Исходная.Год, "ЧГ="), Исходная.Налогоплательщик, Исходная.Обучающийся), ,
			Отказ);
		Возврат;
	КонецЕсли;
	НомерСправки = Исходная.НомерСправки;

КонецПроцедуры

//Сумма (по кассе, кроме аннулирующей) и «Кем приходится» — по данным учёта.
Процедура ЗаполнитьПоУчету() Экспорт

	КемПриходится = Документы.УЗ_СправкаОбОплатеОбучения.КемПриходится(Обучающийся, Налогоплательщик);
	Если НомерКорректировки <> 999 Тогда
		Сумма = Документы.УЗ_СправкаОбОплатеОбучения.РасходыНаОбучение(Организация, Налогоплательщик, Обучающийся,
			Год, ОплатыСупруга);
	КонецЕсли;

КонецПроцедуры

//Повторы (п. 18–19): номер справки с номером корректировки в организации за год — один; первичная справка
//налогоплательщику за обучающегося за год — одна (вторая — корректирующей: «Скопировать» или «Корректирующая справка»).
Процедура ПроверитьПовтор(Отказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Справки.НомерСправки КАК НомерСправки,
	|	Справки.НомерКорректировки КАК НомерКорректировки,
	|	Справки.Налогоплательщик = &Налогоплательщик
	|		И Справки.Обучающийся = &Обучающийся КАК ТеЖеЛица
	|ИЗ
	|	Документ.УЗ_СправкаОбОплатеОбучения КАК Справки
	|ГДЕ
	|	Справки.Ссылка <> &Ссылка
	|	И НЕ Справки.ПометкаУдаления
	|	И Справки.Организация = &Организация
	|	И Справки.Год = &Год
	|	И (Справки.НомерСправки = &НомерСправки
	|				И Справки.НомерКорректировки = &НомерКорректировки
	|			ИЛИ &НомерКорректировки = 0
	|				И Справки.НомерКорректировки = 0
	|				И Справки.Налогоплательщик = &Налогоплательщик
	|				И Справки.Обучающийся = &Обучающийся)";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Год", Год);
	Запрос.УстановитьПараметр("НомерСправки", НомерСправки);
	Запрос.УстановитьПараметр("НомерКорректировки", НомерКорректировки);
	Запрос.УстановитьПараметр("Налогоплательщик", Налогоплательщик);
	Запрос.УстановитьПараметр("Обучающийся", Обучающийся);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	Если Выборка.НомерСправки = НомерСправки И Выборка.НомерКорректировки = НомерКорректировки Тогда
		Текст = СтрШаблон(НСтр("ru = 'Справка № %1 с номером корректировки %2 за %3 год уже есть.'"),
			Формат(НомерСправки, "ЧГ="), Формат(НомерКорректировки, "ЧН=0; ЧГ="), Формат(Год, "ЧГ="));
	Иначе
		Текст = СтрШаблон(НСтр("ru = 'Этому налогоплательщику за этого обучающегося за %1 год уже выдана справка "
			+ "№ %2 — оформите корректирующую («Корректирующая справка» в ней).'"),
			Формат(Год, "ЧГ="), Формат(Выборка.НомерСправки, "ЧГ="));
	КонецЕсли;
	УЗ_ОбщийКлиентСервер.СообщитьПользователю(Текст, , , Отказ);

КонецПроцедуры
