
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка.Пустая() И Объект.Дата = НачалоДня(Объект.Дата) Тогда
		Сейчас = НачалоМинуты(ТекущаяДатаСеанса());
		Объект.Дата = НачалоДня(?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, Сейчас)) + (Сейчас - НачалоДня(Сейчас));
	КонецЕсли;
	Если Не УЗ_Общий.ЕстьОрганизации() Тогда
		Элементы.Организация.Видимость = Ложь;
	КонецЕсли;
	ОбновитьПояснение();

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УЗ_ДатыЗапрета.ФормаПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	ОбновитьПояснение();
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ОбновитьПояснение();
КонецПроцедуры

//Под шапкой — что мешает выдать справку (отказы записи) и что проверить (предупреждения); пусто — всё в порядке.
&НаСервере
Процедура ОбновитьПояснение()

	Менеджер = Документы.УЗ_СправкаОбОплатеОбучения;
	Данные = Менеджер.ДанныеСправки(Объект);
	Тексты = Менеджер.ПричиныОтказа(Данные);
	Для Каждого Текст Из Менеджер.Предупреждения(Данные, Объект.КемПриходится) Цикл
		Тексты.Добавить(Текст);
	КонецЦикла;
	Элементы.Пояснение.Заголовок = СтрСоединить(Тексты, Символы.ПС);
	Элементы.Пояснение.ЦветТекста = ?(Менеджер.ПричиныОтказа(Данные).Количество() > 0,
		УЗ_ОбщийКлиентСервер.ЦветМинусаДенег(), УЗ_ОбщийКлиентСервер.ЦветПояснения());

КонецПроцедуры

//Сумма и «Кем приходится» — по кассе и плательщикам ученика (аннулирующая справка сумму не меняет).
&НаСервере
Процедура ЗаполнитьПоУчетуНаСервере()

	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	ДокументОбъект.ЗаполнитьПоУчету();
	ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
	ОбновитьПояснение();

КонецПроцедуры

