//Договор обучения (В43): не проводится, движений нет — номер, дата и условия договора с заказчиком. Вводится на
//основании ученика (стоимость — по его тарифу) или абонемента (предмет, срок и цена абонемента); заказчик — основной
//плательщик ученика (нет — ученик сам).

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = РегистрыСведений.УЗ_Настройки.Настройки().Организация;
	КонецЕсли;
	Если ПустаяСтрока(ПорядокОплаты) Тогда
		ПорядокОплаты = Документы.УЗ_ДоговорОбучения.ПорядокОплатыПоУмолчанию();
	КонецЕсли;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.УЗ_ФизЛица") И ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Обучающийся = ДанныеЗаполнения;
		Тариф = УЗ_Общий.ЗначениеРеквизита(ДанныеЗаполнения, "Тариф");
		ДанныеТарифа = Документы.УЗ_ДоговорОбучения.ДанныеТарифа(Тариф, ТекущаяДатаСеанса());
		Если ДанныеТарифа <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеТарифа);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.УЗ_Абонемент")
		И ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Абонемент = ДанныеЗаполнения;
		ДанныеАбонемента = Документы.УЗ_ДоговорОбучения.ДанныеАбонемента(ДанныеЗаполнения);
		Если ДанныеАбонемента <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеАбонемента, , ?(ЗначениеЗаполнено(ДанныеАбонемента.Организация),
				"", "Организация"));
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения);
	КонецЕсли;
	Если ЗначениеЗаполнено(Обучающийся) И НЕ ЗначениеЗаполнено(Заказчик) Тогда
		Заказчик = Справочники.УЗ_ФизЛица.ОсновнойПлательщик(Обучающийся);
	КонецЕсли;

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	АвторДокумента = Неопределено;
	Комментарий = "";

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	//созданный программно без даты — на сейчас (форма ставит дату сама)
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(АвторДокумента) Тогда
		АвторДокумента = УЗ_Среда.ТекущийПользователь();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = РегистрыСведений.УЗ_Настройки.Настройки().Организация;
	КонецЕсли;
	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Обучающийся) Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Укажите обучающегося.'"), "Обучающийся", Отказ);
	КонецЕсли;
	Если Заказчик = Обучающийся И ЗначениеЗаполнено(Заказчик) Тогда
		//обучающийся — сам заказчик: поле «Заказчик» пустое (так печатается «Заказчик, он же Обучающийся»)
		Заказчик = Справочники.УЗ_ФизЛица.ПустаяСсылка();
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаОкончания) И ДатаОкончания < ДатаНачала Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Дата окончания обучения раньше даты начала.'"),
			"ДатаОкончания", Отказ);
	КонецЕсли;
	Если ЗначениеЗаполнено(Абонемент) И ЗначениеЗаполнено(Обучающийся)
		И УЗ_Общий.ЗначениеРеквизита(Абонемент, "ФизЛицо") <> Обучающийся Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, СтрШаблон(НСтр("ru = 'Абонемент «%1» — другого "
			+ "ученика.'"), Абонемент),
			"Абонемент", Отказ);
	КонецЕсли;

КонецПроцедуры
