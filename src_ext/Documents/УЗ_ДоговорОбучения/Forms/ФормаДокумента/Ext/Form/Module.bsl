
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Объект.Ссылка.Пустая() И Объект.Дата = НачалоДня(Объект.Дата) Тогда
		Сейчас = НачалоМинуты(ТекущаяДатаСеанса());
		Объект.Дата = НачалоДня(?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, Сейчас)) + (Сейчас - НачалоДня(Сейчас));
	КонецЕсли;
	Если Объект.Ссылка.Пустая() И ПустаяСтрока(Объект.ПорядокОплаты) Тогда
		Объект.ПорядокОплаты = Документы.УЗ_ДоговорОбучения.ПорядокОплатыПоУмолчанию();
	КонецЕсли;
	Если Не УЗ_Общий.ЕстьОрганизации() Тогда
		Элементы.Организация.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

//Новый обучающийся: заказчик — его основной плательщик (нет — пусто: ученик сам), стоимость — по его тарифу, если
//абонемента нет.
&НаСервере
Процедура ОбучающийсяПриИзмененииНаСервере()

	Объект.Заказчик = Справочники.УЗ_ФизЛица.ОсновнойПлательщик(Объект.Обучающийся);
	//абонемент другого ученика договору не подходит — очищается; без абонемента стоимость — по тарифу ученика
	АбонементУченика = УЗ_Общий.ЗначениеРеквизита(Объект.Абонемент, "ФизЛицо") = Объект.Обучающийся;
	Если Не АбонементУченика Тогда
		Объект.Абонемент = Справочники.УЗ_Абонемент.ПустаяСсылка();
		ДанныеТарифа = Документы.УЗ_ДоговорОбучения.ДанныеТарифа(
			УЗ_Общий.ЗначениеРеквизита(Объект.Обучающийся, "Тариф"), Объект.Дата);
		Если ДанныеТарифа <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Объект, ДанныеТарифа);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

//Абонемент: предмет, срок и цена абонемента.
&НаСервере
Процедура АбонементПриИзмененииНаСервере()

	ДанныеАбонемента = Документы.УЗ_ДоговорОбучения.ДанныеАбонемента(Объект.Абонемент);
	Если ДанныеАбонемента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Объект, ДанныеАбонемента, "Стоимость, ОписаниеСтоимости, ПредметОбучения, "
		+ "ДатаНачала, ДатаОкончания");
	//абонемент — конкретного ученика: обучающийся и заказчик — по нему
	Если Объект.Обучающийся <> ДанныеАбонемента.Обучающийся Тогда
		Объект.Обучающийся = ДанныеАбонемента.Обучающийся;
		Объект.Заказчик = Справочники.УЗ_ФизЛица.ОсновнойПлательщик(Объект.Обучающийся);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбучающийсяПриИзменении(Элемент)
	ОбучающийсяПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура АбонементПриИзменении(Элемент)
	АбонементПриИзмененииНаСервере();
КонецПроцедуры
