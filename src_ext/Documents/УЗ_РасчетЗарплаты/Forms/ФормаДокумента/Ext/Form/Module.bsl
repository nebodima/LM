
&НаКлиенте
Процедура ПериодПриИзменении(Элемент)	
	
	Объект.ДатаНачала = Период.ДатаНачала;
	Объект.ДатаОкончания = Период.ДатаОкончания;
	
	Объект.ДД.Очистить();
	Объект.СуммаДокумента = 0;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТЧ(Команда)

	Если Не ЗначениеЗаполнено(Объект.ДатаНачала) Или Не ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		СообщитьНаФорме(НСтр("ru = 'Укажите период начисления — по нему подбираются уроки педагога.'"), "Период");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Педагог) Тогда
		СообщитьНаФорме(НСтр("ru = 'Укажите педагога.'"), "Объект.Педагог");
		Возврат;
	КонецЕсли;
	Объект.ДД.Очистить();
	ЗаполнитьТЧНаСервере();
	Если Объект.ДД.Количество() = 0 Тогда
		СообщитьНаФорме(СтрШаблон(НСтр("ru = 'За %1 у педагога %2 нет начислений к выплате: нет проведённых уроков с заполненной вкладкой «Начисления педагогу» или все они уже вошли в проведённые расчёты. Таблица пуста.'"),
			ПредставлениеПериода(НачалоДня(Объект.ДатаНачала), КонецДня(Объект.ДатаОкончания)), Объект.Педагог), "Объект.ДД");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СообщитьНаФорме(Текст, Поле)

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.Сообщить();

КонецПроцедуры

&НаКлиенте
Процедура КассаПриИзменении(Элемент)
	ОстатокВКассе = КассаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТЧНаСервере()

	//строго за период документа и без начислений, уже вошедших в другие проведённые расчёты
	//(раньше период расширялся до месяца, и второй расчёт за месяц выплачивал уроки ещё раз)
	Документ = РеквизитФормыВЗначение("Объект");
	Документ.ЗаполнитьНачисления();
	ЗначениеВРеквизитФормы(Документ, "Объект");

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)	
	Период.ДатаНачала = Объект.ДатаНачала;
	Период.ДатаОкончания = Объект.ДатаОкончания;
КонецПроцедуры

&НаКлиенте
Процедура ПедагогПриИзменении(Элемент)
	Объект.ДД.Очистить();
	Объект.СуммаДокумента = 0;
КонецПроцедуры

&НаКлиенте
Процедура ДДПриИзменении(Элемент)
	Объект.СуммаДокумента = Объект.ДД.Итог("КОплате");
КонецПроцедуры

&НаСервере
Функция КассаПриИзмененииНаСервере()

	//сколько можно выдать из кассы организации расчёта — та же функция, что у РКО и перемещения (В12, В14)
	Возврат Справочники.УЗ_Кассы.ДоступныйОстатокДляРасхода(Объект.Касса, Неопределено, Объект.Организация);

КонецФункции

&НаКлиенте
Процедура ПолучитьОстатокПоКассе(Команда)
	ОстатокВКассе = КассаПриИзмененииНаСервере();	
КонецПроцедуры

&НаСервере
Функция ПереместитьДеньгиНаСервере()

	//весь остаток кассы — в основную кассу (Справочники.УЗ_Кассы.ПолучитьОсновнуюКассу)
	Документ = РеквизитФормыВЗначение("Объект");
	Перемещение = Документ.ПереместитьОстатокВОсновнуюКассу();
	ОстатокВКассе = КассаПриИзмененииНаСервере();
	Возврат Перемещение;

КонецФункции

&НаКлиенте
Процедура ПереместитьДеньги(Команда)
	               	
	Если ЗначениеЗаполнено(Объект.Перемещение) Тогда
		Сообщить("Невозможно создать еще одно Перемещение! Существует уже созданное ранее.");
		Возврат;
	КонецЕсли; 	
	
	Если ЗначениеЗаполнено(Объект.СуммаДокумента) и ЗначениеЗаполнено(Объект.Касса) и ЗначениеЗаполнено(Объект.Педагог) и ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		Объект.Перемещение = ПереместитьДеньгиНаСервере();
		//ссылка на перемещение — сразу в расчёт, как у РКО: закрытие без записи не потеряет её
		Если ЗначениеЗаполнено(Объект.Перемещение) Тогда
			Записать();
		КонецЕсли;
	Иначе
		Сообщить("Невозможно создать Перемещение! Возможно незаполнены поля: Касса, Педагог, СуммаДокумента, Период");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ОстатокКВыплате()
	Возврат Документы.УЗ_РасчетЗарплаты.СостояниеВыплаты(Объект.Ссылка).Остаток;
КонецФункции

&НаСервере
Функция СделтьРКОНаСервере()
	
	//выплата — на основании проведённого расчёта (решение В9): РКО заполняется по расчёту — вид «Выплата
	//зарплаты», педагог, касса, невыплаченный остаток; дата — сегодня (раньше — канун конца периода)
	Если Объект.Ссылка.Пустая() Или НЕ Объект.Проведен Тогда
		Сообщить(НСтр("ru = 'Сначала проведите расчёт: выплата идёт на основании проведённого расчёта.'"));
		Возврат Документы.УЗ_РасходДенег.ПустаяСсылка();
	КонецЕсли;
	НовРКО = Документы.УЗ_РасходДенег.СоздатьДокумент();
	НовРКО.Заполнить(Объект.Ссылка);
	НовРКО.Дата = ТекущаяДатаСеанса();
	НовРКО.АвторДокумента = УЗ_Среда.ТекущийПользователь();
	
	Попытка
		НовРКО.Записать(РежимЗаписиДокумента.Проведение);		
		Возврат НовРКО.Ссылка;
	Исключение
		Сообщить("Не удалось провести РКО!"+ " " +ОписаниеОшибки());
	КонецПопытки;

	Возврат Документы.УЗ_РасходДенег.ПустаяСсылка();
	
КонецФункции

&НаКлиенте
Процедура СделтьРКО(Команда)

	Оповещение = Новый ОписаниеОповещения("СделтьРКОЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Создать расходный кассовый ордер на выплату зарплаты?", РежимДиалогаВопрос.ДаНет, 0);

КонецПроцедуры

&НаКлиенте
Процедура СделтьРКОЗавершение(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	//по всем выплатам на основании расчёта: второй ордер — только на невыплаченный остаток
	Если ОстатокКВыплате() <= 0 И ЗначениеЗаполнено(Объект.Ссылка) И Объект.Проведен Тогда
		Сообщить("По расчёту уже выплачено всё — ещё один расходный ордер не нужен.");
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.СуммаДокумента) и ЗначениеЗаполнено(Объект.Касса) и ЗначениеЗаполнено(Объект.Педагог) и ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
		Объект.РКО = СделтьРКОНаСервере();
		Если ЗначениеЗаполнено(Объект.РКО) Тогда
			Записать();
		КонецЕсли;
		//ОткрытьЗначение(Объект.РКО);
		ПроверитьРКО()
	Иначе
		Сообщить("РКО невозможно создать! Не заполнены обязательные поля: Касса, Педагог, СуммаДокумента, Период");
	КонецЕсли; 

КонецПроцедуры

Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УЗ_ДатыЗапрета.ФормаПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	ПроверитьРКО();
КонецПроцедуры

&НаСервере
Процедура ПроверитьРКО()
	//сумма и флажок РКО имеют смысл, только когда РКО выписан
	Элементы.РКОСумма.Видимость = ЗначениеЗаполнено(Объект.РКО);
	Элементы.РКОПроведен.Видимость = ЗначениеЗаполнено(Объект.РКО);
	//статус — по всем проведённым выплатам на основании расчёта (Документы.УЗ_РасчетЗарплаты.СостояниеВыплаты),
	//а не по одному РКО из реквизита: РКО, введённый «на основании», и частичные выплаты тоже считаются
	Состояние = Документы.УЗ_РасчетЗарплаты.СостояниеВыплаты(Объект.Ссылка);
	Элементы.ДекорацияВыплачено.Видимость = Объект.Проведен;
	Элементы.ДекорацияВыплачено.Заголовок = Состояние.Текст;
	Если Состояние.Статус = "Выплачено" Тогда
		//палитра: зелёный — выплачено, красный — долг или ошибка; поле РКО без заливки
		Элементы.ДекорацияВыплачено.ЦветТекста = WebЦвета.ЗеленыйЛес;
	ИначеЕсли Состояние.Статус = "Переплачено" Тогда
		Элементы.ДекорацияВыплачено.ЦветТекста = WebЦвета.ТемноКрасный;
	ИначеЕсли Состояние.Статус = "ВыплаченоЧастично" Тогда
		Элементы.ДекорацияВыплачено.ЦветТекста = WebЦвета.ТемноКрасный;
	Иначе
		Элементы.ДекорацияВыплачено.ЦветТекста = WebЦвета.ТемноКрасный;
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ПроверитьРКО();
КонецПроцедуры 

&НаКлиенте
Процедура РКОПриИзменении(Элемент)
	ПроверитьРКО();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	//новый документ — на текущее время, а не на полночь
	Если Объект.Ссылка.Пустая() И Объект.Дата = НачалоДня(Объект.Дата) Тогда
		Сейчас = НачалоМинуты(ТекущаяДатаСеанса());
		Объект.Дата = НачалоДня(?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, Сейчас)) + (Сейчас - НачалоДня(Сейчас));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации";	
	Если Запрос.Выполнить().Выгрузить().Количество() = 0 Тогда
		Элементы.Организация.Видимость = Ложь;
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.Касса) Тогда
		ОстатокВКассе = КассаПриИзмененииНаСервере();
	КонецЕсли;
	ПроверитьРКО();

КонецПроцедуры
