
&НаКлиенте
Процедура ПериодПриИзменении(Элемент)	
	
	Объект.ДатаНачала = Период.ДатаНачала;
	Объект.ДатаОкончания = Период.ДатаОкончания;
	
	Объект.ДД.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТЧ(Команда)
	Объект.ДД.Очистить();
	ЗаполнитьТЧНаСервере();
КонецПроцедуры

Процедура ЗаполнитьТЧНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УЗ_РасчетыПоЗарплатеОстаткиИОбороты.Регистратор КАК Регистратор,
		|	УЗ_РасчетыПоЗарплатеОстаткиИОбороты.СуммаПриход КАК СуммаПриход,
		|	УЗ_РасчетыПоЗарплатеОстаткиИОбороты.НеИзменять КАК НеИзменять,
		|	УЗ_РасчетыПоЗарплатеОстаткиИОбороты.Комментарий КАК Комментарий
		|ИЗ
		|	РегистрНакопления.УЗ_РасчетыПоЗарплате.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Авто, , ) КАК УЗ_РасчетыПоЗарплатеОстаткиИОбороты
		|ГДЕ
		|	УЗ_РасчетыПоЗарплатеОстаткиИОбороты.Организация = &Организация
		|	И УЗ_РасчетыПоЗарплатеОстаткиИОбороты.Педагог = &Педагог";	
	Запрос.УстановитьПараметр("Педагог", Объект.Педагог);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Объект.ДатаНачала));
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Объект.ДатаОкончания));
	РезультатЗапроса = Запрос.Выполнить();	
	Док = РезультатЗапроса.Выбрать();
	
	Пока Док.Следующий() Цикл		
		
		СтрокаТЧ = Объект.ДД.Добавить();
		
		СтрокаТЧ.Комментарий= Док.Комментарий;
		СтрокаТЧ.Документ 	= Док.Регистратор;
		СтрокаТЧ.Начисление = Док.СуммаПриход;
		//СтрокаТЧ.НеИзменять = Док.НеИзменять;
		СтрокаТЧ.КОплате 	= Док.СуммаПриход;
		
	КонецЦикла;
	
	Объект.СуммаДокумента 	= Объект.ДД.Итог("КОплате");
	
КонецПроцедуры

