#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

//Состояние выплаты расчёта зарплаты — по ВСЕМ проведённым РКО «Выплата зарплаты» на его основании (частичные
//выплаты складываются; РКО, введённый через «Создать на основании», тоже считается). Прежде форма сравнивала сумму
//расчёта с одним РКО из реквизита «РКО»: две частичные выплаты — «НЕ ПОЛНОСТЬЮ» навсегда, РКО «на основании» —
//«НЕ ВЫПЛАЧЕНО» (дефект демо-снимков).
//Возврат: Структура — КВыплате, Выплачено, Остаток (числа), Выплат (число РКО), ПервыйРКО (ссылка или пустая),
//  Статус: "НеПроведен" | "НеВыплачено" | "ВыплаченоЧастично" | "Выплачено" | "Переплачено"; Текст — для формы.
Функция СостояниеВыплаты(Расчет) Экспорт

	Итог = Новый Структура("КВыплате, Выплачено, Остаток, Выплат, ПервыйРКО, Статус, Текст", 0, 0, 0, 0,
		Документы.УЗ_РасходДенег.ПустаяСсылка(), "НеПроведен", "");
	Если Не ЗначениеЗаполнено(Расчет) Тогда
		Возврат Итог;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Выплаты.Ссылка КАК Ссылка,
	|	Выплаты.СуммаДокумента КАК Сумма
	|ИЗ
	|	Документ.УЗ_РасходДенег КАК Выплаты
	|ГДЕ
	|	Выплаты.Проведен
	|	И Выплаты.ДокументОснования = &Расчет
	|	И Выплаты.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыОпераций.ВыплатаЗарплаты)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Выплаты.Дата";
	Запрос.УстановитьПараметр("Расчет", Расчет);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Итог.Выплачено = Итог.Выплачено + Выборка.Сумма;
		Итог.Выплат = Итог.Выплат + 1;
		Если Итог.Выплат = 1 Тогда
			Итог.ПервыйРКО = Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;

	Итог.КВыплате = Расчет.СуммаДокумента;
	Итог.Остаток = Итог.КВыплате - Итог.Выплачено;
	Если Не Расчет.Проведен Тогда
		Итог.Статус = "НеПроведен";
		Итог.Текст = "";
	ИначеЕсли Итог.Выплачено = 0 Тогда
		Итог.Статус = "НеВыплачено";
		Итог.Текст = СтрШаблон(НСтр("ru = 'Не выплачено: %1'"), Формат(Итог.КВыплате, "ЧДЦ=2"));
	ИначеЕсли Итог.Остаток > 0 Тогда
		Итог.Статус = "ВыплаченоЧастично";
		Итог.Текст = СтрШаблон(НСтр("ru = 'Выплачено не полностью: %1 из %2, осталось %3'"),
			Формат(Итог.Выплачено, "ЧДЦ=2"), Формат(Итог.КВыплате, "ЧДЦ=2"), Формат(Итог.Остаток, "ЧДЦ=2"));
	ИначеЕсли Итог.Остаток < 0 Тогда
		Итог.Статус = "Переплачено";
		Итог.Текст = СтрШаблон(НСтр("ru = 'Переплачено: выплачено %1 при %2 к выплате'"),
			Формат(Итог.Выплачено, "ЧДЦ=2"), Формат(Итог.КВыплате, "ЧДЦ=2"));
	Иначе
		Итог.Статус = "Выплачено";
		Итог.Текст = ?(Итог.Выплат > 1, СтрШаблон(НСтр("ru = 'Выплачено полностью (%1 выплаты)'"), Итог.Выплат),
			НСтр("ru = 'Выплачено полностью'"));
	КонецЕсли;
	Возврат Итог;

КонецФункции

//Невыплаченные начисления педагога в организации по источникам (урок, «Начисления педагогам») с датой начисления в
//[Начало; Конец] — одна функция для «Заполнить и рассчитать» ведомости и обновления данных (перенос старых выплат):
//начисление источника в регистре минус его суммы «К оплате» в других проведённых расчётах педагога (расчёт с
//проведённой выплатой — и непроведённый, N01). Источник без расчётов — строками по комментариям начислений (как в
//регистре); частично выплаченный — одной строкой остатка; выплаченный целиком — не попадает.
//  Исключить — расчёт, свои строки которого не считать (перезаполнение); Неопределено — никакой.
//Возврат: Массив Структура(Документ, Комментарий, Сумма, Период) по возрастанию даты начисления.
Функция НевыплаченныеНачисления(Педагог, Организация, Начало, Конец, Исключить = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Начисления.Регистратор КАК Документ,
	|	Начисления.Комментарий КАК Комментарий,
	|	МИНИМУМ(Начисления.Период) КАК Период,
	|	СУММА(Начисления.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ВТ_Начисления
	|ИЗ
	|	РегистрНакопления.УЗ_РасчетыПоЗарплате КАК Начисления
	|ГДЕ
	|	Начисления.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И Начисления.Активность
	|	И Начисления.Период МЕЖДУ &Начало И &Конец
	|	И Начисления.Педагог = &Педагог
	|	И Начисления.Организация = &Организация
	|	И (Начисления.Регистратор ССЫЛКА Документ.УЗ_Урок
	|			ИЛИ Начисления.Регистратор ССЫЛКА Документ.УЗ_НачисленияПедагогам)
	|
	|СГРУППИРОВАТЬ ПО
	|	Начисления.Регистратор,
	|	Начисления.Комментарий
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Другие.Документ КАК Документ,
	|	СУММА(Другие.КОплате) КАК Выплачено
	|ПОМЕСТИТЬ ВТ_ВДругих
	|ИЗ
	|	Документ.УЗ_РасчетЗарплаты.ДД КАК Другие
	|ГДЕ
	|	Другие.Ссылка <> &Исключить
	|	И (Другие.Ссылка.Проведен
	|			ИЛИ Другие.Ссылка В (ВЫБРАТЬ Выплаты.ДокументОснования ИЗ Документ.УЗ_РасходДенег КАК Выплаты
	|				ГДЕ Выплаты.Проведен И Выплаты.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыОпераций.ВыплатаЗарплаты)))
	|	И Другие.Ссылка.Педагог = &Педагог
	|	И Другие.Документ В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				ВТ_Начисления.Документ
	|			ИЗ
	|				ВТ_Начисления КАК ВТ_Начисления)
	|
	|СГРУППИРОВАТЬ ПО
	|	Другие.Документ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Начисления.Документ КАК Документ,
	|	ВТ_Начисления.Комментарий КАК Комментарий,
	|	ВТ_Начисления.Период КАК Период,
	|	ВТ_Начисления.Сумма КАК Сумма,
	|	ЕСТЬNULL(ВТ_ВДругих.Выплачено, 0) КАК Выплачено
	|ИЗ
	|	ВТ_Начисления КАК ВТ_Начисления
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВДругих КАК ВТ_ВДругих
	|		ПО ВТ_Начисления.Документ = ВТ_ВДругих.Документ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период,
	|	Комментарий";
	Запрос.УстановитьПараметр("Педагог", Педагог);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Запрос.УстановитьПараметр("Исключить", ?(ЗначениеЗаполнено(Исключить), Исключить, Документы.УЗ_РасчетЗарплаты.ПустаяСсылка()));
	Таблица = Запрос.Выполнить().Выгрузить();

	//источник целиком: сумма начислений по всем комментариям и уже выплаченное в других расчётах
	Источники = Таблица.Скопировать(, "Документ, Сумма, Выплачено");
	Источники.Свернуть("Документ, Выплачено", "Сумма");
	Итог = Новый Массив;
	Добавлены = Новый Соответствие;
	Для Каждого Строка Из Таблица Цикл
		Если Строка.Выплачено = 0 Тогда
			Если Строка.Сумма <> 0 Тогда
				Итог.Добавить(Новый Структура("Документ, Комментарий, Сумма, Период", Строка.Документ,
					Строка.Комментарий, Строка.Сумма, Строка.Период));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Добавлены[Строка.Документ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Добавлены.Вставить(Строка.Документ, Истина);
		Остаток = Источники.Найти(Строка.Документ, "Документ").Сумма - Строка.Выплачено;
		Если Остаток > 0 Тогда
			Итог.Добавить(Новый Структура("Документ, Комментарий, Сумма, Период", Строка.Документ,
				СтрШаблон(НСтр("ru = 'Остаток: %1 из начисленных %2 уже выплачено другими расчётами'"),
					Формат(Строка.Выплачено, "ЧДЦ=2; ЧН=0"), Формат(Строка.Выплачено + Остаток, "ЧДЦ=2; ЧН=0")),
				Остаток, Строка.Период));
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

#КонецЕсли
