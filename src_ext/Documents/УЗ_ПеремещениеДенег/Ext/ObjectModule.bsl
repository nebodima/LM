
Процедура ОбработкаПроведения(Отказ, Режим)
	
	//дата запрета проверяется подпиской УЗ_ДатаЗапретаПередЗаписью (модуль УЗ_ДатыЗапрета)
	

	Если СделатьДвиженияПоВзаиморасчетам Тогда
		
		Если НЕ ЗначениеЗаполнено(Клиент) Тогда
			Отказ = Истина;
			Сообщить("Не выбран клиент!");
		КонецЕсли;
		
		Если Сумма <= 0 Тогда
			Отказ = Истина;
			Сообщить("Укажите сумму!");
		КонецЕсли;
		
		
		Структ = ПолучитьСтруктуруОстатков();
		Если Структ.СуммаОстаток < Сумма Тогда
			Отказ = Истина;
			Сообщить("Невозможно переместить деньги, потому что на остатках = " +Структ.СуммаОстаток+ "; по отбору Клиент = " +Клиент.Ссылка + "; ПредметОбучения = " +ПредметОбученияОтправитель+ "; на дату: " +Дата);
		КонецЕсли;
		
		// регистр СписанияСуммЗаУроки Расход
		Движения.УЗ_СписанияСуммЗаУроки.Записывать = Истина;
		Движение = Движения.УЗ_СписанияСуммЗаУроки.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период 	 = Дата;
		Движение.Клиент 	 = Клиент;
		Движение.Сумма 		 = Сумма;
		Движение.ПредметОбучения = ПредметОбученияОтправитель;
		Движение.Организация = Организация;
		
		// регистр СписанияСуммЗаУроки Приход
		Движения.УЗ_СписанияСуммЗаУроки.Записывать = Истина;
		Движение = Движения.УЗ_СписанияСуммЗаУроки.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период 	 = Дата;
		Движение.Клиент 	 = Клиент;
		Движение.Сумма 		 = Сумма;
		Движение.ПредметОбучения = ПредметОбученияПолучатель;
		Движение.Организация = Организация;
		
	Иначе
		
		//между кассами (как контроль остатков денег в типовых): обе кассы указаны и различны, сумма > 0,
		//касса-отправитель не уходит в минус
		ПроверитьПеремещениеМеждуКассами(Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;

		// регистр Касса Расход
		Движения.УЗ_Касса.Записывать = Истина;
		Движение = Движения.УЗ_Касса.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период 	 = Дата;
		Движение.Клиент 	 = Клиент;
		Движение.Сумма 		 = Сумма;
		Движение.Касса		 = КассаОтправитель;
		Движение.СтатьяЗатрат= СтатьяЗатрат;
		Движение.ВидОперации = Перечисления.УЗ_ВидыОпераций.ВнутренняяКасса;
		Движение.Организация = Организация;
			
		// регистр Касса Приход
		Движения.УЗ_Касса.Записывать = Истина;
		Движение = Движения.УЗ_Касса.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период 	 = Дата;
		Движение.Клиент 	 = Клиент;
		Движение.Сумма 		 = Сумма;
		Движение.Касса		 = КассаПолучатель;
		Движение.СтатьяЗатрат= СтатьяЗатрат;
		Движение.ВидОперации = Перечисления.УЗ_ВидыОпераций.ВнутренняяКасса;
		Движение.Организация = Организация;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьПеремещениеМеждуКассами(Отказ)
	
	Если НЕ ЗначениеЗаполнено(КассаОтправитель) Тогда
		СообщитьОбОшибке(НСтр("ru = 'Укажите кассу-отправителя.'"), "КассаОтправитель", Отказ);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(КассаПолучатель) Тогда
		СообщитьОбОшибке(НСтр("ru = 'Укажите кассу-получателя.'"), "КассаПолучатель", Отказ);
	КонецЕсли;
	Если ЗначениеЗаполнено(КассаОтправитель) И КассаОтправитель = КассаПолучатель Тогда
		СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Касса-отправитель и касса-получатель совпадают (%1): перемещать некуда.'"), КассаОтправитель),
			"КассаПолучатель", Отказ);
	КонецЕсли;
	Если Сумма <= 0 Тогда
		СообщитьОбОшибке(НСтр("ru = 'Укажите сумму перемещения больше нуля.'"), "Сумма", Отказ);
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Остаток = ОстатокКассыОтправителя();
	Если Сумма > Остаток Тогда
		СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'В кассе %1 остаток %2 — переместить %3 нельзя, касса уйдёт в минус.'"),
			КассаОтправитель, Формат(Остаток, "ЧДЦ=2; ЧН=0,00"), Формат(Сумма, "ЧДЦ=2; ЧН=0,00")), "Сумма", Отказ);
	КонецЕсли;
	
КонецПроцедуры

//Текущий остаток денег кассы-отправителя по всем клиентам, предметам, статьям и видам операций, без движений
//самого документа (при перепроведении старые движения ещё в регистре). Блокировка — до чтения: два
//перемещения из одной кассы, проводимые одновременно, не израсходуют один остаток дважды.
Функция ОстатокКассыОтправителя()
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.УЗ_Касса");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Касса", КассаОтправитель);
	Блокировка.Заблокировать();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Данные.Сумма), 0) КАК Сумма
	|ИЗ
	|	(ВЫБРАТЬ
	|		Остатки.СуммаОстаток КАК Сумма
	|	ИЗ
	|		РегистрНакопления.УЗ_Касса.Остатки(, Касса = &Касса) КАК Остатки
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВЫБОР
	|			КОГДА Свои.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|				ТОГДА Свои.Сумма
	|			ИНАЧЕ -Свои.Сумма
	|		КОНЕЦ
	|	ИЗ
	|		РегистрНакопления.УЗ_Касса КАК Свои
	|	ГДЕ
	|		Свои.Регистратор = &Ссылка
	|		И Свои.Касса = &Касса
	|		И Свои.Активность) КАК Данные";
	Запрос.УстановитьПараметр("Касса", КассаОтправитель);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Сумма;
	
КонецФункции

Процедура СообщитьОбОшибке(Текст, Поле, Отказ)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	Отказ = Истина;
	
КонецПроцедуры
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.АвторДокумента) Тогда
		ЭтотОбъект.АвторДокумента = УЗ_Среда.ТекущийПользователь();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ВидОперации) Тогда
		Если СделатьДвиженияПоВзаиморасчетам Тогда
			ЭтотОбъект.ВидОперации = Перечисления.УЗ_ВидыОпераций.КассаУченики;
		Иначе
			ЭтотОбъект.ВидОперации = Перечисления.УЗ_ВидыОпераций.ВнутренняяКасса;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

//Остаток денег ученика для контроля перемещения: по предмету-отправителю или (предмет не указан) по всем
//предметам. Виртуальная таблица сама сворачивает педагога, тариф, явку и прочие измерения, которых нет в
//запросе (проверено на базе 28.09.2026, тест_остатки_по_строкам), — строка одна; СУММА — для явности.
//Блокировка — до чтения: два перемещения одного ученика, проводимые одновременно, не израсходуют один
//остаток дважды.
Функция ПолучитьСтруктуруОстатков()
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.УЗ_СписанияСуммЗаУроки");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Клиент", Клиент);
	Если ЗначениеЗаполнено(ПредметОбученияОтправитель) Тогда
		ЭлементБлокировки.УстановитьЗначение("ПредметОбучения", ПредметОбученияОтправитель);
	КонецЕсли;
	Блокировка.Заблокировать();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(СписанияСуммЗаУрокиОстатки.СуммаОстаток), 0) КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки.Остатки(, Клиент = &Клиент) КАК СписанияСуммЗаУрокиОстатки";
	Если ЗначениеЗаполнено(ПредметОбученияОтправитель) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Клиент = &Клиент", "Клиент = &Клиент И ПредметОбучения = &ПредметОбучения");
		Запрос.УстановитьПараметр("ПредметОбучения", ПредметОбученияОтправитель);
	КонецЕсли;
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Структ = Новый Структура;
	Структ.Вставить("СуммаОстаток", Выборка.СуммаОстаток);
	Возврат Структ;
	
КонецФункции

Процедура ПриКопировании(ОбъектКопирования)
	 АвторДокумента = Неопределено;
	 Комментарий    = Неопределено;
КонецПроцедуры

