
Процедура ОбработкаПроведения(Отказ, Режим)

	//дата запрета проверяется подпиской УЗ_ДатаЗапретаПередЗаписью (модуль УЗ_ДатыЗапрета)

	Если СделатьДвиженияПоВзаиморасчетам Тогда

		Если НЕ ЗначениеЗаполнено(Клиент) Тогда
			УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Не выбран ученик.'"), "Клиент", Отказ);
		КонецЕсли;

		Если Сумма <= 0 Тогда
			УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Укажите сумму перемещения больше нуля.'"), "Сумма",
				Отказ);
		КонецЕсли;
		Если ПредметОбученияОтправитель = ПредметОбученияПолучатель Тогда
			УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
				СтрШаблон(НСтр("ru = 'Предмет-отправитель и предмет-получатель совпадают (%1): перемещать некуда.'"),
				?(ЗначениеЗаполнено(ПредметОбученияПолучатель), ПредметОбученияПолучатель,
					НСтр("ru = 'без предмета'"))),
				"ПредметОбученияПолучатель", Отказ);
		КонецЕсли;
		Если Отказ Тогда
			Возврат;
		КонецЕсли;

		//C02/В12: деньги ученика — в разрезе организации документа и на его дату (оплата в другой организации
		//или поступившая позже перемещения его не покрывает); одна функция с формами — УЗ_Сервер.ОстатокДенегУченика
		//Находка 1 третьего аудита Codex (28.09.2026): проверяется тот же разрез, из которого пишется расход, —
		//предмет-отправитель; «без предмета» — пустой предмет, а не сумма всех предметов (прежде перемещение «без
		//предмета → математика» при деньгах только на математике удваивало доступный к возврату аванс математики).
		//Аванс без предмета, уже зачтённый в долги предметов, перемещается только в предмет с долгом (оформить
		//зачёт) — в другой предмет его не увести: доступно свободный аванс без предмета + долг получателя.
		УЗ_Сервер.ЗаблокироватьДеньгиУченика(Клиент, Организация);
		Граница = Новый Граница(МоментВремени(), ВидГраницы.Исключая);
		Остаток = УЗ_Сервер.ОстатокДенегУченика(Клиент, Организация, ПредметОбученияОтправитель, Граница);
		Если НЕ ЗначениеЗаполнено(ПредметОбученияОтправитель) Тогда
			ДолгПолучателя = Макс(0,
				-УЗ_Сервер.ОстатокДенегУченика(Клиент, Организация, ПредметОбученияПолучатель, Граница));
			Остаток = Мин(Остаток, УЗ_Сервер.СвободныйАвансБезПредмета(Клиент, Организация, Граница) + ДолгПолучателя);
		КонецЕсли;
		Если Остаток < Сумма Тогда
			УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
				СтрШаблон(НСтр(
				"ru = 'Невозможно переместить %1: у ученика %2 в организации «%3» %4 на %5 доступный остаток %6.'"),
				Формат(Сумма, "ЧДЦ=2; ЧН=0,00"), Клиент, Организация,
				?(ЗначениеЗаполнено(ПредметОбученияОтправитель), "по предмету «" + ПредметОбученияОтправитель + "»",
					НСтр("ru = 'без предмета (аванс, не зачтённый в долги других предметов)'")),
				Формат(Дата, "ДЛФ=DT"), Формат(Макс(Остаток, 0), "ЧДЦ=2; ЧН=0,00")), "Сумма", Отказ);
		КонецЕсли;

		// регистр СписанияСуммЗаУроки Расход
		Движения.УЗ_СписанияСуммЗаУроки.Записывать = Истина;
		Движение = Движения.УЗ_СписанияСуммЗаУроки.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период 	 = Дата;
		Движение.Клиент 	 = Клиент;
		Движение.Сумма 		 = Сумма;
		Движение.ПредметОбучения = ПредметОбученияОтправитель;
		Движение.Организация = Организация;

		// регистр СписанияСуммЗаУроки Приход
		Движения.УЗ_СписанияСуммЗаУроки.Записывать = Истина;
		Движение = Движения.УЗ_СписанияСуммЗаУроки.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период 	 = Дата;
		Движение.Клиент 	 = Клиент;
		Движение.Сумма 		 = Сумма;
		Движение.ПредметОбучения = ПредметОбученияПолучатель;
		Движение.Организация = Организация;

	Иначе

		//между кассами (как контроль остатков денег в типовых): обе кассы указаны и различны, сумма > 0,
		//касса-отправитель не уходит в минус
		ПроверитьПеремещениеМеждуКассами(Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;

		//раздел кассы (деньги учеников / внутренняя касса) переезжает вместе с деньгами: пары «расход из кассы-
		//отправителя — приход в кассу-получатель» по остаткам разделов отправителя (прежде всё писалось
		//«Внутренней кассой»: в зале ученики +10 000 / внутренняя −10 000, в основной — внутренняя +10 000)
		Движения.УЗ_Касса.Записывать = Истина;
		Для Каждого Часть Из ЧастиПоРазделам() Цикл
			Движение = Движения.УЗ_Касса.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период 	 = Дата;
			Движение.Клиент 	 = Клиент;
			Движение.Сумма 		 = Часть.Значение;
			Движение.Касса		 = КассаОтправитель;
			Движение.СтатьяЗатрат= СтатьяЗатрат;
			Движение.ВидОперации = Часть.Ключ;
			Движение.Организация = Организация;

			Движение = Движения.УЗ_Касса.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период 	 = Дата;
			Движение.Клиент 	 = Клиент;
			Движение.Сумма 		 = Часть.Значение;
			Движение.Касса		 = КассаПолучатель;
			Движение.СтатьяЗатрат= СтатьяЗатрат;
			Движение.ВидОперации = Часть.Ключ;
			Движение.Организация = Организация;
		КонецЦикла;

		//В14/В12: касса-отправитель организации не уходит в минус (с блокировкой), на дату и в текущем остатке
		Справочники.УЗ_Кассы.ПроверитьОстаткиКасс(ЭтотОбъект, Движения.УЗ_Касса, Отказ);
	КонецЕсли;

КонецПроцедуры

//Сумма перемещения по разделам кассы-отправителя (Соответствие: раздел → сумма): сначала деньги учеников, потом
//внутренняя касса, потом прочие разделы с остатком — по их остаткам организации в кассе на момент
//документа; что не покрыто остатками разделов, — «Внутренняя касса».
Функция ЧастиПоРазделам()

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.УЗ_Касса");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Касса", КассаОтправитель);
	ЭлементБлокировки.УстановитьЗначение("Организация", Организация);
	Блокировка.Заблокировать();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.ВидОперации КАК ВидОперации,
	|	СУММА(Остатки.СуммаОстаток) КАК Сумма
	|ИЗ
	|	РегистрНакопления.УЗ_Касса.Остатки(&Граница, Касса = &Касса И Организация = &Организация) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.ВидОперации
	|
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.СуммаОстаток) > 0";
	Запрос.УстановитьПараметр("Граница", Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Касса", КассаОтправитель);
	Запрос.УстановитьПараметр("Организация", Организация);
	Остатки = Запрос.Выполнить().Выгрузить();

	Порядок = Новый Массив;
	Порядок.Добавить(Перечисления.УЗ_ВидыОпераций.КассаУченики);
	Порядок.Добавить(Перечисления.УЗ_ВидыОпераций.ВнутренняяКасса);
	Для Каждого СтрокаОстатка Из Остатки Цикл
		Если Порядок.Найти(СтрокаОстатка.ВидОперации) = Неопределено Тогда
			Порядок.Добавить(СтрокаОстатка.ВидОперации);
		КонецЕсли;
	КонецЦикла;

	Части = Новый Соответствие;
	Осталось = Сумма;
	Для Каждого Раздел Из Порядок Цикл
		СтрокаОстатка = Остатки.Найти(Раздел, "ВидОперации");
		Если СтрокаОстатка = Неопределено Или Осталось <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Часть = Мин(Осталось, СтрокаОстатка.Сумма);
		Части.Вставить(Раздел, Часть);
		Осталось = Осталось - Часть;
	КонецЦикла;
	Если Осталось > 0 Тогда
		Внутренняя = Перечисления.УЗ_ВидыОпераций.ВнутренняяКасса;
		Части.Вставить(Внутренняя, ?(Части[Внутренняя] = Неопределено, 0, Части[Внутренняя]) + Осталось);
	КонецЕсли;
	Возврат Части;

КонецФункции

Процедура ПроверитьПеремещениеМеждуКассами(Отказ)

	Если НЕ ЗначениеЗаполнено(КассаОтправитель) Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Укажите кассу-отправителя.'"), "КассаОтправитель",
			Отказ);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(КассаПолучатель) Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Укажите кассу-получателя.'"), "КассаПолучатель",
			Отказ);
	КонецЕсли;
	Если ЗначениеЗаполнено(КассаОтправитель) И КассаОтправитель = КассаПолучатель Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
			СтрШаблон(НСтр("ru = 'Касса-отправитель и касса-получатель совпадают (%1): перемещать некуда.'"),
			КассаОтправитель),
			"КассаПолучатель", Отказ);
	КонецЕсли;
	Если Сумма <= 0 Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Укажите сумму перемещения больше нуля.'"), "Сумма",
			Отказ);
	КонецЕсли;
	//В12: касса принадлежит организации — перемещение только между кассами организации документа
	Для Каждого ИмяКассы Из СтрРазделить("КассаОтправитель,КассаПолучатель", ",") Цикл
		ТекстКассы = Справочники.УЗ_Кассы.ТекстКассаДругойОрганизации(ЭтотОбъект[ИмяКассы], Организация);
		Если ЗначениеЗаполнено(ТекстКассы) Тогда
			УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, ТекстКассы, ИмяКассы, Отказ);
		КонецЕсли;
	КонецЦикла;
	//остаток кассы-отправителя (В14) — после движений, общей проверкой Справочники.УЗ_Кассы.ПроверитьОстаткиКасс

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.АвторДокумента) Тогда
		ЭтотОбъект.АвторДокумента = УЗ_Среда.ТекущийПользователь();
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ВидОперации) Тогда
		Если СделатьДвиженияПоВзаиморасчетам Тогда
			ЭтотОбъект.ВидОперации = Перечисления.УЗ_ВидыОпераций.КассаУченики;
		Иначе
			ЭтотОбъект.ВидОперации = Перечисления.УЗ_ВидыОпераций.ВнутренняяКасса;
		КонецЕсли;
	КонецЕсли;

	//C03: перемещение, созданное программно (панель ученика, обработки), без организации писало деньги
	//в пустую организацию — организация по умолчанию из настроек, как у урока и ПКО
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = РегистрыСведений.УЗ_Настройки.Настройки().Организация;
	КонецЕсли;

	//В14: отмена проведения перемещения между кассами забирает деньги из кассы-получателя — не в минус
	Справочники.УЗ_Кассы.ПередЗаписьюДокументаКассы(ЭтотОбъект, РежимЗаписи, Отказ);

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	АвторДокумента = Неопределено;
	Комментарий    = Неопределено;
КонецПроцедуры
