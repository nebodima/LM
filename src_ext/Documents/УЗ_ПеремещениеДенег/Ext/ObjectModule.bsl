
Процедура ОбработкаПроведения(Отказ, Режим)
	
	//дата запрета проверяется подпиской УЗ_ДатаЗапретаПередЗаписью (модуль УЗ_ДатыЗапрета)
	

	Если СделатьДвиженияПоВзаиморасчетам Тогда
		
		Если НЕ ЗначениеЗаполнено(Клиент) Тогда
			СообщитьОбОшибке(НСтр("ru = 'Не выбран ученик.'"), "Клиент", Отказ);
		КонецЕсли;

		Если Сумма <= 0 Тогда
			СообщитьОбОшибке(НСтр("ru = 'Укажите сумму перемещения больше нуля.'"), "Сумма", Отказ);
		КонецЕсли;

		//C02/В12: деньги ученика — в разрезе организации документа и на его дату (оплата в другой организации
		//или поступившая позже перемещения его не покрывает)
		Остаток = ОстатокДенегУченика();
		Если Остаток < Сумма Тогда
			СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Невозможно переместить %1: у ученика %2 в организации «%3» по предмету «%4» на %5 остаток %6.'"),
				Формат(Сумма, "ЧДЦ=2; ЧН=0,00"), Клиент, Организация,
				?(ЗначениеЗаполнено(ПредметОбученияОтправитель), ПредметОбученияОтправитель, НСтр("ru = 'все предметы'")),
				Формат(Дата, "ДЛФ=DT"), Формат(Остаток, "ЧДЦ=2; ЧН=0,00")), "Сумма", Отказ);
		КонецЕсли;

		// регистр СписанияСуммЗаУроки Расход
		Движения.УЗ_СписанияСуммЗаУроки.Записывать = Истина;
		Движение = Движения.УЗ_СписанияСуммЗаУроки.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период 	 = Дата;
		Движение.Клиент 	 = Клиент;
		Движение.Сумма 		 = Сумма;
		Движение.ПредметОбучения = ПредметОбученияОтправитель;
		Движение.Организация = Организация;
		
		// регистр СписанияСуммЗаУроки Приход
		Движения.УЗ_СписанияСуммЗаУроки.Записывать = Истина;
		Движение = Движения.УЗ_СписанияСуммЗаУроки.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период 	 = Дата;
		Движение.Клиент 	 = Клиент;
		Движение.Сумма 		 = Сумма;
		Движение.ПредметОбучения = ПредметОбученияПолучатель;
		Движение.Организация = Организация;
		
	Иначе
		
		//между кассами (как контроль остатков денег в типовых): обе кассы указаны и различны, сумма > 0,
		//касса-отправитель не уходит в минус
		ПроверитьПеремещениеМеждуКассами(Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;

		// регистр Касса Расход
		Движения.УЗ_Касса.Записывать = Истина;
		Движение = Движения.УЗ_Касса.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период 	 = Дата;
		Движение.Клиент 	 = Клиент;
		Движение.Сумма 		 = Сумма;
		Движение.Касса		 = КассаОтправитель;
		Движение.СтатьяЗатрат= СтатьяЗатрат;
		Движение.ВидОперации = Перечисления.УЗ_ВидыОпераций.ВнутренняяКасса;
		Движение.Организация = Организация;
			
		// регистр Касса Приход
		Движения.УЗ_Касса.Записывать = Истина;
		Движение = Движения.УЗ_Касса.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период 	 = Дата;
		Движение.Клиент 	 = Клиент;
		Движение.Сумма 		 = Сумма;
		Движение.Касса		 = КассаПолучатель;
		Движение.СтатьяЗатрат= СтатьяЗатрат;
		Движение.ВидОперации = Перечисления.УЗ_ВидыОпераций.ВнутренняяКасса;
		Движение.Организация = Организация;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьПеремещениеМеждуКассами(Отказ)
	
	Если НЕ ЗначениеЗаполнено(КассаОтправитель) Тогда
		СообщитьОбОшибке(НСтр("ru = 'Укажите кассу-отправителя.'"), "КассаОтправитель", Отказ);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(КассаПолучатель) Тогда
		СообщитьОбОшибке(НСтр("ru = 'Укажите кассу-получателя.'"), "КассаПолучатель", Отказ);
	КонецЕсли;
	Если ЗначениеЗаполнено(КассаОтправитель) И КассаОтправитель = КассаПолучатель Тогда
		СообщитьОбОшибке(СтрШаблон(НСтр("ru = 'Касса-отправитель и касса-получатель совпадают (%1): перемещать некуда.'"), КассаОтправитель),
			"КассаПолучатель", Отказ);
	КонецЕсли;
	Если Сумма <= 0 Тогда
		СообщитьОбОшибке(НСтр("ru = 'Укажите сумму перемещения больше нуля.'"), "Сумма", Отказ);
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	//В14: остаток на дату перемещения и текущий, без движений самого документа, под блокировкой кассы
	Остаток = Справочники.УЗ_Кассы.ДоступныйОстатокДляРасхода(КассаОтправитель, ЭтотОбъект);
	Если Сумма > Остаток Тогда
		СообщитьОбОшибке(Справочники.УЗ_Кассы.ТекстКассаУйдетВМинус(КассаОтправитель, Остаток, Сумма), "Сумма", Отказ);
	КонецЕсли;

КонецПроцедуры

Процедура СообщитьОбОшибке(Текст, Поле, Отказ)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Сообщить();
	Отказ = Истина;
	
КонецПроцедуры
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.АвторДокумента) Тогда
		ЭтотОбъект.АвторДокумента = УЗ_Среда.ТекущийПользователь();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.ВидОперации) Тогда
		Если СделатьДвиженияПоВзаиморасчетам Тогда
			ЭтотОбъект.ВидОперации = Перечисления.УЗ_ВидыОпераций.КассаУченики;
		Иначе
			ЭтотОбъект.ВидОперации = Перечисления.УЗ_ВидыОпераций.ВнутренняяКасса;
		КонецЕсли;
	КонецЕсли;

	//C03: перемещение, созданное программно (панель ученика, обработки), без организации писало деньги
	//в пустую организацию — организация по умолчанию из настроек, как у урока и ПКО
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = РегистрыСведений.УЗ_Настройки.Настройки().Организация;
	КонецЕсли;

КонецПроцедуры

//Остаток денег ученика для контроля перемещения (C02/В12): в организации документа, на момент документа (без
//его собственных движений — граница «исключая»), по предмету-отправителю или (предмет не указан) по всем
//предметам. Прежде — текущий остаток по всем организациям: оплата в А или поступление после даты перемещения
//разрешали расход в Б или задним числом. Виртуальная таблица сама сворачивает прочие измерения (тест
//тест_остатки_по_строкам) — строка одна; СУММА — для явности. Блокировка — до чтения: два перемещения одного
//ученика, проводимые одновременно, не израсходуют один остаток дважды.
Функция ОстатокДенегУченика()

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.УЗ_СписанияСуммЗаУроки");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Клиент", Клиент);
	ЭлементБлокировки.УстановитьЗначение("Организация", Организация);
	Если ЗначениеЗаполнено(ПредметОбученияОтправитель) Тогда
		ЭлементБлокировки.УстановитьЗначение("ПредметОбучения", ПредметОбученияОтправитель);
	КонецЕсли;
	Блокировка.Заблокировать();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.СуммаОстаток), 0) КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки.Остатки(&Граница, Клиент = &Клиент И Организация = &Организация) КАК Остатки";
	Если ЗначениеЗаполнено(ПредметОбученияОтправитель) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Организация = &Организация", "Организация = &Организация И ПредметОбучения = &ПредметОбучения");
		Запрос.УстановитьПараметр("ПредметОбучения", ПредметОбученияОтправитель);
	КонецЕсли;
	Запрос.УстановитьПараметр("Клиент", Клиент);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Граница", Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.СуммаОстаток;

КонецФункции

Процедура ПриКопировании(ОбъектКопирования)
	 АвторДокумента = Неопределено;
	 Комментарий    = Неопределено;
КонецПроцедуры

