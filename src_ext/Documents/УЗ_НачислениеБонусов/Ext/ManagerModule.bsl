
// Печать — точка входа подменю «Печать» (сигнатура БСП; вызывают форма печати хозяина
// и своя печать УЗ_Печать.СформироватьСвоейПечатью). Идентификатор формы — "НачислениеБонусов".
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УЗ_Печать.НужноПечататьМакет(КоллекцияПечатныхФорм, "НачислениеБонусов") Тогда
		УЗ_Печать.ВывестиВКоллекцию(КоллекцияПечатныхФорм, "НачислениеБонусов", НСтр("ru = 'Начисление бонусов'"),
			ПечатьНачисления(МассивОбъектов, ОбъектыПечати));
		УЗ_Печать.УстановитьЗаголовок(ПараметрыВывода, НСтр("ru = 'Начисление бонусов'"));
	КонецЕсли;

КонецПроцедуры

// Ведомость начисления бонусов по дисконтным картам, каждый документ на своей странице:
// заголовок с номером и датой, организация, таблица «ученик — карта — начислено — действует до»
// с итогом, комментарий и подписи. Строится кодом (без макета): А4 книжный, по ширине страницы.
Функция ПечатьНачисления(МассивОбъектов, ОбъектыПечати) Экспорт

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_УЗ_НачислениеБонусов";
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НачислениеБонусов.Ссылка КАК Ссылка,
	|	НачислениеБонусов.Номер КАК Номер,
	|	НачислениеБонусов.Дата КАК Дата,
	|	НачислениеБонусов.Организация КАК Организация,
	|	НачислениеБонусов.АвторДокумента КАК АвторДокумента,
	|	НачислениеБонусов.Комментарий КАК Комментарий,
	|	НачислениеБонусов.СуммаБонусов КАК СуммаБонусов,
	|	НачислениеБонусов.ДисконтныеКарты.(
	|		НомерСтроки КАК НомерСтроки,
	|		ДисконтнаяКарта.Владелец КАК Ученик,
	|		ДисконтнаяКарта КАК ДисконтнаяКарта,
	|		СуммаБонусов КАК СуммаБонусов,
	|		ДисконтнаяКарта.ДатаОкончанияДействия КАК ДействуетДо
	|	) КАК ДисконтныеКарты
	|ИЗ
	|	Документ.УЗ_НачислениеБонусов КАК НачислениеБонусов
	|ГДЕ
	|	НачислениеБонусов.Ссылка В (&Ссылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НачислениеБонусов.Дата,
	|	НачислениеБонусов.Ссылка";
	Запрос.УстановитьПараметр("Ссылка", МассивОбъектов);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		Если ТабДок.ВысотаТаблицы > 0 Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		НомерСтрокиНачало = ТабДок.ВысотаТаблицы + 1;
		ВывестиДокумент(ТабДок, Выборка);
		УЗ_Печать.ЗадатьОбластьДокумента(ТабДок, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
	КонецЦикла;

	ТабДок.ОтображатьСетку = Ложь;
	ТабДок.ОтображатьЗаголовки = Ложь;
	Возврат ТабДок;

КонецФункции

// Колонки: 1 — №, 2 — ученик, 3 — карта, 4 — начислено, 5 — действует до. Сумма ширин ~ ширина А4.
Процедура ВывестиДокумент(ТабДок, Выборка)

	Ширины = СтрРазделить("5,40,30,16,14", ",");
	Начало = ТабДок.ВысотаТаблицы + 1;
	Для НомерКолонки = 1 По Ширины.Количество() Цикл
		ТабДок.Область(1, НомерКолонки, 1, НомерКолонки).ШиринаКолонки = Число(Ширины[НомерКолонки - 1]);
	КонецЦикла;
	Тонкая = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	Обычный = Новый Шрифт("Arial", 9);
	Жирный = Новый Шрифт("Arial", 9, Истина);

	Ряд = Начало;
	Ячейка(ТабДок, Ряд, 1, 5, СтрШаблон(НСтр("ru = 'Начисление бонусов № %1 от %2'"),
		УЗ_ОбщийКлиентСервер.НомерНаПечать(Выборка.Номер), Формат(Выборка.Дата, "ДЛФ=D")), Новый Шрифт("Arial", 13, Истина));
	ТабДок.Область(Ряд, 1, Ряд, 5).ВысотаСтроки = 22;
	Ряд = Ряд + 1;
	Если ЗначениеЗаполнено(Выборка.Организация) Тогда
		Ячейка(ТабДок, Ряд, 1, 5, НСтр("ru = 'Организация: '") + Выборка.Организация, Обычный);
		Ряд = Ряд + 1;
	КонецЕсли;
	Ряд = Ряд + 1;

	Заголовки = СтрРазделить(НСтр("ru = '№|Ученик|Дисконтная карта|Начислено бонусов|Действует до'"), "|");
	Для НомерКолонки = 1 По 5 Цикл
		Область = Ячейка(ТабДок, Ряд, НомерКолонки, НомерКолонки, Заголовки[НомерКолонки - 1], Жирный);
		Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Область.Обвести(Тонкая, Тонкая, Тонкая, Тонкая);
		Область.ЦветФона = WebЦвета.ДымчатоБелый;
	КонецЦикла;
	Ряд = Ряд + 1;

	Итого = 0;
	Карт = 0;
	Строки = Выборка.ДисконтныеКарты.Выбрать();
	Пока Строки.Следующий() Цикл
		Значения = Новый Массив;
		Значения.Добавить(Строки.НомерСтроки);
		Значения.Добавить(Строка(Строки.Ученик));
		Значения.Добавить(Строка(Строки.ДисконтнаяКарта));
		Значения.Добавить(Формат(Строки.СуммаБонусов, "ЧДЦ=2; ЧН=0,00"));
		Значения.Добавить(?(ЗначениеЗаполнено(Строки.ДействуетДо), Формат(Строки.ДействуетДо, "ДЛФ=D"), НСтр("ru = 'бессрочно'")));
		Для НомерКолонки = 1 По 5 Цикл
			Область = Ячейка(ТабДок, Ряд, НомерКолонки, НомерКолонки, Значения[НомерКолонки - 1], Обычный);
			Область.Обвести(Тонкая, Тонкая, Тонкая, Тонкая);
			Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
			Если НомерКолонки = 1 Или НомерКолонки = 4 Тогда
				Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
			ИначеЕсли НомерКолонки = 5 Тогда
				Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
			КонецЕсли;
		КонецЦикла;
		Итого = Итого + Строки.СуммаБонусов;
		Карт = Карт + 1;
		Ряд = Ряд + 1;
	КонецЦикла;
	Если Карт = 0 Тогда
		Область = Ячейка(ТабДок, Ряд, 1, 5, НСтр("ru = 'Карты не указаны'"), Обычный);
		Область.Обвести(Тонкая, Тонкая, Тонкая, Тонкая);
		Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Ряд = Ряд + 1;
		Итого = Выборка.СуммаБонусов;
	КонецЕсли;
	Область = Ячейка(ТабДок, Ряд, 1, 3, НСтр("ru = 'Итого'"), Жирный);
	Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	Область = Ячейка(ТабДок, Ряд, 4, 4, Формат(Итого, "ЧДЦ=2; ЧН=0,00"), Жирный);
	Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	Область.Обвести(Тонкая, Тонкая, Тонкая, Тонкая);
	Ряд = Ряд + 2;

	Ячейка(ТабДок, Ряд, 1, 5, СтрШаблон(НСтр("ru = 'Всего начислено бонусов: %1, дисконтных карт: %2.'"),
		Формат(Итого, "ЧДЦ=2; ЧН=0,00"), Карт), Обычный);
	Ряд = Ряд + 1;
	Если ЗначениеЗаполнено(Выборка.Комментарий) Тогда
		Область = Ячейка(ТабДок, Ряд, 1, 5, НСтр("ru = 'Комментарий: '") + Выборка.Комментарий, Обычный);
		Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		Ряд = Ряд + 1;
	КонецЕсли;
	Ряд = Ряд + 1;
	Ячейка(ТабДок, Ряд, 1, 2, НСтр("ru = 'Ответственный ______________________'"), Обычный);
	Ячейка(ТабДок, Ряд, 3, 5, "/ " + Строка(Выборка.АвторДокумента) + " /", Обычный);

КонецПроцедуры

Функция Ячейка(ТабДок, НомерСтроки, Колонка1, Колонка2, Текст, Шрифт)

	Область = ТабДок.Область(НомерСтроки, Колонка1, НомерСтроки, Колонка2);
	Если Колонка2 > Колонка1 Тогда
		Область.Объединить();
	КонецЕсли;
	Область.Текст = Текст;
	Область.Шрифт = Шрифт;
	Область.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	Возврат Область;

КонецФункции
