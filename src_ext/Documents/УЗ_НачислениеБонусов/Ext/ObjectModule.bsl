
Процедура ОбработкаПроведения(Отказ, Режим)

	//В24: единые проверки карты — карта выбрана, действует на дату (срок, «Не действует»), бонусы ≥ 0
	Для Каждого Стр из ДисконтныеКарты Цикл
		Текст = Документы.УЗ_ПриходДенег.ПроверитьНачислениеБонусов(Стр.ДисконтнаяКарта, Дата, Стр.СуммаБонусов);
		Если НЕ ЗначениеЗаполнено(Текст) И НЕ ЗначениеЗаполнено(Стр.ДисконтнаяКарта) Тогда
			Текст = НСтр("ru = 'Не выбрана дисконтная карта.'");
		КонецЕсли;
		Если ЗначениеЗаполнено(Текст) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(НСтр("ru = 'Строка %1: %2'"), Стр.НомерСтроки, Текст);
			Сообщение.Поле = СтрШаблон("ДисконтныеКарты[%1].ДисконтнаяКарта", Стр.НомерСтроки - 1);
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// регистр ДвижениеДисконтныхКарт Приход
	Движения.УЗ_ДвижениеДисконтныхКарт.Записывать = Истина;
	Для Каждого Стр из ДисконтныеКарты Цикл
		Движение = Движения.УЗ_ДвижениеДисконтныхКарт.Добавить();
		Движение.ВидДвижения 		= ВидДвиженияНакопления.Приход;
		Движение.Период 			= Дата;
		Движение.Клиент 			= Стр.ДисконтнаяКарта.Владелец;
		Движение.ДисконтнаяКарта 	= Стр.ДисконтнаяКарта;
		Движение.СуммаБонусов 		= Стр.СуммаБонусов;
		Движение.Организация		= Организация;
	КонецЦикла;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если НЕ ЗначениеЗаполнено(ЭтотОбъект.АвторДокумента) Тогда
		ЭтотОбъект.АвторДокумента = УЗ_Среда.ТекущийПользователь();
	КонецЕсли;

	//итог шапки — сумма по картам (раньше итог писался в локальную переменную, и в шапке оставался 0); без карт
	//сумма шапки остаётся введённой — печать показывает её строкой «Карты не указаны»
	Если ДисконтныеКарты.Количество() > 0 Тогда
		СуммаБонусов = ДисконтныеКарты.Итог("СуммаБонусов");
	КонецЕсли;

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	АвторДокумента = Неопределено;
	Комментарий    = Неопределено;
КонецПроцедуры
