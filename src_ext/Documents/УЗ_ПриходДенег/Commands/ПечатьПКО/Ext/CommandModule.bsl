&НаСервере
Функция ПечатьПКОНаСервере(ПараметрКоманды)

	Если ТипЗнч(ПараметрКоманды) = Тип("Массив") Тогда
		МассивОбъектов = ПараметрКоманды;
	Иначе
		МассивОбъектов = Новый Массив;
		МассивОбъектов.Добавить(ПараметрКоманды);
	КонецЕсли;
	Возврат Документы.УЗ_ПриходДенег.ПечатьПКО(МассивОбъектов, Неопределено);

КонецФункции
