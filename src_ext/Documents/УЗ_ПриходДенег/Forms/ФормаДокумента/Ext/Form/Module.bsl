#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Элементы.ФормаСнятьРезервЧека.Видимость = РольДоступна("УЗ_Руководитель")
		Или ПравоДоступа("Администрирование", Метаданные);
	//новый документ — на текущее время, а не на полночь
	Если Объект.Ссылка.Пустая() И Объект.Дата = НачалоДня(Объект.Дата) Тогда
		Сейчас = НачалоМинуты(ТекущаяДатаСеанса());
		Объект.Дата = НачалоДня(?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, Сейчас)) + (Сейчас - НачалоДня(Сейчас));
	КонецЕсли;

	Если Объект.Ссылка.Пустая() Тогда
		ЗаполнитьЗначенияСвойств(Объект,Параметры.ЗначенияЗаполнения);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации";
	Если Запрос.Выполнить().Выгрузить().Количество() = 0 Тогда
		Элементы.Организация.Видимость = Ложь;
	КонецЕсли;

	//приход — только «Касса ученики» и «Внутренняя касса» (решение В7); расходные виды не проводятся
	Элементы.ВидОперации.РежимВыбораИзСписка = Истина;
	Элементы.ВидОперации.СписокВыбора.Очистить();
	Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.УЗ_ВидыОпераций.КассаУченики);
	Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.УЗ_ВидыОпераций.ВнутренняяКасса);

	//остаток бонусов — число (прежде у числа бралось поле .СуммаБонусовОстаток, и ПКО с картой не открывался)
	Если НЕ Объект.ДисконтнаяКарта.Пустая() Тогда
		ДоступноБонусов = РассчитатьОстатокБонусовНаСервере();
	КонецЕсли;

	//В35: один ученик — расшифровка в полях шапки (как ПКО типовых с одной строкой); несколько — списком
	РежимСписка = Объект.РасшифровкаПлатежа.Количество() > 1;
	ОбновитьРежимРасшифровки();
	Если Объект.Ссылка.Пустая() Тогда
		УЗ_Чеки.ПоказатьЧекВФорме(ЭтотОбъект, Объект.Ссылка);
	КонецЕсли;
	//оплата по QR (В65): новый приход можно превратить в счёт на оплату по QR — приход создастся сам по оплате
	Элементы.ФормаQRДляОплаты.Видимость = Объект.Ссылка.Пустая() И УЗ_ОплатыQR.ПравоВыставлять();

КонецПроцедуры

//В режиме списка единственная строка расшифровки переходит в шапку: шапка — простой вид одной строки
//(модуль объекта строит строку из шапки)
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если РежимСписка И ТекущийОбъект.РасшифровкаПлатежа.Количество() = 1 Тогда
		СтрокаОплаты = ТекущийОбъект.РасшифровкаПлатежа[0];
		ТекущийОбъект.ФизЛицо = СтрокаОплаты.Ученик;
		ТекущийОбъект.ПредметОбучения = СтрокаОплаты.ПредметОбучения;
		ТекущийОбъект.Абонемент = СтрокаОплаты.Абонемент;
		ТекущийОбъект.Тариф = СтрокаОплаты.Тариф;
		ТекущийОбъект.СуммаДокумента = СтрокаОплаты.Сумма;
	ИначеЕсли РежимСписка И ТекущийОбъект.РасшифровкаПлатежа.Количество() = 0 Тогда
		ТекущийОбъект.ФизЛицо = Справочники.УЗ_ФизЛица.ПустаяСсылка();
		ТекущийОбъект.СуммаДокумента = 0;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УЗ_ДатыЗапрета.ФормаПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	УЗ_Чеки.ПоказатьЧекВФорме(ЭтотОбъект, ТекущийОбъект.Ссылка);
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	Если ЗначениеЗаполнено(Объект.СуммаБонусов) и НЕ ЗначениеЗаполнено(Объект.ДисконтнаяКарта) Тогда
		Сообщить("Не выбрана дисконтная карта! Так как выбрана оплата бонусами.");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

//открытая карточка абонемента пересчитывает «Оплачено» (Справочник.УЗ_Абонемент, ОбработкаОповещения)
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Оповестить("Запись_УЗ_ПриходДенег", ПараметрыЗаписи, Объект.Ссылка);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбновитьВидимость();
КонецПроцедуры

//чек пробит в этой или другой форме документа (УЗ_ЧекиКлиент) — перечитать: ПриЧтенииНаСервере покажет чек
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "УЗ_ЧекПробит" И Параметр = Объект.Ссылка И Не Модифицированность Тогда
		Прочитать();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КлиентПриИзменении(Элемент)
	КлиентПриИзмененииНаСервере();
КонецПроцедуры

//находка 2 третьего аудита Codex (28.09.2026): смена организации или предмета очищает абонемент другой организации
//или предмета — оплата абонемента остаётся в его разрезе
&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	СогласоватьАбонемент();
КонецПроцедуры

&НаКлиенте
Процедура ПредметОбученияПриИзменении(Элемент)
	СогласоватьАбонемент();
КонецПроцедуры

//«Внутренняя касса» — прочее поступление без расшифровки по ученикам
&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	ВидОперацииПриИзмененииНаСервере();
КонецПроцедуры

//выбранный абонемент заполняет ученика, организацию и предмет — как приход на основании абонемента
&НаКлиенте
Процедура АбонементПриИзменении(Элемент)
	АбонементПриИзмененииНаСервере();
	ОбновитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура ДисконтнаяКартаПриИзменении(Элемент)

	Если ЗначениеЗаполнено(Объект.ДисконтнаяКарта) Тогда
		ДоступноБонусов = РассчитатьОстатокБонусовНаСервере();
	Иначе
		ДоступноБонусов = 0;
	КонецЕсли;

	ОбновитьВидимость();

КонецПроцедуры

&НаКлиенте
Процедура ДисконтнаяКартаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	//несколько учеников — карты любого из них (бонусы зачисляются строке владельца карты)
	ПараметрыОтбора = Новый Структура("Владелец", УченикиДокумента());
	ПараметрыОткрытия = Новый Структура("Отбор", ПараметрыОтбора);
	ОткрытьФорму("Справочник.УЗ_ДисконтныеКарты.ФормаВыбора", ПараметрыОткрытия, Элемент, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ДоступноДенегНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПараметрыОткрытия = ОткрытьДвиженяПоДисконтнойКартеНаСервере(Объект.ДисконтнаяКарта);
	ОткрытьФорму("Отчет.УЗ_ОтчетПоДисконтнымКартам.Форма", ПараметрыОткрытия, ЭтаФорма);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьТекстНазначенияПлатежа(Команда)

	Если РежимСписка Тогда
		Объект.НазначениеПлатежа = ТекстРасшифровкиНаСервере();
	ИначеЕсли ЗначениеЗаполнено(Объект.ФизЛицо) Тогда

		СписокУроков = ОпределитьСписокУроков();

		Объект.НазначениеПлатежа = "Ученик: " +Объект.ФизЛицо+
		?(ЗначениеЗаполнено(Объект.ПредметОбучения),", за предмет: " +Объект.ПредметОбучения,"")+
		?(СписокУроков<>"",", за уроки: " +СписокУроков,"");

	КонецЕсли;

КонецПроцедуры

//В35: ученики плательщика с долгами в организации документа — строками расшифровки
&НаКлиенте
Процедура ЗаполнитьПоДолгам(Команда)

	Если НЕ ЗначениеЗаполнено(Объект.Плательщик) Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Выберите плательщика: по долгам заполняются ученики, за которых он платит (карточка ученика, "
			+ "страница «Плательщики»).'"), "Плательщик", "Объект");
		Возврат;
	КонецЕсли;
	Пояснение = ЗаполнитьПоДолгамНаСервере();
	//итог заполнения — оповещением: сообщение у поля веб-клиент показывает плашкой «Ошибка:»
	Если СтрНачинаетсяС(Пояснение, НСтр("ru = 'Заполнено по долгам'")) Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Заполнено по долгам'"), , Пояснение, БиблиотекаКартинок.Информация);
	ИначеЕсли ЗначениеЗаполнено(Пояснение) Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(Пояснение, "Плательщик", "Объект");
	КонецЕсли;

КонецПроцедуры

//В35: один платёж за нескольких учеников — расшифровка списком; обратно — к одному ученику (если строка одна)
&НаКлиенте
Процедура НесколькоУчеников(Команда)

	Пояснение = ПереключитьРежимНаСервере();
	Если ЗначениеЗаполнено(Пояснение) Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(Пояснение, "РасшифровкаПлатежа", "Объект");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаСуммаПриИзменении(Элемент)
	Объект.СуммаДокумента = Объект.РасшифровкаПлатежа.Итог("Сумма");
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПослеУдаления(Элемент)
	Объект.СуммаДокумента = Объект.РасшифровкаПлатежа.Итог("Сумма");
КонецПроцедуры

//строка: абонемент другого ученика или предмета очищается; выбранный абонемент заполняет ученика и предмет строки
&НаКлиенте
Процедура РасшифровкаПлатежаУченикПриИзменении(Элемент)
	СогласоватьТекущуюСтроку(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаПредметОбученияПриИзменении(Элемент)
	СогласоватьТекущуюСтроку(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаПлатежаАбонементПриИзменении(Элемент)
	СогласоватьТекущуюСтроку(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СогласоватьТекущуюСтроку(ПоАбонементу)

	Текущая = Элементы.РасшифровкаПлатежа.ТекущиеДанные;
	Если Текущая <> Неопределено Тогда
		СогласоватьСтрокуНаСервере(Текущая.ПолучитьИдентификатор(), ПоАбонементу);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЗадолженность(Команда)

	Пояснение = РассчитатьЗадолженностьНаСервере();
	Если ЗначениеЗаполнено(Пояснение) Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(Пояснение, "ПредметОбучения", "Объект");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВзаиморасчеты(Команда)

	Если ЗначениеЗаполнено(Объект.ФизЛицо) Тогда
		ПараметрыОткрытия = ОткрытьВзаиморасчетыНаСервере();
		ОткрытьФорму("Отчет.УЗ_Взаиморасчеты.Форма", ПараметрыОткрытия, ЭтаФорма);
	Иначе
		ОткрытьФорму("Отчет.УЗ_Взаиморасчеты.Форма", , ЭтаФорма);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РассчитатьОстатокБонусов(Команда)
	Если ЗначениеЗаполнено(Объект.ДисконтнаяКарта) Тогда
		ДоступноБонусов = РассчитатьОстатокБонусовНаСервере();
	Иначе
		Сообщить("Не выбрана дисконтная карта!");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСуммуПоТарифу(Команда)

	Если ЗначениеЗаполнено(Объект.Тариф) Тогда
		Объект.СуммаДокумента = ПолучитьСуммуПоТарифуНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДвиженияДокумента(Команда)
	ДанныеС = Новый Структура;
	ДанныеС.Вставить("Документ",Объект.Ссылка);
	ОткрытьФорму("Отчет.УЗ_ДвиженияДокумента.Форма.ДвиженияДокумента",ДанныеС ,ЭтаФорма, , , , ,
		РежимОткрытияОкнаФормы.Независимый);
КонецПроцедуры

//чек 54-ФЗ на онлайн-кассе программы (этап 2.2, В61): приход — оплата ученика, расход — возврат прихода
&НаКлиенте
Процедура ПробитьЧек(Команда)
	УЗ_ЧекиКлиент.ПробитьЧек(ЭтотОбъект);
КонецПроцедуры

//«QR для оплаты» (В65): вместо этого прихода — счёт на оплату по QR с той же суммой и расшифровкой; форма прихода
//закрывается без записи, приход денег создаст задание «Проверка оплат по QR», когда банк подтвердит оплату.
&НаКлиенте
Процедура QRДляОплаты(Команда)

	Данные = ДанныеДляQRНаСервере();
	Если Не ПустаяСтрока(Данные.Причина) Тогда
		ПоказатьПредупреждение(, Данные.Причина);
		Возврат;
	КонецЕсли;
	ОткрытьФорму("Документ.УЗ_СчетНаОплатуQR.ФормаОбъекта", Новый Структура("Основание", Данные.Основание));
	Модифицированность = Ложь;
	Закрыть();

КонецПроцедуры

&НаКлиенте
Процедура СнятьРезервЧека(Команда)

	УЗ_Чеки.СнятьРезервЧека(Объект.Ссылка);
	Оповестить("УЗ_ЧекПробит", , Объект.Ссылка);
	ПоказатьОповещениеПользователя(НСтр("ru = 'Резерв чека снят'"), , НСтр(
		"ru = 'Пробивать заново — только если в журнале ККТ этого чека нет.'"));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура КлиентПриИзмененииНаСервере()

	//В33: плательщик — основной плательщик ученика (нет — пусто: платит сам)
	Объект.Плательщик = Справочники.УЗ_ФизЛица.ОсновнойПлательщик(Объект.ФизЛицо);
	Объект.ДисконтнаяКарта = Неопределено;
	СогласоватьАбонемент();

КонецПроцедуры

//Абонемент другого ученика, организации или предмета (Документы.УЗ_ПриходДенег.ТекстНесогласованногоАбонемента —
//та же проверка, что при проведении) очищается с пояснением.
&НаСервере
Процедура СогласоватьАбонемент()

	Текст = Документы.УЗ_ПриходДенег.ТекстНесогласованногоАбонемента(Объект.Абонемент, Объект.ФизЛицо,
		Объект.Организация, Объект.ПредметОбучения, Объект.ВидОперации);
	Если ЗначениеЗаполнено(Текст) Тогда
		Объект.Абонемент = Справочники.УЗ_Абонемент.ПустаяСсылка();
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(Текст + " " + НСтр("ru = 'Абонемент очищен.'"), "Абонемент",
			"Объект");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура АбонементПриИзмененииНаСервере()

	Абонемент = Объект.Абонемент;
	Если НЕ ЗначениеЗаполнено(Абонемент) Тогда
		Возврат;
	КонецЕсли;
	Объект.ВидОперации = Перечисления.УЗ_ВидыОпераций.КассаУченики;
	Если Объект.ФизЛицо <> Абонемент.ФизЛицо Тогда
		Объект.ФизЛицо = Абонемент.ФизЛицо;
		Объект.Плательщик = Справочники.УЗ_ФизЛица.ОсновнойПлательщик(Объект.ФизЛицо);
		Объект.ДисконтнаяКарта = Неопределено;
		ДоступноБонусов = 0;
	КонецЕсли;
	Если ЗначениеЗаполнено(Абонемент.Организация) Тогда
		Объект.Организация = Абонемент.Организация;
	КонецЕсли;
	Если ЗначениеЗаполнено(Абонемент.ПредметОбучения) Тогда
		Объект.ПредметОбучения = Абонемент.ПредметОбучения;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ОпределитьСписокУроков()

	//неоплаченные уроки — из регистра денег ученика в организации ПКО на момент ПКО без него самого
	//(УЗ_Сервер.НеоплаченныеУрокиУченика); прежде — сумма документов ПКО по всем организациям
	Граница = ?(Объект.Ссылка.Пустая(), Неопределено,
		Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	Уроки = УЗ_Сервер.НеоплаченныеУрокиУченика(Объект.ФизЛицо, Объект.Организация,
		?(ЗначениеЗаполнено(Объект.ПредметОбучения), Объект.ПредметОбучения, Неопределено), Граница);
	Даты = Новый Массив;
	Для Каждого ДатаУрока Из Уроки Цикл
		Даты.Добавить(Формат(ДатаУрока, "ДФ='дд.ММ.гггг (ЧЧ:мм)'"));
	КонецЦикла;
	Возврат СтрСоединить(Даты, ", ");

КонецФункции

//Сумма (и предмет, если он пуст) по долгу ученика; возвращает пояснение для пользователя или "".
&НаСервере
Функция РассчитатьЗадолженностьНаСервере()

	//В12: долг ученика — в организации ПКО (деньги учеников раздельно по организациям); по предмету — за вычетом
	//аванса, внесённого без предмета (иначе ПКО по предмету предлагал взять деньги второй раз). Предмет пуст —
	//подставляется предмет долга (УЗ_Сервер.ЗаполнениеПоЗадолженности): приход без предмета долг предмета не гасил.
	Заполнение = УЗ_Сервер.ЗаполнениеПоЗадолженности(Объект.ФизЛицо, Объект.Организация,
		?(ЗначениеЗаполнено(Объект.ПредметОбучения), Объект.ПредметОбучения, Неопределено),
		?(Объект.Ссылка.Пустая(), Неопределено, Объект.Ссылка));
	Если Заполнение.ПредметОбучения <> Неопределено И Объект.ПредметОбучения <> Заполнение.ПредметОбучения Тогда
		Объект.ПредметОбучения = Заполнение.ПредметОбучения;
		СогласоватьАбонемент();
	КонецЕсли;
	Объект.СуммаДокумента = Заполнение.Сумма;
	Возврат Заполнение.Пояснение;

КонецФункции

