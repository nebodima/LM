//Строки по долгам плательщика (Документы.УЗ_ПриходДенег.СтрокиПоДолгамПлательщика) заменяют расшифровку; одна
//строка — в шапку (режим одного ученика), несколько — списком. Возврат: пояснение для пользователя.
&НаСервере
Функция ЗаполнитьПоДолгамНаСервере()

	//проведённый приход заполняется заново — долг без его движений (он их заменит)
	Строки = Документы.УЗ_ПриходДенег.СтрокиПоДолгамПлательщика(Объект.Плательщик, Объект.Организация,
		?(Объект.Ссылка.Пустая(), Неопределено, Объект.Ссылка));
	Если Строки.Количество() = 0 Тогда
		Ученики = Справочники.УЗ_ФизЛица.УченикиПлательщика(Объект.Плательщик);
		Если Ученики.Количество() = 0 Тогда
			Возврат СтрШаблон(НСтр("ru = '%1 не указан плательщиком ни у одного ученика (карточка ученика, страница "
				+ "«Плательщики»).'"), Объект.Плательщик);
		КонецЕсли;
		Имена = Новый Массив;
		Для Каждого Ученик Из Ученики Цикл
			Имена.Добавить(Строка(Ученик));
		КонецЦикла;
		Возврат СтрШаблон(НСтр("ru = 'У учеников плательщика %1 (%2) долгов%3 нет — расшифровка не изменена.'"),
			Объект.Плательщик, СтрСоединить(Имена, ", "),
			?(ЗначениеЗаполнено(Объект.Организация),
				" " + НСтр("ru = 'в организации'") + " «" + Объект.Организация + "»", ""));
	КонецЕсли;
	Объект.РасшифровкаПлатежа.Очистить();
	Для Каждого Долг Из Строки Цикл
		ЗаполнитьЗначенияСвойств(Объект.РасшифровкаПлатежа.Добавить(), Долг);
	КонецЦикла;
	Объект.СуммаДокумента = Объект.РасшифровкаПлатежа.Итог("Сумма");
	Объект.ДисконтнаяКарта = Неопределено;
	РежимСписка = Строки.Количество() > 1;
	Если НЕ РежимСписка Тогда
		СтрокаВШапку(Объект.РасшифровкаПлатежа[0]);
	КонецЕсли;
	ОбновитьРежимРасшифровки();
	Возврат СтрШаблон(НСтр("ru = 'Заполнено по долгам: %1.'"),
		Документы.УЗ_ПриходДенег.ТекстРасшифровки(Объект.РасшифровкаПлатежа));

КонецФункции

//Переключение «один ученик» ↔ «несколько учеников». Возврат: почему не переключилось, или "".
&НаСервере
Функция ПереключитьРежимНаСервере()

	Если РежимСписка Тогда
		Если Объект.РасшифровкаПлатежа.Количество() > 1 Тогда
			Возврат СтрШаблон(НСтр(
				"ru = 'В расшифровке %1 строк: чтобы вернуться к одному ученику, оставьте одну строку.'"),
				Объект.РасшифровкаПлатежа.Количество());
		КонецЕсли;
		Если Объект.РасшифровкаПлатежа.Количество() = 1 Тогда
			СтрокаВШапку(Объект.РасшифровкаПлатежа[0]);
		КонецЕсли;
		РежимСписка = Ложь;
	Иначе
		//шапка одного ученика — первой строкой списка (модуль объекта держит её равной шапке)
		Если ЗначениеЗаполнено(Объект.ФизЛицо) Или ЗначениеЗаполнено(Объект.СуммаДокумента) Тогда
			Если Объект.РасшифровкаПлатежа.Количество() = 0 Тогда
				Объект.РасшифровкаПлатежа.Добавить();
			КонецЕсли;
			СтрокаОплаты = Объект.РасшифровкаПлатежа[0];
			СтрокаОплаты.Ученик = Объект.ФизЛицо;
			СтрокаОплаты.ПредметОбучения = Объект.ПредметОбучения;
			СтрокаОплаты.Абонемент = Объект.Абонемент;
			СтрокаОплаты.Тариф = Объект.Тариф;
			СтрокаОплаты.Сумма = Объект.СуммаДокумента;
		КонецЕсли;
		РежимСписка = Истина;
	КонецЕсли;
	ОбновитьРежимРасшифровки();
	Возврат "";

КонецФункции

&НаСервере
Процедура ВидОперацииПриИзмененииНаСервере()

	Если Объект.ВидОперации <> Перечисления.УЗ_ВидыОпераций.КассаУченики И РежимСписка Тогда
		Объект.РасшифровкаПлатежа.Очистить();
		РежимСписка = Ложь;
	КонецЕсли;
	ОбновитьРежимРасшифровки();

КонецПроцедуры

&НаСервере
Процедура СтрокаВШапку(СтрокаОплаты)

	Объект.ФизЛицо = СтрокаОплаты.Ученик;
	Объект.ПредметОбучения = СтрокаОплаты.ПредметОбучения;
	Объект.Абонемент = СтрокаОплаты.Абонемент;
	Объект.Тариф = СтрокаОплаты.Тариф;
	Объект.СуммаДокумента = СтрокаОплаты.Сумма;

КонецПроцедуры

//Видимость: один ученик — поля шапки (ученик, предмет, тариф, абонемент, кнопки суммы); несколько — таблица
//расшифровки, сумма документа — итог строк (только просмотр).
&НаСервере
Процедура ОбновитьРежимРасшифровки()

	Оплата = (Объект.ВидОперации = Перечисления.УЗ_ВидыОпераций.КассаУченики);
	Элементы.ГруппаРасшифровка.Видимость = РежимСписка;
	Для Каждого Имя Из СтрРазделить("Клиент,ПредметОбучения,Тариф,Абонемент,Группа3", ",") Цикл
		Элементы[Имя].Видимость = НЕ РежимСписка;
	КонецЦикла;
	Элементы.Сумма.ТолькоПросмотр = РежимСписка;
	Элементы.ЗаполнитьПоДолгам.Видимость = Оплата;
	Элементы.НесколькоУчеников.Видимость = Оплата;
	Элементы.НесколькоУчеников.Заголовок = ?(РежимСписка, НСтр("ru = 'Один ученик'"),
		НСтр("ru = 'Несколько учеников'"));

КонецПроцедуры

//Строка расшифровки: абонемент другого ученика, организации или предмета — очищается с пояснением (та же проверка,
//что при проведении); выбранный абонемент заполняет ученика и предмет строки.
&НаСервере
Процедура СогласоватьСтрокуНаСервере(Идентификатор, ПоАбонементу)

	СтрокаОплаты = Объект.РасшифровкаПлатежа.НайтиПоИдентификатору(Идентификатор);
	Если СтрокаОплаты = Неопределено Или НЕ ЗначениеЗаполнено(СтрокаОплаты.Абонемент) Тогда
		Возврат;
	КонецЕсли;
	Абонемент = СтрокаОплаты.Абонемент;
	Если ПоАбонементу Тогда
		СтрокаОплаты.Ученик = Абонемент.ФизЛицо;
		Если ЗначениеЗаполнено(Абонемент.ПредметОбучения) Тогда
			СтрокаОплаты.ПредметОбучения = Абонемент.ПредметОбучения;
		КонецЕсли;
	КонецЕсли;
	Текст = Документы.УЗ_ПриходДенег.ТекстНесогласованногоАбонемента(Абонемент, СтрокаОплаты.Ученик,
		Объект.Организация, СтрокаОплаты.ПредметОбучения, Объект.ВидОперации);
	Если ЗначениеЗаполнено(Текст) Тогда
		СтрокаОплаты.Абонемент = Справочники.УЗ_Абонемент.ПустаяСсылка();
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(Текст + " " + НСтр("ru = 'Абонемент очищен.'"),
			СтрШаблон("РасшифровкаПлатежа[%1].Абонемент", Формат(Объект.РасшифровкаПлатежа.Индекс(СтрокаОплаты),
				"ЧН=0; ЧГ=0")), "Объект");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ТекстРасшифровкиНаСервере()
	Возврат Документы.УЗ_ПриходДенег.ТекстРасшифровки(Объект.РасшифровкаПлатежа);
КонецФункции

//Ученики документа: один ученик — из шапки, несколько — из строк расшифровки (Массив).
&НаКлиенте
Функция УченикиДокумента()

	Ученики = Новый Массив;
	Если НЕ РежимСписка Тогда
		Ученики.Добавить(Объект.ФизЛицо);
		Возврат Ученики;
	КонецЕсли;
	Для Каждого СтрокаОплаты Из Объект.РасшифровкаПлатежа Цикл
		Ученики.Добавить(СтрокаОплаты.Ученик);
	КонецЦикла;
	Возврат Ученики;

КонецФункции

&НаСервере
Функция ДанныеДляQRНаСервере()

	Итог = Новый Структура("Причина, Основание", "", Неопределено);
	Если Не Объект.Ссылка.Пустая() Тогда
		Итог.Причина = НСтр("ru = 'Приход уже записан. QR выставляется вместо нового прихода: создайте новый приход или
			|«Счёт на оплату по QR».'");
		Возврат Итог;
	ИначеЕсли Объект.ВидОперации <> Перечисления.УЗ_ВидыОпераций.КассаУченики Тогда
		Итог.Причина = НСтр("ru = 'Оплата по QR — только оплата ученика (вид «Касса ученики»).'");
		Возврат Итог;
	ИначеЕсли Объект.СуммаБонусов > 0 Тогда
		Итог.Причина = НСтр(
			"ru = 'Бонусы в оплату по QR не входят: уберите бонусы (или примите их отдельным приходом).'");
		Возврат Итог;
	КонецЕсли;
	Строки = Новый Массив;
	Если РежимСписка Тогда
		Для Каждого СтрокаОплаты Из Объект.РасшифровкаПлатежа Цикл
			Строки.Добавить(Новый Структура("Ученик, ПредметОбучения, Абонемент, Тариф, Сумма", СтрокаОплаты.Ученик,
				СтрокаОплаты.ПредметОбучения, СтрокаОплаты.Абонемент, СтрокаОплаты.Тариф, СтрокаОплаты.Сумма));
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(Объект.ФизЛицо) Тогда
		Строки.Добавить(Новый Структура("Ученик, ПредметОбучения, Абонемент, Тариф, Сумма", Объект.ФизЛицо,
			Объект.ПредметОбучения, Объект.Абонемент, Объект.Тариф, Объект.СуммаДокумента));
	КонецЕсли;
	Сумма = 0;
	Для Каждого СтрокаОплаты Из Строки Цикл
		Сумма = Сумма + СтрокаОплаты.Сумма;
	КонецЦикла;
	Если Строки.Количество() = 0 Или Сумма <= 0 Тогда
		Итог.Причина = НСтр("ru = 'Укажите ученика и сумму оплаты — на неё выставится QR.'");
		Возврат Итог;
	КонецЕсли;
	Основание = Новый Структура("Организация, Плательщик, СтрокиОплаты", Объект.Организация, Объект.Плательщик, Строки);
	Если ТипЗнч(Объект.ДокументОснования) = Тип("СправочникСсылка.УЗ_ФизЛица")
		Или ТипЗнч(Объект.ДокументОснования) = Тип("СправочникСсылка.УЗ_Абонемент") Тогда
		Основание.Вставить("ДокументОснования", Объект.ДокументОснования);
	КонецЕсли;
	Итог.Основание = Основание;
	Возврат Итог;

КонецФункции

Процедура ОбновитьВидимость()

	Если Объект.ДисконтнаяКарта.Пустая() Тогда
		Элементы.СуммаБонусов.Доступность = Ложь;
		Объект.СуммаБонусов = 0;
	Иначе
		Элементы.СуммаБонусов.Доступность = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти