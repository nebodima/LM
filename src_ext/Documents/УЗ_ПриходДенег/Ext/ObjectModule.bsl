#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)

	//дата запрета проверяется подпиской УЗ_ДатаЗапретаПередЗаписью (модуль УЗ_ДатыЗапрета)

	//решение В7: приход — только «Касса ученики» (оплата ученика) или «Внутренняя касса» (прочее поступление);
	//расходные виды в приходе молча добавляли бы деньги в кассу под видом выплаты/расхода
	Если ВидОперации <> Перечисления.УЗ_ВидыОпераций.КассаУченики
		И ВидОперации <> Перечисления.УЗ_ВидыОпераций.ВнутренняяКасса Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
			СтрШаблон(НСтр(
			"ru = 'Вид «%1» — для расхода денег. В приходе выберите «Касса ученики» (оплата ученика) или "
			+ "«Внутренняя касса» (прочее поступление).'"),
			ВидОперации), "ВидОперации", Отказ);
		Возврат;
	КонецЕсли;
	ПроверитьЗаполнениеПрихода(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	//В35 (этап 2.1): деньги — по строкам расшифровки платежа (за кого и за что внесены); «Внутренняя касса» — одной
	//строкой кассы, без расшифровки. Плательщик — в реквизите движения кассы: по нему отчёт «Оплаты по плательщикам»
	//(кто сколько внёс за кого за год); пустой плательщик — платит сам ученик
	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.КассаУченики Тогда
		Для Каждого СтрокаОплаты Из РасшифровкаПлатежа Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаОплаты.Сумма) Тогда
				Продолжить;
			КонецЕсли;
			Движение = Движения.УЗ_Касса.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = Дата;
			Движение.Клиент = СтрокаОплаты.Ученик;
			Движение.Сумма = СтрокаОплаты.Сумма;
			Движение.Касса = Касса;
			Движение.ПредметОбучения = СтрокаОплаты.ПредметОбучения;
			Движение.ВидОперации = ВидОперации;
			Движение.СтатьяЗатрат = СтатьяЗатрат;
			Движение.Организация = Организация;
			Движение.Абонемент = СтрокаОплаты.Абонемент;
			Движение.Плательщик = ?(ЗначениеЗаполнено(Плательщик), Плательщик, СтрокаОплаты.Ученик);
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(СуммаДокумента) Тогда
		Движение = Движения.УЗ_Касса.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Клиент = ФизЛицо;
		Движение.Сумма = СуммаДокумента;
		Движение.Касса = Касса;
		Движение.ПредметОбучения = ПредметОбучения;
		Движение.ВидОперации = ВидОперации;
		Движение.СтатьяЗатрат = СтатьяЗатрат;
		Движение.Организация = Организация;
		Движение.Абонемент = Абонемент;
		Движение.Плательщик = Плательщик;
	КонецЕсли;
	Движения.УЗ_Касса.Записывать = Истина;

	//В14: уменьшение прихода или перенос в другую кассу не уводит кассу в минус (деньги уже выданы расходами)
	Справочники.УЗ_Кассы.ПроверитьОстаткиКасс(ЭтотОбъект, Движения.УЗ_Касса, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.КассаУченики Тогда
		// регистр СписанияСуммЗаУроки: деньги каждого ученика — на его баланс по предмету и абонементу строки
		Для Каждого СтрокаОплаты Из РасшифровкаПлатежа Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаОплаты.Сумма) Тогда
				Продолжить;
			КонецЕсли;
			Движение = Движения.УЗ_СписанияСуммЗаУроки.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Период = Дата;
			Движение.Клиент = СтрокаОплаты.Ученик;
			Движение.Сумма = СтрокаОплаты.Сумма;
			Движение.Тариф = СтрокаОплаты.Тариф;
			Движение.ПредметОбучения = СтрокаОплаты.ПредметОбучения;
			Движение.Организация = Организация;
			Движение.Абонемент = СтрокаОплаты.Абонемент;
		КонецЦикла;
		Движения.УЗ_СписанияСуммЗаУроки.Записывать = Истина;
	КонецЕсли;

	Если ЗначениеЗаполнено(СуммаБонусов) И Не ЗначениеЗаполнено(ДисконтнаяКарта) Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, "Оплата бонусами: не выбрана дисконтная карта", "ДисконтнаяКарта",
			Отказ);
	КонецЕсли;

	Если ЗначениеЗаполнено(ДисконтнаяКарта) и ЗначениеЗаполнено(СуммаБонусов) Тогда

		//В24: единые проверки карты (срок, «Не действует», сумма ≥ 0, остаток под исключительной блокировкой —
		//две оплаты не потратят одни бонусы) — та же функция, что в списании остатков
		ТекстОшибкиКарты =
			Документы.УЗ_ПриходДенег.ПроверитьСписаниеБонусов(ДисконтнаяКарта, Дата, СуммаБонусов, Ссылка);
		Если ЗначениеЗаполнено(ТекстОшибкиКарты) Тогда
			УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, ТекстОшибкиКарты, "СуммаБонусов", Отказ);
		КонецЕсли;
		//В35: бонусы — оплата ученика-владельца карты: его строка расшифровки (одна строка — она)
		СтрокаБонусов = СтрокаОплатыБонусами();
		Если СтрокаБонусов = Неопределено Тогда
			УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, СтрШаблон(НСтр(
				"ru = 'Бонусы карты «%1» принимаются в оплату её владельца %2 — его нет в расшифровке платежа.'"),
				ДисконтнаяКарта, ДисконтнаяКарта.Владелец), "СуммаБонусов", Отказ);
			Возврат;
		КонецЕсли;

		//СписаниеБонусов
		Движения.УЗ_ДвижениеДисконтныхКарт.Записывать = Истина;
		Движение = Движения.УЗ_ДвижениеДисконтныхКарт.Добавить();
		Движение.ВидДвижения 		= ВидДвиженияНакопления.Расход;
		Движение.Период 	 		= Дата;
		Движение.Клиент 	 		= ДисконтнаяКарта.Владелец;
		Движение.ДисконтнаяКарта 	= ДисконтнаяКарта;
		Движение.СуммаБонусов		= СуммаБонусов;
		Движение.Организация 		= Организация;

		// регистр СписанияСуммЗаУроки ОплачиваемБонусами
		Движения.УЗ_СписанияСуммЗаУроки.Записывать = Истина;
		Движение = Движения.УЗ_СписанияСуммЗаУроки.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период 	 		= Дата;
		Движение.Клиент 	 		= СтрокаБонусов.Ученик;
		Движение.Сумма  	 		= СуммаБонусов;
		Движение.Тариф		 		= СтрокаБонусов.Тариф;
		Движение.ПредметОбучения 	= СтрокаБонусов.ПредметОбучения;
		Движение.Организация 		= Организация;
		Движение.Абонемент 			= СтрокаБонусов.Абонемент;

	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	УЗ_Общий.ЗаполнитьАвтораИОрганизацию(ЭтотОбъект);
	Если НЕ ОбменДанными.Загрузка Тогда
		СинхронизироватьРасшифровку(Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	//В14: отмена проведения (и пометка удаления) прихода не уводит кассу в минус — эти деньги уже могли выдать
	Справочники.УЗ_Кассы.ПередЗаписьюДокументаКассы(ЭтотОбъект, РежимЗаписи, Отказ);

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Если ЭтоНовый() Тогда
		LMНастроки = РегистрыСведений.УЗ_Настройки.Настройки();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, LMНастроки);
	КонецЕсли;

	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.УЗ_ФизЛица") Тогда

		ВидОперации	= Перечисления.УЗ_ВидыОпераций.КассаУченики;
		ФизЛицо	= ДанныеЗаполнения.Ссылка;
		ДокументОснования = ДанныеЗаполнения.Ссылка;
		//В33: плательщик — основной плательщик ученика (нет — пусто: платит сам)
		Плательщик = Справочники.УЗ_ФизЛица.ОсновнойПлательщик(ФизЛицо);

	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.УЗ_Абонемент") Тогда

		ВидОперации			= Перечисления.УЗ_ВидыОпераций.КассаУченики;
		ФизЛицо			= ДанныеЗаполнения.Ссылка.ФизЛицо;
		Абонемент			= ДанныеЗаполнения.Ссылка;
		ДокументОснования 	= ДанныеЗаполнения.Ссылка;
		ПредметОбучения 	= ДанныеЗаполнения.Ссылка.ПредметОбучения;
		Плательщик = Справочники.УЗ_ФизЛица.ОсновнойПлательщик(ФизЛицо);
		//организация абонемента (им оплачены уроки этой организации) и сумма — неоплаченный остаток цены: второй
		//приход по абонементу не берёт цену целиком ещё раз (прежде — организация из настроек и полная цена)
		Если ЗначениеЗаполнено(ДанныеЗаполнения.Организация) Тогда
			Организация = ДанныеЗаполнения.Организация;
		КонецЕсли;
		//R13: та же функция, что «Осталось оплатить» в карточке абонемента (оплата минус возвраты)
		СуммаДокумента = Справочники.УЗ_Абонемент.ОплатаАбонемента(ДанныеЗаполнения).ОсталосьОплатить;

	КонецЕсли;

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	АвторДокумента 	= Неопределено;
	Комментарий    	= Неопределено;
	Абонемент 		= Неопределено;
	ДисконтнаяКарта = Неопределено;
	ДокументОснования = Неопределено;
	//абонемент оплачивается один раз: в копии строки расшифровки без абонементов
	Для Каждого СтрокаОплаты Из РасшифровкаПлатежа Цикл
		СтрокаОплаты.Абонемент = Неопределено;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(ОбъектКопирования.Организация) Тогда
		LMНастроки = РегистрыСведений.УЗ_Настройки.Настройки();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, LMНастроки);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//Обязательное в приходе: сумма денег и бонусов ≥ 0 и хоть что-то принято; деньги — в указанную кассу своей
//организации (В12); оплата ученика — с учениками в расшифровке платежа (В35: каждая строка — ученик, в
//нескольких строках — сумма каждой больше нуля, абонемент строки — этого ученика, организации и предмета); бонусы
//(В24) — только оплата ученика: «Внутренняя касса» не зачисляет их ученику (прежде зачисляла — прочее поступление
//увеличивало баланс ученика мимо денег).
Процедура ПроверитьЗаполнениеПрихода(Отказ)

	Если СуммаДокумента < 0 Или СуммаБонусов < 0 Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
			НСтр("ru = 'Сумма и бонусы в приходе не могут быть отрицательными: возврат денег — расход денег "
			+ "«Касса ученики».'"),
			"СуммаДокумента", Отказ);
		Возврат;
	КонецЕсли;
	Если СуммаДокумента + СуммаБонусов = 0 Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Укажите сумму прихода (или бонусы в оплату).'"),
			"СуммаДокумента", Отказ);
	КонецЕсли;
	Если СуммаДокумента > 0 И НЕ ЗначениеЗаполнено(Касса) Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Укажите кассу, в которую поступают деньги.'"), "Касса",
			Отказ);
	КонецЕсли;
	ТекстКассы = Справочники.УЗ_Кассы.ТекстКассаДругойОрганизации(Касса, Организация);
	Если ЗначениеЗаполнено(ТекстКассы) Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, ТекстКассы, "Касса", Отказ);
	КонецЕсли;
	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.ВнутренняяКасса И СуммаБонусов > 0 Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
			НСтр("ru = 'Бонусы принимаются только в оплату ученика (вид «Касса ученики»): прочее поступление "
			+ "«Внутренняя касса» бонусы ученику не зачисляет.'"),
			"СуммаБонусов", Отказ);
	КонецЕсли;
	Если ВидОперации <> Перечисления.УЗ_ВидыОпераций.КассаУченики Тогда
		ТекстАбонемента = Документы.УЗ_ПриходДенег.ТекстНесогласованногоАбонемента(Абонемент, ФизЛицо, Организация,
			ПредметОбучения, ВидОперации);
		Если ЗначениеЗаполнено(ТекстАбонемента) Тогда
			УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, ТекстАбонемента, "Абонемент", Отказ);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если РасшифровкаПлатежа.Количество() = 0 Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Оплата ученика — укажите ученика (физ. лицо).'"),
			"ФизЛицо", Отказ);
		Возврат;
	КонецЕсли;
	Несколько = РасшифровкаПлатежа.Количество() > 1;
	Для Каждого СтрокаОплаты Из РасшифровкаПлатежа Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаОплаты.Ученик) Тогда
			УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, ?(Несколько,
				СтрШаблон(НСтр("ru = 'Расшифровка платежа, строка %1: укажите ученика.'"), СтрокаОплаты.НомерСтроки),
				НСтр("ru = 'Оплата ученика — укажите ученика (физ. лицо).'")),
				ПолеСтроки(СтрокаОплаты, "Ученик", "ФизЛицо"), Отказ);
			Продолжить;
		КонецЕсли;
		Если Несколько И СтрокаОплаты.Сумма <= 0 Тогда
			УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, СтрШаблон(НСтр(
				"ru = 'Расшифровка платежа, строка %1 (%2): укажите сумму или удалите строку.'"),
				СтрокаОплаты.НомерСтроки, СтрокаОплаты.Ученик), ПолеСтроки(СтрокаОплаты, "Сумма", "СуммаДокумента"),
				Отказ);
		КонецЕсли;
		//находка 2 третьего аудита Codex (28.09.2026): оплата абонемента — деньги этого абонемента: ученик,
		//организация и предмет строки те же, что у абонемента (прежде ПКО по абонементу А/математика, переведённый на
		//организацию Б или гитару, показывал абонемент оплаченным, а деньги лежали в другом разрезе)
		ТекстАбонемента = Документы.УЗ_ПриходДенег.ТекстНесогласованногоАбонемента(СтрокаОплаты.Абонемент,
			СтрокаОплаты.Ученик, Организация, СтрокаОплаты.ПредметОбучения, ВидОперации);
		Если ЗначениеЗаполнено(ТекстАбонемента) Тогда
			Если Несколько Тогда
				ТекстАбонемента = СтрШаблон(НСтр("ru = 'Расшифровка платежа, строка %1: %2'"), СтрокаОплаты.НомерСтроки,
					ТекстАбонемента);
			КонецЕсли;
			УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, ТекстАбонемента, ПолеСтроки(СтрокаОплаты, "Абонемент",
				"Абонемент"), Отказ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

//В35: расшифровка платежа — правда о том, за кого и за что внесены деньги; шапка — её простой вид. Одна строка (или
//ни одной: документ заполнен программно по шапке) — строка повторяет шапку (ученик, предмет, абонемент, тариф,
//сумма документа), как ПКО типовых с одной строкой расшифровки. Несколько строк — сумма документа = итог строк,
//ученик, предмет, абонемент и тариф шапки пусты (их задают строки). «Внутренняя касса» — без расшифровки.
//Находка 9 аудита Codex 2.1 (30.09.2026): итог строк больше вместимости суммы документа (Число 10,2) — отказ до
//присваивания; прежде платформа молча урезала сумму документа до 99 999 999,99, а движения по строкам оставались
//полными (печать ПКО и журналы — одна сумма, касса — другая).
Процедура СинхронизироватьРасшифровку(Отказ)

	Если ВидОперации <> Перечисления.УЗ_ВидыОпераций.КассаУченики Тогда
		РасшифровкаПлатежа.Очистить();
		Возврат;
	КонецЕсли;
	Если РасшифровкаПлатежа.Количество() > 1 Тогда
		Итог = РасшифровкаПлатежа.Итог("Сумма");
		Предел = УЗ_Общий.ПредельнаяСуммаДенег();
		Если Итог > Предел Тогда
			УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, СтрШаблон(НСтр(
				"ru = 'Итог расшифровки платежа %1 больше наибольшей суммы документа %2 — разделите платёж на "
				+ "несколько приходов.'"), Формат(Итог, "ЧДЦ=2"), Формат(Предел, "ЧДЦ=2")), "РасшифровкаПлатежа",
				Отказ);
			Возврат;
		КонецЕсли;
		ФизЛицо = Справочники.УЗ_ФизЛица.ПустаяСсылка();
		ПредметОбучения = Справочники.УЗ_ПредметыОбучения.ПустаяСсылка();
		Абонемент = Справочники.УЗ_Абонемент.ПустаяСсылка();
		Тариф = Справочники.УЗ_Тарифы.ПустаяСсылка();
		СуммаДокумента = Итог;
		Возврат;
	КонецЕсли;
	Если РасшифровкаПлатежа.Количество() = 0 Тогда
		Если НЕ ЗначениеЗаполнено(ФизЛицо) И НЕ ЗначениеЗаполнено(СуммаДокумента) Тогда
			Возврат;
		КонецЕсли;
		РасшифровкаПлатежа.Добавить();
	КонецЕсли;
	СтрокаОплаты = РасшифровкаПлатежа[0];
	СтрокаОплаты.Ученик = ФизЛицо;
	СтрокаОплаты.ПредметОбучения = ПредметОбучения;
	СтрокаОплаты.Абонемент = Абонемент;
	СтрокаОплаты.Тариф = Тариф;
	СтрокаОплаты.Сумма = СуммаДокумента;

КонецПроцедуры

//Строка, на которую зачисляются бонусы: одна строка — она; несколько — первая строка владельца карты
//(Неопределено — владельца в расшифровке нет).
Функция СтрокаОплатыБонусами()

	Если РасшифровкаПлатежа.Количество() = 1 Тогда
		Возврат РасшифровкаПлатежа[0];
	КонецЕсли;
	Возврат РасшифровкаПлатежа.Найти(ДисконтнаяКарта.Владелец, "Ученик");

КонецФункции

//Поле сообщения об ошибке строки: одна строка показана в шапке — поле шапки, иначе колонка таблицы.
Функция ПолеСтроки(СтрокаОплаты, Колонка, ПолеШапки)

	Если РасшифровкаПлатежа.Количество() = 1 Тогда
		Возврат ПолеШапки;
	КонецЕсли;
	Возврат СтрШаблон("РасшифровкаПлатежа[%1].%2", Формат(СтрокаОплаты.НомерСтроки - 1, "ЧН=0; ЧГ=0"), Колонка);

КонецФункции

#КонецОбласти
