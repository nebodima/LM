
// Печать — точка входа подменю «Печать» (сигнатура БСП; вызывают форма печати хозяина
// и своя печать УЗ_Печать.СформироватьСвоейПечатью).
//
// Параметры:
//  МассивОбъектов – Массив – ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати – Структура – дополнительные настройки печати;
//  КоллекцияПечатныхФорм – ТаблицаЗначений – сформированные табличные документы (выходной параметр)
//  ОбъектыПечати – СписокЗначений – значение – ссылка на объект;
//                                            представление – имя области, в которой был выведен объект (выходной параметр);
//  ПараметрыВывода – Структура – дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УЗ_Печать.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПКО") Тогда
		УЗ_Печать.ВывестиВКоллекцию(КоллекцияПечатныхФорм, "ПКО", НСтр("ru = 'Приходный кассовый ордер'"),
			ПечатьПКО(МассивОбъектов, ОбъектыПечати));
		УЗ_Печать.УстановитьЗаголовок(ПараметрыВывода, НСтр("ru = 'Приходный кассовый ордер'"));
	КонецЕсли;

КонецПроцедуры

// Приходный кассовый ордер (унифицированная форма КО-1), каждый документ на своей странице.
// Реквизиты организации — из её карточки у хозяина (УЗ_Печать.СведенияОбОрганизации).
// Счета дебета и кредита не печатаем: план счетов — дело бухгалтерии покупателя, у УНФ его
// может не быть вовсе; графы остаются пустыми для ручного заполнения.
Функция ПечатьПКО(МассивОбъектов, ОбъектыПечати) Экспорт

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_УЗ_ПриходДенег_ПКО";
	Макет = Документы.УЗ_ПриходДенег.ПолучитьМакет("ПечатьПКО");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПКО.Ссылка КАК Ссылка,
	|	ПКО.АвторДокумента КАК АвторДокумента,
	|	ПКО.Дата КАК Дата,
	|	ПКО.ФизЛицо КАК Контрагент,
	|	ПКО.НазначениеПлатежа КАК НазначениеПлатежа,
	|	ПКО.Номер КАК Номер,
	|	ПКО.СуммаДокумента КАК СуммаДокумента,
	|	ПКО.СуммаБонусов КАК СуммаБонусов,
	|	ПКО.Родитель КАК Родитель,
	|	ПКО.Подразделение КАК Подразделение,
	|	ПКО.Организация КАК Организация
	|ИЗ
	|	Документ.УЗ_ПриходДенег КАК ПКО
	|ГДЕ
	|	ПКО.Ссылка В (&Ссылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПКО.Дата,
	|	ПКО.Ссылка";
	Запрос.УстановитьПараметр("Ссылка", МассивОбъектов);
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;

		//В24: приход только бонусами — денег в кассу не поступало, кассовый ордер на сумму бонусов не печатается
		//(прежде печатался КО-1 «на 300 рублей», хотя кассир денег не принимал)
		Если НЕ ЗначениеЗаполнено(Выборка.СуммаДокумента) Тогда
			НомерСтроки = ТабличныйДокумент.ВысотаТаблицы + 1;
			ТабличныйДокумент.Область(НомерСтроки, 2, НомерСтроки, 2).Текст = СтрШаблон(
				НСтр("ru = 'Приход денег № %1 от %2 оплачен только бонусами (%3) — денег в кассу не поступало, приходный кассовый ордер не печатается.'"),
				УЗ_ОбщийКлиентСервер.НомерНаПечать(Выборка.Номер), Формат(Выборка.Дата, "ДЛФ=D"),
				Формат(Выборка.СуммаБонусов, "ЧДЦ=2; ЧН=0,00"));
			УЗ_Печать.ЗадатьОбластьДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
			Продолжить;
		КонецЕсли;

		//область берём заново на каждый документ: параметры прошлого документа не переживут
		Шапка = Макет.ПолучитьОбласть("Шапка");
		Сумма = Выборка.СуммаДокумента;   //кассовый ордер — только на деньги; бонусы в кассу не поступают
		Организация = УЗ_Печать.СведенияОбОрганизации(Выборка.Организация);

		Шапка.Параметры.ПредставлениеОрганизации = Организация.Представление;
		Шапка.Параметры.ОрганизацияПоОКПО = Организация.ОКПО;
		Шапка.Параметры.ПредставлениеПодразделения = Строка(Выборка.Подразделение);
		Шапка.Параметры.НомерДокумента = УЗ_ОбщийКлиентСервер.НомерНаПечать(Выборка.Номер);
		Шапка.Параметры.ДатаДокумента = Формат(Выборка.Дата, "ДЛФ=D");
		Шапка.Параметры.ПринятоОт = Строка(?(ЗначениеЗаполнено(Выборка.Родитель), Выборка.Родитель, Выборка.Контрагент));
		Шапка.Параметры.Основание = Выборка.НазначениеПлатежа;
		Шапка.Параметры.Сумма = Формат(Сумма, "ЧЦ=15; ЧДЦ=2");
		Шапка.Параметры.СуммаРубКоп = Формат(Сумма, "ЧЦ=15; ЧДЦ=2");
		Шапка.Параметры.СуммаПрописью = ЧислоПрописью(Сумма, , НСтр("ru = 'рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2'"));
		Шапка.Параметры.ВТомЧисле = НСтр("ru = 'без налога (НДС)'");
		Шапка.Параметры.ФИОКассира = Строка(Выборка.АвторДокумента);
		//корреспондирующие счета и коды — пустые графы (см. комментарий к функции)
		Шапка.Параметры.КодДебета = "";
		Шапка.Параметры.СубСчет = "";
		Шапка.Параметры.КодПодразделения = "";
		Шапка.Параметры.КодАналитическогоУчета = "";
		Шапка.Параметры.КодЦелевогоНазначения = "";
		Шапка.Параметры.Приложение = "";
		Шапка.Параметры.ФИОГлавногоБухгалтера = "";

		ТабличныйДокумент.Вывести(Шапка);
		УЗ_Печать.ЗадатьОбластьДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);

	КонецЦикла;

	ТабличныйДокумент.ОтображатьСетку = Ложь;
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	Возврат ТабличныйДокумент;

КонецФункции

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Номер = Данные.Номер;
	Пока Лев(Номер, 1) = "0" Цикл
		Номер = Прав(Номер, СтрДлина(Номер) - 1);
	КонецЦикла;

	Представление = "ПКО (оплата+) " +Номер+ " от " +Формат(Данные.Дата,"ДФ=д.ММ.гггг")+ " " +Данные.Ссылка.ПредметОбучения;

КонецПроцедуры

//Остаток бонусов дисконтной карты на текущий момент — сумма по всем разрезам (клиент, организация);
//у карты без движений — 0 (не Неопределено: пустая карта не «пропускает» проверку списания).
Функция ОстатокБонусовКарты(ДисконтнаяКарта) Экспорт

	Если Не ЗначениеЗаполнено(ДисконтнаяКарта) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.СуммаБонусовОстаток), 0) КАК Остаток
	|ИЗ
	|	РегистрНакопления.УЗ_ДвижениеДисконтныхКарт.Остатки(, ДисконтнаяКарта = &ДисконтнаяКарта) КАК Остатки";
	Запрос.УстановитьПараметр("ДисконтнаяКарта", ДисконтнаяКарта);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Остаток, 0);

КонецФункции

//Срок действия дисконтной карты — одно правило для урока (начисление бонусов) и ПКО (списание):
//действует с ДатаНачалаДействия по ДатаОкончанияДействия включительно (пустая дата — без ограничения),
//с флагом «Не действует» — не действует. Возврат: "" — действует, иначе текст отказа.
Функция ПроверитьСрокДисконтнойКарты(ДисконтнаяКарта, Дата) Экспорт

	Если Не ЗначениеЗаполнено(ДисконтнаяКарта) Тогда
		Возврат "";
	КонецЕсли;

	Если ДисконтнаяКарта.НеДействует Тогда
		Возврат СтрШаблон("Дисконтная карта «%1» не действует (отмечено «Не действует»)", ДисконтнаяКарта);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДисконтнаяКарта.ДатаНачалаДействия) И Дата < НачалоДня(ДисконтнаяКарта.ДатаНачалаДействия) Тогда
		Возврат СтрШаблон("У дисконтной карты «%1» срок действия начинается %2",
			ДисконтнаяКарта, Формат(ДисконтнаяКарта.ДатаНачалаДействия, "ДЛФ=D"));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДисконтнаяКарта.ДатаОкончанияДействия) И Дата > КонецДня(ДисконтнаяКарта.ДатаОкончанияДействия) Тогда
		Возврат СтрШаблон("У дисконтной карты «%1» истек срок действия: действительна по %2",
			ДисконтнаяКарта, Формат(ДисконтнаяКарта.ДатаОкончанияДействия, "ДЛФ=D"));
	КонецЕсли;
	Возврат "";

КонецФункции

//В24 (решение владельца 28.09.2026): единые проверки дисконтной карты при списании бонусов — приход денег (оплата
//бонусами), списание остатков (вкладка «Бонусы»). Карта действует на дату (ПроверитьСрокДисконтнойКарты: срок и
//«Не действует»), сумма ≥ 0, остаток карты — под исключительной блокировкой (две оплаты не потратят одни бонусы) —
//не меньше суммы. Документ — ссылка списывающего документа: при перепроведении его прежнее списание в остатке
//возвращается на карту. Возврат: "" — можно, иначе текст отказа.
Функция ПроверитьСписаниеБонусов(ДисконтнаяКарта, Дата, Сумма, Документ = Неопределено) Экспорт

	Текст = ПроверитьНачислениеБонусов(ДисконтнаяКарта, Дата, Сумма);
	Если ЗначениеЗаполнено(Текст) Или Сумма = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Если ТранзакцияАктивна() Тогда
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.УЗ_ДвижениеДисконтныхКарт");
		ЭлементБлокировки.УстановитьЗначение("ДисконтнаяКарта", ДисконтнаяКарта);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
	КонецЕсли;
	//нет движений по карте — остаток 0 (прежде проверка пропускалась и бонусы списывались из ничего)
	Остаток = ОстатокБонусовКарты(ДисконтнаяКарта) + СписаноДокументом(ДисконтнаяКарта, Документ);
	Если Сумма > Остаток Тогда
		Возврат СтрШаблон(НСтр("ru = 'Недостаточно бонусов на карте «%1»: доступно %2, к списанию %3'"),
			ДисконтнаяКарта, Формат(Остаток, "ЧДЦ=2; ЧН=0"), Формат(Сумма, "ЧДЦ=2"));
	КонецЕсли;
	Возврат "";

КонецФункции

//В24: начисление бонусов (документ «Начисление бонусов», возврат бонусов списанием остатков; урок — у его
//владельца) — карта выбрана, действует на дату, сумма ≥ 0. Возврат: "" — можно, иначе текст отказа.
Функция ПроверитьНачислениеБонусов(ДисконтнаяКарта, Дата, Сумма) Экспорт

	Если НЕ ЗначениеЗаполнено(ДисконтнаяКарта) Тогда
		Возврат ?(Сумма = 0, "", НСтр("ru = 'Не выбрана дисконтная карта.'"));
	КонецЕсли;
	Если Сумма < 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'Бонусы по карте «%1» — отрицательная сумма %2: укажите сумму не меньше нуля.'"),
			ДисконтнаяКарта, Формат(Сумма, "ЧДЦ=2"));
	КонецЕсли;
	Возврат ПроверитьСрокДисконтнойКарты(ДисконтнаяКарта, Дата);

КонецФункции

//Сколько бонусов карты уже списали движения документа (при перепроведении они ещё в регистре).
Функция СписаноДокументом(ДисконтнаяКарта, Документ)

	Если Документ = Неопределено Или НЕ ЗначениеЗаполнено(Документ) Тогда
		Возврат 0;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА Свои.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|					ТОГДА Свои.СуммаБонусов
	|				ИНАЧЕ -Свои.СуммаБонусов
	|			КОНЕЦ), 0) КАК Сумма
	|ИЗ
	|	РегистрНакопления.УЗ_ДвижениеДисконтныхКарт КАК Свои
	|ГДЕ
	|	Свои.Регистратор = &Документ
	|	И Свои.ДисконтнаяКарта = &ДисконтнаяКарта
	|	И Свои.Активность";
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("ДисконтнаяКарта", ДисконтнаяКарта);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Сумма;

КонецФункции