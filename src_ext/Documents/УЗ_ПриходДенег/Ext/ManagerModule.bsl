#Область ПрограммныйИнтерфейс

// Печать — точка входа подменю «Печать» (сигнатура БСП; вызывают форма печати хозяина
// и своя печать УЗ_Печать.СформироватьСвоейПечатью).
//
// Параметры:
//  МассивОбъектов – Массив – ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати – Структура – дополнительные настройки печати;
//  КоллекцияПечатныхФорм – ТаблицаЗначений – сформированные табличные документы (выходной параметр)
//  ОбъектыПечати – СписокЗначений – значение – ссылка на объект;
//представление – имя области, в которой был выведен объект (выходной
//параметр);
//  ПараметрыВывода – Структура – дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УЗ_Печать.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПКО") Тогда
		УЗ_Печать.ВывестиВКоллекцию(КоллекцияПечатныхФорм, "ПКО", НСтр("ru = 'Приходный кассовый ордер'"),
			ПечатьПКО(МассивОбъектов, ОбъектыПечати));
		УЗ_Печать.УстановитьЗаголовок(ПараметрыВывода, НСтр("ru = 'Приходный кассовый ордер'"));
	КонецЕсли;

КонецПроцедуры

// Приходный кассовый ордер (унифицированная форма КО-1), каждый документ на своей странице.
// Реквизиты организации — из её карточки у хозяина (УЗ_Печать.СведенияОбОрганизации).
// Счета дебета и кредита не печатаем: план счетов — дело бухгалтерии покупателя, у УНФ его
// может не быть вовсе; графы остаются пустыми для ручного заполнения.
Функция ПечатьПКО(МассивОбъектов, ОбъектыПечати) Экспорт

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_УЗ_ПриходДенег_ПКО";
	Макет = Документы.УЗ_ПриходДенег.ПолучитьМакет("ПечатьПКО");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПКО.Ссылка КАК Ссылка,
	|	ПКО.АвторДокумента КАК АвторДокумента,
	|	ПКО.Дата КАК Дата,
	|	ПКО.ФизЛицо КАК Контрагент,
	|	ПКО.НазначениеПлатежа КАК НазначениеПлатежа,
	|	ПКО.Номер КАК Номер,
	|	ПКО.СуммаДокумента КАК СуммаДокумента,
	|	ПКО.СуммаБонусов КАК СуммаБонусов,
	|	ПКО.Плательщик КАК Плательщик,
	|	ПКО.Подразделение КАК Подразделение,
	|	ПКО.Организация КАК Организация
	|ИЗ
	|	Документ.УЗ_ПриходДенег КАК ПКО
	|ГДЕ
	|	ПКО.Ссылка В (&Ссылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПКО.Дата,
	|	ПКО.Ссылка";
	Запрос.УстановитьПараметр("Ссылка", МассивОбъектов);
	Выборка = Запрос.Выполнить().Выбрать();
	//В35: расшифровка платежа (за кого внесены деньги) — в «Принято от» и «Основание»
	Строки = Новый Запрос(
	"ВЫБРАТЬ
	|	Строки.Ссылка КАК Ссылка,
	|	Строки.Ученик КАК Ученик,
	|	Строки.ПредметОбучения КАК ПредметОбучения,
	|	Строки.Сумма КАК Сумма
	|ИЗ
	|	Документ.УЗ_ПриходДенег.РасшифровкаПлатежа КАК Строки
	|ГДЕ
	|	Строки.Ссылка В (&Ссылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Строки.НомерСтроки");
	Строки.УстановитьПараметр("Ссылка", МассивОбъектов);
	Расшифровки = Строки.Выполнить().Выгрузить();

	Пока Выборка.Следующий() Цикл

		Если ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;

		//В24: приход только бонусами — денег в кассу не поступало, кассовый ордер на сумму бонусов не печатается
		//(прежде печатался КО-1 «на 300 рублей», хотя кассир денег не принимал)
		Если НЕ ЗначениеЗаполнено(Выборка.СуммаДокумента) Тогда
			НомерСтроки = ТабличныйДокумент.ВысотаТаблицы + 1;
			ТабличныйДокумент.Область(НомерСтроки, 2, НомерСтроки, 2).Текст = СтрШаблон(
				НСтр("ru = 'Приход денег № %1 от %2 оплачен только бонусами (%3) — денег в кассу не поступало, "
					+ "приходный кассовый ордер не печатается.'"),
				УЗ_ОбщийКлиентСервер.НомерНаПечать(Выборка.Номер), Формат(Выборка.Дата, "ДЛФ=D"),
				Формат(Выборка.СуммаБонусов, "ЧДЦ=2; ЧН=0,00"));
			УЗ_Печать.ЗадатьОбластьДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);
			Продолжить;
		КонецЕсли;

		//область берём заново на каждый документ: параметры прошлого документа не переживут
		Шапка = Макет.ПолучитьОбласть("Шапка");
		Сумма = Выборка.СуммаДокумента;   //кассовый ордер — только на деньги; бонусы в кассу не поступают
		Организация = УЗ_Печать.СведенияОбОрганизации(Выборка.Организация);

		Шапка.Параметры.ПредставлениеОрганизации = Организация.Представление;
		Шапка.Параметры.ОрганизацияПоОКПО = Организация.ОКПО;
		Шапка.Параметры.ПредставлениеПодразделения = Строка(Выборка.Подразделение);
		Шапка.Параметры.НомерДокумента = УЗ_ОбщийКлиентСервер.НомерНаПечать(Выборка.Номер);
		Шапка.Параметры.ДатаДокумента = Формат(Выборка.Дата, "ДЛФ=D");
		Расшифровка = Расшифровки.НайтиСтроки(Новый Структура("Ссылка", Выборка.Ссылка));
		Шапка.Параметры.ПринятоОт = ПринятоОт(Выборка.Плательщик, Выборка.Контрагент, Расшифровка);
		Шапка.Параметры.Основание = ОснованиеПКО(Выборка.НазначениеПлатежа, Расшифровка);
		Шапка.Параметры.Сумма = Формат(Сумма, "ЧЦ=15; ЧДЦ=2");
		Шапка.Параметры.СуммаРубКоп = Формат(Сумма, "ЧЦ=15; ЧДЦ=2");
		Шапка.Параметры.СуммаПрописью =
			ЧислоПрописью(Сумма, , НСтр("ru = 'рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2'"));
		Шапка.Параметры.ВТомЧисле = НСтр("ru = 'без налога (НДС)'");
		Шапка.Параметры.ФИОКассира = Строка(Выборка.АвторДокумента);
		//корреспондирующие счета и коды — пустые графы (см. комментарий к функции)
		Шапка.Параметры.КодДебета = "";
		Шапка.Параметры.СубСчет = "";
		Шапка.Параметры.КодПодразделения = "";
		Шапка.Параметры.КодАналитическогоУчета = "";
		Шапка.Параметры.КодЦелевогоНазначения = "";
		Шапка.Параметры.Приложение = "";
		Шапка.Параметры.ФИОГлавногоБухгалтера = "";

		ТабличныйДокумент.Вывести(Шапка);
		УЗ_Печать.ЗадатьОбластьДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, Выборка.Ссылка);

	КонецЦикла;

	ТабличныйДокумент.ОтображатьСетку = Ложь;
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	Возврат ТабличныйДокумент;

КонецФункции

//В35: «Принято от» кассового ордера — плательщик; не указан — ученик (платит сам), несколько учеников без
//плательщика — их имена через запятую.
Функция ПринятоОт(Плательщик, Ученик, Расшифровка) Экспорт

	Если ЗначениеЗаполнено(Плательщик) Тогда
		Возврат Строка(Плательщик);
	КонецЕсли;
	Если Расшифровка.Количество() <= 1 Тогда
		Возврат Строка(?(Расшифровка.Количество() = 1, Расшифровка[0].Ученик, Ученик));
	КонецЕсли;
	Имена = Новый Массив;
	Для Каждого СтрокаОплаты Из Расшифровка Цикл
		Если Имена.Найти(Строка(СтрокаОплаты.Ученик)) = Неопределено Тогда
			Имена.Добавить(Строка(СтрокаОплаты.Ученик));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");

КонецФункции

//«Основание» кассового ордера: назначение платежа; при нескольких строках расшифровки (один платёж за нескольких
//учеников) — и расшифровка «за кого и за что»: без неё из ордера не понять, сколько внесено за каждого (справка на
//вычет — отдельная на каждого обучаемого).
Функция ОснованиеПКО(НазначениеПлатежа, Расшифровка) Экспорт

	Если Расшифровка.Количество() <= 1 Тогда
		Возврат НазначениеПлатежа;
	КонецЕсли;
	Текст = ТекстРасшифровки(Расшифровка);
	Возврат ?(ПустаяСтрока(НазначениеПлатежа), Текст, СокрП(НазначениеПлатежа) + "; " + Текст);

КонецФункции

//Расшифровка платежа строкой: «Оплата за обучение: Иванов Пётр (Математика) — 3 000,00; Иванова Мария — 2 500,00».
//  Строки — коллекция с колонками Ученик, ПредметОбучения, Сумма.
Функция ТекстРасшифровки(Строки) Экспорт

	Части = Новый Массив;
	Для Каждого СтрокаОплаты Из Строки Цикл
		Части.Добавить(СтрШаблон("%1%2 — %3", СтрокаОплаты.Ученик,
			?(ЗначениеЗаполнено(СтрокаОплаты.ПредметОбучения), " (" + СтрокаОплаты.ПредметОбучения + ")", ""),
			Формат(СтрокаОплаты.Сумма, "ЧДЦ=2; ЧН=0,00")));
	КонецЦикла;
	Возврат НСтр("ru = 'Оплата за обучение:'") + " " + СтрСоединить(Части, "; ");

КонецФункции

//«Заполнить по долгам» (В35): ученики, за которых платит Плательщик (Справочники.УЗ_ФизЛица.УченикиПлательщика), и
//их долги в организации по предметам на текущий момент (УЗ_Сервер.ДолгиДляОплаты — как «Заполнить сумму по
//задолженности»: долг предмета за вычетом аванса без предмета, и долг без предмета). Массив Структур (Ученик,
//ПредметОбучения, Сумма).
//  Исключить — заполняемый заново приход: долг — без его движений (находка 6 аудита Codex 2.1: проведённый приход
//  прежде считал долг уже уменьшенным своей же оплатой и, заменив её, оставлял долг — результат колебался).
Функция СтрокиПоДолгамПлательщика(Плательщик, Организация, Исключить = Неопределено) Экспорт

	Итог = Новый Массив;
	Если НЕ ЗначениеЗаполнено(Плательщик) Тогда
		Возврат Итог;
	КонецЕсли;
	Для Каждого Ученик Из Справочники.УЗ_ФизЛица.УченикиПлательщика(Плательщик) Цикл
		Для Каждого Долг Из УЗ_Сервер.ДолгиДляОплаты(Ученик, Организация, , Исключить) Цикл
			Итог.Добавить(Новый Структура("Ученик, ПредметОбучения, Сумма", Ученик, Долг.ПредметОбучения, Долг.Сумма));
		КонецЦикла;
	КонецЦикла;
	Возврат Итог;

КонецФункции

//Находка 2 третьего аудита Codex (28.09.2026): абонемент прихода согласован с документом — оплата ученика («Касса
//ученики»), ученик абонемента, организация и предмет абонемента (если заполнены у абонемента). Одна функция для
//проведения и формы (смена ученика, организации, предмета очищает несогласованный абонемент). Возврат: "" —
//согласован или абонемента нет, иначе текст отказа.
Функция ТекстНесогласованногоАбонемента(Абонемент, ФизЛицо, Организация, ПредметОбучения, ВидОперации) Экспорт

	Если НЕ ЗначениеЗаполнено(Абонемент) Тогда
		Возврат "";
	КонецЕсли;
	Реквизиты = Новый Структура("ФизЛицо, Организация, ПредметОбучения", Абонемент.ФизЛицо, Абонемент.Организация,
		Абонемент.ПредметОбучения);
	Если ВидОперации <> Перечисления.УЗ_ВидыОпераций.КассаУченики Тогда
		Возврат СтрШаблон(НСтр("ru = 'Абонемент %1 оплачивается только оплатой ученика (вид «Касса ученики»).'"),
			Абонемент);
	КонецЕсли;
	Если Реквизиты.ФизЛицо <> ФизЛицо Тогда
		Возврат СтрШаблон(НСтр("ru = 'Абонемент %1 — ученика %2, а оплата — от %3.'"), Абонемент, Реквизиты.ФизЛицо,
			?(ЗначениеЗаполнено(ФизЛицо), ФизЛицо, НСтр("ru = '(ученик не указан)'")));
	КонецЕсли;
	Если ЗначениеЗаполнено(Реквизиты.Организация) И Реквизиты.Организация <> Организация Тогда
		Возврат СтрШаблон(НСтр("ru = 'Абонемент %1 продан организацией «%2», а оплата — в «%3». Оплату абонемента "
			+ "принимает его организация.'"), Абонемент, Реквизиты.Организация,
			?(ЗначениеЗаполнено(Организация), Организация, НСтр("ru = '(организация не указана)'")));
	КонецЕсли;
	Если ЗначениеЗаполнено(Реквизиты.ПредметОбучения) И Реквизиты.ПредметОбучения <> ПредметОбучения Тогда
		Возврат СтрШаблон(НСтр("ru = 'Абонемент %1 — по предмету «%2», а оплата — %3.'"), Абонемент,
			Реквизиты.ПредметОбучения, ?(ЗначениеЗаполнено(ПредметОбучения), "по предмету «" + ПредметОбучения + "»",
			НСтр("ru = 'без предмета'")));
	КонецЕсли;
	Возврат "";

КонецФункции

//Остаток бонусов дисконтной карты на текущий момент (или на конец секунды НаДату) — сумма по всем разрезам
//(клиент, организация); у карты без движений — 0 (не Неопределено: пустая карта не «пропускает» проверку списания).
Функция ОстатокБонусовКарты(ДисконтнаяКарта, НаДату = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(ДисконтнаяКарта) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(Остатки.СуммаБонусовОстаток), 0) КАК Остаток
	|ИЗ
	|	РегистрНакопления.УЗ_ДвижениеДисконтныхКарт.Остатки(&Период, ДисконтнаяКарта = &ДисконтнаяКарта) КАК Остатки";
	Запрос.УстановитьПараметр("ДисконтнаяКарта", ДисконтнаяКарта);
	Запрос.УстановитьПараметр("Период", ?(НаДату = Неопределено, Неопределено,
		Новый Граница(НаДату, ВидГраницы.Включая)));
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Остаток, 0);

КонецФункции

//Срок действия дисконтной карты — одно правило для урока (начисление бонусов) и ПКО (списание):
//действует с ДатаНачалаДействия по ДатаОкончанияДействия включительно (пустая дата — без ограничения),
//с флагом «Не действует» — не действует. Возврат: "" — действует, иначе текст отказа.
Функция ПроверитьСрокДисконтнойКарты(ДисконтнаяКарта, Дата) Экспорт

	Если Не ЗначениеЗаполнено(ДисконтнаяКарта) Тогда
		Возврат "";
	КонецЕсли;

	Если ДисконтнаяКарта.НеДействует Тогда
		Возврат СтрШаблон("Дисконтная карта «%1» не действует (отмечено «Не действует»)", ДисконтнаяКарта);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДисконтнаяКарта.ДатаНачалаДействия)
		И Дата < НачалоДня(ДисконтнаяКарта.ДатаНачалаДействия) Тогда
		Возврат СтрШаблон("У дисконтной карты «%1» срок действия начинается %2",
			ДисконтнаяКарта, Формат(ДисконтнаяКарта.ДатаНачалаДействия, "ДЛФ=D"));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДисконтнаяКарта.ДатаОкончанияДействия)
		И Дата > КонецДня(ДисконтнаяКарта.ДатаОкончанияДействия) Тогда
		Возврат СтрШаблон("У дисконтной карты «%1» истек срок действия: действительна по %2",
			ДисконтнаяКарта, Формат(ДисконтнаяКарта.ДатаОкончанияДействия, "ДЛФ=D"));
	КонецЕсли;
	Возврат "";

КонецФункции

//В24 (решение владельца 28.09.2026): единые проверки дисконтной карты при списании бонусов — приход денег (оплата
//бонусами), списание остатков (вкладка «Бонусы»). Карта действует на дату (ПроверитьСрокДисконтнойКарты: срок и
//«Не действует»), сумма ≥ 0, остаток карты — под исключительной блокировкой (две оплаты не потратят одни бонусы) —
//не меньше суммы. Документ — ссылка списывающего документа: при перепроведении его прежнее списание в остатке
//возвращается на карту. Возврат: "" — можно, иначе текст отказа.
Функция ПроверитьСписаниеБонусов(ДисконтнаяКарта, Дата, Сумма, Документ = Неопределено) Экспорт

	Текст = ПроверитьНачислениеБонусов(ДисконтнаяКарта, Дата, Сумма);
	Если ЗначениеЗаполнено(Текст) Или Сумма = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Если ТранзакцияАктивна() Тогда
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.УЗ_ДвижениеДисконтныхКарт");
		ЭлементБлокировки.УстановитьЗначение("ДисконтнаяКарта", ДисконтнаяКарта);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
	КонецЕсли;
	//нет движений по карте — остаток 0 (прежде проверка пропускалась и бонусы списывались из ничего)
	//A5-02: задним числом нельзя потратить бонусы, начисленные позже даты документа, — меньший из остатков на дату
	//документа и текущего
	Остаток = Мин(ОстатокБонусовКарты(ДисконтнаяКарта), ОстатокБонусовКарты(ДисконтнаяКарта, Дата))
		+ СписаноДокументом(ДисконтнаяКарта, Документ);
	Если Сумма > Остаток Тогда
		Возврат СтрШаблон(НСтр("ru = 'Недостаточно бонусов на карте «%1»: доступно %2, к списанию %3'"),
			ДисконтнаяКарта, Формат(Остаток, "ЧДЦ=2; ЧН=0"), Формат(Сумма, "ЧДЦ=2"));
	КонецЕсли;
	Возврат "";

КонецФункции

//В24: начисление бонусов (документ «Начисление бонусов», возврат бонусов списанием остатков; урок — у его
//владельца) — карта выбрана, действует на дату, сумма ≥ 0. Возврат: "" — можно, иначе текст отказа.
Функция ПроверитьНачислениеБонусов(ДисконтнаяКарта, Дата, Сумма) Экспорт

	Если НЕ ЗначениеЗаполнено(ДисконтнаяКарта) Тогда
		Возврат ?(Сумма = 0, "", НСтр("ru = 'Не выбрана дисконтная карта.'"));
	КонецЕсли;
	Если Сумма < 0 Тогда
		Возврат СтрШаблон(НСтр("ru = 'Бонусы по карте «%1» — отрицательная сумма %2: укажите сумму не меньше нуля.'"),
			ДисконтнаяКарта, Формат(Сумма, "ЧДЦ=2"));
	КонецЕсли;
	Возврат ПроверитьСрокДисконтнойКарты(ДисконтнаяКарта, Дата);

КонецФункции

//Находка 3 третьего аудита Codex (28.09.2026), как контроль остатков в типовых: документ, начисляющий бонусы
//(«Начисление бонусов», урок, списание остатков с минусом), не забирает с карты уже потраченные бонусы. Уменьшение
//начисления, смена карты в строке, отмена проведения и пометка удаления проходят, только если остаток карты после
//документа не меньше нуля. Прежде проверялась лишь новая положительная сумма: начисление 100, оплата ими 100, затем
//начисление уменьшали до 10 или отменяли — карта −90 / −100, а оплата ученика на 100 оставалась.
//  НаборДвижений — новые движения УЗ_ДвижениеДисконтныхКарт (при отмене проведения — пустой набор); прежние движения
//документа — запомненные в ПередЗаписью (ПередЗаписьюДокументаБонусов) или из регистра. Проверяются только карты,
//которые документ уменьшает (карта, уже ушедшая в минус, не мешает начислять). Остаток — под
//исключительной блокировкой карты (одновременная оплата бонусами не проскочит между проверкой и записью).
Процедура ПроверитьИзъятиеБонусов(Документ, НаборДвижений, Отказ) Экспорт

	Если Документ.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Изменения = Новый ТаблицаЗначений;
	Изменения.Колонки.Добавить("ДисконтнаяКарта");
	Изменения.Колонки.Добавить("Новое", Новый ОписаниеТипов("Число"));
	Изменения.Колонки.Добавить("Прежнее", Новый ОписаниеТипов("Число"));
	Для Каждого Запись Из НаборДвижений Цикл
		Изменение = Изменения.Добавить();
		Изменение.ДисконтнаяКарта = Запись.ДисконтнаяКарта;
		Изменение.Новое =
			?(Запись.ВидДвижения = ВидДвиженияНакопления.Приход, Запись.СуммаБонусов, -Запись.СуммаБонусов);
	КонецЦикла;
	Прежние = Неопределено;
	Если НЕ Документ.ДополнительныеСвойства.Свойство("УЗ_ПрежниеДвиженияБонусов", Прежние) Тогда
		Прежние = ДвиженияБонусовДокумента(Документ.Ссылка);
	КонецЕсли;
	Для Каждого Прежнее Из Прежние Цикл
		Изменение = Изменения.Добавить();
		Изменение.ДисконтнаяКарта = Прежнее.ДисконтнаяКарта;
		Изменение.Прежнее = Прежнее.СуммаБонусов;
	КонецЦикла;
	Изменения.Свернуть("ДисконтнаяКарта", "Новое, Прежнее");

	Уменьшаемые = Новый Массив;
	Блокировка = Новый БлокировкаДанных;
	Для Каждого Изменение Из Изменения Цикл
		Если ЗначениеЗаполнено(Изменение.ДисконтнаяКарта) И Изменение.Новое < Изменение.Прежнее Тогда
			Уменьшаемые.Добавить(Изменение.ДисконтнаяКарта);
			ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.УЗ_ДвижениеДисконтныхКарт");
			ЭлементБлокировки.УстановитьЗначение("ДисконтнаяКарта", Изменение.ДисконтнаяКарта);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		КонецЕсли;
	КонецЦикла;
	Если Уменьшаемые.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если ТранзакцияАктивна() Тогда
		Блокировка.Заблокировать();
	КонецЕсли;
	ОстаткиБезДокумента = ОстаткиКартБезДокумента(Уменьшаемые, Документ.Ссылка);

	Для Каждого Карта Из Уменьшаемые Цикл
		Изменение = Изменения.Найти(Карта, "ДисконтнаяКарта");
		СтрокаОстатка = ОстаткиБезДокумента.Найти(Карта, "ДисконтнаяКарта");
		Остаток = ?(СтрокаОстатка = Неопределено, 0, СтрокаОстатка.Остаток) + Изменение.Новое;
		Если Остаток < 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(НСтр(
				"ru = 'Бонусы карты «%1» уже потрачены: после документа на карте останется %2. Уменьшить, перенести "
				+ "на другую карту или отменить начисление можно только в пределах неиспользованного остатка — сначала "
				+ "отмените или уменьшите оплату бонусами (приход денег).'"),
				Изменение.ДисконтнаяКарта, Формат(Остаток, "ЧДЦ=2; ЧН=0"));
			Сообщение.УстановитьДанные(Документ);
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

//Из ПередЗаписью документа, начисляющего бонусы: запомнить его прежние движения по картам (для
//ПроверитьИзъятиеБонусов при перепроведении — к ОбработкаПроведения платформа их уже удалит); при отмене проведения
//(и пометке удаления проведённого) — сразу проверить, что потраченные бонусы не изымаются.
Процедура ПередЗаписьюДокументаБонусов(Документ, РежимЗаписи, Отказ) Экспорт

	Если Документ.ОбменДанными.Загрузка Или Документ.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	Документ.ДополнительныеСвойства.Вставить("УЗ_ПрежниеДвиженияБонусов", ДвиженияБонусовДокумента(Документ.Ссылка));
	Если РежимЗаписи = РежимЗаписиДокумента.ОтменаПроведения Тогда
		ПроверитьИзъятиеБонусов(Документ, РегистрыНакопления.УЗ_ДвижениеДисконтныхКарт.СоздатьНаборЗаписей(), Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

//Предмет — полем представления, а не чтением прихода по ссылке (приход в списках регистров и отчётов — по запросу
//на каждую строку, как A1-02 у урока)
Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Поля.Добавить("Номер");
	Поля.Добавить("Дата");
	Поля.Добавить("ПредметОбучения");

КонецПроцедуры

//«Приход денег 53 от 01.09.2026 (Ударные)» — без служебного «ПКО (оплата+)»; несколько учеников (В35) — предмет
//в шапке пуст, представление без него
Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Номер = УЗ_ОбщийКлиентСервер.НомерБезНулей(Данные.Номер);
	Представление = "Приход денег " + Номер + " от " + Формат(Данные.Дата, "ДФ=дд.ММ.гггг");
	Если ЗначениеЗаполнено(Данные.ПредметОбучения) Тогда
		Представление = Представление + " (" + Данные.ПредметОбучения + ")";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//Остатки карт без движений документа (при перепроведении платформа их уже удалила, при отмене проведения они ещё в
//регистре): ТаблицаЗначений (ДисконтнаяКарта, Остаток) — одним запросом по всем картам.
Функция ОстаткиКартБезДокумента(Карты, Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Части.ДисконтнаяКарта КАК ДисконтнаяКарта,
	|	СУММА(Части.Сумма) КАК Остаток
	|ИЗ
	|	(ВЫБРАТЬ
	|		Остатки.ДисконтнаяКарта КАК ДисконтнаяКарта,
	|		Остатки.СуммаБонусовОстаток КАК Сумма
	|	ИЗ
	|		РегистрНакопления.УЗ_ДвижениеДисконтныхКарт.Остатки(, ДисконтнаяКарта В (&Карты)) КАК Остатки
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Свои.ДисконтнаяКарта,
	|		ВЫБОР
	|			КОГДА Свои.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА -Свои.СуммаБонусов
	|			ИНАЧЕ Свои.СуммаБонусов
	|		КОНЕЦ
	|	ИЗ
	|		РегистрНакопления.УЗ_ДвижениеДисконтныхКарт КАК Свои
	|	ГДЕ
	|		Свои.Регистратор = &Ссылка
	|		И Свои.Активность
	|		И Свои.ДисконтнаяКарта В (&Карты)) КАК Части
	|
	|СГРУППИРОВАТЬ ПО
	|	Части.ДисконтнаяКарта";
	Запрос.УстановитьПараметр("Карты", Карты);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

//Движения документа по картам, свёрнутые по карте (приход +, расход −): ТаблицаЗначений (ДисконтнаяКарта,
//СуммаБонусов).
Функция ДвиженияБонусовДокумента(Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Свои.ДисконтнаяКарта КАК ДисконтнаяКарта,
	|	СУММА(ВЫБОР
	|			КОГДА Свои.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА Свои.СуммаБонусов
	|			ИНАЧЕ -Свои.СуммаБонусов
	|		КОНЕЦ) КАК СуммаБонусов
	|ИЗ
	|	РегистрНакопления.УЗ_ДвижениеДисконтныхКарт КАК Свои
	|ГДЕ
	|	Свои.Регистратор = &Ссылка
	|	И Свои.Активность
	|
	|СГРУППИРОВАТЬ ПО
	|	Свои.ДисконтнаяКарта";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

//Сколько бонусов карты уже списали движения документа (при перепроведении они ещё в регистре).
Функция СписаноДокументом(ДисконтнаяКарта, Документ)

	Если Документ = Неопределено Или НЕ ЗначениеЗаполнено(Документ) Тогда
		Возврат 0;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|				КОГДА Свои.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|					ТОГДА Свои.СуммаБонусов
	|				ИНАЧЕ -Свои.СуммаБонусов
	|			КОНЕЦ), 0) КАК Сумма
	|ИЗ
	|	РегистрНакопления.УЗ_ДвижениеДисконтныхКарт КАК Свои
	|ГДЕ
	|	Свои.Регистратор = &Документ
	|	И Свои.ДисконтнаяКарта = &ДисконтнаяКарта
	|	И Свои.Активность";
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("ДисконтнаяКарта", ДисконтнаяКарта);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Сумма;

КонецФункции

#КонецОбласти
