#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Если ЭтоНовый() Тогда
		Статус = Перечисления.УЗ_СтатусыОплатыQR.Новый;
		Если Не ЗначениеЗаполнено(Организация) Тогда
			Организация = РегистрыСведений.УЗ_Настройки.Настройки().Организация;
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.УЗ_ФизЛица") Тогда
		ЗаполнитьПоФизЛицу(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.УЗ_Абонемент") Тогда
		ЗаполнитьПоАбонементу(ДанныеЗаполнения);
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") И ДанныеЗаполнения.Свойство("СтрокиОплаты") Тогда
		//из формы прихода денег (кнопка «QR для оплаты»): плательщик и расшифровка платежа
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеЗаполнения, "Организация, Плательщик, ДокументОснования");
		Расшифровка.Очистить();
		Для Каждого СтрокаОплаты Из ДанныеЗаполнения.СтрокиОплаты Цикл
			ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), СтрокаОплаты);
		КонецЦикла;
		СуммаДокумента = Расшифровка.Итог("Сумма");
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	УЗ_Общий.ЗаполнитьАвтораИОрганизацию(ЭтотОбъект);
	Если Не ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.УЗ_СтатусыОплатыQR.Новый;
	КонецЕсли;
	СуммаДокумента = Расшифровка.Итог("Сумма");
	Если ДополнительныеСвойства.Свойство(УЗ_ОплатыQR.КлючСлужебнойЗаписи()) Тогда
		Возврат;
	КонецЕсли;
	//выставленный QR — на сумму счёта: сумму, плательщика, организацию и расшифровку не меняем, пока QR ждёт оплаты
	//или счёт оплачен (оплата пойдёт в приход с этой расшифровкой)
	Если Не ЭтоНовый() И Не УЗ_ОплатыQR.МожноМенятьСчет(Ссылка.Статус) И ИзмененыДанныеОплаты() Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, СтрШаблон(НСтр(
			"ru = 'Счёт в статусе «%1»: сумму, плательщика и расшифровку менять нельзя. Отмените QR и выставьте "
			+ "заново.'"),
			Ссылка.Статус), "СуммаДокумента", Отказ);
		Возврат;
	КонецЕсли;
	Если ПометкаУдаления И Не ЭтоНовый() И Ссылка.Статус = Перечисления.УЗ_СтатусыОплатыQR.Ожидает Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр(
			"ru = 'QR ждёт оплаты: сначала отмените его («Отменить QR»), иначе оплата не станет приходом денег.'"),
			"Статус", Отказ);
		Возврат;
	КонецЕсли;
	Если Не ЭтоНовый() И Ссылка.Статус <> Статус Тогда
		//статус меняет только модуль оплат (банк, отмена)
		Статус = Ссылка.Статус;
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(Организация) Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Укажите организацию: деньги придут на её счёт.'"),
			"Организация", Отказ);
	КонецЕсли;
	Для Каждого СтрокаОплаты Из Расшифровка Цикл
		Если Не ЗначениеЗаполнено(СтрокаОплаты.Ученик) Тогда
			УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, СтрШаблон(НСтр("ru = 'Строка %1: укажите ученика.'"),
				СтрокаОплаты.НомерСтроки), "Расшифровка[" + Формат(СтрокаОплаты.НомерСтроки - 1, "ЧН=0; ЧГ=0")
					+ "].Ученик", Отказ);
		КонецЕсли;
		Если СтрокаОплаты.Сумма < 0 Тогда
			УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, СтрШаблон(НСтр(
				"ru = 'Строка %1: сумма не может быть отрицательной.'"),
				СтрокаОплаты.НомерСтроки), "Расшифровка[" + Формат(СтрокаОплаты.НомерСтроки - 1, "ЧН=0; ЧГ=0")
					+ "].Сумма", Отказ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

	Статус = Перечисления.УЗ_СтатусыОплатыQR.Новый;
	Провайдер = Перечисления.УЗ_ПровайдерыОплатыQR.ПустаяСсылка();
	ИдентификаторQR = "";
	СсылкаНаОплату = "";
	КартинкаQR = Новый ХранилищеЗначения(Неопределено);
	СрокДействия = '00010101';
	ДатаОплаты = '00010101';
	ИдОперацииБанка = "";
	ПриходДенег = Документы.УЗ_ПриходДенег.ПустаяСсылка();
	ТекстОшибки = "";
	АвторДокумента = Неопределено;
	ДокументОснования = Неопределено;
	//абонемент оплачивается один раз: в копии строки без абонементов (как копия прихода денег)
	Для Каждого СтрокаОплаты Из Расшифровка Цикл
		СтрокаОплаты.Абонемент = Справочники.УЗ_Абонемент.ПустаяСсылка();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

//Карточка человека: платит за других (он в их плательщиках) — он плательщик, строки — долги его учеников; иначе он
//ученик — плательщик основной (нет — платит сам), строки — его долги. Долгов нет — строка ученика без суммы.
Процедура ЗаполнитьПоФизЛицу(ФизЛицо)

	ДокументОснования = ФизЛицо;
	Ученики = Справочники.УЗ_ФизЛица.УченикиПлательщика(ФизЛицо);
	Если Ученики.Количество() > 0 Тогда
		Плательщик = ФизЛицо;
	Иначе
		Плательщик = Справочники.УЗ_ФизЛица.ОсновнойПлательщик(ФизЛицо);
		Ученики.Добавить(ФизЛицо);
	КонецЕсли;
	Расшифровка.Очистить();
	Для Каждого СтрокаДолга Из УЗ_ОплатыQR.СтрокиПоДолгам(Ученики, Организация) Цикл
		ЗаполнитьЗначенияСвойств(Расшифровка.Добавить(), СтрокаДолга);
	КонецЦикла;
	Если Расшифровка.Количество() = 0 Тогда
		Расшифровка.Добавить().Ученик = Ученики[0];
	КонецЕсли;
	СуммаДокумента = Расшифровка.Итог("Сумма");

КонецПроцедуры

//Абонемент: его ученик, предмет и организация, сумма — неоплаченный остаток цены (как приход на основании абонемента).
Процедура ЗаполнитьПоАбонементу(Абонемент)

	ДокументОснования = Абонемент;
	Реквизиты = Новый Структура("ФизЛицо, Организация, ПредметОбучения");
	ЗаполнитьЗначенияСвойств(Реквизиты, Абонемент);
	Если ЗначениеЗаполнено(Реквизиты.Организация) Тогда
		Организация = Реквизиты.Организация;
	КонецЕсли;
	Плательщик = Справочники.УЗ_ФизЛица.ОсновнойПлательщик(Реквизиты.ФизЛицо);
	Расшифровка.Очистить();
	СтрокаОплаты = Расшифровка.Добавить();
	СтрокаОплаты.Ученик = Реквизиты.ФизЛицо;
	СтрокаОплаты.ПредметОбучения = Реквизиты.ПредметОбучения;
	СтрокаОплаты.Абонемент = Абонемент;
	СтрокаОплаты.Сумма = Справочники.УЗ_Абонемент.ОплатаАбонемента(Абонемент).ОсталосьОплатить;
	СуммаДокумента = СтрокаОплаты.Сумма;

КонецПроцедуры

//Изменились ли данные, по которым банк выставил QR и по которым создастся приход.
Функция ИзмененыДанныеОплаты()

	Прежний = Ссылка;
	Если Прежний.Организация <> Организация Или Прежний.Плательщик <> Плательщик
		Или Прежний.СуммаДокумента <> СуммаДокумента Или Прежний.Расшифровка.Количество() <> Расшифровка.Количество(
			) Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого СтрокаОплаты Из Прежний.Расшифровка Цикл
		Новая = Расшифровка[СтрокаОплаты.НомерСтроки - 1];
		Если Новая.Ученик <> СтрокаОплаты.Ученик Или Новая.ПредметОбучения <> СтрокаОплаты.ПредметОбучения
			Или Новая.Абонемент <> СтрокаОплаты.Абонемент Или Новая.Тариф <> СтрокаОплаты.Тариф
			Или Новая.Сумма <> СтрокаОплаты.Сумма Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти
