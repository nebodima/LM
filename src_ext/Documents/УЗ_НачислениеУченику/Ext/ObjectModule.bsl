
//Начисление ученику (решение владельца В15, 28.09.2026): набор, материалы, взнос — «прочее начисление» покупателю,
//как в типовых. Уменьшает остаток денег ученика (регистр УЗ_СписанияСуммЗаУроки, Расход) по предмету в организации
//документа — так же, как проведённый урок «К оплате»: аванс ученика уменьшается, без аванса появляется долг.
//Деньги кассы не меняет (оплата — приход денег «Касса ученики»); % педагога — от оплаты ученика, начисление его
//не меняет. Педагог, группа, тариф, абонемент не заполняются: начисление — не урок.
Процедура ОбработкаПроведения(Отказ, Режим)

	//дата запрета проверяется подпиской УЗ_ДатаЗапретаПередЗаписью (модуль УЗ_ДатыЗапрета)

	//обязательное — и при программной записи (проверку заполнения платформа зовёт только из формы)
	Если НЕ ЗначениеЗаполнено(ФизЛицо) Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Укажите ученика.'"), "ФизЛицо", Отказ);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(СтатьяЗатрат) Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект,
			НСтр("ru = 'Укажите статью: за что начислено (набор, материалы, взнос).'"), "СтатьяЗатрат",
			Отказ);
	КонецЕсли;
	Если Сумма <= 0 Тогда
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Укажите сумму начисления больше нуля.'"), "Сумма",
			Отказ);
	КонецЕсли;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Движения.УЗ_СписанияСуммЗаУроки.Записывать = Истина;
	Движение = Движения.УЗ_СписанияСуммЗаУроки.Добавить();
	Движение.ВидДвижения     = ВидДвиженияНакопления.Расход;
	Движение.Период          = Дата;
	Движение.Клиент          = ФизЛицо;
	Движение.ПредметОбучения = ПредметОбучения;
	Движение.Организация     = Организация;
	Движение.Сумма           = Сумма;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	//ученик, статья и сумма — обязательные реквизиты (FillChecking); сумма — больше нуля: начисление на 0 ничего
	//не начисляет, а отрицательное было бы скрытым приходом денег ученику мимо кассы
	Если Сумма <= 0 Тогда
		Индекс = ПроверяемыеРеквизиты.Найти("Сумма");
		Если Индекс <> Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(Индекс);
		КонецЕсли;
		УЗ_Общий.СообщитьОбОшибкеОбъекта(ЭтотОбъект, НСтр("ru = 'Укажите сумму начисления больше нуля.'"), "Сумма",
			Отказ);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если ЭтоНовый() И НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = РегистрыСведений.УЗ_Настройки.Настройки().Организация;
	КонецЕсли;
	Если ТипЗнч(ДанныеЗаполнения) = Тип("СправочникСсылка.УЗ_ФизЛица") И ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		ФизЛицо = ДанныеЗаполнения;
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(АвторДокумента) Тогда
		АвторДокумента = УЗ_Среда.ТекущийПользователь();
	КонецЕсли;
	//созданный программно (обработки, внешнее соединение) без организации — организация по умолчанию, как у ПКО
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = РегистрыСведений.УЗ_Настройки.Настройки().Организация;
	КонецЕсли;

КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	АвторДокумента = Неопределено;
	Комментарий    = Неопределено;
КонецПроцедуры
