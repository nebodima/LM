
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//Убираем доступ к изменению периода у Менеджеров. Период видимости документов = 1 неделя (с вторника по вторник)
	УЗ_ОбновлениеДанных.ОбновитьДанныеПриНеобходимости();
	ПроблемаОбновления = УЗ_ОбновлениеДанных.ПроблемаОбновления();
	Если Не ПустаяСтрока(ПроблемаОбновления) Тогда
		УЗ_ОбщийКлиентСервер.СообщитьПользователю(ПроблемаОбновления);
	КонецЕсли;

	//состав журнала — то, что двигает кассу: перемещение денег между предметами ученика кассу не меняет — его нет
	//(«Не заполнено» — и Ложь у перемещения между кассами, и пусто у прочих документов журнала); списание остатков
	//в журнале есть — со своей суммой по кассе
	ЭлементОтбора = Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("МеждуПредметами");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	ЭлементОтбора.Использование = Истина;

	//скользящий запрет (Настройки → Даты запрета изменения) ограничивает и просмотр:
	//сотрудник видит документы только разрешённого периода, как «неделя менеджера» в LM
	ГраницаПросмотра = УЗ_ДатыЗапрета.ГраницаПросмотра();
	Если ЗначениеЗаполнено(ГраницаПросмотра) Тогда
		Элементы.Список.Период.ДатаНачала = ГраницаПросмотра;
		Элементы.Список.Период.ДатаОкончания = КонецМесяца(ТекущаяДатаСеанса());
		Элементы.СписокСостояниеПросмотра.Доступность = Ложь;
		Элементы.ФормаУстановитьИнтервал.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

