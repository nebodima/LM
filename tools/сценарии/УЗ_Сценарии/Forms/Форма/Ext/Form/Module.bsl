//Исполнитель сценариев пользователей «Учёта занятий» для штатного тест-менеджера платформы.
//
//Запуск (делает tools\сценарии\прогон_сценариев.py): тест-клиент /TESTCLIENT -TPort <порт> под пользователем роли,
//тест-менеджер /TESTMANAGER /Execute УЗ_Сценарии.epf /C <файл задания>. Задание — JSON: порт, файл итога, каталог
//снимков, переменные и сценарии; сценарий — список шагов-данных («д» — действие). Исполнитель общий: ни одного
//сценария в коде, только действия (открыть, раздел, форма, поле, флажок, кнопка, строка таблицы, проверить,
//сообщение, отказ, нет команды, ответ, закрыть). Итог пишется после КАЖДОГО шага — упадёт менеджер посреди прогона,
//итог покажет, докуда дошёл. На провале шага — текст ошибки, сообщения и надписи открытых окон клиента, запрос снимка
//окна (файл .запрос — снимок делает скрипт) и пропуск остальных шагов сценария.
//
//Условия запуска (выяснены в Путевых листах, память pl-ext-testmanager): сценарий — в модуле ФОРМЫ (/Execute
//открывает форму), код клиентский, в conf.cfg платформы DisableUnsafeActionProtection=.* (иначе модальный вопрос
//об открытии внешней обработки), формы открывает ОКНО клиента методом ВыполнитьКоманду.

&НаКлиенте
Перем Приложение;
&НаКлиенте
Перем ОкноОсновное;
&НаКлиенте
Перем Задание;
&НаКлиенте
Перем Итоги;
&НаКлиенте
Перем ТекФорма;
&НаКлиенте
Перем ТекСценарий;
&НаКлиенте
Перем НомерСнимка;
&НаКлиенте
Перем Зонд;
&НаКлиенте
Перем Заметка;   //подробности удачного шага (например, где и за сколько найден отказ)

#Область Прогон

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ПодключитьОбработчикОжидания("Прогон", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура Прогон()

	Итоги = Новый Массив;
	Зонд = Новый Массив;
	НомерСнимка = 0;
	Если ПрочитатьЗадание() И Соединиться() Тогда
		//после провала — стоп: закрыть изменённую форму нельзя (вопрос «Сохранить изменения?» — модальное окно
		//клиента, вызов Закрыть() ждёт ответа, а ответить некому — исполнитель висел до таймаута). Остальные
		//сценарии роли скрипт запускает в новом клиенте
		Для Каждого Сценарий Из Задание.сценарии Цикл
			Если Не ВыполнитьСценарий(Сценарий) Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Сохранить(Истина);
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

&НаКлиенте
Функция ПрочитатьЗадание()

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.ОткрытьФайл(ПараметрЗапуска, "UTF-8");
		Задание = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
	Исключение
		//итог — рядом с заданием (скрипт ждёт его там): задание_роль.json → итог_роль.json. Частая причина — ключ
		//шага не имя (пробел, запятая): JSON читается в Структуру
		Задание = Новый Структура("итог", СтрЗаменить(ПараметрЗапуска, "задание_", "итог_"));
		Записать("", 0, "задание", ПараметрЗапуска, "провал", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), 0);
		Возврат Ложь;
	КонецПопытки;
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция Соединиться()

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Приложение = Новый ТестируемоеПриложение("localhost", Задание.порт);
		//клиент поднимается несколько секунд: соединение повторяем, пока он не ответит
		Соединено = Ложь;
		Пока Не Соединено Цикл
			Попытка
				Приложение.УстановитьСоединение();
				Соединено = Истина;
			Исключение
				Если ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало > 60000 Тогда
					ВызватьИсключение;
				КонецЕсли;
				Пауза(300);
			КонецПопытки;
		КонецЦикла;
		ОкноОсновное = НайтиОсновноеОкно(60);
	Исключение
		Записать("", 0, "связь", "соединение с тест-клиентом", "провал",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Секунд(Начало));
		Возврат Ложь;
	КонецПопытки;
	Если ОкноОсновное = Неопределено Тогда
		Записать("", 0, "связь", "основное окно клиента", "провал", "клиент не открыл основное окно", Секунд(Начало));
		Возврат Ложь;
	КонецЕсли;
	Записать("", 0, "связь", "соединение с тест-клиентом", "успех", ЗаголовокОбъекта(ОкноОсновное), Секунд(Начало));
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ВыполнитьСценарий(Сценарий)

	ТекСценарий = Сценарий.имя;
	//окна, открытые при входе (стартовая страница «Информация», помощник первого запуска), и хвосты прошлого сценария
	ЗакрытьВсе();
	Провал = Ложь;
	Номер = 0;
	Для Каждого Шаг Из Сценарий.шаги Цикл
		Номер = Номер + 1;
		Что = ?(Шаг.Свойство("что"), Шаг.что, ОписаниеШага(Шаг));
		Если Провал Тогда
			Записать(ТекСценарий, Номер, Шаг.д, Что, "пропуск", "", 0);
			Продолжить;
		КонецЕсли;
		//шаг описан, но ещё не сделан: в итоге виден («не реализовано» с причиной), прогон не краснит
		Если Шаг.д = "не_реализовано" Тогда
			Записать(ТекСценарий, Номер, Шаг.д, Что, "не реализовано", ?(Шаг.Свойство("причина"), Шаг.причина, ""), 0);
			Продолжить;
		КонецЕсли;
		Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Ошибка = "";
		Заметка = "";
		Попытка
			Ошибка = ВыполнитьШаг(Шаг);
		Исключение
			Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Сек = Секунд(Начало);
		Если ПустаяСтрока(Ошибка) Тогда
			Записать(ТекСценарий, Номер, Шаг.д, Что, "успех", Заметка, Сек);
		Иначе
			Провал = Истина;
			Подробности = Ошибка + Символы.ПС + ОбстановкаКлиента();
			Снимок = ЗапроситьСнимок();
			Записать(ТекСценарий, Номер, Шаг.д, Что, "провал", Подробности, Сек, Снимок);
		КонецЕсли;
	КонецЦикла;
	//после удачного сценария — чистый клиент: следующий не должен краснеть на чужих открытых окнах (формы
	//записаны — вопроса о сохранении нет). «продолжать» — сценарий самопроверки: его формы не изменены, закрыть можно
	Продолжать = Сценарий.Свойство("продолжать") И Сценарий.продолжать;
	Если Не Провал Или Продолжать Тогда
		ЗакрытьВсе();
	КонецЕсли;
	Возврат Не Провал Или Продолжать;

КонецФункции

#КонецОбласти

#Область Шаги

&НаКлиенте
Функция ВыполнитьШаг(Шаг)

	Действие = Шаг.д;
	Если Действие = "открыть" Тогда
		ОкноОсновное.ВыполнитьКоманду(Подставить(Шаг.ссылка));
		Если Шаг.Свойство("форма") Тогда
			Возврат ЖдатьФорму(Шаг.форма, Таймаут(Шаг));
		КонецЕсли;
	ИначеЕсли Действие = "форма" Тогда
		Возврат ЖдатьФорму(Шаг.заголовок, Таймаут(Шаг));
	ИначеЕсли Действие = "поле" Тогда
		Возврат ЗаполнитьПоле(Шаг);
	ИначеЕсли Действие = "флажок" Тогда
		Возврат УстановитьФлажок(Шаг);
	ИначеЕсли Действие = "кнопка" Тогда
		Кнопка = НайтиЭлемент("ТестируемаяКнопкаФормы", Шаг, Таймаут(Шаг));
		Если Кнопка = Неопределено Тогда
			Возврат "нет кнопки " + ОписаниеЭлемента(Шаг) + " на форме «" + ЗаголовокОбъекта(ТекФорма) + "»";
		КонецЕсли;
		Кнопка.Нажать();
		Если Шаг.Свойство("форма") Тогда
			Возврат ЖдатьФорму(Шаг.форма, Таймаут(Шаг));
		КонецЕсли;
	ИначеЕсли Действие = "скрыт" Тогда
		//элемента нет на форме или он не виден (права на поля, видимость по ролям). Самопроверка: «скрыт» у видимого
		//поля обязан покраснеть
		Элемент = НайтиЭлемент(
			"ТестируемоеПолеФормы,ТестируемаяКнопкаФормы,ТестируемаяГруппаФормы,ТестируемаяТаблицаФормы", Шаг, 0);
		Если Элемент <> Неопределено И Элемент.ТекущаяВидимость() Тогда
			Возврат "элемент " + ОписаниеЭлемента(Шаг) + " виден на форме «" + ЗаголовокОбъекта(ТекФорма) + "»";
		КонецЕсли;
	ИначеЕсли Действие = "страница" Тогда
		Страница = НайтиЭлемент("ТестируемаяГруппаФормы", Шаг, Таймаут(Шаг));
		Если Страница = Неопределено Тогда
			Возврат "нет страницы " + ОписаниеЭлемента(Шаг);
		КонецЕсли;
		Страница.Активизировать();
	ИначеЕсли Действие = "строка" Тогда
		Возврат ЗаполнитьСтроку(Шаг);
	ИначеЕсли Действие = "выбрать_строку" Тогда
		Возврат ВыбратьСтроку(Шаг);
	ИначеЕсли Действие = "проверить" Тогда
		Возврат ПроверитьЗначение(Шаг);
	ИначеЕсли Действие = "сообщение" Тогда
		Возврат ЖдатьСообщение(Шаг);
	ИначеЕсли Действие = "без_ошибок" Тогда
		//ни сообщений пользователю, ни окна ошибки: «непредвиденная ситуация» платформа показывает отдельным окном,
		//а не сообщением (так пропускалась ошибка формы урока у менеджера, 28.09.2026)
		Текст = СообщенияКлиента();
		Если Не ПустаяСтрока(Текст) Тогда
			Возврат "сообщения: " + Текст;
		КонецЕсли;
		Текст = ОкнаОшибок();
		Если Не ПустаяСтрока(Текст) Тогда
			Возврат "окно ошибки: " + Текст;
		КонецЕсли;
	ИначеЕсли Действие = "отказ" Тогда
		Возврат ЖдатьОтказ(Шаг);
	ИначеЕсли Действие = "ответ" Тогда
		Возврат Ответить(Шаг);
	ИначеЕсли Действие = "закрыть" Тогда
		ЗакрытьВсе();
	ИначеЕсли Действие = "ждать" Тогда
		Пауза(Шаг.сек * 1000);
	ИначеЕсли Действие = "замер" Тогда
		Части = Новый Массив;
		Н = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Окна = Приложение.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения"));
		Части.Добавить("окна " + Секунд(Н));
		Н = ТекущаяУниверсальнаяДатаВМиллисекундах();
		СообщенияКлиента();
		Части.Добавить("сообщения " + Секунд(Н));
		Н = ТекущаяУниверсальнаяДатаВМиллисекундах();
		НадписиОкон();
		Части.Добавить("надписи " + Секунд(Н));
		Н = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Попытка
			ОкноОсновное.НайтиОбъект(Тип("ТестируемаяФорма"), "нет такой формы");
		Исключение
		КонецПопытки;
		Части.Добавить("НайтиОбъект(нет) " + Секунд(Н));
		Н = ТекущаяУниверсальнаяДатаВМиллисекундах();
		Для Каждого ОкноКлиента Из Окна Цикл
			Попытка
				ОкноКлиента.ПолучитьТекстСообщенийПользователю();
			Исключение
			КонецПопытки;
			Части.Добавить("  текст сообщений окна «" + ЗаголовокОбъекта(ОкноКлиента) + "» " + Секунд(Н));
			Н = ТекущаяУниверсальнаяДатаВМиллисекундах();
		КонецЦикла;
		Заметка = СтрСоединить(Части, "; ");
	ИначеЕсли Действие = "зонд" Тогда
		ЗаписатьЗонд(?(Шаг.Свойство("метка"), Шаг.метка, ""));
	Иначе
		Возврат "неизвестное действие «" + Действие + "»";
	КонецЕсли;
	Возврат "";

КонецФункции

&НаКлиенте
Функция ЗаполнитьПоле(Шаг)

	Поле = НайтиЭлемент("ТестируемоеПолеФормы", Шаг, Таймаут(Шаг));
	Если Поле = Неопределено Тогда
		Возврат "нет поля " + ОписаниеЭлемента(Шаг) + " на форме «" + ЗаголовокОбъекта(ТекФорма) + "»";
	КонецЕсли;
	ВвестиВПоле(Поле, Подставить(Строка(Шаг.значение)), Шаг.Свойство("выбор") И Шаг.выбор);
	Возврат "";

КонецФункции

&НаКлиенте
Процедура ВвестиВПоле(Поле, Значение, ИзСписка)

	Поле.Активизировать();
	Поле.ВвестиТекст(Значение);
	Если ИзСписка Тогда
		//ссылочное поле: введённый текст подбирает значение по вводу; «выбор» — выбрать из выпадающего списка
		//подбора (ВыполнитьВыборИзСпискаВыбора — только у поля со списком выбора: иначе «Неподходящий тип элемента»)
		Поле.ВыполнитьВыборИзСпискаВыбора(Значение);
	КонецЕсли;
	//значение уходит в реквизит при выходе из поля
	Попытка
		ТекФорма.ПерейтиКСледующемуЭлементу();
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Функция УстановитьФлажок(Шаг)

	Поле = НайтиЭлемент("ТестируемоеПолеФормы", Шаг, Таймаут(Шаг));
	Если Поле = Неопределено Тогда
		Возврат "нет флажка " + ОписаниеЭлемента(Шаг);
	КонецЕсли;
	Поле.Активизировать();
	Если Шаг.значение Тогда
		Поле.УстановитьОтметку();
	Иначе
		Поле.СнятьОтметку();
	КонецЕсли;
	Возврат "";

КонецФункции

//Строка таблицы формы: «новая» (по умолчанию) — добавить, «первая» — изменить первую; «поля» — имя элемента колонки
//(как в форме) → значение; значение, начинающееся с «>», выбирается из списка подбора.
&НаКлиенте
Функция ЗаполнитьСтроку(Шаг)

	Таблица = НайтиЭлемент("ТестируемаяТаблицаФормы", Новый Структура("имя", Шаг.таблица), Таймаут(Шаг));
	Если Таблица = Неопределено Тогда
		Возврат "нет таблицы «" + Шаг.таблица + "»";
	КонецЕсли;
	Таблица.Активизировать();
	Если Шаг.Свойство("строка") И Шаг.строка = "первая" Тогда
		Таблица.ПерейтиКПервойСтроке();
		Таблица.ИзменитьСтроку();
	Иначе
		Таблица.ДобавитьСтроку();
	КонецЕсли;
	Для Каждого КлючЗначение Из Шаг.поля Цикл
		Поле = Таблица.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , КлючЗначение.Ключ);
		Если Поле = Неопределено Тогда
			Возврат "нет колонки «" + КлючЗначение.Ключ + "» в таблице «" + Шаг.таблица + "»";
		КонецЕсли;
		Значение = Подставить(Строка(КлючЗначение.Значение));
		ИзСписка = Лев(Значение, 1) = ">";
		Если ИзСписка Тогда
			Значение = Сред(Значение, 2);
		КонецЕсли;
		Поле.Активизировать();
		Поле.ВвестиТекст(Значение);
		Если ИзСписка Тогда
			Поле.ВыполнитьВыборИзСпискаВыбора(Значение);
		КонецЕсли;
	КонецЦикла;
	Таблица.ЗакончитьРедактированиеСтроки();
	Возврат "";

КонецФункции

//Перейти к строке таблицы по значениям колонок (заголовок видимой колонки → представление, точно как на экране) и,
//если «открыть», открыть её. Ищет платформа (ПерейтиКСтроке, от первой строки вниз). Прочитать значение ячейки
//нельзя: ПолучитьПредставлениеДанных у поля колонки — «Неподходящее состояние элемента управления»; колонка не на
//экране — «Структура описания строки не совпадает со структурой данных».
&НаКлиенте
Функция ВыбратьСтроку(Шаг)

	Таблица = НайтиЭлемент("ТестируемаяТаблицаФормы", Новый Структура("имя", Шаг.таблица), Таймаут(Шаг));
	Если Таблица = Неопределено Тогда
		Возврат "нет таблицы «" + Шаг.таблица + "»";
	КонецЕсли;
	Таблица.Активизировать();
	//динамический список дочитывает строки после открытия формы: до того «Неподходящее состояние элемента управления»
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока Истина Цикл
		Попытка
			Таблица.ПерейтиКПервойСтроке();
			Прервать;
		Исключение
			Если Секунд(Начало) >= Таймаут(Шаг) Тогда
				Возврат "в таблице «" + Шаг.таблица + "» нет строк: "
					+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецЕсли;
		КонецПопытки;
		Пауза(200);
	КонецЦикла;
	Если Шаг.Свойство("колонки") Тогда
		Отбор = Новый Соответствие;
		Для Каждого КлючЗначение Из Шаг.колонки Цикл
			Отбор.Вставить(КлючЗначение.Ключ, Подставить(Строка(КлючЗначение.Значение)));
		КонецЦикла;
		Если Не Таблица.ПерейтиКСтроке(Отбор) Тогда
			Возврат "нет строки " + ОписаниеОтбора(Отбор) + " в таблице «" + Шаг.таблица + "»";
		КонецЕсли;
	КонецЕсли;
	Если Шаг.Свойство("открыть") И Шаг.открыть Тогда
		Таблица.Выбрать();
	КонецЕсли;
	Если Шаг.Свойство("форма") Тогда
		Возврат ЖдатьФорму(Шаг.форма, Таймаут(Шаг));
	КонецЕсли;
	Возврат "";

КонецФункции

&НаКлиенте
Функция ОписаниеОтбора(Отбор)

	Части = Новый Массив;
	Для Каждого КлючЗначение Из Отбор Цикл
		Части.Добавить(КлючЗначение.Ключ + " = «" + КлючЗначение.Значение + "»");
	КонецЦикла;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

&НаКлиенте
Функция ПроверитьЗначение(Шаг)

	//поле или декорация: оба типа в одном ожидании (прежде декорацию искали после 10 с ожидания поля)
	Элемент = НайтиЭлемент("ТестируемоеПолеФормы,ТестируемаяДекорацияФормы", Шаг, Таймаут(Шаг));
	Если Элемент = Неопределено Тогда
		Возврат "нет элемента " + ОписаниеЭлемента(Шаг) + " на форме «" + ЗаголовокОбъекта(ТекФорма) + "»";
	КонецЕсли;
	//у декорации данных нет — её текст в заголовке
	Если ТипЗнч(Элемент) = Тип("ТестируемаяДекорацияФормы") Тогда
		Факт = ЗаголовокОбъекта(Элемент);
	Иначе
		Факт = СокрЛП(Элемент.ПолучитьПредставлениеДанных());
	КонецЕсли;
	Если Шаг.Свойство("равно") Тогда
		Ожидаем = Подставить(Строка(Шаг.равно));
		Если ЧислоИзТекста(Факт) <> Неопределено И ЧислоИзТекста(Ожидаем) <> Неопределено Тогда
			Совпало = ЧислоИзТекста(Факт) = ЧислоИзТекста(Ожидаем);
		Иначе
			Совпало = Факт = Ожидаем;
		КонецЕсли;
		Если Не Совпало Тогда
			Возврат СтрШаблон("%1: «%2», ожидалось «%3»", ОписаниеЭлемента(Шаг), Факт, Ожидаем);
		КонецЕсли;
	ИначеЕсли Шаг.Свойство("содержит") Тогда
		Если СтрНайти(НРег(Факт), НРег(Подставить(Шаг.содержит))) = 0 Тогда
			Возврат СтрШаблон("%1: «%2», нет «%3»", ОписаниеЭлемента(Шаг), Факт, Шаг.содержит);
		КонецЕсли;
	ИначеЕсли Шаг.Свойство("не_пусто") Тогда
		Если ПустаяСтрока(Факт) Или ЧислоИзТекста(Факт) = 0 Тогда
			Возврат СтрШаблон("%1 пусто («%2»)", ОписаниеЭлемента(Шаг), Факт);
		КонецЕсли;
	КонецЕсли;
	Возврат "";

КонецФункции

&НаКлиенте
Функция ЧислоИзТекста(Текст)

	Чистый = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, Символы.НПП, ""), " ", ""), ",", ".");
	Если ПустаяСтрока(Чистый) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Число(Чистый);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

//Сообщение пользователю (окно сообщений формы) или окно-предупреждение с этим текстом.
&НаКлиенте
Функция ЖдатьСообщение(Шаг)

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Искомое = НРег(Подставить(Шаг.содержит));
	Пока Истина Цикл
		Текст = СообщенияКлиента() + Символы.ПС + НадписиОкон();
		Если СтрНайти(НРег(Текст), Искомое) > 0 Тогда
			Возврат "";
		КонецЕсли;
		Если Секунд(Начало) >= Таймаут(Шаг) Тогда
			Возврат "нет сообщения «" + Шаг.содержит + "»";
		КонецЕсли;
		Пауза(200);
	КонецЦикла;

КонецФункции

//Ожидаемый отказ: навигационная ссылка на недоступное (чужой урок, касса руководителя) даёт ошибку платформы —
//исключение команды, окно ошибки или сообщение — с текстом отказа прав. «содержит» — свой текст отказа; по
//умолчанию «Недостаточно прав» или «Нарушение прав доступа». Просто «прав» не годится: самопроверка поймала
//ложный зелёный — «прав» есть в «Справка» и «Провести» любой открывшейся формы.
&НаКлиенте
Функция ЖдатьОтказ(Шаг)

	Искомые = Новый Массив;
	Если Шаг.Свойство("содержит") Тогда
		Искомые.Добавить(НРег(Шаг.содержит));
	Иначе
		Искомые.Добавить("недостаточно прав");
		Искомые.Добавить("нарушение прав доступа");
	КонецЕсли;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		ОкноОсновное.ВыполнитьКоманду(Подставить(Шаг.ссылка));
	Исключение
		Текст = НРег(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Для Каждого Искомое Из Искомые Цикл
			Если СтрНайти(Текст, Искомое) > 0 Тогда
				Заметка = СтрШаблон("отказ — исключением команды за %1 с: %2", Секунд(Начало), Текст);
				Возврат "";
			КонецЕсли;
		КонецЦикла;
	КонецПопытки;
	Команда = Секунд(Начало);
	Кругов = 0;
	Пока Истина Цикл
		Кругов = Кругов + 1;
		Текст = НРег(СообщенияКлиента() + Символы.ПС + ТекстыОкон());
		Для Каждого Искомое Из Искомые Цикл
			Если СтрНайти(Текст, Искомое) > 0 Тогда
				Заметка = СтрШаблон("отказ на экране: команда %1 с, найден за %2 с (кругов %3): %4", Команда,
					Секунд(Начало),
					Кругов, Лев(Текст, 200));
				ЗакрытьВсе();
				Заметка = Заметка + СтрШаблон(", с закрытием %1 с", Секунд(Начало));
				Возврат "";
			КонецЕсли;
		КонецЦикла;
		Если Секунд(Начало) >= Таймаут(Шаг) Тогда
			Возврат "отказа («" + СтрСоединить(Искомые, "» или «") + "») нет — открылось: " + Лев(НадписиОкон(), 300);
		КонецЕсли;
		Пауза(200);
	КонецЦикла;

КонецФункции

//Ответ на вопрос/предупреждение: кнопка с заголовком в любом открытом окне (модальный вопрос — отдельное окно).
&НаКлиенте
Функция Ответить(Шаг)

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока Истина Цикл
		Для Каждого Форма Из Приложение.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
			Для Каждого Кнопка Из Форма.НайтиОбъекты(Тип("ТестируемаяКнопкаФормы")) Цикл
				Если СовпадаетЗаголовок(ЗаголовокОбъекта(Кнопка), Шаг.кнопка) Тогда
					Кнопка.Нажать();
					Возврат "";
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Если Секунд(Начало) >= Таймаут(Шаг) Тогда
			Возврат "нет окна с кнопкой «" + Шаг.кнопка + "»";
		КонецЕсли;
		Пауза(200);
	КонецЦикла;

КонецФункции

#КонецОбласти

#Область Формы

//Форма с заголовком, содержащим искомый текст, становится текущей: в ней шаги ищут поля и кнопки.
&НаКлиенте
Функция ЖдатьФорму(ЗаголовокИскомый, Сек)

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока Истина Цикл
		Форма = НайтиФорму(Подставить(ЗаголовокИскомый));
		Если Форма <> Неопределено Тогда
			ТекФорма = Форма;
			Попытка
				ТекФорма.Активизировать();
			Исключение
			КонецПопытки;
			Возврат "";
		КонецЕсли;
		Если Секунд(Начало) >= Сек Тогда
			Возврат "форма «" + ЗаголовокИскомый + "» не открылась за " + Сек + " с";
		КонецЕсли;
		Пауза(200);
	КонецЦикла;

КонецФункции

&НаКлиенте
Функция НайтиФорму(ЗаголовокИскомый)

	Найдена = Неопределено;
	Для Каждого Форма Из Приложение.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
		Если ПодходитЗаголовок(ЗаголовокОбъекта(Форма), ЗаголовокИскомый) Тогда
			Найдена = Форма;   //последняя из подходящих — самая новая
		КонецЕсли;
	КонецЦикла;
	Возврат Найдена;

КонецФункции

//Элемент текущей формы по имени (как в конфигураторе) или заголовку (как видит человек). Ищет сама платформа
//(НайтиОбъект с именем/заголовком): перебор НайтиОбъекты с чтением свойств — сотни обращений к клиенту, секунды.
&НаКлиенте
Функция НайтиЭлемент(ИмяТипа, Шаг, Сек)

	Если ТекФорма = Неопределено Тогда
		ВызватьИсключение "нет текущей формы: перед шагом нужен шаг «форма» или «открыть» с формой";
	КонецЕсли;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока Истина Цикл
		//ИмяТипа — один тип или несколько через запятую (поле или декорация)
		Для Каждого ОдинТип Из СтрРазделить(ИмяТипа, ",") Цикл
			Элемент = Неопределено;
			Попытка
				Если Шаг.Свойство("имя") Тогда
					Элемент = ТекФорма.НайтиОбъект(Тип(ОдинТип), , Шаг.имя);
				ИначеЕсли Шаг.Свойство("заголовок") Тогда
					Элемент = ТекФорма.НайтиОбъект(Тип(ОдинТип), Подставить(Шаг.заголовок));
				КонецЕсли;
			Исключение
				Элемент = Неопределено;
			КонецПопытки;
			Если Элемент <> Неопределено Тогда
				Возврат Элемент;
			КонецЕсли;
		КонецЦикла;
		Если Секунд(Начало) >= Сек Тогда
			Возврат Неопределено;
		КонецЕсли;
		Пауза(200);
	КонецЦикла;

КонецФункции

//Закрыть открытые формы (кроме основного окна и рабочего стола) — клиент чистый к следующему сценарию. Каждое
//обращение — в Попытке: форма исчезает между НайтиОбъекты и обращением к ней («Объект не может быть найден»),
//и необработанная ошибка в обработчике ожидания роняла исполнитель без итога.
&НаКлиенте
Процедура ЗакрытьВсе()

	Для Круг = 1 По 3 Цикл
		Закрыто = 0;
		Попытка
			Окна = Приложение.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения"));
		Исключение
			Окна = Новый Массив;
		КонецПопытки;
		Для Каждого ОкноКлиента Из Окна Цикл
			Попытка
				Если Не ОкноКлиента.Основное Тогда
					ОкноКлиента.Закрыть();
					Закрыто = Закрыто + 1;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЦикла;
		//закрытие изменённой формы спрашивает «Сохранить изменения?» (окно «1С:Предприятие») — не сохраняем.
		//Кнопки — перебором НайтиОбъекты: НайтиОбъект ненайденного ждёт ~1 с на каждой форме
		Попытка
			Формы = Приложение.НайтиОбъекты(Тип("ТестируемаяФорма"));
		Исключение
			Формы = Новый Массив;
		КонецПопытки;
		Для Каждого Форма Из Формы Цикл
			Попытка
				Если ЗаголовокОбъекта(Форма) = "1С:Предприятие" Тогда
					Для Каждого Кнопка Из Форма.НайтиОбъекты(Тип("ТестируемаяКнопкаФормы")) Цикл
						Если ЗаголовокОбъекта(Кнопка) = "Нет" Тогда
							Кнопка.Нажать();
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЦикла;
		Если Закрыто = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ТекФорма = Неопределено;

КонецПроцедуры

&НаКлиенте
Функция НайтиОсновноеОкно(Сек)

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Пока Истина Цикл
		Для Каждого ОкноКлиента Из Приложение.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения")) Цикл
			Попытка
				Если ОкноКлиента.Основное Тогда
					Возврат ОкноКлиента;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЦикла;
		Если Секунд(Начало) >= Сек Тогда
			Возврат Неопределено;
		КонецЕсли;
		Пауза(300);
	КонецЦикла;

КонецФункции

#КонецОбласти

#Область Диагностика

//Что видно на экране клиента: сообщения пользователю и надписи всех окон — без них провал говорит «что-то не так».
&НаКлиенте
Функция ОбстановкаКлиента()

	Части = Новый Массив;
	Попытка
		Сообщения = СообщенияКлиента();
		Если Не ПустаяСтрока(Сообщения) Тогда
			Части.Добавить("сообщения: " + Сообщения);
		КонецЕсли;
		Части.Добавить("окна: " + НадписиОкон());
	Исключение
		Части.Добавить("обстановку клиента прочитать не удалось: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Лев(СтрСоединить(Части, Символы.ПС), 3000);

КонецФункции

&НаКлиенте
Функция СообщенияКлиента()

	Куски = Новый Массив;
	Для Каждого ОкноКлиента Из Приложение.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения")) Цикл
		Попытка
			Текст = СокрЛП(ОкноКлиента.ПолучитьТекстСообщенийПользователю());
		Исключение
			Текст = "";
		КонецПопытки;
		Если Не ПустаяСтрока(Текст) И Куски.Найти(Текст) = Неопределено Тогда
			Куски.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Куски, " | ");

КонецФункции

//Заголовки окон и форм, надписи и кнопки неосновных окон (окно ошибки, вопрос, предупреждение).
&НаКлиенте
Функция НадписиОкон()

	Куски = Новый Массив;
	Для Каждого ОкноКлиента Из Приложение.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения")) Цикл
		Попытка
			НадписиОкна(ОкноКлиента, Куски);
		Исключение
			Куски.Добавить("(окно закрылось при чтении)");
		КонецПопытки;
	КонецЦикла;
	Возврат СтрСоединить(Куски, " | ");

КонецФункции

&НаКлиенте
Процедура НадписиОкна(ОкноКлиента, Куски)

		Основное = Ложь;
		Попытка
			Основное = ОкноКлиента.Основное;
		Исключение
		КонецПопытки;
		Куски.Добавить("[" + ?(Основное, "основное", "окно") + " «" + ЗаголовокОбъекта(ОкноКлиента) + "»]");
		Для Каждого Форма Из ОкноКлиента.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
			Куски.Добавить("форма «" + ЗаголовокОбъекта(Форма) + "»");
			Если Основное Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого ИмяТипа Из СтрРазделить("ТестируемаяДекорацияФормы,ТестируемоеПолеФормы,ТестируемаяКнопкаФормы",
				",") Цикл
				Для Каждого Элемент Из Форма.НайтиОбъекты(Тип(ИмяТипа)) Цикл
					Текст = ЗаголовокОбъекта(Элемент);
					Если ИмяТипа = "ТестируемоеПолеФормы" Тогда
						Попытка
							Текст = Текст + ": " + Элемент.ПолучитьПредставлениеДанных();
						Исключение
						КонецПопытки;
					КонецЕсли;
					Если Не ПустаяСтрока(Текст) Тогда
						Куски.Добавить(Лев(СокрЛП(Текст), 300));
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;

КонецПроцедуры

//Окна ошибок платформы: форма с элементом ErrorInfo («К сожалению, возникла непредвиденная ситуация») или
//окно «1С:Предприятие» с надписью об ошибке. → их текст («» — нет).
&НаКлиенте
Функция ОкнаОшибок()

	Куски = Новый Массив;
	Попытка
		Формы = Приложение.НайтиОбъекты(Тип("ТестируемаяФорма"));
	Исключение
		Возврат "";
	КонецПопытки;
	Для Каждого Форма Из Формы Цикл
		Попытка
			Если ЗаголовокОбъекта(Форма) <> "1С:Предприятие" Тогда
				Продолжить;
			КонецЕсли;
			Надписи = Новый Массив;
			Ошибка = Ложь;
			Для Каждого Элемент Из Форма.НайтиОбъекты(Тип("ТестируемаяДекорацияФормы")) Цикл
				Текст = ЗаголовокОбъекта(Элемент);
				Если ИмяОбъекта(Элемент) = "ErrorInfo" Или СтрНайти(НРег(Текст), "ошибк") > 0 Тогда
					Ошибка = Истина;
				КонецЕсли;
				Если Не ПустаяСтрока(Текст) И Не СтрНачинаетсяС(Текст, "Decoration") Тогда
					Надписи.Добавить(Текст);
				КонецЕсли;
			КонецЦикла;
			Если Ошибка Тогда
				Куски.Добавить(СтрСоединить(Надписи, " "));
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Возврат СтрСоединить(Куски, " | ");

КонецФункции

//Коротко и быстро: заголовки форм и надписи (декорации) неосновных окон, кроме начальной страницы, — там
//окна ошибок, отказов и вопросов. Полные надписи окон (НадписиОкон, ~1 с) — только для диагностики провала.
&НаКлиенте
Функция ТекстыОкон()

	Куски = Новый Массив;
	Попытка
		Окна = Приложение.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения"));
	Исключение
		Возврат "";
	КонецПопытки;
	Для Каждого ОкноКлиента Из Окна Цикл
		Попытка
			Если ОкноКлиента.Основное Или ЗаголовокОбъекта(ОкноКлиента) = "Начальная страница" Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Форма Из ОкноКлиента.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
				Куски.Добавить(ЗаголовокОбъекта(Форма));
				Для Каждого Элемент Из Форма.НайтиОбъекты(Тип("ТестируемаяДекорацияФормы")) Цикл
					Куски.Добавить(ЗаголовокОбъекта(Элемент));
				КонецЦикла;
			КонецЦикла;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Возврат СтрСоединить(Куски, " | ");

КонецФункции

//Снимок окна клиента делает скрипт: исполнитель кладёт файл-запрос и ждёт (до 5 с), пока скрипт его уберёт.
&НаКлиенте
Функция ЗапроситьСнимок()

	Если Не Задание.Свойство("снимки") Тогда
		Возврат "";
	КонецЕсли;
	НомерСнимка = НомерСнимка + 1;
	Имя = СтрШаблон("%1_%2", Задание.роль, НомерСнимка);
	ФайлЗапроса = Задание.снимки + "\" + Имя + ".запрос";
	Попытка
		Текст = Новый ТекстовыйДокумент;
		Текст.УстановитьТекст(ТекСценарий);
		Текст.Записать(ФайлЗапроса, КодировкаТекста.UTF8);
	Исключение
		Возврат "";
	КонецПопытки;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Файл = Новый Файл(ФайлЗапроса);
	Пока Файл.Существует() И Секунд(Начало) < 5 Цикл
		Пауза(100);
	КонецЦикла;
	Возврат Имя + ".png";

КонецФункции

//Зонд: что тест-клиент видит — окна, формы, элементы с именами, заголовками и значениями. Нужен, когда пишется новый
//сценарий: имена элементов берутся отсюда, а не угадываются.
&НаКлиенте
Процедура ЗаписатьЗонд(Метка)

	Снимок = Новый Массив;
	Для Каждого ОкноКлиента Из Приложение.НайтиОбъекты(Тип("ТестируемоеОкноКлиентскогоПриложения")) Цикл
		Основное = Ложь;
		Попытка
			Основное = ОкноКлиента.Основное;
		Исключение
		КонецПопытки;
		Снимок.Добавить("ОКНО «" + ЗаголовокОбъекта(ОкноКлиента) + "» основное=" + Основное);
		Для Каждого Форма Из ОкноКлиента.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
			Снимок.Добавить("  ФОРМА «" + ЗаголовокОбъекта(Форма) + "» " + ИмяОбъекта(Форма));
			Для Каждого ИмяТипа Из СтрРазделить("ТестируемоеПолеФормы,ТестируемаяКнопкаФормы,ТестируемаяТаблицаФормы,"
				+ "ТестируемаяГруппаФормы,ТестируемаяДекорацияФормы", ",") Цикл
				Для Каждого Элемент Из Форма.НайтиОбъекты(Тип(ИмяТипа)) Цикл
					Значение = "";
					Попытка
						Значение = " = " + Элемент.ПолучитьПредставлениеДанных();
					Исключение
					КонецПопытки;
					Попытка
						Значение = ?(Элемент.ТекущаяВидимость(), "", " [скрыт]") + Значение;
					Исключение
						Значение = " [видимость?]" + Значение;
					КонецПопытки;
					Снимок.Добавить(СтрШаблон("    %1 %2 «%3»%4", СтрЗаменить(ИмяТипа, "Тестируем", ""),
						ИмяОбъекта(Элемент), ЗаголовокОбъекта(Элемент), Лев(Значение, 120)));
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Зонд.Добавить(Новый Структура("метка, строки", Метка, Снимок));

КонецПроцедуры

#КонецОбласти

#Область Служебные

//Заголовок содержит образец; «*» в образце — любые символы: «Урок*от 28.09.26» не спутать со списком «Уроки».
&НаКлиенте
Функция ПодходитЗаголовок(Заголовок, Образец)

	Остаток = НРег(Заголовок);
	Для Каждого Часть Из СтрРазделить(НРег(Образец), "*", Ложь) Цикл
		Позиция = СтрНайти(Остаток, Часть);
		Если Позиция = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Остаток = Сред(Остаток, Позиция + СтрДлина(Часть));
	КонецЦикла;
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура Записать(Сценарий, Номер, Действие, Что, Итог, Подробности, Сек, Снимок = "")

	Итоги.Добавить(Новый Структура("сценарий, номер, д, что, итог, подробности, сек, снимок",
		Сценарий, Номер, Действие, Что, Итог, Подробности, Сек, Снимок));
	Сохранить(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Готово)

	Попытка
		Запись = Новый ЗаписьJSON;
		Запись.ОткрытьФайл(Задание.итог, "UTF-8");
		ЗаписатьJSON(Запись, Новый Структура("готово, шаги, зонд", Готово, Итоги, Зонд));
		Запись.Закрыть();
	Исключение
		//писать некуда — молчим: диагностика не должна ронять сам прогон
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Функция ЗаголовокОбъекта(Объект)

	Если Объект = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат СокрЛП(Строка(Объект.ТекстЗаголовка));
	Исключение
	КонецПопытки;
	Попытка
		Возврат СокрЛП(Строка(Объект.Заголовок));
	Исключение
	КонецПопытки;
	Возврат "";

КонецФункции

&НаКлиенте
Функция ИмяОбъекта(Объект)

	Попытка
		Возврат Строка(Объект.Имя);
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

//Заголовок кнопки совпадает без учёта регистра, многоточия и подчёркивания-ускорителя.
&НаКлиенте
Функция СовпадаетЗаголовок(ЗаголовокИскомый, Искомый)

	Возврат ЧистыйЗаголовок(ЗаголовокИскомый) = ЧистыйЗаголовок(Искомый);

КонецФункции

&НаКлиенте
Функция ЧистыйЗаголовок(Текст)

	Возврат НРег(СокрЛП(СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, "...", ""), "…", ""), "&", "")));

КонецФункции

&НаКлиенте
Функция ОписаниеЭлемента(Шаг)

	Если Шаг.Свойство("имя") Тогда
		Возврат "«" + Шаг.имя + "»";
	ИначеЕсли Шаг.Свойство("заголовок") Тогда
		Возврат "«" + Подставить(Шаг.заголовок) + "»";
	КонецЕсли;
	Возврат "(без имени)";

КонецФункции

&НаКлиенте
Функция ОписаниеШага(Шаг)

	Части = Новый Массив;
	Для Каждого КлючЗначение Из Шаг Цикл
		Если КлючЗначение.Ключ <> "д" Тогда
			Части.Добавить(КлючЗначение.Ключ + "=" + Строка(КлючЗначение.Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат Шаг.д + " " + СтрСоединить(Части, ", ");

КонецФункции

//{имя} в тексте шага — переменная задания (ссылки на данные, которые скрипт заготовил через COM).
&НаКлиенте
Функция Подставить(Текст)

	Если Не Задание.Свойство("переменные") Или СтрНайти(Текст, "{") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Итог = Текст;
	Для Каждого КлючЗначение Из Задание.переменные Цикл
		Итог = СтрЗаменить(Итог, "{" + КлючЗначение.Ключ + "}", Строка(КлючЗначение.Значение));
	КонецЦикла;
	Возврат Итог;

КонецФункции

&НаКлиенте
Функция Таймаут(Шаг)

	Возврат ?(Шаг.Свойство("таймаут"), Шаг.таймаут, 10);

КонецФункции

&НаКлиенте
Функция Секунд(НачалоМс)

	Возврат Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоМс) / 1000, 2);

КонецФункции

//Пауза без модальных окон и фоновых заданий: у клиента менеджера нет другого способа подождать.
&НаКлиенте
Процедура Пауза(Мс)

	Конец = ТекущаяУниверсальнаяДатаВМиллисекундах() + Мс;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Конец Цикл
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
