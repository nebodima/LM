// Серверная часть форм УЗ_ext для нагрузочного замера (tools\нагрузка\замеры.py): модуль объекта внешней обработки.
// Модули форм через COM не вызвать, поэтому здесь — те же запросы и те же обращения через точку, что делают
// серверные процедуры форм при открытии (перенесено из src_ext; номера строк — в комментариях у каждой функции).
// Реквизиты формы (Планировщик, таблицы) — локальные переменные. Клиентская часть и оформление не повторяются.
// Правка src_ext → сверить этот файл (замеры.py печатает отпечаток исходных модулей форм рядом с результатом).

// ── Календарь: DataProcessors\УЗ_Календарь\Forms\ФормаКалендарь\Ext\Form\Module.bsl ──

// СформироватьСписокЗанятыхДат (стр. 448–502), фильтры пустые.
Функция КалендарьЗанятыеДаты(ДатаКалендаря) Экспорт

	ТЗЗ = Новый ТаблицаЗначений;
	ТЗЗ.Колонки.Добавить("Дата");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Урок.Дата КАК Дата
	|ИЗ
	|	Документ.УЗ_Урок КАК Урок
	|ГДЕ
	|	НЕ Урок.ПометкаУдаления
	|	И Урок.Дата >= &ДатаНачала
	|	И Урок.Дата <= &ДатаОкончания";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоМесяца(НачалоМесяца(ДатаКалендаря) - 1));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецМесяца(КонецМесяца(ДатаКалендаря) + 1));
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТЗЗ.Добавить().Дата = НачалоДня(Выборка.Дата);
	КонецЦикла;
	ТЗЗ.Свернуть("Дата");
	Возврат ТЗЗ.Количество();

КонецФункции

// ЗаполнитьНаСервере (стр. 3–313): измерения по помещениям уроков периода, уроки периода, на каждый урок —
// чтение объекта урока через Ссылка (группа, предмет, педагог, ученики, цвет), без фильтров.
// Флаги — Структура(ГруппаОбучения, ПредметОбучения, Педагог, Ученики, Цвет) как в настройках формы.
Функция КалендарьЗаполнить(ДатаНачала, ДатаОкончания, Флаги) Экспорт

	Планировщик = Новый Планировщик;
	Планировщик.ТекущиеПериодыОтображения.Добавить(ДатаНачала, ДатаОкончания);
	ЭлементыПланировщика = Планировщик.Элементы;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УЗ_Урок.Помещение КАК Помещение
	|ИЗ
	|	Документ.УЗ_Урок КАК УЗ_Урок
	|ГДЕ
	|	УЗ_Урок.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ УЗ_Урок.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	УЗ_Урок.Помещение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Помещение
	|АВТОУПОРЯДОЧИВАНИЕ";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	НовИзмерение = Планировщик.Измерения.Добавить("Помещение");
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НовЭл = НовИзмерение.Элементы.Добавить(ВыборкаДетальныеЗаписи.Помещение);
		НовЭл.Текст = Строка(ВыборкаДетальныеЗаписи.Помещение);
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Помещение.Цвет) Тогда
			НовЭл.ЦветФона = УЗ_ОбщийКлиентСервер.WebЦветПоИмени(СокрЛП(ВыборкаДетальныеЗаписи.Помещение.Цвет));
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УЗ_Урок.Ссылка КАК Ссылка,
	|	УЗ_Урок.Дата КАК Дата,
	|	УЗ_Урок.КоличествоЧасов КАК КоличествоЧасов,
	|	УЗ_Урок.Педагог КАК Педагог,
	|	УЗ_Урок.Статус КАК Статус,
	|	УЗ_Урок.Помещение КАК Помещение
	|ИЗ
	|	Документ.УЗ_Урок КАК УЗ_Урок
	|ГДЕ
	|	УЗ_Урок.Ссылка.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И НЕ УЗ_Урок.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Помещение,
	|	Педагог
	|АВТОУПОРЯДОЧИВАНИЕ";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Уроки = Запрос.Выполнить().Выбрать();
	Количество = 0;
	Пока Уроки.Следующий() Цикл
		Количество = Количество + 1;
		Начало = Уроки.Дата;
		Конец = Начало + Окр(Уроки.КоличествоЧасов * 60) * 60;
		НовыйЭлемент = ЭлементыПланировщика.Добавить(Начало, Конец);
		Если Флаги.ГруппаОбучения И ЗначениеЗаполнено(Уроки.Ссылка.ГруппаОбучения) Тогда
			НовыйЭлемент.Текст = НовыйЭлемент.Текст + Уроки.Ссылка.ГруппаОбучения.Наименование + "; ";
		КонецЕсли;
		Если Флаги.ПредметОбучения И ЗначениеЗаполнено(Уроки.Ссылка.ПредметОбучения) Тогда
			НовыйЭлемент.Текст = НовыйЭлемент.Текст + Уроки.Ссылка.ПредметОбучения.Наименование + "; ";
		КонецЕсли;
		Если Флаги.Педагог И ЗначениеЗаполнено(Уроки.Ссылка.Педагог) Тогда
			НовыйЭлемент.Текст = НовыйЭлемент.Текст + "Педагог: " + Уроки.Ссылка.Педагог.Наименование + "; ";
		КонецЕсли;
		Если Флаги.Ученики Тогда
			НовыйЭлемент.Текст = НовыйЭлемент.Текст + "Ученики: ";
			Для Каждого СтрУченик Из Уроки.Ссылка.Ученики Цикл
				НовыйЭлемент.Текст = НовыйЭлемент.Текст + СтрУченик.Ученик.Наименование + ", ";
			КонецЦикла;
		КонецЕсли;
		НовыйЭлемент.Текст = ТекстУрокаВКалендаре(НовыйЭлемент.Текст, Уроки.Ссылка);
		НовыйЭлемент.Значение = Уроки.Ссылка;
		ИмяЦветаУрока = "";
		Если Флаги.Цвет = "Помещение" И ЗначениеЗаполнено(Уроки.Ссылка.Помещение) Тогда
			ИмяЦветаУрока = Уроки.Ссылка.Помещение.Цвет;
		ИначеЕсли Флаги.Цвет = "ПредмОбуч" И ЗначениеЗаполнено(Уроки.Ссылка.ПредметОбучения) Тогда
			ИмяЦветаУрока = Уроки.Ссылка.ПредметОбучения.Цвет;
		ИначеЕсли Флаги.Цвет = "Педагог" И ЗначениеЗаполнено(Уроки.Ссылка.Педагог) Тогда
			ИмяЦветаУрока = Уроки.Ссылка.Педагог.Цвет;
		КонецЕсли;
		ЦветУрока = УЗ_ОбщийКлиентСервер.WebЦветПоИмени(ИмяЦветаУрока);
		Если ЦветУрока <> Новый Цвет Тогда
			НовыйЭлемент.ЦветФона = ЦветУрока;
		КонецЕсли;
		СоответствиеЗначений = Новый Соответствие;
		СоответствиеЗначений.Вставить("Помещение", Уроки.Ссылка.Помещение);
		СоответствиеЗначений.Вставить("Педагог", Уроки.Ссылка.Педагог);
		НовыйЭлемент.ЗначенияИзмерений = Новый ФиксированноеСоответствие(СоответствиеЗначений);
	КонецЦикла;
	Возврат Количество;

КонецФункции

// ТекстУрокаВКалендаре (стр. 316–340)
Функция ТекстУрокаВКалендаре(Знач Детали, Знач Урок)

	Текст = СокрЛП(Детали);
	Пока СтрЗаканчиваетсяНа(Текст, ";") Или СтрЗаканчиваетсяНа(Текст, ",") Цикл
		Текст = СокрЛП(Лев(Текст, СтрДлина(Текст) - 1));
	КонецЦикла;
	Если ЗначениеЗаполнено(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	Части = Новый Массив;
	Если ЗначениеЗаполнено(Урок.ПредметОбучения) Тогда
		Части.Добавить(Строка(Урок.ПредметОбучения));
	ИначеЕсли ЗначениеЗаполнено(Урок.ГруппаОбучения) Тогда
		Части.Добавить(Строка(Урок.ГруппаОбучения));
	Иначе
		Части.Добавить("Урок");
	КонецЕсли;
	Если ЗначениеЗаполнено(Урок.Педагог) Тогда
		Части.Добавить(Строка(Урок.Педагог));
	КонецЕсли;
	Возврат СтрСоединить(Части, ", ");

КонецФункции

// ── Панель ученика: DataProcessors\УЗ_ПанельУченика\Forms\Форма\Ext\Form\Module.bsl ──

// ПриСозданииНаСервере (стр. 161–174) + ОпределитьАктивныеГруппыОбучения (стр. 29–101) с ОсталосьУроковТекстом
// (стр. 106–158) на каждую группу; период панели пустой (как при открытии).
Функция ПанельОткрыть(Ученик, Организация) Экспорт

	Настройки = РегистрыСведений.УЗ_Настройки.Настройки();
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Организации.Ссылка КАК Ссылка ИЗ Справочник.Организации КАК Организации");
	Запрос.Выполнить().Пустой();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Обороты.ГруппаОбучения КАК ГруппаОбучения
	|ПОМЕСТИТЬ ВТ_Группы
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки.Обороты(&НачалоПериода, &КонецПериода, , Клиент = &Клиент) КАК Обороты
	|ГДЕ
	|	Обороты.ГруппаОбучения <> ЗНАЧЕНИЕ(Справочник.УЗ_ГруппыОбучения.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	УрокУченики.Ссылка.ГруппаОбучения
	|ИЗ
	|	Документ.УЗ_Урок.Ученики КАК УрокУченики
	|ГДЕ
	|	УрокУченики.Ученик = &Клиент
	|	И НЕ УрокУченики.Ссылка.ПометкаУдаления
	|	И УрокУченики.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И УрокУченики.Ссылка.ГруппаОбучения <> ЗНАЧЕНИЕ(Справочник.УЗ_ГруппыОбучения.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.ПредметОбучения КАК ПредметОбучения,
	|	СУММА(Остатки.СуммаОстаток) КАК Остаток
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.УЗ_СписанияСуммЗаУроки.Остатки(, Клиент = &Клиент И Организация = &Организация) КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.ПредметОбучения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Группы.ГруппаОбучения КАК ГруппаОбучения,
	|	ЕСТЬNULL(ВТ_Остатки.Остаток, 0) КАК Остаток
	|ИЗ
	|	ВТ_Группы КАК ВТ_Группы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ВТ_Группы.ГруппаОбучения.ПредметОбучения = ВТ_Остатки.ПредметОбучения
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Группы.ГруппаОбучения.Наименование";
	Запрос.УстановитьПараметр("Клиент", Ученик);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоПериода", '00010101');
	Запрос.УстановитьПараметр("КонецПериода", '29991231');
	Выборка = Запрос.Выполнить().Выбрать();
	Групп = 0;
	Пока Выборка.Следующий() Цикл
		Групп = Групп + 1;
		ОсталосьУроковТекстом(Ученик, Выборка.ГруппаОбучения, Выборка.Остаток);
	КонецЦикла;
	Возврат Групп;

КонецФункции

Функция ОсталосьУроковТекстом(Ученик, ГруппаОбучения, ОстатокДенег)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Абонементы.КоличествоЗанятий КАК КоличествоЗанятий,
	|	Абонементы.КоличествоЧасов КАК КоличествоЧасов,
	|	ЕСТЬNULL(Обороты.КоличествоУроковОборот, 0) КАК Проведено,
	|	ЕСТЬNULL(Обороты.ЧасыРасход, 0) КАК СекундПроведено
	|ИЗ
	|	Справочник.УЗ_Абонемент КАК Абонементы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.УЗ_СписанияСуммЗаУроки.Обороты(, , , Клиент = &Ученик) КАК Обороты
	|		ПО (Обороты.Абонемент = Абонементы.Ссылка)
	|ГДЕ
	|	Абонементы.ФизЛицо = &Ученик
	|	И Абонементы.Активный
	|	И НЕ Абонементы.ПометкаУдаления
	|	И (Абонементы.ПредметОбучения = &ПредметОбучения
	|			ИЛИ Абонементы.ПредметОбучения = ЗНАЧЕНИЕ(Справочник.УЗ_ПредметыОбучения.ПустаяСсылка))
	|	И (Абонементы.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ Абонементы.ДатаОкончания >= &Дата)";
	Запрос.УстановитьПараметр("Ученик", Ученик);
	Запрос.УстановитьПараметр("ПредметОбучения", ГруппаОбучения.ПредметОбучения);
	Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДатаСеанса()));
	Абонементы = Запрос.Выполнить().Выгрузить();
	Если Абонементы.Количество() > 0 И Абонементы.Итог("КоличествоЗанятий") + Абонементы.Итог("КоличествоЧасов") > 0 Тогда
		Возврат "";
	КонецЕсли;
	Если ОстатокДенег <= 0 Тогда
		Возврат "0";
	КонецЕсли;
	Цена = Документы.УЗ_Урок.ЦенаТарифаНаДату(ГруппаОбучения.Тариф, ТекущаяДатаСеанса());
	Возврат ?(Цена = Неопределено, "", Строка(Цена.Сумма));

КонецФункции

// Динамический список СписокУроков панели (Form.xml стр. 621–663): Документ.УЗ_Урок, отбор Ученики.Ученик,
// группировка ПредметОбучения → ГруппаОбучения, без периода. Платформа читает группировки и первую порцию строк —
// здесь: верхний уровень группировок и 50 последних уроков ученика с представлениями ссылок.
Функция ПанельСписокУроков(Ученик) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Урок.ПредметОбучения КАК ПредметОбучения,
	|	ПРЕДСТАВЛЕНИЕ(Урок.ПредметОбучения) КАК ПредметОбученияПредставление
	|ИЗ
	|	Документ.УЗ_Урок КАК Урок
	|ГДЕ
	|	Урок.Ссылка В
	|			(ВЫБРАТЬ
	|				УрокУченики.Ссылка
	|			ИЗ
	|				Документ.УЗ_Урок.Ученики КАК УрокУченики
	|			ГДЕ
	|				УрокУченики.Ученик = &Ученик)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 50
	|	Урок.Ссылка КАК Ссылка,
	|	Урок.Дата КАК Дата,
	|	Урок.Номер КАК Номер,
	|	Урок.Проведен КАК Проведен,
	|	ПРЕДСТАВЛЕНИЕ(Урок.ПредметОбучения) КАК ПредметОбучения,
	|	ПРЕДСТАВЛЕНИЕ(Урок.ГруппаОбучения) КАК ГруппаОбучения,
	|	ПРЕДСТАВЛЕНИЕ(Урок.Педагог) КАК Педагог,
	|	ПРЕДСТАВЛЕНИЕ(Урок.Помещение) КАК Помещение,
	|	Урок.КоличествоЧасов КАК КоличествоЧасов,
	|	Урок.Сумма КАК Сумма
	|ИЗ
	|	Документ.УЗ_Урок КАК Урок
	|ГДЕ
	|	Урок.Ссылка В
	|			(ВЫБРАТЬ
	|				УрокУченики.Ссылка
	|			ИЗ
	|				Документ.УЗ_Урок.Ученики КАК УрокУченики
	|			ГДЕ
	|				УрокУченики.Ученик = &Ученик)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Урок.Дата УБЫВ";
	Запрос.УстановитьПараметр("Ученик", Ученик);
	Результаты = Запрос.ВыполнитьПакет();
	Возврат Результаты[1].Выгрузить().Количество();

КонецФункции

// ── Помощник уроков: Documents\УЗ_Урок\Forms\ПомощникСозданияУроков\Ext\Form\Module.bsl ──

// ЗаполнитьУчениковИзГруппы (стр. 364–423): ученики группы на сегодня и их действующие абонементы.
Функция ПомощникУченики(ГруппаОбучения) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ГруппыУченика.Ссылка КАК Ученик,
	|	ГруппыУченика.Ссылка.Наименование КАК Наименование,
	|	ГруппыУченика.Ссылка.Тариф КАК Тариф,
	|	ГруппыУченика.Ссылка.Скидка КАК Скидка
	|ПОМЕСТИТЬ ВТ_Ученики
	|ИЗ
	|	Справочник.УЗ_ФизЛица.ГруппыОбучения КАК ГруппыУченика
	|ГДЕ
	|	ГруппыУченика.ГруппаОбучения = &ГруппаОбучения
	|	И НЕ ГруппыУченика.Ссылка.ПометкаУдаления
	|	И НЕ ГруппыУченика.Ссылка.ЭтоПедагог
	|	И (ГруппыУченика.ДатаНачала = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ГруппыУченика.ДатаНачала <= &Дата)
	|	И (ГруппыУченика.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ГруппыУченика.ДатаОкончания >= &Дата)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Ученики.Ученик КАК Ученик,
	|	ВТ_Ученики.Наименование КАК Наименование,
	|	ВТ_Ученики.Тариф КАК Тариф,
	|	ВТ_Ученики.Скидка КАК Скидка
	|ИЗ
	|	ВТ_Ученики КАК ВТ_Ученики
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	Запрос.УстановитьПараметр("ГруппаОбучения", ГруппаОбучения);
	Запрос.УстановитьПараметр("Дата", НачалоДня(ТекущаяДатаСеанса()));
	Таблица = Запрос.Выполнить().Выгрузить();
	Абонементы = Документы.УЗ_Урок.ДействующиеАбонементы(Таблица.ВыгрузитьКолонку("Ученик"),
		ГруппаОбучения.ПредметОбучения, ТекущаяДатаСеанса());
	ДанныеУчеников = Новый Массив;
	Для Каждого Выборка Из Таблица Цикл
		ДанныеУчеников.Добавить(Новый Структура("Ученик, Тариф, Скидка, СписатьОплату, Явка, Абонемент",
			Выборка.Ученик, ?(ЗначениеЗаполнено(Выборка.Тариф), Выборка.Тариф, ГруппаОбучения.Тариф), Выборка.Скидка,
			Истина, Истина, Абонементы[Выборка.Ученик]));
	КонецЦикла;
	Возврат ДанныеУчеников;

КонецФункции

// Даты месяца по дням недели группы (ДобавитьВСписок, стр. 527–543) с временем из расписания группы
// (ПолучитьВремяИзГруппы, стр. 7–46): Массив из Структура(Дата, ВремяНачала, ВремяОкончания).
Функция ПомощникДаты(ГруппаОбучения, ДатаНач, ДатаКон) Экспорт

	Дни = СтрРазделить("ПН,ВТ,СР,ЧТ,ПТ,СБ,ВС", ",");
	Итог = Новый Массив;
	День = НачалоДня(ДатаНач);
	Пока День <= ДатаКон Цикл
		Имя = Дни[ДеньНедели(День) - 1];
		Если ГруппаОбучения[Имя] И ЗначениеЗаполнено(ГруппаОбучения[Имя + "Время"])
			И ЗначениеЗаполнено(ГруппаОбучения[Имя + "Время2"]) Тогда
			Итог.Добавить(Новый Структура("Дата, ВремяНачала, ВремяОкончания", День,
				ГруппаОбучения[Имя + "Время"], ГруппаОбучения[Имя + "Время2"]));
		КонецЕсли;
		День = День + 86400;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// НайтиДокументыНаСервере (стр. 748–804): запрос на каждую выделенную дату.
Функция ПомощникНайтиДокументы(ГруппаОбучения, Даты) Экспорт

	Найдено = 0;
	Для Каждого Стр Из Даты Цикл
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Урок.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.УЗ_Урок КАК Урок
		|ГДЕ
		|	НЕ Урок.ПометкаУдаления
		|	И Урок.Окончание <= &ДатаОкончания
		|	И Урок.Дата >= &ДатаНачала
		|	И Урок.ПредметОбучения = &ПредметОбучения
		|	И Урок.Помещение = &Помещение";
		Запрос.УстановитьПараметр("ДатаНачала", Стр.Дата - ('00010101' - Стр.ВремяНачала));
		Запрос.УстановитьПараметр("ДатаОкончания", Стр.Дата - ('00010101' - Стр.ВремяОкончания));
		Запрос.УстановитьПараметр("ПредметОбучения", ГруппаОбучения.ПредметОбучения);
		Запрос.УстановитьПараметр("Помещение", ГруппаОбучения.Помещение);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Найдено = Найдено + 1;
		КонецЦикла;
	КонецЦикла;
	Возврат Найдено;

КонецФункции

// ВыполнитьНаСервере, страница «Создание уроков» (стр. 105–143): на каждую дату — ЗаписатьУчениковВУрок
// (будущие уроки только записываются, В10). Возврат: Массив созданных/изменённых уроков (для уборки замера).
Функция ПомощникЗаписать(ГруппаОбучения, Даты, ДанныеУчеников) Экспорт

	Уроки = Новый Массив;
	Для Каждого Стр Из Даты Цикл
		ПараметрыУрока = Новый Структура;
		ПараметрыУрока.Вставить("Дата", Стр.Дата - ('00010101' - Стр.ВремяНачала));
		ПараметрыУрока.Вставить("КоличествоЧасов", (Стр.ВремяОкончания - Стр.ВремяНачала) / 3600);
		ПараметрыУрока.Вставить("ПредметОбучения", ГруппаОбучения.ПредметОбучения);
		ПараметрыУрока.Вставить("Педагог", ГруппаОбучения.Педагог);
		ПараметрыУрока.Вставить("Помещение", ГруппаОбучения.Помещение);
		ПараметрыУрока.Вставить("ГруппаОбучения", ГруппаОбучения);
		ПараметрыУрока.Вставить("Статус", Справочники.УЗ_Статусы.ПустаяСсылка());
		ПараметрыУрока.Вставить("Тариф", ГруппаОбучения.Тариф);
		Итог = Документы.УЗ_Урок.ЗаписатьУчениковВУрок(ПараметрыУрока, ДанныеУчеников, Истина);
		Если ЗначениеЗаполнено(Итог.Урок) Тогда
			Уроки.Добавить(Итог.Урок);
		КонецЕсли;
	КонецЦикла;
	Возврат Уроки;

КонецФункции

// ── Отчёты на СКД: где уходит время (не форма — разбор формирования по этапам) ──

// Этапы формирования варианта по умолчанию за период: макет, выполнение запросов набора (текст запроса, который
// построила СКД, — с отборами и параметрами), вывод в табличный документ; плюс вывод в таблицу значений
// (без оформления) — чтобы отделить цену запроса от цены вывода. Возврат: Структура с миллисекундами и текстом.
Функция ЗамерСКД(ИмяОтчета, Начало, Окончание) Экспорт

	Итог = Новый Структура("Макет, Запрос, СтрокЗапроса, Вывод, ВысотаТаблицы, ВКоллекцию, СтрокКоллекции, ТекстЗапроса");
	Отчет = Отчеты[ИмяОтчета].Создать();
	Схема = Отчет.СхемаКомпоновкиДанных;
	Настройки = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", Новый СтандартныйПериод(Начало, Окончание));

	Засечка = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Макет = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = Макет.Выполнить(Схема, Настройки);
	Итог.Макет = ТекущаяУниверсальнаяДатаВМиллисекундах() - Засечка;

	// запросы наборов данных так, как их построила СКД
	Засечка = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Строк = 0;
	Тексты = Новый Массив;
	Для Каждого Набор Из МакетКомпоновки.НаборыДанных Цикл
		Если ТипЗнч(Набор) <> Тип("НаборДанныхЗапросМакетаКомпоновкиДанных") Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос(Набор.Запрос);
		Для Каждого Значение Из МакетКомпоновки.ЗначенияПараметров Цикл
			Запрос.УстановитьПараметр(Значение.Имя, Значение.Значение);
		КонецЦикла;
		Строк = Строк + Запрос.Выполнить().Выгрузить().Количество();
		Тексты.Добавить(Набор.Запрос);
	КонецЦикла;
	Итог.Запрос = ТекущаяУниверсальнаяДатаВМиллисекундах() - Засечка;
	Итог.СтрокЗапроса = Строк;
	Итог.ТекстЗапроса = СтрСоединить(Тексты, Символы.ПС + "-----" + Символы.ПС);

	// полное формирование в табличный документ (запрос + компоновка + вывод)
	Засечка = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(МакетКомпоновки);
	Документ = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(Документ);
	ПроцессорВывода.Вывести(Процессор);
	Итог.Вывод = ТекущаяУниверсальнаяДатаВМиллисекундах() - Засечка;
	Итог.ВысотаТаблицы = Документ.ВысотаТаблицы;

	// то же в таблицу значений: без оформления и без колонок дополнения периода (вариант с таблицей СКД
	// в коллекцию не выводится — тогда -1)
	Засечка = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		МакетКоллекции = Макет.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		Процессор = Новый ПроцессорКомпоновкиДанных;
		Процессор.Инициализировать(МакетКоллекции);
		Таблица = Новый ТаблицаЗначений;
		ПроцессорВКоллекцию = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		ПроцессорВКоллекцию.УстановитьОбъект(Таблица);
		ПроцессорВКоллекцию.Вывести(Процессор);
		Итог.ВКоллекцию = ТекущаяУниверсальнаяДатаВМиллисекундах() - Засечка;
		Итог.СтрокКоллекции = Таблица.Количество();
	Исключение
		Итог.ВКоллекцию = -1;
		Итог.СтрокКоллекции = -1;
	КонецПопытки;
	Возврат Итог;

КонецФункции

// Параметры запроса набора, как их подставила СКД (для опытов с текстом запроса из python).
Функция ПараметрыЗапросаСКД(ИмяОтчета, Начало, Окончание) Экспорт

	Отчет = Отчеты[ИмяОтчета].Создать();
	Настройки = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", Новый СтандартныйПериод(Начало, Окончание));
	МакетКомпоновки = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = МакетКомпоновки.Выполнить(Отчет.СхемаКомпоновкиДанных, Настройки);
	Итог = Новый Структура;
	Для Каждого Значение Из МакетКомпоновки.ЗначенияПараметров Цикл
		Итог.Вставить(Значение.Имя, Значение.Значение);
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Выполнить текст запроса с параметрами СКД — миллисекунды и число строк.
Функция ВыполнитьЗапросСКД(Текст, Параметры) Экспорт

	Запрос = Новый Запрос(Текст);
	Для Каждого КлючИЗначение Из Параметры Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Засечка = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Строк = Запрос.Выполнить().Выгрузить().Количество();
	Возврат Новый Структура("Мс, Строк", ТекущаяУниверсальнаяДатаВМиллисекундах() - Засечка, Строк);

КонецФункции

// Вывод варианта отчёта в табличный документ с изменёнными настройками: без условного оформления и/или без
// дополнения периода по дням у группировок. Возврат: миллисекунды полного формирования и высота/ширина таблицы.
Функция ЗамерВыводаСКД(ИмяОтчета, Начало, Окончание, БезОформления, БезДополнения) Экспорт

	Отчет = Отчеты[ИмяОтчета].Создать();
	Настройки = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", Новый СтандартныйПериод(Начало, Окончание));
	Если БезОформления Тогда
		Настройки.УсловноеОформление.Элементы.Очистить();
		СнятьОформлениеСтруктуры(Настройки.Структура);
	КонецЕсли;
	Если БезДополнения Тогда
		СнятьДополнениеПериода(Настройки.Структура);
	КонецЕсли;
	Засечка = ТекущаяУниверсальнаяДатаВМиллисекундах();
	МакетКомпоновки = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = МакетКомпоновки.Выполнить(Отчет.СхемаКомпоновкиДанных, Настройки);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(МакетКомпоновки);
	Документ = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(Документ);
	ПроцессорВывода.Вывести(Процессор);
	Возврат Новый Структура("Мс, Высота, Ширина", ТекущаяУниверсальнаяДатаВМиллисекундах() - Засечка,
		Документ.ВысотаТаблицы, Документ.ШиринаТаблицы);

КонецФункции

Процедура СнятьОформлениеСтруктуры(Коллекция)

	Для Каждого Элемент Из Коллекция Цикл
		Если ТипЗнч(Элемент) = Тип("ТаблицаКомпоновкиДанных") Тогда
			Элемент.УсловноеОформление.Элементы.Очистить();
			СнятьОформлениеСтруктуры(Элемент.Строки);
			СнятьОформлениеСтруктуры(Элемент.Колонки);
		ИначеЕсли ТипЗнч(Элемент) = Тип("ГруппировкаКомпоновкиДанных")
			Или ТипЗнч(Элемент) = Тип("ГруппировкаТаблицыКомпоновкиДанных") Тогда
			Элемент.УсловноеОформление.Элементы.Очистить();
			СнятьОформлениеСтруктуры(Элемент.Структура);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура СнятьДополнениеПериода(Коллекция)

	Для Каждого Элемент Из Коллекция Цикл
		Если ТипЗнч(Элемент) = Тип("ТаблицаКомпоновкиДанных") Тогда
			СнятьДополнениеПериода(Элемент.Строки);
			СнятьДополнениеПериода(Элемент.Колонки);
		ИначеЕсли ТипЗнч(Элемент) = Тип("ГруппировкаКомпоновкиДанных")
			Или ТипЗнч(Элемент) = Тип("ГруппировкаТаблицыКомпоновкиДанных") Тогда
			Для Каждого Поле Из Элемент.ПоляГруппировки.Элементы Цикл
				Если ТипЗнч(Поле) = Тип("ПолеГруппировкиКомпоновкиДанных") Тогда
					Поле.ТипДополнения = ТипДополненияПериодаКомпоновкиДанных.БезДополнения;
				КонецЕсли;
			КонецЦикла;
			СнятьДополнениеПериода(Элемент.Структура);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Опыт с условным оформлением: Режим = "БезУсловияПериода" — из отборов оформления убрать условие «Период
// заполнено» (остальное как есть); "ТолькоТаблица" — оформление варианта (уровень настроек) очистить, оставить
// оформление таблицы; "ТолькоНастройки" — наоборот.
Функция ЗамерОформленияСКД(ИмяОтчета, Начало, Окончание, Режим) Экспорт

	Отчет = Отчеты[ИмяОтчета].Создать();
	Настройки = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", Новый СтандартныйПериод(Начало, Окончание));
	Если Режим = "БезУсловияПериода" Тогда
		УбратьУсловиеПериода(Настройки.УсловноеОформление);
		Для Каждого Элемент Из Настройки.Структура Цикл
			Если ТипЗнч(Элемент) = Тип("ТаблицаКомпоновкиДанных") Тогда
				УбратьУсловиеПериода(Элемент.УсловноеОформление);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Режим = "ВГруппировкеКолонок" Тогда
		// оформление — в группировке колонок «Период» (только ячейки дней), условие «Период заполнено» не нужно
		Для Каждого Элемент Из Настройки.Структура Цикл
			Если ТипЗнч(Элемент) <> Тип("ТаблицаКомпоновкиДанных") Тогда
				Продолжить;
			КонецЕсли;
			Колонка = Элемент.Колонки[0];
			Для Каждого Исходный Из Настройки.УсловноеОформление.Элементы Цикл
				ЭлементНовый = Колонка.УсловноеОформление.Элементы.Добавить();
				Для Каждого Поле Из Исходный.Поля.Элементы Цикл
					ЭлементНовый.Поля.Элементы.Добавить().Поле = Поле.Поле;
				КонецЦикла;
				Для Каждого Значение Из Исходный.Оформление.Элементы Цикл
					Если Значение.Использование Тогда
						ЭлементНовый.Оформление.УстановитьЗначениеПараметра(Значение.Параметр, Значение.Значение);
					КонецЕсли;
				КонецЦикла;
				СкопироватьОтборБезПериода(Исходный.Отбор.Элементы, ЭлементНовый.Отбор.Элементы);
			КонецЦикла;
		КонецЦикла;
		Настройки.УсловноеОформление.Элементы.Очистить();
	ИначеЕсли Режим = "ТолькоТаблица" Тогда
		Настройки.УсловноеОформление.Элементы.Очистить();
	ИначеЕсли Режим = "ТолькоНастройки" Тогда
		Для Каждого Элемент Из Настройки.Структура Цикл
			Если ТипЗнч(Элемент) = Тип("ТаблицаКомпоновкиДанных") Тогда
				Элемент.УсловноеОформление.Элементы.Очистить();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Засечка = ТекущаяУниверсальнаяДатаВМиллисекундах();
	МакетКомпоновки = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = МакетКомпоновки.Выполнить(Отчет.СхемаКомпоновкиДанных, Настройки);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(МакетКомпоновки);
	Документ = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(Документ);
	ПроцессорВывода.Вывести(Процессор);
	Возврат Новый Структура("Мс, Высота, Ширина, ЭлементовНастроек, ЭлементовТаблицы",
		ТекущаяУниверсальнаяДатаВМиллисекундах() - Засечка, Документ.ВысотаТаблицы, Документ.ШиринаТаблицы,
		Настройки.УсловноеОформление.Элементы.Количество(), ЭлементовОформленияТаблицы(Настройки));

КонецФункции

Функция ЭлементовОформленияТаблицы(Настройки)
	Количество = 0;
	Для Каждого Элемент Из Настройки.Структура Цикл
		Если ТипЗнч(Элемент) = Тип("ТаблицаКомпоновкиДанных") Тогда
			Количество = Количество + Элемент.УсловноеОформление.Элементы.Количество();
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
КонецФункции

Процедура УбратьУсловиеПериода(Оформление)

	Для Каждого ЭлементОформления Из Оформление.Элементы Цикл
		УбратьИзОтбора(ЭлементОформления.Отбор.Элементы);
	КонецЦикла;

КонецПроцедуры

Процедура УбратьИзОтбора(ЭлементыОтбора)

	Удалить = Новый Массив;
	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			УбратьИзОтбора(ЭлементОтбора.Элементы);
		ИначеЕсли ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Период") Тогда
			Удалить.Добавить(ЭлементОтбора);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЭлементОтбора Из Удалить Цикл
		ЭлементыОтбора.Удалить(ЭлементОтбора);
	КонецЦикла;

КонецПроцедуры

Процедура СкопироватьОтборБезПериода(Откуда, Куда)

	Для Каждого ЭлементОтбора Из Откуда Цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			СкопироватьОтборБезПериода(ЭлементОтбора.Элементы, Куда);
		ИначеЕсли ЭлементОтбора.ЛевоеЗначение <> Новый ПолеКомпоновкиДанных("Период") Тогда
			НовыйЭлемент = Куда.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовыйЭлемент, ЭлементОтбора);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Полное формирование «Взаиморасчётов» с исправленным запросом набора: ПредметОбучения — поле регистра, а не
// ВЫБОР со строкой «<<предмет не выбран>>» (строковое значение в поле группировки делает поле составным: СКД
// сортирует и группирует по выражению, индексы и соединения теряются). Возврат: миллисекунды и высота.
Функция ЗамерВзаиморасчетов(Начало, Окончание, ИсправитьЗапрос, БезДетальных = Ложь) Экспорт

	Отчет = Отчеты.УЗ_Взаиморасчеты.Создать();
	Схема = Отчет.СхемаКомпоновкиДанных;
	Если ИсправитьЗапрос Тогда
		Набор = Схема.НаборыДанных[0];
		Было = Набор.Запрос;
		Конец_ = СтрНайти(Было, "КОНЕЦ КАК ПредметОбучения");
		Начало_ = ?(Конец_ > 0, СтрНайти(Было, "ВЫБОР", НаправлениеПоиска.СКонца, Конец_), 0);
		Если Начало_ > 0 И СтрНайти(Сред(Было, Начало_, Конец_ - Начало_), "<<предмет не выбран>>") > 0 Тогда
			Набор.Запрос = Лев(Было, Начало_ - 1) + "СписанияСуммЗаУроки.ПредметОбучения КАК ПредметОбучения"
				+ Сред(Было, Конец_ + СтрДлина("КОНЕЦ КАК ПредметОбучения"));
		КонецЕсли;
		Если Набор.Запрос = Было Тогда
			ВызватьИсключение "замена в запросе «Взаиморасчётов» не сработала — текст схемы изменился";
		КонецЕсли;
	КонецЕсли;
	Настройки = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("Период", Новый СтандартныйПериод(Начало, Окончание));
	Если БезДетальных Тогда
		УбратьДетальныеЗаписи(Настройки.Структура);
	КонецЕсли;
	Засечка = ТекущаяУниверсальнаяДатаВМиллисекундах();
	МакетКомпоновки = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = МакетКомпоновки.Выполнить(Схема, Настройки);
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(МакетКомпоновки);
	Документ = Новый ТабличныйДокумент;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(Документ);
	ПроцессорВывода.Вывести(Процессор);
	Возврат Новый Структура("Мс, Высота", ТекущаяУниверсальнаяДатаВМиллисекундах() - Засечка, Документ.ВысотаТаблицы);

КонецФункции

// Группировка без полей группировки — детальные записи; убрать её (итоги по группировкам выше остаются).
Процедура УбратьДетальныеЗаписи(Коллекция)

	Удалить = Новый Массив;
	Для Каждого Элемент Из Коллекция Цикл
		Если ТипЗнч(Элемент) = Тип("ГруппировкаКомпоновкиДанных") Тогда
			Если Элемент.ПоляГруппировки.Элементы.Количество() = 0 Тогда
				Удалить.Добавить(Элемент);
			Иначе
				УбратьДетальныеЗаписи(Элемент.Структура);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из Удалить Цикл
		Коллекция.Удалить(Элемент);
	КонецЦикла;

КонецПроцедуры
