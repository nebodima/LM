// похожие на нарушения, — на них аудиты обязаны молчать.
// вызов ОбщегоНазначения.СообщитьПользователю(…) в комментарии не считается

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Движения.УЗ_Касса.Записывать = Истина;
	Движение = Движения.УЗ_Касса.ДобавитьПриход();
	Движение.Период = Дата;
	Движение.Касса = Касса;
	Движение.Сумма = Сумма;

	Если ВидОперации = Перечисления.УЗ_ВидыОпераций.Приход Тогда
		ТекущийОстаток = ОстатокКассы(Касса);
	КонецЕсли;

	// параметр с именем общего модуля БСП — локальное имя, это не вызов БСП
	ДобавитьПустого(Новый Массив);

	Для Индекс = 1 По Расшифровка.Количество() Цикл
		СтрокаРасшифровки = Расшифровка[Индекс - 1];
		СтрокаРасшифровки.СуммаСтроки = Окр(СтрокаРасшифровки.СуммаСтроки, 2);
	КонецЦикла;

	Текст = "Как в прошлый раз: сумма и касса как и раньше";   // не запрос
	ЗаписьXML = Новый ЗаписьXML;
	НайденныйДокумент = Метаданные.Документы.Найти("УЗ_ПриходДенег");
	ТипСсылки = Тип("ДокументСсылка.УЗ_ПриходДенег");
	ДополнительныеСвойства.Вставить("Проба", Новый Структура("Остаток, Текст, Документ, Тип", ТекущийОстаток,
		Текст, НайденныйДокумент, ТипСсылки));

КонецПроцедуры

Функция ОстатокКассы(КассаОстатка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Касса КАК Касса,
	|	Остатки.СуммаОстаток КАК Сумма
	|ИЗ
	|	РегистрНакопления.УЗ_Касса.Остатки(, Касса = &Касса) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПриходДенег.Ссылка КАК Ссылка,
	|	ПриходДенег.Сумма КАК Сумма,
	|	ПриходДенег.Касса.Организация КАК Организация,
	|	Пользователи.Наименование КАК Автор
	|ИЗ
	|	Документ.УЗ_ПриходДенег КАК ПриходДенег
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|		ПО ПриходДенег.Автор = Пользователи.Ссылка
	|ГДЕ
	|	ПриходДенег.ВидОперации = ЗНАЧЕНИЕ(Перечисление.УЗ_ВидыОпераций.Приход)
	|	И ПриходДенег.Проведен
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Расшифровка.Ссылка,
	|	Расшифровка.СуммаСтроки,
	|	NULL,
	|	""""
	|ИЗ
	|	Документ.УЗ_ПриходДенег.Расшифровка КАК Расшифровка";
	Запрос.УстановитьПараметр("Касса", КассаОстатка);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Сумма, 0);

КонецФункции

Процедура ДобавитьПустого(Пользователи)
	Пользователи.Добавить(Справочники.Пользователи.ПустаяСсылка());
КонецПроцедуры

#КонецЕсли
