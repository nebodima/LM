// Фикстура аудитов: печать ПКО — каждый параметр макета заполняется кодом.

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

//Печатная форма ПКО: табличный документ по макету ПечатьПКО.
Функция ПечатьПКО(Ссылка) Экспорт

	ТабличныйДокумент = Новый ТабличныйДокумент;
	Макет = Документы.УЗ_ПриходДенег.ПолучитьМакет("ПечатьПКО");
	Шапка = Макет.ПолучитьОбласть("Шапка");
	Шапка.Параметры.НомерДокумента = Ссылка.Номер;
	Шапка.Параметры.Сумма = Ссылка.Сумма;
	Знаки = Новый Структура;
	УЗ_Печать.ДобавитьЗнакоместа(Знаки, "ИНН", Формат(Ссылка.Сумма, "ЧГ="), 1);
	Шапка.Параметры.Заполнить(Знаки);
	ТабличныйДокумент.Вывести(Шапка);
	Возврат ТабличныйДокумент;

КонецФункции

#КонецЕсли
