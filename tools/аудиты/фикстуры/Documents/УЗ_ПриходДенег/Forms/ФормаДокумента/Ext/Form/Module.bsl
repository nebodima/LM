// Фикстура аудитов: модуль формы без модальных окон и без БСП.

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Не ЗначениеЗаполнено(Объект.Автор) Тогда
		Объект.Автор = УЗ_Среда.ТекущийПользователь();
	КонецЕсли;
	// реквизит формы «Пользователи» — таблица значений, а не общий модуль БСП
	Пользователи.Очистить();

КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)

	Оповещение = Новый ОписаниеОповещения("ЗаполнитьПослеВопроса", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Заполнить расшифровку?", РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПослеВопроса(Ответ, ДополнительныеПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьНаСервере();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()

	Объект.Расшифровка.Очистить();
	НоваяСтрока = Объект.Расшифровка.Добавить();
	НоваяСтрока.Назначение = "Оплата занятий";
	НоваяСтрока.СуммаСтроки = Объект.Сумма;

КонецПроцедуры
