{
 "миграции": {
  "Catalogs.УЗ_Тарифы|Attribute:КоличествоЧасов": "перенос не нужен: точность часов тарифа 10.1 -> 13.4 (В13/В25, до минуты: 40 мин = 0,6667 ч), целая часть 9 знаков как в выпуске, платформа сохраняет значения при реструктуризации (28.09.2026)",
  "InformationRegisters.УЗ_ЦеныТарифов|Resource:КоличествоЧасов": "перенос не нужен: точность часов цены тарифа 10.1 -> 13.4 (В13/В25, до минуты), целая часть 9 знаков как в выпуске, платформа сохраняет значения при реструктуризации (28.09.2026)",
  "Documents.УЗ_СписаниеОстатков|Attribute:КоличествоЧасов": "перенос не нужен: дробная часть 0 -> 4 знака (учёт №10: часы в секунды; В13: до минуты), целая часть 13 знаков покрывает любые часы, платформа сохраняет значения при реструктуризации (28.09.2026)",
  "Documents.УЗ_СписаниеОстатков|TabularSection:ТЗСписания.КоличествоЧасов": "перенос не нужен: дробная часть 0 -> 4 знака (учёт №10: часы в секунды; В13: до минуты), целая часть 10 знаков как в выпуске, платформа сохраняет значения при реструктуризации (28.09.2026)",
  "Documents.УЗ_Урок|Attribute:КоличествоЧасов": "перенос не нужен: точность часов 4 знака (В13, до минуты: 40 мин = 0,6667 ч), целая часть не меньше прежней, платформа сохраняет значения при реструктуризации; старые 0,67/0,83 ч округляются до 40/50 мин в Документы.УЗ_Урок.СекундУрока (Codex A12, 28.09.2026)"
 },
